{
  "work_id": "patristic/coptic-scriptorium/dormition_john",
  "source_path": "patristic/coptic-scriptorium/dormition_john.json",
  "source_language": "cop",
  "target_language": "eng",
  "provenance": {
    "gpt-6.1-sol/bulk-2026-10-12/2026-10-12": {
      "model": "gpt-6.1-sol",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-10-12",
      "script": "scripts.embed_eval.translate"
    }
  },
  "translations": [
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0013",
      "source_sha256": "7a9a77978af5cfdd",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "When you obey his holy commandments, he will have mercy on you too."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0014",
      "source_sha256": "f1e53569294da0d1",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "Do not cause the good God to grieve because of you: the merciful and compassionate one, the undefiled, the tireless, the incomprehensible, the one who alone is unique, the unchanging, the guileless, the one without anger, the name above every name that can be conceived."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0015",
      "source_sha256": "4f8b88396a85b22a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "Let him be glad with you as you conduct yourselves well for him."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0016",
      "source_sha256": "d175e86a8ccb5e9c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "Let him rejoice with you as you live in gladness and moderation."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0017",
      "source_sha256": "184de397b16baba1",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "Let him find rest in you as you conduct yourselves with dignity."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0022",
      "source_sha256": "f00bf7fdeff805ab",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "These things, then, my brothers, I say to you because I am eager to go forward with the work he has set before me, whose completion will come to me through the Lord."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0024",
      "source_sha256": "a1a5060a1307ed53",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "You have the pledge of his kingdom."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0039",
      "source_sha256": "1f21581410e78d1a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "We give you glory, Lord Jesus Christ, whose name was revealed through the Father."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0045",
      "source_sha256": "494d1052e17468fa",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "For you are the Lord, the root of immortality, the spring of incorruptibility, and the foundation of the ages."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0046",
      "source_sha256": "fc93c3251465d80c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "Your name has been pronounced over all these things, so that we too may call upon you through them."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0047",
      "source_sha256": "7486352200ccea60",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "For we know your invisible greatness, which is not revealed to us now."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0048",
      "source_sha256": "a61c7fd072414c63",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "When you purify us, then we will see you in the very body that you made new in old age."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0049",
      "source_sha256": "62ee5b4e0229044d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "And when he broke the bread, he prayed over each of the brothers, so that they might be worthy of the Lord’s grace."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0074",
      "source_sha256": "8cbbf4c33cb7df2d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "The one who made her overcome her enemies when she fled to him."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0094",
      "source_sha256": "8a3d7efdcb312d04",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "The one who saved me from the second death, which is the fiery Gehenna, as you made me stand in holiness."
    },
    {
      "chunk_id": "patristic/coptic-scriptorium/dormition_john#CopScr.dormition-john.000.0111",
      "source_sha256": "062d85789f91998b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 16,
      "text": "When John the Theologian had said these things, he looked toward the east, giving glory to God."
    }
  ]
}
