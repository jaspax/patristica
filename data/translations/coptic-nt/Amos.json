    {
      "chunk_id": "coptic-nt/amos#Amos.2.13",
      "source_sha256": "5e7eba615e40cdd0",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 5,
      "text": "Therefore, look: I will roll you about as a cart rolls when it is full of straw."
    },
    {
      "chunk_id": "coptic-nt/amos#Amos.3.8",
      "source_sha256": "a2069e8d6ef883dc",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 5,
      "text": "A lion will roar, and who will not be afraid? The Lord God has spoken, and who will not prophesy?"
    },
    {
      "chunk_id": "coptic-nt/amos#Amos.8.4",
      "source_sha256": "cf9b033a1b04d67b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 5,
      "text": "Listen, then, to these things, you who crush the afflicted in the morning and oppress the poor on the earth."
    },
    {
      "chunk_id": "coptic-nt/amos#Amos.9.12",
      "source_sha256": "4d3a7defc2f29f06",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 5,
      "text": "So that the rest of humanity and all the nations over whom my name has been invoked may seek, says the Lord, who does these things."
    },
    {
      "chunk_id": "coptic-nt/amos#Amos.9.15",
      "source_sha256": "db5b669d363df702",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 5,
      "text": "And I will plant them in their land, and from now on they will never be removed from their land, which I gave them, says the Lord God Almighty."
    }
  ]
}
