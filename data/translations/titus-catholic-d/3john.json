{
  "work_id": "titus-catholic-d/3john",
  "source_path": "titus-catholic-d/3john.json",
  "source_language": "oge",
  "target_language": "eng",
  "provenance": {
    "claude-opus-5-5/bulk-2026-10-12/2026-11-04": {
      "model": "claude-opus-5-5",
      "prompt_version": "bulk-2026-10-12",
