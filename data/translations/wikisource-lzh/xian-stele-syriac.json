      "source_sha256": "d259a3fe4c8ea0bf",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-13",
      "group_size": 25,
      "text": "Mar Yazdbozid, priest and chorepiscopus of Kumdan, the royal city,"
