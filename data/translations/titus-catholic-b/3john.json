  "translations": [
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.1",
      "source_sha256": "32fc8f26c5c27e23",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "The Elder, to the beloved Gaius, whom I love in truth."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.2",
      "source_sha256": "2ef5689f7065d83c",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "Beloved, I pray that you may prosper in all things, just as your soul prospers."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.3",
      "source_sha256": "afce16347b80f417",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "For I rejoiced greatly when brothers came and testified to your truth, how you walk in truth."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.4",
      "source_sha256": "9ca32d5770a08a47",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "I have no greater joy than this: to hear that my children walk in truth."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.5",
      "source_sha256": "f917641af8b55e07",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "Beloved, you act faithfully in what you do for the brothers, and that for strangers."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.6",
      "source_sha256": "1d410c2aea5950f2",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "They have testified to your truth before the churches. You do well to send them on their way in a manner worthy of God."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.7",
      "source_sha256": "59d5e64fd4534701",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "For they went out for the sake of the name of the Lord, and took nothing from the Gentiles."
    },
    {
      "chunk_id": "titus-catholic-b/3john#3John.1.8",
      "source_sha256": "da5de0d61ec70621",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 8,
      "text": "So we ought to receive such people, so that we may become fellow helpers of the truth."
    }
  ]
}
