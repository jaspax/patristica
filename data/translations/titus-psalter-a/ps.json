{
  "work_id": "titus-psalter-a/ps",
  "source_path": "titus-psalter-a/ps.json",
  "source_language": "oge",
  "target_language": "eng",
  "provenance": {
    "claude-opus-5-5/bulk-2026-10-12/2026-11-04": {
      "model": "claude-opus-5-5",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-11-04",
      "script": "__main__"
    }
  },
  "translations": [
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.4",
      "source_sha256": "cc88e7b5ec9e98e9",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "For we have seen the heavens, the works of your hands, the moon and the stars, which you created;"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.5",
      "source_sha256": "a4c28be74966d027",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "what is man, that you remember him, or the son of man, that you look upon him?"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.6",
      "source_sha256": "ad8a7a67326bdc02",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "You made him a little lower than your angels; you crowned him with glory and honor."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.7",
      "source_sha256": "08eb3f291eb0862b",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "You set him over the work of your hands; you put all things in subjection under his feet,"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.8",
      "source_sha256": "f050ba95dbee4028",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "sheep and oxen, all of them, and the beasts of the field as well,"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.9",
      "source_sha256": "a1fb12e9b1f0252d",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "the birds of the sky, the fish of the sea, all that pass through the places of the seas."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.8.10",
      "source_sha256": "420c66849dd79894",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "O Lord, our Lord, how wonderful is your name in all the earth!"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.2",
      "source_sha256": "55e4abb5797d8b16",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "I will confess you, O Lord, with all my heart, and I will tell of all your wonders."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.3",
      "source_sha256": "98547dbe8ace6a88",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "I will rejoice and be glad in you, and I will sing to your name, O Most High."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.4",
      "source_sha256": "29a9f85a61a54507",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "When all my enemies are turned back, they will grow weak and perish before your face,"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.5",
      "source_sha256": "1cb55316684b5725",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "for you have carried out your justice and my judgment; you sat upon thrones, O judge of righteousness."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.6",
      "source_sha256": "13c758a0efbed4db",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "You rebuked the nations, and the ungodly one perished; you blotted out their names forever and ever and ever."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.7",
      "source_sha256": "5ebecf5a66e73afc",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "The sword of the enemy has failed completely, and the cities were laid waste; their memory perished with a clamor;"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.8",
      "source_sha256": "ebd3a9e4f2244d30",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "but the Lord abides forever; he has prepared his throne for judgment."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.9",
      "source_sha256": "c2c58c307b6c070b",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "He himself will judge the world in righteousness, and the people in uprightness."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.10",
      "source_sha256": "20ce4503967040cf",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "The Lord became a refuge for the downtrodden, a helper in good time, in time of affliction."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.11",
      "source_sha256": "b367774a066456c0",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "Let all who know your name put their hope in you, for you have not forsaken those who seek you, O Lord."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.12",
      "source_sha256": "705c2479a4894361",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "Sing to the Lord, you who dwell in Zion; tell his deeds among the nations;"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.13",
      "source_sha256": "7264b5c068f8fb97",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "for he remembered to seek vengeance for their blood, and he did not forget the cry of the downtrodden."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.14",
      "source_sha256": "7298f2a1587d0af0",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "Have mercy on me, O Lord, and see how I am humbled by my enemies, you who lift me up from the gates of death,"
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.15",
      "source_sha256": "4e392c748b1dbb82",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "so that I may tell all your praises in the gates of the daughter of Zion; we will rejoice in your salvation."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.16",
      "source_sha256": "2a167d0f2a4767cc",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "The nations have sunk into the destruction they made; in the snare that they laid, their own foot was caught."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.17",
      "source_sha256": "ed89c869864535e2",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "The Lord is made known by carrying out his judgment; the sinner was caught in the works of his own hands."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.18",
      "source_sha256": "7deee1df24742aed",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "Let the sinners be turned back to hell, all the nations that have forgotten God."
    },
    {
      "chunk_id": "titus-psalter-a/ps#Ps.9.19",
      "source_sha256": "de12378c1fde4d8d",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-04",
      "group_size": 25,
      "text": "For the poor will not be forgotten forever, and the endurance of the downtrodden will not perish completely."
    }
  ]
}
