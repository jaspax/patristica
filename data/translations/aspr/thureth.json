      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-02",
      "group_size": 3,
      "text": "I am a book of consecration (a pontifical). May the Lord keep the one who adorned me so beautifully with ornaments."
    },
    {
      "chunk_id": "aspr/thureth#Thureth.3",
      "source_sha256": "100d4e5b0f25259e",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-02",
      "group_size": 3,
      "text": "Thureth had me made this way in thanks, for the praise and honour of Him who created light."
    },
    {
      "chunk_id": "aspr/thureth#Thureth.5.s1",
      "source_sha256": "6d7ced320dfb4254",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-02",
      "group_size": 3,
      "text": "He is mindful of every power that he is able to exercise on earth. May the Ruler of nations thank him for being willing to set aside many treasures, in remembrance, as an offering to the Lord;"
    },
    {
      "chunk_id": "aspr/thureth#Thureth.5.s2",
      "source_sha256": "d25f1df4040ae295",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-02",
      "group_size": 1,
      "text": "and he shall find eternal reward for all that he does rightly on earth."
    }
  ]
}
