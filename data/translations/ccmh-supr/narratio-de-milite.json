{
  "work_id": "ccmh-supr/narratio-de-milite",
  "source_path": "ccmh-supr/narratio-de-milite.json",
  "source_language": "chu",
  "target_language": "eng",
  "provenance": {
    "gpt-6.1-sol/bulk-2026-10-12/2026-10-29": {
      "model": "gpt-6.1-sol",
      "prompt_version": "bulk-2026-10-12",
