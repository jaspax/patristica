{
  "work_id": "coptic-scriptorium/pachomius_instructions",
  "source_path": "coptic-scriptorium/pachomius_instructions.json",
  "source_language": "cop",
  "target_language": "eng",
  "provenance": {
    "gpt-6.1-sol/bulk-2026-10-12/2026-10-12": {
      "model": "gpt-6.1-sol",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-10-12",
      "script": "scripts.embed_eval.translate"
    }
  },
  "translations": [
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0010",
      "source_sha256": "9f254ed87a166713",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "My son, emulate the lives of the saints and live according to their virtues."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0028",
      "source_sha256": "9d07ceb57ab4fce9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "But I destroyed them in the name of the Lord."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0029",
      "source_sha256": "1ab9d9c934a8380d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Immediately God's help comes to you, and you cast them away from you. Gladness surrounds you, and the glory of God walks with you."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0030",
      "source_sha256": "e1033c7d6d9481ce",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For gladness walks with the humble, and you will be satisfied as your soul desires."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0031",
      "source_sha256": "191b916cc11f5481",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For God's paths are humility of heart and gentleness."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0032",
      "source_sha256": "78cbc9cd6427ad69",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For he said, “On whom will I look except the humble and the gentle?”"
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0067",
      "source_sha256": "be9abb45caf01e14",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And you will speak evil of the ruler and those with fatherly authority."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0070",
      "source_sha256": "2e2ded47c69b27d5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For the distance between them amounts to forty-five stages, especially Daniel, at the bottom of the pit, as food for the wild beasts."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0084",
      "source_sha256": "2950331a0ac5b57f",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "When you sit among the brothers, do not put yourself forward with any foolish talk."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0111",
      "source_sha256": "2652e6d68950408b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Now the robber spoke a word on the cross. The Lord forgave his sins and took him into paradise."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0173",
      "source_sha256": "a9c9b2fe19c10497",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not move from one place to another, saying, “I will find God in this place or that one.”"
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0214",
      "source_sha256": "329964f4ddb6c934",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Be watchful, then, and remember your vows. Flee this [?] and separate yourself from it, lest it gouge out the eyes of your mind and make you blind, so that you do not know the road to the city where you dwell."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0218",
      "source_sha256": "c6d168007520983c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "But when your enemy—that is, the devil—provokes you, you incline your ear to him, and he pours filth into it. You open your heart and swallow the poison he has cast to you."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.000.0231",
      "source_sha256": "ddf9af1220e5949c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "You, for your part, are running after the captivity of the Chaldeans."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0020",
      "source_sha256": "1a9c0c76390789ab",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Follow the Lord in everything, so that you may find confidence in the Valley of Jehoshaphat."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0021",
      "source_sha256": "2d21821a46ee2565",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Let them also see you in the world as one of those rejected, but on the day of judgment let them find you clothed in glory."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0022",
      "source_sha256": "82e2cf36dd26d61d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not put your trust in any person for the comfort of your soul. Instead, cast your care upon the Lord, and he will sustain you."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0023",
      "source_sha256": "3ef84a851ca42c58",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Look at Elijah, who trusted in him beside the brook Cherith, where he sustained him through a raven."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0024",
      "source_sha256": "14eb31f2212b510c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Guard yourself very carefully against sexual immorality, for it has deceived many and cast them down."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0052",
      "source_sha256": "a27a727b980da806",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Your brother, however, will enter eternal life because he humbles himself before you for Jesus' sake."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0068",
      "source_sha256": "93101e062dbd62d0",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Look, my beloved, you know that we have clothed ourselves with Christ, who is good and loves humanity."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0077",
      "source_sha256": "f4cd7b6df8cc78d9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "We have been appointed to give light to the world. Do not let people stumble because of you. Let us maintain silence."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0109",
      "source_sha256": "7bd14f0ab573f719",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "We have been given patience and gentleness. If we preserve all these things, we will inherit the glory of God."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0154",
      "source_sha256": "843c0b21dc5dd73d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "If we have vowed to God to live as monks in love,"
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0163",
      "source_sha256": "71f22144ce49a0cd",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And you say, “I will do as Abraham did. I will reach up to God Most High, who created heaven and earth, declaring that I will take nothing from all that belongs to you, from a thread to a sandal strap.”"
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0172",
      "source_sha256": "e57f69a5f84718e8",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "For you are a chariot, being a horseman of self-control, with the lamp of God burning above you as you shine with the hidden light of the Spirit."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0174",
      "source_sha256": "9a16b23ad2275ee1",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "God will grant you the sobriety of the saints, and no idol will be found in your city."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0198",
      "source_sha256": "c88ead1ea3e2d525",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "And make yourself like a poor man carrying his cross, a companion of weeping."
    },
    {
      "chunk_id": "coptic-scriptorium/pachomius_instructions#CopScr.pachomius-instructions.001.0234",
      "source_sha256": "257a865ac634a5b6",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "Each one has made himself king on his own. They despise what is proper."
    }
  ]
}
