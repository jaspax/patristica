{
  "work_id": "coptic-scriptorium/life_eustathius_theopiste",
  "source_path": "coptic-scriptorium/life_eustathius_theopiste.json",
  "source_language": "cop",
  "target_language": "eng",
  "provenance": {
    "gpt-6.1-sol/bulk-2026-10-12/2026-10-12": {
      "model": "gpt-6.1-sol",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-10-12",
      "script": "scripts.embed_eval.translate"
    }
  },
  "translations": [
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0008",
      "source_sha256": "5f92f7e9d0658b5a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The people of old, about whom accounts were written in the holy Scriptures [?], so that those who hear may love what is good, and so that those who say, “It is impossible to live rightly now, in these last times,” may themselves turn to the strength of their virtues."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0038",
      "source_sha256": "00f4220687568cce",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A herd of deer appeared to him, grazing."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0051",
      "source_sha256": "1068e6cc6b4034a5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "When the commander approached him, with no one beside him, he stood looking in every direction."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0062",
      "source_sha256": "2f8e260cc2589888",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“O Placidus, why are you chasing me?”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0074",
      "source_sha256": "41e97de37580a01b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“And what kind of voice is this that I have heard?”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0075",
      "source_sha256": "c6461e25ab515768",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“Reveal yourself to me, you who are speaking with me, so that I may believe in you.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0076",
      "source_sha256": "fbae50c9454866c3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The Lord said to him, “Take courage, Placidus.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0077",
      "source_sha256": "001a545a8dd8db09",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“I am Jesus Christ, the Son of the living God, who created heaven and earth when they did not exist.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0078",
      "source_sha256": "1968a994f634bdbf",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“I created all matter, which is beyond counting.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0096",
      "source_sha256": "8cef35cdbd729df5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For he alone is the true God, who saves those who put their hope in him."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0100",
      "source_sha256": "b5c2b7b8b38ef2e2",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“Come now, during the night, and let us go and receive baptism from the chief priests of the Christians, as he commanded you.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0166",
      "source_sha256": "d35e570cb7d21eb9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "They were amazed at what had happened to him."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0172",
      "source_sha256": "d5b278226fff729a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The captain of the ship was a savage barbarian."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0176",
      "source_sha256": "9049fa4647368b0e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He seized his wife because of the fare."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.000.0222",
      "source_sha256": "b4c0dbcf46bef668",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Job, for his part, had his children there comforting him."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0010",
      "source_sha256": "7a1d1bb4a478dff7",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He recognized them by the way they walked."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0026",
      "source_sha256": "e94b6bca4fad7c76",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He said to them, “For what reason are you looking for him?”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0027",
      "source_sha256": "e469f9b349c7a0f0",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "They said to him, “He is our friend, and we have wanted to meet him for many years.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0028",
      "source_sha256": "71ba8ad35a13d4f3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He said to them, “I do not know the man.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0029",
      "source_sha256": "69f0e17b0352b722",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“Then make yourselves comfortable with me, for it is getting late. Rest with me here in the place where I am staying.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0030",
      "source_sha256": "d0ce78c399b35b04",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "“For I too am a stranger.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0055",
      "source_sha256": "5f24ec7edbef35b2",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Everyone in the village walked with him, seeing him off."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0068",
      "source_sha256": "f1b56beee16f3706",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He wrote a letter of this kind to every city, directing them to recruit men and examine them to see whether they were suitable, and to make them soldiers."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0091",
      "source_sha256": "bafb172b0a5177ed",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "They boarded a ship with us. I did not know where we were going."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0108",
      "source_sha256": "ded4ccd28b4df784",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "While she was still saying these things, she began to recognize him as her husband by the distinguishing marks she knew on him. When she recognized him, she was afraid to question him."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0119",
      "source_sha256": "0596be9008cbd1ec",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "He got up and immediately hurried to her. He said to her, “I am Eustathius, the one being spoken of.” And they kissed one another with a spiritual kiss."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0121",
      "source_sha256": "5e873072eeddcdca",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "His wife said to him, “Where are my children?”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0125",
      "source_sha256": "8f3f4c931c0e113d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "She answered, saying, “Yesterday, while I was still sitting in the garden, I heard two young men talking with one another about their childhood experiences and recounting what had happened to them.”"
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0140",
      "source_sha256": "1d9859095016542c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "Another king, whose name was Hadrian, took his place. He was exceedingly impious, more so than all the kings who had come before him."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0171",
      "source_sha256": "97fdb4343d43675e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "You have endured many trials. Now, then, do not be afraid. Come up to this place in peace and receive the imperishable crown."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0179",
      "source_sha256": "c66032c5a435ed81",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "And when they brought them out, they laid them on the ground. Great fear and amazement seized everyone standing around them, and the bodies of the saints shone like snow."
    },
    {
      "chunk_id": "coptic-scriptorium/life_eustathius_theopiste#CopScr.life-eustathius-theopiste.001.0184",
      "source_sha256": "142004ea5cb02bbf",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 7,
      "text": "And after the persecution [?], they also built a martyrs’ shrine for them, celebrating in it with hymns and songs of praise, according to the custom of the Christians."
    }
  ]
}
