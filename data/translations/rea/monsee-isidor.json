      "source_sha256": "83dab274baf926ad",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 25,
      "text": "[?] to you [?]"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.34.s12",
      "source_sha256": "d5df1e99a65cf774",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 25,
      "text": "[?] of the kingdom of the earth [?]"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.34.s13",
      "source_sha256": "d92cf658388eeaee",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 25,
