      "chunk_id": "rea/monsee-isidor#Mons.36.s20",
      "source_sha256": "2609364b90810517",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 7,
      "text": "[?] because the title of his [?]"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.36.s21",
      "source_sha256": "7b720dd57a3b0ca2",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 7,
      "text": "[?] [over] his head Pilate wrote [?]"
