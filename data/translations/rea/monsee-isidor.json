      "chunk_id": "rea/monsee-isidor#Mons.35.s53",
      "source_sha256": "d01121a4b238988b",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "that the Son and the Holy Spirit"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.35.s54",
      "source_sha256": "89d6fafe64e2474a",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "are God."
    },
