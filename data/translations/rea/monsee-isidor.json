      "chunk_id": "rea/monsee-isidor#Mons.36.s9",
      "source_sha256": "3c9084e5bdf9275e",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "will be his"
