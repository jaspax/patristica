      "chunk_id": "rea/monsee-isidor#Mons.36.s12",
      "source_sha256": "18ce42ec01f9550e",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 7,
      "text": "[?] was [?]"
    },
