      "chunk_id": "rea/monsee-isidor#Mons.35.s47",
      "source_sha256": "303f6ac46fead4db",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "is God."
