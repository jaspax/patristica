      "chunk_id": "rea/monsee-isidor#Mons.36.s1",
      "source_sha256": "6fd56d528d718b24",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "And will be"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.36.s2",
      "source_sha256": "a137f17a19a09cbe",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "[?]"
    },
