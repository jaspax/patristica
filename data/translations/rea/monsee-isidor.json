      "chunk_id": "rea/monsee-isidor#Mons.35.s48",
      "source_sha256": "9a4125df0238a497",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "Here it speaks about the signification of the three Persons of God."
