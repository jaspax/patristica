      "chunk_id": "rea/monsee-isidor#Mons.36.s18",
      "source_sha256": "9bc5758de1c984f2",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "to us"
