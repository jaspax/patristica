      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 25,
      "text": "Shall I be [?]. Of all this the testimony is to [?]"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.33.s20",
      "source_sha256": "ace447af11be4f3b",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-02",
      "group_size": 25,
      "text": "[?] does not believe [?]"
    },
    {
      "chunk_id": "rea/monsee-isidor#Mons.33.s21",
      "source_sha256": "e3f094f7ca36d8a9",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-02",
      "group_size": 25,
      "text": "[?] that for him [one of] two [?]"
