      "chunk_id": "rea/monsee-isidor#Mons.36.s11",
      "source_sha256": "375a8484a5387254",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 7,
      "text": "the prophet certainly [?]"
