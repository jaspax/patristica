      "chunk_id": "rea/monsee-isidor#Mons.36.s10",
      "source_sha256": "3dd438f955148c1f",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 25,
      "text": "commanded"
