      "chunk_id": "rea/monsee-isidor#Mons.36.s19",
      "source_sha256": "23a54c8defb0435f",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 7,
      "text": "[?] born. But the Son [is] none other than the Son of God. His lordship, because before [?] in his own [?]"
    },
