      "chunk_id": "rea/monsee-isidor#Mons.36.s17",
      "source_sha256": "3d56e5ae6147a118",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-07",
      "group_size": 24,
      "text": "having become"
