      "chunk_id": "rea/monsee-isidor#Mons.36.s4",
      "source_sha256": "8b458cf997d19a53",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-09",
      "group_size": 25,
      "text": "named"
