{
  "work_id": "celt/regula-choluimb-chille",
  "source_path": "celt/regula-choluimb-chille.json",
  "source_language": "sga",
  "target_language": "eng",
  "provenance": {
    "claude-opus-5-5/bulk-2026-10-12/2026-11-12": {
      "model": "claude-opus-5-5",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-11-12",
      "script": "__main__"
    }
  },
  "translations": [
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.1",
      "source_sha256": "30af7f45a209fb8d",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Be alone in a separate place near a chief city, if your conscience is not ready to be in common with the crowd."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.2",
      "source_sha256": "cb4628887f020fcd",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Be always naked in imitation of Christ and the Evangelists."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.3.s1",
      "source_sha256": "6324c06333a88114",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Whatever little or much you possess of anything, whether place, clothing, drink or food, let it be used only by the command of your senior and with his counsel."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.3.s2",
      "source_sha256": "bdfa271d19c7c492",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "For it is not safe for a devout person to live in any way by his own free judgement."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.4",
      "source_sha256": "086c4d8f960a7530",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "A fully enclosed place around you, with a single door."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.5",
      "source_sha256": "e2869f4118053b13",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Let a few devout people who talk of God and his testament come to visit you on feast days, to strengthen you in the commandments of God and the stories of Scripture."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.6.s1",
      "source_sha256": "c62f280687e783f5",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "But other people, who would talk with you of idle or worldly words, or who grumble about what they cannot cure or prevent,"
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.6.s2",
      "source_sha256": "fc9a7b3a582964e1",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "and who would rather cause you grief, whether they are among friends or enemies, you shall not admit to you; but let them take a blessing if they deserve it."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.7",
      "source_sha256": "654253f38e0e13f9",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Let your servant, who is to attend you always, be a dutiful, devout man who does not gossip. Let your labour be measured and your food similar [?]; that is what is safe."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.8",
      "source_sha256": "8621dde398286a1a",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Your power should be at the will of someone else. A way of life that is devout."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.9",
      "source_sha256": "75d24de5e6dc0eed",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "A mind ready for red martyrdom."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.10",
      "source_sha256": "87b211e6b23866e6",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "A mind steadfast and constant for white martyrdom."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.11",
      "source_sha256": "9bcb7047ef291c9d",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Forgiveness from the heart to everyone."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.12",
      "source_sha256": "8a7714434a1905d9",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Constant prayer for those who trouble you."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.13",
      "source_sha256": "6fff9cf50c78558a",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Diligence in singing the office for the dead, as if every faithful dead person were a particular friend of yours."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.14",
      "source_sha256": "eeb1551fc862071a",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Hymns for souls, sung standing."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.15",
      "source_sha256": "40fa015770405625",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Keep your vigils regularly from one hour to the next, at the will of someone else."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.16",
      "source_sha256": "7f5596578939a753",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Three tasks in the day, namely prayer, work and reading."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.17.s1",
      "source_sha256": "5e299e92af8d20d9",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Divide your work into three: namely, for your own benefit and the benefit of your place, for whatever it truly needs; another part for the share of the brethren;"
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.17.s2",
      "source_sha256": "7efc04aa085acfeb",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "another part to help your neighbours, that is, by teaching or writing or any useful work, so that you are not found empty-handed,"
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.17.s3",
      "source_sha256": "138e5c8826150b65",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "that is, as the Lord says: 'You shall not appear before me empty'; that is, everything in its proper order."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.18",
      "source_sha256": "3f6661e234dba0d6",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "For no one will be crowned except the one who has striven lawfully; that is, pursue almsgiving before everything."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.19",
      "source_sha256": "3f723e0704c3489c",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Do not take food until you are hungry."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.20",
      "source_sha256": "591b28c1c2555006",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Do not sleep until you feel it is needed."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.21",
      "source_sha256": "473c69d2d5760756",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 25,
      "text": "Do not speak to anyone except on necessary business."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.22",
      "source_sha256": "ecdac544a9358f65",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 5,
      "text": "Whatever surplus or excess [?] you have of your own share of food or of clothing [?], give it out of compassion to the brethren who lack it, or to the poor in general."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.23",
      "source_sha256": "069d0300a37c4247",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 5,
      "text": "Love of God with all your heart and with all your strength."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.24",
      "source_sha256": "6440da7a24a2a325",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 5,
      "text": "Love of your neighbour as yourself."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.25",
      "source_sha256": "343b5d34f1b5b1ac",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 5,
      "text": "Keeping to the commandments of God at all times."
    },
    {
      "chunk_id": "celt/regula-choluimb-chille#RegCol.26",
      "source_sha256": "c5a40e4f8d39d2cd",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 5,
      "text": "Your measure of prayer: until your tears come. Or your measure of useful work, or of prostrations: until your sweat often comes, if your tears do not come easily."
    }
  ]
}
