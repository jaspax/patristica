      "group_size": 4,
      "text": "Columba sang:"
    },
    {
      "chunk_id": "celt/colum-cilles-lieblingsstatten#ColLieb.1",
      "source_sha256": "52049ec7e5909150",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 4,
      "text": "The three dearest things I have left behind in the populous world: Durrow, Derry, the high hill of angels, and the land of Lugaid."
    },
    {
      "chunk_id": "celt/colum-cilles-lieblingsstatten#ColLieb.2",
      "source_sha256": "1944b886b864e85e",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 4,
      "text": "Gartan, Tulach and Tory, and Derry of Ethne, the dwelling of the saints; truly dear is the other Derry."
    },
    {
      "chunk_id": "celt/colum-cilles-lieblingsstatten#ColLieb.3",
      "source_sha256": "8d1c675a1e559593",
      "provenance": "claude-opus-5-5/bulk-2026-10-12/2026-11-12",
      "group_size": 4,
      "text": "If the King of the angels and of the sun permitted it, I would like to make my home in Gartan rather than in any of the three. Three [i.e. the refrain \"Three dearest things…\" is repeated]."
    }
  ]
}
