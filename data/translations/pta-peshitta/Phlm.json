  "translations": [
    {
      "chunk_id": "pta-peshitta/phlm#Phlm.1.5",
      "source_sha256": "9c048f2459f3520b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "Indeed, since I heard of your faith and the love you have for our Lord Jesus and for all the saints,"
    },
    {
      "chunk_id": "pta-peshitta/phlm#Phlm.1.8",
      "source_sha256": "991788fd7718fde4",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "For this reason I have great boldness in Christ to command you to do what is right."
    },
    {
      "chunk_id": "pta-peshitta/phlm#Phlm.1.9",
      "source_sha256": "68833e42edce5d98",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "But because of love, I appeal to you—I, Paul, who am an old man, as you know, and now also a prisoner of Jesus Christ."
    },
    {
      "chunk_id": "pta-peshitta/phlm#Phlm.1.20",
      "source_sha256": "ce75d49e0ebaec16",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 4,
      "text": "Yes, my brother, let me find refreshment through you in our Lord. Refresh my heart in Christ."
    }
  ]
}
