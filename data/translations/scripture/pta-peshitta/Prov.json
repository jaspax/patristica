{
  "work_id": "scripture/pta-peshitta/prov",
  "source_path": "scripture/pta-peshitta/Prov.json",
  "source_language": "syc",
  "target_language": "eng",
  "provenance": {
    "gpt-6.1-sol/bulk-2026-10-12/2026-10-12": {
      "model": "gpt-6.1-sol",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-10-12",
      "script": "scripts.embed_eval.translate"
    }
  },
  "translations": [
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.1.7",
      "source_sha256": "c531764735457ee9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The beginning of wisdom is the fear of the Lord, but the wicked despise knowledge and discipline."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.1.16",
      "source_sha256": "b7af9bf3b11faa0f",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For their feet run toward evil, and they hurry to shed innocent blood."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.1.23",
      "source_sha256": "b618973a26fe6af8",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "If you turn to my correction, I will pour out my spirit to you and make my words known to you."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.2.12",
      "source_sha256": "82b8624fa50f9137",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "So that you may be rescued from evil paths and from men who speak perverse things."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.2.21",
      "source_sha256": "fc90d17eec364127",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For the upright will dwell in the land, and those who are blameless will remain in it."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.3.8",
      "source_sha256": "49943cf62863e64a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "So that it may be healing for your flesh and nourishment for your bones."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.3.19",
      "source_sha256": "8150693502e44ddc",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The Lord laid the earth's foundations by his wisdom and established the heavens by his understanding."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.3.21",
      "source_sha256": "83dce874c52293e3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "My son, do not regard keeping my teaching and my counsel as something trivial."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.4.9",
      "source_sha256": "b2bf8e1cba23ea06",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "She will place the beauty of favor on your head and satisfy you with a crown of glory."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.4.15",
      "source_sha256": "683f3c2bd7c31c54",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not pass through the place where they dwell, but turn aside and pass away from it."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.4.22",
      "source_sha256": "aeea5555059c18d1",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For they are life to whoever finds them and healing for his whole body."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.5.9",
      "source_sha256": "c1ca7b9ce77a2dc7",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "So that you do not give your strength to others and your years to those who show no mercy."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.5.12",
      "source_sha256": "f0ba8eba092fafbe",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And you will say, “Why did I hate discipline, and why did my heart reject correction?”"
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.5.23",
      "source_sha256": "a6dbb0bee41f89f9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He will die without discipline, and through his great folly he will go astray."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.6.11",
      "source_sha256": "8519c7ba69a9f852",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Poverty will come upon you, and need will overtake you like a vigorous man."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.6.12",
      "source_sha256": "0828dd0411e82ae5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A foolish person, a wicked man, goes about oppressing others."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.7.3",
      "source_sha256": "d36d9cbade225e60",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Tie them around your neck and write them on the tablets of your heart."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.8.2",
      "source_sha256": "5112f8d00a15eb2f",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For wisdom is on the tops of the heights; she stands at the crossroads and beside the paths."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.8.7",
      "source_sha256": "eedbf17e08236448",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For my mouth speaks truth, and lying lips are unclean in my sight."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.8.17",
      "source_sha256": "271e9623088cd46a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "I love those who love me, and those who seek me will find me."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.8.32",
      "source_sha256": "bf38f3496d6fc283",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Now, children, listen to me. Blessed is the one who keeps my ways."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.9.11",
      "source_sha256": "f2e9fb60979e2ec4",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For through her your days will increase, and years of life will be added to you."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.9.18",
      "source_sha256": "4ade6a9a9c139b04",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "He does not know that mighty men perish with her, and that all who visit her are in the depths of Sheol. But leap away and do not linger in that place, and do not let your eye be caught by it. For in this way you will cross foreign waters and pass over a foreign river. Turn aside from foreign waters, and do not drink foreign waters, for many days and years of life will be added to you."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.10.1",
      "source_sha256": "7d9f69e9902b1e05",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A wise son makes his father glad, but a son who lacks understanding brings shame to his mother."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.10.8",
      "source_sha256": "cf5700b3e1e6a221",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "One whose heart is wise will accept a command, but one whose lips are contemptuous will be caught."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.12.14",
      "source_sha256": "7359f4300b81ab8b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A good man will be satisfied by the fruit of his mouth, and everyone is repaid according to the work of their hands."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.13.9",
      "source_sha256": "24e6a9d47346d3f3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The light of the righteous will rejoice, but the lamp of the wicked will go out."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.13.19",
      "source_sha256": "7302280f7eb17a78",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A beautiful desire delights the soul, but the impurity of the wicked is separated from knowledge."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.14.12",
      "source_sha256": "72ef8e3b73dabd50",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "There is a way that people think is right, but its paths are paths of death."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.14.13",
      "source_sha256": "1a043bd0ce1cfa92",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Even in laughter the heart may ache, and the end of its joy is sorrow."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.14.14",
      "source_sha256": "7e0975df887f5fa7",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Someone whose heart is insolent will be satisfied by his own ways, and a good man will be satisfied by his own reverence."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.14.30",
      "source_sha256": "6ffe6c41ad494cb7",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Someone who cools his anger is a healer of his own soul, but envy rots the bones."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.14.33",
      "source_sha256": "be425c08e7e42711",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Wisdom will dwell in the heart of the upright, but in the heart of fools it will not be known."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.15.7",
      "source_sha256": "ea8f2f3f5412e24b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The lips of the wise speak knowledge, but the hearts of fools are not upright."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.15.29",
      "source_sha256": "7a0f03cdbb20479c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The Lord is far from the wicked, but he hears the prayer of the righteous."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.16.5",
      "source_sha256": "a91377b44413f19e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Everyone who is proud in heart is unclean before the Lord, and someone who stretches out his hand against his neighbor will not be cleared of wrongdoing."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.16.21",
      "source_sha256": "5378533987c5f1b8",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Someone wise in heart knows understanding, and someone whose lips are reverent increases learning."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.17.2",
      "source_sha256": "94d17720be7c4016",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A sensible servant will rule over a son who brings shame, and will share the inheritance among the brothers."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.17.16",
      "source_sha256": "2227211103e29069",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Why does wealth go to a fool who has no heart to acquire wisdom?"
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.18.19",
      "source_sha256": "d9077da4f3dbdefb",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A brother helped by his brother is like a city because of its strength, and its locks are like the bar of a fortress."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.18.24",
      "source_sha256": "c103be081b20c760",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "There are friends who are friends, and there is a friend who stays closer than a brother."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.19.12",
      "source_sha256": "464a9496bcaf8b76",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The king's anger roars like a lion, but his favor is like dew on the grass."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.20.16",
      "source_sha256": "0dd15ce3ec159965",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Take the cloak of someone who guarantees a stranger's debt, and take his pledge on behalf of strangers."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.20.17",
      "source_sha256": "2c1ac86721de68c0",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Bread gained through deceit tastes sweet to a man, but afterward his mouth will be filled with gravel."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.20.26",
      "source_sha256": "3541309c5da2b47e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A wise king scatters the wicked and rolls a wheel over them."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.21.10",
      "source_sha256": "f3c79bcb1855f54d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The soul of the wicked person is not seen in the eyes of his companions."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.22.16",
      "source_sha256": "56ad680dd920c849",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Someone who oppresses the poor increases his own trouble, and someone who gives to the rich brings loss upon himself."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.23.11",
      "source_sha256": "fae2037c09756a28",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For their redeemer is strong, and he will plead their case against you."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.23.16",
      "source_sha256": "6db03e47df4c8c2d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "My innermost being will rejoice when your lips speak what is right."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.23.19",
      "source_sha256": "73365e53a34cb1ad",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Listen, my son, and be wise, and let my mind rejoice in your heart."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.23.21",
      "source_sha256": "03237cc2cc2ee401",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "For whoever gets drunk on wine and gorges on meat will perish, and whoever sleeps will wear sackcloth."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.24.6",
      "source_sha256": "64028fd1e60df60b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "War is waged through strategy, and victory comes through many advisers."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.24.10",
      "source_sha256": "7a064990a8920806",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Evil will lead the wicked away on the day of distress."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.24.11",
      "source_sha256": "7fe32595afe46ebd",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Rescue those who are being led to death, and do not hold back from redeeming those who are seized for slaughter."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.24.12",
      "source_sha256": "511f9f7e3aea59d7",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "If you say, “I do not know,” know that God examines the thoughts of the heart. The one who guards your life knows, and he repays each person according to their deeds."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.24.31",
      "source_sha256": "06d5ab3c187f3d7b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "It grew up and was entirely filled with woodland; moles covered its surface, and its stone walls had collapsed."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.24.34",
      "source_sha256": "6fbfc03269e67472",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Poverty will go before you, and need will overtake you like an armed man."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.25.27",
      "source_sha256": "2e9e5730fb1cb28e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Eating much honey is not good, nor is searching out words of praise."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.26.15",
      "source_sha256": "b17b5095dc45086a",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "The lazy person who hides his hands in his lap finds it tiring to bring them to his mouth."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.26.17",
      "source_sha256": "7f32b9d55b9da6a6",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Whoever meddles in a dispute that is not his own is like someone who grabs a dog by its ears."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.26.20",
      "source_sha256": "3698a8befb27406c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "When there is no wood, the fire goes out; where there is no troublemaker, quarreling becomes quiet."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.27.25",
      "source_sha256": "7817e275096b2fc5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "The hay flourished, the new grass appeared, and the grass of the mountains was gathered."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.29.5",
      "source_sha256": "d6613a24360ab653",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "A man who quarrels with his neighbor spreads a net across his path."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.29.11",
      "source_sha256": "6741e2b6fffa11cf",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "A fool pours out all his anger, but a wise person considers matters in his mind."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.29.21",
      "source_sha256": "87b0b9eecbf36300",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Whoever is pampered from his youth will become a servant, and in the end he will groan."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.30.3",
      "source_sha256": "90ca42ebb77a33e2",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "I have not known wisdom, nor have I learned the knowledge of the holy ones."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.30.7",
      "source_sha256": "c74132751876892d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "I have asked two things of you; do not withhold them from me before I die."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.30.29",
      "source_sha256": "eece80c0f789a21d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "There are three whose steps are stately, and four that walk well."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.31.9",
      "source_sha256": "00735e01d88cae0d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "Open your mouth with a just judgment, and judge the cases of the poor and the unfortunate."
    },
    {
      "chunk_id": "scripture/pta-peshitta/prov#Prov.31.15",
      "source_sha256": "6fc7db22de93d6de",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 20,
      "text": "She rose in the night and gave food to her household and work to her maidservants."
    }
  ]
}
