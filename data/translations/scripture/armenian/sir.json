{
  "work_id": "scripture/armenian/sir",
  "source_path": "scripture/armenian/sir.json",
  "source_language": "hye",
  "target_language": "eng",
  "provenance": {
    "gpt-6.1-sol/bulk-2026-10-12/2026-10-12": {
      "model": "gpt-6.1-sol",
      "prompt_version": "bulk-2026-10-12",
      "date": "2026-10-12",
      "script": "scripts.embed_eval.translate"
    }
  },
  "translations": [
    {
      "chunk_id": "scripture/armenian/sir#Sir.1.25",
      "source_sha256": "cd8e7146012712ca",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The roots of wisdom are fear of the Lord, and its paths lead to long life."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.3.2",
      "source_sha256": "d5af448d129c14cf",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Children, listen to me, your father, and do this so that you may live."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.3.13",
      "source_sha256": "e2d5130e74afa93c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For a man's glory rests on honoring his father, and a son's disgrace is dishonoring his mother."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.3.20",
      "source_sha256": "2b022627ea49ded9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The greater you are, the more humbly you should conduct yourself, so that you may find favor before the Lord."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.4.11",
      "source_sha256": "5e821ac6bd546001",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And you will become a son of the Most High."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.5.8",
      "source_sha256": "41961819b64f8136",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "My child, do not delay turning from your sins to the Lord."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.5.10",
      "source_sha256": "bbca198668922622",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not put your hope in unjustly acquired treasures, for they will not help you on the day of wrath."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.5.11",
      "source_sha256": "c6e491657810b3dc",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not walk along every path, for this is the way of a sinner and a double-tongued person."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.5.12",
      "source_sha256": "a664b1e27c870d30",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Let good counsel be firmly established in your mind, and let the same word remain in your mouth."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.5.13",
      "source_sha256": "d53e9b62690231f5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Be quick to listen and patient in answering."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.6.1",
      "source_sha256": "f7fb215eb614278f",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A bad name inherits shame and dishonor, and a sinful person inherits double-tongued speech."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.6.27",
      "source_sha256": "10c59207265d79cb",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Approach her with your whole mind, and keep her ways with all your strength."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.6.28",
      "source_sha256": "c1285538aec09312",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Seek and investigate, and make it known to yourself."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.6.37",
      "source_sha256": "f78cd4f068b05326",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Meditate on the Lord's commands, and he will strengthen your heart and give you a desire for wisdom."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.7.5",
      "source_sha256": "93a45256a5c2f7a8",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not make a show of your words before kings."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.7.15",
      "source_sha256": "f670ff95d646bf1f",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not show off among elders, and do not repeat your words in your prayer."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.7.22",
      "source_sha256": "5500f45759e04464",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not anger a faithful servant who works for you, and do not scorn a hired worker who has devoted himself to your service."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.8.22",
      "source_sha256": "4d888430a5e58004",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not open your heart to everyone, lest they thank you without reason."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.9.14",
      "source_sha256": "72637daf8803167e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not abandon an old friend, lest the new one prove unequal to him."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.10.6",
      "source_sha256": "5c02d35bbf3a3459",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not hold a grudge against your neighbor for any offense. My child, keep away from falsehood and sins."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.10.24",
      "source_sha256": "637f23126632701c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Among brothers, the eldest is honored, but the one who fears the Lord is more honored than he."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.10.32",
      "source_sha256": "d08ff9c32a357725",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For who will justify someone who sins against himself? Who will honor someone who dishonors his own life?"
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.11.7",
      "source_sha256": "7707b0b283220bb3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Ask first, and do not slander; understand, and then speak."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.11.33",
      "source_sha256": "0826e8afaeca4ebd",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Just as a dog snatches things wherever it enters, so a lawless person destroys and causes turmoil wherever he goes."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.13.1",
      "source_sha256": "69a038269c626f50",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "For whoever comes near pitch is smeared with it, and whoever trusts such a person is corrupted."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.13.20",
      "source_sha256": "5ec4ca5f642214f2",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Each kind goes to its own kind, and a person to one like himself."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.13.24",
      "source_sha256": "bf07c54c3c7fbaab",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The arrogant person recoils from the humble, and likewise the rich person from the poor."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.14.11",
      "source_sha256": "fde5222f303130af",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "My child, while you are able, treat yourself well."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.16.4",
      "source_sha256": "6148671a278f70b5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And consider it better to be childless than to have ungodly children."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.16.17",
      "source_sha256": "b628742a64a6194d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Or what am I among so many creatures?"
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.17.18",
      "source_sha256": "c8cd4a1ecd921dc5",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And a person's righteousness and grace are sealed before him."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.18.8",
      "source_sha256": "76349d7d8cf31bbd",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The number of a person's days is perhaps a hundred years. But like a drop from the sea and a grain of sand, so are a hundred years among the sum of the ages. For a thousand years in this world are not even like one day in the world of the righteous."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.18.22",
      "source_sha256": "0970266375a767b2",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Do not wait until the hour of death to become righteous. And do not delay the vow you have made; prepare to fulfill it."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.19.2",
      "source_sha256": "673759234dafa536",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Women and wine destroy wisdom; the reckless person will perish."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.19.5",
      "source_sha256": "78c123d355023b9c",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "One who is shameless in mind will be [?] to many."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.20.12",
      "source_sha256": "9723028aa8b49c85",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And there are those who buy something great for little, and there are those who suffer a loss seven times greater."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.20.28",
      "source_sha256": "26cbe8b853e782b3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The words of a person's own heart bring dishonor upon him, and his shame will come upon him. My child, keep my words and attend to them day and night. For even a true son and an heir of noble birth who does not renew and advance the greatness of his ancestors is a great shame and reproach to his forefathers, and a new curse.\nProverbial Sayings, Second."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.21.5",
      "source_sha256": "3ea03ce592cce195",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Insults and punishments will destroy greatness; likewise, the houses of the arrogant will be overthrown."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.21.14",
      "source_sha256": "c2972aa76b8e37f9",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A person who lacks discernment does not accept instruction."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.21.30",
      "source_sha256": "1d8e7a34a2da8625",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "The ungodly person curses Satan and does not realize that he is cursing himself."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.23.14",
      "source_sha256": "9348e70b3c64d80e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And even if he swore needlessly, he will not be justified."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.24.38",
      "source_sha256": "88efb5787325fd0e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Those who came first could not reach it, and those who came last did not even understand its end."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.25.6",
      "source_sha256": "abd279a3b6bf1d32",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "How beautiful is the wisdom of the elderly!"
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.25.11",
      "source_sha256": "5d9805853a44d436",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And one who lives with a wise wife, and one who has not yoked an ox and a donkey together, and one who has not stumbled with his tongue and has not served anyone unworthy."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.25.22",
      "source_sha256": "d51900231b378c62",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "There is no head more wicked than a snake's, and no enmity more wicked than a woman's."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.26.3",
      "source_sha256": "a5129b08bbc82814",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A wise wife is a good portion and the share of those who fear God."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.27.4",
      "source_sha256": "5f77ce4ae78bcf4f",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "And if they do not hold firmly to the fear of the Lord, their houses will quickly collapse."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.27.6",
      "source_sha256": "612454cd7847fcb7",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "A furnace fires earthen vessels, and a person's testing is in his thoughts."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.27.29",
      "source_sha256": "02affac061672cdc",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "One who digs a pit for a friend will fill it himself."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.28.29",
      "source_sha256": "7b606f3ffb2cdc01",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 25,
      "text": "Tie up your silver and gold, and establish a measure and a weight for your words. Set a door at your mouth."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.29.14",
      "source_sha256": "7a9a6772bccbab31",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "Give your treasures to the poor according to the commandment."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.30.4",
      "source_sha256": "b4203696a6701d26",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "His father died, yet he is not dead, for he left someone like himself in the world."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.30.15",
      "source_sha256": "bd727c323029b92b",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "Health and healing are better than gold and great wealth. A word of instruction concerning food."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.31.41",
      "source_sha256": "9dcf199e579eacc8",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "Do not rebuke your companion at a drinking party."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.34.9",
      "source_sha256": "3c1590f80a26c56d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "A discerning man came to know many things, and wisdom was sent forth from him."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.34.28",
      "source_sha256": "f23939cfb14b1896",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "What benefit do they produce except toil?"
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.35.17",
      "source_sha256": "e5662fd0c791a5f0",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "And he does not despise the widow or the orphan when he pours out his prayers before him."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.36.11",
      "source_sha256": "160cec89934d0b08",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "Let the enemy perish in the fury of fire, and let those who torment your people meet with ruin and destruction."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.39.2",
      "source_sha256": "a5f25d79ee7d4b0e",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "He shall preserve the sayings of renowned men."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.39.13",
      "source_sha256": "8f2d0a500149d88d",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "And his name shall live on, and let his memory not be erased."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.39.25",
      "source_sha256": "be9586a7ac7d5612",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "For he has looked from eternity to eternity, and nothing is astonishing in his eyes."
    },
    {
      "chunk_id": "scripture/armenian/sir#Sir.43.13",
      "source_sha256": "fc8925afe06dbba3",
      "provenance": "gpt-6.1-sol/bulk-2026-10-12/2026-10-12",
      "group_size": 12,
      "text": "The hand of the Most High established the tents of heaven."
    }
  ]
}
