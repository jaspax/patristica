    "work_id": "armenian/3john",
    "canonical_ref": "3John.1.4",
    "language": "hye",
    "text": "Մեծ եւս ինչ ուրախութիւն քան զայս ոչ ունիմ զի լսեմ եթէ իմ որդեակքն ճշմարտութեամբ գնան",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
