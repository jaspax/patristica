    "work_id": "armenian/3john",
    "canonical_ref": "3John.1.5",
    "language": "hye",
    "text": "Սիրելի հաւատարիմ գործես զայդ զոր եթէ առնիցես առ եղբարս զդոյն եւ առ օտարս",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
