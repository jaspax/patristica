    "work_id": "armenian/3john",
    "canonical_ref": "3John.1.3",
    "language": "hye",
    "text": "Յոյժ ուրախ եղէ ի գալ եղբարց եւ լինել վկայ քոյոյ ճշմարտութեանդ որպէս գնասդ դու ճշմարտութեամբ",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
