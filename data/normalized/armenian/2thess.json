  },
  {
    "chunk_id": "armenian/2thess#2Thess.2.4",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.4",
    "language": "hye",
    "text": "հակառակորդն հպարտացեալ ի վերայ ամենայնի որ անուանեալ իցէ Աստուած կամ պաշտօն մինչեւ նստել նմա ի տաճարին Աստուծոյ եւ ցուցանել զանձն թէ Աստուած իցէ",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
