    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.9",
    "language": "hye",
    "text": "որոյ գալուստն ըստ ազդեցութեան Սատանայի է ամենայն զօրութեամբ եւ նշանօք եւ արուեստիւք ստովք",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
