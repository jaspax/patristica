  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.11",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.11",
    "language": "hye",
    "text": "Յոր եւ աղօթս առնեմք վասն ձեր յամենայն ժամ զի զձեզ արժանիս արասցէ կոչմանն ձերում Աստուած մինչեւ լցցէ զամենայն հաճութիւն բարութեան եւ զգործս հաւատոցն զօրութեամբ",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
