  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.10",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.10",
    "language": "hye",
    "text": "յորժամ գայցէ փառաւոր լինել ի մէջ սրբոց իւրոց եւ սքանչելի ի մէջ ամենայն հաւատացելոց զի հաւատարիմ եղեւ վկայութիւնն մեր ի վերայ ձեր յաւուր յայնմիկ",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
