    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.7",
    "language": "hye",
    "text": "եւ ձեզ նեղելոցդ հանգիստ ընդ մեզ ի յայտնութեանն Տեառն մերոյ Յիսուսի յերկնից հրեշտակօք զօրութեան իւրոյ",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
