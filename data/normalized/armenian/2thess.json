  },
  {
    "chunk_id": "armenian/2thess#2Thess.2.2",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.2",
    "language": "hye",
    "text": "մի՛ վաղվաղակի խռովել ձեզ ի մտաց եւ մի՛ զարհուրել մի՛ հոգւով եւ մի՛ բանիւ եւ մի՛ թղթովք իբրեւ թէ ի մէնջ որպէս թէ եկեալ հասեալ իցէ օր Տեառն",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
