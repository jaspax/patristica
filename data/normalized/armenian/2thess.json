    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "armenian/2thess#2Thess.2.3",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.3",
    "language": "hye",
    "text": "Մի՛ ոք զձեզ խաբեսցէ եւ մի՛ իւիք իրօք զի եթէ ոչ նախ եկեսցէ ապստամբութիւնն եւ յայտնեսցի մարդն անօրէնութեան որդին կորստեան",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
