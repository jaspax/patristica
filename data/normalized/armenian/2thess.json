  {
    "chunk_id": "armenian/2thess#2Thess.1.1",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.1",
    "language": "hye",
    "text": "Պաւղոս եւ Սիղուանոս եւ Տիմոթէոս եկեղեցւոյդ Թեսաղոնիկեցւոց յԱստուած Հայր մեր եւ ի Տէր Յիսուս Քրիստոս",
    "chunk_index": 0,
