  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.3",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.3",
    "language": "hye",
    "text": "Գոհանալ պարտիմք զԱստուծոյ յամենայն ժամ վասն ձեր եղբարք որպէս եւ արժան իսկ է զի եւս քան զեւս աճեն հաւատք ձեր եւ յաճախէ սէր իւրաքանչիւր ամենեցուն ձեր առ միմեանս",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
      90
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.4",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.4",
    "language": "hye",
    "text": "որպէս եւ մեզ ձեւք պարծել յեկեղեցիսն Աստուծոյ վասն համբերութեան ձերոյ եւ հաւատոց յամենայն հալածանս ձեր եւ ի նեղութիւնս որում դուքն համբերէք",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
      90
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.5",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.5",
    "language": "hye",
    "text": "յօրինակ արդար դատաստանին Աստուծոյ արժանի լինել ձեզ արքայութեանն Աստուծոյ վասն որոյ եւ զճգնութիւնդ կրէք",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
