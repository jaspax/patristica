  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.12",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.12",
    "language": "hye",
    "text": "զի փառաւոր լիցի անուն Տեառն մերոյ Յիսուսի Քրիստոսի ի ձեզ եւ դուք ի նմա ըստ շնորհացն Աստուծոյ մերոյ եւ Տեառն Յիսուսի Քրիստոսի",
    "chunk_index": 11,
    "context_before": null,
