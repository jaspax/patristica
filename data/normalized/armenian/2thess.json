    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.7",
    "language": "hye",
    "text": "Զի խորհուրդն անօրէնութեան արդէն իսկ զօրանայ բայց յայնժամ մինչ ի միջոյ բարձցի որ այժմդ ունի",
    "chunk_index": 18,
