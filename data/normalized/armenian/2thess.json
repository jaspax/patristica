    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.8",
    "language": "hye",
    "text": "Եւ ապա յայտնեսցի անօրէնն զոր Տէր Յիսուս սատակեսցէ հոգւով բերանոյ իւրոյ եւ խափանեսցէ յայտնութեամբ գալստեանն իւրոյ",
    "chunk_index": 19,
    "context_before": null,
