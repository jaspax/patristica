  },
  {
    "chunk_id": "armenian/2thess#2Thess.1.8",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.8",
    "language": "hye",
    "text": "ի բոց հրոյ առնուլ զվրէժս յայնցանէ ոյք ոչ ճանաչեն զԱստուած եւ որ ոչ հնազանդին աւետարանին Տեառն մերոյ Յիսուսի Քրիստոսի",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
