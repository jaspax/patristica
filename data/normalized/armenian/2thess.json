    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.1.9",
    "language": "hye",
    "text": "որք տայցեն վրէժս ի սատակումն յաւիտենից յերեսաց Տեառն եւ ի փառաց զօրութեան նորա",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
      50,
