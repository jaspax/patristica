  {
    "chunk_id": "armenian/2thess#2Thess.2.1",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.1",
    "language": "hye",
    "text": "Աղաչեմ զձեզ եղբարք վասն գալստեան Տեառն մերոյ Յիսուսի Քրիստոսի եւ մերոյ ժողովելոյն առ նա",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
    "date_range": [
