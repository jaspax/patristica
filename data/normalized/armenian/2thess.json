  },
  {
    "chunk_id": "armenian/2thess#2Thess.2.5",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.5",
    "language": "hye",
    "text": "Ո՞չ յիշիցէք զի մինչ առ ձեզն իսկ էի ասէի զայս",
