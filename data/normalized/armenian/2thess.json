  },
  {
    "chunk_id": "armenian/2thess#2Thess.2.10",
    "work_id": "armenian/2thess",
    "canonical_ref": "2Thess.2.10",
    "language": "hye",
    "text": "եւ ամենայն պատրանօք անիրաւութեան ի վերայ կորուսելոցն փոխանակ զի զսէրն ճշմարտութեան ոչ ընկալան զի ապրեսցին եւ վասն այնորիկ առաքեսցէ նոցա Աստուած ազդեցութիւն մոլորութեան հաւատալ նոցա ստութեանն",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 52,
