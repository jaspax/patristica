    "work_id": "scripture/pta-lxx/jude",
    "canonical_ref": "Jude.1.2",
    "language": "grc",
    "text": "ἔλεος ὑμῖν καὶ εἰρήνη καὶ ἀγάπη πληθυνθείη .",
    "chunk_index": 1,
    "context_before": null,
