  },
  {
    "chunk_id": "scripture/pta-lxx/jude#Jude.1.5",
    "work_id": "scripture/pta-lxx/jude",
    "canonical_ref": "Jude.1.5",
    "language": "grc",
    "text": "Ὑπομνῆσαι δὲ ὑμᾶς βούλομαι , εἰδότας ὑμᾶς ἅπαξ ἅπαξ ὑμᾶς ἅπαξ ὑμᾶς πάντα τοῦτο , ὅτι Ἰησοῦς κύριος ὁ κύριος ὁ κύριος ἅπαξ λαὸν ἐκ γῆς Αἰγύπτου σώσας τὸ δεύτερον τοὺς μὴ πιστεύσαντας ἀπώλεσεν ,",
    "chunk_index": 4,
    "context_before": null,
