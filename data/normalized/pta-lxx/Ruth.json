    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.1.3",
    "language": "grc",
    "text": "καὶ ἀπέθανεν Αβιμελεχ ὁ ἀνὴρ τῆς Νωεμιν, καὶ κατελείφθη αὐτὴ καὶ οἱ δύο υἱοὶ αὐτῆς.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
