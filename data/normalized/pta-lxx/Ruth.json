    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.1.19",
    "language": "grc",
    "text": "ἐπορεύθησαν δὲ ἀμφότεραι ἕως τοῦ παραγενέσθαι αὐτὰς εἰς Βαιθλεεμ. καὶ ἤχησεν πᾶσα ἡ πόλις ἐπ’ αὐταῖς καὶ εἶπον Αὕτη ἐστὶν Νωεμιν;",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
      -400
    ],
