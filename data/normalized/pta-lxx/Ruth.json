    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/ruth#Ruth.2.4",
    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.2.4",
    "language": "grc",
    "text": "καὶ ἰδοὺ Βοος ἦλθεν ἐκ Βαιθλεεμ καὶ εἶπεν τοῖς θερίζουσιν Κύριος μεθ’ ὑμῶν· καὶ εἶπον αὐτῷ Εὐλογήσαι σε κύριος.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
