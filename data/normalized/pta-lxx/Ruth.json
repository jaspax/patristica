  {
    "chunk_id": "pta-lxx/ruth#Ruth.1.18",
    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.1.18",
    "language": "grc",
    "text": "ἰδοῦσα δὲ Νωεμιν ὅτι κραταιοῦται αὐτὴ τοῦ πορεύεσθαι μετ’ αὐτῆς, ἐκόπασεν τοῦ λαλῆσαι πρὸς αὐτὴν ἔτι.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
