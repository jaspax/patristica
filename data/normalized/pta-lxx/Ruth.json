  },
  {
    "chunk_id": "pta-lxx/ruth#Ruth.1.22",
    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.1.22",
    "language": "grc",
    "text": "καὶ ἐπέστρεψεν Νωεμιν καὶ Ρουθ ἡ Μωαβῖτις ἡ νύμφη αὐτῆς ἐπιστρέφουσα ἐξ ἀγροῦ Μωαβ· αὐταὶ δὲ παρεγενήθησαν εἰς Βαιθλεεμ ἐν ἀρχῇ θερισμοῦ κριθῶν.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
