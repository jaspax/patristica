    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.1.9",
    "language": "grc",
    "text": "δῴη κύριος ὑμῖν καὶ εὕροιτε ἀνάπαυσιν ἑκάστη ἐν οἴκῳ ἀνδρὸς αὐτῆς. καὶ κατεφίλησεν αὐτάς, καὶ ἐπῆραν τὴν φωνὴν αὐτῶν καὶ ἔκλαυσαν.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
