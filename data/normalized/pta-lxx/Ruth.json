    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/ruth#Ruth.1.20",
    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.1.20",
    "language": "grc",
    "text": "καὶ εἶπεν πρὸς αὐτάς Μὴ δὴ καλεῖτέ με Νωεμιν, καλέσατέ με Πικράν, ὅτι ἐπικράνθη ἐν ἐμοὶ ὁ ἱκανὸς σφόδρα·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
