    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/ruth#Ruth.2.2",
    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.2.2",
    "language": "grc",
    "text": "καὶ εἶπεν Ρουθ ἡ Μωαβῖτις πρὸς Νωεμιν Πορευθῶ δὴ εἰς ἀγρὸν καὶ συνάξω ἐν τοῖς στάχυσιν κατόπισθεν οὗ ἐὰν εὕρω χάριν ἐν ὀφθαλμοῖς αὐτοῦ. εἶπεν δὲ αὐτῇ Πορεύου, θύγατερ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
      -400
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/ruth#Ruth.2.3",
    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.2.3",
    "language": "grc",
    "text": "καὶ ἐπορεύθη καὶ συνέλεξεν ἐν τῷ ἀγρῷ κατόπισθεν τῶν θεριζόντων· καὶ περιέπεσεν περιπτώματι τῇ μερίδι τοῦ ἀγροῦ Βοος τοῦ ἐκ συγγενείας Αβιμελεχ.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
      -400
    ],
    "date_confidence": "uncertain",
