    "work_id": "pta-lxx/ruth",
    "canonical_ref": "Ruth.2.1",
    "language": "grc",
    "text": "Καὶ τῇ Νωεμιν ἀνὴρ γνώριμος τῷ ἀνδρὶ αὐτῆς· ὁ δὲ ἀνὴρ δυνατὸς ἰσχύι ἐκ τῆς συγγενείας Αβιμελεχ, καὶ ὄνομα αὐτῷ Βοος.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": -500,
    "date_range": [
      -600,
      -400
    ],
