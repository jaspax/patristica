  },
  {
    "chunk_id": "pta-lxx/beldrthdt#BelDrThdt.1.2",
    "work_id": "pta-lxx/beldrthdt",
    "canonical_ref": "BelDrThdt.1.2",
    "language": "grc",
    "text": "καὶ ἦν Δανιηλ συμβιωτὴς τοῦ βασιλέως καὶ ἔνδοξος ὑπὲρ πάντας τοὺς φίλους αὐτοῦ.",
    "chunk_index": 1,
    "context_before": null,
