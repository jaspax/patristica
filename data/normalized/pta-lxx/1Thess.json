    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.6",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.6",
    "language": "grc",
    "text": "οὔτε ζητοῦντες ἐξ ἀνθρώπων δόξαν , οὔτε ἀφ’ ὑμῶν οὔτε ἀπ’ ἄλλων ,",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
