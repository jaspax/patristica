  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.10",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.10",
    "language": "grc",
    "text": "ὑμεῖς μάρτυρες καὶ ὁ θεός , ὡς ὁσίως καὶ δικαίως καὶ ἀμέμπτως ὑμῖν τοῖς πιστεύουσιν ἐγενήθημεν ,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
