    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.4",
    "language": "grc",
    "text": "εἰδέναι ἕκαστον ὑμῶν τὸ ἑαυτοῦ σκεῦος κτᾶσθαι ἐν ἁγιασμῷ καὶ τιμῇ ,",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
