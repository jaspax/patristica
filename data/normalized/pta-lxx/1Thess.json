    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.15",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.15",
    "language": "grc",
    "text": "τῶν καὶ τὸν κύριον ἀποκτεινάντων Ἰησοῦν καὶ τοὺς + ἰδίους προφήτας καὶ ἡμᾶς ἐκδιωξάντων , καὶ θεῷ μὴ ἀρεσκόντων , καὶ πᾶσιν ἀνθρώποις ἐναντίων ,",
    "chunk_index": 24,
    "context_before": null,
