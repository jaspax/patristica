    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.5",
    "language": "grc",
    "text": "οὔτε γάρ ποτε ἐν λόγῳ κολακείας ἐγενήθημεν , καθὼς οἴδατε , οὔτε ἐν προφάσει πλεονεξίας , θεὸς μάρτυς ,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
