    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.3.12",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.3.12",
    "language": "grc",
    "text": "ὑμᾶς δὲ ὁ κύριος πλεονάσαι καὶ περισσεύσαι τῇ ἀγάπῃ εἰς ἀλλήλους καὶ εἰς πάντας , καθάπερ καὶ ἡμεῖς εἰς ὑμᾶς ,",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.3.13",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.3.13",
    "language": "grc",
    "text": "εἰς τὸ στηρίξαι ὑμῶν τὰς καρδίας ἀμέμπτους ἐν ἁγιωσύνῃ ἔμπροσθεν τοῦ θεοῦ καὶ πατρὸς ἡμῶν ἐν τῇ παρουσίᾳ τοῦ κυρίου ἡμῶν Ἰησοῦ + Χριστοῦ μετὰ πάντων τῶν ἁγίων αὐτοῦ + ἀμήν .",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
