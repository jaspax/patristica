    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.9",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.9",
    "language": "grc",
    "text": "Περὶ δὲ τῆς φιλαδελφίας οὐ χρείαν ἔχετε γράφειν ὑμῖν , αὐτοὶ γὰρ ὑμεῖς θεοδίδακτοί ἐστε εἰς τὸ ἀγαπᾶν ἀλλήλους ·",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.10",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.10",
    "language": "grc",
    "text": "καὶ γὰρ ποιεῖτε αὐτὸ εἰς πάντας τοὺς ἀδελφοὺς τοὺς ἐν ὅλῃ τῇ Μακεδονίᾳ . παρακαλοῦμεν δὲ ὑμᾶς , ἀδελφοί , περισσεύειν μᾶλλον ,",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
