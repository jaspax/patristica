    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.3",
    "language": "grc",
    "text": "τοῦτο γάρ ἐστιν θέλημα τοῦ θεοῦ , ὁ ἁγιασμὸς ὑμῶν , ἀπέχεσθαι ὑμᾶς ἀπὸ τῆς πορνείας ,",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
