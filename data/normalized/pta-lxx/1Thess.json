  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.3.11",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.3.11",
    "language": "grc",
    "text": "Αὐτὸς δὲ ὁ θεὸς καὶ πατὴρ ἡμῶν καὶ ὁ κύριος ἡμῶν Ἰησοῦς + Χριστός κατευθύναι τὴν ὁδὸν ἡμῶν πρὸς ὑμᾶς ·",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
