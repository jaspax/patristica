  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.11",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.11",
    "language": "grc",
    "text": "καθάπερ οἴδατε ὡς ἕνα ἕκαστον ὑμῶν ὡς πατὴρ τέκνα ἑαυτοῦ",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
