    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.5",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.5",
    "language": "grc",
    "text": "μὴ ἐν πάθει ἐπιθυμίας καθάπερ καὶ τὰ ἔθνη τὰ μὴ εἰδότα τὸν θεόν ,",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
