  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.3.10",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.3.10",
    "language": "grc",
    "text": "νυκτὸς καὶ ἡμέρας ὑπερεκπερισσοῦ δεόμενοι εἰς τὸ ἰδεῖν ὑμῶν τὸ πρόσωπον καὶ καταρτίσαι τὰ ὑστερήματα τῆς πίστεως ὑμῶν ;",
    "chunk_index": 39,
    "context_before": null,
