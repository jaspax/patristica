    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.3",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.3",
    "language": "grc",
    "text": "ἡ γὰρ παράκλησις ἡμῶν οὐκ ἐκ πλάνης οὐδὲ ἐξ ἀκαθαρσίας οὐδὲ οὔτε ἐν δόλῳ ,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
