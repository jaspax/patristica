    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.1.4",
    "language": "grc",
    "text": "εἰδότες , ἀδελφοὶ ἠγαπημένοι ὑπὸ θεοῦ τοῦ θεοῦ , τὴν ἐκλογὴν ὑμῶν ,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
