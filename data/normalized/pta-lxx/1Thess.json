    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.1",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.1",
    "language": "grc",
    "text": "Λοιπὸν οὖν , ἀδελφοί , ἐρωτῶμεν ὑμᾶς καὶ παρακαλοῦμεν ἐν κυρίῳ Ἰησοῦ , ἵνα καθὼς παρελάβετε παρ’ ἡμῶν τὸ πῶς δεῖ ὑμᾶς περιπατεῖν καὶ ἀρέσκειν θεῷ , καθὼς καὶ περιπατεῖτε , ἵνα περισσεύητε μᾶλλον .",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
