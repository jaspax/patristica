    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.18",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.18",
    "language": "grc",
    "text": "διότι διό ἠθελήσαμεν ἐλθεῖν πρὸς ὑμᾶς , ἐγὼ μὲν Παῦλος καὶ ἅπαξ καὶ δίς , καὶ ἐνέκοψεν ἡμᾶς ὁ Σατανᾶς .",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
