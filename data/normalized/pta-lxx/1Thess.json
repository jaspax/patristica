    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.12",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.12",
    "language": "grc",
    "text": "παρακαλοῦντες ὑμᾶς καὶ παραμυθούμενοι καὶ μαρτυρόμενοι , εἰς τὸ περιπατεῖν περιπατῆσαι ὑμᾶς ἀξίως τοῦ θεοῦ τοῦ καλοῦντος ὑμᾶς εἰς τὴν ἑαυτοῦ βασιλείαν καὶ δόξαν .",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
