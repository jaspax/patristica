    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.8",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.8",
    "language": "grc",
    "text": "τοιγαροῦν ὁ ἀθετῶν οὐκ ἄνθρωπον ἀθετεῖ ἀλλὰ τὸν θεὸν τὸν καὶ διδόντα δόντα τὸ πνεῦμα αὐτοῦ τὸ ἅγιον εἰς ὑμᾶς .",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
