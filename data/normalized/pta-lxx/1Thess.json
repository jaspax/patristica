    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.7",
    "language": "grc",
    "text": "δυνάμενοι ἐν βάρει εἶναι ὡς Χριστοῦ ἀπόστολοι · ἀλλὰ ἐγενήθημεν ἤπιοι νήπιοι ἐν μέσῳ ὑμῶν , ὡς ἐὰν ἂν τροφὸς θάλπῃ τὰ ἑαυτῆς τέκνα ·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
