    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.2",
    "language": "grc",
    "text": "οἴδατε γὰρ τίνας παραγγελίας ἐδώκαμεν ὑμῖν διὰ τοῦ κυρίου Ἰησοῦ .",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
