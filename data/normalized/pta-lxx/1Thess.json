    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.6",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.6",
    "language": "grc",
    "text": "τὸ μὴ ὑπερβαίνειν καὶ πλεονεκτεῖν ἐν τῷ πράγματι τὸν ἀδελφὸν αὐτοῦ , διότι ἔκδικος κύριος ὁ κύριος περὶ πάντων τούτων , καθὼς καὶ προείπαμεν ὑμῖν καὶ διεμαρτυράμεθα .",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
      52
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.4.7",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.4.7",
    "language": "grc",
    "text": "οὐ γὰρ ἐκάλεσεν ἡμᾶς ὁ θεὸς ἐπὶ ἀκαθαρσίᾳ ἀλλ’ ἐν ἁγιασμῷ .",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
