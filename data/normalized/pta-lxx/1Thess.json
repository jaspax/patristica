    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.3.8",
    "language": "grc",
    "text": "ὅτι νῦν ζῶμεν ἐὰν ὑμεῖς στήκετε ἐν κυρίῳ .",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
