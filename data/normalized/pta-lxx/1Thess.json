    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/1thess#1Thess.2.4",
    "work_id": "pta-lxx/1thess",
    "canonical_ref": "1Thess.2.4",
    "language": "grc",
    "text": "ἀλλὰ καθὼς δεδοκιμάσμεθα ὑπὸ τοῦ θεοῦ πιστευθῆναι τὸ εὐαγγέλιον οὕτως λαλοῦμεν , οὐχ ὡς ἀνθρώποις ἀρέσκοντες ἀλλὰ θεῷ τῷ θεῷ τῷ δοκιμάζοντι τὰς καρδίας ἡμῶν .",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
