  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.52",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.52",
    "language": "grc",
    "text": "ὡς δὲ διεχωρίσθησαν εἷς ἀπὸ τοῦ ἑνός, ἐκάλεσεν τὸν ἕνα αὐτῶν καὶ εἶπεν πρὸς αὐτόν Πεπαλαιωμένε ἡμερῶν κακῶν, νῦν ἥκασιν αἱ ἁμαρτίαι σου, ἃς ἐποίεις τὸ πρότερον",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
