    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.46",
    "language": "grc",
    "text": "καὶ ἐβόησεν φωνῇ μεγάλῃ Καθαρὸς ἐγὼ ἀπὸ τοῦ αἵματος ταύτης.",
    "chunk_index": 45,
    "context_before": null,
