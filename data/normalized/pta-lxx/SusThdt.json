    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.53",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.53",
    "language": "grc",
    "text": "κρίνων κρίσεις ἀδίκους καὶ τοὺς μὲν ἀθῴους κατακρίνων ἀπολύων δὲ τοὺς αἰτίους, λέγοντος τοῦ κυρίου Ἀθῷον καὶ δίκαιον οὐκ ἀποκτενεῖς·",
    "chunk_index": 52,
    "context_before": null,
