    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.43",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.43",
    "language": "grc",
    "text": "σὺ ἐπίστασαι ὅτι ψευδῆ μου κατεμαρτύρησαν· καὶ ἰδοὺ ἀποθνῄσκω μὴ ποιήσασα μηδὲν ὧν οὗτοι ἐπονηρεύσαντο κατ’ ἐμοῦ.",
    "chunk_index": 42,
