    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.34",
    "language": "grc",
    "text": "ἀναστάντες δὲ οἱ δύο πρεσβῦται ἐν μέσῳ τῷ λαῷ ἔθηκαν τὰς χεῖρας ἐπὶ τὴν κεφαλὴν αὐτῆς·",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
