    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.1",
    "language": "grc",
    "text": "Καὶ ἦν ἀνὴρ οἰκῶν ἐν Βαβυλῶνι, καὶ ὄνομα αὐτῷ Ιωακιμ.",
    "chunk_index": 0,
    "context_before": null,
