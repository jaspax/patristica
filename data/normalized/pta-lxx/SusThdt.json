    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.31",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.31",
    "language": "grc",
    "text": "ἡ δὲ Σουσαννα ἦν τρυφερὰ σφόδρα καὶ καλὴ τῷ εἴδει.",
