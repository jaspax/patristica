  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.48",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.48",
    "language": "grc",
    "text": "ὁ δὲ στὰς ἐν μέσῳ αὐτῶν εἶπεν Οὕτως μωροί, οἱ υἱοὶ Ισραηλ; οὐκ ἀνακρίναντες οὐδὲ τὸ σαφὲς ἐπιγνόντες κατεκρίνατε θυγατέρα Ισραηλ;",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
      -200,
      -50
    ],
    "date_confidence": "approximate",
