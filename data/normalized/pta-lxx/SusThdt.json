    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.58",
    "language": "grc",
    "text": "νῦν οὖν λέγε μοι Ὑπὸ τί δένδρον κατέλαβες αὐτοὺς ὁμιλοῦντας ἀλλήλοις; ὁ δὲ εἶπεν Ὑπὸ πρῖνον.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
