    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.56",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.56",
    "language": "grc",
    "text": "καὶ μεταστήσας αὐτὸν ἐκέλευσεν προσαγαγεῖν τὸν ἕτερον· καὶ εἶπεν αὐτῷ Σπέρμα Χανααν καὶ οὐκ Ιουδα, τὸ κάλλος ἐξηπάτησέν σε, καὶ ἡ ἐπιθυμία διέστρεψεν τὴν καρδίαν σου·",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
      -200,
      -50
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
