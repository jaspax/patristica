    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.38",
    "language": "grc",
    "text": "ἡμεῖς δὲ ὄντες ἐν τῇ γωνίᾳ τοῦ παραδείσου ἰδόντες τὴν ἀνομίαν ἐδράμομεν ἐπ’ αὐτούς·",
    "chunk_index": 37,
    "context_before": null,
