    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.49",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.49",
    "language": "grc",
    "text": "ἀναστρέψατε εἰς τὸ κριτήριον· ψευδῆ γὰρ οὗτοι κατεμαρτύρησαν αὐτῆς.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
