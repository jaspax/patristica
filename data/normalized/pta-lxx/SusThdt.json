    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.37",
    "language": "grc",
    "text": "καὶ ἦλθεν πρὸς αὐτὴν νεανίσκος, ὃς ἦν κεκρυμμένος, καὶ ἀνέπεσε μετ’ αὐτῆς.",
    "chunk_index": 36,
    "context_before": null,
