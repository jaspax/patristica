    "chunk_id": "pta-lxx/susthdt#SusThdt.1.50",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.50",
    "language": "grc",
    "text": "καὶ ἀνέστρεψεν πᾶς ὁ λαὸς μετὰ σπουδῆς. καὶ εἶπαν αὐτῷ οἱ πρεσβύτεροι Δεῦρο κάθισον ἐν μέσῳ ἡμῶν καὶ ἀνάγγειλον ἡμῖν· ὅτι σοὶ δέδωκεν ὁ θεὸς τὸ πρεσβεῖον.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
