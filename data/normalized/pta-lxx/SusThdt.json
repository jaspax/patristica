    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.47",
    "language": "grc",
    "text": "ἐπέστρεψεν δὲ πᾶς ὁ λαὸς πρὸς αὐτὸν καὶ εἶπαν Τίς ὁ λόγος οὗτος, ὃν σὺ λελάληκας;",
    "chunk_index": 46,
    "context_before": null,
