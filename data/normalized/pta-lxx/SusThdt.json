    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.44",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.44",
    "language": "grc",
    "text": "Καὶ εἰσήκουσεν κύριος τῆς φωνῆς αὐτῆς.",
    "chunk_index": 43,
    "context_before": null,
