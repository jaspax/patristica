    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.55",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.55",
    "language": "grc",
    "text": "εἶπεν δὲ Δανιηλ Ὀρθῶς ἔψευσαι εἰς τὴν σεαυτοῦ κεφαλήν· ἤδη γὰρ ἄγγελος τοῦ θεοῦ λαβὼν φάσιν παρὰ τοῦ θεοῦ σχίσει σε μέσον.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
      -200,
