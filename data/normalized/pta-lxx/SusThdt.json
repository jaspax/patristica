    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/susthdt#SusThdt.1.54",
    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.54",
    "language": "grc",
    "text": "νῦν οὖν ταύτην εἴπερ εἶδες, εἰπόν Ὑπὸ τί δένδρον εἶδες αὐτοὺς ὁμιλοῦντας ἀλλήλοις; ὁ δὲ εἶπεν Ὑπὸ σχῖνον.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": -100,
    "date_range": [
