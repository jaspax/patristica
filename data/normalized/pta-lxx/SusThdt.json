    "work_id": "pta-lxx/susthdt",
    "canonical_ref": "SusThdt.1.33",
    "language": "grc",
    "text": "ἔκλαιον δὲ οἱ παρ’ αὐτῆς καὶ πάντες οἱ ἰδόντες αὐτήν.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
