    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.15",
    "language": "grc",
    "text": "τάχα γὰρ διὰ τοῦτο ἐχωρίσθη πρὸς ὥραν ἵνα αἰώνιον αὐτὸν ἀπέχῃς ,",
    "chunk_index": 14,
    "context_before": null,
