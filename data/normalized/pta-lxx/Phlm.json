    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.9",
    "language": "grc",
    "text": "διὰ τὴν ἀγάπην μᾶλλον παρακαλῶ , τοιοῦτος ὢν ὡς Παῦλος πρεσβύτης νυνὶ δὲ καὶ δέσμιος Χριστοῦ Ἰησοῦ Ἰησοῦ Χριστοῦ —",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
