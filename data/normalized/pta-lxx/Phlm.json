    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.14",
    "language": "grc",
    "text": "χωρὶς δὲ τῆς σῆς γνώμης οὐδὲν ἠθέλησα ποιῆσαι , ἵνα μὴ ὡς κατὰ ἀνάγκην τὸ ἀγαθόν σου ᾖ ἀλλὰ κατὰ ἑκούσιον ·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
