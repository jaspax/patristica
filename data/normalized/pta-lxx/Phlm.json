    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.11",
    "language": "grc",
    "text": "τόν ποτέ σοι ἄχρηστον νυνὶ δὲ + καὶ σοὶ καὶ ἐμοὶ εὔχρηστον ,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
