    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.8",
    "language": "grc",
    "text": "Διό , πολλὴν ἐν Χριστῷ παρρησίαν ἔχων ἐπιτάσσειν σοι τὸ ἀνῆκον ,",
    "chunk_index": 7,
    "context_before": null,
