    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.18",
    "language": "grc",
    "text": "εἰ δέ τι ἠδίκησέν σε ἢ ὀφείλει , τοῦτο ἐμοὶ ἐλλόγα ἐλλόγει ·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
