  },
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.2",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.2",
    "language": "grc",
    "text": "καὶ Ἀπφίᾳ τῇ ἀδελφῇ ἀγαπητῇ καὶ Ἀρχίππῳ τῷ συστρατιώτῃ ἡμῶν καὶ τῇ κατ’ οἶκόν σου ἐκκλησίᾳ ·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
