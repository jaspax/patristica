    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.3",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.3",
    "language": "grc",
    "text": "χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ .",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
      63
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.4",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.4",
    "language": "grc",
    "text": "Εὐχαριστῶ τῷ θεῷ μου πάντοτε μνείαν σου ποιούμενος ἐπὶ τῶν προσευχῶν μου ,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
      63
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.5",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.5",
    "language": "grc",
    "text": "ἀκούων σου τὴν ἀγάπην καὶ τὴν πίστιν ἣν ἔχεις πρὸς εἰς τὸν κύριον Ἰησοῦν καὶ εἰς πάντας τοὺς ἁγίους ,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
      63
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.6",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.6",
    "language": "grc",
    "text": "ὅπως ἡ κοινωνία τῆς πίστεώς σου ἐνεργὴς γένηται ἐν ἐπιγνώσει παντὸς ἀγαθοῦ τοῦ ἐν ἡμῖν εἰς Χριστόν + Ἰησοῦν ·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
      63
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.7",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.7",
    "language": "grc",
    "text": "χαρὰν Χάριν γὰρ πολλὴν ἔσχον ἔχομεν πολλὴν καὶ παράκλησιν ἐπὶ τῇ ἀγάπῃ σου , ὅτι τὰ σπλάγχνα τῶν ἁγίων ἀναπέπαυται διὰ σοῦ , ἀδελφέ .",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
      63
    ],
