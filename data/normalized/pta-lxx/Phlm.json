[
  {
    "chunk_id": "pta-lxx/phlm#Phlm.1.1",
    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.1",
    "language": "grc",
    "text": "Παῦλος δέσμιος Χριστοῦ Ἰησοῦ καὶ Τιμόθεος ὁ ἀδελφὸς Φιλήμονι τῷ ἀγαπητῷ καὶ συνεργῷ ἡμῶν",
    "chunk_index": 0,
    "context_before": null,
