    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.10",
    "language": "grc",
    "text": "παρακαλῶ σε περὶ τοῦ ἐμοῦ τέκνου , ὃν ἐγέννησα ἐν τοῖς δεσμοῖς + μου Ὀνήσιμον ,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
