    "work_id": "pta-lxx/phlm",
    "canonical_ref": "Phlm.1.17",
    "language": "grc",
    "text": "Εἰ οὖν με ἔχεις κοινωνόν , προσλαβοῦ αὐτὸν ὡς ἐμέ .",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
