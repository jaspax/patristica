  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.12.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.12.s4",
    "language": "grc",
    "text": "ἐρράγησαν οἱ τάφοι· οὐδέπω κατῆλθεν εἰς ᾅδου διορθωσάμενος τὰ πράγματα καὶ οὐκ ἤνεγκεν ἡ γῆ τοῦ δεσπότου τὴν παρουσίαν·",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
