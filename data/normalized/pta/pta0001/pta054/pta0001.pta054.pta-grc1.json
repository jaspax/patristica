[
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.1.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.1.s1",
    "language": "grc",
    "text": "Ἀπαρξώμεθα τῇ ἡμέρᾳ τοῦ σταυροῦ τὸν περὶ τοῦ σταυροῦ λόγον καὶ στέψωμεν τὴν ἡμέραν, μᾶλλον δὲ στεφθῶμεν ὑπὸ τῆς μνήμης τῆς ἡμέρας·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.1.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.1.s2",
    "language": "grc",
    "text": "οὐ γὰρ ἐξ ὧν φθεγγόμεθα σταυρὸς στεφανοῦται, ἀλλ’ ἐξ ὧν εὐγνωμόνως ὁμολογοῦμεν τοὺς στεφάνους παρ’ αὐτοῦ κομιζόμεθα.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.1.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.1.s3",
    "language": "grc",
    "text": "Σήμερον, ἀδελφοί, σταυρὸς ἐπάγη καὶ κόσμος ἡγιάσθη, σήμερον σταυρὸς ἐπάγη καὶ θάνατος ἀνετράπη, σήμερον σταυρὸς ἔλαμψεν καὶ δαίμονες ἐσκορπίσθησαν,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.1.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.1.s4",
    "language": "grc",
    "text": "σήμερον σταυρὸς ἐβράβευσεν καὶ διάβολος κατῃσχύνθη, σήμερον σταυρὸς ἔλαμψεν καὶ θάνατος ἐνικήθη καὶ ἄνθρωπος ἐλευθερώθη καὶ ὁ Θεὸς ἐδοξάσθη.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.2.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.2.s1",
    "language": "grc",
    "text": "Σήμερον παρὰ Ἰουδαίοις γῆ ἐσαλεύσατο, παρ’ ἡμῖν δὲ ἡ οἰκουμένη στηρίζεται, σήμερον ἡ θεομάχος τόλμα τῶν Ἰουδαίων πέτρας ἔσχισεν, σήμερον ἡ φιλόθεος εὐσέβεια τὴν οἰκουμένην ἥνωσεν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.2.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.2.s2",
    "language": "grc",
    "text": "Ἔπρεπεν γὰρ τὰ μὲν τῆς εὐσεβείας συναφθῆναι, τὰ δὲ τῆς ἀσεβείας σχισθῆναι, καθὼς ὁ Δαβὶδ λέγει· Διεσχίσθησαν καὶ οὐ κατηνύγησαν.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.2.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.2.s3",
    "language": "grc",
    "text": "Σήμερον παρὰ Ἰουδαίοις ὁ ἥλιος ἀπὸ ἕκτης ὥρας ἕως ἐννάτης σκότος εἰργάσατο· οὐ γὰρ ἤνεγκεν τὸ ποίημα τὴν ὕβριν τοῦ ποιήσαντος.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.2.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.2.s4",
    "language": "grc",
    "text": "Συνέστειλε γὰρ τὰς ἀκτῖνας ἵνα ἐπόπτης μὴ γένηται τοῦ θεομάχου μίσους, οὐκ ἐπειδὴ τῆς θεότητος ὕβρις ἥπτετο, ἀλλ’ ἐπειδὴ παρὰ τῶν τολμησάντων τὸ γινόμενον εἰς ὕβριν ἐγίνετο.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.3.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.3.s1",
    "language": "grc",
    "text": "Σήμερον παρὰ Ἰουδαίοις ὁ ἥλιος τὴν ἀκτῖνα μετεποίησεν· σήμερον ἡ χάρις παρ’ ἡμῖν τὴν νύκτα εἰς ἡμέραν ποιεῖ.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.3.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.3.s2",
    "language": "grc",
    "text": "Φίλον γὰρ τῇ εὐσεβείᾳ καὶ ἐν σκότει φῶς ἀπολαύειν, τῇ δὲ ἀσεβείᾳ καὶ ἐν φωτὶ σκότους ἀναπληροῦσθαι.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.3.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.3.s3",
    "language": "grc",
    "text": "Τοῖς πιστοῖς καὶ ἡ νὺξ εἰς ἡμέραν λογίζεται, τοῖς δὲ ἀπίστοις καὶ ἡ ἡμέρα μεταποιεῖται εἰς νύκτα.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.3.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.3.s4",
    "language": "grc",
    "text": "Διὰ τοῦτο περὶ μὲν τῶν πιστῶν ἡ γραφὴ διαλεγομένη φησί· Καὶ νὺξ φωτισμὸς ἐν τῇ τρυφῇ μου, ὅτι τὸ σκότος οὐ σκοτισθήσεται ἀπὸ σοῦ καὶ νὺξ ὡς ἡμέρα φωτισθήσεται.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.3.s5",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.3.s5",
    "language": "grc",
    "text": "Τῷ οὖν πιστῷ καὶ ἡ νὺξ εἰς ἡμέραν μεταβάλλεται, τῷ δὲ ἀπίστῳ καὶ ἡ ἡμέρα εἰς νύκτα μετατίθεται, καθὼς βοᾷ ὁ προφήτης λέγων·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.3.s6",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.3.s6",
    "language": "grc",
    "text": "Ψηλαφήσουσιν ὡς τυφλοὶ τοῖχον καὶ περιπατήσουσιν ἐν ἡμέρᾳ ὡς ἐν μεσονυκτίῳ.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.4.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.4.s1",
    "language": "grc",
    "text": "Σήμερον ἀδελφοὶ Ἀδὰμ ἐξεβλήθη τοῦ παραδείσου διὰ τὴν παρακοήν, σήμερον πάλιν εἰσάγεται εἰς τὸν παράδεισον. Καὶ μάρτυς ὁ λῃστής.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.4.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.4.s2",
    "language": "grc",
    "text": "Ἐξῆλθεν κλέπτης καὶ εἰσῆλθεν κλέπτης, ἐξῆλθεν ὁ κλέψας παρὰ τὸ βούλημα τῆς ἐντολῆς καὶ εἰσῆλθεν ὁ κλέψας ἀπὸ τοῦ σταυροῦ τὴν σωτηρίαν.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.4.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.4.s3",
    "language": "grc",
    "text": "Οἶδα καὶ πρώην εἰρηκὼς περὶ τοῦ λῃστοῦ, ἀλλ’ ἔχει διαφόρους ἱστορίας ὁ τοῦ σταυροῦ λόγος.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.4.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.4.s4",
    "language": "grc",
    "text": "Ἐκεῖνος ὁ λῃστὴς διὰ ξύλου θανατοῦται, οὗτος ὁ λῃστὴς ἀπὸ ξύλου τρυγᾷ τὴν σωτηρίαν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.4.s5",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.4.s5",
    "language": "grc",
    "text": "Οὐκ ἤρκει αὐτῷ τὰ ἐπίγεια ἀλλὰ καὶ τὰ ἐπουράνια ἐσύλησεν, οὐ περιγράφων τῇ δυνάμει, ἀλλὰ νικῶν τῇ πίστει.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.4.s6",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.4.s6",
    "language": "grc",
    "text": "Αὕτη γάρ ἐστιν φωνὴ τοῦ δεσπότου λέγοντος· Ἡ βασιλεία τῶν οὐρανῶν βιάζεται καὶ βιασταὶ ἁρπάζουσιν αὐτήν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.5.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.5.s1",
    "language": "grc",
    "text": "Ἐπὶ σταυροῦ δύο λῃσταί, εἰκὼν Ἰουδαίων τε καὶ Ἑλλήνων, τῶν ἐν ἀσεβείᾳ τὰ πρῶτα ὁδευσάντων καὶ μετὰ ταῦτα τὴν ἀλήθειαν ἐπεγνωκότων.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.5.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.5.s2",
    "language": "grc",
    "text": "Εἰκὼν Ἰουδαίων ὁ λῃστὴς ὁ μέχρι τέλους λῃστής· ἕως τοῦ σταυροῦ, συνέδραμον ἀλλήλοις τὴν ὁδὸν τῆς πονηρίας καὶ ὁ σταυρὸς ἐμέρισεν τὰς ὁδούς·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.5.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.5.s3",
    "language": "grc",
    "text": "ἀπὸ γὰρ τοῦ σταυροῦ μερίζονται οἱ δύο, ὁδὸς ἀπωλείας τοῖς ἀπιστοῦσι καὶ ὁδὸς σωτηρίας τοῖς πιστεύουσιν.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.5.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.5.s4",
    "language": "grc",
    "text": "Ἐκεῖ ἔμαθεν ὁ λῃστὴς τὴν διαφορὰν τῶν ὁδῶν ὅτι γινώσκει Κύριος ὁδὸν δικαίων καὶ ὁδὸς ἀσεβῶν ἀπολεῖται .",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.6.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.6.s1",
    "language": "grc",
    "text": "Καὶ βλέπε τοῦ Θεοῦ τὴν διακρισίαν ἵνα εἴπῃς καὶ σὺ μετὰ τοῦ προφήτου· Δίκαιος εἶ Κύριε, καὶ εὐθεῖς αἱ κρίσεις σου.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.6.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.6.s2",
    "language": "grc",
    "text": "Διὰ μίαν ἁμαρτίαν ἐξορίζεται Ἀδὰμ τοῦ παραδείσου, διὰ μίαν φωνὴν πίστεως ὁ λῃστὴς σῴζεται·",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.6.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.6.s3",
    "language": "grc",
    "text": "μία ἐκεῖνον ἁμαρτία ἐκβάλλει τῆς τρυφῆς, μία τοῦτον δικαιοσύνη εἰσοικίζει εἰς τὴν τρυφήν. Εἰσῆλθεν ὁ λῃστὴς εἰς τὸν παράδεισον. Ὢ τοῦ θαύματος.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.6.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.6.s4",
    "language": "grc",
    "text": "οὔτε τῷ Ἀβραὰμ ἐδόθη ἐπαγγελία παραδείσου διὰ φωνῆς· κληρονομεῖ γὰρ διὰ πίστεως ἀλλ’ ἐπαγγελίαν παραδείσου οὐδὲ γὰρ πρὸ τοῦ λῃστοῦ ἔλαβεν.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
