  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.12.s5",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.12.s5",
    "language": "grc",
    "text": "ἐρράγησαν οἱ ποταμοί μὴ ἐνεγκόντες τὸν ἄνωθεν πρὸς αὐτοὺς κατελθόντα, ἐρράγησαν οἱ τάφοι καὶ ἀνέδωκαν ἀνθρώπους καὶ εἰσῆλθον εἰς τὴν πόλιν τὴν ἁγίαν ἵνα ἀποφάσιστον καταλίπωσιν τὴν δίκην.",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.13.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.13.s1",
    "language": "grc",
    "text": "Ταῦτα ἐγένετο ἐπὶ τοῦ σταυροῦ καὶ Ἰουδαῖοι ἐχλεύαζον λέγοντες· Εἰ υἱὸς εἶ τοῦ Θεοῦ κατάβηθι ἀπὸ τοῦ σταυροῦ καὶ πιστεύσομέν σοι.",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.13.s2",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.13.s2",
    "language": "grc",
    "text": "Ἐννόησον τὴν φωνὴν τῶν τέκνων τοῦ διαβόλου πῶς μιμοῦνται τὴν φωνὴν ταύτην τὴν πατρικήν.",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.13.s3",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.13.s3",
    "language": "grc",
    "text": "Ὁ διάβολος λέγει τῷ σωτῆρι εἰς τὸ πτερύγιον τοῦ ναοῦ· Εἰ υἱὸς εἶ τοῦ Θεοῦ, βάλε σεαυτὸν κάτω.",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.13.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.13.s4",
    "language": "grc",
    "text": "Ὁμοίως καὶ οἱ Ἰουδαῖοι· Εἰ υἱὸς εἶ τοῦ Θεοῦ, κατάβηθι ἀπὸ τοῦ σταυροῦ καὶ πιστεύσομέν σοι.",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
