  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.7.s1",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.7.s1",
    "language": "grc",
    "text": "Ἐνταῦθα πρόσεχε ἀκριβῶς καὶ τὴν παλαιὰν ἐρευνήσας γραφὴν πᾶσαν καὶ τὴν νέαν·",
    "chunk_index": 28,
