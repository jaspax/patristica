  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-grc1#pta0001.pta054.15.s4",
    "work_id": "pta/pta0001/pta054/pta-grc1",
    "canonical_ref": "pta0001.pta054.15.s4",
    "language": "grc",
    "text": "Ἠρνήσαντο τὴν τοῦ Θεοῦ βασιλείαν καὶ παρεδώθησαν τῇ Ῥωμαίων βασιλείᾳ· ἐπειδὴ ὃ εἶχον ἠγνόησαν, ὃ ᾐτήσαντο ἔλαβον.",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
