    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.14.s1",
    "language": "lat",
    "text": "Pariter crucifigunt latrones, non tanquam inimici latronum, participes enim erant sceleris eorum, sed ut infamarent dominum suum, qui non sine causa crucifixus sit, sed quasi facinorosus inventus sit.",
    "chunk_index": 60,
    "context_before": null,
