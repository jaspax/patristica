    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.4.s3",
    "language": "lat",
    "text": "Scio et antea de latrone me dixisse, sed diversas habet intelligentias, ideo dicit sermo iste: latro de ligno mercatus est salutem, latro furatur caeleste imperium;",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
