    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-lat1#pta0001.pta054.6.s3",
    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.6.s3",
    "language": "lat",
    "text": "Unum peccatum defecit illum, et una iustitia introduxit istum. Adam eiectus est de paradiso, et latro habitator factus est paradisi. O admiranda rerum materia!",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
