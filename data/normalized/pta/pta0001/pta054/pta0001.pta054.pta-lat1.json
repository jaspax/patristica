    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.2.s4",
    "language": "lat",
    "text": "Et David dicebat: Dirupti sunt et non sunt compuncti. Hodie apud Iudaeos, ab hora sexta usque ad horam nonam sol obscuratus est;",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
