    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.6.s2",
    "language": "lat",
    "text": "Propter unum peccatum damnatus est Adam, et propter unam fidei vocem latro salvatus est.",
