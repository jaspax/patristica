    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.2.s5",
    "language": "lat",
    "text": "non enim ferre poterat creatura iniurias creatoris; retraxit radios suos, celavit igneum iubar ne videret impiorum facinora;",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
