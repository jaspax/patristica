    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.12.s3",
    "language": "lat",
    "text": "Et ideo recedente Domino, deserta remansit domus, sicut ipse dixit: Ecce relinquetur vobis domus vestra deserta.",
