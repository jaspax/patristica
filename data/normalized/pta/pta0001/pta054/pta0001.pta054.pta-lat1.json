    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.10.1.s4",
    "language": "lat",
    "text": "Scissae sunt petrae, diruptum est velumm templi, et Iudaeorum secreta patuerunt.",
