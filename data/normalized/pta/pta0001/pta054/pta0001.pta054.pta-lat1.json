    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.7.s1",
    "language": "lat",
    "text": "Hic attendite diligentius perscrutantes vetus testamentum et novum: nullum invenietis ante latronem repromissionem paradisi meruisse:",
    "chunk_index": 28,
