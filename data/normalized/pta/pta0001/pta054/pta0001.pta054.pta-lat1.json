    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.12.s2",
    "language": "lat",
    "text": "Postquam impietas infidelium Deo intulit manus, iniuria Domino facta est qui habitavit in templo.",
