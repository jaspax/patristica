    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.13.s2",
    "language": "lat",
    "text": "Diabolus dicebat: Si filius Dei es, mitte te deorsum. Et Iudaei dicunt: Si filius Dei es, descende de cruce et credimus tibi.",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
