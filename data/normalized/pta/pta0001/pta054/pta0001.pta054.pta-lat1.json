  },
  {
    "chunk_id": "pta/pta0001/pta054/pta-lat1#pta0001.pta054.6.s4",
    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.6.s4",
    "language": "lat",
    "text": "Nec Abrahae per vocem data est repromissio paradisi. Hereditavit quidem per fidem, repromissionem autem paradisi nemo ante latronem accepit.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
