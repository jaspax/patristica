    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.5.s2",
    "language": "lat",
    "text": "imaginem obtinuit populi ex gentibus congregati, qui prius in errore ambulaverat et post hoc veritatem agnovit.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
