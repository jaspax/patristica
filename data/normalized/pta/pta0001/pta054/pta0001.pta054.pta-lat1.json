    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.4.s4",
    "language": "lat",
    "text": "vim facit majestati, non virtute propria sed fide vincens. Ipsius Domini vox est: Regnum caelorum vim patitur et violenti rapiunt illud.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
