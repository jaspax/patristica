    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.5.s5",
    "language": "lat",
    "text": "In cruce didicit latro differentiam viarum, quoniam novit Dominus viam iustorum, via autem impiorum peribit.",
