    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.2.s2",
    "language": "lat",
    "text": "Hodie apud Iudaeos, quia mente audaci contra Dominum vadunt, petrae scissae sunt; hodie amabilis Deo pietas universum conspersit orbem.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
