    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.3.s1",
    "language": "lat",
    "text": "Hodie apud Iudaeos tenebrae sunt, apud nos autem nox in diem conversa est.",
