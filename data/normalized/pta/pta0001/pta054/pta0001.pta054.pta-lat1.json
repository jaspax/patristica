    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.10.1.s2",
    "language": "lat",
    "text": "Vidi quidem crucifixum sed et terraemotum sensi, et propter parricidas Iudaeos elementa indignantia intellexi.",
    "chunk_index": 49,
    "context_before": null,
