    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.3.s5",
    "language": "lat",
    "text": "Infidelibus autem et dies in noctem mutatur, dicente scriptura: Palpabunt sicut caeci parietem et ambulabunt in meridie tanquam in medio noctis.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
