    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.6.s1",
    "language": "lat",
    "text": "Vide Dei iustum iudicium, ut dicas et tu cum propheta: Iustus es Domine et rectum iudicium tuum.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
