    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.4.s2",
    "language": "lat",
    "text": "exiit contemptor verbi, et ingressus est confitens Verbum: exiit contemnens salutem, et introivit de cruce mercans salutem.",
