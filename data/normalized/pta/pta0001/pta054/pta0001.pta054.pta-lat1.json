    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.1.s4",
    "language": "lat",
    "text": "Hodie diabolus victus est, et homo absolutus est, et Deus glorificatus est.",
