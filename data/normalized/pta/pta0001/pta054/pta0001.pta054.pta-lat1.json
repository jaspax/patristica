    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.7.s2",
    "language": "lat",
    "text": "non Abraham, non Isaac, non Iacob, non Moysen; non prophetas nec apostolos, sed ante omnes reperietis latronem.",
