    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.5.s4",
    "language": "lat",
    "text": "Crux autem divisit utrumque; viam namque malignitatis et perditionis, qui non credidit ingressus est; viam autem salutis qui credidit adeptus est.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
