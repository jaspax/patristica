    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.5.s1",
    "language": "lat",
    "text": "In cruce duo latrones, imago est Iudaeorum et gentilium; latro qui paenituit.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
