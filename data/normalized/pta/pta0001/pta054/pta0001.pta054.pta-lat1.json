    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.10.s3",
    "language": "lat",
    "text": "Numquidnam audisti divinum sermonem, quando ad caedem gladium acuebas? Unde eruditus es talia philosophari de Christo?",
