    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.10.s2",
    "language": "lat",
    "text": "O admirandam latronis confessionem! Numquidnam scripturas legisti, ab iniquitate non cessans? Numquidnam prophetas audisti, homicidia exercens?",
