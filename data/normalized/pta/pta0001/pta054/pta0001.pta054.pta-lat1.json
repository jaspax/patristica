    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.3.s2",
    "language": "lat",
    "text": "Etenim pietatis proprium est, ut in tenebris fulgeat; impietas autem, etsi in lumine fuerit, tenebrescit.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
