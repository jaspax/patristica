    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.3.s4",
    "language": "lat",
    "text": "De fidelibus vero scriptura dicit: Quia tenebrae non obscurabuntur a te, et nox sicut dies illuminabitur.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
