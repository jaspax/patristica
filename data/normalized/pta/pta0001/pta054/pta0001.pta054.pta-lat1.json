    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.10.1.s1",
    "language": "lat",
    "text": "Quis te erudivit, o latro, talia de eo dicere? Non me, inquit, lex docuit sed sol occultans lumen suum.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
