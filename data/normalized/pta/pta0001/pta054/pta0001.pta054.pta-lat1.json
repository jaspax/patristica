    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.11.s2",
    "language": "lat",
    "text": "In illo enim tempore crucis, terra mota est, sol fugit, et petrae scissae sunt, velum diruptum est, monumenta patuerunt.",
