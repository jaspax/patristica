    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.3.s3",
    "language": "lat",
    "text": "Et fidelibus quidem nox in diem mutatur, infidelibus autein etiam ipsa lux tenebrescit.",
