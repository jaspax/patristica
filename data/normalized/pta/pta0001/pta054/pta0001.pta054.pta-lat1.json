    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.2.s3",
    "language": "lat",
    "text": "Decebat enim ea quae pietatis erant coniungi, ea autem quae infidelitatis erant disiungi.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
