    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.7.s3",
    "language": "lat",
    "text": "Audite igitur dominicam vocem dicentem: Amen dico tibi, hodie mecum eris in paradiso.",
    "chunk_index": 30,
    "context_before": null,
