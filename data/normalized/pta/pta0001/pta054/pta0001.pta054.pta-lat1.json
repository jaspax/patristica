    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.13.s1",
    "language": "lat",
    "text": "Iudaei inquiunt: Si filius Dei es, descende de cruce et credimus tibi. Considera nunc vocem filiorum diaboli, quomodo imitantur vocem paternam.",
    "chunk_index": 58,
    "context_before": null,
