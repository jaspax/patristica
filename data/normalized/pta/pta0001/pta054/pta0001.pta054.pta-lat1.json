    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.5.s3",
    "language": "lat",
    "text": "Imaginem vero latro ille obtinuit Iudaeorum, qui usque ad finem perseveravit in errore, et usque ad tempus quidem crucis viam malignitatis gerunt.",
