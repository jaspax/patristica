    "work_id": "pta/pta0001/pta054/pta-lat1",
    "canonical_ref": "pta0001.pta054.12.s1",
    "language": "lat",
    "text": "Et sicut gloria domus est ubi velum pendet, habitante intrinsecus domino domus, sic ignominia templi est unde recessit Spiritus sanctus.",
