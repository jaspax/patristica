[
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s1",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s1",
    "language": "grc",
    "text": "Δεῖ τὴν ὑμετέραν ἀγάπην εἰδέναι ὅτι ὁ θεὸς τεμὼν τοῦ βίου τούτου εἰς πέντε γενεὰς τὰς τάξεις, γενεὰς δὲ λέγω οὐχ ἡμαρτημένας, ἀλλὰ μερίδας.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s2",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s2",
    "language": "grc",
    "text": "Εἰς πέντε γὰρ μερίδας διελὼν τοῦ κόσμου τὸν δρόμον ἑκάστῃ μερίδι ἴδιον ἀπέδωκε πατέρα.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s3",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s3",
    "language": "grc",
    "text": "Ἐγένετο πρώτη μερὶς καὶ τάξις ἀπὸ τοῦ Ἀδὰμ μέχρι τοῦ Νῶε κἀκείνης τῆς προτέρας ἀρχηγὸς καὶ ἡγεμὼν ἦν ὁ Ἀδάμ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s4",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s4",
    "language": "grc",
    "text": "Ὅτε δὲ ὁ κατακλυσμὸς καταλαβὼν ἠφάνισε τὸν κόσμον διαιρέσεως καὶ τάξεως Νῶε δεύτερος πατὴρ τοῦ κόσμου γενόμενος.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s5",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s5",
    "language": "grc",
    "text": "Ὅτε δὲ λοιπὸν κατέλαβε οὐκέτι ὑδάτων σύγχυσις μόνον, ἀλλὰ καὶ πολλῶν κακῶν καὶ ἐτολμήθη τὰ τῆς πυργοποιίας καὶ ἀπὸ θεογνωσίας ἀληθοῦς εἰς ἀσέβειαν ἐβυθίσθησαν καὶ κατέλαβε δεύτερος κατακλυσμὸς τὰς ψυχὰς καταποντίζων,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s6",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s6",
    "language": "grc",
    "text": "περιγράφει πάλιν ὁ θεὸς τὴν δευτέραν γενεὰν οὐκ ἀφανίζων, ἀλλὰ διαιρῶν. Καὶ περιγράψας τὴν δευτέραν ἐπάγει τὴν τρίτην ἀρχὴν αὐτῇ δεδωκὼς τὸν Ἀβραάμ.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s7",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s7",
    "language": "grc",
    "text": "Εἶτα πάλιν τῆς ἀπὸ τοῦ Ἀβραὰμ γενεᾶς εἰς Αἴγυπτον κατελθούσης κἀκεῖ πάλιν εἰς ἀσέβειαν πεσούσης περιγράφων ἐκείνην τὴν τρίτην τάξιν δίδωσιν ἑτέραν ἀρχὴν τετάρτην πατέρα καταστήσας αὐτῇ Μωϋσέα.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s8",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s8",
    "language": "grc",
    "text": "Τελευταῖον δὲ πάντων δίδωσι πατέρα ἡμῶν κατὰ σάρκα Ἰησοῦν τὸν κύριον, περὶ οὗ καὶ ὁ προφήτης ἔλεγε·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s9",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s9",
    "language": "grc",
    "text": "Θαυμαστὸς σύμβουλος, θεὸς ἰσχυρός, ἐξουσιαστής, ἄρχων εἰρήνης, πατὴρ τοῦ μέλλοντος αἰῶνος.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s10",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s10",
    "language": "grc",
    "text": "Ἔχεις οὖν πατέρα τῆς πρώτης γενεᾶς τὸν Ἀδάμ, δεύτερον τὸν Νῶε, τρίτον πατέρα τὸν Ἀβραάμ, τέταρτον τὸν Μωϋσέα, πέμπτον τὸν σωτῆρα Χριστὸν κατὰ σάρκα.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s11",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s11",
    "language": "grc",
    "text": "Ἑκάστη τοίνυν διαίρεσις ἰδίαν ἔσχεν ὄψιν, ἰδίαν τάξιν, ἰδίους κανόνας, ἰδίους νόμους.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s12",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s12",
    "language": "grc",
    "text": "Καὶ ὥσπερ τοῦ ἐνιαυτοῦ αἱ τροπαὶ ἰδιάζουσαν ἔχουσι κατάστασιν καὶ ἑκάστη ἴδιον ἀποκεκλήρωται νόμον.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s13",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s13",
    "language": "grc",
    "text": "Ἄλλη ἡ ὄψις ἔαρος, ἄλλη θέρους, μετοπώρου, ἄλλη χειμῶνος, μιᾶς δὲ διοικήσεως τὰ πάντα.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s14",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s14",
    "language": "grc",
    "text": "Οὕτως καὶ αὗται αἱ πέντε διαρέσεις χρησίμως ὑπὸ θεοῦ διαιρεθεῖσαι ἑκάστη ἴδιον ἔλαβεν ἀρχηγὸν πάντα ὁμοῦ, τὰ εἰς διαφόρους χρόνους γενόμενα, εἰς μίαν συμφωνίαν ἄγοντος.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s15",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s15",
    "language": "grc",
    "text": "Ἕκαστος δὲ τούτων τῶν γενομένων καὶ κληθέντων ἀρχηγῶν πάντως κατηξιώθη καὶ προφήτης εἶναι. Οὐδὲ γὰρ ἠδύνατο ἄρχειν γενεᾶς ἀνθρώπων μὴ ἔχων τι πλέον ὑπὲρ ἀνθρώπους.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s16",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s16",
    "language": "grc",
    "text": "Ἦλθε γὰρ ὁ σωτήρ, ὁ ἀληθινὸς προφήτης τοῦ κόσμου, ὁ φωστήρ, ὁ πρῶτος καὶ τελευταῖος καὶ μέσος, ὁ πρὸ τῶν αἰώνων καὶ μετὰ πάντων, ὁ θεμέλιος πάντων καὶ ἀκρογωνιαῖος λίθος.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s17",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s17",
    "language": "grc",
    "text": "Ἦλθεν οὗτος ὁ ἀληθῶς προφήτης. Ἀληθῶς οὖν καὶ μόνος προφήτης λεγέσθω Χριστός, ὁ προειπὼν τὰ πάντα.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s18",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s18",
    "language": "grc",
    "text": "Οὐ τῷ παρ’ ἄλλου βαλεῖν, ἀλλὰ τῷ παρ’ ἑαυτῷ γνῶναι προφήτην αὐτὸν ἐκάλεσεν ἡ παλαιὰ διαθήκη.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s19",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s19",
    "language": "grc",
    "text": "Καὶ γὰρ ὁ Μωϋσῆς εἶπεν· Προφήτην ὑμῖν ἀναστήσει κύριος ὡς ἐμέ· αὐτὸν ἀκούσεσθε.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s20",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s20",
    "language": "grc",
    "text": "Ἀλλὰ καὶ αὐτὸς ἑαυτὸν προφήτην καλεῖ κατὰ σάρκα· Πλὴν σήμερον καὶ αὔριον ἀνέξομαι τοῦ μὴ πορευθῆναι εἰς Ἱερουσαλήμ. Ἔχεις πέντε προφήτας τῶν διαιρέσεων ἀρχηγούς.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s21",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s21",
    "language": "grc",
    "text": "Κατ’ αὐτὴν τὴν ἔννοιαν καὶ ὁ σωτὴρ ἔλεγεν· Ὁμοία ἐστὶν ἡ βασιλεία τῶν οὐρανῶν δέκα παρθένοις, ὧν ἦσαν πέντε φρόνιμοι καὶ πέντε μωραί.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s22",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s22",
    "language": "grc",
    "text": "Ἀπεικάζει τὰς πέντε διαιρέσεις δέκα παρθένοις. Ἑκάστη γὰρ γενεὰ ἔσχε μίαν παρθένον συνετὴν καὶ μίαν ἀσύνετον, τουτέστιν ἓν τάγμα πιστὸν καὶ ἓν ἄπιστον.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s23",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s23",
    "language": "grc",
    "text": "Πάλιν ταύτας τὰς πέντε διαιρέσεις ἀπεικάζει ἑτέρᾳ παραβολῇ ὁ σωτήρ·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s24",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s24",
    "language": "grc",
    "text": "Ὁμοία ἐστὶν ἡ βασιλεία τῶν οὐρανῶν ἀνθρώπῳ οἰκοδεσπότῃ, ὃς ἐξῆλθεν ἅμα πρωὶ μισθώσασθαι ἐργάτας εἰς τὸν ἀμπελῶνα αὐτοῦ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s25",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s25",
    "language": "grc",
    "text": "Τὸ πρωὶ τοῦ κόσμου ἡ τοῦ Ἀδὰμ κατασκευή. Τῷ γὰρ θεῷ πᾶς αἰὼν ὡς ἡμέρα μία. Εἶδες πρώτην διαίρεσιν;",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s26",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s26",
    "language": "grc",
    "text": "Ἐξῆλθε τρίτην ὥραν τοὺς περὶ τὸν Νῶε ζητῶν, ἐξῆλθεν ἕκτην ὥραν τοὺς περὶ τὸν Ἀβραὰμ ζητῶν,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta033/pta-grc1#pta0001.pta033.1.s27",
    "work_id": "pta/pta0001/pta033/pta-grc1",
    "canonical_ref": "pta0001.pta033.1.s27",
    "language": "grc",
    "text": "ἐξῆλθεν ἐνάτην ὥραν τοὺς περὶ τὸν Μωϋσέα ζητῶν, ἐξῆλθεν ἑνδεκάτην ὥραν τὴν τοῦ σωτῆρος ἐπιδημίαν ζητῶν.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
