  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.19.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.19.s1",
    "language": "grc",
    "text": "Καλῶς ἀπότομος ὁ Πέτρος, εὐγνώμων ἀλλ’ ἀγνοῶν τὴν οἰκονομίαν, πίστει παραιτεῖται καὶ εὐγνωμόνως ὑπακούει·",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
