    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.22.s2",
    "language": "grc",
    "text": "Αὐτός σου τηρήσει κεφαλὴν καὶ σὺ τηρήσεις αὐτοῦ πτέρναν , ἅπτεται τοῦ τόπου τῆς πτέρνης καθ’ ἧς ἡ ἀπόφασις,",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
