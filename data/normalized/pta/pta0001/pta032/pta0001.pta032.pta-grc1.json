    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.9.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.9.s2",
    "language": "grc",
    "text": "οὐ σανίδα τιμῶντες ἢ τὴν κηρόχυτον γραφὴν τοῦτο ποιοῦσι ἀλλὰ τὸν χαρακτῆρα τοῦ βασιλέως, οὕτω καὶ ἡ κτίσις οὐ τὸ γήϊνον σκεῦος τιμᾷ ἀλλὰ τὸν ἐπουράνιον χαρακτῆρα αἰδεῖται.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
