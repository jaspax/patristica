    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.20.s2",
    "language": "grc",
    "text": "ἀλλότριον αὐτὸν ποιεῖ τῆς ἑαυτοῦ μερίδος, ἵνα μὴ νικήσῃ ἡ ἀνθρωπίνη ἔνστασις ἀλλὰ νικήσῃ ἡ τοῦ θεοῦ βούλησις.",
    "chunk_index": 63,
    "context_before": null,
