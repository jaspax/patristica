    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.20.s4",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.20.s4",
    "language": "grc",
    "text": "Μὴ μόνον τοὺς πόδας ἀλλὰ καὶ τὰς χεῖρας καὶ τὴν κεφαλήν, ὅλον με νίψον, ὅλον με πλῦνον, ἵνα εἴπω κἀγὼ μετὰ τοῦ Δαυίδ· Πλυνεῖς με καὶ ὑπὲρ χιόνα λευκανθήσομαι.",
    "chunk_index": 65,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
