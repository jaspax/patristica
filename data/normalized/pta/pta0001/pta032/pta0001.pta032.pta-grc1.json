    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.10.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.10.s1",
    "language": "grc",
    "text": "Πάντα τοίνυν ἐγένετο οὐ διὰ χρείαν θεοῦ ἀλλὰ διὰ χρῆσιν ἡμῶν καὶ ἵνα δοξάζωμεν τὴν τοῦ θεοῦ φιλανθρωπίαν.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
