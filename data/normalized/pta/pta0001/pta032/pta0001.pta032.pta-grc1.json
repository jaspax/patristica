[
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.1.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.1.s1",
    "language": "grc",
    "text": "Ἔλεον θεοῦ καὶ φιλανθρωπίαν κηρύττει μὲν ἡ κτίσις ἅπασα, κηρύττει δὲ καὶ ἡ τῆς κτίσεως οἰκονομία. Οὐδὲν γάρ ἐστι τῶν φαινομένων ὃ μὴ τὴν τοῦ θεοῦ κηρύττει ἀγαθότητα·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.1.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.1.s2",
    "language": "grc",
    "text": "ἀλλὰ καὶ οὐρανὸς καὶ γῆ καὶ θάλασσα καὶ πάντα τὰ ὁρώμενα καὶ τὰ μὴ ὁρώμενα ἐλέῳ θεοῦ γέγονε καὶ συνίσταται καὶ φυλάττεται.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.1.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.1.s3",
    "language": "grc",
    "text": "Εἰκότως τοίνυν ὁ μακάριος Δαυὶδ κηρύττει ἀπὸ τῆς φιλανθρωπίας τὸν ἐλεήμονα λέγων· Ἐλεήμων ὁ κύριος καὶ δίκαιος καὶ ὁ θεὸς ἡμῶν ἐλεεῖ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.2.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.2.s1",
    "language": "grc",
    "text": "Ἔμιξε τῇ φιλανθρωπίᾳ τὴν δικαιοσύνην καὶ δίκαιον καλεῖ καὶ φιλάνθρωπον, ἵν’ ὅταν δίκαιον ἀκούσῃς, φοβηθῇς τὴν κρίσιν, ὅταν δὲ φιλάνθρωπον, προσδράμῃς τῇ μετανοίᾳ.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.2.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.2.s2",
    "language": "grc",
    "text": "Καὶ οὐ κηρύττει τὴν φιλανθρωπίαν ἀπόλυτον οὔτε τὴν δικαιοσύνην γυμνήν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.2.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.2.s3",
    "language": "grc",
    "text": "Ἐὰν γὰρ μόνην τὴν δικαιοσύνην κηρύξῃ, ἀπαγορεύει τοὺς τῷ ἐλέει ἐλπίζοντας, καὶ ἐὰν μόνην τὴν φιλανθρωπίαν εἴπῃ, εἰς καταφρόνησιν ἄγει τοὺς ἀμελεστέρους.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.2.s4",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.2.s4",
    "language": "grc",
    "text": "Ἐλεήμων καὶ οἰκτίρμων καὶ δίκαιος κύριος ὁ θεός. Συνῆψε μὲν δικαιοσύνῃ φιλανθρωπίαν, ἀρχὴν δὲ καὶ ἐπισφράγισμα τοῦ ῥήματος ἐλεημοσύνην ἔθηκεν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.3.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.3.s1",
    "language": "grc",
    "text": "Τὰ γὰρ πάντα ἀπὸ φιλανθρωπίας καὶ ἤρξατο καὶ ἔληξεν εἰς φιλανθρωπίαν·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.3.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.3.s2",
    "language": "grc",
    "text": "οὐρανὸς διὰ φιλανθρωπίαν ἐγένετο, οὐ διὰ χρῆσιν θεοῦ· ἀφ’ οὗ γὰρ ὁ οὐρανὸς ἐδημιουργήθη, οὐδέπω ἑξακισχίλια ἔτη.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.3.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.3.s3",
    "language": "grc",
    "text": "Πρὸ δὲ τῶν οὐρανῶν καὶ πρὸ τῶν αἰώνων ἐκείνων τῶν ἀπείρων καὶ ἀρχὴν οὐκ ἐχόντων ὁ θεός ἐστι καὶ ἦν· καὶ πρὸ πάσης ἐπινοίας τὸ ἦν λέλεκται.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.3.s4",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.3.s4",
    "language": "grc",
    "text": "Οὐκ ἐγένετο οὖν ὁ οὐρανὸς διὰ χρῆσιν θεοῦ, ἀλλὰ διὰ φιλανθρωπίαν. Διὰ τοῦτο οἱ οὐρανοὶ διηγοῦνται οὐ χρῆσιν θεοῦ, ἀλλὰ δόξαν θεοῦ",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.4.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.4.s1",
    "language": "grc",
    "text": "Λέγεται μὲν γὰρ ὁ θεὸς ἡμῶν ἐν τῷ οὐρανῷ ἄνω · ἀλλὰ λέλεκται οὐχ ὡς χρείαν αὐτοῦ ἔχοντος τοῦ θεοῦ, ἀλλ’ ὡς ἐπαναπαυομένου τοῖς ἐν τῷ οὐρανῷ ἀγγέλοις.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.4.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.4.s2",
    "language": "grc",
    "text": "Οὐρανὸν γὰρ πολλάκις καλεῖ ἡ γραφὴ τοὺς ἐν οὐρανῷ ἀγγέλους, ὥσπερ καὶ γῆν τοὺς ἀπὸ γῆς ἀνθρώπους.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.4.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.4.s3",
    "language": "grc",
    "text": "Καθὼς ἡ ἱστορία αἰνιττομένη τὸν καιρὸν τοῦ ἀρίστου φησίν· Πᾶσα δὲ ἡ γῆ ἠρίστα , ἀντὶ τοῦ Καιρὸς ἦν ἀρίστου.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.4.s4",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.4.s4",
    "language": "grc",
    "text": "Καλεῖ οὖν γῆν τοὺς ἀπὸ γῆς ἀνθρώπους καὶ οὐρανὸν τοὺς ἐν οὐρανῷ ἀγγέλους.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.5.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.5.s1",
    "language": "grc",
    "text": "Καὶ τοῦτο δηλοῖ τό· Εὐφραινέσθωσαν οἱ οὐρανοὶ καὶ ἀγαλλιάσθω ἡ γῆ. Οὗτοι οἱ ἐν οὐρανῷ διὰ τί εὐφραινέσθωσαν οἱ ἄγγελοι;",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.5.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.5.s2",
    "language": "grc",
    "text": "Ἐπὶ τῇ τοῦ κόσμου σωτηρίᾳ. Καὶ τίς ἐγγυᾶται τὴν φωνὴν ταύτην; Αὐτὸς ὁ βασιλεὺς τῶν ἀγγέλων λέγων·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.5.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.5.s3",
    "language": "grc",
    "text": "Ἀμὴν ἀμὴν λέγω ὑμῖν, χαρὰ γίνεται ἐνώπιον πάντων ἀγγέλων τῶν ἐν οὐρανοῖς ἐπὶ ἑνὶ ἁμαρτωλῷ μετανοοῦντι.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.6.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.6.s1",
    "language": "grc",
    "text": "Ἐγένετο οὐρανὸς εἰς δόξαν μὲν θεοῦ, εἰς χρῆσιν δὲ ἡμετέραν, ἵνα ἥλιος μὲν ἡμῖν καταλάμπῃ καὶ σελήνη καὶ πάντα ἄστρα.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.6.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.6.s2",
    "language": "grc",
    "text": "Οὐδὲ γὰρ ἡλίου ἔχρηζεν ὁ θεός. Ὁ δημιουργὸς τοῦ φωτὸς οὐκ ἔχρηζεν φωτὸς αἰσθητοῦ ὁ μόνος ἔχων ἀθανασίαν, φῶς οἰκῶν ἀπρόσιτον.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.7.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.7.s1",
    "language": "grc",
    "text": "Καὶ οὐδὲν θαυμαστὸν εἰ ὁ θεὸς οὐ χρῄζει φωτὸς αἰσθητοῦ· οὐδὲ γὰρ ἄγγελοι φωτὸς χρῄζουσιν ἐπιγείου, ἀλλὰ μόνου τοῦ ἐπουρανίου·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.7.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.7.s2",
    "language": "grc",
    "text": "ἐπουράνιον δὲ φῶς αὐτὸς ὁ θεός· οὕτως μαρτυρεῖ ἡ τῶν πράξεων βίβλος· Κατὰ δὲ τὴν μέσην νύκτα ἄγγελος ἐπέστη τῷ δεσμωτηρίῳ ἐν ᾧ ἦν ὁ Πέτρος.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.7.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.7.s3",
    "language": "grc",
    "text": "Καὶ τί φησιν ὁ ἱστοριογράφος, μᾶλλον δὲ τὸ πνεῦμα τὸ ἅγιον τὸ δι’ ἐκείνου φθεγγόμενον; Καὶ ἰδοὺ ἄγγελος ἐπέστη ἐν τῇ νυκτὶ καὶ φῶς ἔλαμψεν ἐν τῇ οἰκήματι.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.7.s4",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.7.s4",
    "language": "grc",
    "text": "Εἰ δὲ ἄγγελος οὐ χρῄζει φωτὸς ὁ γενόμενος, ὁ ποιητὴς τῶν ἀγγέλων καὶ πάσης κτίσεως φωτὸς χρῄζει;",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.7.s5",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.7.s5",
    "language": "grc",
    "text": "Οὐ χρῄζει τοίνυν φωτὸς ἀλλ’ ἡμᾶς διὰ τοῦ φωτὸς εὐφραίνει, ἡμᾶς ζωοποιεῖ, ἡμᾶς θάλπει.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.8.s1",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.8.s1",
    "language": "grc",
    "text": "Τὰ πάντα γὰρ ἐγένετο διὰ δόξαν μὲν αὐτοῦ, χρῆσιν δὲ ἡμετέραν, ἥλιος ἵνα ἀνθρώπους μὲν καταλάμπῃ,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.8.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.8.s2",
    "language": "grc",
    "text": "νεφέλαι δὲ εἰς τὴν τῶν ὄμβρων διακονίαν καὶ γῆ εἰς τὴν τῶν καρπῶν εὐθηνίαν καὶ θάλασσα εἰς τὴν τῶν ἐμπόρων ἀφθονίαν.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.8.s3",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.8.s3",
    "language": "grc",
    "text": "Πάντα συλλειτουργεῖ τῷ ἀνθρώπῳ, μᾶλλον δὲ τῇ εἰκόνι τοῦ θεοῦ.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
