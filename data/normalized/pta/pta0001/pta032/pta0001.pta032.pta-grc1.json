    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta032/pta-grc1#pta0001.pta032.21.s2",
    "work_id": "pta/pta0001/pta032/pta-grc1",
    "canonical_ref": "pta0001.pta032.21.s2",
    "language": "grc",
    "text": "Ταύτην τὴν καλὴν νίψιν τῶν ποδῶν θεασάμενος Ἡσαΐας πρὸ μακρῶν ἄνωθεν χρόνων καὶ εἰδὼς ὅτι οὐκ ἄνθρωπος ἔπλυσεν, ἀλλὰ θεὸς ἔσμηξεν, ἐβόα λέγων·",
    "chunk_index": 68,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
