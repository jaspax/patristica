  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.2.s32",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.2.s32",
    "language": "grc",
    "text": "Ἐὰν γὰρ μιμήσῃ τῆς μελίττης τὸ κέντρον, κατηγορεῖ σου Δαυὶδ λέγων· Πάντα τὰ ἔθνη ἐκύκλωσάν με, ὡσεὶ μέλισσαι κηρίον, καὶ τῷ ὀνόματι κυρίου ἠμυνάμην αὐτούς.",
    "chunk_index": 69,
    "context_before": null,
