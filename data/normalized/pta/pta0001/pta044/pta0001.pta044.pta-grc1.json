    "canonical_ref": "pta0001.pta044.2.s13",
    "language": "grc",
    "text": "καὶ ἀκούεις παρὰ τοῦ κυρίου· Γίνεσθε φρόνιμοι ὡς ὁ ὄφις, καὶ ἀκέραιοι ὡς αἱ περιστεραί.",
    "chunk_index": 50,
    "context_before": null,
