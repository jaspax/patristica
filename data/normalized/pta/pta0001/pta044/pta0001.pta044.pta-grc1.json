[
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s1",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s1",
    "language": "grc",
    "text": "Καλοὶ τῆς εὐσεβείας οἱ λειμῶνες, οὐ προσκαίροις χροιαῖς κομῶντες, ἀλλ’ οὐρανίοις ἄνθεσι βρύοντες. Ἄνθη δέ εἰσι τῆς εὐσεβείας, οἱ καρποὶ τῆς ἐνθέου πολιτείας.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s2",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s2",
    "language": "grc",
    "text": "Αἱ γὰρ ἀρεταὶ ἀνάγουσιν ἡμᾶς εἰς τὸ θαυμαστὸν καὶ πρωτότυπον ἐκεῖνο κάλλος τὸ κατ’ εἰκόνα θεοῦ γεγενημένον καὶ καθ’ ὁμοίωσιν . Αὕτη τοίνυν ἡ κατ’ ἀρετὴν ὁμοίωσις ἵππον ἀντὶ ἀνθρώπου οὐκ ἐᾷ λέγεσθαι.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s3",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s3",
    "language": "grc",
    "text": "Ταύτην οὖν ὅταν μεταδιώκωμεν, οὐκ ἔτι λύκος καὶ δράκων καὶ ὄφις καὶ σκορπίος ὀνομαζόμεθα, πρὸς τὴν τῶν ἀλόγων ὕβριν καταφερόμενοι·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s4",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s4",
    "language": "grc",
    "text": "ἀλλ’ εἰκὼν θεοῦ θαυμαστὴ καὶ τιμία, τὸ πρωτότυπον κάλλος τοῦ χαρακτῆρος σώζουσα, καὶ ἐσμέν, καὶ λεγόμεθα, καὶ πιστευόμεθα.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s5",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s5",
    "language": "grc",
    "text": "Δεσπότης ἐγένου τῶν ἀλόγων· μὴ μιμοῦ τῶν οἰκετῶν τὰ ἤθη· οὐκ ἐπειδὴ φαῦλα τὰ ἄλογα· οὐδὲν γὰρ παρὰ τοῦ ἀγαθοῦ κακὸν ἐκτίσθη.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s6",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s6",
    "language": "grc",
    "text": "Μὴ γάρ τις νομιζέτω ἐν χώρᾳ κακίας τὰ ἄλογα τάττεσθαι, διὰ τὸ εἰκόνα κακίας παρῆχθαι τῶν μὴ κατ’ ἀρετὴν βιούντων.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s7",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s7",
    "language": "grc",
    "text": "Εἰ γὰρ τοῦτο, πῶς εἶπεν ἡ γραφὴ καὶ εἶδεν ὁ θεὸς πάντα ὅσα ἐποίησε, καὶ ἰδοὺ καλά , καὶ οὐχ ἁπλῶς καλά, ἀλλὰ καὶ καλὰ λίαν ;",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s8",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s8",
    "language": "grc",
    "text": "Ὁπότε οὖν τὰ γεγονότα εἰς εἰκόνα κακίας παρήχθησαν ὁ γὰρ λέων εἰκὼν τοῦ τυράννου, καὶ ὁ ὄφις τοῦ σκολιοῦ καὶ τοῦ πονηροτάτου τὸν τρόπον,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s9",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s9",
    "language": "grc",
    "text": "καὶ ὁ σκορπίος τοῦ πλήκτου, καὶ ὁ λύκος τοῦ ἁρπακτικοῦ, ποῦ ἂν εἴη καλὰ τὰ γενόμενα, φησίν, οὕτω προφανῶς εἰς εἰκόνα κακίας παραλαμβανόμενα;",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s10",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s10",
    "language": "grc",
    "text": "Δεῖ δὲ εἰδέναι τοὺς φιλομαθεῖς, ὅτι ταῦτα τῇ οἰκείᾳ φύσει κακὰ οὔτ’ ἔστιν, οὔτε λέγεται, ἀλλὰ τοῖς ἀλόγοις πρέπουσα κατάστασις.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s11",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s11",
    "language": "grc",
    "text": "Ἐπειδὰν δὲ ἔλθῃ εἰς τὴν λογικὴν φύσιν, ὑβρίζει τὴν θέαν καὶ ἀμβλύνει τὴν λογικὴν ἐλευθερίαν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s12",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s12",
    "language": "grc",
    "text": "Ἔλαβες, ἄνθρωπε, τὴν δεσποτικὴν ἀξίαν· μὴ τὴν ἄτιμον καὶ δουλοπρεπῆ τῶν ἀλόγων μεταδίωκε τάξιν· ὑβρίζεις γὰρ σαυτόν, μιμούμενος τῶν ἀλόγων τὴν θηριωδίαν·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s13",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s13",
    "language": "grc",
    "text": "οὐχ ὡς τῶν ἀλόγων κακῶν ὄντων, ἢ λεγομένων, ἀλλ’ ὡς τῆς ἀτίμου καὶ δουλοπρεποῦς εἰκόνος οὐ πρεπούσης τοῖς ἐλευθέροις.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s14",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s14",
    "language": "grc",
    "text": "Ὥσπερ γάρ τις ἀνὴρ ἐπίσημος καὶ ἐπίδοξος, ἐὰν ἐνδύσηται ἢ περιβάληται δούλου στολήν, ὑβρίζεται καὶ καταισχύνεται,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s15",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s15",
    "language": "grc",
    "text": "οὐχ ὡς τῆς ἐσθῆτος οὔσης φαύλης καὶ ῥυπαρᾶς, ἀλλ’ ὡς δούλῳ μὲν πρεπούσης, ἐλευθέρῳ δὲ μὴ ἁρμοττούσης·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s16",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s16",
    "language": "grc",
    "text": "οὕτως ἐὰν ἦθος σκορπίου καὶ λύκου ἀναλάβῃς, οὐχ ἡ φύσις τῶν ἀλόγων διαβάλλεται, ἀλλ’ ἡ σὴ κατάστασις ὑβρίζεται ἡ δεσποτείαν λαχοῦσα, καὶ τὰ δούλου μεταδιώκουσα.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s17",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s17",
    "language": "grc",
    "text": "Ταῦτα δέ μοι ἀναγκαίως παρῆκται, ἵνα μηδεὶς εἰς ὕβριν τῆς δημιουργίας ἐκλάβῃ τὰ εἰρημένα, ὡς τοῦ θεοῦ φαῦλόν τι πεποιηκότος·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s18",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s18",
    "language": "grc",
    "text": "πάντα γὰρ ἀληθῶς καλά καὶ καλὰ λίαν , ἐὰν τὴν οἰκείαν φυλάττῃ τάξιν καὶ τὸν οἰκεῖον μεταδιώκῃ νόμον.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s19",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s19",
    "language": "grc",
    "text": "Ἵνα δὲ μάθῃς, ἀγαπητέ, ὅτι οὐδὲν φαῦλον γεγένηται παρὰ τοῦ θεοῦ κατὰ φύσιν, ἐδίδαξεν ἡμᾶς ὁ θεὸς καὶ τῶν ἀλόγων τούτων εἰκόνα λαμβάνειν.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s20",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s20",
    "language": "grc",
    "text": "Ὑπέθηκε γάρ τινα μιμεῖσθαι τῶν ἀλόγων πλεονεκτήματα, ἵνα μὴ διαβάλλωμεν εἰς κακίαν τὰ γεγονότα, οὐ καθόλου τὴν φύσιν, ἀλλ’ ὅσα ἁρμόζει λογικῇ καταστάσει.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s21",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s21",
    "language": "grc",
    "text": "Ἢ οὐκ ἤκουσας σήμερον τοῦ Παροιμιαστοῦ λέγοντος· Πορεύθητι πρὸς τὸν μύρμηκα, ὀκνηρέ, καὶ ζήλωσον τὰς ὁδοὺς αὐτοῦ ;",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s22",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s22",
    "language": "grc",
    "text": "Οὐ συνῆκας πῶς τὴν τοῦ μύρμηκος φιλοπονίαν ὑποθέμενος, εἰς ἄοκνον ἡμῶν προθυμίαν ἐπαιδαγώγησεν;",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s23",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s23",
    "language": "grc",
    "text": "Οὐκ ἐδιδάξαμέν σε ῥητῶς ἀπὸ μὲν τοῦ μύρμηκος τὸ ἄοκνον, ἀπὸ δὲ τῆς μελίσσης τὸ φιλότεχνον;",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s24",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s24",
    "language": "grc",
    "text": "Ἔστι γάρ, ἔστιν, ὡς ἔφθην εἰπών, ἀπανθήσασθαί τινα καὶ τῶν ἀλόγων πλεονεκτήματα ἁρμόζοντα λογικῇ καταστάσει·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s25",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s25",
    "language": "grc",
    "text": "πλήν γε ταῦτα πρὸς ἡμετέραν λέγονται αἰσχύνην καὶ ὄνειδος. Ἐπειδὴ γὰρ θεὸν οὐκ ἐμιμήσω, μίμησαι, φησί, τὸν μύρμηκα.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s26",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s26",
    "language": "grc",
    "text": "Οὐκ εἶδές ποτε πατέρα γνήσιον ἐπιτιμῶντα τὰ τέκνα, καὶ μετὰ πολλὴν παιδείαν εἰς μίμησιν αὐτὰ οἰκετῶν ἀνάγοντα, καὶ ταῦτα προφανῶς λέγοντα·",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s27",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s27",
    "language": "grc",
    "text": "Μίμησαι κἂν τὸν οἰκέτην, ὑποδεέστερον μὲν τῇ ἀξίᾳ, ὑπερέχοντα δὲ τῇ ἐπιστήμῃ;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.1.s28",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.1.s28",
    "language": "grc",
    "text": "Ὅθεν ὁ φιλάνθρωπος θεὸς εἰς ἔνδειξιν τῆς ἡμετέρας ἀγνωμοσύνης προσφέρει τὸν μύρμηκα ἐλέγχοντα ἡμῶν τὸν ὄκνον, καὶ τὴν μέλιτταν ἐλέγχουσαν ἡμῶν τὴν ῥᾳθυμίαν.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
