    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.2.s28",
    "language": "grc",
    "text": "Ὅρα τοίνυν πῶς τὴν μὲν αὐτὴν εἰκόνα παρήγαγε, ταῖς δὲ λέξεσι τὰς ἐννοίας ἐμέρισεν.",
    "chunk_index": 65,
