  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.2.s30",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.2.s30",
    "language": "grc",
    "text": "ἐπὶ δὲ τοῦ δικαίου οὐκ εἶπεν ὡσεὶ κέδρος ἡ ἐν τῷ Λιβάνῳ ἐπανθήσεται, ἀλλὰ πληθυνθήσεται . Οὕτως οὖν καὶ τὴν μέλιτταν μίμησαι, ὦ ἄνθρωπε, ἣν καὶ ἡ γραφὴ διδάσκει μιμεῖσθαι πρὸς φιλοπονίαν.",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
