    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.2.s2",
    "language": "grc",
    "text": "Πανοῦργος τοίνυν ἐστὶν οὐκ εἰς τὸ μελετᾶν κακίαν, ἀλλ’ εἰς τὸ φεύγειν κακίαν.",
    "chunk_index": 39,
