  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.2.1.s2",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.2.1.s2",
    "language": "grc",
    "text": "καὶ ποιεῖν ἐκεῖνο τὸ ὑπὸ τοῦ Δαυὶδ εἰρημένον, τὸ ἔχειν τὸν νόμον τοῦ θεοῦ πάντοτε ἐν μέσῳ τῆς κοιλίας ἡμῶν, ἤγουν τὰ θεῖα νοήματα,",
    "chunk_index": 80,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
