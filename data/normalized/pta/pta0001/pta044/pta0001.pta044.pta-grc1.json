    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta044/pta-grc1#pta0001.pta044.2.s35",
    "work_id": "pta/pta0001/pta044/pta-grc1",
    "canonical_ref": "pta0001.pta044.2.s35",
    "language": "grc",
    "text": "ποθήσωμεν ἐξ ὅλης ψυχῆς, καὶ τὸ κηρίον ἐργασώμεθα τὸ νοερὸν ἐν τῷ κρυπτῷ τῆς ψυχῆς ἐργαστηρίῳ, καὶ τὰ θεῖα λόγια λάβωμεν ὑπὲρ μέλι καὶ κηρίον .",
    "chunk_index": 72,
    "context_before": null,
