    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s8",
    "language": "lat",
    "text": "Quae sunt et opera in terra sanctorum, nisi angelicam vitam agere in terris, et dignis Deum laudibus praedicare?",
