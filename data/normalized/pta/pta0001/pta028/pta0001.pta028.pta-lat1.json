    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s4",
    "language": "lat",
    "text": "Hodie enim effulsit veritas cum rege coelesti. Christi enim praesentia verae lucis adventus est, et totius mundi plena libertas.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
