    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s7",
    "language": "lat",
    "text": "Negant enim propter charitatem Christi naturam corporis, et ministerium suscipiunt Angelorum. Quid enim aliud agunt Angeli in coelis, nisi quod divinis obtemperant nutibus?",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
