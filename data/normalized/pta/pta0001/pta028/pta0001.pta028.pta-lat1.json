    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s5",
    "language": "lat",
    "text": "Adverte ergo, charissime, dignam Deo Ecclesiae disciplinam, adverte coelestis desiderii inexstinguibilem flammam, adverte corporis hanc naturam Angelorum ministeriis coaequari.",
    "chunk_index": 4,
    "context_before": null,
