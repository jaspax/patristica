    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s2",
    "language": "lat",
    "text": "Laetetur omnis anima, omnis concinat lingua, et terra Domini psallat universa. Hodie enim gratiam lucis, in die lucis, filius lucis irradiat.",
    "chunk_index": 1,
    "context_before": null,
