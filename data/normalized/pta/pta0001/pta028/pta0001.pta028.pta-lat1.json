    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s6",
    "language": "lat",
    "text": "Homines enim de terra, et habitantes in terra, quos etiam terra nutrit, supernis Potestatibus aemulantur.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
