    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.2.s1",
    "language": "lat",
    "text": "Hodie ergo, charissimi, Dominus noster Jesus Christus in Jordanis fluenta descendit: non ut ipse sanctificaretur, sed ut aquis futuris vitalibus sanctificationem ipse praeberet.",
    "chunk_index": 9,
    "context_before": null,
