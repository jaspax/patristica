    "canonical_ref": "pta0001.pta028.1.s1",
    "language": "lat",
    "text": "Aperiatur hodie omne os, dilectissimi, et collaudet omne verbum, Dei Verbum quod effulsit de coelo.",
    "chunk_index": 0,
    "context_before": null,
