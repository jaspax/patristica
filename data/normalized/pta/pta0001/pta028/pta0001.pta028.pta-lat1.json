    "work_id": "pta/pta0001/pta028/pta-lat1",
    "canonical_ref": "pta0001.pta028.1.s9",
    "language": "lat",
    "text": "Quorum ergo idem est officium, ambiguum non est quod eadem possit esse et dignitas.",
