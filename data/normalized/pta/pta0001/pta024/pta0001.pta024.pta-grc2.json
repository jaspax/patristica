    "canonical_ref": "pta0001.pta024.1.s2",
    "language": "grc",
    "text": "μὴ τοίνυν ἀπεχώμεθα τῆς ἀκολουθίας, ἀλλὰ κἂν αἱ ἀναγνώσεις τὸν ἴδιον ἀνυέτωσαν δρόμον, ἡμεῖς δὲ τῆς ἱστορίας τὴν ἀκολουθίαν φυλάξωμεν.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
