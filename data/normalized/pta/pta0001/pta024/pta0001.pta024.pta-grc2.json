    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s17",
    "language": "grc",
    "text": "καὶ ὅρα τὸ θαυμαστόν. ἐπειδὴ Αβελ πρῶτος δικαιοσύνῃ συνηγωνίσατο, πρῶτος ὑπὲρ εὐσεβείας ἡξιώθη παθεῖν.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
