    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s16",
    "language": "grc",
    "text": "ἀρχὴν ἔπηξε δικαιοσύνης τὸν ἐπιβουλευόμενον μὲν παρὰ ἀνθρώποις, στεφανούμενον δὲ παρὰ τῷ Θεῷ, τὸν Αβελ.",
    "chunk_index": 15,
    "context_before": null,
