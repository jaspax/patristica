  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s3",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s3",
    "language": "grc",
    "text": "ἐν τοῖς προηγησαμένοις λόγοις παρεδίδοτο ἐκ τῆς τοῦ ἁγίου πνεύματος διδασκαλίας, τίς γέγονεν ἡ τοῦ ἀνθρώπου κατασκευὴ, τίς ἡ τιμὴ, τίς ἡ τάξις, τίς ἡ τῶν πραγμάτων δοθεῖσα ἡγεμονία.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s4",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s4",
    "language": "grc",
    "text": "ἴσ ἠκολούθησε ἥκει γὰρ τούτοις ἡ ἀπάτη ἡ ἐν παραδείσῳ, ἡ ἐξετασθεῖσα δίκη, ἡ ἐξενεχθεῖσα μετὰ φιλανθρωπίας ἀπόφασις.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s5",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s5",
    "language": "grc",
    "text": "τούτοις ἡκολούθησε τὰ κατὰ τὸν Κάϊν καὶ τὸν Αβελ, ὄψει μὲν τῇ αὐτῇ τὸν Θεὸν τιμᾶν ἐπιχειρησάντων, διαφόρῳ δὲ διαθέσει τὴν λειτουργίαν ἀναλαβόντων.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s6",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s6",
    "language": "grc",
    "text": "προσήνεγκε γὰρ καὶ οὗτος κἀκεῖνος· ἀλλὰ τοῦ μὲν σχῆμα μόνον δώρου εἶχεν ἡ προσφορὰ, τοῦ δὲ καὶ τὴν πρέπουσαν διάθεσιν καὶ τιμήν.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s7",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s7",
    "language": "grc",
    "text": "εἶτα ἠκολούθησε φθόνος. τῇ γὰρ εὐσεβείᾳ ἀκολουθεῖ ἀεὶ παρὰ μὲν τῶν κακῶν φθόνος, παρὰ δὲ τοῦ βραβευτοῦ στέφανος.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s8",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s8",
    "language": "grc",
    "text": "ἀνηρέθη ὁ Αβελ ὁ πρῶτος τῆς δικαιοσύνης κήρυξ, ὁ πρῶτος εὐσέβειαν ἀγαπήσας καὶ μεταδιώξας, ὁ πρῶτος ἀλήθειαν τιμήσας καὶ μετὰ ἀληθείας τὸν Θεὸν ἀγαπήσας καὶ προσκυνήσας,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s9",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s9",
    "language": "grc",
    "text": "ὁ ἐν πολλοῖς μιμητὴς τοῦ Χριστοῦ γενόμενος. εὐρίσκω γὰρ τὸν ἅγιον Αβελ πολλὰς τοῦ Χριστοῦ εἰκόνας δεξάμενον.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s10",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s10",
    "language": "grc",
    "text": "ὥσπερ γὰρ ὁ σωτὴρ τῶν μετὰ τὸν νόμον ἀνακαινιζομένων ἀρχηγὸς καὶ πρῶτος δίκαιος, οὕτω τῶν ἀρχαίων πάντων ἀνθρώπων ἀρχηγὸς δικαιοσύνης Αβελ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s11",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s11",
    "language": "grc",
    "text": "οὔτε ἐν τῷ ἀνακαινισμῷ τῆς ἀνθρωπότητος, ἣν ἀνεκαίνισεν ὁ πάντων δεσπότης, εὑρίσκεις τι τοῦ δεσποτικοῦ ἴσ. πρότερον πρῶτον σώματος, οὔτε ἐν τῇ παλαιᾷ τῶν ἀνθρώπων τάξει εὑρίσκεις δικαιοσύνην προλάμψασαν τοῦ Αβελ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s12",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s12",
    "language": "grc",
    "text": "ἐκεῖνος ἀρχηγὸς τῶν παλαιῶν δικαίων, καὶ οὗτος ἀρχηγὸς καὶ τῶν νέων δικαίων καὶ τῶν μετὰ ἀληθείας ἀνακαινιζομένων ἁγίων.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta024/pta-grc2#pta0001.pta024.1.s13",
    "work_id": "pta/pta0001/pta024/pta-grc2",
    "canonical_ref": "pta0001.pta024.1.s13",
    "language": "grc",
    "text": "διὰ τοῦτο ὁ σωτὴρ ἔπηξε τοῦ Αβελ τὴν μνήμην πάσης δικαιοσύνης ἀρχήν.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
