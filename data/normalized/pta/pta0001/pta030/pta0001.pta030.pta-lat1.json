    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s8",
    "language": "lat",
    "text": "Hodie Christus, qui est rex pacis, cum sua pace procedens, fugavit omne dissidium, dissensiones depulit, discordiam perturbavit.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0001/pta030/pta-lat1#pta0001.pta030.1.s9",
    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s9",
    "language": "lat",
    "text": "Et sicut coelum splendor solis, ita ecclesiam fulgor pacis illuminat.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
