    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s11",
    "language": "lat",
    "text": "Pax nomen est ipsius Christi, sicut dicit et apostolus: Quia Christus pax nostra, qui fecit utraque unum , quae nequaquam fide, sed invidia diaboli dissidebant.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
