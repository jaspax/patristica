    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s7",
    "language": "lat",
    "text": "Hodie Christus in laetitia, et diabolus in luctu. Hodie angeli in exsultatione, et daemones in confusione. Et quid opus est multa dicere?",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
