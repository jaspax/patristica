    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s6",
    "language": "lat",
    "text": "Hodie vinea Domini in abundantia, et operarii iniquitatis in egentia. Hodie populus Christi exaltatus est, et inimici veritatis humiliati sunt.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
