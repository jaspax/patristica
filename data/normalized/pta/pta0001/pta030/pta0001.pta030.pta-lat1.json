    "canonical_ref": "pta0001.pta030.1.s3",
    "language": "lat",
    "text": "Ab ipsis enim sanctis angelis etiam mutuati nos vocem, annuntiamus vobis hodie gaudium magnum.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
