    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.2.s7",
    "language": "lat",
    "text": "Gloria in excelsis Deo, et in terra pax hominibus bonae voluntatis. Vides quomodo coelestes omnes et terrestres invicem sibi munera pacis emittunt?",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
