    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s5",
    "language": "lat",
    "text": "Hodie pastores ecclesiae in securitate, et haeretici in perturbatione sunt. Hodie oves Domini in tuto, et lupi insaniunt.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
