    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s4",
    "language": "lat",
    "text": "Hodie enim in pace ecclesia est, et haeretici in ira. Hodie ecclesiae navis in portu est, et haereticorum furor jactatur in fluctibus.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
