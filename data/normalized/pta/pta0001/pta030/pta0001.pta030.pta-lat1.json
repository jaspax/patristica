    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.1.s10",
    "language": "lat",
    "text": "O quam desiderabile nomen pacis, quam religionis christianae stabile fundamentum, et altaris dominici coelestis armatura! Et quid possumus de pace proloqui?",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 402,
    "date_range": [
      401,
      404
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
