    "work_id": "pta/pta0001/pta030/pta-lat1",
    "canonical_ref": "pta0001.pta030.2.s4",
    "language": "lat",
    "text": "nunc in coelestibus laetitia, et in angelis exsultatio, quibus specialis familiaris pax.",
