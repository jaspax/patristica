    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.4.s6",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.4.s6",
    "language": "grc",
    "text": "Οὐ διὰ τὴν ἀργίαν οὖν τὸ σάββατον δέδωκεν, ἀλλὰ πρὸς τὸ γινώσκειν αὐτοὺς τὴν κατάπαυσιν τῆς κτίσεως.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
