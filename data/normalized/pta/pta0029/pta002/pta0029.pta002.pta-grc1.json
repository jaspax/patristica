    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.6.s1",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.6.s1",
    "language": "grc",
    "text": "Ἡγοῦμαι δὲ καὶ διὰ τοῦτο τὴν περιτομὴν δεδόσθαι. Τοῦ γὰρ Ἀδὰμ ἀκούσαντος· Γῆ εἶ, καὶ εἰς γῆν ἀπελεύσῃ, ἔθνησκε, καὶ διεφθείρετο τὸ σῶμα·",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
