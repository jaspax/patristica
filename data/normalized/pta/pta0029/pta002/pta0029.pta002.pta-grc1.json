    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.6.s3",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.6.s3",
    "language": "grc",
    "text": "Καὶ ὥσπερ αἱ θυσίαι σκιαὶ ἦσαν τῶν μελλόντων, οὕτως καὶ ἡ ἐκ μέρους περιτομὴ τοῦ ὅλου ἦν σκιά. Τοῦτο δὲ καὶ ἐν τῷ Ἰησοῦ τῷ τοῦ Ναυῆ φανερῶς ὁ λόγος σημαίνει·",
    "chunk_index": 74,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
