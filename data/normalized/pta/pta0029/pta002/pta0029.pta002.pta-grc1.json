    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s13",
    "language": "grc",
    "text": "καὶ μετ’ ὀλίγα· Καὶ ἔσται πᾶσα ψυχὴ, ἥτις ποιήσει ἔργον ἐν αὐτῇ τῇ ἡμέρᾳ ταύτῃ, ἀπολεῖται ἡ ψυχὴ ἐκείνη ἐκ τοῦ λαοῦ αὐτῆς.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
