    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s10",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s10",
    "language": "grc",
    "text": "Ἀμέλει καὶ τὰς μὴ ἡμέρας τῶν σαββάτων, ὅμως διὰ τὴν ἄφεσιν τῶν ἁμαρτιῶν καὶ τὴν τῆς θεογνωσίας χάριν, σάββατα ὀνομάζειν εἴωθεν ὁ νόμος, μᾶλλον δὲ ὁ κύριος τοῦ νόμου, ὡς ἐν τῷ Λευϊτικῷ·",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s11",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s11",
    "language": "grc",
    "text": "καὶ ἐλάλησε κύριος πρὸς Μωσῆν λέγων· Καὶ τῇ δεκάτῃ τοῦ μηνὸς τοῦ ἑβδόμου τούτου ἡμέρα ἐξιλασμοῦ κλητὴ ἁγία ἔσται ὑμῖν·",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
