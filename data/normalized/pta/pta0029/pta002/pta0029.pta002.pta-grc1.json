  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.5.s5",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.5.s5",
    "language": "grc",
    "text": "ἣν ἑωρακὼς ὁ προφήτης φησίν· Ἰδοὺ ἀνὴρ, ἀνατολὴ ὄνομα αὐτῷ· καὶ πάλιν· Ὑμῖν δὲ τοῖς φοβουμένοις αὐτὸν ἀνατελεῖ ἥλιος δικαιοσύνης.",
    "chunk_index": 58,
    "context_before": null,
