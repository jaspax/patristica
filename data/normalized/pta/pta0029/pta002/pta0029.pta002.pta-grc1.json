[
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s1",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s1",
    "language": "grc",
    "text": "Καὶ φυλάξουσιν οἱ υἱοὶ Ἰσραὴλ τὰ σάββατα, ποιεῖν αὐτὰ εἰς τὰς γενεὰς αὐτῶν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s2",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s2",
    "language": "grc",
    "text": "Διαθήκη αἰώνιος ἐν ἐμοὶ καὶ τοῖς υἱοῖς Ἰσραὴλ, σημεῖόν ἐστιν ἐν ἐμοὶ αἰώνιον, ὅτι ἓξ ἡμέραις ἐποίησε κύριος τὸν οὐρανὸν καὶ τὴν γῆν, καὶ τῇ ἑβδόμῃ ἡμέρᾳ κατέπαυσε.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s3",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s3",
    "language": "grc",
    "text": "Σημεῖόν ἐστι τοῦ εἰδέναι τὴν τῆς κτίσεως ἡμέραν, καὶ τὸ ταύτης τέλος. Ἀκόλουθον ἦν ἕως τὰ τῆς κτίσεως ἐνεργεῖτο, ἐπὶ τῆς Ἱερουσαλὴμ ἕως τότε φυλάττειν τὰ σάββατα.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s4",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s4",
    "language": "grc",
    "text": "Ἐλθούσης δὲ τῆς ἑτέρας γενεᾶς καὶ τοῦ κτιζομένου λαοῦ, κατὰ τὸ λεγόμενον· Γραφήτω αὕτη εἰς γενεὰν ἑτέραν, καὶ λαὸς ὁ κτιζόμενος αἰνέσει τὸν κύριον·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s5",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s5",
    "language": "grc",
    "text": "ἀνάγκη μηκέτι τὸν λαὸν τοῦτον τηρεῖν τὸ τῆς προτέρας κτίσεως τέλος, ἀλλὰ τὴν ἀρχὴν τῆς δευτέρας κτίσεως ζητεῖν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s6",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s6",
    "language": "grc",
    "text": "Τίς δέ ἐστιν, ἢ καθ’ ἣν ἀνέστη ὁ κύριος; Ἔκτοτε γὰρ ἀρχὴν ἔσχεν ἡ καινὴ κτίσις, περὶ ἧς εἶπεν ὁ Παῦλος· Ὥστε εἴ τις ἐν Χριστῷ καινὴ κτίσις.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s7",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s7",
    "language": "grc",
    "text": "Τὴν μὲν οὖν προτέραν κτίσιν ποιῶν ὁ θεὸς κατέπαυσε· διὰ τοῦτο καὶ τὸ σάββατον ἐν τῇ ἡμέρᾳ τῇ ἑβδόμῃ ἐτήρουν οἱ τῆς γενεᾶς ἐκείνης·",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s8",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s8",
    "language": "grc",
    "text": "ἡ δὲ δευτέρα κτίσις τέλος οὐκ ἔχει· διὰ τοῦτο οὐδὲ κατέπαυσεν, ἀλλ’ ἕως ἄρτι ἐργάζεται.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s9",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s9",
    "language": "grc",
    "text": "Ὅθεν οὐδὲ σαββατίζομεν ἡμέραν ὡς ἐπὶ τῇ πρώτῃ, ἀλλὰ τὰ μέλλοντα ἐλπίζομεν σάββατα σαββάτων, ἃ οὐ τέλος λαμβάνει ἡ καινὴ κτίσις, ἀλλὰ φανεροῦται καὶ διόλου ἑορτάζει.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s10",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s10",
    "language": "grc",
    "text": "Διὰ γὰρ τοῦτο ἐδόθη τὸ σάββατον τῷ προτέρῳ λαῷ, ἵνα γινώσκῃ καὶ τὸ τέλος καὶ τὴν ἀρχὴν τῆς κτίσεως.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.1.s11",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.1.s11",
    "language": "grc",
    "text": "Τῇ δὲ καινῇ κτίσει οὐκ ἐνετείλατο φυλάττειν σάββατον· ἵνα τὴν μὲν ἀρχὴν ἐν τῇ κυριακῇ γινώσκῃ, ἀτελεύτητον δὲ ἐπίσταται τὴν ταύτης χάριν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s1",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s1",
    "language": "grc",
    "text": "Διὰ τοῦτο δὲ καὶ τὴν ἀρχὴν, τουτέστι τὴν κυριακὴν ἐδήλωσεν, ἵνα τὸ τέλος τῆς παρελθούσης γινώσκῃς.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s2",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s2",
    "language": "grc",
    "text": "Ὁ γοῦν ἀπόστολος περὶ τῆς προτέρας γράφων φησίν· Ὅτε δὲ ἦλθε τὸ πλήρωμα τοῦ χρόνου, ἐξαπέστειλεν ὁ θεὸς τὸν υἱὸν αὐτοῦ· καὶ πάλιν· Ἐπὶ συντελείᾳ τῶν αἰώνων.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s3",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s3",
    "language": "grc",
    "text": "Οὐκοῦν ἡ μὲν πρώτη πεπλήρωται καὶ τετελείωται, οὐκ ἄλλοτε ἢ ὡς οἱ προφῆται ἔλεγον· Ἐν ταῖς ἐσχάταις ἡμέραις ἐκχεῶ ἀπὸ τοῦ πνεύματός μου.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s4",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s4",
    "language": "grc",
    "text": "Τέλος δὲ ἐχουσῶν τῶν πρώτων ἡμερῶν, ἄλλαι γίνονται, ὡς ὁ Ἱερεμίας φησίν· Ἰδοὺ ἡμέραι ἔρχονται, λέγει Κύριος.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s5",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s5",
    "language": "grc",
    "text": "Τέλος δὲ ἐχούσης τῆς πρώτης, ἀκολούθως ἑτέρας ἀρχὴ γέγονε· διὰ τοῦτο μετὰ τὸ σάββατον ἀνέστη ὁ κύριος·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s6",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s6",
    "language": "grc",
    "text": "οὐ γὰρ προηγουμένως εἵνεκεν τοῦ ἀργεῖν τοὺς ἀνθρώπους ἐδίδου τὸ σάββατον ὁ θεὸς ὁ λέγων·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s7",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s7",
    "language": "grc",
    "text": "Ὁδοὶ ἀεργῶν ἐστρωμέναι ἀκάνθαις, καὶ ὁ προστάττων ἐν τοῖς Ἀριθμοῖς· Καὶ τῇ ἡμέρᾳ τῶν σαββάτων προσάξετε δύο ἀμνοὺς ἐνιαυσίους ἀμώμους,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s8",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s8",
    "language": "grc",
    "text": "καὶ δύο δέκατα σεμιδάλεως ἀναπεποιημένης ἐν ἐλαίῳ εἰς θυσίαν καὶ σπονδὴν, καὶ ὁλοκαύτωμα σαββάτων ἐν τοῖς σαββάτοις ἐπὶ τῆς ὁλοκαυτώσεως τῆς διὰ παντός.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s9",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s9",
    "language": "grc",
    "text": "Καὶ πάλιν πρὸ ὀλίγων λέγει ἐν τοῖς ἀνωτέρω· Καὶ ἐπιθήσετε ἐπὶ τὸ θῦμα λίβανον καθαρὸν καὶ ἅλας, καὶ ἔσονται εἰς ἄρτους εἰς ἀνάμνησιν, προκείμενα τῷ κυρίῳ.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s10",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s10",
    "language": "grc",
    "text": "Τῇ ἡμέρᾳ τῶν σαββάτων προτεθήσεται ἔναντι κυρίου διαπαντὸς ἐνώπιον τῶν υἱῶν Ἰσραὴλ, διαθήκην αἰώνιον.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s11",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s11",
    "language": "grc",
    "text": "Εἰ γὰρ ἔμελλεν αὐτῷ περὶ ἀργίας, οὐκ ἂν προτιθέναι, καὶ προσάγειν, καὶ σφάζειν, ἐκέλευε τοὺς Λευΐτας.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s12",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s12",
    "language": "grc",
    "text": "Εἰ γὰρ ἡ ἀργία ἁγιάζει, δηλονότι ἡ ἐργασία μολύνει· ἀλλ’ οἱ Λευῖται ἐργαζόμενοι οὐ μολύνονται· οὐκ ἄρα ἡ ἀργία καθαρίζει.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s13",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s13",
    "language": "grc",
    "text": "Ἢ διὰ τί μόνοι οἱ Λευῗται τοῦ ἁγιασμοῦ στερίσκονται, προσάγοντες, καὶ σφάζοντες, καὶ προτιθέντες ἐν τῷ σαββάτῳ;",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.2.s14",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.2.s14",
    "language": "grc",
    "text": "Τοσούτῳ γὰρ ἀπέχονται τοῦ πλημμελεῖν, ὅσῳ καὶ ἱλάσκονται, ὑπὲρ τῶν προσφερόντων.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s1",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s1",
    "language": "grc",
    "text": "Οὐκοῦν οὐκ ἀργίαν σημαίνει τὸ σάββατον, ἀλλὰ γνῶσιν μὲν τοῦ ποιητοῦ, παῦλαν δὲ τοῦ σχήματος τῆς κτίσεως ταύτης, ὡς καὶ ἐν τῷ Ἰεζεχιὴλ διαμαρτύρεται λέγων ὁ θεός·",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s2",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s2",
    "language": "grc",
    "text": "Καὶ τὰ σάββατά μου ἔδωκα αὐτοῖς τοῦ εἶναι εἰς σημεῖον ἀνὰ μέσον ἐμοῦ καὶ ἀνὰ μέσον αὐτῶν τοῦ γνῶναι αὐτοὺς, ὅτι ἐγὼ κύριος ὁ ἁγιάζων αὐτούς.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s3",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s3",
    "language": "grc",
    "text": "Γνώσεως ἄρα καὶ οὐκ ἀργίας ἕνεκεν ἐδόθη τὸ σάββατον· ὡς εἶναι μᾶλλον τὴν γνῶσιν ἀναγκαιοτέραν τῆς ἀργίας.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s4",
