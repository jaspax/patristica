    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.5.s8",
    "language": "grc",
    "text": "Ἡ γὰρ περιτομὴ οὐδὲν ἄλλο ἐδήλου ἢ τὴν τῆς γενέσεως ἀπέκδυσιν·",
    "chunk_index": 61,
    "context_before": null,
