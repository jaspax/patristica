    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s12",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s12",
    "language": "grc",
    "text": "καὶ ταπεινώσετε τὰς ψυχὰς ὑμῶν καὶ προσάξετε ὁλοκαυτώματα τῷ κυρίῳ. Πᾶν ἔργον οὐ ποιήσετε ἐν αὐτῇ τῇ ἡμέρᾳ ταύτῃ·",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
