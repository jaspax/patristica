    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.5.s2",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.5.s2",
    "language": "grc",
    "text": "Διὰ τοῦτο, τὴν ἐν ἓξ ἡμέραις κτίσιν ἀνακαινίσας, ἡμέραν τίθησι τῇ ἀνακαινίσει, ἣν διὰ τοῦ ψαλμοῦ προαναφωνεῖ λέγον τὸ πνεῦμα·",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
