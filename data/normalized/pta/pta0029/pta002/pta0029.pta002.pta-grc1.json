    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.4.s4",
    "language": "grc",
    "text": "Καὶ ὅμως τὴν ἀπαντῶσαν ἡμέραν διὰ τὸν ἐξιλασμὸν σάββατον οὐχ ἀπλῶς, ἀλλὰ σάββατα σαββάτων ὀνομάζει.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
