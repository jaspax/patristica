    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s14",
    "language": "grc",
    "text": "Πᾶν ἔργον οὐ ποιήσετε, νόμιμον αἰώνιον εἰς τὰς γενεὰς ὑμῶν.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
