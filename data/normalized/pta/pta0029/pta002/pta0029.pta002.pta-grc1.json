    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.4.s9",
    "language": "grc",
    "text": "Τέλος μὲν οὖν τῆς προτέρας κτίσεως ἦν τὸ σάββατον, ἀρχὴ δὲ τῆς δευτέρας, ἡ κυριακὴ, ἐν ᾗ τὴν παλαιὰν ἀνενεώσατο καὶ ἀνεκαίνισεν.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
