    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.6.s2",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.6.s2",
    "language": "grc",
    "text": "ὅθεν μέρος τι τοῦ σώματος, καὶ τοῦτο τὸ αἴτιον τῆς τοῦ σώματος γενέσεως προσετάχθησαν ἐκτιννύειν, προδιδασκόμενοι τὴν τοῦ ὅλου ἀπέκδυσιν, ἵν’, ὥσπερ ἀποδιδόντες τὸ κατακριθὲν, διασωθῆναι δυνηθῶσι.",
    "chunk_index": 73,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
