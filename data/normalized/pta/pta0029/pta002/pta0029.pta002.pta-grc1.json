    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.4.s3",
    "language": "grc",
    "text": "Οὐ γὰρ ὡρισμένως, τῷ σαββάτῳ, εἴρηκεν, ἀλλ’ ἁπλῶς τῇ δεκάτῃ, ἣν συμβαίνει ἀπαντᾷν μὴ ἐν σαββάτῳ.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
