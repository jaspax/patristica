    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s7",
    "language": "grc",
    "text": "Εἰ τοίνυν ἕνεκα τοῦ ἀργεῖν ἐδόθη τὸ σάββατον, διὰ τί ἐργάζεσθαι προστάττονται σαλπίζοντες;",
    "chunk_index": 31,
    "context_before": null,
