  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.5.s1",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.5.s1",
    "language": "grc",
    "text": "Ἀτελὲς μὲν γὰρ ἦν τὸ ἔργον, εἰ, ἁμαρτήσαντος τοῦ Ἀδὰμ, ἀπέθνησκεν ὁ ἄνθρωπος· τέλειον δὲ γέγονε, ζωοποιηθέντος αὐτοῦ.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
