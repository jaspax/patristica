    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s8",
    "language": "grc",
    "text": "Ἀλλ’ ἠπίστατο, ὅτι σαλπίζοντες ἐσαββάτιζον, οὐκ ἀργοῦντες, ἀλλὰ γινώσκοντες τὸν βοηθοῦντα αὐτοῖς κύριον·",
    "chunk_index": 32,
    "context_before": null,
