    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.3.s15",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.3.s15",
    "language": "grc",
    "text": "σάββατα σαββάτων ἔσται ὑμῖν, καὶ ταπεινώσετε τὰς ψυχὰς ὑμῶν ἀπὸ ἐνάτης τοῦ μηνὸς, ἀπὸ ἑσπέρας ἕως ἑσπέρας, καὶ σαββατιεῖτε τὰ σάββατα ὑμῶν.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
