    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.5.s6",
    "language": "grc",
    "text": "Οὐ γὰρ πάντων ἡμέρα αὕτη, ἀλλὰ τῶν ἀποθανόντων τῇ ἁμαρτίᾳ, ζώντων δὲ τῷ κυρίῳ.",
    "chunk_index": 59,
    "context_before": null,
