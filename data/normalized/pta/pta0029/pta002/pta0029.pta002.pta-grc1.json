    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.4.s8",
    "language": "grc",
    "text": "Ἤθελε δὲ αὐτοὺς γινώσκοντας τὸ τέλος ταύτης ἀρχὴν ζητεῖν ἑτέρας.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
