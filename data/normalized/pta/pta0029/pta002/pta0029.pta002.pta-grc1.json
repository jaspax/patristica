  },
  {
    "chunk_id": "pta/pta0029/pta002/pta-grc1#pta0029.pta002.5.s9",
    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.5.s9",
    "language": "grc",
    "text": "τὸν γὰρ τῇ ἕκτῃ ἀποθανόντα ἀπεκδιδυσκόμεθα, καὶ ἀνακαινούμεθα τῇ κυριακῇ, ὅτε ὁ παλαιὸς, ἀπεκδυθεὶς, ἀνεγεννήθη τῇ ἀναστάσει.",
    "chunk_index": 62,
    "context_before": null,
