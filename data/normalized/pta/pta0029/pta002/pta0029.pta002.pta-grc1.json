    "work_id": "pta/pta0029/pta002/pta-grc1",
    "canonical_ref": "pta0029.pta002.4.s7",
    "language": "grc",
    "text": "Ἐνετείλατο γὰρ ὁ θεὸς λέγων· Ἵνα γινώσκητε, ὅτι ἐν ταύτῃ τῇ ἡμέρᾳ κατέπαυσε κύριος ὁ θεὸς ὑμῶν ἀπὸ τῶν ἔργων, ὧν ἤρξατο ποιῆσαι.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": 420,
    "date_range": [
      340,
      500
    ],
    "date_confidence": "approximate",
