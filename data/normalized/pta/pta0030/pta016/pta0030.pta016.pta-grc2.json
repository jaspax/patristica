    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s8",
    "language": "grc",
    "text": "οὐαὶ δὲ τῷ πρεσβυτέρῳ τῷ τὰ τοιαῦτα κινοῦντι, ἢ δικάζοντι ἐν ἡμέρᾳ κυριακῆς, καὶ μὴ ἀποδιδόντι τῷ κυρίῳ τὰς εὐχὰς ἐν τῇ τεταγμένῃ ὥρᾳ.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
