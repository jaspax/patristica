    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.6.s2",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.6.s2",
    "language": "grc",
    "text": "φρονίμῳ γὰρ, φησὶν, ἀνδρὶ εἷς λόγος αὐτάρκης, μωρῷ δὲ ἐξηγούμενος οὐ πείσεις τὴν καρδίαν αὐτοῦ ἕως θανάτου.",
    "chunk_index": 76,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.6.s3",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.6.s3",
    "language": "grc",
    "text": "Θέλεις μὴ ἐπελθεῖν σοι κακὸν; τὴν κυριακὴν μὴ ὑβρίσῃς, τῶν πονηρῶν ἔργων ἀπόστηθι, τῇ εὐχῇ σχόλασον,",
    "chunk_index": 77,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.6.s4",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.6.s4",
    "language": "grc",
    "text": "τὸ στόμα σου ἀπὸ αἰσχρολογίας κατάπαυσον, μετὰ ἀνδρῶν εὐλαβῶν συναθροίσθητι, καὶ σὺν αὐτοῖς τῷ Θεῷ εὐχαρίστησον, δοξολογίαν ἀνάπεμψον.",
    "chunk_index": 78,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
