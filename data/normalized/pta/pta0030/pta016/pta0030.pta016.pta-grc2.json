    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s3",
    "language": "grc",
    "text": "Ἄθλιε καὶ ταλαίπωρε, εὔξασθαι προσετάγης τῇ κυριακῇ, οὐχὶ δὲ καὶ δικαστήρια συνιστᾷν;",
    "chunk_index": 44,
    "context_before": null,
