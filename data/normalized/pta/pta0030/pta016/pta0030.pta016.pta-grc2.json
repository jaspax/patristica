      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.4.s12",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s12",
    "language": "grc",
    "text": "Ἀλλὰ καὶ ὁ πονηρὰ ἔργα ἑαυτῷ συνειδὼς, καὶ πρὶν ἢ ταῦτα διὰ τῆς μετανοίας ἀπονίψασθαι, κοινωνῶν, τῆς αὐτῆς ἐστι κατακρίσεως.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
