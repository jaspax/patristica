    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.5.s1",
    "language": "grc",
    "text": "Αὕτη γὰρ ἡ ἡμέρα, ἣν ἐποίησεν ὁ κύριος, ἀγαλλιασώμεθα, καὶ εὐφρανθῶμεν ἐν αὐτῇ.",
    "chunk_index": 58,
    "context_before": null,
