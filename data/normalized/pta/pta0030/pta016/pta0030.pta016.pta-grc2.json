    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s2",
    "language": "grc",
    "text": "Οἶδα πολλοὺς, πρὸς ἀλλήλους πράγματα ἔχοντας, καὶ φιλονεικοῦντας, λέγοντας· ἔρχεται ἡ κυριακὴ, καὶ τὴν δίκην λέγομεν.",
    "chunk_index": 43,
    "context_before": null,
