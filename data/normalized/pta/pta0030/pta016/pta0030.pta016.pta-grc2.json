    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s6",
    "language": "grc",
    "text": "καὶ προβάλλουσι πρὸς ἀλλήλους πράγματα, διαπληκτισμοὺς, ὕβρεις, λοιδορίας, καὶ ὅσα τοιαῦτα, καὶ τὰ τούτων χείρονα.",
    "chunk_index": 47,
    "context_before": null,
