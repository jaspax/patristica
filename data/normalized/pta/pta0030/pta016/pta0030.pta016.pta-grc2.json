[
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s1",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s1",
    "language": "grc",
    "text": "Μετὰ τὴν ἀπόλυσιν τῆς ἐκκλησίας, ἐν ἡμέρᾳ τῆς ἁγίας κυριακῆς, καθεζομένου τοῦ μακαρίου Εὐσεβίου τοῦ ἐπισκόπου προσελθὼν ὁ Ἀλέξανδρος λέγει αὐτῷ·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s2",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s2",
    "language": "grc",
    "text": "δέομαί σου, κύριέ μου, τίνος ἕνεκεν ἡμῖν ἐστιν ἀναγκαῖον φυλάττειν τὴν κυριακὴν, καὶ μὴ ἐργάζεσθαι, καὶ ποῖον κέρδος ἔχομεν μὴ ἐργαζόμενοι;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s3",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s3",
    "language": "grc",
    "text": "Ὁ δὲ μακάριος ἤρξατο λέγειν· ἄκουσον, τέκνον, καὶ ἐρῶ σοι, τίνος χάριν παραδέδοται τὸ φυλάσσειν ἡμᾶς τὴν κυριακὴν καὶ μὴ ἐργάζεσθαι.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s4",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s4",
    "language": "grc",
    "text": "Ὅτε παρέδωκεν ὁ κύριος τὸ μυστήριον τοῖς μαθηταῖς, λαβὼν τὸν ἄρτον, εὐλόγησεν, καὶ κλάσας ἔδωκε τοῖς μαθηταῖς αὐτοῦ, λέγων, λάβετε,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s5",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s5",
    "language": "grc",
    "text": "φάγετε, τοῦτο μοῦ ἐστι τὸ σῶμα, τὸ ὑπὲρ ὑμῶν κλώμενον, εἰς ἄφεσιν ἁμαρτιῶν. Ὁμοίως καὶ τὸ ποτήριον δέδωκεν αὐτοῖς λέγων·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s6",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s6",
    "language": "grc",
    "text": "πίετε ἐξ αὐτοῦ πάντες, τοῦτο ἐστὶ τὸ αἷμα μοῦ, τὸ τῆς καινῆς διαθήκης, τὸ ὑπὲρ ὑμῶν, καὶ πολλῶν, ἐκχυνόμενον, εἰς ἄφεσιν ἁμαρτιῶν, τοῦτο ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησίν, φησι.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s7",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s7",
    "language": "grc",
    "text": "Ἀνάμνησις τοίνυν τοῦ κυρίου ἐστὶν ἡ τῆς κυριακῆς ἁγία ἡμέρα. Διὰ γὰρ τοῦτο καὶ κυριακὴ ἐκλήθη, ὡς κυρία τῶν ἡμερῶν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s8",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s8",
    "language": "grc",
    "text": "Πρὸ γὰρ τοῦ δεσποτικοῦ πάθους οὐκ ἐλέγετο κυριακὴ, ἀλλὰ πρώτη ἡμέρα. Ἐν ταύτῃ τῇ ἡμέρᾳ τὴν ἀπαρχὴν τῆς ἀναστάσεως, ἤγων τῆς κοσμοποιΐας, ἤρξατο ὁ κύριος.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s9",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s9",
    "language": "grc",
    "text": "καὶ ἐν αὐτῇ τῇ ἡμέρᾳ τὴν ἀπαρχὴν τῆς ἀναστάσεως ἐδωρήσατο τῷ κόσμῳ, ἐν ταύτῃ τῇ ἡμέρᾳ, ὡς ἔφημεν, καὶ τῶν ἁγίων μυστηρίων, ἐκέλευσεν ἐπιτελεῖσθαι.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s10",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s10",
    "language": "grc",
    "text": "ἀρχὴ οὖν πάσης ἀγαθοσύνης γέγονεν ὑμῖν ἡ τοιαύτη ἡμέρα, ἀρχὴ κτίσεως κόσμου, ἀρχὴ ἀναστάσεως, ἀρχὴ ἑβδομάδος.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.1.s11",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.1.s11",
    "language": "grc",
    "text": "τρεῖς ἀρχὰς ἔχουσα ἡ ἡμέρα αὕτη, τριάδος τῆς ὑπεραγίας τὴν ἀρχὴν ὑποφαίνει.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s1",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s1",
    "language": "grc",
    "text": "Ἑπτὰ τοίνυν ἡμέρας ἡ ἑβδομὰς ἔχουσα, τὰς ἓξ δέδωκεν ἡμῖν ὁ Θεὸς, ἐργάζεσθαι, καὶ τὴν μίαν δέδωκεν ἡμῖν, εἰς εὐχὴν καὶ ἀνάπαυσιν,",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s2",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s2",
    "language": "grc",
    "text": "καὶ λύσιν κακῶν, καὶ ἵνα, εἴτε ἐν ταῖς ἓξ ἡμέραις ἁμαρτήματα πεποιήκαμεν, ὑπὲρ τούτων ἐν τῇ τῆς κυριακῆς ἡμέρα τῷ Θεῷ ἐξιλασκώμεθα.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s3",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s3",
    "language": "grc",
    "text": "Ὄρθρισον οὖν ἐν τῇ τοῦ Θεοῦ ἐκκλησίᾳ, πρόσελθε τῷ δεσπότῃ, ἐξομολόγησαι αὐτῷ τὰ ἁμαρτήματά σου, μετανόησον ἐν εὐχῇ καὶ καρδίᾳ συντετριμμένῃ,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s4",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s4",
    "language": "grc",
    "text": "παράμεινον ἐν τῇ θείᾳ καὶ ἱερᾷ λειτουργίᾳ, πλήρωσόν σου τὴν εὐχὴν, μηδαμῶς πρὸ τῆς ἀπολύσεως ἐξερχόμενος.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s5",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s5",
    "language": "grc",
    "text": "Ἴδε σοῦ τὸν δεσπότην μελιζόμενον, καὶ διαδιδόμενον, καὶ μὴ δαπανώμενον. καὶ εἰ μὲν ἔχεις καθαρόν σου τὸ συνειδὸς, πρόσελθε, καὶ κοινώνησον τοῦ σώματος, καὶ αἵματος τοῦ κυρίου.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s6",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s6",
    "language": "grc",
    "text": "εἰ δὲ κατακρίνει σὲ τὸ συνειδὸς ἐν πονηροῖς καὶ ἀτόποις ἔργοις, τὴν μὲν κοινωνίαν παραίτησαι,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s7",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s7",
    "language": "grc",
    "text": "μέχρις ἂν διορθώσῃ ἑαυτὴν διὰ μετανοίας, τὴν δὲ εὐχὴν παράμεινον, καὶ μὴ ἐξέλθῃς τῆς ἐκκλησίας, ἐὰν μὴ ἀπολυθῇς.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s8",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s8",
    "language": "grc",
    "text": "Μνήσθητι Ἰούδα, τοῦ προδότου. ἐκείνου γὰρ ἀρχὴ τῆς ἀπωλείας, τὸ μὴ παραμεῖναι μετὰ πάντων ἐν τῇ εὐχῇ, γέγονε.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s9",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s9",
    "language": "grc",
    "text": "λαβὼν δὲ, φησὶν, τὸν ἄρτον, πρῶτος πάντων ἐξῆλθεν, καὶ εὐθέως εἰσῆλθεν εἰς αὐτὸν ὁ Σατανᾶς, καὶ ἐσπούδασεν εἰς τὸ προδοῦναι τὸν κύριον.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s10",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s10",
    "language": "grc",
    "text": "Ἐὰν οὖν πρὸ τῆς ἀπολύσεως ἐξέλθῃς, μιμητὴς γέγονας τοῦ Ἰούδα. Μὴ τοίνυν διὰ βραχεῖαν ὥραν μέλλεις μετὰ τοῦ Ἰούδα κατακρίνεσθαι; οὐδὲν σὲ βλάπτει ἡ παραμονή.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.2.s11",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.2.s11",
    "language": "grc",
    "text": "οὐ χιόνας ἔχει ἡ ἐκκλησία ἔνδον, οὐ πῦρ, οὐχ ἕτερον κολαστήριον οὐδὲν, ἀλλ’ ἡ μόνον ὑπομονῆς ἐστι χρεία ῥοπῆς μιᾶς, καὶ ἀπήρτισταί σου ἡ εὐχή.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s1",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s1",
    "language": "grc",
    "text": "Δι’ οὐδὲν δ’ ἕτερον φυλάττομεν τὴν ἡμέραν τῆς κυριακῆς, ἀλλ’ ἵνα τοῦ ἔργου ἀπεχόμεθα, καὶ τῇ εὐχῇ σχολάσωμεν·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s2",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s2",
    "language": "grc",
    "text": "εἰ δὲ τοῦ ἔργου ἀπέχεις, εἰς τὴν ἐκκλησίαν δὲ οὐκ εἰσέρχῃ, οὐδὲν ἐκέρδανας.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s3",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s3",
    "language": "grc",
    "text": "τοὐναντίον μὲν οὖν οὐ μικρῶς ἑαυτὸν κατέβλαψας. Πολλοὶ δὲ ἐκδέχονται τὴν κυριακὴν, ἀλλ’ οὐκ ἑνὶ σκοπῷ πάντες.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s4",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s4",
    "language": "grc",
    "text": "Οἱ δὲ φοβούμενοι τὸν Θεὸν ἐκδέχονται τὴν κυριακὴν, ἵνα τὴν εὐχὴν τῷ Θεῷ ἀναπέμψωσι, καὶ τοῦ τιμίου σώματος καὶ αἵματος ἀπολαύσωσιν·",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s5",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s5",
    "language": "grc",
    "text": "οἱ δὲ ῥᾴθυμοι καὶ ἀμελεῖς ἐκδέχονται τὴν κυριακὴν, ἵνα τοῦ ἔργου ἀπεχόμενοι τοῖς κακοῖς σχολάσωσι.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s6",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s6",
    "language": "grc",
    "text": "καὶ ὅτι οὐ ψεύδομαι, μαρτυρεῖ τὰ πράγματα. ἔξελθε ἐν τῇ μέσῃ ἐν ἄλλῃ ἡμέρᾳ, καὶ οὐδὲν εὑρήσεις.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
