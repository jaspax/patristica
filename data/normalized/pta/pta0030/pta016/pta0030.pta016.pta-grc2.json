  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.4.s10",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s10",
    "language": "grc",
    "text": "ἐὰν δὲ καὶ γευσάμενος κοινωνήσῃ τοῖς μυστηρίοις, μετὰ τοῦ προδότου Ἰούδα ἡ μερὶς αὐτοῦ ἐστιν.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.4.s11",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s11",
    "language": "grc",
    "text": "Πολλοὺς οἶδα ἐν τῇ τοῦ ἁγίου πάσχα ἡμέρᾳ γευσαμένους καὶ κοινωνήσαντας, καὶ οὐαὶ τῇ ψυχῇ αὐτῶν, καὶ μάλιστα, εἰ ἐν ἡλικία τελείᾳ ὦσι, ὅτι ἀντὶ τοῦ λύειν τὰ ἁμαρτήματα, μᾶλλον ἐπιφορτίζουσι ταῦτα.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
