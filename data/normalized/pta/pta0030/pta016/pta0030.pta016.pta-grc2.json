    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.4.s9",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s9",
    "language": "grc",
    "text": "ἐὰν δὲ καὶ πρὸ τῆς ἀπολύσεως γεύσηταί τις τῶν λαϊκῶν, μεγάλης κρίσεως καὶ τιμωρίας ἔνοχός ἐστιν.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
