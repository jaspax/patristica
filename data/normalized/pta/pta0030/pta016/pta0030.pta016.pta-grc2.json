    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.4.s13",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s13",
    "language": "grc",
    "text": "ὅσῳ γὰρ μείζων ἐστὶν ἡ ἡμέρα, μείζων ἐστὶ καὶ ἡ ἁμαρτία. Ὅσοι δὲ καὶ ἀνέγκλητοι ὑπάρχουσιν, ὀφείλουσι καρτερεῖν μέχρι τῆς ἀπολύσεως, καὶ οὕτω κοινωνεῖν.",
    "chunk_index": 54,
    "context_before": null,
