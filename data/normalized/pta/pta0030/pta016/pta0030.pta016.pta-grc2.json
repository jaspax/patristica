    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.4.s7",
    "language": "grc",
    "text": "εἶτα πάλιν εἰσέρχονται εἰς τὴν ἐκκλησίαν, καὶ ἀλλήλους ὑποβλέπονται, ὥσπερ θηρία τρίζοντες τοὺς ὀδόντας αὐτῶν.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
