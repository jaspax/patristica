    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s9",
    "language": "grc",
    "text": "Καλεῖ εἰς τὴν ἐκκλησίαν ὁ κήρυξ, καὶ πάντες ὄκνον προβάλλονται, καὶ ἀδυναμίαν.",
    "chunk_index": 30,
