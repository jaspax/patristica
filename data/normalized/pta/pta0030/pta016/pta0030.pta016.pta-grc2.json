    "canonical_ref": "pta0030.pta016.6.s6",
    "language": "grc",
    "text": "αὐτὴ οὖν ἡ ἡμέρα, ἣν ἐποίησεν ὁ κύριος, ἀγαλλιασώμεθα καὶ εὐφρανθῶμεν ἐν αὐτῇ,",
    "chunk_index": 80,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
