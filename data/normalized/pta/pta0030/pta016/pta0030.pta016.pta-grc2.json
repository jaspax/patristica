  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.3.s20",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.3.s20",
    "language": "grc",
    "text": "Οἱ οὖν τῆς ἐκείνης ἀγαπῶντες κακότεχνον ὄρχησιν, μετ’ αὐτῆς ἔχουσι τὴν μερίδα, καὶ τὴν κατάκρισιν.",
    "chunk_index": 41,
