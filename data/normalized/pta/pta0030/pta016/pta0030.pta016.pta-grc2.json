    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.6.s5",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.6.s5",
    "language": "grc",
    "text": "αὐτὴ γὰρ ἡ ἡμέρα, πολλαχῶς εἴρηται, εἰς τὴν εὐχὴν καὶ ἀνάπαυσιν ἐδόθη σοι.",
    "chunk_index": 79,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
