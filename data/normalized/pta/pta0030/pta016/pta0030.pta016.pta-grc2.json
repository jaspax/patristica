  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc2#pta0030.pta016.5.s2",
    "work_id": "pta/pta0030/pta016/pta-grc2",
    "canonical_ref": "pta0030.pta016.5.s2",
    "language": "grc",
    "text": "εὐφρανθῶμεν δὲ οὐ κραιπάλῃ καὶ μέθῃ σκοτούμενοι, ἀλλ’ ἐν τῇ μελέτῃ τῶν θείων γραφῶν ἐντρυφῶντες.",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
