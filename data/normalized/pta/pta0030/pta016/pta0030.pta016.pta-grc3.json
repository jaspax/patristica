    "work_id": "pta/pta0030/pta016/pta-grc3",
    "canonical_ref": "pta0030.pta016.1.s7",
    "language": "grc",
    "text": "Ἀνάμνησις οὖν τοῦ κυρίου ἐστὶν ἡ ἡμέρα τοιαύτη, διὸ καὶ κυριακὴ ἐκλήθη. Πρὸ γὰρ τοῦ δεσποτικοῦ πάθους, οὐκ ἐλέγετο κυριακὴ ἀλλὰ πρώτη ἡμέρα·",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
