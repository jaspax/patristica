    "work_id": "pta/pta0030/pta016/pta-grc3",
    "canonical_ref": "pta0030.pta016.1.s4",
    "language": "grc",
    "text": "τὸ φυλάττειν ἡμᾶς τὴν ἁγίαν κυριακὴν καὶ μὴ ἐργάζεσθαι τοῦτο ἐστιν· ὅτε παραδίδου ὁ Ἰησοῦς τοῖς μαθηταῖς αὐτοῦ τὸ μυστήριον, λαβὼν τὸν ἄρτον εὐλόγησεν, καὶ κλάσας ἔδωκεν αὐτοῖς λέγων·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
