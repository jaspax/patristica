    "work_id": "pta/pta0030/pta016/pta-grc3",
    "canonical_ref": "pta0030.pta016.1.s6",
    "language": "grc",
    "text": "τοῦτό μού ἐστιν τὸ αἷμα τὸ ὑπὲρ πολλῶν ἐκχυνόμενον εἰς ἄφεσιν ἁμαρτιῶν, τοῦτο ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησιν.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
