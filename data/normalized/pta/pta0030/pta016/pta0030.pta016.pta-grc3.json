    "work_id": "pta/pta0030/pta016/pta-grc3",
    "canonical_ref": "pta0030.pta016.1.s5",
    "language": "grc",
    "text": "τοῦτό μού ἐστιν τὸ σῶμα τὸ ὑπὲρ ὑμῶν κλώμενον εἰς ἄφεσιν ἁμαρτιῶν, ὁμοίως δὲ καὶ τὸ ποτήριον κεράσας, εἶπεν·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
