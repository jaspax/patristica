  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.10.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.10.s1",
    "language": "grc",
    "text": "Εἶπεν γὰρ ὁ θεὸς διὰ τοῦ προφήτου ὅτι τῶν διανευόντων οἱ ὀφθαλμοὶ ὑπὸ ἀνελεημόνων ἀγγέλων ἐξορύσσονται.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
