    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.12.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.12.s1",
    "language": "grc",
    "text": "Ἀνισταμένου σου τὸ πρωῒ τὸν τύπον τοῦ τιμίου σταυροῦ ποίει εἰς πάντα τὰ μέλη σου. Καὶ περιπατῶν καὶ κοιμώμενος καὶ πάντοτε λέγε· Κύριε Ἰησοῦ Χριστὲ βοήθησον ἡμῖν.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
