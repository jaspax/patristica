  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.10.s3",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.10.s3",
    "language": "grc",
    "text": "εἰς τὸν δυνὸν ᾍδην, εἰς τὸν σκώληκα τὸν ἀκοίμητον, εἰς τὸν πικρὸν κλαυθμόν, εἰς τὸν βρυγμὸν τῶν ὀδόντων.",
    "chunk_index": 46,
    "context_before": null,
