    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.11.s2",
    "language": "grc",
    "text": "Ὥσπερ ἐποίησεν ὁ θεὸς τὸν ἄνθρωπον κατὰ φύσιν τὸ ἀναπνέειν, οὕτως ἐποίησεν ἁρμόζειν καὶ τὰς γυναῖκας ἵνα πάντοτε νηστεύωσι.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
