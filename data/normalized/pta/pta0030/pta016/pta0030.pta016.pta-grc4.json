    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.12.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.12.s2",
    "language": "grc",
    "text": "Ἑσπέρας καὶ πρωῒ εἰς τὴν ἐκκλησίαν ἀπέρχου καὶ ἐξομολογοῦ τῷ θεῷ τὰς ἁμαρτίας σου ἅσπερ ἔπραξας καὶ βλέπε, ἄνθρωπε, μὴ ὀμόσῃς μήτε ἐν τῷ οὐρανῷ μήτε ἐν τῇ γῇ,",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
