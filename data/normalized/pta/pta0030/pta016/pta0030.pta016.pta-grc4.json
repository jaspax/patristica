[
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.1.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.1.s1",
    "language": "grc",
    "text": "Μετὰ τὴν ἀπόλυσιν τῆς ἁγίας κυριακῆς, προκαθίσαντος τοῦ μακαρίου Εὐσεβίου, προσελθὼν Ἀλέξανδρος ὁ βασιλεὺς, λέγει αὐτῷ·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.1.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.1.s2",
    "language": "grc",
    "text": "Δέομαί σου, ἀγαπητὲ τοῦ θεοῦ Εὐσέβειε, διὰ τί φυλάττωμεν τὴν ἡμέραν τῆς ἁγίας κυριακῆς, καὶ οὐ ἐργαζώμεθα αὐτὴν ὡς ἐργαζόμεθα τὰς ἓξ ἡμέρας;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s1",
    "language": "grc",
    "text": "Ὁ δὲ μακάριος Εὐσέβιος λέγει αὐτῷ· ἄκουσον, τέκνον Ἀλέξανδρε, καὶ ἐρῶ σοι περὶ πάντων τῶν γινομένων τὴν ἁγίαν κυριακὴν ἀγαθά·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s2",
    "language": "grc",
    "text": "Ἐν ταύτῃ τῇ ἡμέρᾳ τοῖς ἑαυτοῦ μαθηταῖς ὁ κύριος ἐπαρέδωκεν τὸ μυστήριον, καὶ λαβὼν τὸν ἄρτον εὐλόγησεν, καὶ κλάσας δέδωκεν τοῖς ἑαυτοῦ μαθηταῖς καὶ ἀποστόλοις, εἰπών·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s3",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s3",
    "language": "grc",
    "text": "Λάβετε, φάγετε, τοῦτο ἐστὶν τὸ σῶμά μου, ὁμοίως καὶ τὸ ποτήριον συνκεράσας εὐλόγησεν καὶ εἶπεν· Πίετε ἐξ αὐτοῦ πάντες καὶ ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησιν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s4",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s4",
    "language": "grc",
    "text": "Ἀνάμνησις γάρ ἐστιν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ καὶ τῶν ἁγίων αὐτοῦ μυστηρίων, καὶ διὰ τοῦτο οὐκ ἐργαζόμεθα τὴν ἡμέραν τῆς ἁγίας κυριακῆς·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s5",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s5",
    "language": "grc",
    "text": "ἀρχὴ γὰρ ἀγαθωσύνης γέγονεν ἡ ἡμέρα αὕτη· ἀρχὴ κτίσεως κόσμου, ἀρχὴ ἀναστάσεως, ἀρχὴ ἑβδομάδος.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s6",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s6",
    "language": "grc",
    "text": "τρεῖς ἀρχὰς ἀγαθὰς ἔχει ἡ ἡμέρα τῆς ἁγίας κυριακῆς, καὶ τριάδος ἀναμνήσκει ἡμῶν, προσκυνεῖν τριάδα τὴν ὁμοούσιον καὶ θεότητα.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s7",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s7",
    "language": "grc",
    "text": "Ἓξ ἡμέρας ἔχει ἡ ἑβδομάς· τὰς ἓξ ἡμέρας ἡμῖν ὁ θεὸς εἰς τὸ ἐργάζεσθαι, τὴν δὲ κυριακὴν ἔδωκεν ἡμῖν ὁ θεὸς εἰς εὐχὴν καὶ ἀνάπαυσιν καὶ λύσιν πάντων κακῶν,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.2.s8",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.2.s8",
    "language": "grc",
    "text": "ἵνα ἤτοι ἁμαρτίας ἁμαρτήσωμεν, ἐν τῇ ἡμέρᾳ τῆς ἁγίας κυριακῆς καθαρισθῶμεν ἀπὸ τῆς ἁμαρτίας.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.3.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.3.s1",
    "language": "grc",
    "text": "Ἐρχομένης γὰρ τῆς ἁγίας κυριακῆς, ὄρθρισον, παράμεινον ἕως ἂν πληρωθῇ ὁ ὄρθρος, εἶτα πληρωθέντος τοῦ ὄρθρου, μὴ προσεγγίσῃς ἐν δικαστηρίῳ,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.3.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.3.s2",
    "language": "grc",
    "text": "λόγον ἀργὸν μὴ εἴποις, καὶ (μὴ) μολύνῃς τὴν ψυχήν σου, καὶ τοὺς ἀκούοντας βλάπτῃς, καὶ μὴ καταλαλήσῃς κατά τινος, καὶ μὴ ὀργίσθῃς κατὰ μικροῦ ἢ κατὰ μεγάλου.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.3.s3",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.3.s3",
    "language": "grc",
    "text": "Οἱ (ἐπὶ) τῇ κακίᾳ μένουσιν καὶ οὐκ ἐκατηλλάγησαν εἰς πῦρ ἄσβεστον ἀπελεύσονται.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.3.s4",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.3.s4",
    "language": "grc",
    "text": "Ἔδωκεν ἡμῖν ὁ θεὸς ἕξ ἡμέρας εἰς τὸ ἐργάζεσθαι, ἵνα ἐν αὐταῖς πωλεῖν, ἀγοράζειν, καὶ συνευφραίνεσθαι μετὰ τῆς γυναικός σου τῆς ἐκ νεότητός σου.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.3.s5",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.3.s5",
    "language": "grc",
    "text": "Χάρισαι καὶ σὺ τῷ θεῷ σου μίαν ἡμέραν πρὸς σωτηρίαν τῆς ψυχῆς σου, λέγω δὴ τὴν ἁγίαν κυριακὴν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.4.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.4.s1",
    "language": "grc",
    "text": "Kαὶ μὴ ἐξέλθῃς ἐκ τῆς ἐκκλησίας σου ἐὰν μὴ ἀπόλυσις γένηται· μνήσθητι γὰρ τοῦ προδότου Ἰούδα, καὶ μὴ ἐξέλθῃς, ἐκείνου γὰρ ἡ ἀρχὴ τῆς ἀπωλείας ἐγένετο τοῦ μὴ παραμεῖναι μετὰ πάντων.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.4.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.4.s2",
    "language": "grc",
    "text": "Λαβὼν γὰρ τὸν ἄρτον ὁ Ἰούδας ἐν τῷ στόματι αὐτοῦ ἐξῆλθεν ἔξω, καὶ ἐχόρευσεν ὁ Σατανᾶς, καὶ ἐσπούδασεν εἰς τὴν προδοσίαν τοῦ σωτῆρος.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.4.s3",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.4.s3",
    "language": "grc",
    "text": "Ἐὰν οὖν πρὸ τῆς ἀπολύσεως τῆς ἁγίας ἐκκλησίας ἐξέλθῃς, παρεκτὸς ἀνάγκης, μετὰ Ἰούδαν ἐλογίσθης.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.4.s4",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.4.s4",
    "language": "grc",
    "text": "Καὶ βλέπε, ἀδελφέ· μὴ δι’ ὀλίγην ὥραν μέλλῃς ἀπολέσαι τὴν ψυχήν σου, καὶ αἰωνίως κολάζεσθαι, οὐ μάχαιρα, οὐ κίνδυνος,",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.4.s5",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.4.s5",
    "language": "grc",
    "text": "οὐδὲ ἕτερον κολαστήριον ἐστὶν τὸ δοκοῦντα ἡμᾶς ἐκ τῆς ἁγίας ἐκκλησίας, ἀλλὰ στῆθι οὖν μετὰ φόβου, καὶ ἀκροᾶσαι,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.4.s6",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.4.s6",
    "language": "grc",
    "text": "αἵπερ λέγουσιν οἱ ἱερεῖς καὶ οἱ λευῖται ἐκ τῶν θείων γραφῶν, καὶ γράψαι αὐτὰ εἰς τὰ βάθη τῆς καρδίας σου, ἵνα παραλάβῃς αὐτὰ εἰς νουθέτησιν τοῦ θεοῦ σου.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.5.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.5.s1",
    "language": "grc",
    "text": "Καὶ μὴ κλαπῇς ποτὲ ἐν τῇ ἐκκλησίᾳ καὶ συνζεύξῃς μετά τινα, ἐπεὶ μισθὸν οὐκ ἔχεις, ἀλλὰ στήθι οὖν μετὰ φόβου, καὶ ἴδε τὸν δεσπότην Χριστὸν διαμελιζόμενον,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.5.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.5.s2",
    "language": "grc",
    "text": "καὶ μὴ διαιρούμενον, καὶ μεταδιδόμενον εἰς σωτηρίαν πάντων, καὶ εἰ μὲν ἔχεις καθαρὸν τὸ ἀγγεῖον τῆς ψυχῆς σου, πρόσελθε καὶ κοινώνησον, εἰ δὲ καὶ κατανοεῖ ὁ λογισμός σου,",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.5.s3",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.5.s3",
    "language": "grc",
    "text": "ὅτι ἔχεις κακίαν μετά τινος, ἄφες τὰ δῶρα ἐν τῇ ἁγίᾳ τραπέζῃ, καὶ ἄπελθε καὶ διαλλάγηθι τῷ ἀδελφῷ σου, καὶ τότε στρέφου καὶ κοινώνησον.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.6.s1",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.6.s1",
    "language": "grc",
    "text": "Εἰ δὲ πάλιν κατανοεῖς ὅτι συνεγίνου μετὰ γυναικὸς τῇ νυκτὶ ἐκείνῃ, μὴ προσέλθῃς τοῦ καταλαβεῖν.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.6.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.6.s2",
    "language": "grc",
    "text": "Καιρὸς γάρ ἐστιν τὸ πάντοτε. Ὁ γὰρ ἐσθίων καὶ πίνων τὸ σῶμα καὶ τὸ αἷμα τοὺ κυρίου, κρίμα αὐτῷ ἐσθίει καὶ πίνει.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.6.s3",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.6.s3",
    "language": "grc",
    "text": "Ἄνθρωπος δὲ Χριστιανὸς μένων ἀκοινώνητος χωρὶς ἀνάγκης παρεσυνεβλήθη τοῖς κτήνεσιν τοῖς ἀνοήτοις καὶ ὡμοιώθη αὐτοῖς.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.6.s4",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.6.s4",
    "language": "grc",
    "text": "Τὸ αὐτὸ καὶ ἡ γυνὴ χωρὶς ἁμαρτίας καὶ σωματικῆς ἀσθενείας ἐὰν χωρίσῃ αὐτὴν ἐκ τῆς ἁγίας ἐκκλησίας χωρὶς ἀνάγκης,",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
