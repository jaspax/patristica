  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.9.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.9.s2",
    "language": "grc",
    "text": "Καὶ τὰ ἄλλα ὁμοίως φύλαττε, πρῶτον μὲν μὴ λαλήσῃς, ἄλλ’ ὅτε ἀκούσῃς τινὸς καταλαλοῦντος,",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
