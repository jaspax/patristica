  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc4#pta0030.pta016.10.s2",
    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.10.s2",
    "language": "grc",
    "text": "Τότε οἱ γελῶντες πικρῶς κλαύσουσιν, τότε οἱ φλυαροῦντες ἐλεεινὰ στενάξουσιν, καταδικαζόμενοι εἰς τὸν πύρινον ποταμόν,",
    "chunk_index": 45,
    "context_before": null,
