    "work_id": "pta/pta0030/pta016/pta-grc4",
    "canonical_ref": "pta0030.pta016.11.s1",
    "language": "grc",
    "text": "Τετράδην καὶ παρασκευὴν νήστευε, τὰς δὲ ἄλλας ἡμέρας ἐξουσίαν ἔχεις, κἂν θέλῃς νήστευε, κἂν θέλῃς μὴ νήστευε.",
    "chunk_index": 47,
    "context_before": null,
