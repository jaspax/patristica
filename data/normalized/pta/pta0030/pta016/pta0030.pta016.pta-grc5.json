    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.2.s5",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s5",
    "language": "grc",
    "text": "τοῦτο γὰρ ποιῶν, μεγάλην ἀνάπαυσιν παρέχεις τοῖς προαπελθοῦσιν· πλήρωσον οὖν τὴν εὐχήν· ἴδε τὸν δεσπότην μελιζόμενον καὶ μὴ μιούμενον·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
