    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.2.s10",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s10",
    "language": "grc",
    "text": "εὐθέως ἐξῆλθεν· καὶ ἐχώρησεν εἰς αὐτὸν ὁ Σατανᾶς· καὶ ἐσπούδασεν εἰς τὴν προδοσίαν· οὕτως καὶ νῦν·",
    "chunk_index": 20,
    "context_before": null,
