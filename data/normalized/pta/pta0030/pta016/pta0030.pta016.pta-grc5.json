    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s8",
    "language": "grc",
    "text": "τῇ δὲ εὐχῇ παράμεινον· καὶ μὴ ἐξέλθῃς ἕως οὗ ἀπολυθῇς· μνήσθητι Ἰούδα τοῦ προδότου· καὶ μὴ ἐξέλθῃς τῆς ἐκκλησίας·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
