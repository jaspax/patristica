  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s3",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s3",
    "language": "grc",
    "text": "ὁ δὲ μακάριος Εὐσέβιος λέγει· ἄκουσον τέκνον καὶ ἐρῶ σοι περὶ πάντων τῶν γινομένων ἐν τῇ ἁγίᾳ κυριακῇ·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s4",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s4",
    "language": "grc",
    "text": "εἴτε ἀγαθῶν εἴτε πονηρῶν· καὶ τὸ φυλάττειν ἡμᾶς τὴν ἁγίαν κυριακὴν καὶ μὴ ἐργάζεσθαι, ὅτε παρεδίδου ὁ κύριος·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s5",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s5",
    "language": "grc",
    "text": "τὸν τύπον τοῦ μυστηρίου· λαβὼν τὸν ἄρτον ηὐλόγησεν· καὶ κλάσας ἔδωκε τοῖς μαθηταῖς αὐτοῦ λέγων· λάβετε φάγετε ἐξ αὐτοῦ πάντες·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s6",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s6",
    "language": "grc",
    "text": "τοῦτό ἐστι τὸ σῶμα μου τὸ ὑπὲρ ἡμῶν καὶ πολλῶν κλώμενον εἰς ἄφεσιν ἁμαρτιῶν· ὁμοίως καὶ τὸ ποτήριον συνκεράσας καὶ εὐλογήσας, ἔδωκε λέγων·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s7",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s7",
    "language": "grc",
    "text": "τοῦτο μου ἐστὶ τὸ αἷμα τὸ ὑπὲρ ἡμῶν καὶ πολλῶν ἐκχυνόμενον εἰς ἄφεσιν ἁμαρτιῶν· τοῦτο ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησίν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s8",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s8",
    "language": "grc",
    "text": "Ἀνάμνησις οὖν ἐστιν τοῦ κυρίου ἡ ἡμέρα αὕτη. διατοῦτο καὶ κυριακὴ ἐκλήθη· πρὸ γὰρ τοῦ δεσποτικοῦ πάθους, οὐκ ἐλέγετο κυριακῆ·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s9",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s9",
    "language": "grc",
    "text": "ἀλλὰ πρώτη ἡμέρα· ἀρχὴς τῆς ἑβδομάδος, εἷς ἐδωρήσατο τῷ κόσμῳ· καὶ ἐν τῇ τῶν μυστηρίων ἀναμνήση ἐκέλευσεν ἐπιτελεῖσθαι·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.1.s10",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s10",
    "language": "grc",
    "text": "πρὸς τιμὴν τῆς τῶν μυστηρίων ἱερουργίας· καὶ τῆς ἀναστάσεως τὴν ἀρχὴν ἐκελεύσθημεν μὴ ἐργάζεσθαι, ἀρχὴ οὖν πάσης ἀγαθωσύνης γέγονεν ἡ ἡμέρα αὕτη·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
