    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s4",
    "language": "grc",
    "text": "παράμεινον τῇ προσφερομένῃ θυσίᾳ· μνήσθητι ἐν τῇ προσκομιδῇ καὶ τῶν προαπελθόντων αἰώνων καὶ ἀδελφῶν καὶ φίλων καὶ συγγενῶν·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
