    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.3.s3",
    "language": "grc",
    "text": "ἀλλ’ οὐκ ἑνὶ σκοπῶσι πάντες· οἱ μὲν γὰρ ἐκδέχονται φοβούμενοι τὸν θεὸν, ἵνα εὐχὴν ἀναπέμψωσι τῷ Θεῷ·",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
