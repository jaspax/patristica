    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s7",
    "language": "grc",
    "text": "εἰ δὲ καταγινώσκεις σου τὸ συνειδὸς· τὴν μὲν κοινωνίαν παραίτησαι, μέχρις οὗ διορθώσης σεαυτὸν διὰ μετανοίας·",
    "chunk_index": 17,
    "context_before": null,
