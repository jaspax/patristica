    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.2.s3",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s3",
    "language": "grc",
    "text": "καὶ προσελθῶν τῷ δεσπότῃ χριστῷ ἐξομολόγησαι ἐν δάκρυσιν· καὶ ἀνάγγειλον αὐτῷ τὰ ἁμαρτήματά σου· μετανόησον ἐν εὐχὴ·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
