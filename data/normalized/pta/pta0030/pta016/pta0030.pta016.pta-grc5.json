    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.1.s11",
    "language": "grc",
    "text": "ἀρχὴ κτίσεως κόσμου· ἀρχὴ ἀναστάσεως· ἀρχὴ εὐδομάδος· τρεῖς ἀρχὰς ἔχουσα ἡ ἡμέρα αὕτη· τριάδος ἀγαθῆς μηνύει τὴν ἀρχὴν·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.2.s1",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s1",
    "language": "grc",
    "text": "Ἑπτὰ ἡμέρας ἔχει ἡ ἑβδομάς· τὰς ἓξ ἡμέρας ἔδωκεν ἡμῖν αὐτὰς ὁ Θεὸς εἰς τὸ ἐργάζεσθαι· καὶ τὴν μίαν ἔδωκεν ἡμῖν εἰς ἀνάπαυσιν καὶ εὐχὴν καὶ λύσιν κακῶν·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.2.s2",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s2",
    "language": "grc",
    "text": "ἵνα ταῖς ἓξ ἡμέραις ἡ ἐποίησας ἁμάρτημα ἐν τοῖς βιωτικοῖς πράγμασιν· ἐρχομένης τῆς κυριακῆς, ὀρθρήσης ἐπὶ τὴν ἐκκλησίαν·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
