    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s9",
    "language": "grc",
    "text": "ἐκείνου γάρ ἐστιν ἡ ἀρχὴ τῆς ἀπωλείας τοῦ μὴ παραμεῖναι μετὰ πάντων ἐν τῇ εὐχῇ· λαβὼν γὰρ Ἰούδας τὸν ἄρτον ἐν τῷ στόματι·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
