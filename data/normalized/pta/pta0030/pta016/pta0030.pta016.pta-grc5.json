  },
  {
    "chunk_id": "pta/pta0030/pta016/pta-grc5#pta0030.pta016.2.s12",
    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.2.s12",
    "language": "grc",
    "text": "οὐδὲν σὲ βαρῇ ἡ παραμονή· οὐκ ἔχει ὁ ναὸς τοῦ θεοῦ πῦρ· οὔτε ξίφος· οὔτε ἕτερον κολαστήριον, ἀλλὰ ὑπομονὴν μιᾶς ὥρας·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
