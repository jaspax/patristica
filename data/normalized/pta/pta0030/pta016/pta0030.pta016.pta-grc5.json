    "work_id": "pta/pta0030/pta016/pta-grc5",
    "canonical_ref": "pta0030.pta016.3.s1",
    "language": "grc",
    "text": "δι οὐδὲν οὖν φυλάττειν ὀφείλωμεν τὴν κυριακὴν· ἃ μὴ τοῦ ἔργου ἀπεχόμενοι· σχολάσωμεν τῇ εὐχῇ· καὶ ἐν τοῖς μαρτυρίοις πυκνῶς ἀπιώμεν·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
