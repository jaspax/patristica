[
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.praef.1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.praef.1",
    "language": "grc",
    "text": "Τῷ εὐσεβεστάτῳ καὶ φιλανθρωποτάτῳ Νικητῇ Αὐγούστῳ Ἰοβιανῷ Ἀθανάσιος καὶ οἱ λοιποὶ ἐπίσκοποι οἱ ἐλθόντες ἐκ προσώπου πάντων τῶν ἀπὸ τῆς Αἰγύπτου καὶ Θηβαίδος καὶ Λιβυῶν ἐπισκόπων.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.1",
    "language": "grc",
    "text": "Πρέπουσα θεοφιλεῖ βασιλεῖ φιλομαθὴς προαίρεσις καὶ πόθος τῶν οὐρανίων· οὕτω γὰρ ἀληθῶς καὶ τὴν καρδίαν ἕξεις ἐν χειρὶ θεοῦ καὶ τὴν βασιλείαν μετ’ εἰρήνης πολλαῖς ἐτῶν περιόδοις διατελέσεις.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.2",
    "language": "grc",
    "text": "θελησάσης τοίνυν τῆς σῆς εὐσεβείας μαθεῖν παρ’ ἡμῶν τὴν τῆς καθολικῆς ἐκκλησίας πίστιν εὐχαριστήσαντες ἐπὶ τούτῳ τῷ κυρίῳ ἐβουλευσάμεθα πάντων μᾶλλον τὴν παρὰ τῶν πατέρων ὁμολογηθεῖσαν ἐν Νικαίᾳ πίστιν ὑπομνῆσαι τὴν σὴν θεοσέβειαν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.3.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.3.s1",
    "language": "grc",
    "text": "ταύτην γὰρ ἀθετήσαντές τινες ἡμῖν μὲν ποικίλως ἐπεβούλευσαν, ὅτι μὴ ἐπειθόμεθα τῇ ἀρειανῇ αἱρέσει, αἴτιοι δὲ γεγόνασιν αἱρέσεως καὶ σχισμάτων τῇ καθολικῇ ἐκκλησίᾳ.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.3.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.3.s2",
    "language": "grc",
    "text": "ἡ μὲν γὰρ ἀληθὴς καὶ εὐσεβὴς εἰς τὸν κύριον ἡμῶν Ἰησοῦν Χριστὸν πίστις φανερὰ πᾶσι καθέστηκεν ἐκ τῶν θείων γραφῶν γινωσκομένη τε καὶ ἀναγινωσκομένη ·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.3.s3",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.3.s3",
    "language": "grc",
    "text": "ἐν ταύτῃ γὰρ καὶ οἱ ἅγιοι τελειωθέντες ἐμαρτύρησαν καὶ νῦν ἀναλύσαντές εἰσιν ἐν κυρίῳ.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.3.s4",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.3.s4",
    "language": "grc",
    "text": "ἔμεινεν δ’ ἂν ἡ πίστις διὰ παντὸς ἀβλαβής, εἰ μὴ πονηρία τινῶν αἱρετικῶν παραποιῆσαι ταύτην ἐτόλμησεν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.4.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.4.s1",
    "language": "grc",
    "text": "Ἄρειος γάρ τις καὶ οἱ σὺν αὐτῷ διαφθεῖραι ταύτην καὶ ἀσέβειαν κατ’ αὐτῆς ἐπεισαγαγεῖν ἐπεχείρησαν φάσκοντες ἐξ οὐκ ὄντων καὶ κτίσμα καὶ ποίημα καὶ τρεπτὸν εἶναι τὸν υἱὸν τοῦ θεοῦ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.4.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.4.s2",
    "language": "grc",
    "text": "πολλοὺς τε ἐν τούτοις ἠπάτησαν, ὥστε καὶ τοὺς δοκοῦντας εἶναί τι συναπαχθῆναι αὐτῶν τῇ βλασφημίᾳ .",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.5.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.5.s1",
    "language": "grc",
    "text": "καὶ φθάσαντες μὲν οἱ ἅγιοι πατέρες ἡμῶν συνελθόντες, ὡς προείπομεν, ἐν τῇ κατὰ Νίκαιαν συνόδῳ τὴν μὲν ἀρειανῶν αἵρεσιν ἀνεθεμάτισαν,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.5.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.5.s2",
    "language": "grc",
    "text": "τὴν δὲ τῆς καθολικῆς ἐκκλησίας πίστιν ὡμολόγησαν ἐγγράφως, ὥστε ταύτης πανταχοῦ κηρυττομένης ἀποσβεσθῆναι τὴν ἀναφθεῖσαν αἵρεσιν παρὰ τῶν αἱρετικῶν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.5.s3",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.5.s3",
    "language": "grc",
    "text": "ἦν μὲν οὖν αὕτη πανταχοῦ κατὰ πᾶσαν ἐκκλησίαν γινωσκομένη τε καὶ κηρυττομένη·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.6.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.6.s1",
    "language": "grc",
    "text": "ἀλλ’ ἐπειδὴ νῦν τὴν ἀρειανὴν αἵρεσιν ἀνανεῶσαι βουλόμενοί τινες μὲν αὐτὴν τὴν ἐν Νικαίᾳ παρὰ τῶν πατέρων ὁμολογηθεῖσαν πίστιν τετολμήκασιν ἀθετῆσαι, τινὲς δὲ σχηματίζονται μὲν ὁμολογεῖν αὐτήν,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.6.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.6.s2",
    "language": "grc",
    "text": "ταῖς δὲ ἀληθείαις ἀρνοῦνται παρερμηνεύοντες τὸ ὁμοούσιον καὶ αὐτοὶ βλασφημοῦντες εἰς τὸ πνεῦμα τὸ ἅγιον ἐν τῷ φάσκειν αὐτοὺς κτίσμα εἶναι αὐτὸ καὶ ποίημα διὰ τοῦ υἱοῦ γεγονός,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.6.s3",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.6.s3",
    "language": "grc",
    "text": "ἀναγκαίως θεωρήσαντες τὴν ἐκ τῆς τοιαύτης βλασφημίας βλάβην γινομένην κατὰ τῶν λαῶν ἐπιδοῦναι τῇ σῇ εὐλαβείᾳ τὴν ἐν Νικαίᾳ ὁμολογηθεῖσαν πίστιν ἐσπουδάσαμεν,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.1.6.s4",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.1.6.s4",
    "language": "grc",
    "text": "ἵνα γνῷ σου ἡ θεοσέβεια, μεθ’ ὅσης ἀκριβείας γέγραπται καὶ ὅσον πλανῶνται οἱ παρὰ ταύτην διδάσκοντες.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.1.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.1.s1",
    "language": "grc",
    "text": "Γίνωσκε γάρ, θεοφιλέστατε Αὔγουστε, ὅτι αὕτη μὲν ἐξ αἰῶνός ἐστι κηρυττομένη, ταύτην δὲ ὡμολόγησαν οἱ ἐν Νικαίᾳ συνελθόντες πατέρες καὶ ταύτῃ σύμψηφοι τυγχάνουσι πᾶσαι αἱ πανταχοῦ κατὰ τόπον ἐκκλησίαι,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.1.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.1.s2",
    "language": "grc",
    "text": "αἵ τε κατὰ τὴν Σπανίαν καὶ Βρεττανίαν καὶ Γαλλίας καὶ τῆς Ἰταλίας πάσης καὶ Δαλματίας, Δακίας τε καὶ Μυσίας, Μακεδονίας καὶ πάσης Ἑλλάδος καὶ αἱ κατὰ τὴν Ἀφρικὴν πᾶσαι καὶ Σαρδανίαν καὶ Κύπρον καὶ Κρήτην,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.1.s3",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.1.s3",
    "language": "grc",
    "text": "Παμφυλίαν τε καὶ Λυκίαν καὶ Ἰσαυρίαν καὶ αἱ κατὰ πᾶσαν τὴν Αἴγυπτον καὶ τὰς Λιβύας καὶ Πόντον καὶ Καππαδοκίαν καὶ τὰ πλησίον μέρη καὶ αἱ κατὰ τὴν ἀνατολὴν ἐκκλησίαι παρὲξ ὀλίγων τῶν τὰ Ἀρείου φρονούντων.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.2.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.2.s1",
    "language": "grc",
    "text": "πάντων γὰρ τῶν προειρημένων τῇ πείρᾳ ἐγνώκαμεν τὴν γνώμην καὶ γράμματα ἔχομεν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.2.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.2.s2",
    "language": "grc",
    "text": "καὶ οἶδας, ὦ θεοφιλέστατε Αὔγουστε, ὅτι, κἂν ὀλίγοι τινὲς ἀντιλέγωσι ταύτῃ τῇ πίστει, οὐ δύνανται πρόκριμα ποιεῖν πάσῃ τῇ οἰκουμένῃ.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.2.s3",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.2.s3",
    "language": "grc",
    "text": "πολλῷ γὰρ χρόνῳ βλαβέντες ἀπὸ τῆς ἀρειανῆς αἱρέσεως φιλονεικότερον νῦν ἀνθίστανται τῇ εὐσεβείᾳ.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.2.2.s4",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.2.2.s4",
    "language": "grc",
    "text": "καὶ ὑπὲρ τοῦ γινώσκειν τὴν σὴν εὐσέβειαν καίτοι γινώσκουσαν ὅμως ἐσπουδάσαμεν τὴν ἐν Νικαίᾳ πίστιν ὁμολογηθεῖσαν ὑπὸ τριακοσίων ἐπισκόπων ὑποτάξαι.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.3.1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.3.1",
    "language": "grc",
    "text": "Ἔστι μὲν οὖν ἡ παρὰ τῶν πατέρων ὁμολογηθεῖσα πίστις ἐν Νικαίᾳ αὕτη·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.3.2.s1",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.3.2.s1",
    "language": "grc",
    "text": "Πιστεύομεν εἰς ἕνα θεόν, πατέρα παντοκράτορα, πάντων ὁρατῶν τε καὶ ἀοράτων ποιητήν, καὶ εἰς τὸν ἕνα κύριον Ἰησοῦν Χριστόν, τὸν υἱὸν τοῦ θεοῦ,",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.3.2.s2",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.3.2.s2",
    "language": "grc",
    "text": "γεννηθέντα ἐκ τοῦ πατρὸς μονογενῆ, τουτέστιν ἐκ τῆς οὐσίας τοῦ πατρός, θεὸν ἐκ θεοῦ, φῶς ἐκ φωτός, θεὸν ἀληθινὸν ἐκ θεοῦ ἀληθινοῦ, γεννηθέντα οὐ ποιηθέντα,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.3.2.s3",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.3.2.s3",
    "language": "grc",
    "text": "ὁμοούσιον τῷ πατρί, δι’ οὗ τὰ πάντα ἐγένετο τά τε ἐν τῷ οὐρανῷ καὶ τὰ ἐπὶ τῆς γῆς, τὸν δι’ ἡμᾶς τοὺς ἀνθρώπους καὶ διὰ τὴν ἡμετέραν σωτηρίαν κατελθόντα καὶ σαρκωθέντα,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta016/pta-grc1#pta0022.pta016.3.2.s4",
    "work_id": "pta/pta0022/pta016/pta-grc1",
    "canonical_ref": "pta0022.pta016.3.2.s4",
    "language": "grc",
