    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.1",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· τίνες ἐστὲ καὶ πόθεν;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
