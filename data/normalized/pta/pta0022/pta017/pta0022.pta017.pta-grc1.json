    "canonical_ref": "pta0022.pta017.1.1",
    "language": "grc",
    "text": "δεόμεθά σου τοῦ κράτους καὶ τοῦ βασιλείου σου καὶ τῆς εὐσεβείας σου, ἄκουσον ἡμῶν.",
    "chunk_index": 0,
    "context_before": null,
