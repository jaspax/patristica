    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.4",
    "language": "grc",
    "text": "τινὲς δὲ τοῦ πλήθους τῶν Ἀντιοχέων κατέσχον Λούκιον καὶ προσήνεγκαν τῷ βασιλεῖ λέγοντες· δεόμεθα τοῦ κράτους σου καὶ τοῦ βασιλείου σου, ἴδε τίνα ἠθέλησαν ποιῆσαι ἐπίσκοπον.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.4.1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.4.1",
    "language": "grc",
    "text": "δέομαί σου τοῦ κράτους, ἄκουσόν μου.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
