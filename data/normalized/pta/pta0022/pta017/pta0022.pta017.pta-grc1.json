    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.4.1.2",
    "language": "grc",
    "text": "Λούκιος εἶπε· δέομαί σου, πλοΐ.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
