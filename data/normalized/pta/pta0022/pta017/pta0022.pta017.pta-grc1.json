    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.4.1.1",
    "language": "grc",
    "text": "ὁ βασιλεὺς ἐστάθη καὶ εἶπε· σοὶ αὐτῷ Λουκίῳ λέγω, πῶς ἦλθες ὧδε, πλοῒ ἢ πεζής;",
    "chunk_index": 41,
    "context_before": null,
