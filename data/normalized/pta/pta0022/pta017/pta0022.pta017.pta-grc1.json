  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.2",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· κύριε, Χριστιανοί.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.3",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.3",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπε· πόθεν καὶ ἐκ ποίας πόλεως;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.4",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.4",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· Ἀλεξανδρείας.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.5",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.5",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπε· τί βούλεσθε;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.6",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.6",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· δεόμεθά σου τοῦ κράτους καὶ τοῦ βασιλείου σου, ἐπίσκοπον ἡμῖν δός.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.7",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.7",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· ἐκέλευσα τὸν πρότερον, ὅνπερ εἴχετε τὸ πρότερον, Ἀθανάσιον, καθέζεσθαι ἐν τῷ θρόνῳ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.1.8",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.1.8",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· δεόμεθά σου τοῦ κράτους· καὶ ἐν ἐξορισμῷ καὶ ἐν κατηγορίᾳ ἐστὶν ἔτη πολλά.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.2.s1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.2.s1",
    "language": "grc",
    "text": "στρατιώτης ἐξαίφνης ζηλώσας ἀπεκρίνατο· δέομαί σου τοῦ βασιλείου, αὐτὸς ἐξέτασον, τίνες εἰσὶ καὶ πόθεν.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.2.s2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.2.s2",
    "language": "grc",
    "text": "οὗτοι γάρ εἰσι τὰ λείψανα καὶ ἡ παραβολὴ τῆς Καππαδοκίας, τὰ ὑπόλοιπα τοῦ ἀνοσίου ἐκείνου Γεωργίου, οἱ τὴν πόλιν καὶ τὸν κόσμον ἐρημώσαντες.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.1.2.1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.1.2.1",
    "language": "grc",
    "text": "ἀκούσας ὁ βασιλεὺς ἐπτέρνισε τὸν ἵππον καὶ ἀπῆλθεν εἰς τὸν κάμπον.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.2.1.s1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.2.1.s1",
    "language": "grc",
    "text": "κατηγορίας καὶ ἀποδείξεις ἔχομεν κατὰ Ἀθανασίου, ὅστις πρὸ δέκα καὶ εἴκοσι καὶ τριάκοντα ἐτῶν ἐξωρίσθη ἀπὸ τῶν ἀειμνήστων Κωνσταντίνου καὶ Κωνσταντίου,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.2.1.s2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.2.1.s2",
    "language": "grc",
    "text": "καὶ ἐπὶ τοῦ θεοφιλεστάτου καὶ φιλοσοφωτάτου καὶ μακαριωτάτου Ἰουλιανοῦ ἔσχε τὴν ἐξόρισιν.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.2.1.1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.2.1.1",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· αἱ πρὸ δέκα καὶ εἴκοσι καὶ τριάκοντα ἐτῶν κατηγορίαι ἤδη παρῆλθον. ἐμοὶ μὴ λέγετε περὶ Ἀθανασίου· οἶδα γὰρ διά τι κατηγορήθη καὶ πῶς ἐξωρίσθη.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1",
    "language": "grc",
    "text": "καὶ νῦν πάλιν κατηγορίας ἔχομεν ἄλλας τινὰς κατὰ Ἀθανασίου.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.1.s1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.1.s1",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· οὐκ ἐκ τῆς πολυοχλίας καὶ ἐκ τῶν πολυφωνημάτων τὰ δίκαια φανήσεται.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.1.s2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.1.s2",
    "language": "grc",
    "text": "ἀλλ’ ἢ ἐκλέξασθε δύο ἐξ ἑαυτῶν καὶ ἐκ τῶν τοῦ πλήθους ἑτέρους δύο· οὐ γὰρ δύναμαι πρὸς ἕνα ἕκαστον ὑμῶν ἀποφαίνεσθαι.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.2",
    "language": "grc",
    "text": "οἱ ἐκ τοῦ πλήθους εἶπαν· οὗτοί εἰσι τὰ λείψανα ἀπὸ τοῦ ἀνοσίου Γεωργίου τοῦ ἐρημώσαντος τὴν ἐπαρχίαν ἡμῶν καὶ ἐν ταῖς πόλεσι βουλευτὴν μὴ ἐάσαντος οἰκῆσαι.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.3",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.3",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· δεόμεθά σου, εἴ τινα ἂν θέλῃς χωρὶς Ἀθανασίου.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.4",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.4",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· εἶπον ὑμῖν, ὅτι τὰ περὶ Ἀθανασίου ἤδη διοίκησιν ἔσχε. καὶ ὀργισθεὶς εἶπε· φέρι, φέρι.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.5",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.5",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· δεόμεθά σου, ἐὰν πέμψῃς Ἀθανάσιον, λυμαίνεται ἡ πόλις ἡμῶν, καὶ οὐδεὶς αὐτῷ συνέρχεται.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.6",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.6",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπε· καίτοι περιεργασάμενος ἔγνων, ὅτι καλῶς φρονεῖ καὶ ὀρθόδοξός ἐστι καὶ καλῶς διδάσκει.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.7",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.7",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· τῷ μὲν στόματι καλῶς φθέγγεται, τῇ δὲ ψυχῇ δολίως φρονεῖ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.8.s1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.8.s1",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπε· τοῦτο ἀρκετόν ἐστιν, ὅτι ὑμεῖς ἐμαρτυρήσατε περὶ αὐτοῦ, ὅτι καλῶς φθέγγεται καὶ καλῶς διδάσκει.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.1.8.s2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.1.8.s2",
    "language": "grc",
    "text": "εἰ δὲ τῇ γλώσσῃ καλῶς διδάσκει καὶ λέγει, τῇ δὲ ψυχῇ κακῶς φρονεῖ, πρὸς τὸν θεὸν ἔχει. ἄνθρωποι γὰρ ὄντες τὸν λόγον ἀκούομεν, τὰ δὲ ἐγκάρδια ὁ θεὸς οἶδεν.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· κέλευσον ἡμᾶς συνάγεσθαι.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2.1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2.1",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπε· τίς γὰρ κωλύει ὑμᾶς;",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2.2",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2.2",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· δεόμεθά σου, αἱρεσιώτας καὶ δογματιστὰς ἡμᾶς ἀπαγγέλλει.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2.3",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2.3",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· ἔργον αὐτοῦ ἐστι καὶ τῶν καλῶς διδασκόντων.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2.4",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2.4",
    "language": "grc",
    "text": "οἱ Ἀρειανοὶ εἶπον· δεόμεθά σου τοῦ κράτους· τοῦτον βαστάσαι οὐ δυνάμεθα, καὶ τὰ τεμένη τῶν ἐκκλησιῶν περιῄρει.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2.5",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2.5",
    "language": "grc",
    "text": "ὁ βασιλεὺς εἶπεν· οὐκοῦν ἕνεκεν χρημάτων ἤλθετε ὧδε καὶ οὐχ ἕνεκεν πίστεως; καὶ πάλιν εἶπεν· ἀπέλθετε καὶ εἰρηνεύετε.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 363,
    "date_range": null,
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0022/pta017/pta-grc1#pta0022.pta017.3.2.6.s1",
    "work_id": "pta/pta0022/pta017/pta-grc1",
    "canonical_ref": "pta0022.pta017.3.2.6.s1",
    "language": "grc",
    "text": "ἔτι προσθεὶς εἶπε πρὸς τοὺς Ἀρειανούς· ἀπέλθετε εἰς τὴν ἐκκλησίαν, αὔριον σύναξις ὑμῖν ἐστι.",
    "chunk_index": 32,
    "context_before": null,
