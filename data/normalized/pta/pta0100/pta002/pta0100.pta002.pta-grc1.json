    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.11.s3",
    "language": "grc",
    "text": "ἀλλ’ οὐκ ἰσχύσουσι· νικᾷ γὰρ ἡ ἀλήθεια καὶ οὐδεμία ἐστὶ κοινωνία φωτὶ πρὸς σκότος, οὐδὲ συμφώνησις Χριστοῦ πρὸς Βελίαρ.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
