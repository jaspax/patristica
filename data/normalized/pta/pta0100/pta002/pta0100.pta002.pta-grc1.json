  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.10",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.10",
    "language": "grc",
    "text": "ἠρώτησε γοῦν τις αὐτούς, εἰ δύναται ὁ τοῦ θεοῦ λόγος τραπῆναι ὡς ὁ διάβολος ἐτράπη, καὶ οὐκ ἐφοβήθησαν εἰπεῖν, ὅτι ναὶ δύναται· τρεπτῆς γὰρ φύσεώς ἐστι γενητὸς καὶ κτιστὸς ὑπάρχων.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
