    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.16.s4",
    "language": "grc",
    "text": "διὸ καὶ ἀπεκηρύχθησαν καὶ ἀνεθεματίσθησαν ἀπὸ τῆς ἐκκλησίας.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
