[
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.1",
    "language": "grc",
    "text": "Ἀλέξανδρος πρεσβυτέροις καὶ διακόνοις Ἀλεξανδρείας καὶ Μαρεώτου, παρὼν παροῦσιν, ἀγαπητοῖς ἀδελφοῖς ἐν κυρίῳ χαίρειν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.2.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.2.s1",
    "language": "grc",
    "text": "Εἰ καὶ φθάσαντες ὑπεγράψατε οἷς ἐπέστειλα τοῖς περὶ Ἄρειον προτρέπων αὐτοῖς ἀρνήσασθαι μὲν τὴν ἀσέβειαν πεισθῆναι δὲ τῇ ὑγιαινούσῃ καὶ καθολικῇ πίστει,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.2.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.2.s2",
    "language": "grc",
    "text": "καὶ ἐδείξατε ἑαυτῶν ὀρθὴν τὴν προαίρεσιν καὶ τὴν ἐν τοῖς δόγμασι συμφωνίαν τῆς καθολικῆς ἐκκλησίας, ὅμως ἐπειδὴ καὶ πρὸς τοὺς ἁπανταχοῦ συλλειτουργοὺς ἐπέστειλα περὶ τῶν περὶ Ἄρειον,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.2.s3",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.2.s3",
    "language": "grc",
    "text": "ἀναγκαῖον ἡγησάμην ὑμᾶς μὲν τοὺς τῆς πόλεως κληρικοὺς συναγαγεῖν, ὑμᾶς δὲ τοὺς ἀπὸ τοῦ Μαρεώτου μεταπέμψασθαι.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.3.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.3.s1",
    "language": "grc",
    "text": "μάλιστα ὅτι καὶ ἀφ’ ὑμῶν Χάρης καὶ Πιστὸς πρεσβύτεροι, καὶ Σαραπίων καὶ Παράμμων καὶ Ζώσιμος καὶ Εἰρηναῖος διάκονοι ἐπηκολούθησαν τοῖς περὶ Ἄρειον καὶ ἠγάπησαν σὺν αὐτοῖς καθαιρεθῆναι·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.3.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.3.s2",
    "language": "grc",
    "text": "ἵνα καὶ τὰ νῦν γραφόμενα γνῶτε τήν τε ἐν τούτοις συμφωνίαν ἑαυτῶν ἐπιδείξησθε καὶ τῇ καθαιρέσει τῶν περὶ Ἄρειον καὶ τῶν περὶ Πιστὸν σύμψηφοι γένησθε.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.1.4",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.1.4",
    "language": "grc",
    "text": "πρέπει γὰρ τὰ παρ’ ἐμοῦ γραφόμενα γινώσκειν ὑμᾶς καὶ ἕκαστον ὥς παρ ̓ αὐτοῦ γραφόμενα ἐν τῇ καρδίᾳ κατέχειν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.1",
    "language": "grc",
    "text": "Τοῖς ἀγαπητοῖς καὶ τιμιωτάτοις συλλειτουργοῖς τοῖς ἁπανταχοῦ τῆς καθολικῆς ἐκκλησίας Ἀλέξανδρος ἐν κυρίῳ χαίρειν.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.2.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.2.s1",
    "language": "grc",
    "text": "Ἑνὸς σώματος ὄντος τῆς καθολικῆς ἐκκλησίας ἐντολῆς τε οὔσης ἐν ταῖς θείαις γραφαῖς τηρεῖν τὸν σύνδεσμον τῆς ὁμονοίας καὶ εἰρήνης ἀκόλουθόν ἐστι γράφειν ἡμᾶς καὶ σημαίνειν ἀλλήλοις τὰ παρ’ ἑκάστου γινόμενα,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.2.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.2.s2",
    "language": "grc",
    "text": "ἵνα εἴτε πάσχει εἴτε χαίρει ἓν μέλος ἢ συμπάσχωμεν ἢ συγχαίρωμεν ἀλλήλοις.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.3",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.3",
    "language": "grc",
    "text": "ἐν τῇ ἡμετέρᾳ τοίνυν παροικίᾳ ἐξῆλθον νῦν ἄνδρες παράνομοι καὶ χριστομάχοι διδάσκοντες ἀποστασίαν, ἣν εἰκότως ἄν τις πρόδρομον τοῦ ἀντιχρίστου ὑπονοήσειε καὶ καλέσειεν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.4.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.4.s1",
    "language": "grc",
    "text": "καὶ ἐβουλόμην μὲν σιωπῇ παραδοῦναι τὸ τοιοῦτον, ὅπως ἐν τοῖς προστάταις μόνοις ἀναλωθῇ τὸ κακὸν καὶ μὴ εἰς ἑτέρους τόπους διαβὰν τὸ τοιοῦτον ῥυπώσῃ τινῶν ἀκεραίων τὰς ἀκοάς.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.4.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.4.s2",
    "language": "grc",
    "text": "ἐπειδὴ δὲ Εὐσέβιος ὁ νῦν ἐν τῇ Νικομηδείᾳ νομίσας ἐπ’ αὐτῷ κεῖσθαι τὰ τῆς ἐκκλησίας,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.4.s3",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.4.s3",
    "language": "grc",
    "text": "ὅτι καταλείψας τὴν Βηρυτὸν καὶ ἐποφθαλμίσας τῇ ἐκκλησίᾳ Νικομηδέων καὶ οὐκ ἐκδεδίκηται κατ’ αὐτοῦ, προίσταται καὶ τούτων τῶν ἀποστατῶν καὶ γράφειν ἐπεχείρησε πανταχοῦ συνιστῶν αὐτούς,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.4.s4",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.4.s4",
    "language": "grc",
    "text": "ὅπως ὑποσύρῃ τινὰς ἀγνοοῦντας εἰς τὴν αἰσχίστην ταύτην καὶ χριστομάχον αἵρεσιν, ἀνάγκην ἔσχον εἰδὼς τὸ ἐν τῷ νόμῳ γεγραμμένον μηκέτι μὲν σιωπῆσαι,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.4.s5",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.4.s5",
    "language": "grc",
    "text": "ἀναγγεῖλαι δὲ πᾶσιν ὑμῖν, ἵνα γινώσκητε τούς τε ἀποστάτας γενομένους καὶ τὰ τῆς αἱρέσεως αὐτῶν δύστηνα ῥήματα καί, ἐὰν γράφῃ Εὐσέβιος, μὴ προσέχητε.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.5",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.5",
    "language": "grc",
    "text": "παλαιὰν γὰρ αὐτοῦ κακόνοιαν τὴν χρόνῳ σιωπηθεῖσαν νῦν διὰ τούτων ἀνανεῶσαι βουλόμενος σχηματίσεται μὲν ὡς ὑπὲρ τούτων γράφειν, ἔργῳ δὲ δείκνυσιν, ὅτι ὑπὲρ ἑαυτοῦ σπουδάζων τοῦτο ποιεῖ.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.6.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.6.s1",
    "language": "grc",
    "text": "Οἱ μὲν οὖν ἀποστάται γενόμενοί εἰσιν Ἄρειος καὶ Ἀχιλεὺς καὶ Ἀειθαλῆς καὶ Καρπώνης καὶ ἕτερος Ἄρειος καὶ Σαρμάτης οἱ ποτὲ πρεσβύτεροι·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.6.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.6.s2",
    "language": "grc",
    "text": "καὶ Εὐζώϊος καὶ Λούκιος καὶ Ἰούλιος καὶ Μηνᾶς καὶ Ἑλλάδιος καὶ Γάϊος οἱ ποτὲ διάκονοι· καὶ σὺν αὐτοῖς Σεκοῦνδος καὶ Θεωνᾶς οἱ ποτὲ λεχθέντες ἐπίσκοποι.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.7",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.7",
    "language": "grc",
    "text": "ποῖα δὲ παρὰ τὰς γραφὰς ἐφευρόντες λαλοῦσιν, ἔστι ταῦτα·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.7.1.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.7.1.s1",
    "language": "grc",
    "text": "Οὐκ ἀεὶ ὁ θεὸς πατὴρ ἦν, ἀλλ’ ἦν ὅτε ὁ θεὸς πατὴρ οὐκ ἦν. οὐκ ἀεὶ ἦν ὁ τοῦ θεοῦ λόγος, ἀλλ’ ἐξ οὐκ ὄντων γέγονεν.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.7.1.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.7.1.s2",
    "language": "grc",
    "text": "ὁ γὰρ ὢν θεὸς τὸν μὴ ὄντα ἐκ τοῦ μὴ ὄντος πεποίηκε. διὸ καὶ ἦν ποτε ὅτε οὐκ ἦν. κτίσμα γάρ ἐστι καὶ ποίημα ὁ υἱός,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.7.1.s3",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.7.1.s3",
    "language": "grc",
    "text": "οὔτε δὲ ὅμοιος κατ’ οὐσίαν τῷ πατρί ἐστιν οὔτε ἀληθινὸς καὶ φύσει τοῦ πατρὸς λόγος ἐστὶν οὔτε ἀληθινὴ σοφία αὐτοῦ ἐστιν, ἀλλ’ εἷς μὲν τῶν ποιημάτων καὶ γενητῶν ἐστι,",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.7.1.s4",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.7.1.s4",
    "language": "grc",
    "text": "καταχρηστικῶς δὲ λέγεται λόγος καὶ σοφία, γενόμενος καὶ αὐτὸς τῷ ἰδίῳ τοῦ θεοῦ λόγῳ καὶ τῇ ἐν τῷ θεῷ σοφίᾳ ἐν ᾗ καὶ τὰ πάντα καὶ αὐτὸν πεποίηκεν ὁ θεός.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.8.s1",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.8.s1",
    "language": "grc",
    "text": "διὸ καὶ τρεπτός ἐστι καὶ ἀλλοιωτὸς τὴν φύσιν ὡς καὶ πάντα τὰ λογικά.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.8.s2",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.8.s2",
    "language": "grc",
    "text": "ξένος τε καὶ ἀλλότριος καὶ ἀπεσχοινισμένος ἐστὶν ὁ λόγος τῆς τοῦ θεοῦ οὐσίας καὶ ἀόρατός ἐστιν ὁ πατὴρ τῷ υἱῷ.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.8.s3",
    "work_id": "pta/pta0100/pta002/pta-grc1",
    "canonical_ref": "pta0100.pta002.2.8.s3",
    "language": "grc",
    "text": "οὔτε γὰρ τελείως καὶ ἀκριβῶς γινώσκει ὁ λόγος τὸν πατέρα, οὔτε τελείως ὁρᾶν αὐτὸν δύναται. καὶ γὰρ καὶ ἑαυτοῦ τὴν οὐσίαν οὐκ οἶδεν ὁ υἱὸς ὡς ἔστι.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta002/pta-grc1#pta0100.pta002.2.9",
