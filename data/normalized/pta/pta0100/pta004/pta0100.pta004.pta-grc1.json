[
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.0",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.0",
    "language": "grc",
    "text": "Τῷ δεσπότῃ μου Παυλίνῳ Εὐσέβιος ἐν κυρίῳ χαίρειν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.1.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.1.s1",
    "language": "grc",
    "text": "Οὔτε ἡ τοῦ δεσπότου μου Εὐσεβίου σπουδὴ ἡ ὑπὲρ τοῦ ἀληθοῦς λόγου παρεσιωπήθη, ἀλλ’ ἔφθασεν ἕως καὶ ἡμῶν, οὔτε ἡ σοῦ ἐπὶ τούτῳ σιωπή, δέσποτα.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.1.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.1.s2",
    "language": "grc",
    "text": "καὶ ὡς ἦν ἀκόλουθον, ἐπὶ μὲν τῷ δεσπότῃ μου Εὐσεβίῳ ηὐφράνθημεν, ἐπὶ δὲ σοὶ λυπούμεθα, στοχαζόμενοι καὶ τὴν σιωπὴν ἀνδρὸς τοιούτου ἧτταν ἡμῶν εἶναι.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.2.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.2.s1",
    "language": "grc",
    "text": "διὸ παρακαλῶ εἰδότα σε ὡς ἀπρεπὲς ἀνδρὶ φρονίμῳ ἀλλοῖα φρονεῖν καὶ σιωπᾶν τἀληθῆ, ἀνασκαλεύσαντι τῷ πνεύματι τὸν λογισμὸν περὶ τὸ γράφειν περὶ τούτου ἄρχου λυσιτελοῦντος καὶ σοὶ καὶ τοῖς ἀκούουσί σου,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.2.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.2.s2",
    "language": "grc",
    "text": "μάλισθ’ ὅταν κατὰ ἀκολουθίαν τῆς γραφῆς καὶ τοῖς ἴχνεσι τῶν λόγων αὐτῆς καὶ τῶν βουλημάτων ἐθέλοις γράφειν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.3.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.3.s1",
    "language": "grc",
    "text": "Ὅτι γὰρ οὔτε δύο ἀγέννητα ἀκηκόαμεν οὔτε ἓν εἰς δύο διῃρημένον οὐδὲ σωματικόν τι πεπονθὸς μεμαθήκαμεν ἢ πεπιστεύκαμεν, δέσποτα, ἀλλ’ ἓν μὲν τὸ ἀγέννητον,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.3.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.3.s2",
    "language": "grc",
    "text": "ἓν δὲ τὸ ὑπ’ αὐτοῦ ἀληθῶς καὶ οὐκ ἐκ τῆς οὐσίας αὐτοῦ γεγονός, καθόλου τῆς φύσεως τῆς ἀγεννήτου μὴ μετέχον ἢ ὃν ἐκ τῆς οὐσίας αὐτοῦ,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.3.s3",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.3.s3",
    "language": "grc",
    "text": "ἀλλὰ γεγονὸς ὁλοσχερῶς ἕτερον τῇ φύσει καὶ τῇ δυνάμει, πρὸς τελείαν ὁμοιότητα διαθέσεώς τε καὶ δυνάμεως τοῦ πεποιηκότος γενόμενον.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.3.s4",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.3.s4",
    "language": "grc",
    "text": "οὗ τὴν ἀρχὴν οὐ λόγῳ μόνον ἀδιήγητον, ἀλλὰ καὶ ἐννοίᾳ οὐκ ἀνθρώπων μόνον, ἀλλὰ καὶ τῶν ὑπὲρ ἀνθρώπους πάντων εἶναι ἀκατάληπτον πεπιστεύκαμεν.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.4.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.4.s1",
    "language": "grc",
    "text": "Καὶ ταῦτα οὐχὶ λογισμοὺς ἑαυτῶν ὑποθέμενοι, ἀλλ’ ἀπὸ τῆς ἁγίας γραφῆς μεμαθηκότες λέγομεν·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.4.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.4.s2",
    "language": "grc",
    "text": "κτιστὸν εἶναι καὶ θεμελιωτὸν καὶ γεννητὸν τῇ οὐσίᾳ καὶ τῇ ἀναλλοιώτῳ καὶ ἀρρήτῳ φύσει καὶ ὁμοιότητι τῇ πρὸς τὸν πεποιηκότα μεμαθήκαμεν, ὡς αὐτὸς ὁ κύριός φησιν·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.4.s3",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.4.s3",
    "language": "grc",
    "text": "»ὁ θεὸς ἔκτισέ με ἀρχὴν ὁδῶν αὐτοῦ, καὶ πρὸ τοῦ αἰῶνος ἐθεμελίωσέ με· πρὸ δὲ πάντων βουνῶν γεννᾷ με«.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.5.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.5.s1",
    "language": "grc",
    "text": "εἰ δὲ ἐξ αὐτοῦ, τουτέστιν ἀπ’ αὐτοῦ ἦν ὡς ἂν μέρος αὐτοῦ ἢ ἐξ ἀπορροίας τῆς οὐσίας, οὐκ ἂν ἔτι κτιστὸν οὐδὲ θεμελιωτὸν εἶναι ἐλέγετο·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.5.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.5.s2",
    "language": "grc",
    "text": "οὐδὲ αὐτὸς ἀγνοεῖς, κύριε, ἀληθῶς, τὸ γὰρ ἐκ τοῦ ἀγεννήτου ὑπάρχον κτιστὸν ἔτι ὑφ’ ἑτέρου ἢ ὑπ’ αὐτοῦ ἢ θεμελιωτὸν οὐκ ἂν εἴη, ἐξ ἀρχῆς ἀγέννητον ὑπάρχον.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.6.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.6.s1",
    "language": "grc",
    "text": "εἰ δὲ τὸ γεννητὸν αὐτὸν λέγεσθαι ὑπόβασίν τινα παρέχει, ὡς ἂν ἐκ τῆς οὐσίας τῆς πατρικῆς αὐτὸν γεγονότα καὶ ἔχειν ἐκ τούτου τὴν ταυτότητα τῆς φύσεως,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.6.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.6.s2",
    "language": "grc",
    "text": "γιγνώσκομεν ὡς οὐ περὶ αὐτοῦ μόνου τὸ γεννητὸν εἶναί φησιν ἡ γραφή, ἀλλὰ καὶ ἐπὶ τῶν ἀνομοίων αὐτῷ κατὰ πάντα τῇ φύσει.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.7.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.7.s1",
    "language": "grc",
    "text": "καὶ γὰρ καὶ ἐπ’ ἀνθρώπων φησίν· »υἱοὺς ἐγέννησα καὶ ὕψωσα, αὐτοὶ δέ με ἠθέτησαν«, καὶ »θεὸν τὸν γεννήσαντά σε ἐγκατέλιπες«, καὶ ἐν ἑτέροις »τίς«, φησί, »ὁ τετοκὼς βώλους δρόσου«;",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.7.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.7.s2",
    "language": "grc",
    "text": "οὐ τὴν φύσιν ἐκ τῆς φύσεως διηγούμενος, ἀλλὰ τὴν ἐφ’ ἑκάστῳ τῶν γενομένων ἐκ τοῦ βουλήματος αὐτοῦ γένεσιν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.7.s3",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.7.s3",
    "language": "grc",
    "text": "οὐδὲν γάρ ἐστιν ἐκ τῆς οὐσίας αὐτοῦ, πάντα δὲ βουλήματι αὐτοῦ γενόμενα ἕκαστον, ὡς καὶ ἐγένετο, ἐστίν.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.8.s1",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.8.s1",
    "language": "grc",
    "text": "ὁ μὲν γὰρ θεός, τὰ δὲ πρὸς ὁμοιότητα αὐτοῦ λόγῳ ὅμοια ἐσόμενα, τὰ δὲ καθ’ ἑκουσιασμὸν γενόμενα· τὰ δὲ πάντα δι’ αὐτοῦ ὑπὸ τοῦ θεοῦ γενόμενα, πάντα δὲ ἐκ τοῦ θεοῦ.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.8.s2",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.8.s2",
    "language": "grc",
    "text": "ἅπερ λαβὼν καὶ ἐξεργασάμενος κατὰ τὴν προσοῦσάν σοι θεόθεν χάριν, γράψαι τῷ δεσπότῃ μου Ἀλεξάνδρῳ σπούδασον.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
      800
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "pta/pta0100/pta004/pta-grc1#pta0100.pta004.8.s3",
    "work_id": "pta/pta0100/pta004/pta-grc1",
    "canonical_ref": "pta0100.pta004.8.s3",
    "language": "grc",
    "text": "πεπίστευκα γὰρ ὡς εἰ γράψειας αὐτῷ, ἐντρέψειας αὐτόν. πρόσειπε πάντας τοὺς ἐν κυρίῳ. ἐρρωμένον σε καὶ ὑπὲρ ἡμῶν εὐχόμενον ἡ θεία χάρις διαφυλάττοι, δέσποτα.",
    "chunk_index": 21,
    "context_before": null,
