    "work_id": "pta/pta0100/pta009/pta-grc1",
    "canonical_ref": "pta0100.pta009.2.s1",
    "language": "grc",
    "text": "Κατηγορεῖ αὐτῶν τὰ σὰ γράμματα ὡς λεγόντων, ὅτι ὁ υἱὸς ἐκ τοῦ μὴ ὄντος γέγονεν ὡς εἷς τῶν πάντων.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
