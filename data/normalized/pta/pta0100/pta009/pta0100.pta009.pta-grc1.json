    "work_id": "pta/pta0100/pta009/pta-grc1",
    "canonical_ref": "pta0100.pta009.2.s4",
    "language": "grc",
    "text": "γεννήσαντα δὲ οὐ δοκήσει, ἀλλὰ ἀληθείᾳ, ὑποστήσαντα ἰδίῳ θελήματι, ἄτρεπτον καὶ ἀναλλοίωτον, κτίσμα τοῦ θεοῦ τέλειον, ἀλλ’ οὐχ ὡς ἓν τῶν κτισμάτων«.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
