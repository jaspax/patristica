    "work_id": "pta/pta0100/pta009/pta-grc1",
    "canonical_ref": "pta0100.pta009.2.s2",
    "language": "grc",
    "text": "οἱ δὲ προήνεγκαν ἑαυτῶν γραμματεῖον, ὃ πρὸς σὲ πεποιήκασιν, ἐν ᾧ τὴν ἑαυτῶν πίστιν ἐκθέμενοι αὐτοῖς ῥήμασιν τάδε ὡμολόγουν·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 415,
    "date_range": [
      30,
