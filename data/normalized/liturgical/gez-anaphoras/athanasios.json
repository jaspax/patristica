    "work_id": "gez-anaphoras/athanasios",
    "canonical_ref": "EthLit.Athanasios.0016",
    "language": "eng",
    "text": "Thou hast made him (man) to see death and life. He loved death and despised life—not the death of the body (only). . . but eternal death.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
