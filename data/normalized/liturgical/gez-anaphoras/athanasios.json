    "work_id": "gez-anaphoras/athanasios",
    "canonical_ref": "EthLit.Athanasios.0009",
    "language": "eng",
    "text": "The priest saith: Let the inner ears of your heart be opened, and not the ears which are set without.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 380,
    "date_range": [
      350,
