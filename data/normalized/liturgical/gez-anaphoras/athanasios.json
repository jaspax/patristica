    "work_id": "gez-anaphoras/athanasios",
    "canonical_ref": "EthLit.Athanasios.0004",
    "language": "eng",
    "text": "The deacon saith: Ye who are gathered on this day, hearken to the Eucharist (qedddsé) of the holy Christian Sabbath.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
