    "work_id": "gez-anaphoras/athanasios",
    "canonical_ref": "EthLit.Athanasios.0011",
    "language": "eng",
    "text": "And let not your mind be as the waves of the sea, now rising up and again sinking down, but let it be as a pillar of fire reaching from the earth to the heaven.",
