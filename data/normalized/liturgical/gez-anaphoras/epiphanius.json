    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0009",
    "language": "eng",
    "text": "The priest saith: He came, though He was here (already), He was sent, though here His sound was heard; He came down, though He moved not from His throne nor left His place.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
    "date_confidence": "uncertain",
