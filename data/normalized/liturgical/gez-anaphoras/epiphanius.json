    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0019",
    "language": "eng",
    "text": "The priest saith: Lord of lights, Lord of dominions, Lord of the heads of the angels. .. .",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
    "date_confidence": "uncertain",
