    "translation_group_id": null
  },
  {
    "chunk_id": "gez-anaphoras/epiphanius#EthLit.Epiphanius.0012",
    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0012",
    "language": "eng",
    "text": "Here follows mention of His baptism, temptation, His hungering and thirsting, His preaching of the gospel of the kingdom of heaven.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
