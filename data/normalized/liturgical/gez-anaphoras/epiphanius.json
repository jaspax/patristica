    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0013",
    "language": "eng",
    "text": "102 THE ANAPHORAS OF THE ETHIOPIC LITURGY",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
