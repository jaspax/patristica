  },
  {
    "chunk_id": "gez-anaphoras/epiphanius#EthLit.Epiphanius.0011",
    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0011",
    "language": "eng",
    "text": "The priest saith: He was conceived in the womb, though He filled all things.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
