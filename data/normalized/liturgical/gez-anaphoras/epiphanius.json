  },
  {
    "chunk_id": "gez-anaphoras/epiphanius#EthLit.Epiphanius.0020",
    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0020",
    "language": "eng",
    "text": "O Lord Almighty, Father of our Lord and our God and our Saviour Jesus Christ, make us worthy to receive of this bread, the life-giving Body of Thy Son, and of this cup, the reasonable Blood of Thy Messiah, by whom to Thee, with Him, etc.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
    "date_confidence": "uncertain",
