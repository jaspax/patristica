    "translation_group_id": null
  },
  {
    "chunk_id": "gez-anaphoras/epiphanius#EthLit.Epiphanius.0018",
    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0018",
    "language": "eng",
    "text": "The deacon saith: Standing (bow your heads).",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
    "date_confidence": "uncertain",
