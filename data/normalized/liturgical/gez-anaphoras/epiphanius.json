    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0008",
    "language": "eng",
    "text": "The deacon saith: For the sake of the blessed.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
