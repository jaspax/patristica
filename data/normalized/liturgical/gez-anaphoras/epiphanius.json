    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0004",
    "language": "eng",
    "text": "There is no beginning of His essence, nor end of His Being ; there is no number of His days nor reckoning of His years... .",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
