    "work_id": "gez-anaphoras/epiphanius",
    "canonical_ref": "EthLit.Epiphanius.0010",
    "language": "eng",
    "text": "The deacon saith: Ye who sit (arise).",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 403,
    "date_range": [
      380,
      430
    ],
    "date_confidence": "uncertain",
