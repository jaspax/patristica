    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.1.13",
    "language": "grc",
    "text": "καὶ εἶπεν Αγγαιος ὁ ἄγγελος κυρίου τῷ λαῷ ἐγώ εἰμι μεθ᾿ ὑμῶν λέγει κύριος",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
