    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.2.12",
    "language": "grc",
    "text": "ἐὰν λάβῃ ἄνθρωπος κρέας ἅγιον ἐν τῷ ἄκρῳ τοῦ ἱματίου αὐτοῦ καὶ ἅψηται τὸ ἄκρον τοῦ ἱματίου αὐτοῦ ἄρτου ἢ ἑψέματος ἢ οἴνου ἢ ἐλαίου ἢ παντὸς βρώματος εἰ ἁγιασθήσεται καὶ ἀπεκρίθησαν οἱ ἱερεῖς καὶ εἶπαν οὔ",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
