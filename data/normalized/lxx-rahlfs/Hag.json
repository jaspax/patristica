    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.1.3",
    "language": "grc",
    "text": "καὶ ἐγένετο λόγος κυρίου ἐν χειρὶ Αγγαιου τοῦ προφήτου λέγων",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
