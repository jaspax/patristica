    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.2.11",
    "language": "grc",
    "text": "τάδε λέγει κύριος παντοκράτωρ ἐπερώτησον τοὺς ἱερεῖς νόμον λέγων",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
