    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.2.3",
    "language": "grc",
    "text": "τίς ἐξ ὑμῶν ὃς εἶδεν τὸν οἶκον τοῦτον ἐν τῇ δόξῃ αὐτοῦ τῇ ἔμπροσθεν καὶ πῶς ὑμεῖς βλέπετε αὐτὸν νῦν καθὼς οὐχ ὑπάρχοντα ἐνώπιον ὑμῶν",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
