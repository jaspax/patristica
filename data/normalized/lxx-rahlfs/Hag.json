    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.2.5",
    "language": "grc",
    "text": "καὶ τὸ πνεῦμά μου ἐφέστηκεν ἐν μέσῳ ὑμῶν θαρσεῖτε",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
