    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.2.7",
    "language": "grc",
    "text": "καὶ συσσείσω πάντα τὰ ἔθνη καὶ ἥξει τὰ ἐκλεκτὰ πάντων τῶν ἐθνῶν καὶ πλήσω τὸν οἶκον τοῦτον δόξης λέγει κύριος παντοκράτωρ",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
