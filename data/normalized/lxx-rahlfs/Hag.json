    "work_id": "lxx-rahlfs/hag",
    "canonical_ref": "Hag.2.8",
    "language": "grc",
    "text": "ἐμὸν τὸ ἀργύριον καὶ ἐμὸν τὸ χρυσίον λέγει κύριος παντοκράτωρ",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
