    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.7",
    "language": "grc",
    "text": "εὐλαβεῖσθε ἀπὸ προσώπου κυρίου τοῦ θεοῦ διότι ἐγγὺς ἡ ἡμέρα τοῦ κυρίου ὅτι ἡτοίμακεν κύριος τὴν θυσίαν αὐτοῦ ἡγίακεν τοὺς κλητοὺς αὐτοῦ",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
