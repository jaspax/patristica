    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.2",
    "language": "grc",
    "text": "ἐκλείψει ἐκλιπέτω πάντα ἀπὸ προσώπου τῆς γῆς λέγει κύριος",
