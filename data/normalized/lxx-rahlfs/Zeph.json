    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.11",
    "language": "grc",
    "text": "θρηνήσατε οἱ κατοικοῦντες τὴν κατακεκομμένην ὅτι ὡμοιώθη πᾶς ὁ λαὸς Χανααν ἐξωλεθρεύθησαν πάντες οἱ ἐπηρμένοι ἀργυρίῳ",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
