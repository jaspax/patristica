    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.12",
    "language": "grc",
    "text": "καὶ ἔσται ἐν ἐκείνῃ τῇ ἡμέρᾳ ἐξερευνήσω τὴν Ιερουσαλημ μετὰ λύχνου καὶ ἐκδικήσω ἐπὶ τοὺς ἄνδρας τοὺς καταφρονοῦντας ἐπὶ τὰ φυλάγματα αὐτῶν οἱ λέγοντες ἐν ταῖς καρδίαις αὐτῶν οὐ μὴ ἀγαθοποιήσῃ κύριος οὐδ᾿ οὐ μὴ κακώσῃ",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
