    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.9",
    "language": "grc",
    "text": "καὶ ἐκδικήσω ἐπὶ πάντας ἐμφανῶς ἐπὶ τὰ πρόπυλα ἐν ἐκείνῃ τῇ ἡμέρᾳ τοὺς πληροῦντας τὸν οἶκον κυρίου τοῦ θεοῦ αὐτῶν ἀσεβείας καὶ δόλου",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
