    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.8",
    "language": "grc",
    "text": "ἤκουσα ὀνειδισμοὺς Μωαβ καὶ κονδυλισμοὺς υἱῶν Αμμων ἐν οἷς ὠνείδιζον τὸν λαόν μου καὶ ἐμεγαλύνοντο ἐπὶ τὰ ὅριά μου",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
