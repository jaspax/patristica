    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.4",
    "language": "grc",
    "text": "διότι Γάζα διηρπασμένη ἔσται καὶ Ἀσκαλὼν ἔσται εἰς ἀφανισμόν καὶ Ἄζωτος μεσημβρίας ἐκριφήσεται καὶ Ακκαρων ἐκριζωθήσεται",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
