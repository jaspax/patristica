  },
  {
    "chunk_id": "lxx-rahlfs/zeph#Zeph.2.11",
    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.11",
    "language": "grc",
    "text": "ἐπιφανήσεται κύριος ἐπ᾿ αὐτοὺς καὶ ἐξολεθρεύσει πάντας τοὺς θεοὺς τῶν ἐθνῶν τῆς γῆς καὶ προσκυνήσουσιν αὐτῷ ἕκαστος ἐκ τοῦ τόπου αὐτοῦ πᾶσαι αἱ νῆσοι τῶν ἐθνῶν",
    "chunk_index": 28,
    "context_before": null,
