  },
  {
    "chunk_id": "lxx-rahlfs/zeph#Zeph.2.9",
    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.9",
    "language": "grc",
    "text": "διὰ τοῦτο ζῶ ἐγώ λέγει κύριος τῶν δυνάμεων ὁ θεὸς Ισραηλ διότι Μωαβ ὡς Σοδομα ἔσται καὶ οἱ υἱοὶ Αμμων ὡς Γομορρα καὶ Δαμασκὸς ἐκλελειμμένη ὡς θιμωνιὰ ἅλωνος καὶ ἠφανισμένη εἰς τὸν αἰῶνα καὶ οἱ κατάλοιποι λαοῦ μου διαρπῶνται αὐτούς καὶ οἱ κατάλοιποι ἔθνους μου κληρονομήσουσιν αὐτούς",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
