    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.1",
    "language": "grc",
    "text": "συνάχθητε καὶ συνδέθητε τὸ ἔθνος τὸ ἀπαίδευτον",
