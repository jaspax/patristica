    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.6",
    "language": "grc",
    "text": "καὶ τοὺς ἐκκλίνοντας ἀπὸ τοῦ κυρίου καὶ τοὺς μὴ ζητήσαντας τὸν κύριον καὶ τοὺς μὴ ἀντεχομένους τοῦ κυρίου",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
