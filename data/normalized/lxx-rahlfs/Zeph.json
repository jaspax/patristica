    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.1.13",
    "language": "grc",
    "text": "καὶ ἔσται ἡ δύναμις αὐτῶν εἰς διαρπαγὴν καὶ οἱ οἶκοι αὐτῶν εἰς ἀφανισμόν καὶ οἰκοδομήσουσιν οἰκίας καὶ οὐ μὴ κατοικήσουσιν ἐν αὐταῖς καὶ καταφυτεύσουσιν ἀμπελῶνας καὶ οὐ μὴ πίωσιν τὸν οἶνον αὐτῶν",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
