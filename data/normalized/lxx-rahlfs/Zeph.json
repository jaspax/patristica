    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.5",
    "language": "grc",
    "text": "οὐαὶ οἱ κατοικοῦντες τὸ σχοίνισμα τῆς θαλάσσης πάροικοι Κρητῶν λόγος κυρίου ἐφ᾿ ὑμᾶς Χανααν γῆ ἀλλοφύλων καὶ ἀπολῶ ὑμᾶς ἐκ κατοικίας",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
