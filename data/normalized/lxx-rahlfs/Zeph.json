    "work_id": "lxx-rahlfs/zeph",
    "canonical_ref": "Zeph.2.6",
    "language": "grc",
    "text": "καὶ ἔσται Κρήτη νομὴ ποιμνίων καὶ μάνδρα προβάτων",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
