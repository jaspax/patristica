    "work_id": "syriac-documents/eusebius-abgar-story",
    "canonical_ref": "EusAbgar.3",
    "language": "eng",
    "text": "Now the story relating to Thaddæus was on this wise:—",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 313,
    "date_range": [
