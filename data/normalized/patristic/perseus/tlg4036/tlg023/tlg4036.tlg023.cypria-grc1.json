[
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1",
    "language": "grc",
    "text": "Ἐπιβάλλει τούτοις τὰ λεγόμενα Κύπρια ἐν βιβλΐοις φερόμενα ἕνδεκα· ὧν περὶ τῆς γραφῆς ὕστερον ἐροῦμεν· ἵ̈να μὴ τὸν ἑξῆς λόγον νῦν ἐμποδίζωμεν· τὰ δὲ περιέχοντά, ἐστὶ ταῦτα·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.1",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.1",
    "language": "grc",
    "text": "Ζεὺς βουλεύεται μετὰ τῆς Θέτιδος περὶ τοῦ Τρωϊκοῦ πολέμου·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.2",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.2",
    "language": "grc",
    "text": "παραγενομένη δὲ Ἔρις εὐωχουμένων τῶν θεῶν ἐν τοῖς Πηλέως γάμοις νεῖκος περὶ κάλλους ἐνίστησιν, Ἀθηνᾷ· Ἥρᾳ· καὶ Ἀφροδίτῃ· αἳ πρὸς Ἀλέξανδρον ἐν Ἴ̈δῃ κατὰ Διὸς προσταγὴν ὑφ' Ἑρμοῦ πρὸς τὴν κρίσιν ἄγονται· καὶ προκρίνει τὴν Ἀφροδίτην ἐπαρθεὶς τοῖς Ἑλένης γάμοις Ἀλέξανδρος·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.3",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.3",
    "language": "grc",
    "text": "ἔπειτα δὲ Ἀφροδίτης ὑ̈ποθεμένης, ναυπηγεῖται· καὶ Ἕλενος περὶ τῶν μελλόντων αὐτοῖς προθεσπίζει· καὶ ἡ Ἀφροδίτη Αἰνείαν συμπλεῖν αὐτῶ κελεύει· καὶ Κασσάνδρα περὶ τῶν μελλόντων προδηλοῖ·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.4",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.4",
    "language": "grc",
    "text": "ἐπιβὰς δὲ τῇ Λακεδαιμονίᾳ Ἀλέξανδρος, ξενίζεται παρὰ τοῖς Τυνδαρίδαις· καὶ μετα ταῦτ ταῦτα ἐν τῇ Σπάρτῃ παρὰ Μενελάῳ καὶ Ἑλένῃ παρὰ τὴν εὐωχίαν δίδωσι δῶρα ὁ Ἀλέξανδρος· καὶ μετα ταῦτ ταῦτα Μενέλαος εἰς Κρήτην ἐκπλεῖ· κελεύσας τὴν Ἑλένην τοῖς ξένοις τὰ ἐπιτήδεια παρέχειν ἕως ἂν ἀπαλλαγῶσιν· ἐν τούτῳ δὲ Ἀφροδίτη συνάγει τὴν Ἑλένην τῶ Ἀλεξάνδρῳ· καὶ μετὰ τὴν μίξιν τὰ πλεῖστα κτήματα ἐνθέμενοι, νυκτὸς ἀποπλέουσι·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.5",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.5",
    "language": "grc",
    "text": "χειμῶνα δὲ αὐτοῖς ἐφίστησιν Ἥρα· καὶ προσενεχθεὶς Σιδῶνι ὁ Ἀλέξανδρος, αἴρει τὴν πόλιν· καὶ ἀποπλεύσας εἰς Ἴ̈λιον, γάμους τῆς Ἑλένης ἐπετέλεσεν·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.6",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.6",
    "language": "grc",
    "text": "ἐν τούτῳ δὲ Κάστωρ μετὰ Πολυδεύκους. τὰς Ἴ̈δα καὶ Λϋγέως βοῦς ὑ̈φαιρούμενοι ἐφωράθησαν· καὶ Κάστωρ μὲν ὑπὸ τοῦ Ἴ̈δα ἀναιρεῖται· Λυγεὺς δὲ καὶ Ἴ̈δας ὑπὸ Πολυδεύκους· καὶ Ζεὺς αὐτοῖς ἑτερήμερον νέμει τὴν ἀθανασίαν·",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.7",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.7",
    "language": "grc",
    "text": "καὶ μετα ταῦτα Ἶ̈ρις ἀγγέλλει τῷ Μενελάω τὰ γεγονότα κτὰ κατὰ τὸν οἶκον· ὁ δὲ παραγενόμενος, περὶ τῆς ἐπ' Ἴλιον στρατείας βουλεύεται μετὰ τοῦ ἀδελφοῦ καὶ πρὸς Νέστορα παραγίνεται Μενέλαος·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.8",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.8",
    "language": "grc",
    "text": "Νέστωρ δὲ ἐν παρεκβάσει διηγεῖται αὐτῶ ὡς Ἐπωπεὺς φθείρας τὴν Λύκουργου θυγατέρα, ἐξεπορθήθη· καὶ τὰ περὶ Οἰδίπουν καὶ τὴν Ἡρακλέους μανίαν καὶ τὰ περὶ Θησέα καὶ Ἀριάδνην·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.9",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.9",
    "language": "grc",
    "text": "ἔπειτα τοὺς ἡγεμόνας ἀθροίζουσϊν ἐπελθόντε̈ς τὴν Ἑλλάδα· καὶ μαίνεσθαι προσποιησάμενον τὸν Ὀδϋσσέα ἐπὶ τῶ μὴ θέλειν συνστρατεύεσθαι ἐφώρασαν· Παλαμήδους ὑ̈ποθεμένου τὸν υἱὸν Τηλέμαχον ἐπὶ κόλασιν ἐξαρπάσαντες·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.10",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.10",
    "language": "grc",
    "text": "καὶ μετα ταῦτα συνελθόντες εἰς Αὐλίδα θύουσι· καὶ τὰ περὶ τὸν δράκοντα καὶ τοὺς στρουθοὺς γενόμενα δείκνυται· καὶ Κάλχας περὶ τῶν ἀποβησομένων προλέγει αὐτοῖς.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.11",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.11",
    "language": "grc",
    "text": "ἔπειτα ἀναχθέντες Τευθρανία προσίσχουσι· καὶ ταύτην ὡς Ἴ̈λιον ἐπόρθουν· Τήλεφος δὲ ἐκβοηθείας Θέρσανδρόν τε τὸν Πολυνείκους κτείνει· καὶ αὐτὸς ὑπὸ Ἀχϊλλέως τιτρώσκεται·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.12",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.12",
    "language": "grc",
    "text": "ἀποπλέουσι δὲ αὐτοῖς ἐκ τῆς Μϋσίας χειμὼν ἐπιπίπτει καὶ διασκεδάννυνται· Ἀχϊλλεὺς δὲ Σκύρῶ προσσχὼν γαμεῖ τὴν Λυκομήδους θυγατέρα Δηϊδάμειαν·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.13",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.13",
    "language": "grc",
    "text": "ἔπειτα Τήλεφον κτὰ κατὰ μαντείαν παραγενόμενον εἰς Ἄργος ἰ̈ᾶται Ἀχϊλλεὺς ὡς ἡγεμόνα γενησόμενον τοῦτ’ ἐπ' Ἴλιον πλοῦ,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.14",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.14",
    "language": "grc",
    "text": "καὶ τὸ δεύτερον ἠθροισμένου τοῦ στόλου ἐν Αὐλίδι· Ἀγαμέμνων ἐπὶ θήρας βαλὼν ἔλαφον, ὑπερβάλλειν ἔφησε καὶ τὴν Ἄρτεμιν. μῃνίσασα δὲ ἡ θεὸς, ἐπέσχεν αὐτοὺς τοῦ πλοῦ, χειμῶνας ἐπιπέμπουσα· Κάλχαντος δὲ εἰπόντος τὴν τῆς θεοῦ μῆνιν καὶ Ἰφιγένειαν κελεύσαντος θύειν τῇ Ἀρτέμιδι, ὡς ἐπὶ γάμον αὐτὴ Ἀχϊλλεῖ μεταπεμψάμενοι, θύειν ἐπιχειροῦσιν· Ἄρτεμις δὲ αὐτὴν ἐξαρπάσασα, εἰς Ταύρους μετακομίζει· καὶ ἀθάνατον ποιεῖ· ἔλαφον δὲ ἀντὶ τῆς κόρης παρίστησι τῷ βωμῷ·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.15",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.15",
    "language": "grc",
    "text": "ἔπειτα, κταπλέουσιν καταπλέουσιν εἰς Τένεδον· καὶ εὐωχουμένων αὐτῶν Φιλοκτήτης ὑ̈φ' ὕδρου πληγεὶς διὰ τὴν δυσοσμίαν ἐν Λήμνῳ κτελείφθη κατελείφθη · καὶ Ἀχϊλλεὺς ὕ̈στερος κληθεὶς διαφέρεται πρὸς Ἀγαμέμνονα·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.16",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.16",
    "language": "grc",
    "text": "ἔπειτα ἀποβαίνοντας αὐτοὺς εἰς Ἴ̈λιον, εἴργουσιν οἱ Τρῶες· καὶ θνῄσκει Πρωτεσίλαος ὑφ' Ἕκτορος· ἔπειτα Ἀχϊλλεὺς αὐτοὺς τρέπεται· ἀνελῶν Κύκνον τὸν Ποσειδῶνος· καὶ τοὺς νεκροὺς ἀναιροῦνται",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.17",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.17",
    "language": "grc",
    "text": "καὶ διαπρεσβεύονται πρὸς τοὺς Τρῶας· τὴν Ἑλένην καὶ τὰ κτήματα ἀπαιτοῦντες· ὡς δὲ οὐχ’ ὑπήκουσαν ἐκεῖνοι, ἐνταῦθα δὴ τειχομαχοῦσιν·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.18",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.18",
    "language": "grc",
    "text": "ἔπειτα τὴν χώραν ἐσπεξελθόντες, πορθοῦσι καὶ τὰς περιοίκους πόλεις·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.19",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.19",
    "language": "grc",
    "text": "καὶ μετα ταῦτα Ἀχϊλλεὺς Ἑλένην ἐπιθυμεῖ θεάσασθαι· καὶ συνήγαγεν αὐτοὺς εἰς τό τὸ αὐτὸ Ἀφροδίτη καὶ Θέτις·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.20",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.20",
    "language": "grc",
    "text": "εἶτα ἀπονοστεῖν ὡρμημένους τοὺς Ἀχαιοὺς Ἀχϊλλεὺς κτέχει κατέχει · κἄπειτα ἀπελαύνει τὰς Αἰνείου βόας· καὶ Λυρνησσὸν καὶ Πήδασον ποθεῖ· καὶ συχνὰς τῶν περιοικίδων πόλεων· καὶ Τρωΐλον φονεύει·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.21",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.21",
    "language": "grc",
    "text": "Λυκάονά τε Πάτροκλος εἰς Λῆμνον ἀγαγὼν, ἀπεμπολᾷ·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.22",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.22",
    "language": "grc",
    "text": "καὶ ἐκ τῶν λαφύρων Ἀχϊλλεὺς μὲν Βρισηΐδα γέρας λαμβάνει· Χρϋσηΐδα δὲ Ἀγαμέμνων·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.23",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.23",
    "language": "grc",
    "text": "ἔπειτά ἐστὶ Παλαμήδους θάνατος,",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg4036/tlg023/cypria-grc1#tlg4036.tlg023.1.24",
    "work_id": "perseus/tlg4036/tlg023/cypria-grc1",
    "canonical_ref": "tlg4036.tlg023.1.24",
    "language": "grc",
    "text": "καὶ Διὸς βουλὴ ὅπως ἐπικουφίσῃ τοὺς Τρῶας Ἀχϊλλέα τῆς συμμαχίας τῆς Ἑλληνικῆς ἀποστήσας·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
