    "canonical_ref": "tlg0062.tlg032.10.4",
    "language": "grc",
    "text": "ἰδού σοι ἡ κόρυς αὕτη ἀφῄρηται.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.10.5",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.10.5",
    "language": "grc",
    "text": "ἰδοὺ καί σοι ὁ κεστός.",
    "chunk_index": 47,
    "context_before": null,
