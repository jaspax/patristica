[
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.1",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.1",
    "language": "grc",
    "text": "Ἑρμῆ, λαβὼν τουτὶ τὸ μῆλον ἄπιθι εἰς τὴν Φρυγίαν παρὰ τὸν Πριάμου παῖδα τὸν βουκόλον — νέμει δὲ τῆς Ἴδης ἐν τῷ Γαργάρῳ — καὶ λέγε πρὸς αὐτόν, ὅτι σέ, ὦ Πάρι, κελεύει ὁ Ζεύς, ἐπειδὴ καλός τε αὐτὸς εἶ καὶ σοφὸς τὰ ἐρωτικά, δικάσαι ταῖς θεαῖς, ἥτις αὐτῶν ἡ καλλίστη ἐστίν· τοῦ δὲ ἀγῶνος τὸ ἆθλον ἡ νικῶσα λαβέτω τὸ μῆλον. ὥρα δὲ ἤδη καὶ ὑμῖν αὐταῖς ἀπιέναι παρὰ τὸν δικαστήν· ἐγὼ γὰρ ἀπωθοῦμαι τὴν δίαιταν ἐπʼ ἴσης τε ὑμᾶς ἀγαπῶν, καὶ εἴ γε οἷόν τε ἦν, ἡδέως ἂν ἁπάσας νενικηκυίας ἰδών. ἄλλως τε καὶ ἀνάγκη, μιᾷ τὸ καλλιστεῖον ἀποδόντα πάντως ἀπεχθάνεσθαι ταῖς πλείοσιν. διὰ ταῦτα αὐτὸς μὲναὐτὸς μὲν Fritzsche: μὲν αὐτὸς γβ. οὐκ ἐπιτήδειος ὑμῖν δικαστής, ὁ δὲ νεανίας οὗτος ὁ Φρὺξ ἐφʼ ὃν ἄπιτε βασιλικὸς μέν ἐστι καὶ Γανυμήδους τουτουὶ συγγενής, τὰ ἄλλα δὲ ἀφελὴς καὶ ὄρειος, κοὐκ ἄν τις αὐτὸν ἀπαξιώσειε τοιαύτης θέας.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.2",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.2",
    "language": "grc",
    "text": "ἐγὼ μέν, ὦ Ζεῦ, εἰ καὶ τὸν Μῶμον αὐτὸν ἐπιστήσειας ἡμῖν δικαστήν, θαρροῦσα βαδιοῦμαι πρὸς τὴν ἐπίδειξιν· τί γὰρ ἂν καὶ μωμήσαιτό μου; χρὴ δὲ καὶ ταύταις ἀρέσκειν τὸν ἄνθρωπον.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.2.1",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.2.1",
    "language": "grc",
    "text": "οὐδʼ ἡμεῖς, ὦ Ἀφροδίτη, δέδιμεν, οὐδʼ ἂν ὁ Ἄρης ὁ σὸς ἐπιτραπῇ τὴν δίαιταν· ἀλλὰ δεχόμεθα καὶ τοῦτον, ὅστις ἂν ᾖ, τὸν Πάριν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.2.2",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.2.2",
    "language": "grc",
    "text": "ἦ καὶ σοὶ ταῦτα, ὦ θύγατερ, συνδοκεῖ; τί φής; ἀποστρέφῃ καὶ ἐρυθριᾷς; ἔστι μὲν ἴδιον τὸ αἰδεῖσθαι τὰ τοιαῦτα ὑμῶν τῶν παρθένων· ἐπινεύεις δʼ ὅμως. ἄπιτε οὖν καὶ μὴ χαλεπήνητε τῷ δικαστῇ αἱ νενικημέναι μηδὲ κακὸν ἐντρίψησθε τῷ νεανίσκῳ· οὐ γὰρ οἷόν τε ἐπʼ ἴσης πάσας εἶναι καλάς.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.3",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.3",
    "language": "grc",
    "text": "προΐωμεν εὐθὺ τῆς Φρυγίας, ἐγὼ μὲν ἡγούμενος, ὑμεῖς δὲ μὴ βραδέως ἀκολουθεῖτέ μοι καὶ θαρρεῖτε. οἶδα ἐγὼ τὸν Πάριν. νεανίας ἐστὶ καλὸς καὶ τἄλλα ἐρωτικὸς καὶ τὰ τοιαῦτα κρίνειν ἱκανώτατος. οὐκ ἂν ἐκεῖνος δικάσειεν κακῶς.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.3.1",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.3.1",
    "language": "grc",
    "text": "τοῦτο μὲν ἅπαν ἀγαθὸν καὶ πρὸς ἐμοῦ λέγεις, τὸ δίκαιον ἡμῖν εἶναι τὸν δικαστήν· πότερα δὲ ἄγαμός ἐστιν οὗτος ἢ καὶ γυνή τις αὐτῷ σύνεστιν;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.3.2",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.3.2",
    "language": "grc",
    "text": "οὐ παντελῶς ἄγαμος, ὦ Ἀφροδίτη.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.3.3",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.3.3",
    "language": "grc",
    "text": "πῶς λέγεις;",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.3.4",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.3.4",
    "language": "grc",
    "text": "δοκεῖ τις αὐτῷ συνοικεῖν Ἰδαία γυνή, ἱκανὴ μέν, ἀγροῖκος δὲ καὶ δεινῶς ὄρειος, ἀλλʼ οὐ σφόδρα προσέχειν αὐτῇ ἔοικε. τίνος δʼ οὖν ἕνεκα ταῦτα ἐρωτᾷς;",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.3.5",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.3.5",
    "language": "grc",
    "text": "ἄλλως ἠρόμην.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4",
    "language": "grc",
    "text": "παραπρεσβεύεις, ὦ οὗτος, ἰδίᾳ πάλαι ταύτῃ κοινολογούμενος.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.1",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.1",
    "language": "grc",
    "text": "οὐδέν, ὦ Ἀθηνᾶ, δεινὸν οὐδὲ καθʼ ὑμῶν, ἀλλʼ ἤρετό με εἰ ἄγαμος ὁ Πάρις ἐστίν.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.2",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.2",
    "language": "grc",
    "text": "ὡς δὴ τί τοῦτο πολυπραγμονοῦσα;",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.3",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.3",
    "language": "grc",
    "text": "οὐκ οἶδα· φησὶ δʼ οὖν ὅτι ἄλλως ἐπελθόν, οὐκ ἐξεπίτηδες ἤρετο.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.4",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.4",
    "language": "grc",
    "text": "τί οὖν; ἄγαμός ἐστιν;",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.5",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.5",
    "language": "grc",
    "text": "οὐ δοκεῖ.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.6",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.6",
    "language": "grc",
    "text": "τί δέ; τῶν πολεμικῶν ἐστιν αὐτῷ ἐπιθυμία καὶ φιλόδοξός τις, ἢ τὸ πᾶν βουκόλος;",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.7",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.7",
    "language": "grc",
    "text": "τὸ μὲν ἀληθὲς οὐκ ἔχω εἰπεῖν, εἰκάζειν δὲ χρὴ νέον ὄντα καὶ τούτων ὀρέγεσθαι τυχεῖν καὶ βούλεσθαι ἂν πρῶτον αὐτὸν εἶναι κατὰ τὰς μάχας.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.8",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.8",
    "language": "grc",
    "text": "ὁρᾷς, οὐδὲν ἐγὼ μέμφομαι οὐδὲ ἐγκαλῶ σοι τὸ πρὸς ταύτην ἰδίᾳ λαλεῖν· μεμψιμοίρων γὰρ καὶ οὐκ Ἀφροδίτης τὰ τοιαῦτα.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.4.9",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.4.9",
    "language": "grc",
    "text": "καὶ αὕτη σχεδὸν τὰ αὐτά με ἤρετο· διὸ μὴ χαλεπῶς ἔχε μηδʼ οἴου μειονεκτεῖν, εἴ τι καὶ ταύτῃ κατὰ τὸ ἁπλοῦν ἀπεκρινάμην.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5",
    "language": "grc",
    "text": "ἀλλὰ μεταξὺ λόγων ἤδη πολὺ προϊόντες ἀπεσπάσαμεν τῶν ἀστέρων καὶ σχεδόν γε κατὰ τὴν Φρυγίαν ἐσμέν. ἐγὼ δὲ καὶ τὴν Ἴδην ὁρῶ καὶ τὸ Γάργαρον ὅλον ἀκριβῶς, εἰ δὲ μὴ ἐξαπατῶμαι, καὶ αὐτὸν ὑμῶν τὸν δικαστὴν τὸν Πάριν.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.1",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.1",
    "language": "grc",
    "text": "ποῦ δέ ἐστιν; οὐ γὰρ κἀμοὶ φαίνεται.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.2",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.2",
    "language": "grc",
    "text": "ταύτῃ, ὦ Ἥρα, πρὸς τὰ λαιὰ περισκόπει, μὴ πρὸς ἄκρῳ τῷ ὄρει, παρὰ δὲ τὴν πλευράν, οὗ τὸ ἄντρον, ἔνθα καὶ τὴν ἀγέλην ὁρᾷς.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.3",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.3",
    "language": "grc",
    "text": "ἀλλʼ οὐχ ὁρῶ τὴν ἀγέλην.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.4",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.4",
    "language": "grc",
    "text": "πῶς φής; οὐχ ὁρᾷς βοίδια κατὰ τὸν ἐμὸν οὑτωσὶ δάκτυλον ἐκ μέσων τῶν πετρῶν προερχόμενα καί τινα ἐκ τοῦ σκοπέλου καταθέοντα καλαύροπα ἔχοντα καὶ ἀνείργοντα μὴ πρόσω διασκίδνασθαι τὴν ἀγέλην;",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.5",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.5",
    "language": "grc",
    "text": "ὁρῶ νῦν, εἴ γε ἐκεῖνός ἐστιν.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.6",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.6",
    "language": "grc",
    "text": "ἀλλὰ ἐκεῖνος. ἐπειδὴ δὲ πλησίον ἤδη ἐσμέν, ἐπὶ τῆς γῆς, εἰ δοκεῖ, καταστάντες βαδίζωμεν, ἵνα μὴ διαταράξωμεν αὐτὸν ἄνωθεν ἐξ ἀφανοῦς καθιπτάμενοι.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.5.7",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.7",
    "language": "grc",
    "text": "εὖ λέγεις, καὶ οὕτω ποιῶμεν. ἐπεὶ δὲ καταβεβήκαμεν, ὥρα σοι, ὦ Ἀφροδίτη, προϊέναι καὶ ἡγεῖσθαι ἡμῖν τῆς ὁδοῦ· σὺ γὰρ ὡς τὸ εἰκὸς ἔμπειρος εἶ τοῦ χωρίου πολλάκις, ὡς λόγος, κατελθοῦσα πρὸς Ἀγχίσην.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
