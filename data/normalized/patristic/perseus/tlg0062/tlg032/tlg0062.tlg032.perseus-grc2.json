    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.5.8",
    "language": "grc",
    "text": "οὐ σφόδρα, ὦ Ἥρα, τούτοις ἄχθομαι τοῖς σκώμμασιν.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
