    "canonical_ref": "tlg0062.tlg032.9.4",
    "language": "grc",
    "text": "ὅπη καὶ θέλω; γυμνὰς ἰδεῖν βούλομαι.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
