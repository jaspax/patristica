    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.9.1",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.9.1",
    "language": "grc",
    "text": "οὕτω φασὶ ποιήσειν· ὥρα δέ σοι ἤδη περαίνειν τὴν κρίσιν.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.9.2",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.9.2",
    "language": "grc",
    "text": "πειρασόμεθα· τί γὰρ ἂν καὶ πάθοι τις; ἐκεῖνο δὲ πρότερον εἰδέναι βούλομαι, πότερʼ ἐξαρκέσει σκοπεῖν αὐτὰς ὡς ἔχουσιν, ἢ καὶ ἀποδῦσαι δεήσει πρὸς τὸ ἀκριβὲς τῆς ἐξετάσεως;",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0062/tlg032/perseus-grc2#tlg0062.tlg032.9.3",
    "work_id": "perseus/tlg0062/tlg032/perseus-grc2",
    "canonical_ref": "tlg0062.tlg032.9.3",
    "language": "grc",
    "text": "τοῦτο μὲν σὸν ἂν εἴη τοῦ δικαστοῦ, καὶ πρόσταττε ὅπη καὶ θέλεις.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
