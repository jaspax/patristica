[
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.1",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.1",
    "language": "grc",
    "text": "πολλῶν τοίνυν τοῖς ἀνδράσιν ὑπαρξάντων καλῶν, ἐν τοῖς πρώτοις δὲ τοῦ μεγίστους ἐλαχίσταις ἀφορμαῖς γενέσθαι, τοῦτο τῷ Δίωνι κάλλιστόν ἐστιν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.2",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.2",
    "language": "grc",
    "text": "οὐ γὰρ εἶχε τὸν ἀμφισβητοῦντα, καθάπερ ὁ Βροῦτος Κάσσιον, ἄνδρα πρὸς μὲν ἀρετὴν καὶ δόξαν οὐχ ὁμοίως ἀξιόπιστον, εἰς δὲ τὸν πόλεμον οὐκ ἐλάττονας τόλμῃ καὶ δεινότητι καὶ πράξει συμβολὰς παρασχόμενον,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.3",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.3",
    "language": "grc",
    "text": "ᾧ γε καὶ τοῦ παντὸς ἔργου προσποιοῦσιν ἔνιοι τὴν ἀρχήν, ἡγεμόνα τῆς ἐπὶ Καίσαρα γνώμης τοῦτον ἀτρεμοῦντι Βρούτῳ γενέσθαι λέγοντες.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.4",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.4",
    "language": "grc",
    "text": "Δίων δʼ ὥσπερ ὅπλα καὶ πλοῖα καὶ στρατιωτικὴν δύναμιν, οὕτω καὶ φίλους καὶ συνεργοὺς ἐπὶ τὴν πρᾶξιν αὐτὸς ἑαυτῷ φαίνεται κτησάμενος.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.5",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.5",
    "language": "grc",
    "text": "οὐ μὴν οὐδʼ ὡς Βροῦτος ἐκ τῶν πραγμάτων αὑτῶν καὶ τοῦ πολέμου πλοῦτον ἔσχε καὶ δύναμιν, οὕτω καὶ Δίων, ἀλλὰ τῷ πολέμῳ προεισήνεγκεν αὐτὸς τὸν ἑαυτοῦ πλοῦτον, ὑπὲρ τῆς τῶν πολιτῶν ἐλευθερίας τοῖς τῆς φυγῆς ἐφοδίοις προκαταχρησάμενος.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.6",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.6",
    "language": "grc",
    "text": "ἔτι δὲ Βροῦτος μὲν καὶ Κάσσιος, οὐκ ὂν ἀσφαλὲς ἡσυχίαν ἄγειν ἐκπεσοῦσι τῆς Ῥώμης, ἀλλʼ ὠφληκόσι δίκην θανάτου καὶ διωκομένοις, ἀναγκαίως εἰς τὸν πόλεμον κατέφυγον καὶ τὰ σώματα τοῖς ὅπλοις παρακαταθέμενοι διεκινδύνευσαν ὑπὲρ αὑτῶν τὸ πλέον ἢ τῶν πολιτῶν,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.1.7",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.1.7",
    "language": "grc",
    "text": "Δίων δʼ ἀδεέστερον ἐν τῇ φυγῇ τοῦ φυγαδεύσαντος τυράννου καὶ ἥδιον διάγων ἀνέρριψεν ἑκὼν κίνδυνον τοσοῦτον ἐπὶ τῷ σῶσαι Σικελίαν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.2.1",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.2.1",
    "language": "grc",
    "text": "καὶ μὴν οὐχ ὅμοιον Διονυσίου Συρακουσίοις ἡ Καίσαρος ἀπαλλαγῆναι Ῥωμαίοις. ὁ μὲν γὰρ οὐδʼ ἠρνεῖτο τύραννος εἶναι κακῶν τε μυρίων ἐμπεπλήκει Σικελίαν·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.2.2",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.2.2",
    "language": "grc",
    "text": "ἡ δὲ Καίσαρος ἀρχὴ συνισταμένη μὲν οὐκ ὀλίγα τοῖς ἐναντιουμένοις πράγματα παρέσχε, δεξαμένοις δὲ καὶ κρατηθεῖσιν ὄνομα καὶ δόκησις ἐφάνη μόνον, ἔργον δʼ ἀπʼ αὐτῆς οὐδὲν ὠμὸν οὐδὲ τυραννικὸν ὑπῆρξεν, ἀλλὰ καὶ δεομένοις ἔδοξε τοῖς πράγμασι μοναρχίας πρᾳότατος ὥσπερ ἰατρὸς ὑπʼ αὐτοῦ τοῦ δαίμονος δεδόσθαι.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.2.3",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.2.3",
    "language": "grc",
    "text": "διὸ Καίσαρα μὲν εὐθὺς ἐπόθησεν ὁ Ῥωμαίων δῆμος, ὥστε χαλεπὸς γενέσθαι καὶ ἀπαραίτητος τοῖς ἀπεκτονόσι, Δίωνα δʼ ἡ Διονυσίου πάρεσις ἐκ Συρακουσῶν καὶ τὸ μὴ κατασκάψαι τοῦ προτέρου τυράννου τὸν τάφον ἐπαίτιον μάλιστα πρὸς τοὺς πολίτας ἐποίησεν.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.1",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.1",
    "language": "grc",
    "text": "ἐν αὐταῖς τοίνυν ταῖς πολεμικαῖς πράξεσιν ὁ μὲν Δίων ἄμεμπτος γέγονε στρατηγός, ὡς μὲν αὐτὸς ἐβουλεύετο τοῖς πράγμασιν ἄριστα χρώμενος, ἃ δʼ ἐπταίσθη διʼ ἑτέρους ἀναλαβὼν καὶ μεταστήσας ἐπὶ τὸ βέλτιον·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.2",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.2",
    "language": "grc",
    "text": "ὁ δὲ Βροῦτος τὸν ἔσχατον ἀγῶνα ὑπὲρ τῶν ὅλων οὔθʼ ὑποστῆναι δοκεῖ φρονίμως οὔτε σφαλεὶς ἐπανόρθωσιν εὑρεῖν, ἀλλʼ ἀπεῖπε καὶ προεῖτο τὰς ἐλπίδας, οὐδʼ ὅσον Πομπήϊος ἐπιτολμήσας τῇ τύχῃ·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.3",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.3",
    "language": "grc",
    "text": "καὶ ταῦτα πολλῆς μὲν αὐτόθι λειπομένης ἐλπίδος ἐν τοῖς ὅπλοις, ταῖς δὲ ναυσὶ κρατῶν πάσης βεβαίως τῆς θαλάσσης.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.4",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.4",
    "language": "grc",
    "text": "ὃ δὲ μέγιστόν ἐστιν ὧν ἐγκαλοῦσι Βρούτῳ, τὸ σωθέντα τῇ Καίσαρος χάριτι καὶ σώσαντα τῶν συνεαλωκότων ὅσους ἐβούλετο καὶ φίλον νομιζόμενον καὶ προτιμηθέντα πολλῶν αὐτόχειρα τοῦ σώσαντος γενέσθαι, τοῦτʼ οὐκ ἄν τις εἴποι κατὰ Δίωνος.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.5",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.5",
    "language": "grc",
    "text": "ἀλλὰ τοὐναντίον, οἰκεῖος μὲν ὢν Διονυσίῳ καὶ φίλος ὤρθου τὰ πράγματα καὶ συνδιεφύλαττεν, ἐκπεσὼν δὲ τῆς πατρίδος καὶ ἀδικηθεὶς περὶ τὴν γυναῖκα καὶ τὴν οὐσίαν ἀπολέσας ἐκ προφανοῦς εἰς πόλεμον κατέστη νόμιμον καὶ δίκαιον. ἢ τοῦτʼ ἀντιστρέφει πρῶτον;",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.6",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.6",
    "language": "grc",
    "text": "ὃ γὰρ εἰς ἔπαινον ὑπάρχει τοῖς ἀνδράσι μέγιστον, ἡ πρὸς τοὺς τυράννους ἀπέχθεια καὶ μισοπονηρία, τοῦτʼ εἰλικρινές ἐστι τῷ Βρούτῳ καὶ καθαρόν, ἰδίᾳ γὰρ οὐδὲν ἐγκαλῶν Καίσαρι τῆς κοινῆς προεκινδύνευεν ἐλευθερίας·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.7",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.7",
    "language": "grc",
    "text": "ὁ δʼ εἰ μὴ κακῶς ἔπαθεν αὐτός, οὐκ ἂν ἐπολέμησε, καὶ τοῦτο δηλοῦται ταῖς Πλάτωνος ἐπιστολαῖς, ἐξ ὧν δῆλός ἐστιν ὡς ἀποβληθεὶς τῆς τυραννίδος, οὐκ ἀποστάς, κατέλυσε Διονύσιον.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.8",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.8",
    "language": "grc",
    "text": "ἔτι Βροῦτον μὲν καὶ Πομπηΐῳ φίλον ἐποίησεν, ἐχθρὸν ὄντα, καὶ πολέμιον Καίσαρι, τὸ κοινῇ συμφέρον, ὡς ἔχθρας ὅρῳ καὶ φιλίας ἑνὶ χρώμενον τῷ δικαίῳ·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.9",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.9",
    "language": "grc",
    "text": "Δίων δὲ πρὸς χάριν ὤρθου πολλὰ Διονύσιον, ὅτʼ ἦν βέβαιος αὑτῷ, καὶ πρὸς ὀργὴν ἀπιστηθεὶς ἐπολέμησε.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.10",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.10",
    "language": "grc",
    "text": "διὸ τούτῳ μὲν οὐδʼ οἱ φίλοι πάντες ἐπίστευσαν, ὡς μεταστήσας Διονύσιον οὐκ ἂν βεβαιώσαιτο τὴν ἀρχὴν αὑτῷ, πρᾳοτέρῳ τυραννίδος ὀνόματι παραγαγὼν τοὺς πολίτας,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.3.11",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.3.11",
    "language": "grc",
    "text": "περὶ δὲ τοῦ Βρούτου τῶν ἐχθρῶν ἦν ἀκούειν ὅτι μόνος τῶν ἐπὶ Καίσαρα συναραμένων ἕνα προὔθετο σκοπὸν ἀπʼ ἀρχῆς ἄχρι τέλους τὴν πάτριον ἀποδοῦναι Ῥωμαίοις πολιτείαν.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.4.1",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.4.1",
    "language": "grc",
    "text": "ἄνευ γε μὴν τούτων ὁ πρὸς Διονύσιον ἀγὼν οὐχ ὅμοιος ἦν δήπου τῷ πρὸς Καίσαρα.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.4.2",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.4.2",
    "language": "grc",
    "text": "Διονυσίου μὲν γὰρ οὐδεὶς ὅστις οὐκ ἂν κατεφρόνησε τῶν συνήθων ἐν μέθαις καὶ κύβοις καὶ γυναιξὶ τὰς πλείστας ποιουμένου διατριβάς·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.4.3",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.4.3",
    "language": "grc",
    "text": "τὸ δὲ τὴν Καίσαρος κατάλυσιν εἰς νοῦν ἐμβαλέσθαι καὶ μὴ φοβηθῆναι τὴν δεινότητα καὶ δύναμιν καὶ τύχην, οὗ καὶ τοὔνομα τοὺς Παρθυαίων καὶ Ἰνδῶν βασιλεῖς οὐκ εἴα καθεύδειν, ὑπερφυοῦς ἦν ψυχῆς καὶ πρὸς μηθὲν ὑφίεσθαι φόβῳ τοῦ φρονήματος δυναμένης.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0007/tlg062/perseus-grc2#tlg0007.tlg062.4.4",
    "work_id": "perseus/tlg0007/tlg062/perseus-grc2",
    "canonical_ref": "tlg0007.tlg062.4.4",
    "language": "grc",
    "text": "διὸ τῷ μὲν ὀφθέντι μόνον ἐν Σικελίᾳ μυριάδες οὐκ ὀλίγαι συνέστησαν ἐπὶ Διονύσιον· ἡ δὲ Καίσαρος δόξα καὶ πεσόντος ὤρθου τοὺς φίλους, καὶ τοὔνομα τὸν χρησάμενον ἦρεν ἐκ παιδὸς ἀμηχάνου πρῶτον εὐθὺς εἶναι Ῥωμαίων, ὡς ἀλεξιφάρμακον τοῦτο πρὸς τὴν Ἀντωνίου περιαψάμενον ἔχθραν καὶ δύναμιν.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
