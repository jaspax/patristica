[
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.1",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.1",
    "language": "grc",
    "text": "ΠΑΥΛΟΣ ΚΑΙ ΣΙΛΟΥΑΝΟΣ ΚΑΙ ΤΙΜΟΘΕΟΣ τῇ ἐκκλησίᾳ Θεσσαλονικέων ἐν θεῷ πατρὶ ἡμῶν καὶ κυρίῳ Ἰησοῦ",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.2",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.2",
    "language": "grc",
    "text": "Χριστῷ· χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς καὶ κυρίου Ἰησοῦ Χριστοῦ.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.3",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.3",
    "language": "grc",
    "text": "Εὐχαριστεῖν ὀφείλομεν τῷ θεῷ πάντοτε περὶ ὑμῶν, ἀδελφοί, καθὼς ἄξιόν ἐστιν, ὅτι ὑπεραυξάνει ἡ πίστις ὑμῶν καὶ πλεονάζει ἡ ἀγάπη ἑνὸς ἑκάστου πάντων ὑμῶν εἰς ἀλλήλους,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.4",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.4",
    "language": "grc",
    "text": "ὥστε αὐτοὺς ἡμᾶς ἐν ὑμῖν ἐνκαυχᾶσθαι ἐν ταῖς ἐκκλησίαις τοῦ θεοῦ ὑπὲρ τῆς ὑπομονῆς ὑμῶν καὶ πίστεως ἐν πᾶσιν τοῖς διωγμοῖς ὑμῶν καὶ ταῖς θλίψεσιν αἷς ἀνέχεσθε,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.5",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.5",
    "language": "grc",
    "text": "ἔνδειγμα τῆς δικαίας κρίσεως τοῦ θεοῦ, εἰς τὸ καταξιωθῆναι ὑμᾶς τῆς βασιλείας τοῦ θεοῦ, ὑπὲρ ἧς καὶ πάσχετε,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.6",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.6",
    "language": "grc",
    "text": "εἴπερ δίκαιον παρὰ θεῷ ἀνταποδοῦναι τοῖς θλίβουσιν ὑμᾶς θλίψιν",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.7",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.7",
    "language": "grc",
    "text": "καὶ ὑμῖν τοῖς θλιβομένοις ἄνεσιν μεθʼ ἡμῶν ἐν τῇ ἀποκαλύψει τοῦ κυρίου Ἰησοῦ ἀπʼ οὐρανοῦ μετʼ ἀγγέλων δυνάμεως αὐτοῦ",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.8",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.8",
    "language": "grc",
    "text": "ἐν πυρὶ φλογός, διδόντος ἐκδίκησιν τοῖς μὴ εἰδόσι θεὸν καὶ τοῖς μὴ ὑπακούουσιν τῷ εὐαγγελίῳ τοῦ κυρίου ἡμῶν Ἰησοῦ,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.9",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.9",
    "language": "grc",
    "text": "οἵτινες δίκην τίσουσιν ὄλεθρον αἰώνιον ἀπὸ προσώπου τοῦ κυρίου καὶ ἀπὸ τῆς δόξης τῆς ἰσχύος αὐτοῦ,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.10",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.10",
    "language": "grc",
    "text": "ὅταν ἔλθῃ ἐνδοξασθῆναι ἐν τοῖς ἁγίοις αὐτοῦ καὶ θαυμασθῆναι ἐν πᾶσιν τοῖς πιστεύσασιν, ὅτι ἐπιστεύθη τὸ μαρτύριον ἡμῶν ἐφʼ ὑμᾶς, ἐν τῇ ἡμέρᾳ ἐκείνῃ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.11",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.11",
    "language": "grc",
    "text": "Εἰς ὃ καὶ προσευχόμεθα πάντοτε περὶ ὑμῶν, ἵνα ὑμᾶς ἀξιώσῃ τῆς κλήσεως ὁ θεὸς ἡμῶν καὶ πληρώσῃ πᾶσαν εὐδοκίαν ἀγαθωσύνης καὶ ἔργον πίστεως ἐν δυνάμει,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.1.12",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.1.12",
    "language": "grc",
    "text": "ὅπως ἐνδοξασθῇ τὸ ὄνομα τοῦ κυρίου ἡμῶν Ἰησοῦ ἐν ὑμῖν, καὶ ὑμεῖς ἐν αὐτῷ, κατὰ τὴν χάριν τοῦ θεοῦ ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.1",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.1",
    "language": "grc",
    "text": "Ἐρωτῶμεν δὲ ὑμᾶς, ἀδελφοί, ὑπὲρ τῆς παρουσίας τοῦ κυρίου [ἡμῶν] Ἰησοῦ Χριστοῦ καὶ ἡμῶν ἐπισυναγωγῆς ἐπʼ αὐτόν,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.2",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.2",
    "language": "grc",
    "text": "εἰς τὸ μὴ ταχέως σαλευθῆναι ὑμᾶς ἀπὸ τοῦ νοὸς μηδὲ θροεῖσθαι μήτε διὰ πνεύματος μήτε διὰ λόγου μήτε διʼ ἐπιστολῆς ὡς διʼ ἡμῶν, ὡς ὅτι ἐνέστηκεν ἡ ἡμέρα τοῦ κυρίου.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.3",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.3",
    "language": "grc",
    "text": "μή τις ὑμᾶς ἐξαπατήσῃ κατὰ μηδένα τρόπον· ὅτι ἐὰν μὴ ἔλθῃ ἡ ἀποστασία πρῶτον καὶ ἀποκαλυφθῇ ὁ ἄνθρωπος τῆς ἀνομίας, ὁ υἱὸς τῆς ἀπωλείας,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.4",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.4",
    "language": "grc",
    "text": "ὁ ἀντικείμενος καὶ ὑπεραιρόμενος ἐπὶ πάντα λεγόμενον θεὸν ἢ σέβασμα, ὥστε αὐτὸν εἰς τὸν ναὸν τοῦ θεοῦ καθίξαι, ἀποδεικνύντα ἑαυτὸν ὅτι ἔστιν θεός—.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.5",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.5",
    "language": "grc",
    "text": "Οὐ μνημονεύετε ὅτι ἔτι ὢν πρὸς ὑμᾶς ταῦτα ἔλεγον ὑμῖν;",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.6",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.6",
    "language": "grc",
    "text": "καὶ νῦν τὸ κατέχον οἴδατε, εἰς τὸ ἀποκαλυφθῆναι αὐτὸν ἐν τῷ αὐτοῦ καιρῷ·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.7",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.7",
    "language": "grc",
    "text": "τὸ γὰρ μυστήριον ἤδη ἐνεργεῖται τῆς ἀνομίας· μόνον ὁ κατέχων ἄρτι ἕως ἐκ μέσου γένηται.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.8",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.8",
    "language": "grc",
    "text": "καὶ τότε ἀποκαλυφθήσεται ὁ ἄνομος, ὃν ὁ κύριος [Ἰησοῦς] ἀνελεῖ τῷ πνεύματι τοῦ στόματος αὐτοῦ καὶ καταργήσει τῇ ἐπιφανείᾳ τῆς παρουσίας αὐτοῦ,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.9",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.9",
    "language": "grc",
    "text": "οὗ ἐστὶν ἡ παρουσία κατʼ ἐνέργειαν τοῦ Σατανᾶ ἐν πάσῃ δυνάμει καὶ σημείοις καὶ τέρασιν ψεύδους",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.10",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.10",
    "language": "grc",
    "text": "καὶ ἐν πάσῃ ἀπάτῃ ἀδικίας τοῖς ἀπολλυμένοις, ἀνθʼ ὧν τὴν ἀγάπην τῆς ἀληθείας οὐκ ἐδέξαντο εἰς τὸ σωθῆναι αὐτούς·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.11",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.11",
    "language": "grc",
    "text": "καὶ διὰ τοῦτο πέμπει αὐτοῖς ὁ θεὸς ἐνέργειαν πλάνης εἰς τὸ πιστεῦσαι αὐτοὺς τῷ ψεύδει,",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.12",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.12",
    "language": "grc",
    "text": "ἵνα κριθῶσιν πάντες οἱ μὴ πιστεύσαντες τῇ ἀληθείᾳ ἀλλὰ εὐδοκήσαντες τῇ ἀδικίᾳ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.13",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.13",
    "language": "grc",
    "text": "Ἡμεῖς δὲ ὀφείλομεν εὐχαριστεῖν τῷ θεῷ πάντοτε περὶ ὑμῶν, ἀδελφοὶ ἠγαπημένοι ὑπὸ Κυρίου, ὅτι εἵλατο ὑμᾶς ὁ θεὸς ἀπʼ ἀρχῆς εἰς σωτηρίαν ἐν ἁγιασμῷ πνεύματος καὶ πίστει ἀληθείας,",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.14",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.14",
    "language": "grc",
    "text": "εἰς ὃ ἐκάλεσεν ὑμᾶς διὰ τοῦ εὐαγγελίου ἡμῶν, εἰς περιποίησιν δόξης τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.15",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.15",
    "language": "grc",
    "text": "Ἄρα οὖν, ἀδελφοί, στήκετε, καὶ κρατεῖτε τὰς παραδόσεις ἃς ἐδιδάχθητε εἴτε διὰ λόγου εἴτε διʼ ἐπιστολῆς ἡμῶν.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.16",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.16",
    "language": "grc",
    "text": "Αὐτὸς δὲ ὁ κύριος ἡμῶν Ἰησοῦς Χριστὸς καὶ [ὁ] θεὸς ὁ πατὴρ ἡμῶν, ὁ ἀγαπήσας ἡμᾶς καὶ δοὺς παράκλησιν αἰωνίαν καὶ ἐλπίδα ἀγαθὴν ἐν χάριτι,",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0031/tlg014/perseus-grc2#tlg0031.tlg014.2.17",
    "work_id": "perseus/tlg0031/tlg014/perseus-grc2",
    "canonical_ref": "tlg0031.tlg014.2.17",
    "language": "grc",
    "text": "παρακαλέσαι ὑμῶν τὰς καρδίας καὶ στηρίξαι ἐν παντὶ ἔργῳ καὶ λόγῳ ἀγαθῷ.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
