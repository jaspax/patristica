    "work_id": "perseus/tlg0557/tlg003/perseus-grc2",
    "canonical_ref": "tlg0557.tlg003.28",
    "language": "grc",
    "text": "οὐ περὶ τοῦ τυχόντος οὖν, ἔφη, ἐστὶν ὁ ἀγών, ἀλλὰ περὶ τοῦ μαίνεσθαι ἢ μή.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0557/tlg003/perseus-grc2#tlg0557.tlg003.28a",
    "work_id": "perseus/tlg0557/tlg003/perseus-grc2",
    "canonical_ref": "tlg0557.tlg003.28a",
    "language": "grc",
    "text": "ὁ Σωκράτης ἔλεγεν τί θέλετε; λογικῶν ψυχὰς ἔχειν ἢ ἀλόγων; λογικῶν. τίνων λογικῶν; ὑγιῶν ἢ φαύλων; ὑγιῶν. τί οὖν οὐ ζητεῖτε; ὅτι ἔχομεν. τί οὖν μάχεσθε καὶ διαφέρεσθε;",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
