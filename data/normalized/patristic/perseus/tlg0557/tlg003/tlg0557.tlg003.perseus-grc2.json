    "canonical_ref": "tlg0557.tlg003.11",
    "language": "grc",
    "text": "ἐκ τῶν Ἀρριανοῦ προτρεπτικῶν ὁμιλιῶν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
