    "work_id": "perseus/tlg0557/tlg003/perseus-grc2",
    "canonical_ref": "tlg0557.tlg003.26",
    "language": "grc",
    "text": "ψυχάριον εἶ βαστάζον νεκρόν, ὡς Ἐπίκτητος ἔλεγεν.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
