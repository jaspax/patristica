    "work_id": "perseus/tlg0557/tlg003/perseus-grc2",
    "canonical_ref": "tlg0557.tlg003.29",
    "language": "grc",
    "text": "ἐκ τοῦ Ἐπικτήτου ἐγχειριδίου.",
