    "work_id": "npnf-works/theophilus-of-alexandria-canonical-writings",
    "canonical_ref": "TheophAlex.Can.xxvi.8",
    "language": "eng",
    "text": "If it do evidently appear, that Jacob, while he was reader, did commit fornication, and was ejected by the priests (πρεσβυτέρων), and yet afterwards ordained, let him be ejected, and not otherwise.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 395,
    "date_range": [
      385,
      412
    ],
    "date_confidence": "approximate",
