    "canonical_ref": "TheophAlex.Can.xxvi.12",
    "language": "eng",
    "text": "Let the clergymen distribute all that is offered by way of sacrifice, after so much as was necessary has been consumed in the Mysteries. Let not the catechumens taste of them, but clergymen and communicants only.",
    "chunk_index": 16,
    "context_before": null,
