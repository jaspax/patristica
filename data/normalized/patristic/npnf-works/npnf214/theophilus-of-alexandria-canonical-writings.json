  {
    "chunk_id": "npnf-works/theophilus-of-alexandria-canonical-writings#TheophAlex.Can.xxvi.2",
    "work_id": "npnf-works/theophilus-of-alexandria-canonical-writings",
    "canonical_ref": "TheophAlex.Can.xxvi.2",
    "language": "eng",
    "text": "Let [the priests] who have communicated with the Arians, be retained or rejected, as the custom of every church is; but so, that other orthodox [priests] be ordained, though the others continue. As the orthodox bishops did in Thebais, so let it be in other cities. They who were ordained by Bishop Apollo, and afterwards communicated with the Arians, if they did it of their own accord, let them be censured; but if they only did it in obedience to the bishop, let them be continued; but if all the people abdicate them, others must be ordained. And if Bistus the priest be found to have committed uncleanness with a woman dismissed from her husband, let him not be permitted to be a priest. But this is no prejudice to the bishop who ordained him, if he did it ignorantly; since the Holy Synod commands unworthy men to be ejected, though they be not convicted until after ordination.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 395,
    "date_range": [
      385,
      412
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "npnf-works/theophilus-of-alexandria-canonical-writings#TheophAlex.Can.xxvi.3",
    "work_id": "npnf-works/theophilus-of-alexandria-canonical-writings",
    "canonical_ref": "TheophAlex.Can.xxvi.3",
    "language": "eng",
    "text": "Canon III.",
    "chunk_index": 7,
    "context_before": null,
