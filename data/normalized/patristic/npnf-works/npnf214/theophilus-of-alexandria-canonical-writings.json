    "work_id": "npnf-works/theophilus-of-alexandria-canonical-writings",
    "canonical_ref": "TheophAlex.Can.xxvi.14",
    "language": "eng",
    "text": "One, Hierax, had delated a clergyman as guilty of fornication. Bishop Apollo defended him. Theophilus orders the matter to be examined.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
