    "canonical_ref": "TheophAlex.Can.xxvi.11",
    "language": "eng",
    "text": "Canon VII.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 395,
    "date_range": [
      385,
      412
    ],
