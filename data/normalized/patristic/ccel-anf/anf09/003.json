  },
  {
    "chunk_id": "ccel-anf/anf09/003#CCELANF093.1.43",
    "work_id": "ccel-anf/anf09/003",
    "canonical_ref": "CCELANF093.1.43",
    "language": "eng",
    "text": "1. That the women fled from the grave and did not see the Lord (sec. 12).",
    "chunk_index": 49,
    "context_before": null,
