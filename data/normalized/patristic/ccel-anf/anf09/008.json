    "translation_group_id": null
  },
  {
    "chunk_id": "ccel-anf/anf09/008#CCELANF098.1.5",
    "work_id": "ccel-anf/anf09/008",
    "canonical_ref": "CCELANF098.1.5",
    "language": "eng",
    "text": "Like the Apocalypse of Esdras it deals with the subject of intercession for sinners and the reluctance of the seer to die. The parallel passages in 4 Esdras and the Apocalypse of Esdras are pointed out in the margin of the translation.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
