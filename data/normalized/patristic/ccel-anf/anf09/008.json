    "canonical_ref": "CCELANF098.1.4",
    "language": "eng",
    "text": "The translation is from Mr. M. R. James’s text in Texts and Studies, ii. 3, p. 130ff., published from a fifteenth century ms. in the Bodleian Library. The original, Mr. James conjecturally assigns to the tenth or eleventh century. It is notable for its close resemblance in several passages to 4 Esdras, to the Greek original of which the author seems to have had direct access.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
