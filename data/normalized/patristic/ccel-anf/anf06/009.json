    "work_id": "ccel-anf/anf06/009",
    "canonical_ref": "CCELANF069.7.7",
    "language": "eng",
    "text": "(Canonical Epistle, p. 279.)",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
