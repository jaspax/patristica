    "work_id": "ccel-anf/anf06/009",
    "canonical_ref": "CCELANF069.7.3",
    "language": "eng",
    "text": "(Meletian schism, p. 259.)",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
