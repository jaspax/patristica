    "work_id": "oglt_pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.8",
    "language": "lat",
    "text": "Maligna erant certamina, De sede non tamen sua, Quae nec pati desiderat, Non inferat mens improba. Nec longiore tempore Versatur in hoc murmure, Dum cogitant succedere, Redit sacerdos qui fuit.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt_pl/amoenus/pl61_8_in#PL61.IN.9",
    "work_id": "oglt_pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.9",
    "language": "lat",
    "text": "Orante plebe protinus, Dum nemo credit, redditur, Quae confluunt post tristia Majora sunt haec gaudia.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
