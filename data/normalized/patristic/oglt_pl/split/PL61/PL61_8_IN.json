    "work_id": "oglt_pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.10",
    "language": "lat",
    "text": "Plausu favebat civitas, Cui reddita est felicitas Orbata quem defleverat, Partem recepit anxia.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
