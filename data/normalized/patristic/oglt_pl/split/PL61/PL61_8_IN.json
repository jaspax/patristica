    "work_id": "oglt_pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.11",
    "language": "lat",
    "text": "Quem vix putabat redditum Præventa voto prospero, Res mira quando cernitur Solet stupere visio.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
