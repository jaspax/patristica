    "translation_group_id": null
  },
  {
    "chunk_id": "oglt_pl/dionysius-exiguus/pl67_4_con#PL67.CON.14",
    "work_id": "oglt_pl/dionysius-exiguus/pl67_4_con",
    "canonical_ref": "PL67.CON.14",
    "language": "lat",
    "text": "LVII. Si quis in morbo constitutus illuminatus tue­ rit, ad honorem presbyterii promoveri non potest. fides enim ejus non est ex proposito, sed ex neces­ sitate : nisi forte propter sequens ejus studium et fi­ dem, atque hominum raritatem.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 518,
    "date_range": [
      497,
      540
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
