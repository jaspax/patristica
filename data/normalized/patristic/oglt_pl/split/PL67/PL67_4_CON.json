    "work_id": "oglt_pl/dionysius-exiguus/pl67_4_con",
    "canonical_ref": "PL67.CON.13",
    "language": "lat",
    "text": "LYI. Presbyter ante triginta annos non ordinetur, etiamsi valde dignus fuerit, sed hoc tempus obser­ vet. Dominus enim Jesus Cbristus trigesimo anno baptizatus est, et cocpit docere",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 518,
    "date_range": [
