    "work_id": "oglt_pl/dionysius-exiguus/pl67_4_con",
    "canonical_ref": "PL67.CON.15",
    "language": "lat",
    "text": "LVIII. Regionarii presbyteri, in dominico civitatis offerre non possunt, praesente episcopo, vel presby­ teris urbis, neque panem dare in oratione, neque ca­ licem; sin autem absint, et ad orationem solus vo­ catus fuerit, dare poterit. Chorepiscopi autem, sunt quidem ad exemplum septuaginta, ut autem commi­ nistri, propter studium in pauperes, offerunt ho­ norati.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 518,
    "date_range": [
      497,
