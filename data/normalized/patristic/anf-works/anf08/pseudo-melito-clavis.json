    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.10",
    "language": "eng",
    "text": "The arm of the Lord—His Son, by whom He hath wrought all His works. In the prophet Isaiah: “And to whom is the arm of the Lord revealed?”",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
