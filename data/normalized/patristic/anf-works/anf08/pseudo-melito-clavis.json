    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.11",
    "language": "eng",
    "text": "The right hand of the Lord—that is, His Son; as also above in the Psalm: “The right hand of the Lord hath done valiantly.”",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
