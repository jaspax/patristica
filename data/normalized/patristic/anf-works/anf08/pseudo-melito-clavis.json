    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.8",
    "language": "eng",
    "text": "The face of the Lord—His manifestation. In Exodus, “My face shall go before thee;” and in the prophet, “The face of the Lord divided them.”",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
