    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.4",
    "language": "eng",
    "text": "The eyelids of the Lord—hidden spiritual mysteries in the Divine precepts. In the Psalm: “His eyelids question, that is prove, the children of men.”",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
