    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/pseudo-melito-clavis#PsMelito.Clavis.30",
    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.30",
    "language": "eng",
    "text": "The footsteps of the Lord—the signs of His secret operations. As in the Psalm: “And Thy footsteps shall not be known.”",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
