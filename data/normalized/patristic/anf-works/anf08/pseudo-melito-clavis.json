  },
  {
    "chunk_id": "anf-works/pseudo-melito-clavis#PsMelito.Clavis.15",
    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.15",
    "language": "eng",
    "text": "The hand of the Lord—Divine operation. In the prophet: “Have not my hands made all these things?”",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
