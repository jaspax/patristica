  },
  {
    "chunk_id": "anf-works/pseudo-melito-clavis#PsMelito.Clavis.12",
    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.12",
    "language": "eng",
    "text": "The right hand of the Lord—electio omnis. As in Deuteronomy: “In His right hand is a fiery law.”",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
