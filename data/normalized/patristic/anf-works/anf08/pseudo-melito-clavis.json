    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.7",
    "language": "eng",
    "text": "The tongue of the Lord—His Holy Spirit. In the Psalm: “My tongue is a pen.”",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
