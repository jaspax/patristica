    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/pseudo-melito-clavis#PsMelito.Clavis.18",
    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.18",
    "language": "eng",
    "text": "The wisdom of the Lord—His Son. In the apostle: “Christ the power of God, and the wisdom of God;” and in Solomon: “The wisdom of the Lord reacheth from one end to the other mightily.”",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
