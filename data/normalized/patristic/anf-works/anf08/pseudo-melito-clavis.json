    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.14",
    "language": "eng",
    "text": "The shoulder of the Lord—the Divine power, by which He condescends to carry the feeble. In Deuteronomy: “He took them up, and put them on His shoulders.”",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
