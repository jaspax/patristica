    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.16",
    "language": "eng",
    "text": "The finger of the Lord—the Holy Spirit, by whose operation the tables of the law in Exodus are said to have been written; and in the Gospel: “If I by the finger of God cast out demons”",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
