    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.6",
    "language": "eng",
    "text": "The mouth of the Lord—His Son, or word addressed to men. In the prophet, “The mouth of the Lord hath spoken;” and elsewhere, “They provoked His mouth to anger.”",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
