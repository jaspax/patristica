    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.33",
    "language": "eng",
    "text": "The remembrance of God—His mercy, by which He rejects and has mercy on whom He will. So in Genesis: “The Lord remembered Noah;” and in another passage: “The Lord hath remembered His people.”",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
