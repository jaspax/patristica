  },
  {
    "chunk_id": "anf-works/pseudo-melito-clavis#PsMelito.Clavis.34",
    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.34",
    "language": "eng",
    "text": "The repentance of the Lord—His change of procedure. As in the book of Kings: “It repented me that I have made Saul king.”",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
