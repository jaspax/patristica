    "work_id": "anf-works/pseudo-melito-clavis",
    "canonical_ref": "PsMelito.Clavis.5",
    "language": "eng",
    "text": "The smelling of the Lord—His delight in the prayers or works of the saints. In Genesis: “And the Lord smelled an odour of sweetness.”",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": [
      600,
      1000
    ],
