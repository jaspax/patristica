    "canonical_ref": "tlg5022.tlg007.1.17",
    "language": "grc",
    "text": "Scholium codicis Vaticani Gr. 204 fol. 134v ad Euclidis Catoptrica prop. I.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
