[
  {
    "chunk_id": "first1k/tlg0085/tlg002/1st1K-grc1#tlg0085.tlg002",
    "work_id": "first1k/tlg0085/tlg002/1st1K-grc1",
    "canonical_ref": "tlg0085.tlg002",
    "language": "grc",
    "text": "Γλαῦκος ἐν τοῖς περὶ Αἰσχύλου μύθων ἐν τῶν Φοινισσῶν Φρυνίχου φησὶ τοὺς Πέρσας παραπεποιῆσθαι. ἐκτίθησι δὲ καὶ τὴν τὴν ἀρχὴν τοῦ δράματος ταύτην, Τάδ᾽ ἐστὶ Περσῶν τῶν πάλαι βεβηκότων. πλὴν ἐκεῖ εὐνοῦχός ἐστιν ἀγγέλλων ἐν ἀρχῇ τὴν Ξέρξου ἧτταν, στορνύς τε θρόνους τινὰς τοῖς τῆς ἀρχῆς παρέδροις: ἐνταῦθα δὲ προλογίζει χορὸς πρεσβυτῶν. καὶ σ̓́στιν ἡ μὲν σκηνὴ τοῦ δράματος παρὰ τῷ ράφῳ Δαρέου: ἡ δὲ ὑπόθεσις, Ξέρξης στρατευσάμενος κατὰ Ἑλλάδος: μετὰ δυνάμεως πολλῆς, ἵππον μὲν ἄμετρον ἐπαγόμενος, ναῦς δὲ χιλίας διακοσίας ἑπτά, ἢ καὶ δεκατέσσαρας: καὶ πεζῇ μὲν Πλαταιαῖς νικηθείς, ναυτικῇ δὲ ἐν Σαλαμῖνι, καὶ διὰ Θεσσαλίας φεύγων διεπεραιώθη ἐς τὴν Ἀσίαν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
