    "work_id": "first1k/tlg1337/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1337.tlg003.24",
    "language": "grc",
    "text": "Τοῦ αὐτοῦ ἐν οἷς χαίρουσι τόποις οἱ ἀστέρες.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
