    "work_id": "first1k/tlg0533/tlg009/1st1K-grc1",
    "canonical_ref": "tlg0533.tlg009.3.1",
    "language": "grc",
    "text": "αἴθ’ ὄφελες θανέειν ἢ ὕστατον ὀρχήσασθαι.",
