    "work_id": "first1k/tlg0533/tlg009/1st1K-grc1",
    "canonical_ref": "tlg0533.tlg009.6.1",
    "language": "grc",
    "text": "βουσσόον, ὅν τε μύωπα βοῶν καλέουσιν ἀμορβοί.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
