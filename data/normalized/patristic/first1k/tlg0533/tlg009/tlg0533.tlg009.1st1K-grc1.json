    "canonical_ref": "tlg0533.tlg009.9.1.1",
    "language": "grc",
    "text": "Suid. s.v. σῦφαρ. So s.v. ναὶ μὰ τό. Schol. Apoll. Rh. i. 669.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
