  {
    "chunk_id": "first1k/tlg0533/tlg009/1st1K-grc1#tlg0533.tlg009.3.1.1",
    "work_id": "first1k/tlg0533/tlg009/1st1K-grc1",
    "canonical_ref": "tlg0533.tlg009.3.1.1",
    "language": "grc",
    "text": "Suid. s. v. (Gaisf. i. 1096) αἴθ’ κτλ.· ἐπειδὴ τὴν γλαῦκα ὅταν λάβωσι τὰ παιδία περιάγουσιν, ἡ δὲ μὴ βλέπουσα δι’ ἡμέρας ὥσπερ ὀρχεῖται· ἢ ὅταν πληγῇ, τελευτῶσα στρέφεται ὥσπερ ὀρχουμένη. Καλλίμαχος ἐν Ἑκάλῃ λέγει περὶ αὐτῆς.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0533/tlg009/1st1K-grc1#tlg0533.tlg009.4.1",
    "work_id": "first1k/tlg0533/tlg009/1st1K-grc1",
    "canonical_ref": "tlg0533.tlg009.4.1",
    "language": "grc",
    "text": "ἁρμοῖ που κἀκείνῳ ἐπέτρεχεν ἁβρὸς ἴουλος.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
