    "work_id": "first1k/tlg0533/tlg009/1st1K-grc1",
    "canonical_ref": "tlg0533.tlg009.9.1",
    "language": "grc",
    "text": "ναὶ μὰ τὸ ῥικνὸν σῦφαρ ἐμόν, ναὶ τοῦτο τὸ δένδρεον αὖον ἐόν περ.",
    "chunk_index": 23,
