    "work_id": "first1k/tlg0627/tlg046/1st1K-grc1",
    "canonical_ref": "tlg0627.tlg046.4",
    "language": "grc",
    "text": "4. Γίνεται δὲ καὶ ἐξίτηλος, ὁτὲ μὲν ἡ προτέρη ἐν χρόνῳ ἀπολυθεῖσα ἢ ἐπιπροστεθεῖσα, ὁτὲ δὲ ἡ ὑστέρη ἐν χρόνῳ ἀπολυθεῖσα ἢ ἐπιπροστεθεῖσα.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
