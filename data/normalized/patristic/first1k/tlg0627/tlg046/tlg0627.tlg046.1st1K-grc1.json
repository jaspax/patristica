  },
  {
    "chunk_id": "first1k/tlg0627/tlg046/1st1K-grc1#tlg0627.tlg046.16",
    "work_id": "first1k/tlg0627/tlg046/1st1K-grc1",
    "canonical_ref": "tlg0627.tlg046.16",
    "language": "grc",
    "text": "16. Ἐς δὲ ταύτην, ἔξωθεν μὲν, κατάπλασμα, κατάχρισμα, ἄλειμμα, γυμνότης ὅλου καὶ μέρεος, καὶ σκέπη ὅλου καὶ μέρεος, θερμασίη καὶ ψύξις κατὰ τὸν αὐτὸν λόγον καὶ στύψις καὶ ἕλκωσις καὶ δηγμὸς καὶ λίπασμα· ἔνδοθεν δὲ, τινά τε τῶν εἰρημένων, καὶ ἐπὶ τούτοισιν αἰτίη ἄδηλος καὶ μέρει καὶ ὅλῳ, τινί τε καὶ οὐτινί.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
