    "work_id": "first1k/tlg0627/tlg046/1st1K-grc1",
    "canonical_ref": "tlg0627.tlg046.18",
    "language": "grc",
    "text": "18. Φαρμακείη ἄνω καὶ κάτω, καὶ οὔτε ἄνω οὔτε κάτω.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
