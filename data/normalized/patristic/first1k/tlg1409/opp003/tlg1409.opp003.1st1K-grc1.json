    "canonical_ref": "tlg1409.opp003.1",
    "language": "grc",
    "text": "1. ἀθηναῖοι τὸ μὲν ἴε ἀρχῆς ἐχρῶντο βασιλείᾳ· συνοικἦσαντος δὲ Ἴωνος αὐτοὺς τότε τρῶτον Ἴωνες ἐκλήθησαν.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
