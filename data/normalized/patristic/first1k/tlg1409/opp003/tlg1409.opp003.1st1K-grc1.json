    "work_id": "first1k/tlg1409/opp003/1st1K-grc1",
    "canonical_ref": "tlg1409.opp003.3.1",
    "language": "grc",
    "text": "ὡς δ᾿ ἐνώχλουν αὐτῷ τινες περὶ τῶν νόμων, ἀπεδήμησεν εἰς Αἴγυπτον.",
    "chunk_index": 9,
    "context_before": null,
