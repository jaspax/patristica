    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1409/opp003/1st1K-grc1#tlg1409.opp003.4",
    "work_id": "first1k/tlg1409/opp003/1st1K-grc1",
    "canonical_ref": "tlg1409.opp003.4",
    "language": "grc",
    "text": "4. Πεισίστρατος τριάκοντα καὶ τρία ἔτη τυραννήσας γηράσας ἀπέθανε.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1409/opp003/1st1K-grc1#tlg1409.opp003.4.1",
    "work_id": "first1k/tlg1409/opp003/1st1K-grc1",
    "canonical_ref": "tlg1409.opp003.4.1",
    "language": "grc",
    "text": "Ἵππαρχος ὁ υἱὸς Πεισιστράτου παιδιώδης ἧν καὶ ἐρωτικὸς καὶ φιλότοῦτον Θεσσαλὸς δὲ νεώτερος καὶ θρασύς.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
