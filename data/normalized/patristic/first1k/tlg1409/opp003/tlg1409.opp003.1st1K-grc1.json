  },
  {
    "chunk_id": "first1k/tlg1409/opp003/1st1K-grc1#tlg1409.opp003.5",
    "work_id": "first1k/tlg1409/opp003/1st1K-grc1",
    "canonical_ref": "tlg1409.opp003.5",
    "language": "grc",
    "text": "5 [7]. Θεμιστοκλῆς καὶ Ἀριστείδης.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
