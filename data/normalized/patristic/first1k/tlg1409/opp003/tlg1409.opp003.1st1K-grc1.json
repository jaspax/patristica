[
  {
    "chunk_id": "first1k/tlg1409/opp003/1st1K-grc1#tlg1409.opp003.preface",
    "work_id": "first1k/tlg1409/opp003/1st1K-grc1",
    "canonical_ref": "tlg1409.opp003.preface",
    "language": "grc",
    "text": "In ood. Vatic. 997, nunc Paris. suppl. gr, 352 (saec. VIII) et depeidito gemello codice, unde nonnulli alii sunt descripti, sub titulo ἐκ τῶν Ἡρακλείδου περὶ πολιτείας Ἀθηναίων (itemque de ceterarum nationum rebus publicis) servata est epitoma operis quod Aristotelicum hoc verbo tenus secutum est, nisi id ipsum fuit. aut enim Heraclides ille librum Aristotelicum ipse excerpsit, aut epitomator Heraclidi sive Pontico sive alii opus tribuit quod sub Aristotelis nomine cognovimus. epitomam ediderunt C. Peruscus (a. 1545), F. G. Schneidewin (1847), C. Mueller ;(Frag. Hist. Graec. II 208, 1848), denique V. Rose, quem (ed. Teub., 1886) plerumque secutus sum. clausulas disposuerunt K-W.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1409/opp003/1st1K-grc1#tlg1409.opp003.1",
