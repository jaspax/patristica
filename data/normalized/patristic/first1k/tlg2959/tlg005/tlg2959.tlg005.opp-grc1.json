    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2959/tlg005/opp-grc1#tlg2959.tlg005.3.4.5",
    "work_id": "first1k/tlg2959/tlg005/opp-grc1",
    "canonical_ref": "tlg2959.tlg005.3.4.5",
    "language": "grc",
    "text": "Οὐκοῦν αὐτὸς ἑαυτοῦ πλοῦτος καὶ δι' ἑαυτὸν πλούσιος καὶ δυωατὸς τυγχάνει;",
    "chunk_index": 31,
    "context_before": null,
