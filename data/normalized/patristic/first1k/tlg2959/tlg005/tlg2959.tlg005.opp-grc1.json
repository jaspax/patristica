    "canonical_ref": "tlg2959.tlg005.3.3.7",
    "language": "grc",
    "text": "Προσηκόντως.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
