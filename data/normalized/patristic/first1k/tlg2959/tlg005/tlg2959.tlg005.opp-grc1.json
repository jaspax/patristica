    "language": "grc",
    "text": "Ὅπως δι’ ἑαυτόν, ἀλλὰ μὴ διὰ κόσμον, καὶ ταῦτα τρεπτόν, αὐτὸς καθ’ ἐαυτὸν τέλειος εὑρίσκοιτο.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
