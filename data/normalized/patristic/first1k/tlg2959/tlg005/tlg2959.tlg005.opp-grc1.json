    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2959/tlg005/opp-grc1#tlg2959.tlg005.3.4.1",
    "work_id": "first1k/tlg2959/tlg005/opp-grc1",
    "canonical_ref": "tlg2959.tlg005.3.4.1",
    "language": "grc",
    "text": "Καὶ τὸν σοφὸν κατὰ μετοχὴν τῆς οὐσιώδους σοφίας, οὐκ αὐτὸν σοφίαν ὄντα, σοφὸν προσαγορευτέον;",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
