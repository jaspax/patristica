    "canonical_ref": "tlg2959.tlg005.3.4",
    "language": "grc",
    "text": "Τί δέ; τὸν πλούσιον διὰ τὸν πλοῦτον λεκτέον πλούσιον; Ὀρθῶς.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
