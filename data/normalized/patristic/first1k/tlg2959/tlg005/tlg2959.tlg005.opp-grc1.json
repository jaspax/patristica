    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2959/tlg005/opp-grc1#tlg2959.tlg005.3.4.4",
    "work_id": "first1k/tlg2959/tlg005/opp-grc1",
    "canonical_ref": "tlg2959.tlg005.3.4.4",
    "language": "grc",
    "text": "Ἄπαγε, οὐδαμῶς.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
