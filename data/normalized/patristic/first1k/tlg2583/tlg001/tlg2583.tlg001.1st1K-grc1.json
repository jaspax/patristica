    "work_id": "first1k/tlg2583/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2583.tlg001.3.toc",
    "language": "grc",
    "text": "Ἐν τῷ γ΄ βιβλίῳ φησίν·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
