    "canonical_ref": "tlg2583.tlg001.2.toc",
    "language": "grc",
    "text": "Ἐν τῷ βʹ τούτῳ βιβλίῳ διέξεισιν,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
