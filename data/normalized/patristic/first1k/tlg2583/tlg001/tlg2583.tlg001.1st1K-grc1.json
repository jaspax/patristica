    "work_id": "first1k/tlg2583/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2583.tlg001.3.toc.5",
    "language": "grc",
    "text": "Ε. Περὶ χρόνων ζωῆς, καὶ πῶς μὲν τούτους ἐφοδευτέον δι᾿ ἡμέρας, πῶς δὲ νυκτός· καὶ πότε μὲν ἀπὸ τῶνδε, πότε δὲ ἀφ᾿ ἑτέρων τούτους παραληπτέον.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
