    "work_id": "first1k/tlg2583/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2583.tlg001.2.toc.1",
    "language": "grc",
    "text": "Α. Περὶ τῆς θέσεως τῶν ἐν τῇ σφαίρᾳ κύκλων φαινομένων τε καὶ ἀφανῶν καὶ ἄξονος καὶ ὁρίζοντος καὶ τῆς ἐν τοῖς κύκλοις τῶν ἄστρων τε καὶ ἀστέρων θέσεως καὶ τῶν λοξῶν κύκλων.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2583/tlg001/1st1K-grc1#tlg2583.tlg001.2.toc.2",
    "work_id": "first1k/tlg2583/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2583.tlg001.2.toc.2",
    "language": "grc",
    "text": "Β. Τί ἕκαστος τῶν ἑπτὰ πλανητῶν ἐν ἰδίῳ, καὶ τί ἐν ἀλλοτρίῳ οἴκῳ φαινόμενος ἀποτελεῖ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2583/tlg001/1st1K-grc1#tlg2583.tlg001.2.toc.3",
    "work_id": "first1k/tlg2583/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2583.tlg001.2.toc.3",
    "language": "grc",
    "text": "Γ. Τίς ἑκάστου τῶν ἑπτὰ πλανητῶν ἐν τῇ ἀνατολῇ, καὶ τίς ἐν τῇ δύσει δύναμις.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2583/tlg001/1st1K-grc1#tlg2583.tlg001.2.toc.4",
    "work_id": "first1k/tlg2583/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2583.tlg001.2.toc.4",
    "language": "grc",
    "text": "Δ. Περὶ τῆς φάσεως τῶν ζʹ πλανητῶν, καὶ τί μὲν ἕκαστος αὐτῶν τῷ ἡλίῳ συνὼν ἀποτελεῖ, καὶ τί διαμετρῶν, τί δὲ τῇ σελήνῃ καθʼ ἑκάστην τῶν δύο φάσεων.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
