  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.2",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.2",
    "language": "grc",
    "text": "καὶ ἔλαβεν γυναῖκα ᾖ ὄνομα Σουσάννα, θυγάτηρ Χελκείου, καλὴ σφόδρα καὶ φοβουμένη τὸν κύριον.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.3",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.3",
    "language": "grc",
    "text": "καὶ οἱ γονεῖς αὐτῆς δίκαιοι, καὶ ἐδίδαξαν τὴν θυγατέρα αὐτῶν κατὰ τὸν νόμον Μωυσῆ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.4",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.4",
    "language": "grc",
    "text": "καὶ ἦν Ἰωακεὶμ πλούσιος σφόδρα, καὶ ἦν αὐτῷ παράδεισος γειτνιῶν τῷ οἴκῳ αὐτοῦ· καὶ πρὸς αὐτὸν προσήγοντο οἱ Ἰουδαῖοι, διὰ τὸ εἶναι αὐτὸν ἐνδοξότερον πάντων.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.5",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.5",
    "language": "grc",
    "text": "Καὶ ἀπεδείχθησαν δύο πρεσβύτεροι ἐκ τοῦ λαοῦ κριταὶ ἐν τῷ ἐνιαυτῷ ἐκείνῳ, περὶ ὧν ἐλάλησεν ὁ δεσπότης ὅτι ἐξῆλθεν ἀνομία ἐκ Βαβυλῶνος ἐκ πρεσβυτέρων κριτῶν οἳ ἐδόκουν κυβερνῶν τὸν λαόν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.6",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.6",
    "language": "grc",
    "text": "οὗτοι προσεκαρτέρουν ἐν τῇ οἰκίᾳ Ἰωακείμ, καὶ ἤρχοντο πρὸς αὐτοὺς πάντες οἱ κρινόμενοι.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.7",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.7",
    "language": "grc",
    "text": "καὶ ἐγένετο ἡνίκα ἀπέτρεχεν ὁ λαὸς μέσον ἡμέρας, εἰσεπορεύετο Σουσάννα καὶ περιεπάτει ἐν τῷ παραδείσῳ τοῦ ἀνδρὸς αὐτῆς.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.8",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.8",
    "language": "grc",
    "text": "καὶ ἐθεώρουν αὐτὴν οἱ δύο πρεσβύτεροι καθʼ ἡμέραν εἰσπορευομένην καὶ περιπατοῦσαν, καὶ ἐγένοντο ἐν ἐπιθυμίᾳ αὐτῆς.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.9",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.9",
    "language": "grc",
    "text": "καὶ διέ. στρεψαν τὸν ἑαυτῶν νοῦν, καὶ ἐξέκλιναν τοὺς ὀφθαλμοὺς αὐτῶν τοῦ μὴ βλέπειν εἰς τὸν οὐρανὸν μηδὲ μνημονεύειν κριμάτων δικαίων.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.10",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.10",
    "language": "grc",
    "text": "καὶ ἦσαν ἀμφότεροι κατανενυγμένοι περὶ αὐτῆς, καὶ οὐκ ἀνήγγειλαν ἀλλήλοις τὴν ὀδύνην ἑαυτῶν·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.11",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.11",
    "language": "grc",
    "text": "ὅτι ήσχύνοντο ἀναγγεῖλαι τὴν ἐπιθυμίαν αὐτῶν ὅτι ἤθελον συγγενέσθαι αὐτῇ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.12",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.12",
    "language": "grc",
    "text": "καὶ παρετηροῦσαν φιλοτίμως καθʼ ἡμέραν ὁρᾷν αὐτήν.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.13",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.13",
    "language": "grc",
    "text": "καὶ εἶπαν 1 Cf quae ad init Danielis adnotavimus Σωσαννα Brescr: item 7 AQ 2 Χελκιου BᵇAQ 3 Μωση A 4 προσηγοντο] συνηγοντο Q 6 προσεκατερουν Q* (ρ superscr) 10 ανηγγειλαν] απηγγελλον AQ εαυτων] αυτων AQ 11 αναγγειλαι] απαγγειλαι AQ 13 ειπαν] ειπεν AQ ἕτερος τῷ ἑτέρῳ Πορευθῶμεν δὴ εἰς οἶκον, ὅτι ἀρίστου ὥρα ἐστίν· B καὶ ἐξελθόντες διεχωρίσθησαν ἀπ᾿ ἀλλήλων.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.14",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.14",
    "language": "grc",
    "text": "καὶ ἀνακάμψαντες ἦλθον ἐπὶ τὸ αὐτό, καὶ ἀνετάζοντες ἀλλήλους τὴν αἰτίαν ὡμολόγησαν τὴν ἐπιθυμίαν αὐτῶν· καὶ τότε κοινῇ συνετάξαντο καιρὸν ὅτε αὐτὴν δυνήσονται εὑρεῖν μόνην.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.15",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.15",
    "language": "grc",
    "text": "καὶ ἐγένετο ἐν τῷ παρατηρεῖν αὐτοὺς ἡμέραν εὔθετον εἰσῆλθέν ποτε καθὼς ἐχθές καὶ τρίτης ἡμέρας μετὰ δύο μόνων κορασίων, καὶ ἐπεθύμησε λούσασθαι ἐν τῷ παραδείσω, ὅτι καῦμα ἣν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.16",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.16",
    "language": "grc",
    "text": "καὶ οὐκ ἣν ἐκεῖ οὐδεὶς πλὴν οἱ δύο πρεσβύτεροι κεκρυμμένοι καὶ παρατηροῦντες αὐτήν.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.17",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.17",
    "language": "grc",
    "text": "καὶ εἶπεν τοῖς κορασίοις Ἐνέγκατε δὴ μοι ἔλαιον καὶ σμήγματα, καὶ τὰς θύρας τοῦ παραδείσου κλείσατε, ὅπως λούσωμαι.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.18",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.18",
    "language": "grc",
    "text": "καὶ ἐποίησαν καθὼς εἶπεν, καὶ ἀπέκλεισαν τὰς θύρας τοῦ παραδείσου, καὶ ἐξῆλθαν κατὰ τὰς πλαγίας θύρας ἐνέγκαι τὰ προστεταγμένα αὐταῖς, καὶ οὐκ εἴδοσαν τοὺς πρεσβυτέρους, ὅτι ἦσαν κεκρυμμένοι.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.19",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.19",
    "language": "grc",
    "text": "καὶ ἐγένετο ὡς ἐξήλθοσαν τὰ κοράσια, καὶ ἀνέστησαν οἱ δύο πρεσβῦται καὶ ἐπέδραμον αὐτῇ,",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.20",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.20",
    "language": "grc",
    "text": "καὶ εἶπον Ἰδοὺ αἱ θύραι τοῦ παραδείσου κέκλεινται, καὶ οὐδεὶς θεωρεῖ ἡμᾶς, καὶ ἐν ἐπιθυμίᾳ σού ἐσμεν· διὸ συνκατάθου ἡμίν, καὶ γενοῦ μεθʼ ἡμῶν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.21",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.21",
    "language": "grc",
    "text": "εἰ δὲ μή, καταμαρτυρήσομέν σου ὅτι ἦν μετὰ σοῦ νεανίσκος, καὶ διὰ τοῦτο ἐξαπέστειλας τὰ κοράσια ἀπὸ σου.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.22",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.22",
    "language": "grc",
    "text": "καὶ ἀνεστέναξεν Σουσάννα καὶ εἶπεν Στενά μοι πάντοθεν· ἐάν τε γὰρ τοῦτο πράξω, θάνατός μοί ἐστιν· ἐάν τε μὴ πράξω, οὐκ ἐκφεύξομαι τὰς χεῖρας ὑμῶν.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.23",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.23",
    "language": "grc",
    "text": "αἱρετόν μοί ἐστιν μὴ πράξασαν ἐνπεσεῖν εἰς τὰς χεῖρας ὑμῶν ἤ ἁμαρτεῖν ἐνώπιον Κυρίου.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.24",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.24",
    "language": "grc",
    "text": "καὶ ἀνεβόησεν φωνῇ μεγάλῃ Σουσάννα· ἐβόησαν δέ καὶ οἱ δύο πρεσβῦται κατέναντι αὐτῆς.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.25",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.25",
    "language": "grc",
    "text": "καὶ δραμὼν ὁ εἶς ἤνοιξεν τὰς θύρας τοῦ παραδείσου.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg055/1st1K-grc1#tlg0527.tlg055.1.26",
    "work_id": "first1k/tlg0527/tlg055/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg055.1.26",
    "language": "grc",
    "text": "ὡς δὲ ἤκουσαν τὴν κραυγὴν ἐν τῷ παραδείσῳ οἱ ἐκ τῆς οἰκίας, εἰσεπήδησαν διὰ τῆς πλαγίας θύρας ἰδεῖν τὸ συμβεβηκὸς αὐτῇ.",
    "chunk_index": 25,
