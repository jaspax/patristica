    "canonical_ref": "tlg0527.tlg055.1.1",
    "language": "grc",
    "text": "ΚΑΙ ἦν ἀνήρ οἰκῶν ἐν Βαβυλῶνι, καὶ ὄνομα αὐτῷ Ἰωακείμ.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
