    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.40",
    "language": "grc",
    "text": "ταύτης δὲ ἐπιλαβόμενοι ἐπηρωτῶμεν αὐτήν Τίς ὁ ἄνθρωπος;",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
