[
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.1",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.1",
    "language": "grc",
    "text": "ΚΑΙ ἦν ἀνὴρ οἰκῶν ἐν Βαβυλῶνι, καὶ ὄνομα αὐτῷ Ἰωακείμ.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.2",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.2",
    "language": "grc",
    "text": "καὶ ἔλαβε γυναῖκα ᾖ ὄνομα Σουσάννα, θυγάτηρ Χελκίου, καλὴ σφόδρα καὶ φοβουμένη τὸν κύριον·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.3",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.3",
    "language": "grc",
    "text": "καὶ οἱ γονεῖς αὐτῆς δίκαιοι, καὶ ἐδίδαξαν τὴν θυγατέρα αὐτῶν κατὰ τὸν νόμον Μωυσῆ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.4",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.4",
    "language": "grc",
    "text": "καὶ ἦν Ἰωακεὶμ πλούσιος σφόδρα, καὶ ἦν αὐτῷ παράδεισος γειτνιῶν τῷ οἴκῳ αὐτοῦ· καὶ πρὸς αὐτὸν προσήγοντο οἱ Ἰουδαῖοι διὰ τὸ εἶναι αὐτὸν ἐνδοξότερον πάντων.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.5",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.5",
    "language": "grc",
    "text": "Καὶ ἀπεδείχθησαν δύο πρεσβύτεροι ἐκ τοῦ λαοῦ κριταὶ ἐν τῷ ἐνιαυτῷ ἐκείνῳ, περὶ ὧν ἐλάλησεν ὁ δεσπότης ὅτι ἐξῆλθεν ἀνομία ἐκ Βαβυλῶνος ἐκ πρεσβυτέρων κριτῶν οἱ ἐδόκουν κυβερνῶν τὸν λαόν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.6",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.6",
    "language": "grc",
    "text": "καὶ ἤρχοντο κρίσεις ἐξ ἄλλων πόλεων πρὸς αὐτοὺς.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.7",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.7",
    "language": "grc",
    "text": "οὗτοι ἰδόντες γυναῖκα ἀστείαν τῷ εἴδει, γυναῖκα ἀδελφοῦ αὐτῶν ἐκ τῶν υἱῶν Ἰσραήλ, ὄνομα Σουσάνναν, θυγατέρα Χελκίου, γυναῖκα Ἰωακείμ, περιπατοῦσαν ἐν τῷ παραδείσῳ τοῦ ἀνδρὸς αὐτῆς τὸ δειλινὸν",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.8",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.8",
    "language": "grc",
    "text": "καὶ ἐπιθυμήσαντες αὐτῆς,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.9",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.9",
    "language": "grc",
    "text": "διέστρεψαν τὸν νοῦν αὐτῶν καὶ ἐξέκλιναν τοὺς ὀφθαλμοὺς αὐτῶν τοῦ μὴ βλέπειν εἰς τὸν οὐρανὸν μηδέ μνημονεύειν κριμάτων δικαίων.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.10",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.10",
    "language": "grc",
    "text": "καὶ ἀμφότεροι ἦσαν κατανενυγμένοι περὶ αὐτῆς, καὶ ἕτερος τῷ ἑτέρῳ οὐ προσεποιεῖτο τὸ κακὸν τὸ ἔχον αὐτοὺς περὶ αὐτῆς, οὐδέ ἡ γυνὴ ἔγνω τὸ πρᾶγμα τοῦτο.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.12",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.12",
    "language": "grc",
    "text": "καὶ ὡς ἐγίνετο ὄρθρος, ἐρχόμενοι ἔκλεπτον ἀλλήλους σπεύδοντες, τίς φανήσεται αὐτῇ πρότερος καὶ λαλήσει πρὸς αὐτήν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.13",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.13",
    "language": "grc",
    "text": "καὶ ἰδοὺ αὕτη κατὰ τὸ εἰωθὸς περιεπάτει, καὶ ὁ εἶς τῶν πρεσβυτέρων ἐληλύθει, καὶ ἰδοὺ ὁ ἕτερος παρεγένετο, καὶ εἶς τὸν ἕτερον ἀνέκρινε λέγων Τί σὺ οὕτως ὄρθρου ἐξῆλθες οὐ παραλαβὼν με;",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.14",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.14",
    "language": "grc",
    "text": "καὶ ἐξωμολογήσαντο πρὸς ἀλλήλους ἑκάτερος τὴν ὀδύνην αὐτοῦ.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.19",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.19",
    "language": "grc",
    "text": "καὶ εἶπεν εἶς τῷ ἑτέρῳ Πορευθῶμεν πρὸς αὐτὴν· καὶ συνθέμενοι προσήλθοσαν αὐτῇ καὶ ἐξεβιάζοντο αὐτήν.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.22",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.22",
    "language": "grc",
    "text": "καὶ εἶπεν αὐτοῖς ἡ Ἰουδαία Οἶδα ὅτι ἐὰν πράξω τοῦτο θάνατός μοί ἐστι, καὶ ἐὰν μὴ πράξω οὐκ ἐκφεύξομ τὰς χεῖρας ὑμῶν·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.23",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.23",
    "language": "grc",
    "text": "κάλλιον δέ με μὴ πράξασαν ἐμπεσεῖν εἰς τὰς χεῖρας ὑμῶν ἤ ἁμαρτεῖν ἐνώπιον Κυρίου.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.28",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.28",
    "language": "grc",
    "text": "οἱ δὲ παράνομοι ἄνδρες ἀπέστρεψαν ἀπειλοῦντες ἐν ἑαυτοῖς καὶ ἐνεδρεύοντες ἵνα θανατώσουσιν αὐτὴν· καὶ ἐλθόντες ἐπὶ τὴν συναγωγὴν τῆς πόλεως οὖ παρῴκουσαν, καὶ συνήδρευσαν οἱ ὄντες ἐκεῖ πάντες οἱ υἱοὶ Ἰσραήλ·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.29",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.29",
    "language": "grc",
    "text": "καὶ ἀναστάντες οἱ δύο πρεσβύτεροι καὶ κριταὶ εἶπαν Ἀποστείλατε ἐπὶ Σουσάνναν, θυγατέρα Χελκίου, ἥτις ἐστὶ γυνὴ Ἰωακείμ. οἱ δὲ εὐθέως ἐκάλεσαν αὐτήν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.30",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.30",
    "language": "grc",
    "text": "ὡς δὲ παρεγενήθη ἡ γυνὴ σὺν τῷ πατρὶ ἑαυτῆς καὶ τῇ μητρί, καὶ οἱ παῖδες καὶ αἱ παιδίσκαι αὐτῆς ὄντες τὸν ἀριθμὸν πεντακόσιοι παρεγένοντο, καὶ τὰ παιδία Σουσάννας τέσσαρα.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.31",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.31",
    "language": "grc",
    "text": "ἧν δὲ ἡ γυνὴ τρυφερὰ σφόδρα.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.32",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.32",
    "language": "grc",
    "text": "καὶ προσέταξαν οἱ παράνομοι ἀποκαλύψαι αὐτήν, ἵνα ἐμπλησθῶσιν κάλλους ἐπιθυμίας αὐτῆς.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.33",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.33",
    "language": "grc",
    "text": "καὶ ἐκλαίοσαν οἱ παρʼ αὐτῆς πάντες καὶ ὅσοι αὐτὴν ᾔδεισαν πάντες.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.34",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.34",
    "language": "grc",
    "text": "ἀναστάντες δὲ οἱ πρεσβύτεροι καὶ κριταὶ ἐπέθηκαν τὰς χεῖρας αὐτῶν ἐπὶ τῆς κεφαλῆς αὐτῆς·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.35",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.35",
    "language": "grc",
    "text": "ἡ δὲ καρδία αὐτῆς ἐπεποίθει ἐπὶ Κυρίῳ τῷ θεῷ αὐτῆς, καὶ ἀνακύψασα ἔκλαυσεν ἐν αὐτῇ λέγουσα",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.35a",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.35a",
    "language": "grc",
    "text": "a Κύριε ὁ θεὸς ὁ αἰώνιος, ὁ εἰδὼς τὰ πάντα πρὶν γενέσεως αὐτῶν, σὺ οἶδας ὅτι οὐκ ἐποίησα ἃ πονηρεύονται οἱ ἄνομοι οὗτοι ἐπʼ ἐμοί. καὶ εἰσήκουσε Κύριος τῆς δεήσεως αὐτῆς.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.36",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.36",
    "language": "grc",
    "text": "οἱ δὲ δύο πρεσβύτεροι εἶπαν Ἡμεῖς περιεπατοῦμεν ἐν τῷ παραδείσῳ τοῦ ἀνδρὸς αὐτῆς,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.37",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.37",
    "language": "grc",
    "text": "καὶ κυκλοῦντες τὸ στάδιον εἵδομεν ταύτην ἀναπαυομένην μετὰ ἀνδρός, καὶ στάντες ἐθεωροῦμεν αὐτοὺς ὁμιλοῦντας ἀλλήλοις,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.38",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.38",
    "language": "grc",
    "text": "καὶ αὐτοὶ οὐκ ἤδεισαν ὅτι εἱστήκειμεν. τότε συνειπάμεθα ἀλλήλοις λέγοντες Μάθωμεν τίνες εἰσὶν οὗτοι.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.39",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.39",
    "language": "grc",
    "text": "καὶ προσελθόντες ἐπέγνωμεν αὐτὴν· ὁ δὲ νεανίσκος ἔφυγε συγκεκαλυμμένος.",
    "chunk_index": 28,
    "context_before": null,
