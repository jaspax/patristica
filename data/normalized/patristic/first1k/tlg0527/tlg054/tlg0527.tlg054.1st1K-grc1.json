    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.48",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.48",
    "language": "grc",
    "text": "διαστείλας δὲ Δανιὴλ τὸν ὄχλον καὶ στὰς ἐν μέσῳ αὐτῶν εἶπεν Οὕτως μωροί, υἱοὶ Ἰσραήλ; οὐκ ἀνακρίναντες οὐδὲ τὸ σαφές ἐπιγνόντες ἀπεκτείνατε θυγατέρα Ἰσραήλ;",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.51",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.51",
    "language": "grc",
    "text": "καὶ νῦν διαχωρίσατέ μοι αὐτοὺς ἀπʼ ἀλλήλων μακράν, ἵνα ἐτάσω αὐτούς.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.51a",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.51a",
    "language": "grc",
    "text": "a ὡς δὲ διεχωρίσθησαν, εἶπεν Δανιὴλ τῇ συναγωγῇ Νῦν μὴ βλέψητε ὅτι οὗτοί εἰσι πρεσβύτεροι, λέγοντες Οὐ μὴ ψεύσωνται· ἀλλὰ ἀνακρινῶ αὐτοὺς κατὰ τὰ ὑποπίπτοντά μοι.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.52",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.52",
    "language": "grc",
    "text": "καὶ ἐκάλεσε τὸν ἕνα αὐτῶν, καὶ προσήγαγον τὸν πρεσβύτερον τῷ νεωτέρῳ· καὶ εἶπεν αὐτῷ Δανιὴλ Ἅκουε ἄκουε, πεπαλαιωμένε ἡμερῶν κακῶν· νῦν ἥκασί σου αἱ ἁμαρτίαι ἃς ἐποίεις τὸ πρότερον,",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.53",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.53",
    "language": "grc",
    "text": "πιστευθεὶς ἀκούειν καὶ κρίνειν κρίσεις θάνατον ἐπιφερούσας, καὶ τὸν μέν ἀθῷον κατέκρινας, τοὺς δὲ ἐνόχους ἠφίεις, τοῦ κυρίου λέγοντος Ἀθῷον καὶ δίκαιον οὐκ ἀποκτενεῖς.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.54",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.54",
    "language": "grc",
    "text": "νῦν οὖν ὑπὸ τί δένδρον καὶ ποταπῷ τοῦ παραδείσου τόπῳ ἑώρακας αὐτοὺς ὄντας σὺν ἑαυτοῖς; καὶ εἶπεν ὁ ἀσεβής ῾ γπὸ σχῖνον.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.55",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.55",
    "language": "grc",
    "text": "εἶπεν δὲ ὁ νεώτερος Ὀρθῶς ἔψευσαι εἰς τὴν σεαυτοῦ ψυχήν· ὁ γὰρ ἄγγελος Κυρίου σχίσει σου τὴν ψυχὴν σήμερον.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.56",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.56",
    "language": "grc",
    "text": "καὶ τοῦτον μεταστήσας εἶπεν προσαγαγεῖν αὐτῷ τὸν ἕτερον· καὶ τούτῳ δὲ εἶπεν Διὰ τί διεστραμμένον τὸ σπέρμα σου, ὡς Σιδῶνος καὶ οὐχ ὡς Ἰούδα; τὸ κάλλος σε ἠπάτησεν, ἡ μικρὰ ἐπιθυμία.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.57",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.57",
    "language": "grc",
    "text": "καὶ οὕτως ἐποιεῖτε θυγατράσιν Ἰσραήλ, καὶ ἐκεῖναι φοβούμεναι ὡμιλοῦσαν ὑμῖν· ἀλλʼ οὐ θυγάτηρ Ἰούδα ὑπέμεινε τὴν νόσον ὑμῶν ἐν ἀνομίᾳ ὑπενεγκεῖν.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.58",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.58",
    "language": "grc",
    "text": "νῦν οὖν λέγε μοι ῾ γπὸ ὸ τί δένδρον καὶ ἐν ποίῳ τοῦ κήπου τόπῳ κατέλαβες αὐτοὺς ὁμιλοῦντας ἀλλήλοις; ὁ δὲ εἶπεν ῾ γπὸ πρῖνον.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.59",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.59",
    "language": "grc",
    "text": "καὶ εἶπεν Δανιὴλ Ἁμαρτωλέ, νῦν ὁ ἄγγελος Κυρίου τὴν ῥομφαίαν ἕστηκεν ἔχων, ἕως ὁ λαὸς ἐξολεθρεύσει ὑμᾶς, ἵνα καταπρίσῃ σε.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.60",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.60",
    "language": "grc",
    "text": "–62 Καὶ πᾶσα ἡ συναγωγὴ ἀνεβόησεν ἐπὶ τῷ νεωτέρῳ, ὡς ἐκ τοῦ ἰδίου στόματος ὁμολόγους αὐτοὺς κατέστησεν ἀμφοτέρους ψευδο- μάρτυρας· καὶ ὡς ὁ νόμος διαγορεύει ἐποίησαν αὐτοῖς, καθὼς ἐπονηρεύσαντο κατὰ τῆς ἀδελφῆς. καὶ ἐφίμωσαν αὐτοὺς καὶ ἐξαγαγόντες ἔρριψαν εἰς φάραγγα· τότε ὁ ἅγγελος Κυρίου ἔρριψε πῦρ διὰ μέσου αὐτῶν. καὶ ἐσώθη αἶμα ἀναίτιον ἐν τῇ ἡμέρᾳ ἐκείνῃ.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg054/1st1K-grc1#tlg0527.tlg054.1.62a",
    "work_id": "first1k/tlg0527/tlg054/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg054.1.62a",
    "language": "grc",
    "text": "ᵃΔιὰ τοῦτο οἱ νεώτεροι ἀγαπητοὶ Ἰακὼβ ἐν τῇ ἁπλότητι αὐτῶν.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
