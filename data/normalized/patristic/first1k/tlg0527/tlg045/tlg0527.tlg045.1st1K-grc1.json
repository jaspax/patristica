    "canonical_ref": "tlg0527.tlg045.2.11",
    "language": "grc",
    "text": "Τάδε λέγει Κύριος Παντοκράτωρ Ἐπερώτησον τοὺς ἱερεῖς νόμον λέγων",
    "chunk_index": 24,
    "context_before": null,
