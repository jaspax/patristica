[
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.1",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.1",
    "language": "grc",
    "text": "ΚAI ὁ βασιλεὺς Ἀστυάγης προσετέθη πρὸς τοὺς πατέρας αὐτοῦ, § καὶ παρέλαβεν Κῦρος ὁ Πέρσης τὴν βασιλείαν αὐτοῦ.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.2",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.2",
    "language": "grc",
    "text": "καὶ ἦν Δανιὴλ συνβιωτὴς τοῦ βασιλέως καὶ ἔνδοξος ὑπέρ πάντας τοὺς φίλους αὐτοῦ.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.3",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.3",
    "language": "grc",
    "text": "καὶ ἣν εἴδωλον τοῖς Βαβυλωνίοις ᾦ ὄνομα Βήλ, καὶ ἐδαπανῶντο εἰς αὐτὸν ἑκάστης ἡμέρας σεμιδάλεως ἀρτάβαι δώδεκα καὶ πρόβατα τεσσεράκοντα καὶ οἴνου μετρηταὶ ἕξ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.4",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.4",
    "language": "grc",
    "text": "καὶ ὁ βασιλεὺς ἐσέβετο αὐτόν, καὶ ἐπορεύετο καθʼ ἑκάστην ἡμέραν προσκυνεῖν αὐτῷ, Δανιὴλ δὲ προσεκύνει τῷ θεῷ αὐτοῦ· καὶ εἶπεν αὐτῷ ὁ βασιλεύς Διὰ τί οὐ προσκυνεῖς τῷ Βήλ;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.5",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.5",
    "language": "grc",
    "text": "ὁ δὲ εἶπ εν Ὅτι οὐ σέβομαι εἴδωλα χειροποίητα, ἀλλὰ τὸν ζῶντα θεόν, τὸν κτίσαντα τὸν οὐρανὸν καὶ τὴν γῆν καὶ ἔχοντα πάσης σαρκὸς κυρίαν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.6",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.6",
    "language": "grc",
    "text": "καὶ εἶπεν αὐτῷ ὁ βασιλεύς Οὐ δοκεῖ σοι Βὴλ εἶναι ζῶν θεός; ἡ οὐχ ὁρᾷς ὅσα ἐσθίει καὶ πίνει καθʼ ἑκάστην ἡμέραν ;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.7",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.7",
    "language": "grc",
    "text": "καὶ εἶπεν Δανιὴλ γελάσας Μὴ πλανῶ, βασιλεῦ· οὗτος γὰρ ἔσωθέν ἐστι πηλός, ἔξωθεν δὲ χαλκός, καὶ οὐ βέβρωκεν οὐδέποτε.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.8",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.8",
    "language": "grc",
    "text": "καὶ θυμωθεὶς ὁ βασιλεὺς ἐκάλεσεν τοὺς ἱερεῖς αὐτοῦ καὶ εἶπεν αὐτοῖς Ἐὰν μὴ εἵπητέ μοι τίς ὁ κατέσθων τὴν δαπάνην ταύτην, ἀποθανεῖσθε·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.9",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.9",
    "language": "grc",
    "text": "ἐὸν δὲ δείξητε ὅτι Βὴλ κατεσθίει αὐτά, ἀποθανεῖται Δανιὴλ, ὅτι ἐβλασφήμησεν εἰς τὸν Βήλ. καὶ εἶπεν Δανιὴλ τῷ βασιλεῖ Γινέσθω κατὰ τὸ ῥῆμά σου.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.10",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.10",
    "language": "grc",
    "text": "καὶ ἤσαν ἱερεῖς τοῦ Βὴλ ἑβδομήκοντα ἐκτὸς γυναικῶν καὶ τέκνων· καὶ ἦλθεν ὁ βασιλεὺς μετὰ Δανιὴλ εἰς τὸν οἶκον τοῦ Βήλ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.11",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.11",
    "language": "grc",
    "text": "καὶ εἶπαν οἰ ἱε- ρεῖς τοῦ Βήλ Ἰδοὺ ἡμεῖς ἀποτρέχομεν ἔξω, σὺ δέ, βασιλεῦ, παράθες τὰ βρώματα καὶ τὸν οἶνον κεράσας θές, καὶ ἀπόκλεισον τὴν θύραν καὶ σφράγισον τῷ δακτυλίῳ σου.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.12",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.12",
    "language": "grc",
    "text": "καὶ ἐλθὼν πρωὶ ἐὰν μὴ εὕρῃς πάντα βεβρωμένα ὑπὸ τοῦ Βήλ, ἀποθανούμεθα, ἡ Δανιὴλ ὁ ψευδόμένος καθʼ ἡμῶν.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.13",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.13",
    "language": "grc",
    "text": "αὐτοὶ δὲ κατεφρόνουν, ὅτι πεποιήκεισαν ὑπὸ τὴν τράπεζαν κεκρυμμένην εἴσοδον, καὶ δι᾿ αὐτῆς εἰσεπορεύοντο διόλου καὶ ἀνήλουν αὐτά.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.14",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.14",
    "language": "grc",
    "text": "καὶ ἐγένετο ὡς ἐξήλθοσαν ἐκεῖνοι, καὶ ὁ βασιλεὺς παρέθηκεν τὰ βρώματα τῷ Βήλ· καὶ ἐπέταξεν Δανιὴλ τοῖς παιδαρίοις αὐτοῦ καὶ ἤνεγκαν τέφραν, καὶ κατέσησαν ὅλον τὸν ναὸν ἐνώπιον τοῦ βασιλέως μόνου· καὶ ἐξελθόντες ἔκλεισαν τὴν θὑραν καὶ ἐσφραγίσαντο ἐν τῷ δακτυλίῳ τοῦ βασιλέως, καὶ ἀπῆλθον.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.15",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.15",
    "language": "grc",
    "text": "οἱ δὲ ἱερεῖς ἦλθον τὴν νύκτα κατὰ τὸ ἔθος αὐτῶν καὶ αἱ γυναῖκες καὶ τὰ τέκνα αὐτῶν, καὶ κατέφαγον πάντα καὶ ἐξέπιον.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.16",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.16",
    "language": "grc",
    "text": "καὶ ὤρθρίσεν ὁ βασιλεὺς πρωί, καὶ Δανιὴλ μετʼ αὐτοῦ.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.17",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.17",
    "language": "grc",
    "text": "καὶ εἶπεν Σῷοι αἱ σφραγῖδες, Δανιὴλ; ὁ δὲ εἶπεν Σῷοι, βασιλεῦ.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.18",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.18",
    "language": "grc",
    "text": "καὶ ἐγένετο ἄμα τῷ ἀνοῖξαι τὰς θύρας, ἐπιβλέψας ὁ βασιλεὺς ἐπὶ τὴν τράπεζαν ἐβόησεν φωνῇ μεγάλῃ Μέγας εἶ, Βήλ, καὶ οὐκ ἔστιν παρὰ σοὶ δόλος οὐδὲ εἰς.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.19",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.19",
    "language": "grc",
    "text": "καὶ ἐγέλασεν Δανιὴλ, καὶ ἐκράτησεν τὸν βασιλέα τοῦ μὴ εἰσελθεῖν αὐτὸν ἔσω, καὶ εἶπ εν Ἴδε δὴ τὸ ἔδαφος καὶ γνῶθι τίνος τὰ ἴχνη ταῦτα.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.20",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.20",
    "language": "grc",
    "text": "καὶ εἶπεν ὁ βασιλεύς Ὁρῶ τὰ ἴχνη ἀνδρῶν καὶ § γυναικῶν καὶ παιδίων.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.21",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.21",
    "language": "grc",
    "text": "καὶ ὀργισθεὶς ὁ βασιλεὺς τότε συνέλαβεν τοὺς ἱερεῖς καὶ τὰς γυναῖκας καὶ τὰ τέκνα αὐτῶν, καὶ ἔδειξαν αὐτῷ τὰς κρυπτὰς θύρας δι ὅν εἰσεπορεύοντο καὶ ἐδαπάνων τὰ ἐπὶ τῇ τραπέζῃ.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.22",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.22",
    "language": "grc",
    "text": "καὶ ἀπέκτεινεν αὐτοὺς ὁ βασιλεύς, καὶ ἔδωκεν τὸν Βήλ ἔκδοτον τῷ Δανιὴλ· καὶ κατέστρεψεν αὐτὸν καὶ τὸ ἱερὸν αὐτοῦ.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.23",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.23",
    "language": "grc",
    "text": "Καὶ ἦν δράκων μέγας, καὶ ἐσέβοντο αὐτὸν οἱ Βαβυλώνιοι.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.24",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.24",
    "language": "grc",
    "text": "καὶ εἶπεν ὁ βασιλεὺς τῷ Δανιὴλ Οὐ δύνασαι εἰπεῖν ὅτι οὐκ ἔστιν οὗτος θεὸς ζῶν· καὶ προσκύνησον αὐτῷ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.25",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.25",
    "language": "grc",
    "text": "καὶ εἶπεν Δανιὴλ Κυρίῳ τῷ θεῷ μου προσκυνήσω, ὅτι· οὗτός ἐστιν θεὸς ζῶν·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.26",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.26",
    "language": "grc",
    "text": "οὺ δέ, βασιλεῦ, δός μοι ἐξουσίαν, καὶ ἀποκτενῶ τὸν δράκοντα ἄνευ μαχαίρας καὶ ῥάβδου. καὶ εἶπεν ὁ βασιλεύς Δίδωμί σοι.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg059/1st1K-grc1#tlg0527.tlg059.1.27",
    "work_id": "first1k/tlg0527/tlg059/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg059.1.27",
    "language": "grc",
    "text": "καὶ ἔλαβεν Δανιὴλ πίσσαν καὶ στῆρ καὶ τρίχας, καὶ ἥψησεν ἐπὶ τὸ αὐτὸ καὶ ἐποίησεν μάζας, καὶ ἔδωκεν εἰς τὸ στόμα τοῦ δράκοντος· καὶ φαγὼν διερράγη ὁ δράκων. καὶ εἶπεν Ἵδετε τὰ σεβάσματα ὑμῶν.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
