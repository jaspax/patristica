    "canonical_ref": "tlg0527.tlg058.1.22",
    "language": "grc",
    "text": "καὶ ἐξήγαγεν αὐτοὺς ὁ βασιλεὺς ἐκ τοῦ Βηλίου, καὶ παρέδωκεν αὐτοὺς τῷ Δανιὴλ· καὶ τὴν δαπάνην τὴν εἰς αὐτὸν ἔδωκε τῷ Δανιὴλ, τὸν δὲ Βὴλ κατέστρεψε.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
