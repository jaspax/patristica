    "work_id": "first1k/tlg0527/tlg058/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg058.1.2",
    "language": "grc",
    "text": "Ἄνθρωπός τις ἧν ἱερεύς, ᾧ ὄνομα Δανιὴλ, υἱὸς Ἁβάλ, συμβιωτὴς τοῦ βασιλέως Βαβυλῶνος.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
