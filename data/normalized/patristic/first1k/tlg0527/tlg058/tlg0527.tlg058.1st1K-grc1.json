    "work_id": "first1k/tlg0527/tlg058/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg058.1.24",
    "language": "grc",
    "text": "καὶ εἶπεν ὁ βασιλεὺς τῷ Δανιὴλ Μὴ καὶ τοῦτον ἐρεῖς ὅτι χαλκοῦς ἐστιν; ἰδοὺ ζῇ καὶ ἐσθίει καὶ πίνει, προσκύνησον αὐτῷ.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
