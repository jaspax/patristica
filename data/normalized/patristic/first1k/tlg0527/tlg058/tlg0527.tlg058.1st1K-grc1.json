  {
    "chunk_id": "first1k/tlg0527/tlg058/1st1K-grc1#tlg0527.tlg058.1.26",
    "work_id": "first1k/tlg0527/tlg058/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg058.1.26",
    "language": "grc",
    "text": "καὶ εἶπεν Δανιὴλ Βασιλεῦ, δός μοι τὴν ἐξουσίαν, καὶ ἀνελῶ τὸν δράκοντα ἄνευ σιδήρου καὶ ῤάβδου. καὶ συνεχώρησεν αὐτῷ ὁ βασιλεὺς καὶ εἶπεν αὐτῷ Δέδοταί σοι.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
