    "work_id": "first1k/tlg0527/tlg058/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg058.1.23",
    "language": "grc",
    "text": "Καὶ ἣν δράκων ἐν τῷ αὐτῷ τόπῳ, καὶ ἐσέβοντο οἱ Βαβυλώνιοι.",
    "chunk_index": 18,
    "context_before": null,
