  },
  {
    "chunk_id": "first1k/tlg0527/tlg058/1st1K-grc1#tlg0527.tlg058.1.19",
    "work_id": "first1k/tlg0527/tlg058/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg058.1.19",
    "language": "grc",
    "text": "καὶ ἐγέλασε Δανιὴλ σφόδρα καὶ εἶπεν τῷ βασιλεῖ Δεῦρο ἴδε τὸν δόλον τῶν ἱερέων. καὶ εἶπεν Δανιὴλ Βασιλεῦ, ταῦτα τὰ ἴχνη τίνος ἐστί",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
