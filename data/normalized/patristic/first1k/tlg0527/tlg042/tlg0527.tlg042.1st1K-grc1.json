[
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.1",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.1",
    "language": "grc",
    "text": "ΑΗΜΜA Νινευή, βιβλίον ὁράσεως Ναοὺμ τοῦ Ἐλκεσαίου.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.2",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.2",
    "language": "grc",
    "text": "Θεὸς ζηλωτὴς καὶ ἐκδικῶν Κύριος μετὰ θυμοῦ, ἐκδικῶν Κύριος τοὺς ὑπεναντίους αὐτοῦ, καὶ ἐξαίρων αὐτὸς τοὺς ἐχθροὺς αὐτοῦ.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.3",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.3",
    "language": "grc",
    "text": "Κύριος μακρόθυμος. καὶ μεγάλη ἡ ἰσχὺς αὐτοῦ, καὶ ἀθῷον οὐκ ἀθῳώσει Κύριος· ἐν συντελείᾳ καὶ ἐν συνσεισμῷ ἡ ὁδὸς αὐτοῦ, καὶ νεφέλαι κονιορτὸς ποδῶν αὐτοῦ·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.4",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.4",
    "language": "grc",
    "text": "ἀπειλῶν θαλάσσῃ καὶ ξηραίνων αὐτήν, καὶ πάντας τοὺς ποταμοὺς ἐξερημῶν. ὀλιγώθη ἡ Βασανῖτις καὶ ὁ Κάρμηλος, καὶ τὰ ἐξανθοῦντα τοῦ Λιβάνου ἐξέλιπεν·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.5",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.5",
    "language": "grc",
    "text": "τὰ ὄρη ἐσείσθησαν ἀπʼ αὐτοῦ, καὶ οἱ βουνοὶ ἐσαλεύθησαν· καὶ ἀνεστάλη ἡ γῆ ἀπὸ προσώπου αὐτοῦ ἡ σύμπασα, καὶ πάντες οἱ κατοικοῦντες ἐν αὐτῇ.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.6",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.6",
    "language": "grc",
    "text": "ἀπὸ προσώπου ἀργῆς αὐτοῦ τίς ὑποστήσεται; καὶ τίς ἀντιστήσεται ἐν ὀργῇ θυμοῦ αὐτοῦ; ὁ θυμὸς αὐτοῦ τήκει ἀρχάς, καὶ αἱ πέτραι διεθρύβησαν ἀπʼ αὐτοῦ.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.7",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.7",
    "language": "grc",
    "text": "χρηστὸς Κύριος τοῖς ὑπομένουσιν αὐτὸν ἐν ἡμέρᾳ θλίψεως, καὶ γινώσκων τοὺς εὐλαβουμένους αὐτόν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.8",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.8",
    "language": "grc",
    "text": "καὶ ἐν κατακλυσμῷ πορείας συντέλειαν ποιήσεται, τοὺς ἐπεγειρομένους καὶ τοὺς ἐχθροὺς αὐτοῦ διώξεται σκότος.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.9",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.9",
    "language": "grc",
    "text": "τί λογίζεσθε ἐπὶ τὸν κύριον; συντέλειαν αὐτὸς ποιήσεται, οὐκ ἐκδικήσει δὶς ἐπὶ τὸ αὐτὸ ἐν θλίψει·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.10",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.10",
    "language": "grc",
    "text": "ὅτι ἕως θεμελίου αὐτοῦ χερσωθήσεται, καὶ ὡς σμῖλαξ περιπλεκομένη βρωθήσεται, καὶ ὡς καλάμη ξηρασίας μεστή.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.11",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.11",
    "language": "grc",
    "text": "ἐκ σοῦ ἐξελεύσεται λογισμὸς κατὰ τοῦ κυρίου πονηρά, βουλευόμενος ἐναντία.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.12",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.12",
    "language": "grc",
    "text": "τάδε λέγει Κύριος κατάρχων ὑδάτων πολλῶν Καὶ οὕτως διασταλήσονται, καὶ ἡ ἀκοὴ σου οὐκ ἐνακουσθήσεται ἔτι.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.13",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.13",
    "language": "grc",
    "text": "καὶ νῦν συντρίψω τὴν ῥάβδον αὐτοῦ ἀπὸ σοῦ, καὶ τοὺς δεσμοὺς διαρήξω·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.14",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.14",
    "language": "grc",
    "text": "καὶ ἐντελεῖται ὑπέρ σοῦ Κύριος, οὐ σπαρήσεται ἐκ τοῦ ὀνόματός σου ἔτι· ἐξ οἴκου θεοῦ σου ἐξολεθρεύσω τὰ γλυπτά, καὶ χωνευτὰ θήσομαι ταφὴν σου· ὅτι ταχεῖς.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.1.15",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.1.15",
    "language": "grc",
    "text": "δοὺ ἐπὶ τὰ ὄρη οἱ πόδες εὐαγγελιζομένου καὶ ἀπαγγέλλοντος εἰρήνην· ἑόρταζε, Ἰούδα, τὰς ἑορτάς σου, ἀπόδος τὰς εὐχάς σου, διότι οὐ μὴ προσθήσωσιν ἔτι τοῦ διελθεῖν διὰ σοῦ εἰς παλαίωσιν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.1",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.1",
    "language": "grc",
    "text": "Συντετέλεσται, ἐξῆρται·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.2",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.2",
    "language": "grc",
    "text": "ἀνέβη ἐμφυσῶν εἰς πρόσωπόν σου, ἐξαιρούμενος ἐκ θλίψεως. σκόπευσον ὁδόν, κράτησον ὀσφύος, ἄνδρισαι τῇ ἰσχύι σφόδρα·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.3",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.3",
    "language": "grc",
    "text": "διότι ἀπέστρεψεν Κύριος τὴν ὕβριν Ἰακὼβ καθὼς ὕβριν τοῦ Ἰσραήλ, διότι ἐκτινάσσοντες ἐξετίναξαν αὐτοὺς καὶ τὰ κλήματα αὐτῶν διέφθειραν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.4",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.4",
    "language": "grc",
    "text": "ὅπλα δυναστείας αὐτῶν ἐξ ἀνθρώπων, ἄνδρας δυνατοὺς ἐμπαίζοντας ἐν πυρί αἱ ἡνίαι τῶν ἁρμάτων αὐτῶν ἐν ἡμέρᾳ ἑτοιμασίας αὐτοῦ, καὶ οἱ ἱππεῖς θορυβηθήσονται",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.5",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.5",
    "language": "grc",
    "text": "ἐν ταῖς ὁδοῖς, καὶ συγχυθήσονται τὰ ἄρματα καὶ συνπλακήσονται ἐν ταῖς πλατείαις· ἡ ὅρασις αὐτῶν ὡς λαμπάδες πυρὸς καὶ ὡς ἀστραπαὶ διατρέχουσαι.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.6",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.6",
    "language": "grc",
    "text": "καὶ μνησθήσονται οἱ μεγιστᾶνες αὐτῶν, καὶ φεύξονται ἡμέρας καὶ ἀσθενήσουσιν ἐν τῇ πορίᾳ αὐτῶν, καὶ σπεύσουσιν ἐπὶ τὰ τείχη αὐτῆς καὶ ἑτοιμάσουσιν τὰς προφυλακὰς αὐτῶν.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.7",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.7",
    "language": "grc",
    "text": "πύλαι τῶν πόλεων διηνοίχθησαν, καὶ τὰ βασίλεια διέπεσεθ,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.8",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.8",
    "language": "grc",
    "text": "καὶ ἡ ὑπόστασις ἀπεκαλύφθη· καὶ αὕτη ἀνέβαινεν καὶ αἱ δοῦλαι αὐτῆς ἥγοντο καθὼς περιστεραὶ φθεγγόμεναι ἐν καρδίαις αὐτῶν.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.9",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.9",
    "language": "grc",
    "text": "καὶ Νινευή, ὡς κολυμβήθρα ὕδατος τὰ ὕδατα αὐτῆς, καὶ αὐτοὶ φεύγοντες οὐκ ἔστησαν, καὶ οὐκ ἣν ὁ ἐπιβλέπων.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.10",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.10",
    "language": "grc",
    "text": "διήρπασαν τὸ ἀργύριον, διήρπαζον τὸ χρυσίον, καὶ οὐκ ἦν πέρας τοῦ κόσμου αὐτῆς· βεβάρυνται ἐπὶ πάντα σκεύη τὰ ἐπιθυμητὰ αὐτῆς.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.11",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.11",
    "language": "grc",
    "text": "ἐκτιναγμὸς καὶ ἀνατιναγμός, καὶ ἐκβραγμὸς καὶ καρδίας θραυσμός, καὶ ὑπόλυσις γονάτων καὶ ὠδῖυες ἐπὶ πᾶσαν ὀσφύν, καὶ τὸ πρόσωπον πάντων ὡς πρόσκαυμα χύτρας.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.12",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.12",
    "language": "grc",
    "text": "ποῦ ἐστιν τὸ κατοικητήριον τῶν λεόντων, καὶ ἡ νομὴ ἡ οὖσα τοῖς σκύμνοις ; ποῦ ἐπορεύθη λέων τοῦ εἰσελθεῖν ἐκεῖ σκύμνον λέοντος, καὶ οὐκ ἦν ὁ ἐκφοβῶν;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.13",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.13",
    "language": "grc",
    "text": "λέων ἥρπασεν τὰ ἱκανὰ τοῖς σκύμνοις αὐτοῦ καὶ ἀπέπνιξεν τοῖς λέουσιν αὐτοῦ, καὶ ἔπλησεν θήρας νοσσιὰν αὐτοῦ καὶ τὸ κατοικητήριον αὐτοῦ ἁρπαγῆς.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.2.14",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.2.14",
    "language": "grc",
    "text": "ἰδοὺ ἐγὼ ἐπὶ σέ, λέγει Κύριος Παντοκράτωρ, καὶ ἐκκαύσω ἐν καπνῷ πλῆθός σου, καὶ τοὺς λέοντάς σου καταφάγεται ῥομφαία, καὶ ἐξολεθρεύσω ἐκ τῆς γῆς τὴν θήραν σου, καὶ οὐ μὴ ἀκουσθῇ οὐκέτι τὰ ἔργα σου.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.1",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.1",
    "language": "grc",
    "text": "Ὦ πόλις αἱμάτων, ὅλη ψευδής, ἀδικίας πλήρης, οὐ ψηλαφηθῇσεται θήρα.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.2",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.2",
    "language": "grc",
    "text": "φωνὴ μαστίγων καὶ φωνὴ σεισμοῦ τροχῶν, καὶ ἵππου διώκοντος καὶ ἅρματος ἀναβράσσοντος,",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.3",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.3",
    "language": "grc",
    "text": "καὶ ἱππέως ἀναβαίνοντος καὶ στιλβούσης ῥομφαίας καὶ ἐξαστραπτόντων ὅπλων, καὶ πλήθους τραυματιῶν καὶ βαρείας πτώσεως, καὶ οὐκ ἦν πέρας τοῖς ἔθνεσιν αὐτῆς· καὶ ἀσθενήσουσιν ἐν τοῖς σώμασιν αὐτῶν ἀπὸ πλήθους πορνείας.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.4",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.4",
    "language": "grc",
    "text": "πόρνη καλὴ καὶ ἐπιχαρής, ἡγουμένη φαρμάκων, ἡ πωλοῦσα ἔθνη ἐν τῇ πορνείᾳ αὐτῆς καὶ λαοὺς ἐν τοῖς φαρμάκοις αὐτῆς.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.5",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.5",
    "language": "grc",
    "text": "ἰδοὺ ἐγὼ ἐπὶ σέ, λέγει Κύριος ὁ θεὸς ὁ παντοκράτωρ, καὶ ἀποκαλύψω τὰ ὀπίσω σου ἐπὶ τὸ πρόσωπόν σου, καὶ δείξω ἔθνεσιν τὴν αἰσχύνην σου καὶ βασιλείαις τὴν ἀτιμίαν σου·",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.6",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.6",
    "language": "grc",
    "text": "καὶ ἐπιρίψω ἐπὶ σέ βδελυγμὸν κατὰ τὰς ἀκαθαρσίας σου, καὶ θήσομαί σε εἰς παράδειγμα·",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.7",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.7",
    "language": "grc",
    "text": "καὶ ἔσται πᾶς ὁ ὁρῶν σε καταβήσεται ἀπὸ σοῦ καὶ ἐρεῖ Δειλαία Νινευή· τίς στενάξει αὐτήν ; πόθεν ζητήσω παράκλησιν αὐτῇ;",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.8",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.8",
    "language": "grc",
    "text": "ἑτοίμασαι μερίδα, ἅρμόσοι χορδήν, ἑτοίμασαι μερίδα, Ἄμμων, ἡ κατοικοῦσα ἐν ποταμοῖς· ὕδωρ κύκλῳ αὐτῆς, ἧς ἡ ἀρχὴ θάλασσα καὶ ὕδωρ τὰ τείχη αὐτῆς.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.9",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.9",
    "language": "grc",
    "text": "καὶ Αἰθιοπία ἰσχὺς αὐτῆς καὶ Aἵγυπτος, καὶ οὐκ ἔστιν πέρας τῆς φυγῆς, καὶ Λίβυες ἐγένοντο βοηθοὶ αὐτῆς.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.10",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.10",
    "language": "grc",
    "text": "καὶ αὐτὴ εἰς μετοικεσίαν πορεύσεται αἰχμάλωτος, καὶ τὰ νήπια αὐτῆς ἐδαφιοῦσιν ἐπʼ ἀρχὰς πασῶν τῶν ὁδῶν αὐτῆς, καὶ ἐπὶ πάντα τὰ ἔνδοξα αὐτῆς βαλοῦσιν κλήρους. καὶ πάντες οἱ μεγιστᾶνες αὐτῆς δεθήσονται χειροπέδαις.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.11",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.11",
    "language": "grc",
    "text": "καὶ σὺ μεθυσθήσῃ καὶ ἔσῃ ὑπερεαωραμένη, καὶ σὺ ζητήσεις σεαυτῇ στάσιν ἐξ ἐχθρῶν.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.12",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.12",
    "language": "grc",
    "text": "πάντα τὰ ὐχυρώματά σου συκαῖ σκοποὺς ἔχουσαι· ἐὰν σαλευθῶσιν, πεσοῦνται εἰς στόμα ἕσθοντος.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.13",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.13",
    "language": "grc",
    "text": "ἰδοὺ ὁ λαός σου ὡς γυναῖκες ἐν σοί· τοῖς ἐχθροῖς σου ἀνοιγόμεναι ἀνοιχθήσονται πύλαι τῆς γῆς σου, καταφάγεται πῦρ τοὺς μοχλούς σου.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.14",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.14",
    "language": "grc",
    "text": "ὕδωρ περιοχῆς ἐπίσπασαι σεαυτῇ, καὶ κατακράτησον τῶν ὀχυρωμάτων σου· ἔμβηθι εἰς πηλὸν καὶ συμπατήθητι ἐν ἀχύροις, κατακράτησον ὑπέρ πλίνθον·",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.15",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.15",
    "language": "grc",
    "text": "ἐκεῖ καταφάγεταί σε πῦρ, ἐξολεθρεύσει σε ῥομφαία, καταφάγεταί σε ὡς ἀκρίς, καὶ βαρυνθήσει ὡς βροῦχος.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.16",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.16",
    "language": "grc",
    "text": "ἐπλήθυνας τὰς ἐμπορίας σου ὑπέρ τὰ ἄστρα τοῦ οὐρανοῦ· βροῦχος ὥρμησεν καὶ ἐξεπετάσθη.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.17",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.17",
    "language": "grc",
    "text": "ἐξήλατο ὡς ἀττέλεβος ὁ συμμικτός σου, ὡς ἀκρὶς ἐπιβεβηκυῖα ἐπὶ φραγμὸν ἐν ἡμέρᾳ πάγους· ὁ ἥλιος ἀνέτειλεν, καὶ ἀφήλατο, καὶ οὐκ ἔγνω τὸν τόπον αὐτῆς. οὐαὶ αὐτοῖς.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.18",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.18",
    "language": "grc",
    "text": "ἐνύσταξαν οἱ ποιμένες σου, βασιλεὺς Ἀσσύριος ἐκοίμισεν τοὺς δυνάστας σου· ἀπῆρεν ὁ λαός σου ἐπὶ τὰ ὄρη, καὶ οὐκ ἦν ὁ ἐκδεχόμενος.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg042/1st1K-grc1#tlg0527.tlg042.3.19",
    "work_id": "first1k/tlg0527/tlg042/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg042.3.19",
    "language": "grc",
    "text": "οὐκ ἔστιν ἴασις τῇ συντριβῇ σου, ἐφλέγμανεν ἡ πληγή σου· πάντες οἱ ἀκούοντες τὴν ἀγγελίαν σου κροτήσουσιν χεῖρας ἐπὶ σέ· διότι ἐπὶ τίνα οὐκ ἐπῆλθεν ἡ κακία σου διὰ παντός;",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
