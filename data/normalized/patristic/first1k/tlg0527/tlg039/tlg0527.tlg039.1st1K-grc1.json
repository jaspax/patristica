[
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.1",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.1",
    "language": "grc",
    "text": "ΛΟΓΟΣ ΟΣ Κυρίου ὃς ἐγενήθη πρὸς Ἰωήλ τὸν τοῦ Βαθουήλ.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.2",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.2",
    "language": "grc",
    "text": "Ἀκούσατε ταῦτα, οἱ πρεσβύτεροι, καὶ ἐνωτίσασθε, πάντες οἱ κατοικοῦντες τὴν γῆν. εἰ γέγονεν τοιαῦτα ἐν ταῖς ἡμέραις ἡμῶν, ἤ ἐν ταῖς ἡμέραις τῶν πατέρων ὑμῶν;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.3",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.3",
    "language": "grc",
    "text": "ὑπέρ αὐτῶν τοῖς τέκνοις ὑμῶν διηγήσασθε, καὶ τὰ τέκνα ὑμῶν τοῖς τέκνοις αὐτῶν, καὶ τὰ τέκνα αὐτῶν εἰς γενεὰν ἑτέραν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.4",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.4",
    "language": "grc",
    "text": "τὰ κατάλοιπα τῆς κάμπης κατέφαγεν ἡ ἀκρίς, καὶ τὰ κατάλοιπα τῆς ἀκρίδος κατέφαγεν ὁ βροίχος, καὶ τὰ κατάλοιπα τοῦ βρούχου κατέφαγεν ἡ ἐρυσίβη.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.5",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.5",
    "language": "grc",
    "text": "Ἐκνήψατε, οἱ μεθύοντες, ἐξ οἴνου αὐτῶν καὶ κλαύσατε· θρηνήσατε, πάντες οἱ πί νοντες οἶνον, εἰς μέθην, ὅτι ἐξήρθη ἐκ στόματος ὑμῶν εὐφροσύνη καὶ χαρά.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.6",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.6",
    "language": "grc",
    "text": "ὅτι ἔθνος ἀνέβη ἐπὶ τὴν γῆν μου ἰσχυρὸν καὶ ἀναρίθμητον, οἱ ὀδόντες αὐτοῦ ὀδόντες λέοντος, καὶ αἱ μύλαι αὐτοῦ σκύμνου·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.7",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.7",
    "language": "grc",
    "text": "ἔθετο τὴν ἄμπελόυ μου εἰς ἀφανισμόν, καὶ τὰς συκᾶς μου εἰς συνκλασμόν· ἐρευνῶν ἐξηρεύνησεν αὐτὴν καὶ ἔριψεν, ἐλεύκανεν τὰ κλήματα αὐτῆς.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.8",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.8",
    "language": "grc",
    "text": "θρήνησον πρὸς μέ ὑπέρ νύμφην περιεζωσμένην σάκκον ἐπὶ τὸυ ἄνδρα αὐτῆς τὸν παρθενικοῦ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.9",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.9",
    "language": "grc",
    "text": "ἐξῆρταιθυσία καὶ σπονδὴ ἐξ οἵκου Κυρίου· πενθεῖτε, ἱερεῖς οἱ λειτουργοῦντες θυσιαστηρίῳ.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.10",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.10",
    "language": "grc",
    "text": "ὅτι τεταλαιπόρηκεν τὰ πεδία, πενθείτω ἡ γῆ· ὅτι τεταλαιπώρηκεν σῖτος, ἐξηράνθη οἶνος, ὠλιγώθη ἔλαιον,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.11",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.11",
    "language": "grc",
    "text": "ἐξηράνθησαν γεωργοί· θρηνεῖτε, κτήματα, ὑπέρ πυροῦ καὶ κριθῆς, ὅτι ἀπόλωλεν τρυγητὸς ἐξ ἀγροῦ·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.12",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.12",
    "language": "grc",
    "text": "ἡ ἄμπελος ἐξηράνθη, καὶ αἱ συκαῖ ὠλιγώθησαν· ῥοὰ καὶ φοίνιξ καὶ μῆλον καὶ πάντα τὰ ξύλου ἀγροῦ ἐξηράνθησαν, ὅτι ἤσχυναν χαρὰν οἱ υἱοὶ τῶν ἀνθρώπων.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.13",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.13",
    "language": "grc",
    "text": "περιζώσασθε καὶ κόπτεσθε οἱ ἱερεῖς, θρηνεῖτε οἱ λειτουργοῦντες ἡυσιαστηρίῳ· εἰσέλθατε, ὑπνώσατε ἐν σάκκοις, λειτουργοῦντες θεῷ, ὅτι ἀπέσχηκεν ἐξ οἵκου θεοῦ ὑμῶν θυσία καὶ σπονδή.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.14",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.14",
    "language": "grc",
    "text": "ἁγιάσατε υηστείαν, κηρύξατε θεραπείαν, συναγάγετε πρεσβυτέρους, πάντας κατοικοῦντας γῆν εἰς οἶκον θεοῦ ὑμῶν, καὶ κεκράξατε πρὸς Κύριον ἐκτενῶς",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.15",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.15",
    "language": "grc",
    "text": "Οἵμοι οἵμοι ομοι εἰς ἡμέραν, ὅτι ἐγγὺς ἡμέρα Κυρίου, καὶ ὡς ταλαιπαωρία ἐκ ταλαιπαωρίας ἤξει.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.16",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.16",
    "language": "grc",
    "text": "κατέναντι τῶν ὀφθαλμῶν ὑμῶν βρώματα ἐξωλεθρεύθη, ἐξ οἵκου θεοῦ ὑμῶν εὐφροσύνη καὶ χαρά.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.17",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.17",
    "language": "grc",
    "text": "ἐσκίρτησαν δαμάλεις ἐπὶ ταῖς φάτναις αὐτῶν, ἠφανίσθησαν θησαυροί, κατεσκάφησαν ληνοί, ὅτι ἐξηράνθη σῖτος.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.18",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.18",
    "language": "grc",
    "text": "τί ἀποθήσομεν ἑαυτοῖς; ἔκλαυσαν βουκόλια βοῶν, ὅτι οὐχ ὑπῆρχεν νομὴ αὐτοῖς, καὶ τὰ ποίμνια τῶν προβάτων ἠφανίσθησαν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.19",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.19",
    "language": "grc",
    "text": "πρὸς σέ, Κύριε, βοήσομαι, ὅτι πῦρ ἀνήλωσεν τὰ ὡραῖα τῆς ἐρήμου, καὶ φλὸξ ἀνῆψεν πάντα τὰ ξύλα τοῦ ἀγροῦ·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.1.20",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.1.20",
    "language": "grc",
    "text": "καὶ τὰ κτήνη τοῦ πεδίου ἀνέβλεψαν πρὸς σέ· ὅτι ἐξηράνθησαν ἀφέσεις ὑδάτων, καὶ πῦρ κατέφαγεν τὰ ὡραῖα τῆς ἐρήμου.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.1",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.1",
    "language": "grc",
    "text": "Σαλπίσατε σάλπιγγι ἐν Σειών, κηρύξατε ἐν ὄρει ἁγίῳ μου, καὶ συγχυθήτωσαν πάντες οἱ κατοικοῦντες τὴν γῆν, διότι πάρεστιν ἡμέρα Κυρίου, ὅτι ἐγγύς·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.2",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.2",
    "language": "grc",
    "text": "ἡμέρα σκότους καὶ γνόφου, ἡμέρα νεφέλης καὶ ὁμίχλης. ὡς ὄρθρος χυθήσεται ἐπὶ τὰ ὄρη λαὸς πολὺς καὶ ἰσχυρός· ὅμοιος αὐτῷ οὐ γέγονεν ἀπὸ τοῦ αἰῶνος, καὶ μετʼ αὐτὸν οὐ προστεθήσεται ἕως ἐτῶν εἰς γενεὰς γενεῶν.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.3",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.3",
    "language": "grc",
    "text": "τὰ ἔμπροσθεν αὐτοῦ πῦρ ἀναλίσκον, καὶ τὰ ὀπίσω αὐτοῦ ἀναπτομένη φλόξ· ὡς παράδεισος τρυφῆς ἡ γῆ πρὸ προσώπου αὐτοῦ, καὶ τὰ ὄπισθεν αὐτοῦ πεδίον αφανισμοῦ, καὶ ἀνασωζόμενος οὐκ ἔσται αὐτῷ.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.4",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.4",
    "language": "grc",
    "text": "ὁὡς ὅρασις ἵππων ἡ ὅρασις αὐτῶν, καὶ ὡς ἱππεῖς οὕτως καταδιώξονται·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.5",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.5",
    "language": "grc",
    "text": "ὡς φωνὴ ἁρμάτων ἐπὶ τὰς κορυφὰς τῶν ὀρέων ἐξαλοῦνται, καὶ ὡς φωνὴ φλογὸς πυρὸς κατεσθιούσης καλάμην, καὶ ὡς λαὸς πολὺς καὶ ἰσχυρὸς παρατασσόμενος εἰς πόλεμον.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.6",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.6",
    "language": "grc",
    "text": "ἀπὸ προσώπου αὐτοῦ συντριβήσονται λαοί, πᾶν πρόσαωπον ὡς πρόσκαυμα χύτρας.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.7",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.7",
    "language": "grc",
    "text": "ὼς μαχηταὶ δραμοῦνται, καὶ ὡς ἄνδρες πολεμισταὶ ἀναβήσονται ἐπὶ τὰ τείχη. καὶ ἕκαστος ἐν τῇ ὁδῷ αὐτοῦ πορεύσεται, καὶ οὐ μὴ ἐκκλίνωσιν τὰς τρίβους αὐτῶν,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.8",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.8",
    "language": "grc",
    "text": "καὶ ἕκαστος ἀπὸ τοῦ ἀδελφοῦ αὐτοῦ οὐκ ἀφέξεται· καταβαρυνόμενοι ἐν τοῖς ὅπλοις αὐτῶν πορεύσονται, καὶ ἐν τοῖς βέλεσιν αὐτῶν πεσοῦνται, καὶ οὐ μὴ συντελεσθῶσιν.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.9",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.9",
    "language": "grc",
    "text": "τῆς πόλεως ἐπιλήμψονται, καὶ ἐπὶ τῶν τειχέων δραμοῦνται, καὶ ἐπὶ ταῖς οἰκίαις ἀναβήσονται, καὶ διὰ θυρίδων εἰσελεύσονται ὡς κλέπται.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.10",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.10",
    "language": "grc",
    "text": "πρὸ προσώπου αὐτοῦ συγχυθήσεται ἡ γῆ καὶ σεισθήσεται ὁ οὐρανός, ὁ ἥλιος καὶ ἡ σελήνη συσκοτάσουσιν, καὶ τὰ ἄστρα δύσουσιν τὸ φέγγος αὐτῶν.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.11",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.11",
    "language": "grc",
    "text": "καὶ Κύριος δώσει φωνὴν αὐτοῦ πρὸ προσώπου δυνάμεως αὐτοῦ, ὅτι πολλή ἐστιν σφόδρα ἡ παρεμβολὴ αὐτοῦ, ὅτι ἰσχυρὰ ἔργα λόγων αὐτοῦ· διότι μεγάλη ἡμέρα τοῦ κυρίου, μεγάλη καὶ ἐπιφανὴς σφόδρα, καὶ τίς ἔσται ἱκανὸς αὐτῇ;",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.12",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.12",
    "language": "grc",
    "text": "καὶ νῦν λέγει Κύριος ὁ θεὸς ὑμῶν Ἐπιστράφητε πρὸς μέ ἐξ ὅλης τῆς καρδίας ὑμῶν καὶ ἐν νηστείᾳ καὶ ἐν κλαυθμῷ καὶ ἐν κοπετῷ,",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.13",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.13",
    "language": "grc",
    "text": "καὶ διαρήξατε τὰς καρδίας ὑμῶν καὶ μὴ τὰ ἱμάτια ὑμῶν, καὶ ἐπιστράφητε πρὸς Κύριον τὸν θεὸν ὑμῶν, ὅτι ἐλεήμαων καὶ οἰκτίρμων ἐστίν, μακρόθυμος καὶ πολυέλεος καὶ μετανοῶν ἐπὶ ταῖς κακίαις.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.14",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.14",
    "language": "grc",
    "text": "τίς οἶδεν εἰ ἐπιστρέψει καὶ μετανοήσει, καὶ ὑπολείψεται ὀπίσω αὐτοῦ εὐλογίαν, θυσίαν καὶ σπονδὴν Κυρίῳ τῷ θεῷ ἡμῶν;",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.15",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.15",
    "language": "grc",
    "text": "Σαλπίσατε σάλπιγγι ἐν Σειών, ἁγιάσατε νηστίαν, κηρύξατε θεραπείαν,",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.16",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.16",
    "language": "grc",
    "text": "συναγάγετε λαόν, ἁγιάσατε ἐκκλησίαν, ἐκλέξασθε πρεσβυτέρους, συναγάγετε νήπια θηλάζοντα μαστούς, ἐξελθάτω νυμφίος ἐκ τοῦ κοιτῶνος αὐτοῦ καὶ νύμφη ἐκ τοῦ παστοῦ αὐτῆς.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.17",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.17",
    "language": "grc",
    "text": "ἀνὰ μέσον τῆς κρηπῖδος τοῦ θυσιαστηρίου κλαύσονται οἱ ἱερεῖς οἱ λειτουργοῦντες Κυρίῳ καὶ ἐροῦσιν Φεῖσαι, Κύριε, τοῦ λαοῦ σου, καὶ μὴ δῷς τὴν κληρονομίαν σου εἰς ὄνειδος τοῦ κατάρξαι αὐτῶν ἔθνη, ὅπως μὴ εἵπαωσιν ἐν τοῖς ἔθνεσιν Ιοῦ ἐστιν ὁ θεὸς αὐτῶν;",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.18",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.18",
    "language": "grc",
    "text": "Καὶ ἐζήλωσεν Κύριος τὴν γῆν αὐτοῦ, καὶ ἐφείσατο τοῦ λαοῦ αὐτοῦ.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.19",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.19",
    "language": "grc",
    "text": "καὶ ἀπεκρίθη Κύριος καὶ εἶπεν τῷ λαῷ αὐτοῦ Ἴδου ἐγὼ ἐξαποστέλλω ὑμῖν τὸν σῖτον καὶ τὸν οἶνον καὶ τὸ ἔλαιον, καὶ ἐμπληφθήσεσθε αὐτῶν, καὶ οὐ δώσω ὑμᾶς οὐκέτι εἰς ὀνειδισμὸν ἐν τοῖς ἔθνεσι",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.20",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.20",
    "language": "grc",
    "text": "καὶ τὸν ἀπὸ βορρᾶ ἐκδιώξω ἀφʼ ὑμῶν καὶ ἐξώσω αὐτὸν εἰς γῆν ἄνυδρον, καὶ ἀφανιῶ τὸ πρόσωπον αὐτοῦ εἰς τὴν θάλασσαν τὴν πρώτην, καὶ τὰ ὀπίσω αὐτοῦ εἰς τὴν θάλασσαν τὴν ἐσχάτην· καὶ ἀναβήσεται σαπρία αὐτοῦ, καὶ ἀναβήσεται ὁ βρόμος αὐτοῦ, ὅτι ἐμεγάλυνεν τὰ ἔργα αὐτοῦ.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.21",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.21",
    "language": "grc",
    "text": "θάρσει, γῆ. χαῖρε καὶ εὐφραίνου, ὅτι ἐμεγάλυνεν Κύριος τοῦ ποιῆσαι.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.22",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.22",
    "language": "grc",
    "text": "θαρσεῖτε, κτήνη τοῦ πεδίου, ὅτι βεβλάστηκεν πεδία τῆς ἐρήμου, ὅτι ξύλον ἤνεγκεν τὸν καρπὸν αὐτοῦ, συκῆ καὶ ἄμπελος ἔδωκαν τὴν ἰσχὺν αὐτῶν.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.23",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.23",
    "language": "grc",
    "text": "καὶ τὰ τέκνα Σειών, χαίρετε καὶ εὐφραίνεσθε ἐπὶ τῷ κυρίῳ θεῷ ὑμῶν, διότι ἔδωκεν ὑμῖν τὰ βρώματα εἰς δικαιοσύνην, καὶ βρέξει ὑμῖν ὑετὸν πρόιμον καὶ ὄψιμον καθὼς ἔμπροσθεν,",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.24",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.24",
    "language": "grc",
    "text": "καὶ πλησθήσονται αἱ ἄλωνες σίτου, καὶ ὐπερχυθήσονται αἱ ληνοὶ οἴνου καὶ ἐλαίου.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.25",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.25",
    "language": "grc",
    "text": "καὶ ἀνταποδώσει ὑμῖν ἀντὶ τῶν ἐτῶν ὦν κατέφαγεν ἡ ἀκρὶς καὶ ὁ βροῦχος καὶ ἡ ἐρυσίβη καὶ ἡ κάμπη, ἡ δύναμίς μου ἡ μεγάλη ἣν ἐξαπέστειλα εἰς ὑμᾶς·",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.26",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.26",
    "language": "grc",
    "text": "καὶ φάγεσθε ἐσθίοντες καὶ ἐμπλησθήσεσθε, καὶ αἰνέσετε τὸ ὄνομα Κυρίου τοῦ θεοῦ ὑμῶν, ἄ ἐποίησεν μεθʼ ὑμῶν εἰς θαυμάσια, καὶ οὐ μὴ καταισχυνθῇ ὁ λαός μου εἰς τὸν αἰῶνα·",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.27",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.27",
    "language": "grc",
    "text": "καὶ ἐπιγνόσεσθε ὅτι ἐν μέσῳ τοῦ Ἰσραὴλ ἐγὼ εἰμι, καὶ ἐγὼ Κύριος ὁ θεὸς ὑμῶν, καὶ οὐκ ἔστιν ἔτι πλὴν ἐμοῦ, καὶ οὐ μὴ καταισχυνθῶσιν ἔτι ὁ λαός μου εἰς τὸν αἰῶνα.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.28",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.28",
    "language": "grc",
    "text": "Καὶ ἔσται μετὰ ταῦτα καὶ ἐκχεῶ ἀπὸ τοῦ πνεύματός μου ἐπὶ πᾶσαν σάρκα, καὶ προφητεύσουσιν οἱ υἱοὶ ὑμῶν καὶ αἱ θυγατέρες ὑμῶν, καὶ οἱ πρεσβύτεροι ὑμῶν ἐνύπνια ἐνυπνιασθήσονται, καὶ οἱ νεαυίσκοι ὑμῶν ὁράσεις ὄψονται·",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.29",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.29",
    "language": "grc",
    "text": "καὶ ἐπὶ τοὺς δούλους μου καὶ ἐπὶ τὰς δούλας ἐν ταῖς ἡμέραις ἐκείναις ἐκχεῶ ἀπὸ τοῦ πνεύματός μου·",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.30",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.30",
    "language": "grc",
    "text": "καὶ δώσω τέρατα ἐν τῷ οὐρανῷ, καὶ ἐπὶ τῆς γῆς αἷμα καὶ πῦρ καὶ ἀτμίδα καπνοῦ·",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.31",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.31",
    "language": "grc",
    "text": "ὁ ἥλιος μεταστραφήσεται εἰς σκότος καὶ ἡ σελήνη εἰς αἵμα πρὶν ἐλθεῖν ἡμέραν Κυρίου τὴν μεγάλην καὶ ἐπιφανῆ·",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.2.32",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.2.32",
    "language": "grc",
    "text": "καὶ ἔσται πᾶς ὅς ἂν ἐπικαλέσηται τὸ ὄνομα Κυρίου σωθήσεται ὅτι ἐν τῷ ὄρει Σειὼν καὶ ἐν Ἰερουσαλὴμ ἔσται ἀνασωζόμενος, καθότι εἶπεν Κύριος, καὶ εὐαγγελιζόμενοι οὓς Κύριος προσκέκληται.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.1",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.1",
    "language": "grc",
    "text": "Διότι ἰδοὺ ἐγὼ ἐν ταῖς ἡμέραις ἐκείναις καὶ ἐν τῷ καιρῷ ἐκείνῳ ὅταν ἐπιστρέφω τὴν αἰχμαλωσίαν Ἰούδα καὶ Ἰερουσαλήμ,",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.2",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.2",
    "language": "grc",
    "text": "καὶ συνάξω πάντα τὰ ἔθνη καὶ κατάξω αὐτὰ εἰς τὴν κοιλάδα Ἰωσαφάτ, καὶ διακριθήσομαι πρὸς αὐτοὺς ἐκεῖ ὑπέρ τοῦ λαοῦ μου καὶ τῆς κληρονομίας μου Ἰσραήλ, οἵ διεσπάρησαν ἐν τοῖς ἔθνεσιν· καὶ τὴν γῆν μου καταδιείλαντο,",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.3",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.3",
    "language": "grc",
    "text": "καὶ ἐπὶ τὸν λαόν μου ἔβαλον κλήρους, καὶ ἔδωκαν τὰ παιδάρια πόρναις, καὶ τὰ κοράσια ἐπόλουν ἀντὶ οἴνου καὶ ἔπινον.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.4",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.4",
    "language": "grc",
    "text": "καὶ τί ὑμεῖς ἐμοί, Ἰύρος καὶ Σειδών, καὶ πᾶσα Γαλειλαία ἀλλοφύλων μὴ ἀνταπόδομα ὑμεῖς ἀνταποδίδοτέ μοι; ἤ μνησικακεῖτε ὑμεῖς ἐπʼ ἐμοὶ ὀξέως; καὶ ταχέως ἀνταποδώσω τὸ ἀνταπόδομα ὑμῶν εἰς κεφαλὰς ὑμῶν,",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.5",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.5",
    "language": "grc",
    "text": "ἀνθʼ ὦν τὸ ἀργύριόν μου καὶ τὸ χρυσίον μου ἐλάβετε, καὶ τὰ ἐπίλεκτά μου καὶ τὰ καλὰ εἰσηνέγκατε εἰς τοὺς ναοὺς ὑμῶν·",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.6",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.6",
    "language": "grc",
    "text": "καὶ τοὺς υἱοὺς Ἰούδα καὶ τοὺς υἱοὺς Ἰερουσαλὴμ ἀπέδοσθε τοῖς υἱοῖς τῶν Ἐλλήνωυ, ὅπως ἐξώσητε αὐτοὺς ἐκ τῶν ὁρίων αὐτῶν.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.7",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.7",
    "language": "grc",
    "text": "ἰδοὺ ἐγὼ ἐξεγείρω αὐτοὺς ἐκ τοῦ τόπου οὐ ἀπέδοσθε αὐτοὺς ἐκεῖ, καὶ ἀνταποδώσω τὸ ἀνταπόδομα ὑμῶν εἰς κεφαλὰς ὑμῶν,",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.8",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.8",
    "language": "grc",
    "text": "καὶ ἀποδώσομαι τοὺς υἱοὺς ὑμῶν καὶ τὰς θυγατέρας ὑμῶν εἰς χεῖρας τῶν υἱῶν Ἰούδα, καὶ ἀποδώσονται αὐτοὺς εἰς αἰχμαλωσίαν εἰς ἔθνος μακρὰν ἀπέχον, ὅτι Κύριος ἐλάλησεν.",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.9",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.9",
    "language": "grc",
    "text": "Κηρύξατε ταῦτα ἐυ τοῖς ἔθνεσιν, ἁγιάσατε πόλεμου, ἐξεγείρατε τοὺς μαχητάς, καὶ προσαγάγετε καὶ ἀναβαίυετε πάντες ἄνδρες πολεμισταί,",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.10",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.10",
    "language": "grc",
    "text": "συγκόψατε τὰ ἄροτρα ὑμῶν εἰς όομφαίας καὶ τὰ δρέπανα ὑμῶν εἰς σειρομάστας· ὁ ἀδύνατος λεγέτω ὅτι Ἰσχύω ἐγώ.",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.11",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.11",
    "language": "grc",
    "text": "συναθροίζεσθε καὶ εἰσπορεύεσθε πάντα τὰ ἔθνη κυκλόθεν καὶ συνάχθητε ἐκεῖ ὁ πρᾳὺς ἔστω μαχητής.",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.12",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.12",
    "language": "grc",
    "text": "ἐξεγειρέσθωσαν, ἀυαβαινέτωσαν πάντα τὰ ἔθνη εἰς τὴν κοιλάδα Ἰωσαφάτ, διότι ἐκεῖ καθιῶ τοῦ διακρῖναι πάντα τὰ ἔθνη κυκλόθεν.",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.13",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.13",
    "language": "grc",
    "text": "ἐξαποστείλατε δρέπανα, ὅτι παρέστηκεν τρυγητός· εἰσπορεύεσθε, πατεῖτε, διότι πλήρης ἡ ληνός· ὑπερεκχεῖτε τὰ ὑπολήνια, ὅτι πεπλήθυυται τὰ κακὰ αὐτῶν.",
    "chunk_index": 64,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.14",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.14",
    "language": "grc",
    "text": "ἤχοι ἐξήχησαν ἐν τῇ κοιλάδι τῆς δίκης, ὅτι ἐγγὺς ἡμέρα Κυρίου ἐν τῇ κοιλάδι τῆς δίκης.",
    "chunk_index": 65,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.15",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.15",
    "language": "grc",
    "text": "ὁ ἥλιος καὶ ἡ σελήνη συσκοτάσουσιν, καὶ οἱ ἀστέρες δύσουσιν φέγγος αὐτῶυ.",
    "chunk_index": 66,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.16",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.16",
    "language": "grc",
    "text": "ὁ δὲ κύριος ἐκ Σειὼν ἀνακεκράξεται, καὶ ἐξ Ἰερουσαλὴμ δώσει φωνὴν αὐτοῦ, καὶ σεισθήσεται ὁ οὐρανὸς καὶ ἡ γῆ· ὁ δὲ κύριος φείσεται τοῦ λαοῦ αὐτοῦ καὶ ἐνισχύσει τοὺς υἱοὺς Ἰσραήλ.",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.17",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.17",
    "language": "grc",
    "text": "καὶ ἐπιγνώσεσθε διότι ἐγὼ Κύριος ὁ θεὸς ὑμῶν ὁ κατασκηνῶν ἐυ Σειών, ἐν ὄρει ἁγίῳ μου· καὶ ἔσται Ἰερουσαλὴμ ἁγία, καὶ ἀλλογενεῖς οὐ διελεύσονται δι᾿ αὐτῆς οὐκέτι.",
    "chunk_index": 68,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.18",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.18",
    "language": "grc",
    "text": "Καὶ ἔσται ἐυ τῇ ἡμέρᾳ ἐκείνῃ ἀποσταλάξει τὰ ὄρη γλυκασμόν, καὶ οἱ βουνοὶ όυήσονται γάλα, καὶ πᾶσαι αἱ ἀφέσεις Ἰούδα ὸυήσονται ὕδατα, καὶ πηγὴ ἐξ οἵκου Κυρίου ἐξελεύσεται καὶ ποτιεῖ τὸν χειμάρρουν τῶν σχοίνων.",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.19",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.19",
    "language": "grc",
    "text": "Aἶγυπτος εἰς ἀφανισμὸν ἔσται, καὶ ἡ Ἰδουμαία εἰς πεδίον ἀφανισμοῦ ἔσται ἐξ ἀδικιῶν υἱῶν Ἰούδα, ἀνθʼ ὧν ἐξέχεαν αἵμα δίκαιον ἐν τῇ γῇ αὐτῶν.",
    "chunk_index": 70,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.20",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.20",
    "language": "grc",
    "text": "ἡ δἐ Ἰουδαία εἰς τὸν αἰῶνα κατοικηθήσεται, καὶ Ἰερουσαλὴμ εἰς γενεὰς γενεῶν·",
    "chunk_index": 71,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg039/1st1K-grc1#tlg0527.tlg039.3.21",
    "work_id": "first1k/tlg0527/tlg039/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg039.3.21",
    "language": "grc",
    "text": "καὶ ἐκζητήσω τὸ αἵμα αὐτῶν καὶ οὐ μὴ ἀθῳώσω, καὶ Κύριος κατασκηνώσει ἐν Σειών.",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  }
]