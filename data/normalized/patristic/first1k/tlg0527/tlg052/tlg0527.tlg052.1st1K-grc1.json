[
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052",
    "language": "grc",
    "text": "ANΤΙΓΡΑΦΟΝ ἐπιστολῆς ἧς ἀπέστειλεν Ἱερεμίας πρὸς τοὺς ἁχόησομένους αἰχμαλώτους εἰς Βαβυλῶνα ὑπὸ τοῦ βασιλέως τῶν Βαβυλωνίων, ἀναγγεῖλαι αὐτοῖς καθότι ἐπετάγη αὐτῷ ὑπὸ τοῦ θεοῦ.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.1",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.1",
    "language": "grc",
    "text": "Διὰ τὰς ἁμαρτίας ὑμῶν ἄς ἡμαρτήκατε ἐναντίον τοῦ θεοῦ ἀχθήσεσθε εἰς Βαβυλῶνα αἰχμάλωτοι ὑπὸ Ναβουχοδονοσὸρ βασιλέως τῶν Βαβυλωνίων.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.2",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.2",
    "language": "grc",
    "text": "εἰσελθόντες οὗν εἰς Βαβυλῶνα ἔσεσθε ἐκεῖ ἔτη πλείονα καὶ χρόνον μακρὸν ἕως γενεῶν ἑπτά· μετὰ τοῦτο δὲ ἐξάξω ὑμᾶς ἐκεῖθεν μετʼ εἰρήνης.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.3",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.3",
    "language": "grc",
    "text": "νυνὶ δὲ ὄψεσθε ἐν Βαβυλῶνι θεοὺς ἀργυροῦς καὶ χρυσοῦς καὶ ξυλίνους ἐπʼ ὠμοις αἰρομένους, δεικνύντας φόβον τοῖς ἔθνεσιν.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.4",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.4",
    "language": "grc",
    "text": "εὐλαβήθητε οὗν μὴ καὶ ὑμεῖς ἀφομοιωθέντες τοῖς ἀλλοφύλοις ἀφομοιωθῆτε, καὶ φόβος ὑμᾶς λάβῃ ἐπʼ αὐτοῖς,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.5",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.5",
    "language": "grc",
    "text": "ἰδόντας ὄχλον ἔμπροσθεν καὶ ὄπισθεν αὐτῶν προσκυνοῦντας αὐτά· εἶπατε δὲ τῇ διανοίᾳ Σοὶ δεῖ προσκυνεῖν, Δἐσποτα.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.6",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.6",
    "language": "grc",
    "text": "ό γὰρ ἄγγελός μου μεθʼ ὑμῶν ἐστίν, αὐτός τε ἐκζητῶν τὰς ψυχὰς ὑμῶν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.7",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.7",
    "language": "grc",
    "text": "Γλῶσσα γὰρ αὐτῶν ἐστὶν κατεξυσμένη ὑπὸ τέκτονος, αὐτά τε περίχρυσα καὶ περιάργυρα, ψευδῆ δʼ ἐστὶν καὶ οὐ δύνανται λαλεῖν.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.8",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.8",
    "language": "grc",
    "text": "καὶ ὥσπερ παρθένῳ φιλοκόσμῳ λαμβάνοντες χρυσίον",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.9",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.9",
    "language": "grc",
    "text": "κατασκευἀζουσιν στεφάνους ἐπὶ τὰς κεφαλὰς τῶν θεῶν αὐτῶν· ἔστι δέ καὶ ὅτε ὑφαιρούμενοι οἱ ἱερεῖς ἀπὸ τῶν θεῶν αὐτῶν χρυσίον καὶ ἀργύριον εἰς ἑαυτοὺς καταναλοῦσιν,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.10",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.10",
    "language": "grc",
    "text": "δώσουσιν δὲ ἀπ αὐτῶν καὶ ταῖς ἐπὶ τοῦ στέγους πόρναις. κοσμοῦσί τε αὐτοὺς ὡς ἀνθρώπους τοῖς ἐνδύμασιν, θεοὺς ἀργυροῦς καὶ θεοὺς χρυσοῦς καὶ ξυλίνους.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.11",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.11",
    "language": "grc",
    "text": "οὗτοι δὲ οὐ δια- σώζονται ἀπὸ ἰοῦ καὶ βρωμάτων, περιβεβλημένων αὐτῶν ἱματισμὸν πορφυροῦν.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.12",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.12",
    "language": "grc",
    "text": "ἐκμάσσονται τὸ πρόσωπον αὐτῶν διὰ τὸν ἐκ τῆς οἰκίας κονιορτόν, ὅς ἐστιν πλείω ἐπʼ αὐτοῖς.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.13",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.13",
    "language": "grc",
    "text": "καὶ σκῆπτρον ἔχει ὁὡς ἄνθρωπος κριτὴς χώρας, ὸς τὸν εἰς αὐτὸν ἁμαρτάνοντα οὐκ ἀνελεῖ.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.14",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.14",
    "language": "grc",
    "text": "ἔχει δὲ ἐνχειρίδιον δεξιῷ καὶ πέλεκυν, ἑαυτὸν δὲ ἐκ πολέμου καὶ λῃστῶν οὐκ ἐξελεῖται. ὅθεν γνώριμοί εἰσιν οὐκ ὄντες θεοί μὴ οὗν φοβηθῆτε αὐτούς.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.15",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.15",
    "language": "grc",
    "text": "Ὥσπερ γὰρ σκεῦος ἀνθρώπου συντριβὲν ἀχρεῖον γίνεται,",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.16",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.16",
    "language": "grc",
    "text": "τοιοῦτοι ὑπάρχουσιν οἱ θεοὶ αὐτῶν, καθιδρυμένων αὐτῶν ἐν τοῖς οἴκοις. οἱ ὀφθαλμοὶ αὐτῶν πλήρεις εἰσὶν κονιορτοῦ ἀπὸ τῶν ποδῶν τῶν εἰσπορευομένων.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.17",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.17",
    "language": "grc",
    "text": "καὶ ὥσπερ τινὶ ἠδικηκότι βασιλέα περιπεφραγμέναι εἰσὶν αἱ αὐλαί, ὡς ἐπὶ θανάτῳ ἀπηγμένῳ, τοὺς οἴκους αὐτῶν ὐχυροῦσιν οἱ ἱερεῖς θυρώμασίν τε καὶ κλείθροις καὶ μοχλοῖς, ὅπως ὑπὸ τῶν λῃστῶν μὴ συληθῶσι",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.18",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.18",
    "language": "grc",
    "text": "λύχνους καίουσιν καὶ πλείους ἑαυτοῖς, ὧν οὐδένα δύνανται ἰδεῖν.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.19",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.19",
    "language": "grc",
    "text": "ἔστιν μέν ὥσπερ δοκὸς τῶν ἐκ τῆς οἰκίας, τὰς δέ καρδίας αὐτῶν φασὶν ἐκλείχεσθαιʼ τῶν ἀπὸ τῆς γῆς ἑρπετῶν κατεσθόντων αὐτοὺς τε καὶ τὸν ἱματισμὸν αὐτῶν οὐκ αἰσθάνονται.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.20",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.20",
    "language": "grc",
    "text": "μεμελανωμένοι τὸ πρόσωπον αὐτῶν ἀπὸ τοῦ καπνοῦ τοῦ ἐκ τῆς οἰκίας.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.21",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.21",
    "language": "grc",
    "text": "ἐπ ὶ τὸ σώμα αὐτῶν καὶ ἐπὶ τὴν κεφαλὴν ἐφίπτανται νυκτερίδες, χελιδόνες καὶ τὰ ὄρνεα, ὡσαύτως δὲ καὶ οἱ αἵλουροι.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.22",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.22",
    "language": "grc",
    "text": "ἰθεν γνώσεσθε ὅτι οὐκ εἰσὶν θεοί μὴ οὗν φοβεῖσθε αὐτά.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.23",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.23",
    "language": "grc",
    "text": "Τὸ γὰρ χρυσίον ὁ περίκεινται εἰς κάλλος, ἐὰν μή τις ἐκμάξῃ τὸν ἰόν, οὐ μὴ στίλψωσιν· οὐδὲ γὰρ ὅτε ἐχωνεύοντο ἠσθάνοντο.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.24",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.24",
    "language": "grc",
    "text": "ἐκ πάσης τιμῆς ἠγορασμένα ἐστίν, ἐν οἷς οὐκ ἔστιν πνεῦμα.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.25",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.25",
    "language": "grc",
    "text": "ἄνευ ποδῶν ἐπʼ ὀμοις φέρονται ἐνδεικνύμενοι τὴν ἑαυτῶν ἀτιμίαν τοῖς ἀνθρώποις, αἰσχύνονταί τε καὶ οἱ θεραπεύοντες αὐτά,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.26",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.26",
    "language": "grc",
    "text": "διὰ τό, μὴ ποτε ἐπὶ τὴν γῆν πέσῃ, δι᾿ αὐτῶν ἀνίστασθαι· μήτε ἐάν τις αὐτὸ ὀρθὸν στήσῃ, δι᾿ ἑαυτοῦ κινηθήσεται, μήτε ἐὰν κλιθῇ, οὐ μὴ ὀρθωθῇ, ἀλλʼ ἶσπερ νεκροῖς τὰ δώρα αὐτοῖς παρατίθεται.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.27",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.27",
    "language": "grc",
    "text": "τὰς δὲ θυσίας αὐτῶν ἀποδόμενοι οἱ ἱερεῖς αὐτῶν καταχρῶνται· ὡσαύτως δὲ καὶ αἱ γυναῖκες ἀπʼ αὐτῶν ταριχεύουσαι οὕτε πτωχῷ οὕτε ἀδυνάτῳ μὴ μεταδώσιν·",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.28",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.28",
    "language": "grc",
    "text": "τῶυ θυσιῶν αὐτῶν ἀποκαθημένη καὶ λεχὼς ἄπτονται. γνόντες οὗν ἀπὸ τούτων ὅτι οὐκ εἰσὶν θεοί, μὴ φοβηθῆτε αὐτοὺς.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.29",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.29",
    "language": "grc",
    "text": "Πόθεν γὰρ κληθείησαν θεοί; ὅτι γυναῖκες παρατιθέασιν θεοῖς ἀργυροῖς καὶ χρυσοῖς καὶ ξυλίνοις·",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.30",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.30",
    "language": "grc",
    "text": "καὶ ἐν τοῖς οἴκοις αὐτῶν οἱ ἱερεῖς διφρεύουσιν, ἔχοντες τοὺς χιτῶνας διερραωγότας καὶ τὰς κεφαλὰς καὶ τοὺς πώγωνας ἐξυρημένους, ὧν αἱ κεφαλαὶ ἀκάλυπτοί εἰσιν,",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.31",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.31",
    "language": "grc",
    "text": "ὠρύονται δέ βοώντες ἐναντίον τῶν θεῶν αὐτῶν ώσπερ τινές ἐν περιδείπνῳ νεκροῦ.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.32",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.32",
    "language": "grc",
    "text": "ἀπὸ τοῦ ἱματισμοῦ αὐτῶν ἀφελόμενοι οἱ ἱερεῖς ἐνδύσουσιν τὰς γυναίκας αὐτῶν καὶ τὰ παιδία·",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.33",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.33",
    "language": "grc",
    "text": "οδτε ἐὰν κακὸν πάθωσιν ὑπό τινος οὕτε ἐὰν ἀγαθόν, δυνήσονται ἀνταποδοῦναι· οὕτε καταστῆσαι βασιλέα δύνανται οὕτε ἀφελέσθαι.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.34",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.34",
    "language": "grc",
    "text": "ὁὡσαύτως οὕτε πλοῦτον οὐτε χαλκὸν οὐ μὴ δύνωνται διδόναι· ἐάν τις αὐτοῖς εὐχὴν εὐξάμενος μὴ ἀποδῷ, οὐ μὴ ἐπιζητήσωσιν·",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.35",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.35",
    "language": "grc",
    "text": "ἐκ θανάτου ἄνθρωπον οὐ μὴ όύσωνται, οὐτε ἥττονα ἀπὸ ἰσχυροῦ μὴ ἐξέλωνται·",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.36",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.36",
    "language": "grc",
    "text": "Μνθρωπον τυφλὸυ εἰς ὄρασιν οὐ μὴ περιστήσωσιν, ἐν ἀνάγκῃ ἄνθρωπον ὄντα οὐ μὴ ἐξέλωνται·",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.37",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.37",
    "language": "grc",
    "text": "χήραν οὐ μὴ ἐλεήσωσιν, οὕτε ὀρφανὸν εὗ ποιήσουσιν.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.38",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.38",
    "language": "grc",
    "text": "τοῖς ἀπὸ τοῦ ὄρους λίθοις ὡμοιωμένοι εἰσὶν τὰ ξύλινα καὶ τὰ περίχρυσα καὶ τὰ περιάργυρα, οἱ δῆ θεραπεύοντες αὐτὰ καταισχυνθήσονται.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.39",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.39",
    "language": "grc",
    "text": "πώς οὗν νομιστέον ἤ κλητέον αὐτοὺς ὑπάρχειν θεούς;",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.40",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.40",
    "language": "grc",
    "text": "Ἐτι δὲ καὶ αὐτῶν τῶν Χαλδαίων ἀτιμαζόντων αὐτά, oζ ὅταν ἴδωσιν ἐνεὸν οὐ δυνάμενον λαλῆσαι, προσενεγκάμενοι τὸν Βῆλον ἀξιοῦσιν φωνῆσαι, ὡς δυνατοῦ ὄντος αὐτοῦ αἰσθέσθαι,",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.41",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.41",
    "language": "grc",
    "text": "καὶ οὐ δύνανται αὐτοὶ νοήσαντες καταλιπεῖν αὐτά, αἵσθησιν γὰρ οὐκ ἔχουσιν.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.42",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.42",
    "language": "grc",
    "text": "αἱ δὲ γυναῖκες περιθέμεναι σχοινία ἐν ταῖς οδοῖς ενκαθηνται, θυμιῶσαι τὰ πίτυρα·",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.43",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.43",
    "language": "grc",
    "text": "ὅταν δέ τις αὐτῶν ἐφελκυσθεῖσα ὑπό τινος τῶν παραπορευομένων κοιμηθῇ, τὴν πλησίον ὀνειδίζει, ὅτι οὐκ ἠξίωται ὥσπερ καὶ αὐτὴ οὕτε τὸ σχοινίον αὐτῆς διερράγη.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.44",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.44",
    "language": "grc",
    "text": "πάντα τὰ γενόμενα αὐτοῖς ἐστὶν ψευδῆ. πῶς οὗν νομιστέον ἡ κλητέον ὡς θεοὺς αὐτοὺς ὑπάρχειν",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.45",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.45",
    "language": "grc",
    "text": "Ὑπὸ τεκτόνων καὶ χρυσοχόων κατασκευασμένα εἰσίν· οὐθὲν ἄλλο μὴ γένηται ἤ ὃ βούλονται οἱ τεχνῖται αὐτὰ γενέσθαι.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.46",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.46",
    "language": "grc",
    "text": "φὐτοί τε οἱ κατασκευάζοντες αὐτὰ οὐ μὴ γένωνται πολυχρόνιοι·",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.47",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.47",
    "language": "grc",
    "text": "πῶς τε δὴ μέλλει τὰ ὑπʼ αὐτῶν κατασκευασθέντα; κατέλιπον γὰρ ψεύδη καὶ ὄνειδος τοῖς ἐπιγινομένοις.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.48",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.48",
    "language": "grc",
    "text": "ὅταν γὰρ ἐπέλθῃ ἐπʼ αὐτὰ πόλεμος καὶ κακά, βουλεύονται πρὸς ἑαυτοὺς οἱ ἱερεῖς ποῦ συναποκρυβῶσι μετʼ αὐτῶν.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.49",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.49",
    "language": "grc",
    "text": "πῶς οὗν οὐκ ἔστιν αἰσθέσθαι ὅτι οὐκ εἰσὶν θεοί, οἱ οδτε σώζουσιν ἑαυτοὺς ἐκ πολέμου οὕτε ἐκ κακῶν;",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.50",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.50",
    "language": "grc",
    "text": "ὑπάρχοντα γὰρ ξύλινα καὶ περίχρυσα καὶ περιάργυρα γνωσθήσεται μετὰ ταῦτα ὅτι ἐστὶν ψευδῆ· τοῖς ἔθνεσι πᾶσι τοῖς τε βασιλεῦσι φανερὸν ἔσται ὅτι οὐκ εἰσὶ θεοὶ ἀλλὰ ἔργα χειρῶν ἀνθρώπων, καὶ οὐδὲν θεοῦ ἔργον ἐν αὐτοῖς ἐστίν.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.51",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.51",
    "language": "grc",
    "text": "Τίνι οὗν γνωστέον ἐστὶν ὅτι οὐκ εἰσὶν θεοί;",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.52",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.52",
    "language": "grc",
    "text": "βασιλέα γὰρ χώρας οὐ μὴ ἀναστήσωσιν, οὕτε ὑετὸν ἀνθρώποις οὐ μὴ δώσιν,",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.53",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.53",
    "language": "grc",
    "text": "κρίσιν τε οὐ μὴ διακρίνωσιν ἑαυτῶν, οὐδὲ μὴ όύσωνται ἀδίκημα, ἀδύνατοι ὄντες·",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.54",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.54",
    "language": "grc",
    "text": "ὥσπερ γὰρ κορῶναι ἀνὰ μέσον τοῦ οὐρανοῦ καὶ τῆς γῆς. καὶ γὰρ ὅταν ἐμπέσῃ εἰς οἰκίαν θεῶν ξυλίνων ἡ περιχρύσων ἡ περιαργύρων πῦρ, οἱ μέν ἱερεῖς αὐτῶν φεύξονται καὶ διασωθήσονται, αὐτοὶ δὲ ὥσπερ δοκοὶ μέσοι κατακαυθήσονται.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.55",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.55",
    "language": "grc",
    "text": "βασιλεῖ δέ καὶ πολεμίοις οὐ μὴ ἀντιστώσιν.",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.56",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.56",
    "language": "grc",
    "text": "πῶς οὗν ἐκδεκτέον ἤ νομιστέον ὅτι εἰσὶν θεοί; Οδτε ἀπὸ κλεπτῶν οὕτε ἀπὸ λῃστῶν οὐ μὴ διαθώσιν, θεοὶ ξύλινοι καὶ περιάργυροι καὶ περίχρυσοι·",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.57",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.57",
    "language": "grc",
    "text": "ὦν οἱ ἰσχύοντες περιελοῦνται τὸ χρυσίον καὶ τὸ ἀργύριον, καὶ τὸν ἱματισμὸν τὸν περικείμενον αὐτοῖς ἀπελεύσονται ἔχοντες, οὕτε ἑαυτοῖς οὐ μὴ βοηθήσωσιν.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.58",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.58",
    "language": "grc",
    "text": "ζώστε κρεῖσσον εἶναι βασιλέα ἐπιδεικνύμενον τὴν ἑαυτοῦ ἀνδρείαν ἡ σκεῦος ἐν οἰκίᾳ χρήσιμον, ἐφ ᾧ κεχρήσεται ὁ κεκτημένος, ἤ οἱ ψευδεῖς θεοί ἡ καὶ θύρα ἐν οἰκίᾳ διασώζουσα τὰ ἐν αὐτῇ ὄντα ἤ οἱ ψευδεῖς θεοί, καὶ ξύλινος στύλος ἐν βασιλείοις ἤ οἱ ψευδεῖς θεοί",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.59",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.59",
    "language": "grc",
    "text": "ἥλιος μὲν γὰρ καὶ σελήνη καὶ ἄστρα ὄντα λαμπρὰ καὶ ἀποστελλόμενα ἐπὶ χρείας εὐήκοα εἰσιν.",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.60",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.60",
    "language": "grc",
    "text": "ῶὡσαύτως καὶ ἀστραπὴ ὅταν ἐπιφανῇ εὐοπτός ἐστιν· τὸ δʼ αὐτὸ καὶ πνεῦμα ἐν πάσῃ χώρᾳ πνεῖ",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.61",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.61",
    "language": "grc",
    "text": "καὶ νεφέλαις ὅταν ἐπιταγῇ ὑπὸ τοῦ θεοῦ ἐπιπορεύεσθαι ἐφʼ ὅλην τὴν οἰκουμένην, συντελοῦσι τὸ ταχθέν.",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.62",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.62",
    "language": "grc",
    "text": "χ ό τε πῦρ ἐξαποσταλὲν ἄνωθεν ἐξαναλῶσαι ὄρη καὶ δρυμοὺς ποιεῖ τὸ συνταχθέν. ταῦτα δὲ oδτε ταῖς εἰδέαις οὕτε ταῖς δυνάμεσιν αὐτῶν ἀφωμοιωμένα ἐστίν.",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.63",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.63",
    "language": "grc",
    "text": "ὅδεν οὕτε νομιστέον οὕτε κλητέον ὑπάρχειν αὐτοὺς θεούς, οὐ δυνατῶν ὄντων αὐτῶν οὕτε κρίσιν κρῖναι οὕτε εὗ ποιεῖν ἀυθρώποις.",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.64",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.64",
    "language": "grc",
    "text": "γνόντες οὗν ὅτι οὐκ εἰσὶν θεοί, μὴ φοβηθῆτε αὐτούς.",
    "chunk_index": 64,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.65",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.65",
    "language": "grc",
    "text": "Οὔτε γὰρ βασιλεῦσιν οὐ μὴ καταράσωνται οὕτε μὴ εὐλογήσωσι.",
    "chunk_index": 65,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.66",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.66",
    "language": "grc",
    "text": "σημεῖά τε ἐυ ἔθνεσιν ἐν οὐρανῷ οὐ μὴ δείξωσιν, οὐδὲ ὡς ὁ ἥλιος λάμψουσιν, οὐδὲ φωτίσουσιν ὡς σελήνη.",
    "chunk_index": 66,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.67",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.67",
    "language": "grc",
    "text": "τὰ θηρία ἐστὶν κρείττω αὐτῶν, ἄ δύνανται ἐκφυγόντα εἰς σκέπην αὐτὰ φελῆσαι.",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.68",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.68",
    "language": "grc",
    "text": "κατʼ οὐδένα οὗν τρόπον ἐστὶν ἡμῖν φανερὸν ὅτι εἰσὶν θεοί διὸ μὴ φοβηθῆτε αὐτούς.",
    "chunk_index": 68,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.69",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.69",
    "language": "grc",
    "text": "Ὥσπερ γὰρ ἐν σικυηράτῳ προβασκάνιον οὐδὲν φυλάσσον, οὕτως οἱ θεοὶ αὐτῶν εἰσὶν ξύλινοι καὶ περίχρυσοι καὶ περιάργυροι.",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.70",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.70",
    "language": "grc",
    "text": "τὸν αὐτὸν τρόπον καὶ τῇ ἐν κήπῳ όάμνῳ, ἐφʼ ἧς πᾶν ὄρνεον ἐπικάθηται, ὡσαύτως δὲ καὶ νεκρῷ ἐρριμμένῳ ἐν σκότει ἀφωμοίωνται οἱ θεοὶ αὐτῶν ξύλινοι καὶ περίχρυσοι καὶ περιάργυροι.",
    "chunk_index": 70,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.71",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.71",
    "language": "grc",
    "text": "ἀπό τε τῆς πορφύρας καὶ τῆς μαρμάρου τῆς ἐπʼ αὐτοὺς σηπομένης γνωσθήσεται ὅτι οὐκ εἰσὶν θεοί αὐτά τε ἐξ ὑστέρου βρωθήσονται, καὶ ἔσται ὄνειδος ἐν τῇ χώρᾳ.",
    "chunk_index": 71,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg052/1st1K-grc1#tlg0527.tlg052.72",
    "work_id": "first1k/tlg0527/tlg052/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg052.72",
    "language": "grc",
    "text": "κρείσσων οὖν ἄνθρωπος δίκαιος οὐκ ἔχων εἶδωλα, ἔσται γὰρ μακράν ἀπὸ ὀνειδισμοῦ.",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
