[
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1",
    "language": "grc",
    "text": "ΡΑΣΙΣ Ὀβδειού.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.1",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.1",
    "language": "grc",
    "text": "Τάδε λέγει Κύριος ὁ θεὸς τῇ Ἰδουμαίᾳ Ἀκοὴν ἤκουσα παρὰ Κυρίου, καὶ περιοχὴν εἰς τὰ ἔθνη ἐξαπέστειλεν Ἀνάστητε καὶ ἐξαναστῶμεν ἐπʼ αὐτὴν εἰς πόλεμον.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.2",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.2",
    "language": "grc",
    "text": "ἰδοὺ ὀλιγοστὸν δέδωκά σε ἐν τοῖς ἔθνεσιν, ἠτιμωμένος σὺ εἶ σφόδρα·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.3",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.3",
    "language": "grc",
    "text": "ὑπερηφανία τῆς καρδίας σου ἐπῆρέν σε κατασκηνοῦντα ἐν ταῖς ὀπαῖς τῶν πετρῶν· ὑψῶν κατοικίαν αὐτοῦ, λέγων ἐν καρδίᾳ αὐτοῦ Τίς με κατάξει ἐπὶ τὴν γῆν ;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.4",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.4",
    "language": "grc",
    "text": "ἐὰν μετεωρισθῇς ὡς ἀετός, καὶ ἐὰν ἀνὰ μέσον τῶν ἄστρων θῇς νοσσιάν σου, ἐκεῖθεν κατάξω σε, λέγει Κύριος.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.5",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.5",
    "language": "grc",
    "text": "εἰ κλέπται εἰσῆλθον πρὸς σὲ ἢ λῃσταὶ νυκτός, ποῦ ἂν ἀπερρίφης; οὐκ ἂν ἔκλεψαν τὰ ἱκανὰ ἑαυτοῖς; καὶ εἰ τρυγηταὶ εἰσῆλθον πρὸς σέ, οὐκ ἂν ὑπελίποντο ἐπιφυλλίδας;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.6",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.6",
    "language": "grc",
    "text": "πῶς ἐξηρευνήθη Ἠσοὺ καὶ κατελήμφθη αὐτοῦ τὰ κεκριυμμένα.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.7",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.7",
    "language": "grc",
    "text": "ἕως τῶν ὁρίων ἐξαπέστειλάν σε· πάντες οἱ ἄνδρες τῆς διαθήκης σου ἀντέστησάν σοι, ἡδυνάσθησαν πρὸς σὲ ἄνδρες εἰρηνικοί σου, ἔθηκαν ἔνεδρα ὑποκάτω σου, οὐκ ἔστιν σύνεσις αὐτοῖς.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.8",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.8",
    "language": "grc",
    "text": "ἐν ἐκείνῃ τῇ ἡμέρᾳ, λέγει Κύριος, ἀπολῶ σοφοὺς ἐκ τῆς Ἰδουμαίας καὶ σύνεσιν ἐξ ὄρους Ἠσού·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.9",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.9",
    "language": "grc",
    "text": "καὶ πτοηθήσονται οἱ μαχηταί σου οἱ ἐκ Θαιμάν, ὅπαως ἐξαρθῇ ἄνθρωπος ἐξ ὄρους Ἠσαύ·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.10",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.10",
    "language": "grc",
    "text": "διὰ τὴν σφαγὴν καὶ τὴν ἀσέβειαν ἀδελφοῦ σου Ἰακὼβ καλύψει σε αἰσχύνη, καὶ ἐξαρθήσῃ εἰς τὸν αἰῶνα.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.11",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.11",
    "language": "grc",
    "text": "Ἀφʼ ἧς ἡμέρας ἀντέστης ἐξ ἐναντίας ἐν ἡμέραις αἰχμαλωτευόντων ἀλλογενῶν δύναμιν αὐτοῦ, καὶ ἀλλότριοι εἰσῆλθον εἰς πύλας αὐτοῦ καὶ ἐπὶ Ἰερουσαλὴμ ἔβαλον κλήρους, καὶ σὺ ἧς ὡς εἷς ἐξ αὐτῶν.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.12",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.12",
    "language": "grc",
    "text": "καὶ μὴ ἐπίδῃς ἡμέραν ἀδελφοῦ σου ἐν ἡμέρᾳ ἀλλοτρίων, καὶ μὴ ἐπιχαρῆς ἐπὶ τοὺς υἱοὺς Ἰούδα ἐν ἡμέρᾳ ἀπωλίας αὐτῶν, καὶ μὴ μεγαλορημονῆς ἐν ἡμέρᾳ θλίψεως·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.13",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.13",
    "language": "grc",
    "text": "μηδὲ εἰσέλθῃς εἰς πύλας λαῶν ἐν ἡμέρᾳ πόνων αὐτῶν, μηδέ ἐπίδῃς καὶ σὺ τὴν συναγωγὴν αὐτάων ἐν ἡμέρᾳ ὀλέθρου αὐτῶν, μηδἐ συνεπιθῇ ἐπὶ τὴν δύναμιν αὐτῶν ἐν ἡμέρᾳ ἀπωλίας αὐτῶν·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.14",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.14",
    "language": "grc",
    "text": "μηδὲ ἐπιστῆς ἐπὶ τὰς διεκβολὰς αὐτοῦ ἐξολεθρεῦσαι τοὺς ἀνασωζομένους αὐτοῦ, μηδέ συγκλείσῃς τοὺς φεύγοντας αὐτοῦ ἐν ἡμέρᾳ θλίψεως.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.15",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.15",
    "language": "grc",
    "text": "διότι ἐγγὺς ἡμέρα Κυρίου ἐπὶ πάντα τὰ ἔθνη· ὃν τρόπον ἐποίησας, οὕτως ἔσται σοι τὸ ἀνταπόδομά σου ἀνταποδοθήσεται εἰς κεφαλήν σου·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.16",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.16",
    "language": "grc",
    "text": "διότι ὃν τρόπον ἔπιες ἐπὶ τὸ ὄρος τὸ ἅγιόν μου, πίονται καὶ καταβήσονται, καὶ ἔσονται καθὼς οὐχ ὑπάρχοντες.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.17",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.17",
    "language": "grc",
    "text": "Ἐν δὲ τῷ ὄρει Σειὼν ἔσται σωτηρία, καὶ ἔσται ἅγιονʼ καὶ κατακληρονομήσουσιν ὁ οἵκος Ἰακὼβ τοὺς κατακληρονομήσαντας αὐτούς.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.18",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.18",
    "language": "grc",
    "text": "καὶ ἔσται ὁ οἶκος Ἰακὼβ πῦρ, ὁ δὲ οἶκος Ἰωσὴφ φλόξ, ὁ δὲ οἶκος Ἠσαύ εἰς καλάμην, καὶ ἐκκαυθήσονται εἰς αὐτοὺς καὶ καταφάγονται αὐτούς, καὶ οὐκ ἔσται πυροφόρος τῷ οἴκῳ Ἠσαύ, διότι Κύριος ἐλάλησεν.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.19",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.19",
    "language": "grc",
    "text": "καὶ κατακληρονομήσουσιν οἱ ἐν Νάγεβ τὸ ὄρος τὸ Ἠσαύ, καὶ οἱ ἐν τῇ Σεφηλὰ τοὺς ἀλλοφύλους· καὶ κατακληρονομήσουσιν τὸ ὄρος Ἐφράιμ καὶ τὸ πεδίον Σαμαρείας καὶ Βενιαμεὶν καὶ τὴν Γαλααδεῖτιν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.20",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.20",
    "language": "grc",
    "text": "καὶ τῆς μετοικεσίας ἡ ἀρχὴ αὕτη· τοῖς υἱοῖς Ἰσραήλ, γῆ τῶν Χαναναίων ἕως Σαρέπτων, καὶ ἡ μετοικεσία Ἰερουσαλὴμ ἕως Ἐφράθα· κληρονομήσουσιν τὰς πόλεις τοῦ Νάγεβ.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg040/1st1K-grc1#tlg0527.tlg040.1.21",
    "work_id": "first1k/tlg0527/tlg040/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg040.1.21",
    "language": "grc",
    "text": "καὶ ἀναβήσονται ἀνασωζόμενοι ἐξ ὄρους Σειὼν τοῦ ἐκδικῆσαι τὸ ὄρος Ἠσαύ, καὶ ἔσται τῷ κυρίῳ ἡ βασιλεία.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  }
]