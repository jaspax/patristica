[
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.1",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.1",
    "language": "grc",
    "text": "ΛΗΜΜΑ λόγου Κυρίου ἐπὶ τὸν Ἰσραὴλ ἐν χειρὶ ἀγγέλου θέσθε δὴ ἐπὶ τὰς καρδίας ὑμῶν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.2",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.2",
    "language": "grc",
    "text": "Ἠγάπησα ὑμᾶς, λέγει Κύριος· καὶ εἴπατε Ἐν τίνι ἠγάπησας ἡμᾶς; οὐκ ἀδελφὸς ἦν Ἠσαὺ τοῦ Ἰακώβ; λέγει Κύριος· καὶ ἠγάπησα τὸν Ἰακώβ,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.3",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.3",
    "language": "grc",
    "text": "τὸν δὲ Ἠσαὺ ἐμίσησα, καὶ ἔταξα τὰ ὅρια αὐτοῦ εἰς ἀφανισμὸν καὶ τὴν κληρονομίαν αὐτοῦ εἰς δόματα ἐρήμου.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.4",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.4",
    "language": "grc",
    "text": "διότι ἐρεῖ Ἡ Ἰδουμαία κατέστραπται, καὶ ἐπιστρέψωμεν καὶ ἀνοικοδομήσωμεν τὰς ἐρήμους. τάδε λέγει Κύριος Παντοκράτωρ Αὐτοὶ οἰκοδομήσουσιν καὶ ἐγὼ καταστρέψω· καὶ ἐπικληθήσεται αὐτοῖς ὅρια ἀνομίας, καὶ λαὸς ἐφʼ ὃν παρατέτακται Κύριος ἕως αἰῶνος.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.5",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.5",
    "language": "grc",
    "text": "καὶ ὀφθαλμοὶ ὑμῶν ὄψονται, καὶ ὑμεῖς ἐρεῖτε Ἐμεγαλύνθη Κύριος ὑπεράνω τῶν ὁρίων τοῦ Ἰσραήλ.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.6",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.6",
    "language": "grc",
    "text": "Υἱὸς δοξάζει πατέρα, καὶ δοῦλος τὸν κύριον αὐτοῦ. καὶ εἰ πατήρ εἰμι ἐγώ, ποῦ ἐστιν ἡ δόξα μου; καὶ εἰ κύριός εἰμι ἐγὼ, ποῦ ἐστιν ὁ φόβος μου; λέγει Κύριος Παντοκράτωρ. ὑμεῖς οἱ ἱερεῖς οἱ φαυλίζοντες τὸ ὄνομά μου, καὶ εἴπατε Ἐν τίνι ἐφαυλίσαμεν τὸ ὄνομά σου;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.7",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.7",
    "language": "grc",
    "text": "προσάγοντες πρὸς τὸ θυσιαστήριόν μου ἄρτους ἠλισγημένους. καὶ εἴπατε Ἐν τίνι ἠλισγήσαμεν αὐτούς; ἐν τῷ λέγειν ὑμᾶς Τράπεζα Κυρίου ἠλισγημένη ἐστίν, καὶ τὰ ἐπιτιθέμενα ἐξουδενώσατε.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.8",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.8",
    "language": "grc",
    "text": "διότι ἐὰν προσαγάγητε τυφλὸν εἰς θυσίαν, οὐ κακόν; καὶ ἐὰν προσαγάγητε χωλὸν ἤ ἄρρωστον, οὐ κακόν ; προσάγαγε δὴ αὐτὸ τῷ ἡγουμένῳ σου, εἰ προσδέξεταί σε, εἰ λήμψεται πρόσωπόν σου, λέγει Κύριος Παντοκράτωρ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.9",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.9",
    "language": "grc",
    "text": "καὶ νῦν ἐξιλάσκεσθε τὸ πρόσαωπον τοῦ θεοῦ ὑμῶν καὶ δεήθητε αὐτοῦ· ἐν χερσὶν ὑμῶν γέγονεν ταῦτα· εἰ λήμψομαι ἐξ ὑμῶν πρόσωπα ὑμῶν; λέγει Κύριος Παντοκράτωρ.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.10",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.10",
    "language": "grc",
    "text": "διότι καὶ ἐν ὑμῖν συνκλεισθήσονται θύραι, καὶ οὐκ ἀνάψεται τὸ θυσιαστήριόν μου δωρεάν· οὐκ ἔστιν μου θέλημα ἐν ὑμῖν, λέγει Κύριος Παντοκράτωρ, καὶ θυσίαν οὐ προσδέξομαι ἐκ τῶν χειρῶν ὑμῶν.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.11",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.11",
    "language": "grc",
    "text": "διότι ἀπ᾿ ἀνατολῶν ἡλίου καὶ ἕως δυσμῶν τὸ ὄνομά μου δεδόξασται ἐν τοῖς ἔθνεσιν, καὶ ἐν παντὶ τόπῳ θυμίαμα προσάγεται τῷ ὀνόματί μου καὶ θυσία καθαρά· διότι μέγα τὸ ὄνομά μου ἐν τοῖς ἔθνεσιν, §λέγει Κύριος Γαντοκράτωρ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.12",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.12",
    "language": "grc",
    "text": "ὑμεῖς δὲ βεβηλοῦτε αὐτὸ ἐν τῷ λέλ γειν ὑμᾶς Γράπεζα Κυρίου ἠλισγημένη ἐστίν, καὶ τὰ ἐπιτιθέμενα ἐξουδένωνται βρώματα αὐτοῦ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.13",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.13",
    "language": "grc",
    "text": "καὶ εἵπατε Γαῦτα ἐκ κακοπαθίας ἐστίν. καὶ ἐξεφύσησα αὐτά, λέγει Κύριος Ιαντοκράτωρ. καὶ εἰσεφέρετε ἁρπάγματα καὶ τὰ χωλὰ καὶ τὰ ἐνοχλούμενα· καὶ ἐὰν φέρητε τὴν θυσίαν, εἰ προσδέξομαι αὐτὰ ἐκ τῶν χειρῶν ὑμῶν; λέγει Κύριος Ιαντοκράτωρ.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.1.14",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.1.14",
    "language": "grc",
    "text": "καὶ ἐπικατάρατος ὸς ἦν δυνατός, καὶ ὑπῆρχεν ἐν τῷ ποιμνίῳ αὐτοῦ ἄρσεν, καὶ εὐχὴ αὐτοῦ ἐπʼ αὐτῷ, καὶ θύει διεφθαρμένον τῷ κυρίῳ· διότι βασιλεὺς μέγας ἐγώ εἰμι, λέγει Κύριος Ιαντοκράτωρ, καὶ τὸ ὄνομά μου ἐπιφανές ἐν τοῖς ἔθνεσιν.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.1",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.1",
    "language": "grc",
    "text": "Καὶ νῦν ἡ ἐντολὴ αὕτη πρὸς ὑμᾶς, οἱ ἱερεῖς.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.2",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.2",
    "language": "grc",
    "text": "ἐὰν μὴ ἀκούσητε. καὶ ἐὰν μὴ θἡσθε εἰς τὴν καρδίαν ὑμῶν τοῦ δοῦναι δόξαν τῷ ὀνόματί μου, λέγει Κύριος Γαντοκράτωρ, καὶ ἐξαποστελῶ ἐφʼ ὑμᾶς τὴν κατάραν, καὶ ἐπικαταράσομαι τὴν εὐλογίαν ὑμῶν, καὶ καταράσομαι αὐτήν· καὶ διασκεδάσω τὴν εὐλογίαν ὑμῶν, καὶ οὐκ ἔσται ἐν ὑμῖν, ὅτι ὑμεῖς οὐ τίθεσθε εἰς τὴν καρδίαν ὑμῶν.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.3",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.3",
    "language": "grc",
    "text": "ἰδου ἐγὼ ἀφορίζω ὑμῖν, τὸν ὥμον, καὶ σκορπιῶ ἔνυστρον ἐπὶ τὰ πρόσωπα ὑμῶν, ἔνυστρον ἑορτῶν, καὶ λήμψομαι ὑμᾶς εἰς τὸ αὐτό·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.4",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.4",
    "language": "grc",
    "text": "καὶ ἐπιγνώσεσθε διότι ἐγὼ ἐξαπέσταλκα πρὸς ὑμᾶς τὴν ἐντολὴν ταύτην, τοῦ εἰναι τὴν διαθήκην μου πρὸς τοὺς Λευείτας, λέγει Κύριος Ιαντοκράτωρ.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.5",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.5",
    "language": "grc",
    "text": "ἡ διαθήκη μου ἦν μετʼ αὐτοῦ τῆς ζωῆς καὶ τῆς εἰρήνης. καὶ ἔδωκα αὐτῷ ἐν φόβῳ φοβεῖσθαι καὶ ἀπὸ προσώπου ὀνόματός μου στέλλεσθαι αὐτόν.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.6",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.6",
    "language": "grc",
    "text": "νόμος ἀληθείας ἣν ἐν τῷ στόματι αὐτοῦ, καὶ ἀδικία οὐχ εὑρέθη ἐν χείλεσιν αὐτοῦ· ἐν εἰρήνῃ κατευθύνων ἐπορεύθη μετʼ ἐμοῦ, καὶ πολλοὺς ἐπέστρεψεν ἀπὸ ἀδικίας.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.7",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.7",
    "language": "grc",
    "text": "ὅτι χείλη ἱερέως φυλάξεται γνῶσιν, καὶ νόμον ἐκζητήσουσιν ἐκ στόματος αὐτοῦ, διότι ἄγγελος Κυρίου Γαντοκράτορός ἐστιν.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.8",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.8",
    "language": "grc",
    "text": "ὑμεῖς δὲ ἐξεκλίνατε ἐκ τῆς ὁδοῦ καὶ ἠσθενήσατε πολλοὺς ἐν νόμῳ, διεφθείρατε τὴν διαθήκην τοῦ Λευὶ, λέγει Κύριος Γαντοκράτωρ.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.9",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.9",
    "language": "grc",
    "text": "κἀγὼ δέδωκα ὑμᾶς ἐξουδενωμένους καὶ ἀπερριμμένους εἰς πάντα τὰ ἔθνη, ἀνθʼ ὧν ὑμεῖς οὐ φυλάσσεσθε τὰς ὁδούς μου ἀλλὰ ἐλαμβάνετε πρόσωπα ἐν νόμῳ.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.10",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.10",
    "language": "grc",
    "text": "Οὐχὶ θεὸς εἰς ἔκτισεν ὑμᾶς; οὐχὶ πατὴρ εἰς πάντων ὑμῶν; τί ὅτι ἐνκατελίπετε ἕκαστος τὸν ἀδελφὸν αὐτοῦ, τοῦ βεβηλῶσαι τὴν διαθήκην τῶν πατέρων ὑμῶν;",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.11",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg047.2.11",
    "language": "grc",
    "text": "ἐνκατελίφθη Ἰούδας, καὶ βδέλυγμα ἐγένετο ἐν τῷ Ἰσραὴλ καὶ ἐν Ἰερουσαλήμ, διότι ἐβεβήλωσεν Ἰούδας τὰ ἅγια Κυρίου, ἐν οἷς ἠγάπησεν καὶ ἐπετήδευσεν εἰς θεοὺς ἀλλοτρίους.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg047/1st1K-grc1#tlg0527.tlg047.2.12",
    "work_id": "first1k/tlg0527/tlg047/1st1K-grc1",
