[
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.1",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.1",
    "language": "grc",
    "text": "ΑΟΓΟΣ Κυρίου ὃς ἐγενήθη πρὸς Σοφονίαν τὸν τοῦ Χουσεὶ υἱὸν Γοδολίου τοῦ Ἀμορίου τοῦ Ἑζεκίου ἐν ἡμέραις Ἰωσείου υἱοῦ Ἀμὼν βασιλέως Ἰούδα.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.2",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.2",
    "language": "grc",
    "text": "Ἐκλείψει ἐκλιπέτω ἀπὸ προσώπου τῆς γῆς, λέγει Κύριος·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.3",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.3",
    "language": "grc",
    "text": "ἐκλιπέτω ἄνθρωπος καὶ κτήνη, ἐκλιπέτω τὰ πετεινὰ τοῦ οὐρανοῦ καὶ οἱ ἰχθύες τῆς θαλάσσης· καὶ ἀσθενήσουσιν οἱ ἀσεβεῖς, καὶ ἐξαρῶ τοὺς ἀνόμους ἀπὸ προσώπου τῆς γῆς, λέγει Κύριος.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.4",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.4",
    "language": "grc",
    "text": "καὶ ἐκτενῶ τὴν χεῖρά μου ἐπὶ Ἰούδαν καὶ ἐπὶ πάντας τοὺς κατοικοῦντας Ἰερουσαλήμ· καὶ ἐξαρῶ ἐκ τοῦ τόπου τούτου τὰ ὀνόματα τῆς Βάαλ καὶ τὰ ὀνόματα τῶν ἱερέων,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.5",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.5",
    "language": "grc",
    "text": "καὶ τοὺς προσκυνοῦντας ἐπὶ τὰ δώματα τῇ στρατιᾷ τοῦ οὐρανοῦ, καὶ τοὺς προσκυνοῦντας καὶ τοὺς ὀμνύοντας κατὰ τοῦ κυρίου, καὶ τοὺς ὀμνύοντας κατὰ τοῦ βασιλέως αὐτῶν,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.6",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.6",
    "language": "grc",
    "text": "καὶ τοὺς ἐκκλίνοντας ἀπὸ τοῦ κυρίου, καὶ τοὺς μὴ ζητοῦντας τὸν κύριον, καὶ τοὺς μὴ ἀντεχομένους τοῦ κυρίου.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.7",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.7",
    "language": "grc",
    "text": "Εὐλαβεῖσθε ἀπὸ προσώπου Κυρίου τοῦ θεοῦ, διότι ἐγγὺς ἡμέρα τοῦ κυρίου, ὅτι ἡτοίμακεν Κύριος τὴν θυσίαν αὐτοῦ, ἡγίακεν τοὺς κλητοὺς αὐτοῦ.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.8",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.8",
    "language": "grc",
    "text": "καὶ ἔσται ἐν ἡμέρᾳ θυσίας Κυρίου καὶ ἐκδικήσω ἐπὶ τοὺς ἄρχοντας καὶ ἐπὶ τὸν οἶκον τοῦ βασιλέως καὶ ἐπὶ πάντας τοὺς ἐνδεδυμένους ἐνδύματα ἀλλότρια·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.9",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.9",
    "language": "grc",
    "text": "καὶ ἐκδικήσω ἐμφανῶς ἐπὶ τὰ πρόπυλα ἐν ἐκείνῃ τῇ ἡμέρᾳ, τοὺς πληροῦντας τὸν οἶκον Κυρίου θεοῦ αὐτῶν ἀσεβείας καὶ δόλου.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.10",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.10",
    "language": "grc",
    "text": "καὶ ἔσται ἐν τῇ ἡμέρᾳ ἐκείνῃ, λέγει Κύριος, φωνὴ κραυγῆς ἀπὸ πύλης ἀποκεντούντων, καὶ ὀλολυγμὸς ἀπὸ τῆς δευτέρας, καὶ συντριμμὸς μέγας ἀπὸ τῶν βουνῶν.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.11",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.11",
    "language": "grc",
    "text": "θρηνήσατε, οἱ κατοικοῦντες τὴν κατακεκομμένην, ὅτι ὡμοιώθη πᾶς ὁ λαὸς Χανάαν, ἐξωλεθρεύθησαν πάντες οἱ ἐπηρμένοι ἀργυρίῳ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.12",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.12",
    "language": "grc",
    "text": "καὶ ἔσται ἐν τῇ ἡμέρᾳ ἐκείνῃ ἐξερευνήσω τὴν Ἰερουσαλὴμ μετὰ λύχνου, καὶ ἐκδικήσω ἐπὶ τοὺς ἄνδρας τοὺς καταφρονοῦντας ἐπὶ τὰ φυλάγματα αὐτῶν· οἱ δὲ λέγοντες ἐν ταῖς καρδίαις αὐτῶν Οὐ μὴ ἀγαθοποιήσῃ Κύριος οὐδὲ μὴ κακώσῃ,",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.13",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.13",
    "language": "grc",
    "text": "καὶ ἔσται ἡ δύναμις αὐτῶν εἰς διαρπαγήν, καὶ οἱ οἶκοι αὐτῶν εἰς ἀφανισμόν· καὶ οἰκοδομήσουσιν οἰκίας καὶ οὐ μὴ κατοικήσουσιν ἐν αὐταῖς, καὶ καταφυτεύσουσιν ἀμπελῶνας καὶ οὐ μὴ πίωσιν τὸν οἶνον αὐτῶν.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.14",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.14",
    "language": "grc",
    "text": "Ὅτι ἐγγὺς ἡμέρα Κυρίου ἡ μεγάλη, ἐγγὺς καὶ ταχεῖα σφόδρα· φωνὴ ἡμέρας Κυρίου πικρὰ καὶ σκληρὰ τέτακται, δυνατή.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.15",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.15",
    "language": "grc",
    "text": "ἡμέρα ὀργῆς, ἡ ἡμέρα ἐκείνη, ἡμέρα θλίψεως καὶ ἀνάγκης, ἡμέρα ἀωρίας καὶ ἀφανισμοῦ, ἡμέρα σκότους καὶ γνόφου, ἡμέρα νεφέλης καὶ ὁμίχλης,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.16",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.16",
    "language": "grc",
    "text": "ἡμέρα σάλπιγγος καὶ κραυγῆς ἐπὶ τὰς πόλεις τὰς ὀχυρὰς καὶ ἐπὶ τὰς γωνίας τὰς ὑψηλάς.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.17",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.17",
    "language": "grc",
    "text": "καὶ ἐκθλίψω τοὺς ἀνθρώπους, καὶ πορεύσονται ὡς τυφλοί, ὅτι τῷ κυρίῳ ἐξήμαρτον· καὶ ἐκχεεῖ τὸ αἷμα αὐτῶν ὡς χοῦν, καὶ τὰς σάρκας αὐτῶν ὡς βόλβιτα·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.1.18",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.1.18",
    "language": "grc",
    "text": "καὶ τὸ ἀργύριον αὐτῶν καὶ τὸ χρυσίον αὐτῶν οὐ μὴ δύνηται ἐξελέσθαι αὐτοὺς ἐν ἡμέρᾳ ὀργῆς Κυρίου. καὶ ἐν πυρὶ ζήλους αὐτοῦ καταναλωθήσεται πᾶσα ἡ γῆ, διότι συντέλειαν καὶ σπουδὴν ποιήσει ἐπὶ πάντας τοὺς κατοικοῦντας τὴν γῆν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.1",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.1",
    "language": "grc",
    "text": "Συνάχθητε καὶ συνδέθητε, τὸ ἔθνος τὸ ἀπαίδευτον,",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.2",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.2",
    "language": "grc",
    "text": "πρὸ τοῦ γενέσθαι ὑμᾶς ὡς ἄνθος παραπορευόμενον, πρὸ τοῦ ἐπελθεῖν ἐφʼ ὑμᾶς ὀργὴν Κυρίου, πρὸ τοῦ ἐπελθεῖν ἐφʼ ὑμᾶς ἡμέραν θυμοῦ Κυρίου.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.3",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.3",
    "language": "grc",
    "text": "ζητήσατε τὸν κύριον, πάντες ταπεινοὶ γῆς· κρίμα ἐργάζεσθε καὶ δικαιοσύνην ζητήσατε, καὶ ἀποκρίνεσθε αὐτά, ὅπως σκεπασθῆτε ἐν ἡμέρᾳ ὀργῆς Κυρίου.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.4",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.4",
    "language": "grc",
    "text": "Διότι Γάζα διηρπασμένη ἔσται, καὶ Ἀσκάλων εἰς ἀφανισμόν, καὶ Ἄζωτος μεσημβρίας ἐκριφήσεται, καὶ Ἀκκαρὼν ἐκριζωθήσεται.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.5",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.5",
    "language": "grc",
    "text": "οὐαὶ οἱ κατοικοῦντες τὸ σχοίνισμα τῆς θαλάσσης, πάροικοι Κρητῶν· λόγος Κυρίου ἐφʼ ὑμᾶς Χανάαν, γῆ ἀλλοφύλων, καὶ ἀπολῶ ὑμᾶς ἐκ κατοικίας·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.6",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.6",
    "language": "grc",
    "text": "καὶ ἔσται Κρήτη νομὴ ποιμνίων καὶ μάνδρα προβάτων,",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.7",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.7",
    "language": "grc",
    "text": "καὶ ἔσται τὸ σχοίνισμα τῆς θαλάσσης τοῖς καταλοίποις οἴκου Ἰούδα· ἐπʼ αὐτοὺς νεμήσονται ἐν τοῖς οἴκοις Ἀσκάλωνος, δείλης καταλύσουσιν ἀπὸ προσώπου υἱῶν Ἰούδα, ὅτι ἐπέσκεπται αὐτοὺς Κύριος ὁ θεὸς αὐτῶν, καὶ ἀπέστρεψε τὴν αἰχμαλωσίαν αὐτῶν.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.8",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.8",
    "language": "grc",
    "text": "Ἤκουσα ὀνειδισμοὺς Μωὰβ καὶ κονδυλισμοὺς υἱῶν Ἀμμών, ἐν οἷς ὠνείδιζον τὸν λαόν μου καὶ ἐμεγαλύνοντο ἐπὶ τὰ ὅριά μου.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.9",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.9",
    "language": "grc",
    "text": "διὰ τοῦτο ζῶ ἐγώ, λέγει Κύριος τῶν δυνάμεων ὁ θεὸς Ἰσραήλ, διότι Μωὰβ ὡς Σόδομα ἔσται, καὶ υἱοὶ Ἀμμὼν ὡς Γόμορρα, καὶ Δαμασκὸς ἐκλελιμμένη ὡς θιμωνιὰ ἃλωνος καὶ ἠφανισμένη εἰς τὸν αἰῶνα· καὶ οἱ κατάλοιποι λαοῦ μου διαρπῶνται αὐτούς, καὶ οἱ κατάλοιποι ἔθνους μου κληρονομήσουσιν αὐτούς.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.10",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.10",
    "language": "grc",
    "text": "αὕτη αὐτοῖς ἀντὶ τῆς ὕβρεως αὐτῶν, διότι ὠνείδισαν καὶ ἐμεγαλύνθησαν ἐπὶ τὸν κύριον τὸν παντοκράτορα.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.11",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.11",
    "language": "grc",
    "text": "ἐπιφανήσεται Κύριος ἐπʼ αὐτούς, καὶ ἐξολεθρεύσει πάντας τοὺς §θεοὺς τῶν ἐθνῶν τῆς γῆς, καὶ προσκυνήσουσιν αὐτῷ ἕκαστος ἐκ τοῦ τόπου αὐτοῦ, πᾶσαι αἱ νῆσοι τῶν ἐθνῶν.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.12",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.12",
    "language": "grc",
    "text": "Καὶ ὑμεῖς, Αἰθίοπες, τραυματίαι ῥομφαίας μού ἐστε·",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.13",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.13",
    "language": "grc",
    "text": "καὶ ἐκτενεῖ τὴν χεῖρα αὐτοῦ ἐπὶ βορρᾶν καὶ ἀπολεῖ τὸν Ἀσσύριον, καὶ θήσει τὴν Νινευὴ εἰς ἀφανισμὸν ἄνυδρον ὡς ἔρημον·",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.2.14",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.2.14",
    "language": "grc",
    "text": "καὶ νεμήσονται ἐν μέσῳ αὐτῆς ποίμνια καὶ πάντα τὰ θηρία τῆς γῆς, καὶ χαμαιλέοντες καὶ ἐχῖνοι ἐν τοῖς φατνώμασιν αὐτῆς κοιτασθήσονται, καὶ θηρία φωνήσει ἐν τοῖς διορύγμασιν αὐτῆς, κόρακες ἐν τοῖς πυλῶσιν αὐτῆς, διότι κέδρος τὸ ἀνάστημα αὐτῆς.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.1",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.1",
    "language": "grc",
    "text": "Aὕτη ἡ πόλις ἡ φαυλίστρια, ἡ κατοικοῦσα ἐπ᾿ ἐλπίδι, ἡ λέγουσα ἐν καρδίᾳ αὐτῆς Ἐγὼ εἰμι, καὶ οὐκ ἔστιν μετʼ ἐμὲ ἔτι. πῶς ἐγενήθη εἰς ἀφανισμόν, νομὴ θηρίων· πᾶς ὁ διαπορευόμενος (1) δι᾿ αὐτῆς συριεῖ καὶ κινήσει τὰς χεῖρας αὐτοῦ.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.2",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.2",
    "language": "grc",
    "text": "ὢ ἡ ἐπιφανὴς (2) καὶ ἀπολελυτρωμένη πόλις, ἡ περιστερά· (2)οὐκ εἰσήκουσεν φωνῆς, οὐκ ἐδέξατο παιδίαν, ἐπὶ τῷ κυρίῳ οὐκ ἐπεποίθει, καὶ πρὸς τὸν θεὸν αὐτῆς οὐκ ἤγγισεν.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.3",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.3",
    "language": "grc",
    "text": "οἱ ἄρχοντες αὐτῆς ἐν αὐτῇ ὡς λέοντες ὠρυόμενοι· οἱ κριταὶ αὐτῆς ὡς λύκοι τῆς Ἀραβίας, οὐχ ὑπελίποντο εἰς τὸ πρωί·",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.4",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.4",
    "language": "grc",
    "text": "οἱ προφῆται αὐτῆς πνευματοφόροι, ἄνδρες καταφρονηταί· οἱ ἱερεῖς αὐτῆς βεβηλοῦσιν τὰ ἅγια καὶ ἀσεβοῦσιν νόμον.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.5",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.5",
    "language": "grc",
    "text": "ὁ δὲ κύριος δίκαιος ἐν μέσῳ αὐτῆς καὶ οὐ μὴ ποιήσῃ ἄδικον· πρωὶ πρωὶ δώσει κρίμα αὐτοῦ εἰς φῶς, καὶ οὐκ ἀπεκρύβη καὶ οὐκ ἔγνω ἀδικίαν ἐν ἀπαιτήσει, καὶ οὐκ εἰς νῖκος ἀδικίαν.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.6",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.6",
    "language": "grc",
    "text": "ἐν διαφθορᾷ κατέσπασα ὑπερηφάνους, ἠφανίσθησαν γωνίαι αὐτῶν· ἐξερημώσω τὰς ὁδοὺς αὐτῶν τὸ παράπαν τοῦ μὴ διοδεύειν· ἐξέλιπον αἱ πόλεις αὐτῶν παρὰ τὸ μηδένα ὑπάρχειν μηδέ κατοικεῖν.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.7",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.7",
    "language": "grc",
    "text": "εἶπα Πλὴν φοβεῖσθέ με καὶ δέξασθε παιδείαν, καὶ οὐ μὴ ἐξολοθρευθῆτε ἐξ ὀφθαλμῶν αὐτῆς, πάντα ὅσα ἐξεδίκησα ἐπʼ αὐτήν· ἑτοιμάζου ὄρθρισον, ἔφθαρται πᾶσα ἡ ἐπιφυλλὶς αὐτῶν.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.8",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.8",
    "language": "grc",
    "text": "Διὰ τοῦτο ὑπόμεινόν με, λέγει Κύριος, εἰς ἡμέραν ἀναστάσεώς μου εἰς μαρτύριον· διότι τὸ κρίμα μου εἰς συναγωγὰς ἐθνῶν, τοῦ εἰσδέξασθαι βασιλεῖς, τοῦ ἐκχέαι ἐπʼ αὐτοὺς πᾶσαν ὀργὴν θυμοῦ μου· διότι ἐν πυρὶ ζήλους μου καταναλωθήσεται πᾶσα ἡ γῆ.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.9",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.9",
    "language": "grc",
    "text": "ὅτι τότε μεταστρέψω ἐπὶ λαοὺς γλῶσσαν εἰς γενεὰν αὐτῆς, τοῦ ἐπικαλεῖσθαι πάντας ¶ τὸ ὄνομα Κυρίου, τοῦ δουλεύειν αὐτῷ ὑπὸ ζυγὸν ἕνα.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.10",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.10",
    "language": "grc",
    "text": "ἐκ περάτων ποταμῶν Αἰθιοπίας προσδέξομαι ἐν διεσπαρμένοις μου, οἴσουσιν θυσίας μοι.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.11",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.11",
    "language": "grc",
    "text": "ἐν τῇ ἡμέρᾳ ἐκείνῃ οὐ μὴ καταισχυνθῇς ἐκ πάντων τῶν ἐπιτηδευμάτων σου ὧν ἠσέβησας εἰς ἐμέ· ὃτι τότε περιελῶ ἀπὸ σοῦ τὰ φαυλίσματα τῆς ὕβρεώς σου, καὶ οὐκέτι μὴ προσθῇς τοῦ μεγαλαυχῆσαι ἐπὶ τὸ ὄρος τὸ ἅγιόν μου.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.12",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.12",
    "language": "grc",
    "text": "καὶ ὑπολείψομαι ἐν σοὶ λαὸν πρᾳὺν καὶ ταπεινόν, καὶ εὐλαβηθήσονται ἀπὸ τοῦ ὀνόματος Κυρίου ¹³οἱ κατάλοιποι τοῦ Ἰσραήλ, καὶ οὐ ποιήσουσιν ἀδικίαν καὶ οὐ λαλήσουσιν μάταια, καὶ οὐ μὴ εὑρεθῇ ἐν τῷ στόματι αὐτῶν γλῶσσα δολία· διότι αὐτοὶ νεμήσονται καὶ κοιτασθήσονται, καὶ οὐκ ἔσται ὁ ἐκφοβῶν αὐτούς.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.14",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.14",
    "language": "grc",
    "text": "Καῖρε, θύγατερ Σειών, κήρυσσε, θύγατερ Ἰερουσαλήμ· εὐφραίνου καὶ κατατέρπου ἐξ ὅλης τῆς καρδίας σου, θύγατερ Ἰερουσαλήμ.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.15",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.15",
    "language": "grc",
    "text": "περιεῖλεν Κύριος τὰ ἀδικήματά σου, λελύτρωταί σε ἐκ χειρὸς ἐχθρῶν σου· βασιλεὺς Ἰσραὴλ Κύριος ἐν μέσῳ σου, οὐκ ὄψῃ κακὰ οὐκέτι.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.16",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.16",
    "language": "grc",
    "text": "ἐν τῷ καιρῷ ἐκείνῳ ἐρεῖ Κύριος τῇ Ἰερουσαλήμ Θάρσει, Σειών, μὴ παρείσθωσαν αἱ χεῖρές σου.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.17",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.17",
    "language": "grc",
    "text": "Κύριος ὁ θεός σου ἐν σοί, ὁ δυνατὸς σώσει σε, ἐπάξει ἐπὶ σὲ εὐφροσύνην καὶ καινιεῖ σε ἐν τῇ ἀγαπήσει αὐτοῦ, καὶ εὐφρανθήσεται ἐπὶ σέ ἐν τέρψει ὡς ἐν ἡμέρᾳ ἑορτῆς.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.18",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.18",
    "language": "grc",
    "text": "καὶ συνάξω τοὺς συντετριμμένους· οὐαί, τίς ἔλαβεν ἐπʼ αὐτὴν ὀνειδισμόν;",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.19",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.19",
    "language": "grc",
    "text": "ἰδοὺ ἐγὼ ποιῶ ἐν σοὶ ἕνεκεν σοῦ ἐν τῷ καιρῷ ἐκείνῳ, λέγει Κύριος, καὶ σώσω τὴν ἐκπεπιεσμένην καὶ τὴν ἀπωσμένην· εἰσδέξομαι αὐτοὺς εἰς καύχημα καὶ ὀνομαστοὺς ἐν πάσῃ τῇ γῇ.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0527/tlg044/1st1K-grc1#tlg0527.tlg044.3.20",
    "work_id": "first1k/tlg0527/tlg044/1st1K-grc1",
    "canonical_ref": "tlg0527.tlg044.3.20",
    "language": "grc",
    "text": "καὶ καταισχυνθήσονται ἐν τῷ καιρῷ ἐκείνῳ ὅταν καλῶς ὑμῖν ποιήσω, καὶ ἐν τῷ καιρῷ ὅταν εἰσδέξομαι ὑμᾶς· διότι δώσω ὑμᾶς ὀνομαστοὺς καὶ εἰς καύχημα ἐν πᾶσιν τοῖς λαοῖς τῆς γῆς, ἐν τῷ στρέφειν με τὴν αἰχμαλωσίαν ὑμῶν ἐνώπιον ὑμῶν, λέγει Κύριος.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  }
]