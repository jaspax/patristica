[
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.1",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.1",
    "language": "grc",
    "text": "Καθόλου τοίνυν περὶ τῶν ἐν τῇ γῇ γινομένων σεισμῶν καὶ τῆς τούτων αἰτίας, καθὰ τοῖς παλαιοῖς διείληπται, ῥητέον δυσεπηβόλου τε καὶ σχεδὸν ἀτεκμάρτου αὐτοῖς τοῦ τοιούτου εἴδους καταληφθέντος· ἐπεὶ τοίνυν τοῖς περὶ τὴν γῆν πάθεσιν μίαν ἐκ πασῶν τὴν περὶ τοῦ καταγείου πυρὸς αἰτίαν τέως ἀποδεχομένους ὁρῶμεν, ἐπεὶ καὶ τοὺς τόπους, ἐν οἷς συνεχῶς σάλοι συμβαίνουσιν, ἐπετήρησαν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.2",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.2",
    "language": "grc",
    "text": "καὶ γὰρ τὸ πῦρ διεργαζόμενον cetera quae apud Lydum cap. 53 p. 107 v. 14 usque ad p. 109 v. 10 leguntur.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.3",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.3",
    "language": "grc",
    "text": "οἱ δέ γε τῶν φυσικῶν ἀκριβέστερον περὶ σεισμῶν ἀναλαβόντες τὴν αὐτῶν γένεσιν οὕτως πώς φασιν. ἔστι φανερὸν ὅτι ἀναγκαῖον καὶ ἀπὸ ὑγροῦ καὶ ἀπὸ ξηροῦ γίνεσθαι ἀναθυμίασιν cetera quae leguntur per totum caput octavum Aristotelis meteorologic. lib. II; et explicit: περὶ μὲν οὖν σεισμῶν καὶ ὅντινα τρόπον γίγνονται τὰ παρὰ τῶν παλαιῶν εὑρήματα τοσαῦτα.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.4",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.4",
    "language": "grc",
    "text": "Ἃ δὲ καὶ περὶ τοῦ προγνῶναι τὴν αὐτῶν γένεσιν, ὅσον κατὰ δύναμιν ἀνθρώποις ἐσημειώθη, συναγαγόντες εἰς ἓν σύνοπτον παραθεῖναι διέγνωμεν.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.5",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.5",
    "language": "grc",
    "text": "λέγεται τοίνυν σημαίνειν σεισμὸς τῶν κακοποιῶν ἀστέρων ἐν τοῖς ἐπισήμοις τῷ πάθει ζωδίοις γιγνομένων.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.6",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.6",
    "language": "grc",
    "text": "Κρόνος ἐν ταύρῳ.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.7",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.7",
    "language": "grc",
    "text": "Κρόνος μὲν γὰρ εἰς τὸν ταῦρον τὴν μετάβασιν ποιούμενος σεισμὸν ὡς ἐπὶ τὸ πλεῖστον ποιεῖ κατὰ τόπους καὶ μάλιστα ἐν ταῖς χώραις καὶ πόλεσιν, ἐν αἷς ὑπάρχει ἡ τοῦ ταύρου δεσποτία.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.8",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.8",
    "language": "grc",
    "text": "ὁ δ᾽ αὐτὸς ἀστὴρ τοῦ Κρόνου καὶ φάσιν ποιούμενος ἐν τῷ πρώτῳ δεκανῷ τοῦ ταύρου σεισμοὺς κατὰ τόπους ποιεῖ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.9",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.9",
    "language": "grc",
    "text": "Κρόνος ἐν διδύμοις.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.10",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.10",
    "language": "grc",
    "text": "ἐν δὲ τοῖς διδύμοις ὁ Κρόνος γενόμενος καὶ ἐν τοῖς βορείοις ἐλθὼν τούτου τοῦ ζωδίου μέρεσι σεισμοὺς κατὰ τόπους ποιεῖ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.11",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.11",
    "language": "grc",
    "text": "Κρόνος ἐν καρκίνῳ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.12",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.12",
    "language": "grc",
    "text": "ἔτι δ᾽ ἐν καρκίνῳ τὴν μετάβασιν ὁ Κρόνος ποιούμενος σεισμοὺς ποιεῖ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.13",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.13",
    "language": "grc",
    "text": "Κρόνος ἐν σκορπίῳ.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.14",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.14",
    "language": "grc",
    "text": "ἐν δὲ τῷ τρίτῳ δεκανῷ τοῦ σκορπίου φάσιν ὁ Κρόνος ποιούμενος σεισμὸν γενέσθαι σημαίνει.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.15",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.15",
    "language": "grc",
    "text": "Ἄρης ἐν ταύρῳ.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.16",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.16",
    "language": "grc",
    "text": "Ἄρης δ᾽ ἐν ταύρῳ διὰ μέσου τοῦ ζωδίου γινόμενος σεισμῶν ἐστι κινητικός.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.17",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.17",
    "language": "grc",
    "text": "ἐν δὲ τοῖς διδύμοις ὁ αὐτὸς ἀστὴρ γινόμενος καὶ ἐν τοῖς βορείοις τοῦ ζωδίου μέρεσιν ἐλθὼν σεισμὸν ποιεῖ.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.18",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.18",
    "language": "grc",
    "text": "ἐν καρκίνῳ δὲ Ἄρης φάσιν ποιούμενος ἐν τῷ πρώτῳ δεκανῷ σεισμὸν σημαίνει.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.19",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.19",
    "language": "grc",
    "text": "ἥλιος ἐν ὑδροχόῳ.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.20",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.20",
    "language": "grc",
    "text": "καὶ ἥλιος δὲ ἐκλείπων ἐν τῷ δευντέρῳ δεκανῷ τοῦ ὑδροχόου σεισμοὺς σημαίνει.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.21",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.21",
    "language": "grc",
    "text": "ἥλιος ἐν ἰχθύσιν.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.22",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.22",
    "language": "grc",
    "text": "ἔτι δὲ ἐκλείπων ὁ ἥλιος ἐν τῇ πρώτῃ δεκαμοιρίᾳ τῶν ἰχθύων σεισμὸν ἐν ταῖς παραλίαις σημαίνει.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.23",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.23",
    "language": "grc",
    "text": "σελήνη ἐν σκορπίῳ.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.24",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.24",
    "language": "grc",
    "text": "σελήνη δὲ ἐκλείπουσα ἐν τῇ πρώτῃ δεκαμοιρίᾳ τοῦ σκορπίου ἐνίοτε σεισμὸν σημαίνει.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.25",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.25",
    "language": "grc",
    "text": "Καθόλου δὲ αἱ ὑπὸ γῆν ἐκλείψεις ἡλίου ἢ σελήνης σεισμοὺς ἀποτελοῦσιν ὡς ἐπὶ τὸ πλεῖστον.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.26",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.26",
    "language": "grc",
    "text": "ἔτι τὰ προηγούμενα τοῦ δωδεκατημορίου τοῦ ταύρου καὶ μάλιστα τὰ κατὰ τὴν πλειάδα σεισμώδη γίγνεται, εἰ μή τις τῶν ἀγαθοποιῶν ἀστέρων ἐπίδοι.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.27",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.27",
    "language": "grc",
    "text": "καὶ τὰ βόρεια δὲ τοῦ δωδεκατημορίου τῶν διδύμων σεισμώδη καθίσταται καὶ τὰ τοῦ δωδεκατημορίου τοῦ σκορπίου ἑπόμενα σεισμώδη φασίν.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.28",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.28",
    "language": "grc",
    "text": "ὁ δὲ τοῦ Ἑρμοῦ ἀστὴρ τὴν οἰκοδεσποτίαν λαβὼν σεισμῶν ἀποτελεστικὸς περὶ τὸ κατάστημα.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.29",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.29",
    "language": "grc",
    "text": "περὶ δὲ τὰς τῆς σελήνης ἐκλείψεις ἐνίοτε προσδοκᾶν χρὴ εὐθὺς γενέσθαι σεισμόν.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2972/tlg001/1st1K-grc1#tlg2972.tlg001.30",
    "work_id": "first1k/tlg2972/tlg001/1st1K-grc1",
    "canonical_ref": "tlg2972.tlg001.30",
    "language": "grc",
    "text": "ἐὰν δὲ μεθ᾽ ἡμέραν ἢ μικρὸν μετὰ δυσμὰς αἰθρίας οὔσης νεφέλιον λεπτὸν φαίνηται διατεῖνον καὶ μακρὸν οἷον γραμμῆς μῆκος εὐθύτητι διηκριβωμένον, σεισμὸν σημαίνει παραυτίκα.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
