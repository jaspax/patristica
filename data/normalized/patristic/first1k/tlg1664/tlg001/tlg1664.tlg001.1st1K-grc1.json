    "canonical_ref": "tlg1664.tlg001.6",
    "language": "grc",
    "text": "v. 1. Ἐπίστευσα, διὸ ἐλάλησα· ἐγὼ δὲ ἐταπεινώθην σφόδρα.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
