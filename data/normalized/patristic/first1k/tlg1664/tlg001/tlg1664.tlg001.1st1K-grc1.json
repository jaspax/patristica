    "canonical_ref": "tlg1664.tlg001.7",
    "language": "grc",
    "text": "v. 1. Μακάριοι οἱ ἄμωμοι ἐν ὁδῷ, οἱ πορευόμενοι ἐν νόμῳ Κυρίου.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
