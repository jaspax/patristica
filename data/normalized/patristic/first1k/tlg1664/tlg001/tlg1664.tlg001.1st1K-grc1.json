[
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1",
    "language": "grc",
    "text": "Ἐπειδή τισιν ἔδοξεν ὁ ψαλμὸς καὶ εἰς Χριστὸν ἀναφέρεσθαι, λεγέσθω καὶ τὰ ἐκείνων.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.1",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.1",
    "language": "grc",
    "text": "Πρῶτον μὲν οὖν ἡ ἐπιγραφὴ εἰς ἀνάμνησιν ἡμᾶς ἄγει τοῦ Σαββάτου ἐκείνου τοῦ μεγάλου, ἐν ᾧ ὁ Χριστὸς ὑπὸ γῆν ἐκρύπτετο.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.2",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.2",
    "language": "grc",
    "text": "Εἶτα, αὐτὸς τὸ τῆς ἀνθρωπότητος ἀναδεξάμενος πρόσωπον, ἐλεγχθῆναι τὴν φύσιν βούλεται, ἀλλ’ οὐκ ἐν ὀργῇ, πρὸς δὲ ἔλεγχον, τὸν ἐπὶ σωτηρίᾳ, καὶ παιδευθῆναι, ἀλλ’ οὐκ ἐν θυμῷ, ἀλλὰ τὴν ἐν εἴρήνῃ καὶ διὰ λό- γον παιδείαν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.3",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.3",
    "language": "grc",
    "text": "Ὁ Χριστὸς δὲ καὶ τὸν ἐφ’ ἡμᾶς ἔλεγχον καὶ τὴν παιδείαν ἔλαβεν, ὁ αὐτὸς ἐλέγχων μὲν ὡς Θεὸς, ὡς δὲ ἄνθρωπος ἐλεγχόμενος.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.4",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.4",
    "language": "grc",
    "text": "Διό φησι πρὸς τὸν Πατέρα· Ὅτι τὰ σὰ βέλη καὶ αἱ πλῆγαι, ὅσας οἱ ἄνθρωποι ὤφειλον, ἐμοὶ ἐνεπάγησαν. Ἐπειδὴ γὰρ ἐγὼ τὰς τοῦ γένους ἁμαρτίας ἔλαβον, ἀναγκαίως καὶ τὰς ὑπὲρ αὐτῶν ὑφίσταμαι μάστιγας, καὶ τὴν χεῖρά σου τὴν παιδευτικὴν ἐπ’ ἐμὲ ἐπεστηριγμένην παραιτοῦμαι, καὶ τὴν σὴν, ὧ Πάτερ, ὀργήν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.5",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.5",
    "language": "grc",
    "text": "Ἐὰν γὰρ ἀνομίας παρατηρήσῃς, τίς ὑποστήσεται; τί δὲ τῆς σῆς ὀργῆς ἔσται φάρμακον; Διὰ δὲ τούτων ἀνθρώπων, ἁμαρτίας τὰς πολλἀς καὶ φορτίου παντὸς βαρυτέρας. ἐβάστασα· διὰ ταύτας καὶ τετάραγμαι, ὥστε εἰπεῖν· Νῦν ἡ ψυχή μου τετάρακται.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.6",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.6",
    "language": "grc",
    "text": "Καὶ ἡ ἐπιθυμία δὲ πᾶσα ἡ ἁγία ἐνώπιόν σου ἐστι, καὶ σὺ ἐκτήσω τοὺς νεφρούς μου, ἤγουν τοὺς λογισμοὺς, οἷς τοῦ χρησίμου τὸ περιττὸν ἀποκρίνουσιν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.7",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.7",
    "language": "grc",
    "text": "Οἰκειοῦμαι δὲ καὶ τὸ τοῦ Ἰούδα πταῖσμα, ὡς διδάσκαλος μαθητοῦ· καὶ σαπῆναί φημι τοὺς μόλωπάς μου διὰ τὴν ἀγχόνην καὶ τὴν ἀπόγνωσιν.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.8",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.8",
    "language": "grc",
    "text": "Καὶ μέντοι ἐταπεινώθην μέχρι θανάτου, θανάτου δὲ σταυροῦ· καὶ ἐστέναζον ἐπὶ τῇ τῶν Ἰουδαίων ἀπωλείᾳ, ὑφ’ ὧν ἐνεπαιζόμην καὶ ἐκολαφιζόμην, καὶ ἡ καρδία πάντως ἐταράχθη, ὅτι σάρξ μου ὄντες καὶ συγγενεῖς κατὰ σάρκα.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.9",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.9",
    "language": "grc",
    "text": "Οἱ φίλοι μου καὶ οἱ πλησίον μου ἐξέναντί μου ἤγγισαν καὶ ἔστησαν· καὶ οἱ ἔγγιστά μου ἀπὸ μακρόθεν ἔστησαν.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.10",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.10",
    "language": "grc",
    "text": "Οὕτω περὶ ἐμὲ διετέθησαν, ὅτε καὶ ἡ ἰσχύς μου, ὁ στεῤῥὸς Πέτρος ἐγκατέλιπεν ἀρνησάμενός με, καὶ οἱ ἄλλοι μαθηταὶ, πρὸς οὒς ἔλεγον· Ὑμεῖς ἐστὲ τὸ φῶς τοῦ κόσμου, οὐκ ἦσαν μετ’ ἐμοῦ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.11",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.11",
    "language": "grc",
    "text": "Ἀλλὰ καὶ οἱ φιλούμενοί μοι Ἰουδαῖοι, οἱ πλησίον μου, διὰ τὴν πίστιν ἀπόστολοι, ἀπὸ μακρόθεν ἔστησαν, τοὺς ἐπιβουλεύοντας εὐλαβούμενοι.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.12",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.12",
    "language": "grc",
    "text": "Καὶ οἱ ζητοῦντες τὴν ψυχήν μου ἐξεβιάζοντο, τὴν περὶ ἐμοῦ δόξαν διὰ φθόνου ὑπορύττοντες. Ἐβούλοντο γὰρ δοκεῖν ὑπὲρ τοῦ νόμου ζηλοῦν.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.13",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.13",
    "language": "grc",
    "text": "Διὸ καὶ δολιότητος ἐμελέτησαν, λέγοντες· Τοῦτον εὕρομεν διαστρέφοντα ἔθνος ἡμῶν καὶ κωλύοντα φόρους διδόναι Καίσαρι. Ἐγὼ δὲ καὶ συκοφαντούμενος ἐσιώπων, καὶ λόγους μὲν πολλοὺς εἶχον εἰς ἔλεγχον.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.14",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.14",
    "language": "grc",
    "text": "Οὐκ ἐφρόντιζον δὲ τῶν ψευδομαρτυρούντων. Σοὶ, Πάτερ, θαῤῥῶ ὡς ἀληθινῷ καὶ ἀδεκάστῳ μάρτυρι, καί γε πρὸς σὲ βοῶ.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.15",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.15",
    "language": "grc",
    "text": "Τήρησον τοὺς μαθητὰς ἐν τῷ ὀνόματί σου, μήποτε ἐπιχαρῶσιν οἱ ἐχθροί μου δαίμονες, τοῦ χοροῦ μὴ φυλαχθέντος τῶν ἀποστόλων· μηδὲ μεγαλοῤῥημονήσωσιν Ἰουδαῖοι, ὁρῶντες ἐμοῦ τοὺς πόδας, τοὺς μαθητάς, πρὸς μικρὸν διὰ τὸν σταυρὸν σαλευθέντας, καὶ ἀγνοοῦντας τὸ μυστήριον.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.16",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.16",
    "language": "grc",
    "text": "Ὅτι ἐγὼ εἰς μάστιγας ἕτοιμος διὰ τὴν πρὸς ἀνθρώπους συμπάθειαν· ἧς ἕνεκα καὶ τοῦ οἰκείου πάθους ἔχω διὰ παντὸς τὴν ἀνάμνησιν, ἐξ ὧν πέπονθα καὶ τοῖς πειραζομένοις δυνάμενος βοηθεῖν. Ἐγὼ μὲν οὖν τὴν τοῦ γένους ἀνομίαν λογιζόμενος, μεριμνῶ τίνα τρόπον αὐτὴν καθαρῶ.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.17",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.17",
    "language": "grc",
    "text": "Οἱ δὲ ἐχθροί μου Ἰουδαοι ζῶσιν, ἐν κακίᾳ δηλονότι καὶ ἀπιστίᾳ; καὶ κατὰ ταύτην κραταιοῦνται, καὶ πληθύνονται οἱ μισοῦντές με ἀδίκως, εἰ καὶ οὐδεμίαν τοῦ μίσους εὔλογον ἔχουσι πρόφασιν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.18",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.18",
    "language": "grc",
    "text": "Καὶ διαβάλλουσί με, διότι ἀγαθωσύνης εἰς αὐτοὺς ἐποίησα τὸ παράδοξον· αἰτιῶνται γὰρ ὅτι τοὺς αὐτῶν ἀῤῥώστους ἐν σαββάτῳ ἐθεράπευσα.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.1.19",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.1.19",
    "language": "grc",
    "text": "Ἀλλ’, ὦ Πάτερ, μὴ ἐγκαταλίπῃς με· ἐμὲ δὲ λέγων, τὴν τῶν πιστῶν ἐκκλησίαν λέγω, ἧς καὶ τὴν σωτηρίαν οἰκειοῦμαι, ὥσπερ νὖν καὶ τὰ ἁμαρτήματα.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.3",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.3",
    "language": "grc",
    "text": "v. 9. Οἱ δὲ πραεῖς κληρονομήσουσιν γῆν. Vat. 645, 2.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.3.1",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.3.1",
    "language": "grc",
    "text": "Οἱ ἀπὸ Οὐαλεντίνου καί τινων ἑτέρων αἱρέσεων, οἰόμενοι τὸν Σωτῆρα λέγειν τὰ μὴ εἰρημένα ἐν τοῖς παλαιοῖς γράμμασιν, ἐντεῦθεν ἐλεγχέσθωσαν, . . . . . . . . ἀκούοντες, ὅτι μακάριοι πραεῖς, ὅτι αὐτοὶ κληρονομήσουσιν τὴν γῆν. Εἴρητο γὰρ τοῦτο καὶ πρότερον διὰ Δαυὶδ ὑπὸ τοῦ αὐτοῦ Πνεύματος.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.4",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.4",
    "language": "grc",
    "text": "v. 14, 15. Θῦσον τῷ Θεῷ θυσίαν αἰνέσεως, καὶ ἀπόδος τῷ Ὑψίστῳ τάς εὐχάς σου, καὶ ἐπικάλεσαί με ἐν ἡμέρᾳ θλίψεως. Vat. 654, 2.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.4.1",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.4.1",
    "language": "grc",
    "text": "Θῦσον τῷ Θεῷ τῷ Πατρί.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.4.2",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.4.2",
    "language": "grc",
    "text": "Καὶ ἀπόδος Ὑψίστῳ τῷ Υἱῷ.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1664/tlg001/1st1K-grc1#tlg1664.tlg001.4.3",
    "work_id": "first1k/tlg1664/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1664.tlg001.4.3",
    "language": "grc",
    "text": "Καὶ ἐπικάλεσαί με τὸ Πνεῦμα τὸ ἄγιον.",
    "chunk_index": 25,
    "context_before": null,
