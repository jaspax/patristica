[
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.1",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.1",
    "language": "grc",
    "text": "Τὸ μακάριον καὶ ἄφθαρτον οὔτε αὐτὸ πράγματα ἔχει οὔτε ἄλλῳ παρέχει, οὔτε ὀργαῖς οὔτε χάρισι συνέχεται· ἐν ἀσθενείᾳ γὰρ πάντα τὰ τοιαῦτα.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.2",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.2",
    "language": "grc",
    "text": "Ὁ θάνατος οὐδὲν πρὸς ἡμᾶς· τὸ γὰρ διαλυθὲν ἀναισθητεῖ· τὸ δὲ ἀναισθητοῦν οὐδὲν πρὸς ἡμᾶς.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.3",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.3",
    "language": "grc",
    "text": "Οὐ χρονίζει τὸ ἀλγοῦν ἐν τῇ σαρκί, ἀλλὰ τὸ μὲν ἄκρον τὸν ἐλάχιστον χρόνον πάρεστι, τὸ δὲ μέσον τὸ ὑπερτεῖνον τὸ ἡδόμενον κατὰ σάρκα 〈οὐ〉 πολλὰς ἡμέρας ὑπάρχει, αἱ δὲ πολυχρόνιοι τῶν ἀρρωστιῶν πλεονάζον ἔχουσιν ἐν τῇ σαρκὶ τὸ ἡδόμενον ἢ τὸ ἀλγοῦν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.4",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.4",
    "language": "grc",
    "text": "Πᾶσα ἀλγηδὼν εὐκαταφρόνητος· ἡ γὰρ σύντονον ἔχουσα τὸ πονοῦν σύντομον ἔχει τὸν χρόνον, ἡ δὲ χρονίζουσα περὶ τὴν σάρκα ἀβληχρὸν ἔχει τὸν πόνον.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.5",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.5",
    "language": "grc",
    "text": "Οὐκ ἔστιν ἡδέως ζῆν ἄνευ τοῦ φρονίμως καὶ καλῶς καὶ δικαίως· ὅπου δὲ τοῦτο μὴ ὑπάρχει, οὐκ ἔστιν ἡδέως ζῆν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.6",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.6",
    "language": "grc",
    "text": "Οὐκ ἔστι τὸν λάθρα τι ποιοῦντα, ὧν συνέθεντο πρὸς ἀλλήλους εἰς τὸ μὴ βλάπτειν μηδὲ βλάπτεσθαι, πιστεύειν ὅτι λήσει, κἂν μυριάκις ἐπὶ τοῦ παρόντος λανθάνῃ· μέχρι γὰρ καταστροφῆς ἄδηλον εἰ λήσει.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.7",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.7",
    "language": "grc",
    "text": "Ἀδικοῦντα λαθεῖν μὲν δύσκολον, πίστιν δὲ λαβεῖν ὑπὲρ τοῦ λαθεῖν ἀδύνατον.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.8",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.8",
    "language": "grc",
    "text": "Ὁ τῆς φύσεως πλοῦτος ὥρισται καὶ εὐπόριστός ἐστιν. ὁ δὲ τῶν κενῶν δοξῶν εἰς ἄπειρον ἐκπίπτει καὶ ἔστι δυσπόριστος.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.9",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.9",
    "language": "grc",
    "text": "Κακὸν ἀνάγκη, ἀλλ’ οὐδεμία ἀνάγκη ζῆν μετὰ ἀνάγκης.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.10",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.10",
    "language": "grc",
    "text": "Μέμνησο ὅτι θνητὸς ὢν τῇ φύσει καὶ λαβὼν χρόνον ὡρισμένον ἀνέβης τοῖς περὶ φύσεως διαλογισμοῖς ἐπὶ τὴν ἀπειρίαν καὶ τὸν αἰῶνα καὶ κατεῖδες τά τ’ ἐόντα τά τ’ ἐσσόμενα πρό τ’ ἐόντα.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.11",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.11",
    "language": "grc",
    "text": "Τῶν πλείστων ἀνθρώπων τὸ μὲν ἡσυχάζον ναρκᾷ, τὸ δὲ κινούμενον λυττᾷ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.12",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.12",
    "language": "grc",
    "text": "Ὁ δίκαιος βίος ἀταρακτότατος, ὁ δὲ ἄδικος πλείστης ταραχῆς γέμων.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.13",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.13",
    "language": "grc",
    "text": "Ὧν ἡ σοφία παρασκευάζεται εἰς τὴν τοῦ ὅλου βίου μακαριότητα, πολὺ μέγιστόν ἐστιν ἡ τῆς φιλίας κτῆσις.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.14",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.14",
    "language": "grc",
    "text": "Γεγόναμεν ἅπαξ, δὶς δὲ οὐκ ἔστι γενέσθαι· δεῖ δὲ τὸν αἰῶνα μηκέτι εἶναι· σὺ δὲ οὐκ ὢν τῆς αὔριον 〈κύριος〉 ἀναβάλλῃ τὸν καιρόν· ὁ δὲ βίος μελλησμῷ παραπόλλυται καὶ εἷς ἕκαστος ἡμῶν ἀσχολούμενος ἀποθνῄσκει.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.15",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.15",
    "language": "grc",
    "text": "Ἤθη ὥσπερ τὰ ἡμῶν αὐτῶν ἴδια τιμῶμεν, ἄν τε χρηστὰ ἔχωμεν καὶ ὑπὸ τῶν ἀνθρώπων ζηλούμενα, ἄν τε μή· οὕτω χρὴ καὶ 〈τὰ〉 τῶν πέλας, ἂν ἐπιεικεῖς ὦσιν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.16",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.16",
    "language": "grc",
    "text": "Οὐδεὶς βλέπων τὸ κακὸν αἱρεῖται αὐτό, ἀλλὰ δελεασθεὶς ὡς ἀγαθῷ 〈ὄντι αὐτῷ καὶ οὐκ ἀποβλέψας〉 πρὸς τὸ μεῖζον αὐτοῦ κακὸν ἐθηρεύθη.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.17",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.17",
    "language": "grc",
    "text": "Οὐ νέος μακαριστός, ἀλλὰ γέρων βεβιωκὼς καλῶς· ὁ γὰρ νέος ἀκμὴν πολὺς ὑπὸ τῆς τύχης ἑτεροφρονῶν πλάζεται· ὁ δὲ γέρων καθάπερ ἐν λιμένι τῷ γήρᾳ καθώρμικεν τὰ πρότε- ρον δυσελπιστούμενα τῶν ἀγαθῶν ἀσφαλεῖ κατακλείσας χάριτι.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.18",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.18",
    "language": "grc",
    "text": "Ἀφαιρουμένης προσόψεως καὶ ὁμιλίας καὶ συναναστροφῆς ἐκλύεται τὸ ἐρωτικὸν πάθος.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.19",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.19",
    "language": "grc",
    "text": "Τοῦ γεγονότος ἀμνήμων ἀγαθοῦ γέρων τήμερον γεγένηται.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.20",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.20",
    "language": "grc",
    "text": "Τῶν ἐπιθυμιῶν αἱ μέν εἰσι φυσικαὶ καὶ ἀναγκαῖαι, αἳ δὲ φυσικαὶ μὲν οὐκ ἀναγκαῖαι δέ, αἱ δὲ οὔτε φυσικαὶ οὔτε ἀναγκαῖαι ἀλλὰ παρὰ κενὴν δόξαν γινόμεναι.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.21",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.21",
    "language": "grc",
    "text": "Οὐ βιαστέον τὴν φύσιν ἀλλὰ πειστέον· πείσομεν δὲ τὰς ἀναγκαίας ἐπιθυμίας ἐκπληροῦντες, τάς τε φυσικὰς ἂν μὴ βλάπτωσι, τὰς δὲ βλαβερὰς πικρῶς ἐλέγχοντες.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.22",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.22",
    "language": "grc",
    "text": "Ὁ ἄπειρος χρόνος καὶ ὁ πεπερασμένος ἴσην ἔχει τὴν ἡδονήν, ἐάν τις ὀρθῶς αὐτῆς τὰ πέρατα καταμετρήσῃ τῷ λογισμῷ.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.23",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.23",
    "language": "grc",
    "text": "Πᾶσα φιλία δι’ ἑαυτὴν αἱρετή· ἀρχὴν δὲ εἴληφεν ἀπὸ τῆς ὠφελείας.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.24",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.24",
    "language": "grc",
    "text": "Ἐνύπνια οὐκ ἔλαχε φύσιν θείαν οὐδὲ μαντικὴν δύναμιν, ἀλλὰ γίνεται κατὰ ἔμπτωσιν εἰδώλων.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.25",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.25",
    "language": "grc",
    "text": "Ἡ πενία μετρουμένη τῷ τῆς φύσεως τέλει μέγας ἐστὶ πλοῦτος· πλοῦτος δὲ μὴ ὁριζόμενος μεγάλη ἐστὶ πενία.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.26",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.26",
    "language": "grc",
    "text": "Δεῖ διαλαβεῖν ὅτι καὶ ὁ πολὺς λόγος καὶ ὁ βραχὺς εἰς τὸ αὐτὸ συντείνει.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.27",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.27",
    "language": "grc",
    "text": "Ἐπὶ μὲν τῶν ἄλλων ἐπιτηδευμάτων μόλις τελειωθεῖσιν ὁ καρπὸς ἔρχεται, ἐπὶ δὲ φιλοσοφίας συντρέχει τῇ γνώσει τὸ τερπνόν· οὐ γὰρ μετὰ μάθησιν ἀπόλαυσις, ἀλλὰ ἅμα μάθησις καὶ ἀπόλαυσις.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.28",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.28",
    "language": "grc",
    "text": "Οὔτε τοὺς προχείρους εἰς φιλίαν οὔτε τοὺς ὀκνηροὺς δοκιμαστέον· δεῖ δὲ καὶ παρακινδυνεῦσαι χάριν, χάριν φιλίας.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.29",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.29",
    "language": "grc",
    "text": "Παρρησίᾳ γὰρ ἔγωγε χρώμενος φυσιολόγῳ χρησμῳδεῖν τὰ συμφέροντα πᾶσιν ἀνθρώποις μᾶλλον ἂν βουλοίμην, κἂν μηδεὶς μέλλῃ συνήσειν, ἢ συγκατατιθέμενος ταῖς δόξαις καρποῦσθαι τὸν πυκνὸν παραπίπτοντα παρὰ τῶν πολλῶν ἔπαινον.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.30",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.30",
    "language": "grc",
    "text": "Ἑτοιμάζονταί τινες διὰ βίου τὰ πρὸς τὸν βίον, οὐ συνορῶντες ὡς πᾶσιν ἡμῖν θανάσιμον ἐγκέχυται τὸ τῆς γενέσεως φάρμακον.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.31",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.31",
    "language": "grc",
    "text": "Πρὸς μὲν τἆλλα δυνατὸν ἀσφάλειαν πορίσασθαι, χάριν δὲ θανάτου πάντες ἄνθρωποι πόλιν ἀτείχιστον οἰκοῦμεν.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.32",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.32",
    "language": "grc",
    "text": "Ὁ τοῦ σοφοῦ σεβασμὸς ἀγαθὸν μέγα τῷ σεβομένῳ ἐστί.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.33",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.33",
    "language": "grc",
    "text": "Σαρκὸς φωνὴ τὸ μὴ πεινῆν, τὸ μὴ διψῆν, τὸ μὴ ῥιγοῦν· ταῦτα γὰρ ἔχων τις καὶ ἐλπίζων ἕξειν κἂν 〈Διὶ〉 ὑπὲρ εὐδαιμονίας μαχέσαιτο.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.34",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.34",
    "language": "grc",
    "text": "Οὐχ οὕτως χρείαν ἔχομεν τῆς χρείας παρὰ τῶν φίλων ὡς τῆς πίστεως τῆς περὶ τῆς χρείας.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.35",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.35",
    "language": "grc",
    "text": "Οὐ δεῖ λυμαίνεσθαι τὰ παρόντα τῶν ἀπόντων ἐπιθυ μίᾳ, ἀλλ’ ἐπιλογίζεσθαι ὅτι καὶ ταῦτα τῶν εὐκταίων ἦν.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.36",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.36",
    "language": "grc",
    "text": "Ὁ Ἐπικούρου βίος τοῖς τῶν ἄλλων συγκρινόμενος ἕνεκεν ἡμερότητος καὶ αὐταρκείας μῦθος ἂν νομισθείη.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.37",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.37",
    "language": "grc",
    "text": "Ἀσθενὴς ἡ φύσις ἐστὶ πρὸς τὸ κακόν, οὐ πρὸς τὸ ἀγαθόν· ἡδοναῖς μὲν γὰρ σῴζεται, ἀλγηδόσι δὲ διαλύεται.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.38",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.38",
    "language": "grc",
    "text": "Μικρὸς παντάπασιν, ᾧ πολλαὶ αἰτίαι εὔλογοι εἰς ἐξαγωγὴν βίου.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.39",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.39",
    "language": "grc",
    "text": "Οὔθ’ ὁ τὴν χρείαν ἐπιζητῶν διὰ παντὸς φίλος οὔθ’ ὁ μηδέποτε συνάπτων· ὃ μὲν γὰρ καπηλεύει τῇ χάριτι τὴν ἀμοιβήν, ὃ δὲ ἀποκόπτει τὴν περὶ τοῦ μέλλοντος εὐελπιστίαν.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.40",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.40",
    "language": "grc",
    "text": "Ὁ λέγων πάντα κατ’ ἀνάγκην γίνεσθαι οὐδὲν ἐγκαλεῖν ἔχει τῷ λέγοντι μὴ πάντα κατ’ ἀνάγκην γίνεσθαι· αὐτὸ γὰρ τοῦτό φησι κατ’ ἀνάγκην γίνεσθαι.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.41",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.41",
    "language": "grc",
    "text": "Γελᾶν ἅμα δεῖ καὶ φιλοσοφεῖν καὶ οἰκονομεῖν καὶ τοῖς λοιποῖς οἰκειώμασι χρῆσθαι καὶ μηδαμῇ λήγειν τὰς ἐκ τῆς ὀρθῆς φιλοσοφίας φωνὰς ἀφιέντας.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.42",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.42",
    "language": "grc",
    "text": "Ὁ αὐτὸς χρόνος καὶ γενέσεως τοῦ μεγίστου ἀγαθοῦ καὶ ἀπολαύσεως.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.43",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.43",
    "language": "grc",
    "text": "Φιλαργυρεῖν ἄδικα μὲν ἀσεβές, δίκαια δὲ αἰσχρόν· ἀπρεπὲς γὰρ ῥυπαρῶς φείδεσθαι καὶ μετὰ τοῦ δικαίου.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.44",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.44",
    "language": "grc",
    "text": "Ὁ σοφὸς εἰς τὰ ἀναγκαῖα συγκλεισθεὶς μᾶλλον ἐπίστα ται μεταδιδόναι ἢ μεταλαμβάνειν· τηλικοῦτον αὐταρκείας εὗρε θησαυρόν.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.45",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.45",
    "language": "grc",
    "text": "Οὐ κόμπου οὐδὲ φωνῆς ἐργαστικοὺς οὐδὲ τὴν περι μάχητον παρὰ τοῖς πολλοῖς παιδείαν ἐνδεικνυμένους φυσιο- λογία παρασκευάζει, ἀλλ’ ἀσοβάρους καὶ αὐτάρκεις καὶ ἐπὶ τοῖς ἰδίοις ἀγαθοῖς, οὐκ ἐπὶ τοῖς τῶν πραγμάτων μέγα φρονοῦντας.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.46",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.46",
    "language": "grc",
    "text": "Τὰς φαύλας συνηθείας ὥσπερ ἄνδρας πονηροὺς πολὺν χρόνον μέγα βλάψαντας τελείως ἐκδιώκομεν.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.47",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.47",
    "language": "grc",
    "text": "Προκατείλημμαί σε, ὦ Τύχη, καὶ πᾶσαν 〈τὴν〉 σὴν παρείσδυσιν ἐνέφραξα. καὶ οὔτε σοὶ οὔτε ἄλλῃ οὐδεμιᾷ περιστάσει δώσομεν ἑαυτοὺς ἐκδότους· ἀλλ’ ὅταν ἡμᾶς τὸ χρεὼν ἐξάγῃ, μέγα προσπτύσαντες τῷ ζῆν καὶ τοῖς αὐτῷ κενῶς περι πλαττομένοις ἄπιμεν ἐκ τοῦ ζῆν μετὰ καλοῦ παιῶνος ἐπιφωνοῦντες ὡς εὖ ἡμῖν βεβίωται.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.48",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.48",
    "language": "grc",
    "text": "Πειρᾶσθαι τὴν ὑστέραν τῆς προτέρας κρείττω ποιεῖν, ἕως ἂν ἐν ὁδῷ ὦμεν· ἐπειδὰν δὲ ἐπὶ πέρας ἔλθωμεν, ὁμαλῶς εὐφραίνεσθαι.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.49",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.49",
    "language": "grc",
    "text": "Οὐκ ἦν τὸ φοβούμενον λύειν ὑπὲρ τῶν κυριωτάτων μὴ εἰδότας τίς ἡ τοῦ σύμπαντος φύσις, ἀλλ’ ὑποπτεύοντάς τι τῶν κατὰ τοὺς μύθους. ὥστε οὐκ ἦν ἄνευ φυσιολογίας ἀκεραίους τὰς ἡδονὰς ἀπολαμβάνειν.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.50",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.50",
    "language": "grc",
    "text": "Οὐδεμία ἡδονὴ καθ’ ἑαυτὴν κακόν· ἀλλὰ τὰ ποιητικὰ ἐνίων πολλαπλασίους ὀχλήσεις ἐπιφέρει τῶν ἡδονῶν.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.51",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.51",
    "language": "grc",
    "text": "Πυνθάνομαί σου τὴν κατὰ σάρκα κίνησιν ἀφθονώτερον διακεῖσθαι πρὸς τὴν ἀφροδισίων ἔντευξιν. σὺ δὲ ὅταν μήτε τοὺς νόμους καταλύῃς μήτε τὰ καλῶς ἔθει κείμενα κινῇς μήτε τῶν πλησίον τινὰ λυπῇς μήτε τὴν σάρκα καταξαίνῃς μήτε τὰ ἀναγκαῖα καταναλίσκῃς, χρῶ ὡς βούλει τῇ σεαυτοῦ προαιρέσει. ἀμήχανον μέντοι γε τὸ μὴ οὐχ ἑνί γέ τινι τούτων συνέχεσθαι· ἀφροδίσια γὰρ οὐδέποτε ὤνησεν, ἀγαπητὸν δὲ εἰ μὴ ἔβλαψεν.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.52",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.52",
    "language": "grc",
    "text": "Ἡ φιλία περιχορεύει τὴν οἰκουμένην κηρύττουσα δὴ πᾶσιν ἡμῖν ἐγείρεσθαι ἐπὶ τὸν μακαρισμόν.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.53",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.53",
    "language": "grc",
    "text": "Οὐδενὶ φθονητέον· ἀγαθοὶ γὰρ οὐκ ἄξιοι φθόνου, πονηροὶ δὲ ὅσῳ ἂν μᾶλλον εὐτυχῶσι. τοσούτῳ μᾶλλον αὑτοῖς λυμαίνονται.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.54",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.54",
    "language": "grc",
    "text": "Οὐ προσποιεῖσθαι δεῖ φιλοσοφεῖν, ἀλλ’ ὄντως φιλοσοφεῖν· οὐ γὰρ προσδεόμεθα τοῦ δοκεῖν ὑγιαίνειν. ἀλλὰ τοῦ κατ’ ἀλήθειαν ὑγιαίνειν.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.55",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.55",
    "language": "grc",
    "text": "Θεραπευτέον τὰς συμφορὰς τῇ τῶν ἀπολλυμένων χάριτι καὶ τῷ γινώσκειν ὅτι οὐκ ἔστιν ἄπρακτον ποιῆσαι τὸ γεγονός.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.56",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.56",
    "language": "grc",
    "text": "Ἀλγεῖ μὲν ὁ σοφὸς οὐ μᾶλλον στρεβλούμενος 〈ἢ στρεβλουμένου〉 τοῦ φίλου.",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.57",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.57",
    "language": "grc",
    "text": "Ὁ βίος αὐτοῦ πᾶς δι’ ἀπιστίαν συγχυθήσεται καὶ ἀνακεχαιτισμένος ἔσται.",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.58",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.58",
    "language": "grc",
    "text": "Ἐκλυτέον ἑαυτοὺς ἐκ τοῦ περὶ τὰ ἐγκύκλια καὶ πολιτικὰ δεσμωτηρίου.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.59",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.59",
    "language": "grc",
    "text": "Ἄπληστον οὐ γαστήρ. ὥσπερ οἱ πολλοί φασιν, ἀλλὰ δόξα ψευδὴς ὑπὲρ τοῦ 〈τῆς〉 γαστρὸς ἀορίστου πληρώματος.",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.60",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.60",
    "language": "grc",
    "text": "Πᾶς ὥσπερ ἄρτι γεγονὼς ἐκ τοῦ ζῆν ἀπέρχεται.",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.61",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.61",
    "language": "grc",
    "text": "Καλλίστη καὶ ἡ τῶν πλησίον ὄψις, τῆς πρώτης συγγενείας ὁμονοούσης ἢ [εἰ] πολλὴν εἰς τοῦτο ποιουμένης σπουδήν.",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.62",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.62",
    "language": "grc",
    "text": "Εἰ γὰρ κατὰ τὸ δέον ὀργαὶ γίνονται τοῖς γεννήσασι πρὸς τὰ ἔκγονα, μάταιον δήπουθέν ἐστι τὸ ἀντιτείνειν καὶ μὴ παραιτεῖσθει συγγνώμης τυχεῖν· εἰ δὲ μὴ κατὰ τὸ δέόν ἀλλὰ ἀλογώτερον, γελοῖον πάν〈τως〉 τὸ προσεκκαίειν τὴν ἀλογίαν θυμοκατοχοῦντα, καὶ μὴ ζητεῖν μεταθεῖναι κατ’ ἄλλους τρόπους εὐγνωμονοῦντα.",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.63",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.63",
    "language": "grc",
    "text": "Ἔστι καὶ ἐν λεπτότητι καθαριότης, ἧς ὁ ἀνεπιλόγιστος παραπλήσιόν τι πάσχει τῷ δι’ ἀοριστίαν ἐκπίπτοντι.",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.64",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.64",
    "language": "grc",
    "text": "Ἀκολουθεῖν δεῖ τὸν παρὰ τῶν ἄλλων ἔπαινον αὐτόματον, ἡμᾶς δὲ γενέσθαι περὶ τὴν ἡμῶν ἰατρείαν.",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.65",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.65",
    "language": "grc",
    "text": "Μάταιόν ἐστι παρὰ θεῶν αἰτεῖσθαι ἅ τις ἑαυτῷ χορηγῆσαι ἱκανός ἐστι.",
    "chunk_index": 64,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.66",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.66",
    "language": "grc",
    "text": "Συμπαθῶμεν τοῖς φίλοις οὐ θρηνοῦντες ἀλλὰ φροντίζοντες.",
    "chunk_index": 65,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.67",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.67",
    "language": "grc",
    "text": "Ἐλεύθερος βίος οὐ δύναται κτήσασθαι χρήματα πολλὰ διὰ τὸ τὸ πρᾶγμα 〈μὴ〉 ῥᾴδιον εἶναι χωρὶς θητείας ὄχλων ἢ δυναστῶν, ἀλλὰ συνεχεῖ δαψιλείᾳ πάντα κέκτηται· ἂν δέ που καὶ τύχῃ χρημάτων πολλῶν, καὶ ταῦτα ῥᾳδίως ἂν εἰς τὴν τοῦ πλησίον εὔνοιαν διαμετρήσαι.",
    "chunk_index": 66,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.68",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.68",
    "language": "grc",
    "text": "Οὐδὲν ἱκανὸν ᾧ ὀλίγον τὸ ἱκανόν.",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.69",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.69",
    "language": "grc",
    "text": "Τὸ τῆς ψυχῆς ἀχάριστον λίχνον ἐποίησε τὸ ζῷον εἰς ἄπειρον τῶν ἐν διαίτῃ ποικιλμάτων.",
    "chunk_index": 68,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.70",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.70",
    "language": "grc",
    "text": "Μηδέν σοι ἐν βίῳ πραχθείη ὃ φόβον παρέξει σοι, εἰ γνωσθήσεται τῷ πλησίον.",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.71",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.71",
    "language": "grc",
    "text": "Πρὸς πάσας τὰς ἐπιθυμίας προσακτέον τὸ ἐπερώτημα τοῦτο· τί μοι γενήσεται ἂν τελεσθῇ τὸ κατὰ τὴν ἐπιθυμίαν ἐπιζητούμενον, καὶ τί ἐὰν μὴ τελεσθῇ;",
    "chunk_index": 70,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.72",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.72",
    "language": "grc",
    "text": "Οὐδὲν ὄφελος ἦν τὴν κατ’ ἀνθρώπους ἀσφάλειαν παρασκευάζεσθαι τῶν ἄνωθεν ὑπό〈πτων ὄ〉ντων καὶ τῶν ὑποκάτω καὶ ἁπλῶς τῶν ἐν τῷ ἀπείρῳ.",
    "chunk_index": 71,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.73",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.73",
    "language": "grc",
    "text": "Καὶ τὸ γενέσθαι τινὰς ἀλγηδόνας περὶ σῶμα λυσιτελεῖ πρὸς φυλακὴν τῶν ὁμοειδῶν.",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.74",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.74",
    "language": "grc",
    "text": "Ἐν φιλολόγῳ συζητήσει πλεῖον ἤνυσεν ὁ ἡττηθείς. καθ’ ὃ προσέμαθεν.",
    "chunk_index": 73,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.75",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.75",
    "language": "grc",
    "text": "Εἰς τὰ παρῳχηκότα ἀγαθὰ ἀχάριστος φωνὴ ἡ λέγουσα Τέλος ὅρα μακροῦ βίου.",
    "chunk_index": 74,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.76",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.76",
    "language": "grc",
    "text": "Τοιοῦτος εἶ γηράσκων ὁποῖον ἐγὼ παραινῶ, καὶ διέγνωκας ὁποῖόν ἐστι τὸ ἑαυτῷ φιλοσοφῆσαι καὶ οἷον τὸ τῇ Ἑλλάδι· συγχαίρω σοι.",
    "chunk_index": 75,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.77",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.77",
    "language": "grc",
    "text": "Τῆς αὐταρκείας καρπὸς μέγιστος ἐλευθερία.",
    "chunk_index": 76,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.78",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.78",
    "language": "grc",
    "text": "Ὁ γενναῖος περὶ σοφίαν καὶ φιλίαν μάλιστα γίγνεται ὧν τὸ μέν ἐστι θνητὸν ἀγαθόν, τὸ δὲ ἀθάνατον.",
    "chunk_index": 77,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.79",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.79",
    "language": "grc",
    "text": "Ὁ ἀτάραχος ἑαυτῷ καὶ ἑτέρῳ ἀόχλητος.",
    "chunk_index": 78,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.80",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.80",
    "language": "grc",
    "text": "Γενναίῳ σωτηρίας μοῖρα τῆς ἡλικίας τήρησις καὶ φυλακὴ τῶν πάντα μολυνόντων κατὰ τὰς ἐπιθυμίας τὰς οἰστρώδεις.",
    "chunk_index": 79,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0537/tlg014/1st1K-grc1#tlg0537.tlg014.81",
    "work_id": "first1k/tlg0537/tlg014/1st1K-grc1",
    "canonical_ref": "tlg0537.tlg014.81",
    "language": "grc",
    "text": "Οὐ λύει τὴν τῆς ψυχῆς ταραχὴν οὐδὲ τὴν ἀξιόλογον ἀπογεννᾷ χαρὰν οὔτε πλοῦτος ὑπάρχων ὁ μέγιστος οὔθ’ ἡ παρὰ τοῖς πολλοῖς τιμὴ καὶ περίβλεψις οὔτ’ ἄλλο τι τῶν παρὰ τὰς †ἀζυρισί(έ?)τους αἰτίας.",
    "chunk_index": 80,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  }
]