    "canonical_ref": "tlg1802.tlg001.3",
    "language": "grc",
    "text": "III. Plat. Gorg. 516 C οὐκοῦν οἵ γε δίκαιοι ἥμεροι, ὡς ἔφη Ὅμηρος.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
