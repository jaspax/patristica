  },
  {
    "chunk_id": "first1k/tlg2178/tlg002/1st1K-grc1#tlg2178.tlg002.14",
    "work_id": "first1k/tlg2178/tlg002/1st1K-grc1",
    "canonical_ref": "tlg2178.tlg002.14",
    "language": "grc",
    "text": "14. Ὅτι ἄριστοι λόγοι καὶ μιμήσεως ἄξιοι οἱ μὴ ἔχοντες ἐνὸς χαρακτῆρα, ἀλλὰ διαφόρων.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
