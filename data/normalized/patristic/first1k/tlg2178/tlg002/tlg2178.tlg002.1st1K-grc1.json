  },
  {
    "chunk_id": "first1k/tlg2178/tlg002/1st1K-grc1#tlg2178.tlg002.18",
    "work_id": "first1k/tlg2178/tlg002/1st1K-grc1",
    "canonical_ref": "tlg2178.tlg002.18",
    "language": "grc",
    "text": "18. Ὅτι τέχνης ἐστὶ μᾶλλον τὸ ποῖα δεῖ προτάττειν, καὶ ποῖα ἐπιζευγνύειν.",
    "chunk_index": 17,
    "context_before": null,
