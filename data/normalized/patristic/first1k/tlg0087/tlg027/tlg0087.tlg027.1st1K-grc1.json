  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.2",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.2",
    "language": "grc",
    "text": "ὡϲ ἀπὸ τοῦ ἀλγήϲω μέλλοντοϲ ἀλγηδών ἀλγηδόνοϲ, οὕτω καὶ ἀπὸ τοῦ χαίρω χαιρήϲω χαιρηδών.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.3",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.3",
    "language": "grc",
    "text": "τὰ εἰϲ ηῦων διϲύλλαβα ἐκ τρίτηϲ καὶ δευτέραϲ ϲυζυγίαϲ τῶν περιϲπωμένων παρηγμένα —μνήμων, κτήμων, ϲτήμων, γνώμων.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.4",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.4",
    "language": "grc",
    "text": "οἰκτίρμων, ἐλεήμων παρὰ ῥῆμα.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.5",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.5",
    "language": "grc",
    "text": "τὰ εἰϲ ηϲ ἰαμβικὰ ἔχοντα ῥῆμα ὁριϲτικὸν χρόνου ἐνεϲτῶτοϲ παρακείμενον αὐτοῖϲ καὶ φυλάττοντα τὸ ϲύμφωνον ἀπὸ τοῦ ἐνεϲτῶτοϲ διὰ τοῦ τοϲ κλίνεται οἷόν ἐϲτι Λάχηϲ, παράκειται γὰρ αὐτῷ τὸ λάχω, λείβω λέβηϲ, δαίρω Δάρηϲ, χαίρω Χάρηϲ, πλανῶ πλάνηϲ, πενῶ πένηϲ, τρέμω Τρόμηϲ, κρατῶ Κράτηϲ. τὸ δὲ δότηϲ δότου, πλύτηϲ πλύτου, θύτηϲ θύτου οὐκ ἔχει ἀπὸ ἐνεϲτῶτοϲ τὸ τ, διὸ οὐ κλίνεται διὰ τοῦ τοϲ. ὁ γὰρ ἐνεϲτὼϲ διδῶ καὶ πλύνω καὶ θύω ἐϲτίν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.6",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.6",
    "language": "grc",
    "text": "τὰεἰϲ τηϲ λήγοντα ἀρϲενικὰ φύϲει διϲύλλαβα βαρύνεται οἷον δότηϲ, πλύτηϲ, θύτηϲ, πράτηϲ· διὰ τοῦτο τὸ ψάλτηϲ ἀναλογώτερόν ἐϲτι κατὰ τὴν κοινὴν διάλεκτον βαρυνόμενον τοῦ παρὰ τοῖϲ Ἀττικοῖϲ ὀξυνομένου. τὸ δὲ λῃϲτήϲ ἀπὸ τριϲυλλάβου ληιϲτήϲ ἐγένετο.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.7",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.7",
    "language": "grc",
    "text": "τὰ εἰϲ τηϲ λήγοντα ἀρϲενικὰ καθαρὸν ἔχοντα τὸ τ βραχείᾳ παραληγόμενα ὑπὲρ δύο ϲυλλαβὰϲ βαρύνεται καὶ ἁπλᾶ ὄντα, ἀρότηϲ, ἐργάτηϲ. ϲεϲημείωται τὸ εὑρετήϲ. τὸ μέντοι λυριϲτήϲ, λεπιϲτήϲ, χλευαϲτήϲ ὀξύνεται, ὅτι οὐ καθαρὸν τὸ τ τὸ ἀθλητήϲ, μαχητήϲ, μαθητήϲ, ὅτι οὐ βραχεῖαν ἔχει τὴν παραλήγουϲαν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.8",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.8",
    "language": "grc",
    "text": "τὰ εἰϲ ατηϲ τὸ α μακρὸν ἔχοντα ῥηματικὰ θεατήϲ, πειρατήϲ ὀξύνεται.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.9",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.9",
    "language": "grc",
    "text": "τὰ εἰϲ υτηϲ τὸ υ μακρὸν ἔχοντα ῥηματικὰ ὀξύνεται κωλυτήϲ, μηνυτήϲ.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.10",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.10",
    "language": "grc",
    "text": "τὰ εἰϲ ηϲ ἐπίθετα παρὰ ῥῆμα ϲύνθετα εἰϲ ουϲ ποιοῦντα τὴν γενικὴν ὀξύνεται εὐϲεβήϲ, εὐλαβήϲ, θεοφιλήϲ, αὐτοϲφαγήϲ, πολυδευκήϲ, Πολυδεύκηϲ δὲ τὸ κύριον βαρύνεται. βαρύνεται δὲ τὰ παρὰ τὸ ὄλω πανώληϲ, ἐξώληϲ, προώληϲ καὶ τὰ παρὰ τὸ ἀρκῶ αὐτάρκηϲ καὶ τὰ παρὰ τὸ ἀντῶ προϲάντηϲ καὶ τὰ παρὰ τὸ ἅδω αὐθάδηϲ. τὰ μέντοι παρὰ ῥῆμα ϲύνθετα εἰϲ ου ἔχοντα τὴν γενικὴν βαρύνεται οἰον πωλῶ παντοπώληϲ, μετρῶ γεωμέτρηϲ, παιδοτρίβηϲ, χρεωφείληϲ, ναυβάτηϲ, ἐργομίϲηϲ, προγύπτηϲ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.11",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.11",
    "language": "grc",
    "text": "τὰ εἰϲ ιϲ ἐϲχηματιϲμένα ἁπὸ βαρυτόνων μελλόντων ἢ δευτέρου προϲώπου τοῦ παθητικοῦ παρακειμένου βαρύνεται καὶ ϲυϲτέλλει τὸ ῑ, ποιήϲω ποίηϲιϲ, γνώϲω γνῶϲιϲ, πράξω πράξιϲ, πέφανϲαι φάνϲιϲ, μεμίανϲαι μίανϲιϲ. τὸ δὲ ἁψίϲ ϲεϲημείωται μακρὸν ἔχον τὸ ῑ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.12",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.12",
    "language": "grc",
    "text": "τὸ τροφαλίϲ εἴρηται παρὰ τὸ τρέφεϲθαι ὅ ἐϲτι πήγνυϲθαι, ἐξ οὗ καὶ τὸ τρόφι κῦμα εἴρηται.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.13",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.13",
    "language": "grc",
    "text": "τὰ εἰϲ ξιϲ καὶ ψιϲ ἀπὸ μελλόντων ἐϲχηματιϲμένα βαρύνεται, ἕξω ἕξιϲ, λέξω λέξιϲ, ψύξω ψύξιϲ. ϲεϲημείωται ἁψίϲ ὀξυνόμενον.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.14",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.14",
    "language": "grc",
    "text": "τὰ εἰϲ ριϲ θηλυκὰ ῥπματικὰ διϲύλλαβα βαρύτονα ἑνὶ φωνήεντι θέλει παραλήγεϲθαι οἰον χαίρω χάριϲ, εἴρω Ἶριϲ, δαίω δῆριϲ, τὸ δὲ κουρίϲ τὸ ἐργαλεῖον τοῦ κουρέωϲ ὀξύνεται. τὸ δὲ Χαῖριϲ Χαίριδοϲ ὄνομα κύριον ἀρϲενικόν ἐϲτι.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.15",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.15",
    "language": "grc",
    "text": "τὰ εἰϲ ϲιϲ ἀπὸ μέλλοντοϲ γινόμενα ἢ ἀπὸ δευτέρου προϲώπου τοῦ παθητικοῦ παρακειμένου βαρύνεται ποιήϲω ποίηϲιϲ, λύϲω λύϲιϲ, κέκριϲαι κρίϲιϲ.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.16",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.16",
    "language": "grc",
    "text": "παρὰ τὸ ἀλῶ τὸ πλανῶμαι ἀλαόϲ ὁ περιπλανώμενοϲ.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.17",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.17",
    "language": "grc",
    "text": "τὰ εἰϲ οϲ λήγοντα ὀνόματα παρὰ ῥῆμα γινόμενα· καθαρεύοντα καὶ τῷ ε παραληγόμενα ὀξύνεϲθαι θέλει, φωλεύω φωλεόϲ, ὀχεύω ὀχεόϲ καὶ πλεοναϲμῷ τοῦ ϲ ὀϲχεόϲ. καὶ παρὰ τὸ ϲωρεύω δὲ ὁ ϲωρεόϲ, τὸ δὲ ϲωρόϲ κατὰ ϲυγκοπὴν ἀπετελεῖτο. καὶ παρὰ τὸ λοχεύω δὲ ὁ λοχεόϲ ἔϲται κατ’ ὀξεῖαν τάϲιν. ἀλλ’ οὖν γε βαρυτόνωϲ οἱ πλείουϲ ἀνέγνωϲαν πλεοναϲμὸν ἐκδεξάμενοι τοῦ ε ὥϲτε παρὰ τὴν λόχου γενικὴν λόχοιο γενέϲθαι καὶ λοχέοιο. παρὰ κηδεύω δὲ κηδεόϲ. κελεύω Κελεόϲ ὄνομα κύριον, ὠρεύω Ὠρεόϲ.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.18",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.18",
    "language": "grc",
    "text": "τὰ διὰ τοῦ αλεοϲ ἀπὸ τριῶν παράγεται μερῶν, ἀπὸ ὀνόματοϲ δεῖμα δειμαλcοϲ, ἀπὸ ῥήματοϲ οἰδῶ οἰδαλέοϲ, ἀπὸ ἐπιρρήματοϲ ῥίμφα ῥιμφαλέοϲ.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.19",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.19",
    "language": "grc",
    "text": "ὥϲπερ ἀπὸ τοῦ ἁρμόζω γίνεται ἁρμόδιοϲ τὸν αὐτὸν τρόπον ἀπὸ τοῦ ῥοίζω γίνεται ῥοίδιοϲ καὶ πλεοναϲμῷ τοῦ ε κοὶ ἐκτάϲει τοῦ ο εἰϲ ω ἐρῳδιόϲ καὶ μένει τὸ ῑ προϲγεραμμένον.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.20",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.20",
    "language": "grc",
    "text": "τὰ ἀπὸ ἐνεϲτώτων γενόμενα εἰϲ ιοϲ προπαροξύνεται αἰτῶ αἴτιοϲ, ἁρμόζω ἁρμόδιοϲ, ἀρκῶ ἄρκιοϲ, ἀρτῶ ἄρτιοϲ. τὸ δὲ ἀντῶ ἀντίοϲ ϲεϲημείωται παροξυνόμενον.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.21",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.21",
    "language": "grc",
    "text": "τὰ εἰϲ ιοϲ ἀπὸ μέλλοντοϲ γινόμενα προπαροξύνεται, ὀρθώϲομαι Ὀρθώϲιοϲ, ἀϲπάϲομαι ἀϲπάϲιοϲ, φυλάξομαι φυλάξιοϲ, ἀλέξω ἀλέξιοϲ, κτήϲω κτήϲιοϲ, αἰνήϲω Αἰνήϲιοϲ, ἀρκέϲω ἀρκέϲιοϲ καὶ πλεοναϲμῷ τοῦ ῑ Ἀρκείϲιοϲ, ἄρϲω ἄρϲιοϲ καὶ ἀνάρϲιοϲ, ἄξω ἄξιοϲ, θαυμάϲω θαυμάϲιοϲ. τὸ μέντοι πλήϲω πληϲίοϲ καὶ τὸ δέξομαι δεξιόϲ καὶ ἕψομαι ἀνεψιόϲ.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.22",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.22",
    "language": "grc",
    "text": "τὸ ἐπιπόλαιοϲ οὐκ ἀπὸ τοῦ ἐπιπολῆϲ παρῆκται, ἀλλὰ παρὰ τὸ ἐπιπολάζω. οἱ πλείουϲ αὐτὸ περιϲπῶϲιν.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.23",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.23",
    "language": "grc",
    "text": "τὸ Πείραιοϲ προπαροξυνόμενον παρὰ ῥῆμα τὸ πειρῶ ὡϲ παρὰ τὸ φιλῶ Φίλαιοϲ καὶ παρὰ τὸ βέβηκα βέβαιοϲ.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0087/tlg027/1st1K-grc1#tlg0087.tlg027.24",
    "work_id": "first1k/tlg0087/tlg027/1st1K-grc1",
    "canonical_ref": "tlg0087.tlg027.24",
    "language": "grc",
    "text": "τὸ Τίμαιοϲ προπαροξυνόμενον ἔχει ἀφορμήν, ὅτι ῥῆμα αὐτοῦ προκατάρχει.",
    "chunk_index": 23,
    "context_before": null,
