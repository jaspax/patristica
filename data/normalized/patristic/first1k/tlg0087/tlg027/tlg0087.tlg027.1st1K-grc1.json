    "canonical_ref": "tlg0087.tlg027.1",
    "language": "grc",
    "text": "τὸ αἴτιον τοῦ μονοϲυλλαβῆϲαι τὸ ζεύϲ ἐν τῷ περὶ ῥηματικῶν ὀνομάτων λέγομεν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
