    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.19",
    "language": "grc",
    "text": "και ευθυς εκαλεσεν αυτους και αφεντες τον πρα αυτων ζεβεδε ον εν τω πλοιω μετα των μισθω των απηλθον ο πισω αυτου",
    "chunk_index": 19,
    "context_before": null,
