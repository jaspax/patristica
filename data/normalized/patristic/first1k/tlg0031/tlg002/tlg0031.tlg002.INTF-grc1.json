    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.7",
    "language": "grc",
    "text": "εγω εβαπτισα υμας υδατι αυτος δε βα πτισει υμας εν πνι αγι ω",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
