    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.5",
    "language": "grc",
    "text": "και ην ο ιωαννης ενδεδυμενος τρι χας καμηλου και ζω νην δερματινην περι την οσφυν αυτου και εσθων εσθιων ακριδας και μελι αγριον",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0031/tlg002/INTF-grc1#tlg0031.tlg002.1.6",
    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.6",
    "language": "grc",
    "text": "και εκηρυσσεν λε γων ερχεται ο ισχυ ροτερος μου οπισω μου ου ουκ ειμι ι κανος ειμη κανος κυψας λυσαι τον ιμαντα των υποδηματων αυ του",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
