    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.16",
    "language": "grc",
    "text": "και ειπεν αυτοις ο ις δευτε οπισω μου και ποι ησω υμας γενεσ θε αλεεις ανων",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
