    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.8",
    "language": "grc",
    "text": "και εγενετο εν εκει ναις ταις ημεραις ηλθεν ις απο ναζα ρετ της γαλιλαιας και εβαπτισθη εις τον ιορδανην υπο ιωαννου",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
