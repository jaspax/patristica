    "canonical_ref": "tlg0031.tlg002.1.22",
    "language": "grc",
    "text": "και ευθυς ην εν τη συναγω γη αυτων ανος εν πνι ακαθαρτω και ανεκραξεν",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
