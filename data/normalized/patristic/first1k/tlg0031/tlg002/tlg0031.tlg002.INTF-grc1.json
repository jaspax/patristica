    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.2",
    "language": "grc",
    "text": "φωνη βοωντος εν τη ερημω ετοιμα σατε την οδον κυ ευθιας ποιειτε τας τριβους αυτου",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0031/tlg002/INTF-grc1#tlg0031.tlg002.1.3",
    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.3",
    "language": "grc",
    "text": "και ε γενετο ιωαννης ο βαπτιζων εν τη ερημω και κηρυσ σων βαπτισμα με τανοιας εις αφεσιν αμαρτιων",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
