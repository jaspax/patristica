    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.1",
    "language": "grc",
    "text": "καθως γε γραπται εν τω ησα ια τω προφητη ιδου εγω αποστε λω τον αγγελον μου προ προσωπου σου ος κατασκευασει την οδον σου",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
