    "canonical_ref": "tlg0031.tlg002.1.30",
    "language": "grc",
    "text": "και προσ ελθων ηγειρεν αυτην κρατησας της χιρος και αφη κεν αυτην ο πυ ρετος και διηκο νει αυτοις",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
