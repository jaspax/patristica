    "canonical_ref": "tlg0031.tlg002.1.27",
    "language": "grc",
    "text": "και εξηλθεν η ακο η αυτου ευθυς πανταχη εις ολην την περιχωρον της ι ουδαιας · γα λιλαιας ·",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
