    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.4",
    "language": "grc",
    "text": "και εξεπορευετο προς αυτον πασα η ιουδαια χωρα και οι ιεροσολυμειτε ιεροσολυμειται παντες και εβαπτιζον το υπ αυτου εν τω ιορδανη ποταμω εξομολογουμενοι τας αμαρτιας αυτων",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
