    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.14",
    "language": "grc",
    "text": "λεγων οτι πεπληρωται ο και ρος και ηγγεικεν η βασιλια του θυ μετανοειτε και πιστευεται εν τω ευαγγελιω",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
