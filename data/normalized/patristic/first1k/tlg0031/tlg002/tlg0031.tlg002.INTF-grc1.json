    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.28",
    "language": "grc",
    "text": "και ευθυς ευθυς πανταχη και και ευθυς εκ της συναγωγης εξελθοντες ηλθον εις την οικιαν σι μωνος και ανδρε ου μετα ιακωβου και ιωαννου",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
