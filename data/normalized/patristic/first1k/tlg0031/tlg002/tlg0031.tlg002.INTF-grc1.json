    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0031/tlg002/INTF-grc1#tlg0031.tlg002.1.9",
    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.9",
    "language": "grc",
    "text": "και ευθυς αναβενων εκ του υδατος ειδεν σχι ζομενους τους ουνους και το πνα ως περιστεραν κα ταβαινον και με νον επ αυτον",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0031/tlg002/INTF-grc1#tlg0031.tlg002.1.10",
    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.10",
    "language": "grc",
    "text": "και φωνη εγενετο εκ των ουνων συ ει ο υς μου ο αγαπητος εν σοι ευδοκησα ·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0031/tlg002/INTF-grc1#tlg0031.tlg002.1.11",
    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.11",
    "language": "grc",
    "text": "και ευθυς το πνα αυ τον εκβαλλει εις την ερημον",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0031/tlg002/INTF-grc1#tlg0031.tlg002.1.12",
    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.12",
    "language": "grc",
    "text": "και ην εν τη ερημω μ ημερας πιραζο μενος υπο του σα τανα και ην μετα των θηριων και οι αγγελοι διηκονουν αυτω",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
