    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.25",
    "language": "grc",
    "text": "και σπαραξαν αυτον το πνα το ακαθαρτον και φωνησαν φω νη μεγαλη εξηλ θεν εξ αυτου",
    "chunk_index": 25,
    "context_before": null,
