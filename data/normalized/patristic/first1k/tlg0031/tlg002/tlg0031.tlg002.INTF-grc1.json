    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.13",
    "language": "grc",
    "text": "μετα δε το παραδο θηναι τον ιωαν νην ηλθεν ο ις εις την γαλιλαιαν κη ρυσσων το ευαγ γελιον του θυ",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
