    "canonical_ref": "tlg0031.tlg002.1.29",
    "language": "grc",
    "text": "η δε πενθερα σιμωνος κατεκειτο πυρεσ σουσα και ευθυς λε γουσιν αυτω πε ρι αυτης",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
