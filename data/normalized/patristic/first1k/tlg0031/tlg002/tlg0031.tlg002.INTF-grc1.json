    "canonical_ref": "tlg0031.tlg002.1.24",
    "language": "grc",
    "text": "και ε πετιμησεν αυτω ο ις λεγων φιμωθητι και εξελθε εξ αυτου",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
