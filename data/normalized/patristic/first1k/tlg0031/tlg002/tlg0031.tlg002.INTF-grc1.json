    "work_id": "first1k/tlg0031/tlg002/INTF-grc1",
    "canonical_ref": "tlg0031.tlg002.1.20",
    "language": "grc",
    "text": "και εισπορευον ται εις καφαρναουμ και ευθυς τοις σαβ βασιν εδιδαξεν εδιδασκεν εις την συναγω γην",
    "chunk_index": 20,
