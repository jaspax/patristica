    "canonical_ref": "tlg0541.tlg042.4",
    "language": "grc",
    "text": "δεινὸν πένεσθαι, χεῖρον δ᾿ εὐπορεῖν κακῶς.",
    "chunk_index": 3,
    "context_before": null,
