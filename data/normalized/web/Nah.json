    "work_id": "web/nah",
    "canonical_ref": "Nah.1.1",
    "language": "eng",
    "text": "A revelation about Nineveh. The book of the vision of Nahum the Elkoshite.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
