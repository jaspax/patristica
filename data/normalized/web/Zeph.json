  },
  {
    "chunk_id": "web/zeph#Zeph.3.16",
    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.16",
    "language": "eng",
    "text": "In that day, it will be said to Jerusalem, “Don’t be afraid, Zion. Don’t let your hands be weak.”",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
