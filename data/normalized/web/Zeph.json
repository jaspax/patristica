    "translation_group_id": null
  },
  {
    "chunk_id": "web/zeph#Zeph.3.11",
    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.11",
    "language": "eng",
    "text": "In that day you will not be disappointed for all your doings in which you have transgressed against me; for then I will take away out from among you your proudly exulting ones, and you will no more be arrogant in my holy mountain.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
