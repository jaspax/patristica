    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.10",
    "language": "eng",
    "text": "From beyond the rivers of Cush, my worshipers, even the daughter of my dispersed people, will bring my offering.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
