    "work_id": "web/zeph",
    "canonical_ref": "Zeph.1.3",
    "language": "eng",
    "text": "I will sweep away man and animal. I will sweep away the birds of the sky, the fish of the sea, and the heaps of rubble with the wicked. I will cut off man from the surface of the earth, says the LORD.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
