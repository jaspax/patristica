    "translation_group_id": null
  },
  {
    "chunk_id": "web/zeph#Zeph.3.15",
    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.15",
    "language": "eng",
    "text": "The LORD has taken away your judgments. He has thrown out your enemy. The King of Israel, the LORD, is among you. You will not be afraid of evil any more.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
