    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.12",
    "language": "eng",
    "text": "But I will leave among you an afflicted and poor people, and they will take refuge in the LORD’s name.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
