  },
  {
    "chunk_id": "web/zeph#Zeph.1.4",
    "work_id": "web/zeph",
    "canonical_ref": "Zeph.1.4",
    "language": "eng",
    "text": "I will stretch out my hand against Judah and against all the inhabitants of Jerusalem. I will cut off the remnant of Baal from this place—the name of the idolatrous and pagan priests,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
      -640,
      -620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
