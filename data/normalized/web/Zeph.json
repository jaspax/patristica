    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.8",
    "language": "eng",
    "text": "“Therefore wait for me”, says the LORD, “until the day that I rise up to the prey, for my determination is to gather the nations, that I may assemble the kingdoms to pour on them my indignation, even all my fierce anger, for all the earth will be devoured with the fire of my jealousy.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
