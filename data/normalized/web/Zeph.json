    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.9",
    "language": "eng",
    "text": "For then I will purify the lips of the peoples, that they may all call on the LORD’s name, to serve him shoulder to shoulder.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
