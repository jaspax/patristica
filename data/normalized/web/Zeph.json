    "translation_group_id": null
  },
  {
    "chunk_id": "web/zeph#Zeph.3.18",
    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.18",
    "language": "eng",
    "text": "I will remove those who grieve about the appointed feasts from you. They are a burden and a reproach to you.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
    "date_range": [
