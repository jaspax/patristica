    "work_id": "web/zeph",
    "canonical_ref": "Zeph.3.14",
    "language": "eng",
    "text": "Sing, daughter of Zion! Shout, Israel! Be glad and rejoice with all your heart, daughter of Jerusalem.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": -630,
