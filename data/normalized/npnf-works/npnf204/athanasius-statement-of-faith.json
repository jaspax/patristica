    "work_id": "npnf-works/athanasius-statement-of-faith",
    "canonical_ref": "Ath.ExpFid.2.2.s11",
    "language": "eng",
    "text": "ix. 26), He had descended from the bosom of the Father, took from the undefiled Virgin Mary our humanity (ἄνθρωπον),",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
