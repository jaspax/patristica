    "work_id": "npnf-works/athanasius-statement-of-faith",
    "canonical_ref": "Ath.ExpFid.2.2.s12",
    "language": "eng",
    "text": "Christ Jesus, whom He delivered of His own will to suffer for us, as the Lord saith:",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 330,
    "date_range": [
      325,
      340
    ],
