    "work_id": "npnf-works/cyril-of-alexandria-canonical-epistles",
    "canonical_ref": "CyrAlex.EpCan.Domn.3.s4",
    "language": "eng",
    "text": "He thinks it very hard, that not only what belonged to the Church, but every thing else was taken from him;",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 430,
    "date_range": [
      412,
      444
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
