    "canonical_ref": "CyrAlex.EpCan.Domn.3.s2",
    "language": "eng",
    "text": "but complains that he had not time and opportunity given him for his defence; and that whatever he had, was taken away from him.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 430,
    "date_range": [
      412,
      444
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
