    "canonical_ref": "CyrAlex.EpCan.Domn.3.s5",
    "language": "eng",
    "text": "and complains that all bishops were called to account for every thing they received, whether from the Church, or by any other means.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 430,
    "date_range": [
      412,
      444
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
