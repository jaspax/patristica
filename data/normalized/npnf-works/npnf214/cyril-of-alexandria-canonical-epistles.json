    "canonical_ref": "CyrAlex.EpCan.Lib.1.s1",
    "language": "eng",
    "text": "There is another Epistle of the same father, complaining to the bishops of Libya and Pentapolis.",
    "chunk_index": 10,
    "context_before": null,
