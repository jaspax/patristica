    "canonical_ref": "CyrAlex.EpCan.Domn.3.s1",
    "language": "eng",
    "text": "This letter contains a complaint of one, Peter, deposed from his See, yet retaining the character of a bishop, who thought his cause good,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 430,
    "date_range": [
