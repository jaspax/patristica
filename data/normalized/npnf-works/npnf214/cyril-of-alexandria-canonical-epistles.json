    "work_id": "npnf-works/cyril-of-alexandria-canonical-epistles",
    "canonical_ref": "CyrAlex.EpCan.Domn.3.s3",
    "language": "eng",
    "text": "He desires Domnus, who was a Metropolitan, that he would call a synod, and let him have a hearing; and that such bishops as Peter suspected of prejudice against him should not be permitted to be his judges.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 430,
    "date_range": [
      412,
      444
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
