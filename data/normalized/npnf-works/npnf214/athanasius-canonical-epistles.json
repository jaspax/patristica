    "work_id": "npnf-works/athanasius-canonical-epistles",
    "canonical_ref": "Ath.EpCan.Amm.2",
    "language": "eng",
    "text": "(Παντα μὲν καλὰ, κ.τ.λ.)",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 360,
    "date_range": [
