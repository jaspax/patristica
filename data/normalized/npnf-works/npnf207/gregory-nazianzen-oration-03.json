    "chunk_id": "npnf-works/gregory-nazianzen-oration-03#GregNaz.Or3.9.s3",
    "work_id": "npnf-works/gregory-nazianzen-oration-03",
    "canonical_ref": "GregNaz.Or3.9.s3",
    "language": "eng",
    "text": "It is only fair, since we have honoured you above all else: ye are my witnesses, ye, and they who have placed in our hands this—shall I say Authority, or Service?",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": 362,
    "date_range": [
