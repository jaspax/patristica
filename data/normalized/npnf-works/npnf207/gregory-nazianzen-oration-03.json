    "translation_group_id": null
  },
  {
    "chunk_id": "npnf-works/gregory-nazianzen-oration-03#GregNaz.Or3.9.s4",
    "work_id": "npnf-works/gregory-nazianzen-oration-03",
    "canonical_ref": "GregNaz.Or3.9.s4",
    "language": "eng",
    "text": "And if to him that loveth most is due, how shall I measure the love, for which I have made you my debtors by my own love?",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": 362,
    "date_range": [
