    "work_id": "npnf-works/gregory-nazianzen-oration-03",
    "canonical_ref": "GregNaz.Or3.9.s8",
    "language": "eng",
    "text": "Believe that listening is always less dangerous than talking, just as learning about God is more pleasant than teaching. Leave the more accurate search into these questions to those who are the Stewards of the Word;",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": 362,
    "date_range": [
