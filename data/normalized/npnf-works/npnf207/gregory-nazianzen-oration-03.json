    "work_id": "npnf-works/gregory-nazianzen-oration-03",
    "canonical_ref": "GregNaz.Or3.10.s3",
    "language": "eng",
    "text": "and may ye never be entangled in the snares of the wicked that go round about, or bound with the chain of your sins.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 362,
    "date_range": [
