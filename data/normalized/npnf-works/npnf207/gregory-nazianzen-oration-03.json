    "work_id": "npnf-works/gregory-nazianzen-oration-03",
    "canonical_ref": "GregNaz.Or3.10.s4",
    "language": "eng",
    "text": "May the Word in you never be smothered with cares of this life and so ye become unfruitful:",
    "chunk_index": 50,
