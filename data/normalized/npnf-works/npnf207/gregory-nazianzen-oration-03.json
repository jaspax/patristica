    "canonical_ref": "GregNaz.Or3.10.s1",
    "language": "eng",
    "text": "VIII. So may ye act, and so may ye honour us, whether present or absent, whether taking your part in our sermons, or preferring to do something else:",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
