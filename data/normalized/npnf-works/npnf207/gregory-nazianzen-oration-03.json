    "work_id": "npnf-works/gregory-nazianzen-oration-03",
    "canonical_ref": "GregNaz.Or3.8.s9",
    "language": "eng",
    "text": "as those bad umpires and measurers of the Godhead do, who by magnifying One Person more than is fit, diminish and insult the whole.",
    "chunk_index": 35,
    "context_before": null,
