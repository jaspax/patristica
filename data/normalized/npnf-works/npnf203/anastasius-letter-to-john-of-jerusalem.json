    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.8.s3",
    "language": "eng",
    "text": "which subvert its well tried moral system, which offend the ears of all who are witnesses of our doings and lay the ground for strife and anger and dissensions.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
