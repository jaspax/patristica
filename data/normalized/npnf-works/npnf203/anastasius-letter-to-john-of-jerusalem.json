    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.8.s9",
    "language": "eng",
    "text": "and all who are convicted of reading his impious works are condemned by the imperial judgment.” In these words my formal sentence was pronounced.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
    ],
