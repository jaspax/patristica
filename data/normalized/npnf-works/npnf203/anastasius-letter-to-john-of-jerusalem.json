    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.9.s1",
    "language": "eng",
    "text": "6. You are troubled by the complaint which people make as to our treatment of Rufinus, so that you pursue certain persons with vague suspicions.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
    ],
    "date_confidence": "approximate",
