    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.9.s2",
    "language": "eng",
    "text": "But I will meet this feeling of yours with an instance taken from holy writ, namely, where it is said: “Man seeth not as God seeth; for God looketh upon the heart, but man upon the countenance.”",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
