    "canonical_ref": "Anast.EpJoh.8.s1",
    "language": "eng",
    "text": "5. Far be such teaching from the catholic system of the Church of Rome. It can never by any possibility come to pass that we should accept as reasonable things which we condemn as matters of law and right.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
    ],
    "date_confidence": "approximate",
