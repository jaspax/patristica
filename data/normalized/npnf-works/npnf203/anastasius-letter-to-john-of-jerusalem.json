    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.8.s7",
    "language": "eng",
    "text": "in whatever part of the world they live, not to allow any translation of profane authors to creep in and spring up amongst them, which will seek to unsettle the mind of devout men by spreading its own darkness among them.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
