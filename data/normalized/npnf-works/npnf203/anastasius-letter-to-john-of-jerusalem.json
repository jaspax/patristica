    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.8.s6",
    "language": "eng",
    "text": "I certainly shall omit nothing which may enable me to guard the faith of the Gospel amongst my own people, and to warn, as far as in me lies, those who form part of my body,",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
