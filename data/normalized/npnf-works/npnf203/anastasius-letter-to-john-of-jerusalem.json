    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.8.s8",
    "language": "eng",
    "text": "Moreover, I cannot pass over in silence an event which has given me great pleasure, the decree issued by our Emperors, by which every one who serves God is warned against the reading of Origen,",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
