    "canonical_ref": "Anast.EpJoh.7.s6",
    "language": "eng",
    "text": "and to give the sanction of his unlooked for support to the overthrow of all that is of prime importance in the true faith as held by Catholic Christians from the time of the Apostles till now.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
