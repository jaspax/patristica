    "canonical_ref": "Anast.EpJoh.7.s5",
    "language": "eng",
    "text": "then the edifice which he has reared at the expense of so much labour serves for nothing else than to make the guilt the act of his own will,",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
