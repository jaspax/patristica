    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.1",
    "language": "eng",
    "text": "Bishop of the Church of Rome to John Bishop of Jerusalem Concerning the Character of Rufinus.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
