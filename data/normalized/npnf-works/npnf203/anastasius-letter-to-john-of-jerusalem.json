    "work_id": "npnf-works/anastasius-letter-to-john-of-jerusalem",
    "canonical_ref": "Anast.EpJoh.8.s2",
    "language": "eng",
    "text": "We have, therefore, the assurance that Christ our God, whose providence reaches over the whole world, bestows his approval on us when we say that it is wholly impossible for us to admit doctrines which defile the church,",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 401,
    "date_range": [
      400,
      401
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
