  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.20",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.20",
    "language": "grc",
    "text": "καὶ τὰ κτήνη τοῦ πεδίου ἀνέβλεψαν πρὸς σέ ὅτι ἐξηράνθησαν ἀφέσεις ὑδάτων καὶ πῦρ κατέφαγεν τὰ ὡραῖα τῆς ἐρήμου",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
