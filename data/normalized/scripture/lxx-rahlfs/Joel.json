    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.17",
    "language": "grc",
    "text": "ἐσκίρτησαν δαμάλεις ἐπὶ ταῖς φάτναις αὐτῶν ἠφανίσθησαν θησαυροί κατεσκάφησαν ληνοί ὅτι ἐξηράνθη σῖτος",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.18",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.18",
    "language": "grc",
    "text": "τί ἀποθήσομεν ἑαυτοῖς ἔκλαυσαν βουκόλια βοῶν ὅτι οὐχ ὑπῆρχεν νομὴ αὐτοῖς καὶ τὰ ποίμνια τῶν προβάτων ἠφανίσθησαν",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
