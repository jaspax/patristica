    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.19",
    "language": "grc",
    "text": "πρὸς σέ κύριε βοήσομαι ὅτι πῦρ ἀνήλωσεν τὰ ὡραῖα τῆς ἐρήμου καὶ φλὸξ ἀνῆψεν πάντα τὰ ξύλα τοῦ ἀγροῦ",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
