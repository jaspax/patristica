    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.4",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.4",
    "language": "grc",
    "text": "τὰ κατάλοιπα τῆς κάμπης κατέφαγεν ἡ ἀκρίς καὶ τὰ κατάλοιπα τῆς ἀκρίδος κατέφαγεν ὁ βροῦχος καὶ τὰ κατάλοιπα τοῦ βρούχου κατέφαγεν ἡ ἐρυσίβη",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.5",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.5",
    "language": "grc",
    "text": "ἐκνήψατε οἱ μεθύοντες ἐξ οἴνου αὐτῶν καὶ κλαύσατε θρηνήσατε πάντες οἱ πίνοντες οἶνον εἰς μέθην ὅτι ἐξῆρται ἐκ στόματος ὑμῶν εὐφροσύνη καὶ χαρά",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.6",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.6",
    "language": "grc",
    "text": "ὅτι ἔθνος ἀνέβη ἐπὶ τὴν γῆν μου ἰσχυρὸν καὶ ἀναρίθμητον οἱ ὀδόντες αὐτοῦ ὀδόντες λέοντος καὶ αἱ μύλαι αὐτοῦ σκύμνου",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.7",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.7",
    "language": "grc",
    "text": "ἔθετο τὴν ἄμπελόν μου εἰς ἀφανισμὸν καὶ τὰς συκᾶς μου εἰς συγκλασμόν ἐρευνῶν ἐξηρεύνησεν αὐτὴν καὶ ἔρριψεν ἐλεύκανεν κλήματα αὐτῆς",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.8",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.8",
    "language": "grc",
    "text": "θρήνησον πρός με ὑπὲρ νύμφην περιεζωσμένην σάκκον ἐπὶ τὸν ἄνδρα αὐτῆς τὸν παρθενικόν",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.9",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.9",
    "language": "grc",
    "text": "ἐξῆρται θυσία καὶ σπονδὴ ἐξ οἴκου κυρίου πενθεῖτε οἱ ἱερεῖς οἱ λειτουργοῦντες θυσιαστηρίῳ",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.10",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.10",
    "language": "grc",
    "text": "ὅτι τεταλαιπώρηκεν τὰ πεδία πενθείτω ἡ γῆ ὅτι τεταλαιπώρηκεν σῖτος ἐξηράνθη οἶνος ὠλιγώθη ἔλαιον",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.11",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.11",
    "language": "grc",
    "text": "ἐξηράνθησαν οἱ γεωργοί θρηνεῖτε κτήματα ὑπὲρ πυροῦ καὶ κριθῆς ὅτι ἀπόλωλεν τρυγητὸς ἐξ ἀγροῦ",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.12",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.12",
    "language": "grc",
    "text": "ἡ ἄμπελος ἐξηράνθη καὶ αἱ συκαῖ ὠλιγώθησαν ῥόα καὶ φοῖνιξ καὶ μῆλον καὶ πάντα τὰ ξύλα τοῦ ἀγροῦ ἐξηράνθησαν ὅτι ᾔσχυναν χαρὰν οἱ υἱοὶ τῶν ἀνθρώπων",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.13",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.13",
    "language": "grc",
    "text": "περιζώσασθε καὶ κόπτεσθε οἱ ἱερεῖς θρηνεῖτε οἱ λειτουργοῦντες θυσιαστηρίῳ εἰσέλθατε ὑπνώσατε ἐν σάκκοις λειτουργοῦντες θεῷ ὅτι ἀπέσχηκεν ἐξ οἴκου θεοῦ ὑμῶν θυσία καὶ σπονδή",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.14",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.14",
    "language": "grc",
    "text": "ἁγιάσατε νηστείαν κηρύξατε θεραπείαν συναγάγετε πρεσβυτέρους πάντας κατοικοῦντας γῆν εἰς οἶκον θεοῦ ὑμῶν καὶ κεκράξατε πρὸς κύριον ἐκτενῶς",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.15",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.15",
    "language": "grc",
    "text": "οἴμμοι οἴμμοι οἴμμοι εἰς ἡμέραν ὅτι ἐγγὺς ἡμέρα κυρίου καὶ ὡς ταλαιπωρία ἐκ ταλαιπωρίας ἥξει",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
