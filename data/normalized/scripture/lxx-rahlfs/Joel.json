    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.16",
    "language": "grc",
    "text": "κατέναντι τῶν ὀφθαλμῶν ὑμῶν βρώματα ἐξωλεθρεύθη ἐξ οἴκου θεοῦ ὑμῶν εὐφροσύνη καὶ χαρά",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
