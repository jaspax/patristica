  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.1.3",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.3",
    "language": "grc",
    "text": "ὑπὲρ αὐτῶν τοῖς τέκνοις ὑμῶν διηγήσασθε καὶ τὰ τέκνα ὑμῶν τοῖς τέκνοις αὐτῶν καὶ τὰ τέκνα αὐτῶν εἰς γενεὰν ἑτέραν",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
