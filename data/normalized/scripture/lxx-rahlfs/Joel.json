    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.1.2",
    "language": "grc",
    "text": "ἀκούσατε δὴ ταῦτα οἱ πρεσβύτεροι καὶ ἐνωτίσασθε πάντες οἱ κατοικοῦντες τὴν γῆν εἰ γέγονεν τοιαῦτα ἐν ταῖς ἡμέραις ὑμῶν ἢ ἐν ταῖς ἡμέραις τῶν πατέρων ὑμῶν",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
