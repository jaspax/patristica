    "canonical_ref": "Joel.1.1",
    "language": "grc",
    "text": "λόγος κυρίου ὃς ἐγενήθη πρὸς Ιωηλ τὸν τοῦ Βαθουηλ",
    "chunk_index": 0,
    "context_before": null,
