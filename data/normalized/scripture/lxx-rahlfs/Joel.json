    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/joel#Joel.2.1",
    "work_id": "scripture/lxx-rahlfs/joel",
    "canonical_ref": "Joel.2.1",
    "language": "grc",
    "text": "σαλπίσατε σάλπιγγι ἐν Σιων κηρύξατε ἐν ὄρει ἁγίῳ μου καὶ συγχυθήτωσαν πάντες οἱ κατοικοῦντες τὴν γῆν διότι πάρεστιν ἡμέρα κυρίου ὅτι ἐγγύς",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
