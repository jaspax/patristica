    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.18",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.18",
    "language": "grc",
    "text": "τί ὠφελεῖ γλυπτόν ὅτι ἔγλυψαν αὐτό ἔπλασαν αὐτὸ χώνευμα φαντασίαν ψευδῆ ὅτι πέποιθεν ὁ πλάσας ἐπὶ τὸ πλάσμα αὐτοῦ τοῦ ποιῆσαι εἴδωλα κωφά",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
