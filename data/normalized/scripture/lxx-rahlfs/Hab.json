    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.4",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.4",
    "language": "grc",
    "text": "καὶ φέγγος αὐτοῦ ὡς φῶς ἔσται κέρατα ἐν χερσὶν αὐτοῦ καὶ ἔθετο ἀγάπησιν κραταιὰν ἰσχύος αὐτοῦ",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
