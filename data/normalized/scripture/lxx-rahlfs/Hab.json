    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.5",
    "language": "grc",
    "text": "πρὸ προσώπου αὐτοῦ πορεύσεται λόγος καὶ ἐξελεύσεται ἐν πεδίλοις οἱ πόδες αὐτοῦ",
    "chunk_index": 41,
    "context_before": null,
