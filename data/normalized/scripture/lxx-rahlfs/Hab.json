    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.8",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.8",
    "language": "grc",
    "text": "μὴ ἐν ποταμοῖς ὠργίσθης κύριε ἢ ἐν ποταμοῖς ὁ θυμός σου ἢ ἐν θαλάσσῃ τὸ ὅρμημά σου ὅτι ἐπιβήσῃ ἐπὶ τοὺς ἵππους σου καὶ ἡ ἱππασία σου σωτηρία",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.9",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.9",
    "language": "grc",
    "text": "ἐντείνων ἐντενεῖς τὸ τόξον σου ἐπὶ τὰ σκῆπτρα λέγει κύριος διάψαλμα ποταμῶν ῥαγήσεται γῆ",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.10",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.10",
    "language": "grc",
    "text": "ὄψονταί σε καὶ ὠδινήσουσιν λαοί σκορπίζων ὕδατα πορείας αὐτοῦ ἔδωκεν ἡ ἄβυσσος φωνὴν αὐτῆς ὕψος φαντασίας αὐτῆς",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.11",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.11",
    "language": "grc",
    "text": "ἐπήρθη ὁ ἥλιος καὶ ἡ σελήνη ἔστη ἐν τῇ τάξει αὐτῆς εἰς φῶς βολίδες σου πορεύσονται εἰς φέγγος ἀστραπῆς ὅπλων σου",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
