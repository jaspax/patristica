    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.6",
    "language": "grc",
    "text": "ἔστη καὶ ἐσαλεύθη ἡ γῆ ἐπέβλεψεν καὶ διετάκη ἔθνη διεθρύβη τὰ ὄρη βίᾳ ἐτάκησαν βουνοὶ αἰώνιοι",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
