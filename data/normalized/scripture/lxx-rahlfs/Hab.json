    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.12",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.12",
    "language": "grc",
    "text": "ἐν ἀπειλῇ ὀλιγώσεις γῆν καὶ ἐν θυμῷ κατάξεις ἔθνη",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.13",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.13",
    "language": "grc",
    "text": "ἐξῆλθες εἰς σωτηρίαν λαοῦ σου τοῦ σῶσαι τοὺς χριστούς σου ἔβαλες εἰς κεφαλὰς ἀνόμων θάνατον ἐξήγειρας δεσμοὺς ἕως τραχήλου διάψαλμα",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.14",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.14",
    "language": "grc",
    "text": "διέκοψας ἐν ἐκστάσει κεφαλὰς δυναστῶν σεισθήσονται ἐν αὐτῇ διανοίξουσιν χαλινοὺς αὐτῶν ὡς ἔσθων πτωχὸς λάθρᾳ",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
