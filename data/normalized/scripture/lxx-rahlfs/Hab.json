    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.1",
    "language": "grc",
    "text": "προσευχὴ Αμβακουμ τοῦ προφήτου μετὰ ᾠδῆς",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
