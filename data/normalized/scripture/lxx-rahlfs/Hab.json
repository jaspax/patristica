    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.19",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.19",
    "language": "grc",
    "text": "οὐαὶ ὁ λέγων τῷ ξύλῳ ἔκνηψον ἐξεγέρθητι καὶ τῷ λίθῳ ὑψώθητι καὶ αὐτό ἐστιν φαντασία τοῦτο δέ ἐστιν ἔλασμα χρυσίου καὶ ἀργυρίου καὶ πᾶν πνεῦμα οὐκ ἔστιν ἐν αὐτῷ",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.20",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.20",
    "language": "grc",
    "text": "ὁ δὲ κύριος ἐν ναῷ ἁγίῳ αὐτοῦ εὐλαβείσθω ἀπὸ προσώπου αὐτοῦ πᾶσα ἡ γῆ",
    "chunk_index": 36,
    "context_before": null,
