    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.7",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.7",
    "language": "grc",
    "text": "πορείας αἰωνίας αὐτοῦ ἀντὶ κόπων εἶδον σκηνώματα Αἰθιόπων πτοηθήσονται καὶ αἱ σκηναὶ γῆς Μαδιαμ",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
