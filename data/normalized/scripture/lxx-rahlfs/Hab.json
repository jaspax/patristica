[
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.1",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.1",
    "language": "grc",
    "text": "τὸ λῆμμα ὃ εἶδεν Αμβακουμ ὁ προφήτης",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.2",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.2",
    "language": "grc",
    "text": "ἕως τίνος κύριε κεκράξομαι καὶ οὐ μὴ εἰσακούσῃς βοήσομαι πρὸς σὲ ἀδικούμενος καὶ οὐ σώσεις",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.3",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.3",
    "language": "grc",
    "text": "ἵνα τί μοι ἔδειξας κόπους καὶ πόνους ἐπιβλέπειν ταλαιπωρίαν καὶ ἀσέβειαν ἐξ ἐναντίας μου γέγονεν κρίσις καὶ ὁ κριτὴς λαμβάνει",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.4",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.4",
    "language": "grc",
    "text": "διὰ τοῦτο διεσκέδασται νόμος καὶ οὐ διεξάγεται εἰς τέλος κρίμα ὅτι ὁ ἀσεβὴς καταδυναστεύει τὸν δίκαιον ἕνεκεν τούτου ἐξελεύσεται τὸ κρίμα διεστραμμένον",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.5",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.5",
    "language": "grc",
    "text": "ἴδετε οἱ καταφρονηταί καὶ ἐπιβλέψατε καὶ θαυμάσατε θαυμάσια καὶ ἀφανίσθητε διότι ἔργον ἐγὼ ἐργάζομαι ἐν ταῖς ἡμέραις ὑμῶν ὃ οὐ μὴ πιστεύσητε ἐάν τις ἐκδιηγῆται",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.6",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.6",
    "language": "grc",
    "text": "διότι ἰδοὺ ἐγὼ ἐξεγείρω ἐφ᾿ ὑμᾶς τοὺς Χαλδαίους τοὺς μαχητάς τὸ ἔθνος τὸ πικρὸν καὶ τὸ ταχινὸν τὸ πορευόμενον ἐπὶ τὰ πλάτη τῆς γῆς τοῦ κατακληρονομῆσαι σκηνώματα οὐκ αὐτοῦ",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.7",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.7",
    "language": "grc",
    "text": "φοβερὸς καὶ ἐπιφανής ἐστιν ἐξ αὐτοῦ τὸ κρίμα αὐτοῦ ἔσται καὶ τὸ λῆμμα αὐτοῦ ἐξ αὐτοῦ ἐξελεύσεται",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.8",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.8",
    "language": "grc",
    "text": "καὶ ἐξαλοῦνται ὑπὲρ παρδάλεις οἱ ἵπποι αὐτοῦ καὶ ὀξύτεροι ὑπὲρ τοὺς λύκους τῆς Ἀραβίας καὶ ἐξιππάσονται οἱ ἱππεῖς αὐτοῦ καὶ ὁρμήσουσιν μακρόθεν καὶ πετασθήσονται ὡς ἀετὸς πρόθυμος εἰς τὸ φαγεῖν",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.9",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.9",
    "language": "grc",
    "text": "συντέλεια εἰς ἀσεβεῖς ἥξει ἀνθεστηκότας προσώποις αὐτῶν ἐξ ἐναντίας καὶ συνάξει ὡς ἄμμον αἰχμαλωσίαν",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.10",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.10",
    "language": "grc",
    "text": "καὶ αὐτὸς ἐν βασιλεῦσιν ἐντρυφήσει καὶ τύραννοι παίγνια αὐτοῦ καὶ αὐτὸς εἰς πᾶν ὀχύρωμα ἐμπαίξεται καὶ βαλεῖ χῶμα καὶ κρατήσει αὐτοῦ",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.11",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.11",
    "language": "grc",
    "text": "τότε μεταβαλεῖ τὸ πνεῦμα καὶ διελεύσεται καὶ ἐξιλάσεται αὕτη ἡ ἰσχὺς τῷ θεῷ μου",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.12",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.12",
    "language": "grc",
    "text": "οὐχὶ σὺ ἀπ᾿ ἀρχῆς κύριε ὁ θεὸς ὁ ἅγιός μου καὶ οὐ μὴ ἀποθάνωμεν κύριε εἰς κρίμα τέταχας αὐτόν καὶ ἔπλασέν με τοῦ ἐλέγχειν παιδείαν αὐτοῦ",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.13",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.13",
    "language": "grc",
    "text": "καθαρὸς ὀφθαλμὸς τοῦ μὴ ὁρᾶν πονηρά καὶ ἐπιβλέπειν ἐπὶ πόνους οὐ δυνήσῃ ἵνα τί ἐπιβλέπεις ἐπὶ καταφρονοῦντας παρασιωπήσῃ ἐν τῷ καταπίνειν ἀσεβῆ τὸν δίκαιον",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.14",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.14",
    "language": "grc",
    "text": "καὶ ποιήσεις τοὺς ἀνθρώπους ὡς τοὺς ἰχθύας τῆς θαλάσσης καὶ ὡς τὰ ἑρπετὰ τὰ οὐκ ἔχοντα ἡγούμενον",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.15",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.15",
    "language": "grc",
    "text": "συντέλειαν ἐν ἀγκίστρῳ ἀνέσπασεν καὶ εἵλκυσεν αὐτὸν ἐν ἀμφιβλήστρῳ καὶ συνήγαγεν αὐτὸν ἐν ταῖς σαγήναις αὐτοῦ ἕνεκεν τούτου εὐφρανθήσεται καὶ χαρήσεται ἡ καρδία αὐτοῦ",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.16",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.16",
    "language": "grc",
    "text": "ἕνεκεν τούτου θύσει τῇ σαγήνῃ αὐτοῦ καὶ θυμιάσει τῷ ἀμφιβλήστρῳ αὐτοῦ ὅτι ἐν αὐτοῖς ἐλίπανεν μερίδα αὐτοῦ καὶ τὰ βρώματα αὐτοῦ ἐκλεκτά",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.1.17",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.1.17",
    "language": "grc",
    "text": "διὰ τοῦτο ἀμφιβαλεῖ τὸ ἀμφίβληστρον αὐτοῦ καὶ διὰ παντὸς ἀποκτέννειν ἔθνη οὐ φείσεται",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.1",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.1",
    "language": "grc",
    "text": "ἐπὶ τῆς φυλακῆς μου στήσομαι καὶ ἐπιβήσομαι ἐπὶ πέτραν καὶ ἀποσκοπεύσω τοῦ ἰδεῖν τί λαλήσει ἐν ἐμοὶ καὶ τί ἀποκριθῶ ἐπὶ τὸν ἔλεγχόν μου",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.2",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.2",
    "language": "grc",
    "text": "καὶ ἀπεκρίθη πρός με κύριος καὶ εἶπεν γράψον ὅρασιν καὶ σαφῶς ἐπὶ πυξίον ὅπως διώκῃ ὁ ἀναγινώσκων αὐτά",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.3",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.3",
    "language": "grc",
    "text": "διότι ἔτι ὅρασις εἰς καιρὸν καὶ ἀνατελεῖ εἰς πέρας καὶ οὐκ εἰς κενόν ἐὰν ὑστερήσῃ ὑπόμεινον αὐτόν ὅτι ἐρχόμενος ἥξει καὶ οὐ μὴ χρονίσῃ",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.4",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.4",
    "language": "grc",
    "text": "ἐὰν ὑποστείληται οὐκ εὐδοκεῖ ἡ ψυχή μου ἐν αὐτῷ ὁ δὲ δίκαιος ἐκ πίστεώς μου ζήσεται",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.5",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.5",
    "language": "grc",
    "text": "ὁ δὲ κατοινωμένος καὶ καταφρονητὴς ἀνὴρ ἀλαζών οὐδὲν μὴ περάνῃ ὃς ἐπλάτυνεν καθὼς ὁ ᾅδης τὴν ψυχὴν αὐτοῦ καὶ οὗτος ὡς θάνατος οὐκ ἐμπιπλάμενος καὶ ἐπισυνάξει ἐπ᾿ αὐτὸν πάντα τὰ ἔθνη καὶ εἰσδέξεται πρὸς αὐτὸν πάντας τοὺς λαούς",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.6",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.6",
    "language": "grc",
    "text": "οὐχὶ ταῦτα πάντα παραβολὴν κατ᾿ αὐτοῦ λήμψονται καὶ πρόβλημα εἰς διήγησιν αὐτοῦ καὶ ἐροῦσιν οὐαὶ ὁ πληθύνων ἑαυτῷ τὰ οὐκ ὄντα αὐτοῦ ἕως τίνος καὶ βαρύνων τὸν κλοιὸν αὐτοῦ στιβαρῶς",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.7",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.7",
    "language": "grc",
    "text": "ὅτι ἐξαίφνης ἀναστήσονται δάκνοντες αὐτόν καὶ ἐκνήψουσιν οἱ ἐπίβουλοί σου καὶ ἔσῃ εἰς διαρπαγὴν αὐτοῖς",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.8",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.8",
    "language": "grc",
    "text": "διότι σὺ ἐσκύλευσας ἔθνη πολλά σκυλεύσουσίν σε πάντες οἱ ὑπολελειμμένοι λαοὶ δι᾿ αἵματα ἀνθρώπων καὶ ἀσεβείας γῆς καὶ πόλεως καὶ πάντων τῶν κατοικούντων αὐτήν",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.9",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.9",
    "language": "grc",
    "text": "ὦ ὁ πλεονεκτῶν πλεονεξίαν κακὴν τῷ οἴκῳ αὐτοῦ τοῦ τάξαι εἰς ὕψος νοσσιὰν αὐτοῦ τοῦ ἐκσπασθῆναι ἐκ χειρὸς κακῶν",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.10",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.10",
    "language": "grc",
    "text": "ἐβουλεύσω αἰσχύνην τῷ οἴκῳ σου συνεπέρανας λαοὺς πολλούς καὶ ἐξήμαρτεν ἡ ψυχή σου",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.11",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.11",
    "language": "grc",
    "text": "διότι λίθος ἐκ τοίχου βοήσεται καὶ κάνθαρος ἐκ ξύλου φθέγξεται αὐτά",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.12",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.12",
    "language": "grc",
    "text": "οὐαὶ ὁ οἰκοδομῶν πόλιν ἐν αἵμασιν καὶ ἑτοιμάζων πόλιν ἐν ἀδικίαις",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.13",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.13",
    "language": "grc",
    "text": "οὐ ταῦτά ἐστιν παρὰ κυρίου παντοκράτορος καὶ ἐξέλιπον λαοὶ ἱκανοὶ ἐν πυρί καὶ ἔθνη πολλὰ ὠλιγοψύχησαν",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.2.14",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.2.14",
    "language": "grc",
    "text": "ὅτι πλησθήσεται ἡ γῆ τοῦ γνῶναι τὴν δόξαν κυρίου ὡς ὕδωρ κατακαλύψει αὐτούς",
    "chunk_index": 30,
