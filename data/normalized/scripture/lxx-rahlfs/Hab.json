    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.15",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.15",
    "language": "grc",
    "text": "καὶ ἐπεβίβασας εἰς θάλασσαν τοὺς ἵππους σου ταράσσοντας ὕδωρ πολύ",
    "chunk_index": 51,
    "context_before": null,
