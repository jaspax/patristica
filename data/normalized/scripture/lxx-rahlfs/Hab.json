    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.16",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.16",
    "language": "grc",
    "text": "ἐφυλαξάμην καὶ ἐπτοήθη ἡ κοιλία μου ἀπὸ φωνῆς προσευχῆς χειλέων μου καὶ εἰσῆλθεν τρόμος εἰς τὰ ὀστᾶ μου καὶ ὑποκάτωθέν μου ἐταράχθη ἡ ἕξις μου ἀναπαύσομαι ἐν ἡμέρᾳ θλίψεως τοῦ ἀναβῆναι εἰς λαὸν παροικίας μου",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.17",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.17",
    "language": "grc",
    "text": "διότι συκῆ οὐ καρποφορήσει καὶ οὐκ ἔσται γενήματα ἐν ταῖς ἀμπέλοις ψεύσεται ἔργον ἐλαίας καὶ τὰ πεδία οὐ ποιήσει βρῶσιν ἐξέλιπον ἀπὸ βρώσεως πρόβατα καὶ οὐχ ὑπάρχουσιν βόες ἐπὶ φάτναις",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
