    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.2",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.2",
    "language": "grc",
    "text": "κύριε εἰσακήκοα τὴν ἀκοήν σου καὶ ἐφοβήθην κατενόησα τὰ ἔργα σου καὶ ἐξέστην ἐν μέσῳ δύο ζῴων γνωσθήσῃ ἐν τῷ ἐγγίζειν τὰ ἔτη ἐπιγνωσθήσῃ ἐν τῷ παρεῖναι τὸν καιρὸν ἀναδειχθήσῃ ἐν τῷ ταραχθῆναι τὴν ψυχήν μου ἐν ὀργῇ ἐλέους μνησθήσῃ",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "lxx-rahlfs/hab#Hab.3.3",
    "work_id": "lxx-rahlfs/hab",
    "canonical_ref": "Hab.3.3",
    "language": "grc",
    "text": "ὁ θεὸς ἐκ Θαιμαν ἥξει καὶ ὁ ἅγιος ἐξ ὄρους κατασκίου δασέος διάψαλμα ἐκάλυψεν οὐρανοὺς ἡ ἀρετὴ αὐτοῦ καὶ αἰνέσεως αὐτοῦ πλήρης ἡ γῆ",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
