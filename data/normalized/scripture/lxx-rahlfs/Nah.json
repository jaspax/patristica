    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.2",
    "language": "grc",
    "text": "θεὸς ζηλωτὴς καὶ ἐκδικῶν κύριος ἐκδικῶν κύριος μετὰ θυμοῦ ἐκδικῶν κύριος τοὺς ὑπεναντίους αὐτοῦ καὶ ἐξαίρων αὐτὸς τοὺς ἐχθροὺς αὐτοῦ",
    "chunk_index": 1,
    "context_before": null,
