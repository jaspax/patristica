  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.3",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.3",
    "language": "grc",
    "text": "κύριος μακρόθυμος καὶ μεγάλη ἡ ἰσχὺς αὐτοῦ καὶ ἀθῳῶν οὐκ ἀθῳώσει κύριος ἐν συντελείᾳ καὶ ἐν συσσεισμῷ ἡ ὁδὸς αὐτοῦ καὶ νεφέλαι κονιορτὸς ποδῶν αὐτοῦ",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.4",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.4",
    "language": "grc",
    "text": "ἀπειλῶν θαλάσσῃ καὶ ξηραίνων αὐτὴν καὶ πάντας τοὺς ποταμοὺς ἐξερημῶν ὠλιγώθη ἡ Βασανῖτις καὶ ὁ Κάρμηλος καὶ τὰ ἐξανθοῦντα τοῦ Λιβάνου ἐξέλιπεν",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.5",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.5",
    "language": "grc",
    "text": "τὰ ὄρη ἐσείσθησαν ἀπ᾿ αὐτοῦ καὶ οἱ βουνοὶ ἐσαλεύθησαν καὶ ἀνεστάλη ἡ γῆ ἀπὸ προσώπου αὐτοῦ ἡ σύμπασα καὶ πάντες οἱ κατοικοῦντες ἐν αὐτῇ",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.6",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.6",
    "language": "grc",
    "text": "ἀπὸ προσώπου ὀργῆς αὐτοῦ τίς ὑποστήσεται καὶ τίς ἀντιστήσεται ἐν ὀργῇ θυμοῦ αὐτοῦ ὁ θυμὸς αὐτοῦ τήκει ἀρχάς καὶ αἱ πέτραι διεθρύβησαν ἀπ᾿ αὐτοῦ",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.7",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.7",
    "language": "grc",
    "text": "χρηστὸς κύριος τοῖς ὑπομένουσιν αὐτὸν ἐν ἡμέρᾳ θλίψεως καὶ γινώσκων τοὺς εὐλαβουμένους αὐτόν",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.8",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.8",
    "language": "grc",
    "text": "καὶ ἐν κατακλυσμῷ πορείας συντέλειαν ποιήσεται τοὺς ἐπεγειρομένους καὶ τοὺς ἐχθροὺς αὐτοῦ διώξεται σκότος",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.9",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.9",
    "language": "grc",
    "text": "τί λογίζεσθε ἐπὶ τὸν κύριον συντέλειαν αὐτὸς ποιήσεται οὐκ ἐκδικήσει δὶς ἐπὶ τὸ αὐτὸ ἐν θλίψει",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.10",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.10",
    "language": "grc",
    "text": "ὅτι ἕως θεμελίου αὐτῶν χερσωθήσεται καὶ ὡς σμῖλαξ περιπλεκομένη βρωθήσεται καὶ ὡς καλάμη ξηρασίας μεστή",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.11",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.11",
    "language": "grc",
    "text": "ἐκ σοῦ ἐξελεύσεται λογισμὸς κατὰ τοῦ κυρίου πονηρὰ λογιζόμενος ἐναντία",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.12",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.12",
    "language": "grc",
    "text": "τάδε λέγει κύριος κατάρχων ὑδάτων πολλῶν καὶ οὕτως διασταλήσονται καὶ ἡ ἀκοή σου οὐκ ἐνακουσθήσεται ἔτι",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.13",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.13",
    "language": "grc",
    "text": "καὶ νῦν συντρίψω τὴν ῥάβδον αὐτοῦ ἀπὸ σοῦ καὶ τοὺς δεσμούς σου διαρρήξω",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.1.14",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.1.14",
    "language": "grc",
    "text": "καὶ ἐντελεῖται ὑπὲρ σοῦ κύριος οὐ σπαρήσεται ἐκ τοῦ ὀνόματός σου ἔτι ἐξ οἴκου θεοῦ σου ἐξολεθρεύσω τὰ γλυπτὰ καὶ χωνευτά θήσομαι ταφήν σου ὅτι ταχεῖς",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.1",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.1",
    "language": "grc",
    "text": "ἰδοὺ ἐπὶ τὰ ὄρη οἱ πόδες εὐαγγελιζομένου καὶ ἀπαγγέλλοντος εἰρήνην ἑόρταζε Ιουδα τὰς ἑορτάς σου ἀπόδος τὰς εὐχάς σου διότι οὐ μὴ προσθήσωσιν ἔτι τοῦ διελθεῖν διὰ σοῦ εἰς παλαίωσιν συντετέλεσται ἐξῆρται",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.2",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.2",
    "language": "grc",
    "text": "ἀνέβη ἐμφυσῶν εἰς πρόσωπόν σου ἐξαιρούμενος ἐκ θλίψεως σκόπευσον ὁδόν κράτησον ὀσφύος ἄνδρισαι τῇ ἰσχύι σφόδρα",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.3",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.3",
    "language": "grc",
    "text": "διότι ἀπέστρεψεν κύριος τὴν ὕβριν Ιακωβ καθὼς ὕβριν τοῦ Ισραηλ διότι ἐκτινάσσοντες ἐξετίναξαν αὐτοὺς καὶ τὰ κλήματα αὐτῶν διέφθειραν",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.4",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.4",
    "language": "grc",
    "text": "ὅπλα δυναστείας αὐτῶν ἐξ ἀνθρώπων ἄνδρας δυνατοὺς ἐμπαίζοντας ἐν πυρί αἱ ἡνίαι τῶν ἁρμάτων αὐτῶν ἐν ἡμέρᾳ ἑτοιμασίας αὐτοῦ καὶ οἱ ἱππεῖς θορυβηθήσονται",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.5",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.5",
    "language": "grc",
    "text": "ἐν ταῖς ὁδοῖς καὶ συγχυθήσονται τὰ ἅρματα καὶ συμπλακήσονται ἐν ταῖς πλατείαις ἡ ὅρασις αὐτῶν ὡς λαμπάδες πυρὸς καὶ ὡς ἀστραπαὶ διατρέχουσαι",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.6",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.6",
    "language": "grc",
    "text": "καὶ μνησθήσονται οἱ μεγιστᾶνες αὐτῶν καὶ φεύξονται ἡμέρας καὶ ἀσθενήσουσιν ἐν τῇ πορείᾳ αὐτῶν καὶ σπεύσουσιν ἐπὶ τὰ τείχη καὶ ἑτοιμάσουσιν τὰς προφυλακὰς αὐτῶν",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.7",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.7",
    "language": "grc",
    "text": "πύλαι τῶν ποταμῶν διηνοίχθησαν καὶ τὰ βασίλεια διέπεσεν",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.8",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.8",
    "language": "grc",
    "text": "καὶ ἡ ὑπόστασις ἀπεκαλύφθη καὶ αὕτη ἀνέβαινεν καὶ αἱ δοῦλαι αὐτῆς ἤγοντο καθὼς περιστεραὶ φθεγγόμεναι ἐν καρδίαις αὐτῶν",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.9",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.9",
    "language": "grc",
    "text": "καὶ Νινευη ὡς κολυμβήθρα ὕδατος τὰ ὕδατα αὐτῆς καὶ αὐτοὶ φεύγοντες οὐκ ἔστησαν καὶ οὐκ ἦν ὁ ἐπιβλέπων",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.10",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.10",
    "language": "grc",
    "text": "διήρπαζον τὸ ἀργύριον διήρπαζον τὸ χρυσίον καὶ οὐκ ἦν πέρας τοῦ κόσμου αὐτῆς βεβάρυνται ὑπὲρ πάντα τὰ σκεύη τὰ ἐπιθυμητὰ αὐτῆς",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.11",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.11",
    "language": "grc",
    "text": "ἐκτιναγμὸς καὶ ἀνατιναγμὸς καὶ ἐκβρασμὸς καὶ καρδίας θραυσμὸς καὶ ὑπόλυσις γονάτων καὶ ὠδῖνες ἐπὶ πᾶσαν ὀσφύν καὶ τὸ πρόσωπον πάντων ὡς πρόσκαυμα χύτρας",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.12",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.12",
    "language": "grc",
    "text": "ποῦ ἐστιν τὸ κατοικητήριον τῶν λεόντων καὶ ἡ νομὴ ἡ οὖσα τοῖς σκύμνοις οὗ ἐπορεύθη λέων τοῦ εἰσελθεῖν ἐκεῖ σκύμνος λέοντος καὶ οὐκ ἦν ὁ ἐκφοβῶν",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.13",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.13",
    "language": "grc",
    "text": "λέων ἥρπασεν τὰ ἱκανὰ τοῖς σκύμνοις αὐτοῦ καὶ ἀπέπνιξεν τοῖς λέουσιν αὐτοῦ καὶ ἔπλησεν θήρας νοσσιὰν αὐτοῦ καὶ τὸ κατοικητήριον αὐτοῦ ἁρπαγῆς",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.2.14",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.2.14",
    "language": "grc",
    "text": "ἰδοὺ ἐγὼ ἐπὶ σέ λέγει κύριος παντοκράτωρ καὶ ἐκκαύσω ἐν καπνῷ πλῆθός σου καὶ τοὺς λέοντάς σου καταφάγεται ῥομφαία καὶ ἐξολεθρεύσω ἐκ τῆς γῆς τὴν θήραν σου καὶ οὐ μὴ ἀκουσθῇ οὐκέτι τὰ ἔργα σου",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.3.1",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.3.1",
    "language": "grc",
    "text": "ὦ πόλις αἱμάτων ὅλη ψευδὴς ἀδικίας πλήρης οὐ ψηλαφηθήσεται θήρα",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": -200,
    "date_range": [
      -280,
      -100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/lxx-rahlfs/nah#Nah.3.2",
    "work_id": "scripture/lxx-rahlfs/nah",
    "canonical_ref": "Nah.3.2",
    "language": "grc",
    "text": "φωνὴ μαστίγων καὶ φωνὴ σεισμοῦ τροχῶν καὶ ἵππου διώκοντος καὶ ἅρματος ἀναβράσσοντος",
    "chunk_index": 29,
