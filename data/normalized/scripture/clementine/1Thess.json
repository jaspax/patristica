    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.7",
    "language": "lat",
    "text": "Non enim vocavit nos Deus in immunditiam, sed in sanctificationem.",
    "chunk_index": 49,
    "context_before": null,
