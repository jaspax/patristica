    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.11",
    "language": "lat",
    "text": "et opera detis ut quieti sitis, et ut vestrum negotium agatis, et operemini manibus vestris, sicut præcepimus vobis:",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
