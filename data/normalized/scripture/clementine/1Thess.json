    "canonical_ref": "1Thess.5.9",
    "language": "lat",
    "text": "quoniam non posuit nos Deus in iram, sed in acquisitionem salutis per Dominum nostrum Jesum Christum,",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
