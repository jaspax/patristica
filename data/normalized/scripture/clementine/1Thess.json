    "chunk_id": "scripture/clementine/1thess#1Thess.4.15",
    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.15",
    "language": "lat",
    "text": "Hoc enim vobis dicimus in verbo Domini, quia nos, qui vivimus, qui residui sumus in adventum Domini, non præveniemus eos qui dormierunt.",
    "chunk_index": 57,
    "context_before": null,
