    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.4",
    "language": "lat",
    "text": "ut sciat unusquisque vestrum vas suum possidere in sanctificatione, et honore:",
    "chunk_index": 46,
    "context_before": null,
