    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.5.6",
    "language": "lat",
    "text": "Igitur non dormiamus sicut et ceteri, sed vigilemus, et sobrii simus.",
    "chunk_index": 66,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
