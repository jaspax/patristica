    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.10",
    "language": "lat",
    "text": "Etenim illud facitis in omnes fratres in universa Macedonia. Rogamus autem vos, fratres, ut abundetis magis,",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
