[
  {
    "chunk_id": "scripture/clementine/1thess#1Thess.1.1",
    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.1.1",
    "language": "lat",
    "text": "Paulus, et Silvanus, et Timotheus ecclesiæ Thessalonicensium in Deo Patre, et Domino Jesu Christo.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
