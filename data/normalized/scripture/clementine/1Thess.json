    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.5.2",
    "language": "lat",
    "text": "Ipsi enim diligenter scitis quia dies Domini, sicut fur in nocte, ita veniet:",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
