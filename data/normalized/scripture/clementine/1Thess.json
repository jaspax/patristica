    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.9",
    "language": "lat",
    "text": "De caritate autem fraternitatis non necesse habemus scribere vobis: ipsi enim vos a Deo didicistis ut diligatis invicem.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
