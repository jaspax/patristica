    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.8",
    "language": "lat",
    "text": "Itaque qui hæc spernit, non hominem spernit, sed Deum: qui etiam dedit Spiritum suum Sanctum in nobis.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
