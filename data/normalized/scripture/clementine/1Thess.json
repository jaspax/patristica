  },
  {
    "chunk_id": "scripture/clementine/1thess#1Thess.4.13",
    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.4.13",
    "language": "lat",
    "text": "Nolumus autem vos ignorare fratres de dormientibus, ut non contristemini sicut et ceteri, qui spem non habent.",
