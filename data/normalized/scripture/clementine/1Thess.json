    "work_id": "scripture/clementine/1thess",
    "canonical_ref": "1Thess.5.7",
    "language": "lat",
    "text": "Qui enim dormiunt, nocte dormiunt: et qui ebrii sunt, nocte ebrii sunt.",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
