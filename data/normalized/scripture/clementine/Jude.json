    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.2",
    "language": "lat",
    "text": "Misericordia vobis, et pax, et caritas adimpleatur.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
