    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.23",
    "language": "lat",
    "text": "illos vero salvate, de igne rapientes. Aliis autem miseremini in timore: odientes et eam, quæ carnalis est, maculatam tunicam.",
