    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.21",
    "language": "lat",
    "text": "vosmetipsos in dilectione Dei servate, exspectantes misericordiam Domini nostri Jesu Christi in vitam æternam.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
