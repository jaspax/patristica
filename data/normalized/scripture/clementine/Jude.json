    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.20",
    "language": "lat",
    "text": "Vos autem carissimi superædificantes vosmetipsos sanctissimæ vestræ fidei, in Spiritu Sancto orantes,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
