    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.24",
    "language": "lat",
    "text": "Ei autem qui potens est vos conservare sine peccato et constituere ante conspectum gloriæ suæ immaculatos in exsultatione in adventu Domini nostri Jesu Christi,",
    "chunk_index": 23,
    "context_before": null,
