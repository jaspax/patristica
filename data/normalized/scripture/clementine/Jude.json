    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.18",
    "language": "lat",
    "text": "qui dicebant vobis, quoniam in novissimo tempore venient illusores, secundum desideria sua ambulantes in impietatibus.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
