    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.22",
    "language": "lat",
    "text": "Et hos quidem arguite judicatos:",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
