    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.16",
    "language": "lat",
    "text": "Hi sunt murmuratores querulosi, secundum desideria sua ambulantes, et os eorum loquitur superba, mirantes personas quæstus causa.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
