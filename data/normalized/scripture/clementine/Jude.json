[
  {
    "chunk_id": "scripture/clementine/jude#Jude.1.1",
    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.1",
    "language": "lat",
    "text": "Judas Jesu Christi servus, frater autem Jacobi, his qui sunt in Deo Patre dilectis, et Christo Jesu conservatis, et vocatis.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
