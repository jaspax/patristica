    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/jude#Jude.1.17",
    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.17",
    "language": "lat",
    "text": "Vos autem carissimi, memores estote verborum, quæ prædicta sunt ab apostolis Domini nostri Jesu Christi,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
