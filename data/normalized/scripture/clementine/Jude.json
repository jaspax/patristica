    "work_id": "scripture/clementine/jude",
    "canonical_ref": "Jude.1.19",
    "language": "lat",
    "text": "Hi sunt, qui segregant semetipsos, animales, Spiritum non habentes.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
