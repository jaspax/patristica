[
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.1",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.1",
    "language": "lat",
    "text": "Verbum Domini, quod factum est ad Joël, filium Phatuel.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
