    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.2",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.2",
    "language": "lat",
    "text": "[Audite hoc, senes, et auribus percipite, omnes habitatores terræ: si factum est istud in diebus vestris, aut in diebus patrum vestrorum?",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.3",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.3",
    "language": "lat",
    "text": "Super hoc filiis vestris narrate, et filii vestri filiis suis, et filii eorum generationi alteræ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.4",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.4",
    "language": "lat",
    "text": "Residuum erucæ comedit locusta, et residuum locustæ comedit bruchus, et residuum bruchi comedit rubigo.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.5",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.5",
    "language": "lat",
    "text": "Expergiscimini, ebrii, et flete et ululate, omnes qui bibitis vinum in dulcedine, quoniam periit ab ore vestro.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.6",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.6",
    "language": "lat",
    "text": "Gens enim ascendit super terram meam, fortis et innumerabilis: dentes ejus ut dentes leonis, et molares ejus ut catuli leonis.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.7",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.7",
    "language": "lat",
    "text": "Posuit vineam meam in desertum, et ficum meam decorticavit; nudans spoliavit eam, et projecit: albi facti sunt rami ejus.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.8",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.8",
    "language": "lat",
    "text": "Plange quasi virgo accincta sacco super virum pubertatis suæ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.9",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.9",
    "language": "lat",
    "text": "Periit sacrificium et libatio de domo Domini; luxerunt sacerdotes, ministri Domini.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.10",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.10",
    "language": "lat",
    "text": "Depopulata est regio, luxit humus, quoniam devastatum est triticum, confusum est vinum, elanguit oleum.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.11",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.11",
    "language": "lat",
    "text": "Confusi sunt agricolæ, ululaverunt vinitores super frumento et hordeo, quia periit messis agri.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.12",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.12",
    "language": "lat",
    "text": "Vinea confusa est, et ficus elanguit; malogranatum, et palma, et malum, et omnia ligna agri aruerunt, quia confusum est gaudium a filiis hominum.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.13",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.13",
    "language": "lat",
    "text": "Accingite vos, et plangite, sacerdotes: ululate, ministri altaris; ingredimini, cubate in sacco, ministri Dei mei, quoniam interiit de domo Dei vestri sacrificium et libatio.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.14",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.14",
    "language": "lat",
    "text": "Sanctificate jejunium, vocate cœtum, congregate senes, omnes habitatores terræ in domum Dei vestri, et clamate ad Dominum:",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.15",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.15",
    "language": "lat",
    "text": "A, a, a, diei ! quia prope est dies Domini, et quasi vastitas a potente veniet.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.16",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.16",
    "language": "lat",
    "text": "Numquid non coram oculis vestris alimenta perierunt de domo Dei nostri, lætitia et exsultatio?",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.17",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.17",
    "language": "lat",
    "text": "Computruerunt jumenta in stercore suo, demolita sunt horrea, dissipatæ sunt apothecæ, quoniam confusum est triticum.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.18",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.18",
    "language": "lat",
    "text": "Quid ingemuit animal, mugierunt greges armenti? quia non est pascua eis; sed et greges pecorum disperierunt.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.19",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.19",
    "language": "lat",
    "text": "Ad te, Domine, clamabo, quia ignis comedit speciosa deserti, et flamma succendit omnia ligna regionis.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.1.20",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.1.20",
    "language": "lat",
    "text": "Sed et bestiæ agri, quasi area sitiens imbrem, suspexerunt ad te, quoniam exsiccati sunt fontes aquarum, et ignis devoravit speciosa deserti.]",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.1",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.1",
    "language": "lat",
    "text": "[Canite tuba in Sion, ululate in monte sancto meo, conturbentur omnes habitatores terræ: quia venit dies Domini, quia prope est.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.2",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.2",
    "language": "lat",
    "text": "Dies tenebrarum et caliginis, dies nubis et turbinis; quasi mane expansum super montes populus multus et fortis: similis ei non fuit a principio, et post eum non erit usque in annos generationis et generationis.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.3",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.3",
    "language": "lat",
    "text": "Ante faciem ejus ignis vorans, et post eum exurens flamma. Quasi hortus voluptatis terra coram eo, et post eum solitudo deserti, neque est qui effugiat eum.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.4",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.4",
    "language": "lat",
    "text": "Quasi aspectus equorum, aspectus eorum; et quasi equites, sic current.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.5",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.5",
    "language": "lat",
    "text": "Sicut sonitus quadrigarum super capita montium exilient, sicut sonitus flammæ ignis devorantis stipulam, velut populus fortis præparatus ad prælium.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.6",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.6",
    "language": "lat",
    "text": "A facie ejus cruciabuntur populi; omnes vultus redigentur in ollam.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.7",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.7",
    "language": "lat",
    "text": "Sicut fortes current; quasi viri bellatores ascendent murum: viri in viis suis gradientur, et non declinabunt a semitis suis.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.8",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.8",
    "language": "lat",
    "text": "Unusquisque fratrem suum non coarctabit, singuli in calle suo ambulabunt; sed et per fenestras cadent, et non demolientur.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.9",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.9",
    "language": "lat",
    "text": "Urbem ingredientur, in muro current, domos conscendent, per fenestras intrabunt quasi fur.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.10",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.10",
    "language": "lat",
    "text": "A facie ejus contremuit terra, moti sunt cæli, sol et luna obtenebrati sunt, et stellæ retraxerunt splendorem suum.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.11",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.11",
    "language": "lat",
    "text": "Et Dominus dedit vocem suam ante faciem exercitus sui, quia multa sunt nimis castra ejus, quia fortia et facientia verbum ejus: magnus enim dies Domini, et terribilis valde, et quis sustinebit eum?",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.12",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.12",
    "language": "lat",
    "text": "Nunc ergo, dicit Dominus, convertimini ad me in toto corde vestro, in jejunio, et in fletu, et in planctu.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.13",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.13",
    "language": "lat",
    "text": "Et scindite corda vestra, et non vestimenta vestra; et convertimini ad Dominum Deum vestrum, quia benignus et misericors est, patiens et multæ misericordiæ, et præstabilis super malitia.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.14",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.14",
    "language": "lat",
    "text": "Quis scit si convertatur, et ignoscat, et relinquat post se benedictionem, sacrificium et libamen Domino Deo vestro?",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.15",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.15",
    "language": "lat",
    "text": "Canite tuba in Sion, sanctificate jejunium, vocate cœtum:",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.16",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.16",
    "language": "lat",
    "text": "congregate populum, sanctificate ecclesiam, coadunate senes, congregate parvulos, et sugentes ubera; egrediatur sponsus de cubili suo, et sponsa de thalamo suo.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/joel#Joel.2.17",
    "work_id": "scripture/clementine/joel",
    "canonical_ref": "Joel.2.17",
    "language": "lat",
    "text": "Inter vestibulum et altare plorabunt sacerdotes, ministri Domini, et dicent: Parce, Domine, parce populo tuo; et ne des hæreditatem tuam in opprobrium, ut dominentur eis nationes. Quare dicunt in populis: Ubi est Deus eorum?]",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
