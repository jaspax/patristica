    "chunk_id": "scripture/clementine/phlm#Phlm.1.16",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.16",
    "language": "lat",
    "text": "jam non ut servum, sed pro servo carissimum fratrem, maxime mihi: quanto autem magis tibi et in carne, et in Domino?",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/phlm#Phlm.1.17",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.17",
    "language": "lat",
    "text": "Si ergo habes me socium, suscipe illum sicut me:",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
