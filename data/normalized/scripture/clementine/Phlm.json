    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.9",
    "language": "lat",
    "text": "propter caritatem magis obsecro, cum sis talis, ut Paulus senex, nunc autem et vinctus Jesu Christi:",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/phlm#Phlm.1.10",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.10",
    "language": "lat",
    "text": "obsecro te pro meo filio, quem genui in vinculis, Onesimo,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
