    "chunk_id": "scripture/clementine/phlm#Phlm.1.22",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.22",
    "language": "lat",
    "text": "Simul autem et para mihi hospitium: nam spero per orationes vestras donari me vobis.",
