    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.3",
    "language": "lat",
    "text": "Gratia vobis, et pax a Deo Patre nostro, et Domino Jesu Christo.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/phlm#Phlm.1.4",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.4",
    "language": "lat",
    "text": "Gratias ago Deo meo, semper memoriam tui faciens in orationibus meis,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
