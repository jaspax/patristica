    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.13",
    "language": "lat",
    "text": "quem ego volueram mecum detinere, ut pro te mihi ministraret in vinculis Evangelii:",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
