    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.19",
    "language": "lat",
    "text": "Ego Paulus scripsi mea manu: ego reddam, ut non dicam tibi, quod et teipsum mihi debes:",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
