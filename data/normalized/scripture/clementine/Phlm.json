    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.21",
    "language": "lat",
    "text": "Confidens in obedientia tua scripsi tibi: sciens quoniam et super id, quod dico, facies.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
