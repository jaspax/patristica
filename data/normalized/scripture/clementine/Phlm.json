    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.12",
    "language": "lat",
    "text": "quem remisi tibi. Tu autem illum, ut mea viscera, suscipe:",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
