    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.11",
    "language": "lat",
    "text": "qui tibi aliquando inutilis fuit, nunc autem et mihi et tibi utilis,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
