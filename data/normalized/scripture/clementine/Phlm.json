    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/phlm#Phlm.1.15",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.15",
    "language": "lat",
    "text": "Forsitan enim ideo discessit ad horam a te, ut æternum illum reciperes:",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
