    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.14",
    "language": "lat",
    "text": "sine consilio autem tuo nihil volui facere, uti ne velut ex necessitate bonum tuum esset, sed voluntarium.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
