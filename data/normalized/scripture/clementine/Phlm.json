    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.2",
    "language": "lat",
    "text": "et Appiæ sorori carissimæ, et Archippo commilitoni nostro, et ecclesiæ, quæ in domo tua est.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
