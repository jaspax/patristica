    "chunk_id": "scripture/clementine/phlm#Phlm.1.18",
    "work_id": "scripture/clementine/phlm",
    "canonical_ref": "Phlm.1.18",
    "language": "lat",
    "text": "si autem aliquid nocuit tibi, aut debet, hoc mihi imputa.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
