    "work_id": "scripture/clementine/obad",
    "canonical_ref": "Obad.1.2",
    "language": "lat",
    "text": "Ecce parvulum dedi te in gentibus: contemptibilis tu es valde.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
