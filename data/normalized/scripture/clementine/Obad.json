    "canonical_ref": "Obad.1.1",
    "language": "lat",
    "text": "Visio Abdiæ. [Hæc dicit Dominus Deus ad Edom: Auditum audivimus a Domino, et legatum ad gentes misit: surgite, et consurgamus adversus eum in prælium.",
    "chunk_index": 0,
    "context_before": null,
