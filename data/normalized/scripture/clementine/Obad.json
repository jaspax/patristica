    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/obad#Obad.1.16",
    "work_id": "scripture/clementine/obad",
    "canonical_ref": "Obad.1.16",
    "language": "lat",
    "text": "Quomodo enim bibistis super montem sanctum meum, bibent omnes gentes jugiter: et bibent, et absorbebunt, et erunt quasi non sint.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/obad#Obad.1.17",
    "work_id": "scripture/clementine/obad",
    "canonical_ref": "Obad.1.17",
    "language": "lat",
    "text": "Et in monte Sion erit salvatio, et erit sanctus; et possidebit domus Jacob eos qui se possederant.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/obad#Obad.1.18",
    "work_id": "scripture/clementine/obad",
    "canonical_ref": "Obad.1.18",
    "language": "lat",
    "text": "Et erit domus Jacob ignis, et domus Joseph flamma, et domus Esau stipula: et succendentur in eis, et devorabunt eos, et non erunt reliquiæ domus Esau, quia Dominus locutus est.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
