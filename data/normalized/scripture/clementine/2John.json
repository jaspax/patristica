    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.5",
    "language": "lat",
    "text": "Et nunc rogo te domina, non tamquam mandatum novum scribens tibi, sed quod habuimus ab initio, ut diligamus alterutrum.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
