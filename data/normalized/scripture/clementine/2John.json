    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.7",
    "language": "lat",
    "text": "Quoniam multi seductores exierunt in mundum, qui non confitentur Jesum Christum venisse in carnem: hic est seductor, et antichristus.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
