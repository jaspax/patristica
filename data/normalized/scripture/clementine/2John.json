    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.4",
    "language": "lat",
    "text": "Gavisus sum valde, quoniam inveni de filiis tuis ambulantes in veritate, sicut mandatum accepimus a Patre.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
