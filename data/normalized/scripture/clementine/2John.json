    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.3",
    "language": "lat",
    "text": "Sit vobiscum gratia, misericordia, pax a Deo Patre, et a Christo Jesu Filio Patris in veritate, et caritate.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
