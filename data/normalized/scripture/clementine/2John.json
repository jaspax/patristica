    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.6",
    "language": "lat",
    "text": "Et hæc est caritas, ut ambulemus secundum mandata ejus. Hoc est enim mandatum, ut quemadmodum audistis ab initio, in eo ambuletis.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
