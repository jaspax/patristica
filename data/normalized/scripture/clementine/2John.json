    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.8",
    "language": "lat",
    "text": "Videte vosmetipsos, ne perdatis quæ operati estis: sed ut mercedem plenam accipiatis.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
