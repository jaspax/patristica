    "work_id": "scripture/clementine/2john",
    "canonical_ref": "2John.1.10",
    "language": "lat",
    "text": "Si quis venit ad vos, et hanc doctrinam non affert, nolite recipere eum in domum, nec Ave ei dixeritis.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
