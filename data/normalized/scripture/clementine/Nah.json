    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.13",
    "language": "lat",
    "text": "Ecce populus tuus mulieres in medio tui: inimicis tuis adapertione pandentur portæ terræ tuæ, devorabit ignis vectes tuos.",
    "chunk_index": 40,
    "context_before": null,
