    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.15",
    "language": "lat",
    "text": "Ibi comedet te ignis, peribis gladio, devorabit te ut bruchus: congregare ut bruchus, multiplicare ut locusta.",
