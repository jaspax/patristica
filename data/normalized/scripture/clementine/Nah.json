[
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.1",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.1",
    "language": "lat",
    "text": "Onus Ninive. Liber visionis Nahum Elcesæi.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.2",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.2",
    "language": "lat",
    "text": "[Deus æmulator, et ulciscens Dominus: ulciscens Dominus, et habens furorem: ulciscens Dominus in hostes suos, et irascens ipse inimicis suis.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.3",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.3",
    "language": "lat",
    "text": "Dominus patiens, et magnus fortitudine, et mundans non faciet innocentem. Dominus in tempestate et turbine viæ ejus, et nebulæ pulvis pedum ejus.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.4",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.4",
    "language": "lat",
    "text": "Increpans mare, et exsiccans illud, et omnia flumina ad desertum deducens. Infirmatus est Basan et Carmelus, et flos Libani elanguit.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.5",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.5",
    "language": "lat",
    "text": "Montes commoti sunt ab eo, et colles desolati sunt: et contremuit terra a facie ejus, et orbis, et omnes habitantes in eo.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.6",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.6",
    "language": "lat",
    "text": "Ante faciem indignationis ejus quis stabit? et quis resistet in ira furoris ejus? Indignatio ejus effusa est ut ignis, et petræ dissolutæ sunt ab eo.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.7",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.7",
    "language": "lat",
    "text": "Bonus Dominus, et confortans in die tribulationis, et sciens sperantes in se.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.8",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.8",
    "language": "lat",
    "text": "Et in diluvio prætereunte consummationem faciet loci ejus, et inimicos ejus persequentur tenebræ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.9",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.9",
    "language": "lat",
    "text": "Quid cogitatis contra Dominum? Consummationem ipse faciet: non consurget duplex tribulatio,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.10",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.10",
    "language": "lat",
    "text": "quia sicut spinæ se invicem complectuntur, sic convivium eorum pariter potantium; consumentur quasi stipula ariditate plena.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.11",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.11",
    "language": "lat",
    "text": "Ex te exibit cogitans contra Dominum malitiam, mente pertractans prævaricationem.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.12",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.12",
    "language": "lat",
    "text": "Hæc dicit Dominus: Si perfecti fuerint, et ita plures, sic quoque attondentur, et pertransibit: afflixi te, et non affligam te ultra.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.13",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.13",
    "language": "lat",
    "text": "Et nunc conteram virgam ejus de dorso tuo, et vincula tua disrumpam.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.14",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.14",
    "language": "lat",
    "text": "Et præcipiet super te Dominus; non seminabitur ex nomine tuo amplius: de domo Dei tui interficiam sculptile, et conflatile; ponam sepulchrum tuum, quia inhonoratus es.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.1.15",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.1.15",
    "language": "lat",
    "text": "Ecce super montes pedes evangelizantis, et annuntiantis pacem. Celebra, Juda, festivitates tuas, et redde vota tua, quia non adjiciet ultra ut pertranseat in te Belial: universus interiit.]",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.1",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.1",
    "language": "lat",
    "text": "[Ascendit qui dispergat coram te, qui custodiat obsidionem: contemplare viam, conforta lumbos, robora virtutem valde.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.2",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.2",
    "language": "lat",
    "text": "Quia reddidit Dominus superbiam Jacob, sicut superbiam Israël; quia vastatores dissipaverunt eos, et propagines eorum corruperunt.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.3",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.3",
    "language": "lat",
    "text": "Clypeus fortium ejus ignitus, viri exercitus in coccineis; igneæ habenæ currus in die præparationis ejus, et agitatores consopiti sunt.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.4",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.4",
    "language": "lat",
    "text": "In itineribus conturbati sunt; quadrigæ collisæ sunt in plateis: aspectus eorum quasi lampades, quasi fulgura discurrentia.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.5",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.5",
    "language": "lat",
    "text": "Recordabitur fortium suorum; ruent in itineribus suis: velociter ascendent muros ejus, et præparabitur umbraculum.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.6",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.6",
    "language": "lat",
    "text": "Portæ fluviorum apertæ sunt, et templum ad solum dirutum.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.7",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.7",
    "language": "lat",
    "text": "Et miles captivus abductus est, et ancillæ ejus minabantur gementes ut columbæ, murmurantes in cordibus suis.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.8",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.8",
    "language": "lat",
    "text": "Et Ninive quasi piscina aquarum aquæ ejus; ipsi vero fugerunt. State, state ! et non est qui revertatur.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.9",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.9",
    "language": "lat",
    "text": "Diripite argentum, diripite aurum: et non est finis divitiarum ex omnibus vasis desiderabilibus.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.10",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.10",
    "language": "lat",
    "text": "Dissipata est, et scissa, et dilacerata; et cor tabescens, et dissolutio geniculorum, et defectio in cunctis renibus, et facies omnium eorum sicut nigredo ollæ.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.11",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.11",
    "language": "lat",
    "text": "Ubi est habitaculum leonum, et pascua catulorum leonum, ad quam ivit leo ut ingrederetur illuc catulus leonis, et non est qui exterreat?",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.12",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.12",
    "language": "lat",
    "text": "Leo cepit sufficienter catulis suis, et necavit leænis suis, et implevit præda speluncas suas, et cubile suum rapina.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.2.13",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.2.13",
    "language": "lat",
    "text": "Ecce ego ad te, dicit Dominus exercituum, et succendam usque ad fumum quadrigas tuas, et leunculos tuos comedet gladius, et exterminabo de terra prædam tuam, et non audietur ultra vox nuntiorum tuorum.]",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.1",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.1",
    "language": "lat",
    "text": "[Væ civitas sanguinum, universa mendacii dilaceratione plena ! non recedet a te rapina.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.2",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.2",
    "language": "lat",
    "text": "Vox flagelli, et vox impetus rotæ, et equi frementis, et quadrigæ ferventis, et equitis ascendentis,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.3",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.3",
    "language": "lat",
    "text": "et micantis gladii, et fulgurantis hastæ, et multitudinis interfectæ, et gravis ruinæ; nec est finis cadaverum, et corruent in corporibus suis.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.4",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.4",
    "language": "lat",
    "text": "Propter multitudinem fornicationum meretricis speciosæ, et gratæ, et habentis maleficia, quæ vendidit gentes in fornicationibus suis, et familias in maleficiis suis.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.5",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.5",
    "language": "lat",
    "text": "Ecce ego ad te, dicit Dominus exercituum, et revelabo pudenda tua in facie tua; et ostendam gentibus nuditatem tuam, et regnis ignominiam tuam.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.6",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.6",
    "language": "lat",
    "text": "Et projiciam super te abominationes, et contumeliis te afficiam, et ponam te in exemplum.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.7",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.7",
    "language": "lat",
    "text": "Et erit: omnis qui viderit te resiliet a te, et dicet: Vastata est Ninive. Quis commovebit super te caput? unde quæram consolatorem tibi?",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.8",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.8",
    "language": "lat",
    "text": "Numquid melior es Alexandria populorum, quæ habitat in fluminibus? aquæ in circuitu ejus; cujus divitiæ, mare; aquæ, muri ejus.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.9",
    "work_id": "scripture/clementine/nah",
    "canonical_ref": "Nah.3.9",
    "language": "lat",
    "text": "Æthiopia fortitudo ejus, et Ægyptus, et non est finis; Africa et Libyes fuerunt in auxilio tuo.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/nah#Nah.3.10",
    "work_id": "scripture/clementine/nah",
