    "work_id": "scripture/clementine/ruth",
    "canonical_ref": "Ruth.2.16",
    "language": "lat",
    "text": "et de vestris quoque manipulis projicite de industria, et remanere permittite, ut absque rubore colligat, et colligentem nemo corripiat.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
