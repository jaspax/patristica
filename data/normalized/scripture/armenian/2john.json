    "work_id": "scripture/armenian/2john",
    "canonical_ref": "2John.1.2",
    "language": "hye",
    "text": "վասն որոյ ճշմարտութեանն որ ի մեզ հաստատեալ է զի եւ ընդ ձեզ իցէ եւ դուք յաւիտենից ընդ մեզ իցէք",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
