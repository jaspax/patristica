    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/armenian/2john#2John.1.4",
    "work_id": "scripture/armenian/2john",
    "canonical_ref": "2John.1.4",
    "language": "hye",
    "text": "Ուրախ եղէ յոյժ զի գտի յորդեկացդ քոց որ գնան ճշմարտութեամբ ըստ պատուիրանին զոր առաք ի Հօրէ",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
