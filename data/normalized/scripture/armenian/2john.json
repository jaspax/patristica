  },
  {
    "chunk_id": "scripture/armenian/2john#2John.1.3",
    "work_id": "scripture/armenian/2john",
    "canonical_ref": "2John.1.3",
    "language": "hye",
    "text": "Շնորհք ողորմութիւն խաղաղութիւն յԱստուծոյ ի Հօրէ եւ ի Տեառնէ Յիսուսէ Քրիստոսէ Որդւոյն Հօր ճշմարտութեամբ եւ սիրով եղիցին ընդ ձեզ",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
      100
    ],
    "date_confidence": "approximate",
