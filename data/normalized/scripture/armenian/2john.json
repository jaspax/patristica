    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/armenian/2john#2John.1.5",
    "work_id": "scripture/armenian/2john",
    "canonical_ref": "2John.1.5",
    "language": "hye",
    "text": "Եւ այժմ աղաչեմ զքեզ Կիւրիա իբրեւ ոչ եթէ նոր ինչ պատուիրան գրեմ քեզ այլ զոր ի սկզբանէն ունէաք զի սիրեսցուք զմիմեանս",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
