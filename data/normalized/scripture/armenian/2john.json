    "work_id": "scripture/armenian/2john",
    "canonical_ref": "2John.1.6",
    "language": "hye",
    "text": "Եւ այս է սէրն զի գնասցուք ըստ պատուիրանաց նորա եւ այս է պատուիրանն զի որպէս լուարուքն ի սկզբանէ ըստ նմին գնասջիք",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
