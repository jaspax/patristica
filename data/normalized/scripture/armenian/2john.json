    "work_id": "scripture/armenian/2john",
    "canonical_ref": "2John.1.7",
    "language": "hye",
    "text": "Զի բազում մոլորեցուցիչք ելին յաշխարհ որ ոք ոչ խոստովանի զՅիսուս Քրիստոս եկեալ մարմնով նա մոլորեցուցիչ է եւ Նեռն",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
