  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.12",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.12",
    "language": "hye",
    "text": "մխիթարէաք եւ սփոփէաք եւ դնէաք վկայութիւն գնալ ձեզ արժանապէս Աստուծոյ որ կոչեացն զձեզ յիւր արքայութիւնն եւ ի փառս",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
