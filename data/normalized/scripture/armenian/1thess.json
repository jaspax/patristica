  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.6",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.6",
    "language": "hye",
    "text": "Եւ դուք նմանեալք մեզ եւ Տեառն ընկալայք զբանն ի բազում նեղութեան խնդութեամբ Հոգւոյն Սրբոյ",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
