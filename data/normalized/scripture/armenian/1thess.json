  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.8",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.8",
    "language": "hye",
    "text": "Նոյնպէս եւ մեք գթայաք ի ձեզ հաճոյ թուէր մեզ տալ ձեզ ոչ միայն զաւետարանն Աստուծոյ այլ եւ զանձինս մեր քանզի սիրելիք մեր եղերուք",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
