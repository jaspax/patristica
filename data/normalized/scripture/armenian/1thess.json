  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.3",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.3",
    "language": "hye",
    "text": "անդադար յիշել զձեր գործն հաւատոց եւ զվաստակ սիրոյ եւ զհամբերութիւն յուսոյ Տեառն մերոյ Յիսուսի Քրիստոսի առաջի Աստուծոյ եւ Հօր մերոյ",
    "chunk_index": 2,
    "context_before": null,
