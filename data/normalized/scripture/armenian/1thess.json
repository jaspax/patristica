  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.5",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.5",
    "language": "hye",
    "text": "զի աւետարանն մեր ոչ եղեւ առ ձեզ միայն բանիւ այլ եւ զօրութեամբ եւ Հոգւով Սրբով եւ լրութեամբ բազմաւ որպէս եւ գիտէք իսկ թէ որպիսիք եղեաք ի միջի ձերում վասն ձեր",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
