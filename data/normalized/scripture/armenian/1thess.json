    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.4",
    "language": "hye",
    "text": "գիտէք եղբարք սիրեցեալք յԱստուծոյ զընտրութիւնն ձեր",
    "chunk_index": 3,
    "context_before": null,
