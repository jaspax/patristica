  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.4",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.4",
    "language": "hye",
    "text": "այլ որպէս ընտրեցաք յԱստուծոյ հաւատարիմ լինել աւետարանին նոյնպէս եւ խօսիմք ոչ իբրեւ մարդկան հաճոյ լինել այլ Աստուծոյ որ քննէ զսիրտս մեր",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
