  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.8",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.8",
    "language": "hye",
    "text": "Զի ի ձէնջ հնչեաց բանն Աստուծոյ ոչ միայն ի Մակեդոնիա եւ յԱքայիա այլ յամենայն տեղիս հաւատքն ձեր որ առ Աստուած են սփռեցան զի այսուհետեւ ոչինչ է պիտոյ մեզ եւ խօսել ինչ",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
