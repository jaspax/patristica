  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.1",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.1",
    "language": "hye",
    "text": "Դուք ինքնին գիտէք եղբարք զմուտն մեր առ ձեզ զի ոչ ընդունայն ինչ եղեւ",
    "chunk_index": 10,
    "context_before": null,
