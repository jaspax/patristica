  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.7",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.7",
    "language": "hye",
    "text": "լինել ձեզ օրինակ ամենայն հաւատացելոց որ են ի Մակեդոնիա եւ յԱքայիա",
    "chunk_index": 6,
    "context_before": null,
