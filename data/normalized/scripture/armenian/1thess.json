  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.10",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.10",
    "language": "hye",
    "text": "Դուք ինքնին վկայէք եւ Աստուած ո՛րպէս սրբութեամբ եւ արդարութեամբ եւ անբծութեամբ ձեզ հաւատացելոցդ եղեաք",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
