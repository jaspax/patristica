  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.9",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.9",
    "language": "hye",
    "text": "Զի նոքին իսկ պատմեն վասն մեր թէ որպէս եղեւ մեզ մուտ առ ձեզ եւ որպէս դարձայք առ Աստուած ի կռոց անտի ծառայել Աստուծոյ կենդանւոյ եւ ճշմարտի",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
