  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.2",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.2",
    "language": "hye",
    "text": "շնորհք ընդ ձեզ եւ խաղաղութիւն Գոհանամք զԱստուծոյ յամենայն ժամ վասն ձեր ամենեցուն յիշատակ առնել յաղօթս մեր",
