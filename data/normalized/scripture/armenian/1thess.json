  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.10",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.10",
    "language": "hye",
    "text": "եւ ակն ունել Որդւոյ նորա յերկնից զոր յարոյցն ի մեռելոց զՅիսուս որ փրկելոցն է զմեզ ի բարկութենէ անտի որ գալոցն է",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
