    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.11",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.11",
    "language": "hye",
    "text": "որպէս եւ գիտէք իսկ զի զիւրաքանչիւր ոք ի ձէնջ իբրեւ հայր զորդիս",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
