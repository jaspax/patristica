  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.9",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.9",
    "language": "hye",
    "text": "Յիշէք եղբարք զվաստակն մեր եւ զջան զի զցայգ եւ զցերեկ գործէաք վասն չ ծանրանալոյ ումեք ի ձէնջ եւ քարոզէաք ձեզ զաւետարանն Աստուծոյ",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
