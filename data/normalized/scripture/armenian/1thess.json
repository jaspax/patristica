[
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.1.1",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.1.1",
    "language": "hye",
    "text": "Պաւղոս եւ Սիղուանոս եւ Տիմոթէոս եկեղեցւոյդ Թեսաղոնիկեցւոց յԱստուած Հայր մեր եւ ի Տէր Յիսուս Քրիստոս",
