  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.7",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.7",
    "language": "hye",
    "text": "Կարող էաք որպէս Քրիստոսի առաքեալս ծանրանալ այլ եղեաք հեզք ի միջի ձերում որպէս դայեակ մի որ սնուցանիցէ մանկունս",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
