  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.5",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.5",
    "language": "hye",
    "text": "Զի ոչ երբեք բանիւք ողոքանաց եղեաք առ ձեզ որպէս եւ դուք իսկ գիտէք եւ ոչ ի պատճառս ագահութեան որպէս եւ Աստուած վկայէ",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 51,
    "date_range": [
      50,
