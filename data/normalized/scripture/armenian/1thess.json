  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.6",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.6",
    "language": "hye",
    "text": "եւ ոչ խնդրէաք փառս ի մարդկանէ ոչ ի ձէնջ եւ ոչ յայլոց",
