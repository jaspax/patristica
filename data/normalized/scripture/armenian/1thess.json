  },
  {
    "chunk_id": "scripture/armenian/1thess#1Thess.2.14",
    "work_id": "scripture/armenian/1thess",
    "canonical_ref": "1Thess.2.14",
    "language": "hye",
    "text": "Զի դուք նմանողք եղերուք եղբարք եկեղեցեացն Աստուծոյ որ են ի Հրէաստանի ի Քրիստոս Յիսուս զի զնոյն չարչարանս չարչարեցայք եւ դուք ի ձերոց ազգականաց որպէս եւ նոքայն ի Հրէից",
    "chunk_index": 23,
    "context_before": null,
