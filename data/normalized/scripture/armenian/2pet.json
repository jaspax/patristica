  },
  {
    "chunk_id": "armenian/2pet#2Pet.1.4",
    "work_id": "armenian/2pet",
    "canonical_ref": "2Pet.1.4",
    "language": "hye",
    "text": "որովք մեծամեծքն եւ պատուական աւետիք պարգեւեալ են մեզ զի նոքիմբք աստուածեղէն բնութեանն լինիցիք հաղորդակիցք փախուցեալք ի ցանկութեանց աշխարհիս եւ յապականութեանց",
