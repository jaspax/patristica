  },
  {
    "chunk_id": "scripture/armenian/jude#Jude.1.6",
    "work_id": "scripture/armenian/jude",
    "canonical_ref": "Jude.1.6",
    "language": "hye",
    "text": "Եւ զհրեշտակս որ ոչ պահեցին զիւրեանց իշխանութիւնն այլ թողին զիւրեանց բնակութիւնն ի դատաստանս մեծի աւուրն մշտնջենաւոր կապանօք պահեաց ի խաւարի",
    "chunk_index": 5,
    "context_before": null,
