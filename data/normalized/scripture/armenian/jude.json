    "work_id": "scripture/armenian/jude",
    "canonical_ref": "Jude.1.8",
    "language": "hye",
    "text": "Ըստ նմին օրինակի եւ սոքա իբրեւ քնով դանդաչեալք զմարմին պղծեն զտէրութիւնս քամահեն զփառսն հայհոյեն",
    "chunk_index": 7,
    "context_before": null,
