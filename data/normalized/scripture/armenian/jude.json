    "work_id": "scripture/armenian/jude",
    "canonical_ref": "Jude.1.10",
    "language": "hye",
    "text": "Իսկ սոքա զոր ինչ ոչն իմանան հայհոյեն եւ զայլն եւս զոր բնութեամբ իբրեւ զանխօս անասուն գիտեն ի նոսին ապականեսցին",
    "chunk_index": 9,
    "context_before": null,
