    "work_id": "scripture/armenian/jude",
    "canonical_ref": "Jude.1.13",
    "language": "hye",
    "text": "անսաստ ալիք ծովու որ միշտ փրփրեն զիւրեանց անձանցն զամօթ աստեղք մոլարք որոց վիհ խաւարին յաւիտենից պահեալ է",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
