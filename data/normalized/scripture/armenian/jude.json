    "work_id": "scripture/armenian/jude",
    "canonical_ref": "Jude.1.4",
    "language": "hye",
    "text": "Քանզի սպրդեցին մտին ոմանք որ յառաջագոյն իսկ կատարեալ էին ի սոյն դատաստան ամբարիշտք որ զԱստուծոյ մերոյ շնորհսն դարձուցին յանկարգութիւն եւ զմի միայն զԻշխանն եւ զՏէր մեր Յիսուս Քրիստոս ուրացեալք",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 70,
    "date_range": [
      65,
