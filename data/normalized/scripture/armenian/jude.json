    "work_id": "scripture/armenian/jude",
    "canonical_ref": "Jude.1.5",
    "language": "hye",
    "text": "Յիշեցուցանել ձեզ այսուհետեւ կամ է ինձ որ գիտէքդ զամենայն զի Աստուած միանգամ զժողովուրդն փրկեաց յԵգիպտոսէ երկրորդ անգամ զանհաւատսն կորոյս",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 70,
    "date_range": [
      65,
