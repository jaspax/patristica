    "work_id": "scripture/web/joel",
    "canonical_ref": "Joel.2.16",
    "language": "eng",
    "text": "Gather the people. Sanctify the assembly. Assemble the elders. Gather the children, and those who nurse from breasts. Let the bridegroom go out of his room, and the bride out of her chamber.",
