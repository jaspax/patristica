    "work_id": "scripture/web/joel",
    "canonical_ref": "Joel.2.5",
    "language": "eng",
    "text": "Like the noise of chariots on the tops of the mountains, they leap, like the noise of a flame of fire that devours the stubble, like a strong people set in battle array.",
