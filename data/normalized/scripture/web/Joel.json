    "work_id": "scripture/web/joel",
    "canonical_ref": "Joel.2.1",
    "language": "eng",
    "text": "Blow the trumpet in Zion, and sound an alarm in my holy mountain! Let all the inhabitants of the land tremble, for the day of the LORD comes, for it is close at hand:",
