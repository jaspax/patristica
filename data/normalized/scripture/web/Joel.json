    "work_id": "scripture/web/joel",
    "canonical_ref": "Joel.2.11",
    "language": "eng",
    "text": "The LORD thunders his voice before his army, for his forces are very great; for he is strong who obeys his command; for the day of the LORD is great and very awesome, and who can endure it?",
