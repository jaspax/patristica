    "work_id": "scripture/web/phlm",
    "canonical_ref": "Phlm.1.2",
    "language": "eng",
    "text": "to the beloved Apphia, to Archippus our fellow soldier, and to the assembly in your house:",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      60,
