    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.8",
    "language": "eng",
    "text": "We therefore ought to receive such, that we might be fellowhelpers to the truth.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
