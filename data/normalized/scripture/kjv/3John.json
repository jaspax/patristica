    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.9",
    "language": "eng",
    "text": "I wrote unto the church: but Diotrephes, who loveth to have the preeminence among them, receiveth us not.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
      100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
