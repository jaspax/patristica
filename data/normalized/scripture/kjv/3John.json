    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.3",
    "language": "eng",
    "text": "For I rejoiced greatly, when the brethren came and testified of the truth that is in thee, even as thou walkest in the truth.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
