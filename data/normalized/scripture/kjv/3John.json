    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.7",
    "language": "eng",
    "text": "Because that for his name’s sake they went forth, taking nothing of the Gentiles.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
      100
    ],
    "date_confidence": "approximate",
