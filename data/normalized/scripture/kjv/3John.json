    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.13",
    "language": "eng",
    "text": "I had many things to write, but I will not with ink and pen write unto thee:",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
