    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.4",
    "language": "eng",
    "text": "I have no greater joy than to hear that my children walk in truth.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
