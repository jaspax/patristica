    "work_id": "scripture/kjv/3john",
    "canonical_ref": "3John.1.5",
    "language": "eng",
    "text": "Beloved, thou doest faithfully whatsoever thou doest to the brethren, and to strangers;",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
