    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/asv/nah#Nah.2.3",
    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.2.3",
    "language": "eng",
    "text": "The shield of his mighty men is made red, the valiant men are in scarlet: the chariots flash with steel in the day of his preparation, and the cypress spears are brandished.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
      -612
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
