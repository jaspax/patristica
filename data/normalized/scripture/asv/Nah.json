    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.1.10",
    "language": "eng",
    "text": "For entangled like thorns, and drunken as with their drink, they are consumed utterly as dry stubble.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
      -612
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
