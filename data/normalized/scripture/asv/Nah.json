  {
    "chunk_id": "scripture/asv/nah#Nah.2.7",
    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.2.7",
    "language": "eng",
    "text": "And it is decreed: she is uncovered, she is carried away; and her handmaids moan as with the voice of doves, beating upon their breasts.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
