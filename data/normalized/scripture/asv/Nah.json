    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.3.2",
    "language": "eng",
    "text": "The noise of the whip, and the noise of the rattling of wheels, and prancing horses, and bounding chariots,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
