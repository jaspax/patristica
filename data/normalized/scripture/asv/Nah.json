    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.2.8",
    "language": "eng",
    "text": "But Nineveh hath been from of old like a pool of water: yet they flee away. Stand, stand, they cry; but none looketh back.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
