    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.3.9",
    "language": "eng",
    "text": "Ethiopia and Egypt were her strength, and it was infinite; Put and Lubim were thy helpers.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
      -612
    ],
