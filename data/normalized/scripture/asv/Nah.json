    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.2.1",
    "language": "eng",
    "text": "He that dasheth in pieces is come up against thee: keep the fortress, watch the way, make thy loins strong, fortify thy power mightily.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
