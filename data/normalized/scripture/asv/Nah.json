    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.1.11",
    "language": "eng",
    "text": "There is one gone forth out of thee, that deviseth evil against Jehovah, that counselleth wickedness.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
      -612
    ],
