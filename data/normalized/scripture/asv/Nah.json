    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.1.9",
    "language": "eng",
    "text": "What do ye devise against Jehovah? he will make a full end; affliction shall not rise up the second time.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
      -612
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
