    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.3.6",
    "language": "eng",
    "text": "And I will cast abominable filth upon thee, and make thee vile, and will set thee as a gazing-stock.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
