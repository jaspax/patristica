    "work_id": "scripture/asv/nah",
    "canonical_ref": "Nah.1.15",
    "language": "eng",
    "text": "Behold, upon the mountains the feet of him that bringeth good tidings, that publisheth peace! Keep thy feasts, O Judah, perform thy vows; for the wicked one shall no more pass through thee; he is utterly cut off.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": -620,
    "date_range": [
      -663,
      -612
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
