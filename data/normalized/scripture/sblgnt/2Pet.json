    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.3.10",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.10",
    "language": "grc",
    "text": "ἥξει δὲ ἡμέρα κυρίου ὡς κλέπτης, ἐν ᾗ οἱ οὐρανοὶ ῥοιζηδὸν παρελεύσονται, στοιχεῖα δὲ καυσούμενα λυθήσεται, καὶ γῆ καὶ τὰ ἐν αὐτῇ ἔργα εὑρεθήσεται.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
