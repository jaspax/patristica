[
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.1",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.1",
    "language": "grc",
    "text": "Συμεὼν Πέτρος δοῦλος καὶ ἀπόστολος Ἰησοῦ Χριστοῦ τοῖς ἰσότιμον ἡμῖν λαχοῦσιν πίστιν ἐν δικαιοσύνῃ τοῦ θεοῦ ἡμῶν καὶ σωτῆρος Ἰησοῦ Χριστοῦ·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.2",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.2",
    "language": "grc",
    "text": "χάρις ὑμῖν καὶ εἰρήνη πληθυνθείη ἐν ἐπιγνώσει τοῦ θεοῦ καὶ Ἰησοῦ τοῦ κυρίου ἡμῶν.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.3",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.3",
    "language": "grc",
    "text": "Ὡς πάντα ἡμῖν τῆς θείας δυνάμεως αὐτοῦ τὰ πρὸς ζωὴν καὶ εὐσέβειαν δεδωρημένης διὰ τῆς ἐπιγνώσεως τοῦ καλέσαντος ἡμᾶς ἰδίᾳ δόξῃ καὶ ἀρετῇ⸃,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.4",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.4",
    "language": "grc",
    "text": "διʼ ὧν τὰ τίμια καὶ μέγιστα ἡμῖν⸃ ἐπαγγέλματα δεδώρηται, ἵνα διὰ τούτων γένησθε θείας κοινωνοὶ φύσεως, ἀποφυγόντες τῆς ἐν τῷ κόσμῳ ἐν ἐπιθυμίᾳ φθορᾶς.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.5",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.5",
    "language": "grc",
    "text": "καὶ αὐτὸ τοῦτο δὲ σπουδὴν πᾶσαν παρεισενέγκαντες ἐπιχορηγήσατε ἐν τῇ πίστει ὑμῶν τὴν ἀρετήν, ἐν δὲ τῇ ἀρετῇ τὴν γνῶσιν,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.6",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.6",
    "language": "grc",
    "text": "ἐν δὲ τῇ γνώσει τὴν ἐγκράτειαν, ἐν δὲ τῇ ἐγκρατείᾳ τὴν ὑπομονήν, ἐν δὲ τῇ ὑπομονῇ τὴν εὐσέβειαν,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.7",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.7",
    "language": "grc",
    "text": "ἐν δὲ τῇ εὐσεβείᾳ τὴν φιλαδελφίαν, ἐν δὲ τῇ φιλαδελφίᾳ τὴν ἀγάπην·",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.8",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.8",
    "language": "grc",
    "text": "ταῦτα γὰρ ὑμῖν ὑπάρχοντα καὶ πλεονάζοντα οὐκ ἀργοὺς οὐδὲ ἀκάρπους καθίστησιν εἰς τὴν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ ἐπίγνωσιν·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.9",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.9",
    "language": "grc",
    "text": "ᾧ γὰρ μὴ πάρεστιν ταῦτα, τυφλός ἐστιν μυωπάζων, λήθην λαβὼν τοῦ καθαρισμοῦ τῶν πάλαι αὐτοῦ ἁμαρτημάτων.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.10",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.10",
    "language": "grc",
    "text": "διὸ μᾶλλον, ἀδελφοί, σπουδάσατε βεβαίαν ὑμῶν τὴν κλῆσιν καὶ ἐκλογὴν ποιεῖσθαι· ταῦτα γὰρ ποιοῦντες οὐ μὴ πταίσητέ ποτε·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.11",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.11",
    "language": "grc",
    "text": "οὕτως γὰρ πλουσίως ἐπιχορηγηθήσεται ὑμῖν ἡ εἴσοδος εἰς τὴν αἰώνιον βασιλείαν τοῦ κυρίου ἡμῶν καὶ σωτῆρος Ἰησοῦ Χριστοῦ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.12",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.12",
    "language": "grc",
    "text": "Διὸ μελλήσω ἀεὶ ὑμᾶς ὑπομιμνῄσκειν περὶ τούτων, καίπερ εἰδότας καὶ ἐστηριγμένους ἐν τῇ παρούσῃ ἀληθείᾳ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.13",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.13",
    "language": "grc",
    "text": "δίκαιον δὲ ἡγοῦμαι, ἐφʼ ὅσον εἰμὶ ἐν τούτῳ τῷ σκηνώματι, διεγείρειν ὑμᾶς ἐν ὑπομνήσει,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.14",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.14",
    "language": "grc",
    "text": "εἰδὼς ὅτι ταχινή ἐστιν ἡ ἀπόθεσις τοῦ σκηνώματός μου, καθὼς καὶ ὁ κύριος ἡμῶν Ἰησοῦς Χριστὸς ἐδήλωσέν μοι·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.15",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.15",
    "language": "grc",
    "text": "σπουδάσω δὲ καὶ ἑκάστοτε ἔχειν ὑμᾶς μετὰ τὴν ἐμὴν ἔξοδον τὴν τούτων μνήμην ποιεῖσθαι.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.16",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.16",
    "language": "grc",
    "text": "Οὐ γὰρ σεσοφισμένοις μύθοις ἐξακολουθήσαντες ἐγνωρίσαμεν ὑμῖν τὴν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ δύναμιν καὶ παρουσίαν, ἀλλʼ ἐπόπται γενηθέντες τῆς ἐκείνου μεγαλειότητος.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.17",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.17",
    "language": "grc",
    "text": "λαβὼν γὰρ παρὰ θεοῦ πατρὸς τιμὴν καὶ δόξαν φωνῆς ἐνεχθείσης αὐτῷ τοιᾶσδε ὑπὸ τῆς μεγαλοπρεποῦς δόξης· Ὁ υἱός μου ὁ ἀγαπητός μου οὗτός ἐστιν⸃, εἰς ὃν ἐγὼ εὐδόκησα—",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.18",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.18",
    "language": "grc",
    "text": "καὶ ταύτην τὴν φωνὴν ἡμεῖς ἠκούσαμεν ἐξ οὐρανοῦ ἐνεχθεῖσαν σὺν αὐτῷ ὄντες ἐν τῷ ἁγίῳ ὄρει⸃.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.19",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.19",
    "language": "grc",
    "text": "καὶ ἔχομεν βεβαιότερον τὸν προφητικὸν λόγον, ᾧ καλῶς ποιεῖτε προσέχοντες ὡς λύχνῳ φαίνοντι ἐν αὐχμηρῷ τόπῳ, ἕως οὗ ἡμέρα διαυγάσῃ καὶ φωσφόρος ἀνατείλῃ ἐν ταῖς καρδίαις ὑμῶν·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.20",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.20",
    "language": "grc",
    "text": "τοῦτο πρῶτον γινώσκοντες ὅτι πᾶσα προφητεία γραφῆς ἰδίας ἐπιλύσεως οὐ γίνεται,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.1.21",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.1.21",
    "language": "grc",
    "text": "οὐ γὰρ θελήματι ἀνθρώπου ἠνέχθη προφητεία ποτέ⸃, ἀλλὰ ὑπὸ πνεύματος ἁγίου φερόμενοι ἐλάλησαν ἀπὸ θεοῦ ἄνθρωποι.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.1",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.1",
    "language": "grc",
    "text": "Ἐγένοντο δὲ καὶ ψευδοπροφῆται ἐν τῷ λαῷ, ὡς καὶ ἐν ὑμῖν ἔσονται ψευδοδιδάσκαλοι, οἵτινες παρεισάξουσιν αἱρέσεις ἀπωλείας, καὶ τὸν ἀγοράσαντα αὐτοὺς δεσπότην ἀρνούμενοι, ἐπάγοντες ἑαυτοῖς ταχινὴν ἀπώλειαν·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.2",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.2",
    "language": "grc",
    "text": "καὶ πολλοὶ ἐξακολουθήσουσιν αὐτῶν ταῖς ἀσελγείαις, διʼ οὓς ἡ ὁδὸς τῆς ἀληθείας βλασφημηθήσεται·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.3",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.3",
    "language": "grc",
    "text": "καὶ ἐν πλεονεξίᾳ πλαστοῖς λόγοις ὑμᾶς ἐμπορεύσονται· οἷς τὸ κρίμα ἔκπαλαι οὐκ ἀργεῖ, καὶ ἡ ἀπώλεια αὐτῶν οὐ νυστάζει.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.4",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.4",
    "language": "grc",
    "text": "Εἰ γὰρ ὁ θεὸς ἀγγέλων ἁμαρτησάντων οὐκ ἐφείσατο, ἀλλὰ σειραῖς ζόφου ταρταρώσας παρέδωκεν εἰς κρίσιν τηρουμένους,",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.5",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.5",
    "language": "grc",
    "text": "καὶ ἀρχαίου κόσμου οὐκ ἐφείσατο, ἀλλὰ ὄγδοον Νῶε δικαιοσύνης κήρυκα ἐφύλαξεν, κατακλυσμὸν κόσμῳ ἀσεβῶν ἐπάξας,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.6",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.6",
    "language": "grc",
    "text": "καὶ πόλεις Σοδόμων καὶ Γομόρρας τεφρώσας καταστροφῇ κατέκρινεν, ὑπόδειγμα μελλόντων ἀσεβέσιν τεθεικώς,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.7",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.7",
    "language": "grc",
    "text": "καὶ δίκαιον Λὼτ καταπονούμενον ὑπὸ τῆς τῶν ἀθέσμων ἐν ἀσελγείᾳ ἀναστροφῆς ἐρρύσατο—",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.8",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.8",
    "language": "grc",
    "text": "βλέμματι γὰρ καὶ ἀκοῇ ὁ δίκαιος ἐγκατοικῶν ἐν αὐτοῖς ἡμέραν ἐξ ἡμέρας ψυχὴν δικαίαν ἀνόμοις ἔργοις ἐβασάνιζεν—",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.9",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.9",
    "language": "grc",
    "text": "οἶδεν κύριος εὐσεβεῖς ἐκ πειρασμοῦ ῥύεσθαι, ἀδίκους δὲ εἰς ἡμέραν κρίσεως κολαζομένους τηρεῖν,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.2.10",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.2.10",
    "language": "grc",
    "text": "μάλιστα δὲ τοὺς ὀπίσω σαρκὸς ἐν ἐπιθυμίᾳ μιασμοῦ πορευομένους καὶ κυριότητος καταφρονοῦντας. Τολμηταί, αὐθάδεις, δόξας οὐ τρέμουσιν, βλασφημοῦντες,",
