  {
    "chunk_id": "sblgnt/2pet#2Pet.3.13",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.13",
    "language": "grc",
    "text": "καινοὺς δὲ οὐρανοὺς καὶ γῆν καινὴν κατὰ τὸ ἐπάγγελμα αὐτοῦ προσδοκῶμεν, ἐν οἷς δικαιοσύνη κατοικεῖ.",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.3.14",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.14",
    "language": "grc",
    "text": "Διό, ἀγαπητοί, ταῦτα προσδοκῶντες σπουδάσατε ἄσπιλοι καὶ ἀμώμητοι αὐτῷ εὑρεθῆναι ἐν εἰρήνῃ,",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.3.15",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.15",
    "language": "grc",
    "text": "καὶ τὴν τοῦ κυρίου ἡμῶν μακροθυμίαν σωτηρίαν ἡγεῖσθε, καθὼς καὶ ὁ ἀγαπητὸς ἡμῶν ἀδελφὸς Παῦλος κατὰ τὴν δοθεῖσαν αὐτῷ⸃ σοφίαν ἔγραψεν ὑμῖν,",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.3.16",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.16",
    "language": "grc",
    "text": "ὡς καὶ ἐν πάσαις ταῖς ἐπιστολαῖς λαλῶν ἐν αὐταῖς περὶ τούτων, ἐν αἷς ἐστιν δυσνόητά τινα, ἃ οἱ ἀμαθεῖς καὶ ἀστήρικτοι στρεβλοῦσιν ὡς καὶ τὰς λοιπὰς γραφὰς πρὸς τὴν ἰδίαν αὐτῶν ἀπώλειαν.",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
      120
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.3.17",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.17",
    "language": "grc",
    "text": "ὑμεῖς οὖν, ἀγαπητοί, προγινώσκοντες φυλάσσεσθε ἵνα μὴ τῇ τῶν ἀθέσμων πλάνῃ συναπαχθέντες ἐκπέσητε τοῦ ἰδίου στηριγμοῦ,",
    "chunk_index": 59,
