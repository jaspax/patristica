  },
  {
    "chunk_id": "sblgnt/2pet#2Pet.3.9",
    "work_id": "sblgnt/2pet",
    "canonical_ref": "2Pet.3.9",
    "language": "grc",
    "text": "οὐ βραδύνει κύριος τῆς ἐπαγγελίας, ὥς τινες βραδύτητα ἡγοῦνται, ἀλλὰ μακροθυμεῖ εἰς ὑμᾶς, μὴ βουλόμενός τινας ἀπολέσθαι ἀλλὰ πάντας εἰς μετάνοιαν χωρῆσαι.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": 100,
    "date_range": [
      80,
