    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.22",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.22",
    "language": "grc",
    "text": "νυνὶ δὲ ἀποκατηλλάγητε ἐν τῷ σώματι τῆς σαρκὸς αὐτοῦ διὰ τοῦ θανάτου— παραστῆσαι ὑμᾶς ἁγίους καὶ ἀμώμους καὶ ἀνεγκλήτους κατενώπιον αὐτοῦ,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.23",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.23",
    "language": "grc",
    "text": "εἴ γε ἐπιμένετε τῇ πίστει τεθεμελιωμένοι καὶ ἑδραῖοι καὶ μὴ μετακινούμενοι ἀπὸ τῆς ἐλπίδος τοῦ εὐαγγελίου οὗ ἠκούσατε, τοῦ κηρυχθέντος ἐν πάσῃ κτίσει τῇ ὑπὸ τὸν οὐρανόν, οὗ ἐγενόμην ἐγὼ Παῦλος διάκονος.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.24",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.24",
    "language": "grc",
    "text": "Νῦν χαίρω ἐν τοῖς παθήμασιν ὑπὲρ ὑμῶν, καὶ ἀνταναπληρῶ τὰ ὑστερήματα τῶν θλίψεων τοῦ Χριστοῦ ἐν τῇ σαρκί μου ὑπὲρ τοῦ σώματος αὐτοῦ, ὅ ἐστιν ἡ ἐκκλησία,",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.25",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.25",
    "language": "grc",
    "text": "ἧς ἐγενόμην ἐγὼ διάκονος κατὰ τὴν οἰκονομίαν τοῦ θεοῦ τὴν δοθεῖσάν μοι εἰς ὑμᾶς πληρῶσαι τὸν λόγον τοῦ θεοῦ,",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.26",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.26",
    "language": "grc",
    "text": "τὸ μυστήριον τὸ ἀποκεκρυμμένον ἀπὸ τῶν αἰώνων καὶ ἀπὸ τῶν γενεῶν,— νῦν δὲ ἐφανερώθη τοῖς ἁγίοις αὐτοῦ,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.27",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.27",
    "language": "grc",
    "text": "οἷς ἠθέλησεν ὁ θεὸς γνωρίσαι τί τὸ πλοῦτος τῆς δόξης τοῦ μυστηρίου τούτου ἐν τοῖς ἔθνεσιν, ὅ ἐστιν Χριστὸς ἐν ὑμῖν, ἡ ἐλπὶς τῆς δόξης·",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.28",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.28",
    "language": "grc",
    "text": "ὃν ἡμεῖς καταγγέλλομεν νουθετοῦντες πάντα ἄνθρωπον καὶ διδάσκοντες πάντα ἄνθρωπον ἐν πάσῃ σοφίᾳ, ἵνα παραστήσωμεν πάντα ἄνθρωπον τέλειον ἐν Χριστῷ·",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.29",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.29",
    "language": "grc",
    "text": "εἰς ὃ καὶ κοπιῶ ἀγωνιζόμενος κατὰ τὴν ἐνέργειαν αὐτοῦ τὴν ἐνεργουμένην ἐν ἐμοὶ ἐν δυνάμει.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.2.1",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.2.1",
    "language": "grc",
    "text": "Θέλω γὰρ ὑμᾶς εἰδέναι ἡλίκον ἀγῶνα ἔχω ὑπὲρ ὑμῶν καὶ τῶν ἐν Λαοδικείᾳ καὶ ὅσοι οὐχ ἑόρακαν τὸ πρόσωπόν μου ἐν σαρκί,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.2.2",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.2.2",
    "language": "grc",
    "text": "ἵνα παρακληθῶσιν αἱ καρδίαι αὐτῶν, συμβιβασθέντες ἐν ἀγάπῃ καὶ εἰς πᾶν πλοῦτος⸃ τῆς πληροφορίας τῆς συνέσεως, εἰς ἐπίγνωσιν τοῦ μυστηρίου τοῦ θεοῦ, Χριστοῦ,",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
