    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.3.7",
    "language": "grc",
    "text": "ἐν οἷς καὶ ὑμεῖς περιεπατήσατέ ποτε ὅτε ἐζῆτε ἐν τούτοις·",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
