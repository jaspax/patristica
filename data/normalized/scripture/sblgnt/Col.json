    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.2.4",
    "language": "grc",
    "text": "τοῦτο λέγω ἵνα μηδεὶς ὑμᾶς παραλογίζηται ἐν πιθανολογίᾳ.",
