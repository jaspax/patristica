    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.19",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.19",
    "language": "grc",
    "text": "ὅτι ἐν αὐτῷ εὐδόκησεν πᾶν τὸ πλήρωμα κατοικῆσαι",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.20",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.20",
    "language": "grc",
    "text": "καὶ διʼ αὐτοῦ ἀποκαταλλάξαι τὰ πάντα εἰς αὐτόν, εἰρηνοποιήσας διὰ τοῦ αἵματος τοῦ σταυροῦ αὐτοῦ, διʼ αὐτοῦ]⸃ εἴτε τὰ ἐπὶ τῆς γῆς εἴτε τὰ ἐν τοῖς οὐρανοῖς·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.21",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.21",
    "language": "grc",
    "text": "καὶ ὑμᾶς ποτε ὄντας ἀπηλλοτριωμένους καὶ ἐχθροὺς τῇ διανοίᾳ ἐν τοῖς ἔργοις τοῖς πονηροῖς—",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
