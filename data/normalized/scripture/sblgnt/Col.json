    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.3.18",
    "language": "grc",
    "text": "Αἱ γυναῖκες, ὑποτάσσεσθε τοῖς ἀνδράσιν, ὡς ἀνῆκεν ἐν κυρίῳ.",
