    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.3",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.3",
    "language": "grc",
    "text": "Εὐχαριστοῦμεν τῷ θεῷ πατρὶ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ πάντοτε περὶ ὑμῶν προσευχόμενοι,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.4",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.4",
    "language": "grc",
    "text": "ἀκούσαντες τὴν πίστιν ὑμῶν ἐν Χριστῷ Ἰησοῦ καὶ τὴν ἀγάπην ἣν ἔχετε⸃ εἰς πάντας τοὺς ἁγίους",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.5",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.5",
    "language": "grc",
    "text": "διὰ τὴν ἐλπίδα τὴν ἀποκειμένην ὑμῖν ἐν τοῖς οὐρανοῖς, ἣν προηκούσατε ἐν τῷ λόγῳ τῆς ἀληθείας τοῦ εὐαγγελίου",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.6",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.6",
    "language": "grc",
    "text": "τοῦ παρόντος εἰς ὑμᾶς, καθὼς καὶ ἐν παντὶ τῷ κόσμῳ ἐστὶν καρποφορούμενον καὶ αὐξανόμενον καθὼς καὶ ἐν ὑμῖν, ἀφʼ ἧς ἡμέρας ἠκούσατε καὶ ἐπέγνωτε τὴν χάριν τοῦ θεοῦ ἐν ἀληθείᾳ·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.7",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.7",
    "language": "grc",
    "text": "καθὼς ἐμάθετε ἀπὸ Ἐπαφρᾶ τοῦ ἀγαπητοῦ συνδούλου ἡμῶν, ὅς ἐστιν πιστὸς ὑπὲρ ἡμῶν διάκονος τοῦ Χριστοῦ,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.8",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.8",
    "language": "grc",
    "text": "ὁ καὶ δηλώσας ἡμῖν τὴν ὑμῶν ἀγάπην ἐν πνεύματι.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.9",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.9",
    "language": "grc",
    "text": "Διὰ τοῦτο καὶ ἡμεῖς, ἀφʼ ἧς ἡμέρας ἠκούσαμεν, οὐ παυόμεθα ὑπὲρ ὑμῶν προσευχόμενοι καὶ αἰτούμενοι ἵνα πληρωθῆτε τὴν ἐπίγνωσιν τοῦ θελήματος αὐτοῦ ἐν πάσῃ σοφίᾳ καὶ συνέσει πνευματικῇ,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.10",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.10",
    "language": "grc",
    "text": "περιπατῆσαι ἀξίως τοῦ κυρίου εἰς πᾶσαν ἀρεσκείαν ἐν παντὶ ἔργῳ ἀγαθῷ καρποφοροῦντες καὶ αὐξανόμενοι τῇ ἐπιγνώσει⸃ τοῦ θεοῦ,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.11",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.11",
    "language": "grc",
    "text": "ἐν πάσῃ δυνάμει δυναμούμενοι κατὰ τὸ κράτος τῆς δόξης αὐτοῦ εἰς πᾶσαν ὑπομονὴν καὶ μακροθυμίαν μετὰ χαρᾶς,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.12",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.12",
    "language": "grc",
    "text": "εὐχαριστοῦντες τῷ πατρὶ τῷ ἱκανώσαντι ὑμᾶς εἰς τὴν μερίδα τοῦ κλήρου τῶν ἁγίων ἐν τῷ φωτί,",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.13",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.13",
    "language": "grc",
    "text": "ὃς ἐρρύσατο ἡμᾶς ἐκ τῆς ἐξουσίας τοῦ σκότους καὶ μετέστησεν εἰς τὴν βασιλείαν τοῦ υἱοῦ τῆς ἀγάπης αὐτοῦ,",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.14",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.14",
    "language": "grc",
    "text": "ἐν ᾧ ἔχομεν τὴν ἀπολύτρωσιν, τὴν ἄφεσιν τῶν ἁμαρτιῶν·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.15",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.15",
    "language": "grc",
    "text": "ὅς ἐστιν εἰκὼν τοῦ θεοῦ τοῦ ἀοράτου, πρωτότοκος πάσης κτίσεως,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.16",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.16",
    "language": "grc",
    "text": "ὅτι ἐν αὐτῷ ἐκτίσθη τὰ πάντα ἐν τοῖς οὐρανοῖς καὶ ἐπὶ τῆς γῆς, τὰ ὁρατὰ καὶ τὰ ἀόρατα, εἴτε θρόνοι εἴτε κυριότητες εἴτε ἀρχαὶ εἴτε ἐξουσίαι· τὰ πάντα διʼ αὐτοῦ καὶ εἰς αὐτὸν ἔκτισται·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.17",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.17",
    "language": "grc",
    "text": "καὶ αὐτός ἐστιν πρὸ πάντων καὶ τὰ πάντα ἐν αὐτῷ συνέστηκεν,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/col#Col.1.18",
    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.1.18",
    "language": "grc",
    "text": "καὶ αὐτός ἐστιν ἡ κεφαλὴ τοῦ σώματος τῆς ἐκκλησίας· ὅς ἐστιν ἀρχή, πρωτότοκος ἐκ τῶν νεκρῶν, ἵνα γένηται ἐν πᾶσιν αὐτὸς πρωτεύων,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 62,
    "date_range": [
      58,
      80
    ],
    "date_confidence": "uncertain",
