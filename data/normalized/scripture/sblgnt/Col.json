    "work_id": "scripture/sblgnt/col",
    "canonical_ref": "Col.2.17",
    "language": "grc",
    "text": "ἅ ἐστιν σκιὰ τῶν μελλόντων, τὸ δὲ σῶμα τοῦ Χριστοῦ.",
