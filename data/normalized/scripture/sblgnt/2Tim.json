[
  {
    "chunk_id": "scripture/sblgnt/2tim#2Tim.1.1",
    "work_id": "scripture/sblgnt/2tim",
    "canonical_ref": "2Tim.1.1",
    "language": "grc",
    "text": "Παῦλος ἀπόστολος Χριστοῦ Ἰησοῦ⸃ διὰ θελήματος θεοῦ κατʼ ἐπαγγελίαν ζωῆς τῆς ἐν Χριστῷ Ἰησοῦ",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 65,
    "date_range": [
