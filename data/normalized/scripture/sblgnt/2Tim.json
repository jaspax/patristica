  },
  {
    "chunk_id": "scripture/sblgnt/2tim#2Tim.2.13",
    "work_id": "scripture/sblgnt/2tim",
    "canonical_ref": "2Tim.2.13",
    "language": "grc",
    "text": "εἰ ἀπιστοῦμεν, ἐκεῖνος πιστὸς μένει· ἀρνήσασθαι ἑαυτὸν οὐ δύναται.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
