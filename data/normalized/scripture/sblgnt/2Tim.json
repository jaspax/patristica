    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/2tim#2Tim.2.5",
    "work_id": "scripture/sblgnt/2tim",
    "canonical_ref": "2Tim.2.5",
    "language": "grc",
    "text": "ἐὰν δὲ καὶ ἀθλῇ τις, οὐ στεφανοῦται ἐὰν μὴ νομίμως ἀθλήσῃ·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 65,
    "date_range": [
      60,
      100
    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/2tim#2Tim.2.6",
    "work_id": "scripture/sblgnt/2tim",
    "canonical_ref": "2Tim.2.6",
    "language": "grc",
    "text": "τὸν κοπιῶντα γεωργὸν δεῖ πρῶτον τῶν καρπῶν μεταλαμβάνειν.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 65,
    "date_range": [
      60,
