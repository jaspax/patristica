    "work_id": "scripture/sblgnt/2tim",
    "canonical_ref": "2Tim.3.12",
    "language": "grc",
    "text": "καὶ πάντες δὲ οἱ θέλοντες ζῆν εὐσεβῶς⸃ ἐν Χριστῷ Ἰησοῦ διωχθήσονται·",
    "chunk_index": 55,
