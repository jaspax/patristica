    ],
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/2tim#2Tim.2.12",
    "work_id": "scripture/sblgnt/2tim",
    "canonical_ref": "2Tim.2.12",
    "language": "grc",
    "text": "εἰ ὑπομένομεν, καὶ συμβασιλεύσομεν· εἰ ἀρνησόμεθα, κἀκεῖνος ἀρνήσεται ἡμᾶς·",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 65,
    "date_range": [
      60,
