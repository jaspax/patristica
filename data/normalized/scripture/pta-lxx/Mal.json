  },
  {
    "chunk_id": "scripture/pta-lxx/mal#Mal.2.1",
    "work_id": "scripture/pta-lxx/mal",
    "canonical_ref": "Mal.2.1",
    "language": "grc",
    "text": "Καὶ νῦν ἡ ἐντολὴ αὕτη πρὸς ὑμᾶς, οἱ ἱερεῖς·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
