  },
  {
    "chunk_id": "scripture/pta-lxx/mal#Mal.1.13",
    "work_id": "scripture/pta-lxx/mal",
    "canonical_ref": "Mal.1.13",
    "language": "grc",
    "text": "καὶ εἴπατε Ταῦτα ἐκ κακοπαθείας ἐστίν, καὶ ἐξεφύσησα αὐτὰ λέγει κύριος παντοκράτωρ· καὶ εἰσεφέρετε ἁρπάγματα καὶ τὰ χωλὰ καὶ τὰ ἐνοχλούμενα· καὶ ἐὰν φέρητε τὴν θυσίαν, εἰ προσδέξομαι αὐτὰ ἐκ τῶν χειρῶν ὑμῶν; λέγει κύριος παντοκράτωρ.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": -450,
    "date_range": [
      -500,
