    "work_id": "scripture/pta-lxx/mal",
    "canonical_ref": "Mal.2.12",
    "language": "grc",
    "text": "ἐξολεθρεύσει κύριος τὸν ἄνθρωπον τὸν ποιοῦντα ταῦτα, ἕως καὶ ταπεινωθῇ ἐκ σκηνωμάτων Ιακωβ καὶ ἐκ προσαγόντων θυσίαν τῷ κυρίῳ παντοκράτορι.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
