    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/mal#Mal.1.4",
    "work_id": "scripture/pta-lxx/mal",
    "canonical_ref": "Mal.1.4",
    "language": "grc",
    "text": "διότι ἐρεῖ ἡ Ιδουμαία Κατέστραπται, καὶ ἐπιστρέψωμεν καὶ ἀνοικοδομήσωμεν τὰς ἐρήμους· τάδε λέγει κύριος παντοκράτωρ Αὐτοὶ οἰκοδομήσουσιν, καὶ ἐγὼ καταστρέψω· καὶ ἐπικληθήσεται αὐτοῖς ὅρια ἀνομίας καὶ λαὸς ἐφ’ ὃν παρατέτακται κύριος ἕως αἰῶνος.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": -450,
    "date_range": [
      -500,
      -400
    ],
    "date_confidence": "approximate",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/mal#Mal.1.5",
    "work_id": "scripture/pta-lxx/mal",
    "canonical_ref": "Mal.1.5",
    "language": "grc",
    "text": "καὶ οἱ ὀφθαλμοὶ ὑμῶν ὄψονται, καὶ ὑμεῖς ἐρεῖτε Ἐμεγαλύνθη κύριος ὑπεράνω τῶν ὁρίων τοῦ Ισραηλ.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": -450,
    "date_range": [
      -500,
