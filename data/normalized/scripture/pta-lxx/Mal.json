    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/mal#Mal.1.14",
    "work_id": "scripture/pta-lxx/mal",
    "canonical_ref": "Mal.1.14",
    "language": "grc",
    "text": "καὶ ἐπικατάρατος ὃς ἦν δυνατὸς καὶ ὑπῆρχεν ἐν τῷ ποιμνίῳ αὐτοῦ ἄρσεν καὶ εὐχὴ αὐτοῦ ἐπ’ αὐτῷ καὶ θύει διεφθαρμένον τῷ κυρίῳ· διότι βασιλεὺς μέγας ἐγώ εἰμι, λέγει κύριος παντοκράτωρ, καὶ τὸ ὄνομά μου ἐπιφανὲς ἐν τοῖς ἔθνεσιν.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": -450,
    "date_range": [
