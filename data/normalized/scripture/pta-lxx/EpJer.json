[
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.1",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.1",
    "language": "grc",
    "text": "Διὰ τὰς ἁμαρτίας, ἃς ἡμαρτήκατε ἐναντίον τοῦ θεοῦ, ἀχθήσεσθε εἰς Βαβυλῶνα αἰχμάλωτοι ὑπὸ Ναβουχοδονοσορ βασιλέως τῶν Βαβυλωνίων.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.2",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.2",
    "language": "grc",
    "text": "εἰσελθόντες οὖν εἰς Βαβυλῶνα ἔσεσθε ἐκεῖ ἔτη πλείονα καὶ χρόνον μακρὸν ἕως γενεῶν ἑπτά, μετὰ τοῦτο δὲ ἐξάξω ὑμᾶς ἐκεῖθεν μετ’ εἰρήνης.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.3",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.3",
    "language": "grc",
    "text": "νυνὶ δὲ ὄψεσθε ἐν Βαβυλῶνι θεοὺς ἀργυροῦς καὶ χρυσοῦς καὶ ξυλίνους ἐπ’ ὤμοις αἰρομένους δεικνύντας φόβον τοῖς ἔθνεσιν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.4",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.4",
    "language": "grc",
    "text": "εὐλαβήθητε οὖν μὴ καὶ ὑμεῖς ἀφομοιωθέντες τοῖς ἀλλοφύλοις ἀφομοιωθῆτε καὶ φόβος ὑμᾶς λάβῃ ἐπ’ αὐτοῖς",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.5",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.5",
    "language": "grc",
    "text": "ἰδόντας ὄχλον ἔμπροσθεν καὶ ὄπισθεν αὐτῶν προσκυνοῦντας αὐτά, εἴπατε δὲ τῇ διανοίᾳ Σοὶ δεῖ προσκυνεῖν, δέσποτα.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.6",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.6",
    "language": "grc",
    "text": "ὁ γὰρ ἄγγελός μου μεθ’ ὑμῶν ἐστιν, αὐτός τε ἐκζητῶν τὰς ψυχὰς ὑμῶν.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.7",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.7",
    "language": "grc",
    "text": "Γλῶσσα γὰρ αὐτῶν ἐστιν κατεξυσμένη ὑπὸ τέκτονος, αὐτά τε περίχρυσα καὶ περιάργυρα, ψευδῆ δ’ ἐστὶν καὶ οὐ δύνανται λαλεῖν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.8",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.8",
    "language": "grc",
    "text": "καὶ ὥσπερ παρθένῳ φιλοκόσμῳ λαμβάνοντες χρυσίον κατασκευάζουσιν στεφάνους ἐπὶ τὰς κεφαλὰς τῶν θεῶν αὐτῶν·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.9",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.9",
    "language": "grc",
    "text": "ἔστι δὲ καὶ ὅτε ὑφαιρούμενοι οἱ ἱερεῖς ἀπὸ τῶν θεῶν αὐτῶν χρυσίον καὶ ἀργύριον εἰς ἑαυτοὺς καταναλώσουσιν, δώσουσιν δὲ ἀπ’ αὐτῶν καὶ ταῖς ἐπὶ τοῦ τέγους πόρναις.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.10",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.10",
    "language": "grc",
    "text": "κοσμοῦσί τε αὐτοὺς ὡς ἀνθρώπους τοῖς ἐνδύμασιν, θεοὺς ἀργυροῦς καὶ χρυσοῦς καὶ ξυλίνους· οὗτοι δὲ οὐ διασῴζονται ἀπὸ ἰοῦ καὶ βρωμάτων.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.11",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.11",
    "language": "grc",
    "text": "περιβεβλημένων αὐτῶν ἱματισμὸν πορφυροῦν, ἐκμάσσονται τὸ πρόσωπον αὐτῶν διὰ τὸν ἐκ τῆς οἰκίας κονιορτόν, ὅς ἐστιν πλείων ἐπ’ αὐτοῖς.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.12",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.12",
    "language": "grc",
    "text": "καὶ σκῆπτρον ἔχει ὡς ἄνθρωπος κριτὴς χώρας, ὃς τὸν εἰς αὐτὸν ἁμαρτάνοντα οὐκ ἀνελεῖ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.13",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.13",
    "language": "grc",
    "text": "ἔχει δὲ ἐγχειρίδιον ἐν δεξιᾷ καὶ πέλεκυν, ἑαυτὸν δὲ ἐκ πολέμου καὶ λῃστῶν οὐκ ἐξελεῖται.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.14",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.14",
    "language": "grc",
    "text": "ὅθεν γνώριμοί εἰσιν οὐκ ὄντες θεοί· μὴ οὖν φοβηθῆτε αὐτούς.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.15",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.15",
    "language": "grc",
    "text": "Ὥσπερ γὰρ σκεῦος ἀνθρώπου συντριβὲν ἀχρεῖον γίνεται, τοιοῦτοι ὑπάρχουσιν οἱ θεοὶ αὐτῶν, καθιδρυμένων αὐτῶν ἐν τοῖς οἴκοις.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.16",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.16",
    "language": "grc",
    "text": "οἱ ὀφθαλμοὶ αὐτῶν πλήρεις εἰσὶν κονιορτοῦ ἀπὸ τῶν ποδῶν τῶν εἰσπορευομένων.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.17",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.17",
    "language": "grc",
    "text": "καὶ ὥσπερ τινὶ ἠδικηκότι βασιλέα περιπεφραγμέναι εἰσὶν αἱ αὐλαὶ ὡς ἐπὶ θανάτῳ ἀπηγμένῳ, τοὺς οἴκους αὐτῶν ὀχυροῦσιν οἱ ἱερεῖς θυρώμασίν τε καὶ κλείθροις καὶ μοχλοῖς, ὅπως ὑπὸ τῶν λῃστῶν μὴ συληθῶσι.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.18",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.18",
    "language": "grc",
    "text": "λύχνους καίουσιν καὶ πλείους ἢ ἑαυτοῖς, ὧν οὐδένα δύνανται ἰδεῖν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.19",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.19",
    "language": "grc",
    "text": "ἔστιν μὲν ὥσπερ δοκὸς τῶν ἐκ τῆς οἰκίας, τὰς δὲ καρδίας αὐτῶν φασιν ἐκλείχεσθαι, τῶν ἀπὸ τῆς γῆς ἑρπετῶν κατεσθόντων αὐτούς τε καὶ τὸν ἱματισμὸν αὐτῶν οὐκ αἰσθάνονται.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.20",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.20",
    "language": "grc",
    "text": "μεμελανωμένοι τὸ πρόσωπον αὐτῶν ἀπὸ τοῦ καπνοῦ τοῦ ἐκ τῆς οἰκίας.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.21",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.21",
    "language": "grc",
    "text": "ἐπὶ τὸ σῶμα αὐτῶν καὶ ἐπὶ τὴν κεφαλὴν ἐφίπτανται νυκτερίδες, χελιδόνες καὶ τὰ ὄρνεα, ὡσαύτως δὲ καὶ οἱ αἴλουροι.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.22",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.22",
    "language": "grc",
    "text": "ὅθεν γνώσεσθε ὅτι οὔκ εἰσιν θεοί· μὴ οὖν φοβεῖσθε αὐτά.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.23",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.23",
    "language": "grc",
    "text": "Τὸ γὰρ χρυσίον, ὃ περίκεινται εἰς κάλλος, ἐὰν μή τις ἐκμάξῃ τὸν ἰόν, οὐ μὴ στίλψωσιν· οὐδὲ γάρ, ὅτε ἐχωνεύοντο, ᾐσθάνοντο.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.24",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.24",
    "language": "grc",
    "text": "ἐκ πάσης τιμῆς ἠγορασμένα ἐστίν, ἐν οἷς οὐκ ἔστιν πνεῦμα.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.25",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.25",
    "language": "grc",
    "text": "ἄνευ ποδῶν ἐπ’ ὤμοις φέρονται ἐνδεικνύμενοι τὴν ἑαυτῶν ἀτιμίαν τοῖς ἀνθρώποις, αἰσχύνονταί τε καὶ οἱ θεραπεύοντες αὐτὰ διὰ τό, μήποτε ἐπὶ τὴν γῆν πέσῃ, δι’ αὐτῶν ἀνίστασθαι·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.26",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.26",
    "language": "grc",
    "text": "μήτε ἐάν τις αὐτὸ ὀρθὸν στήσῃ, δι’ ἑαυτοῦ κινηθήσεται, μήτε ἐὰν κλιθῇ, οὐ μὴ ὀρθωθῇ, ἀλλ’ ὥσπερ νεκροῖς τὰ δῶρα αὐτοῖς παρατίθεται.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.27",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.27",
    "language": "grc",
    "text": "τὰς δὲ θυσίας αὐτῶν ἀποδόμενοι οἱ ἱερεῖς αὐτῶν καταχρῶνται· ὡσαύτως δὲ καὶ αἱ γυναῖκες αὐτῶν ἀπ’ αὐτῶν ταριχεύουσαι οὔτε πτωχῷ οὔτε ἀδυνάτῳ μεταδιδόασιν· τῶν θυσιῶν αὐτῶν ἀποκαθημένη καὶ λεχὼ ἅπτονται.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.28",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.28",
    "language": "grc",
    "text": "γνόντες οὖν ἀπὸ τούτων ὅτι οὔκ εἰσιν θεοί, μὴ φοβηθῆτε αὐτούς.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.29",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.29",
    "language": "grc",
    "text": "Πόθεν γὰρ κληθείησαν θεοί; ὅτι γυναῖκες παρατιθέασιν θεοῖς ἀργυροῖς καὶ χρυσοῖς καὶ ξυλίνοις·",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.30",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.30",
    "language": "grc",
    "text": "καὶ ἐν τοῖς οἴκοις αὐτῶν οἱ ἱερεῖς διφρεύουσιν ἔχοντες τοὺς χιτῶνας διερρωγότας καὶ τὰς κεφαλὰς καὶ τοὺς πώγωνας ἐξυρημένους, ὧν αἱ κεφαλαὶ ἀκάλυπτοί εἰσιν,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.31",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.31",
    "language": "grc",
    "text": "ὠρύονται δὲ βοῶντες ἐναντίον τῶν θεῶν αὐτῶν ὥσπερ τινὲς ἐν περιδείπνῳ νεκροῦ.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.32",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.32",
    "language": "grc",
    "text": "ἀπὸ τοῦ ἱματισμοῦ αὐτῶν ἀφελόμενοι οἱ ἱερεῖς ἐνδύουσιν τὰς γυναῖκας αὐτῶν καὶ τὰ παιδία.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.33",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.33",
    "language": "grc",
    "text": "οὔτε ἐὰν κακὸν πάθωσιν ὑπό τινος οὔτε ἐὰν ἀγαθόν, δυνήσονται ἀνταποδοῦναι· οὔτε καταστῆσαι βασιλέα δύνανται οὔτε ἀφελέσθαι.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.34",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.34",
    "language": "grc",
    "text": "ὡσαύτως οὔτε πλοῦτον οὔτε χαλκὸν οὐ μὴ δύνωνται διδόναι· ἐάν τις αὐτοῖς εὐχὴν εὐξάμενος μὴ ἀποδῷ, οὐ μὴ ἐπιζητήσωσιν.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.35",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.35",
    "language": "grc",
    "text": "ἐκ θανάτου ἄνθρωπον οὐ μὴ ῥύσωνται οὔτε ἥττονα ἀπὸ ἰσχυροῦ οὐ μὴ ἐξέλωνται.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.36",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.36",
    "language": "grc",
    "text": "ἄνθρωπον τυφλὸν εἰς ὅρασιν οὐ μὴ περιστήσωσιν, ἐν ἀνάγκῃ ἄνθρωπον ὄντα οὐ μὴ ἐξέλωνται.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.37",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.37",
    "language": "grc",
    "text": "χήραν οὐ μὴ ἐλεήσωσιν οὔτε ὀρφανὸν εὖ ποιήσουσιν.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.38",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.38",
    "language": "grc",
    "text": "τοῖς ἀπὸ τοῦ ὄρους λίθοις ὡμοιωμένοι εἰσὶν τὰ ξύλινα καὶ τὰ περίχρυσα καὶ τὰ περιάργυρα, οἱ δὲ θεραπεύοντες αὐτὰ καταισχυνθήσονται.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.39",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.39",
    "language": "grc",
    "text": "πῶς οὖν νομιστέον ἢ κλητέον αὐτοὺς ὑπάρχειν θεούς;",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.40",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.40",
    "language": "grc",
    "text": "Ἔτι δὲ καὶ αὐτῶν τῶν Χαλδαίων ἀτιμαζόντων αὐτά, οἵ, ὅταν ἴδωσιν ἐνεὸν οὐ δυνάμενον λαλῆσαι, προσενεγκάμενοι τὸν Βῆλον ἀξιοῦσιν φωνῆσαι, ὡς δυνατοῦ ὄντος αὐτοῦ αἰσθέσθαι,",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.41",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.41",
    "language": "grc",
    "text": "καὶ οὐ δύνανται αὐτοὶ νοήσαντες καταλιπεῖν αὐτά, αἴσθησιν γὰρ οὐκ ἔχουσιν.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.42",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.42",
    "language": "grc",
    "text": "αἱ δὲ γυναῖκες περιθέμεναι σχοινία ἐν ταῖς ὁδοῖς ἐγκάθηνται θυμιῶσαι τὰ πίτυρα·",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.43",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.43",
    "language": "grc",
    "text": "ὅταν δέ τις αὐτῶν ἐφελκυσθεῖσα ὑπό τινος τῶν παραπορευομένων κοιμηθῇ, τὴν πλησίον ὀνειδίζει, ὅτι οὐκ ἠξίωται ὥσπερ καὶ αὐτὴ οὔτε τὸ σχοινίον αὐτῆς διερράγη.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.44",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.44",
    "language": "grc",
    "text": "πάντα τὰ γινόμενα αὐτοῖς ἐστιν ψευδῆ· πῶς οὖν νομιστέον ἢ κλητέον ὥστε θεοὺς αὐτοὺς ὑπάρχειν;",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.45",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.45",
    "language": "grc",
    "text": "Ὑπὸ τεκτόνων καὶ χρυσοχόων κατεσκευασμένα εἰσίν· οὐθὲν ἄλλο μὴ γένωνται ἢ ὃ βούλονται οἱ τεχνῖται αὐτὰ γενέσθαι.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.46",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.46",
    "language": "grc",
    "text": "αὐτοί τε οἱ κατασκευάζοντες αὐτὰ οὐ μὴ γένωνται πολυχρόνιοι· πῶς τε δὴ μέλλει τὰ ὑπ’ αὐτῶν κατασκευασθέντα εἶναι θεοί;",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.47",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.47",
    "language": "grc",
    "text": "κατέλιπον γὰρ ψεύδη καὶ ὄνειδος τοῖς ἐπιγινομένοις.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.48",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.48",
    "language": "grc",
    "text": "ὅταν γὰρ ἐπέλθῃ ἐπ’ αὐτὰ πόλεμος καὶ κακά, βουλεύονται πρὸς ἑαυτοὺς οἱ ἱερεῖς ποῦ συναποκρυβῶσι μετ’ αὐτῶν.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.49",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.49",
    "language": "grc",
    "text": "πῶς οὖν οὐκ ἔστιν αἰσθέσθαι ὅτι οὔκ εἰσιν θεοί, οἳ οὔτε σῴζουσιν ἑαυτοὺς ἐκ πολέμου οὔτε ἐκ κακῶν;",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.50",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.50",
    "language": "grc",
    "text": "ὑπάρχοντα γὰρ ξύλινα καὶ περίχρυσα καὶ περιάργυρα γνωσθήσεται μετὰ ταῦτα ὅτι ἐστὶν ψευδῆ· τοῖς ἔθνεσι πᾶσι τοῖς τε βασιλεῦσι φανερὸν ἔσται ὅτι οὔκ εἰσι θεοὶ ἀλλὰ ἔργα χειρῶν ἀνθρώπων, καὶ οὐδὲν θεοῦ ἔργον ἐν αὐτοῖς ἐστιν.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.51",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.51",
    "language": "grc",
    "text": "τίνι οὖν γνωστέον ἐστὶν ὅτι οὔκ εἰσιν θεοί;",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.52",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.52",
    "language": "grc",
    "text": "Βασιλέα γὰρ χώρας οὐ μὴ ἀναστήσωσιν οὔτε ὑετὸν ἀνθρώποις οὐ μὴ δῶσιν",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.53",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.53",
    "language": "grc",
    "text": "κρίσιν τε οὐ μὴ διακρίνωσιν αὐτῶν οὐδὲ μὴ ῥύσωνται ἀδικούμενον ἀδύνατοι ὄντες· ὥσπερ γὰρ κορῶναι ἀνὰ μέσον τοῦ οὐρανοῦ καὶ τῆς γῆς.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.54",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.54",
    "language": "grc",
    "text": "καὶ γὰρ ὅταν ἐμπέσῃ εἰς οἰκίαν θεῶν ξυλίνων ἢ περιχρύσων ἢ περιαργύρων πῦρ, οἱ μὲν ἱερεῖς αὐτῶν φεύξονται καὶ διασωθήσονται, αὐτοὶ δὲ ὥσπερ δοκοὶ μέσοι κατακαυθήσονται.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.55",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.55",
    "language": "grc",
    "text": "βασιλεῖ δὲ καὶ πολεμίοις οὐ μὴ ἀντιστῶσιν.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.56",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.56",
    "language": "grc",
    "text": "πῶς οὖν ἐκδεκτέον ἢ νομιστέον ὅτι εἰσὶν θεοί;",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.57",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.57",
    "language": "grc",
    "text": "Οὔτε ἀπὸ κλεπτῶν οὔτε ἀπὸ λῃστῶν οὐ μὴ διασωθῶσιν θεοὶ ξύλινοι καὶ περιάργυροι καὶ περίχρυσοι, ὧν οἱ ἰσχύοντες περιελοῦνται τὸ χρυσίον καὶ τὸ ἀργύριον καὶ τὸν ἱματισμὸν τὸν περικείμενον αὐτοῖς ἀπελεύσονται ἔχοντες, οὔτε ἑαυτοῖς οὐ μὴ βοηθήσωσιν·",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.58",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.58",
    "language": "grc",
    "text": "ὥστε κρεῖσσον εἶναι βασιλέα ἐπιδεικνύμενον τὴν ἑαυτοῦ ἀνδρείαν ἢ σκεῦος ἐν οἰκίᾳ χρήσιμον, ἐφ’ ᾧ χρήσεται ὁ κεκτημένος, ἢ οἱ ψευδεῖς θεοί· ἢ καὶ θύρα ἐν οἰκίᾳ διασῴζουσα τὰ ἐν αὐτῇ ὄντα ἢ οἱ ψευδεῖς θεοί, καὶ ξύλινος στῦλος ἐν βασιλείοις ἢ οἱ ψευδεῖς θεοί.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.59",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.59",
    "language": "grc",
    "text": "ἥλιος μὲν γὰρ καὶ σελήνη καὶ ἄστρα ὄντα λαμπρὰ καὶ ἀποστελλόμενα ἐπὶ χρείας εὐήκοά εἰσιν·",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.60",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.60",
    "language": "grc",
    "text": "ὡσαύτως καὶ ἀστραπή, ὅταν ἐπιφανῇ, εὔοπτός ἐστιν· τὸ δ’ αὐτὸ καὶ πνεῦμα ἐν πάσῃ χώρᾳ πνεῖ·",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.61",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.61",
    "language": "grc",
    "text": "καὶ νεφέλαις ὅταν ἐπιταγῇ ὑπὸ τοῦ θεοῦ ἐπιπορεύεσθαι ἐφ’ ὅλην τὴν οἰκουμένην, συντελοῦσι τὸ ταχθέν· τό τε πῦρ ἐξαποσταλὲν ἄνωθεν ἐξαναλῶσαι ὄρη καὶ δρυμοὺς ποιεῖ τὸ συνταχθέν.",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.62",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.62",
    "language": "grc",
    "text": "ταῦτα δὲ οὔτε ταῖς ἰδέαις οὔτε ταῖς δυνάμεσιν αὐτῶν ἀφωμοιωμένα ἐστίν.",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.63",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.63",
    "language": "grc",
    "text": "ὅθεν οὔτε νομιστέον οὔτε κλητέον ὑπάρχειν αὐτοὺς θεούς, οὐ δυνατῶν ὄντων αὐτῶν οὔτε κρίσιν κρῖναι οὔτε εὖ ποιεῖν ἀνθρώποις.",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.64",
    "work_id": "scripture/pta-lxx/epjer",
    "canonical_ref": "EpJer.1.64",
    "language": "grc",
    "text": "γνόντες οὖν ὅτι οὔκ εἰσιν θεοί, μὴ φοβηθῆτε αὐτούς.",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/epjer#EpJer.1.65",
    "work_id": "scripture/pta-lxx/epjer",
