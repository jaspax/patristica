    "work_id": "scripture/pta-lxx/col",
    "canonical_ref": "Col.1.12",
    "language": "grc",
    "text": "εὐχαριστοῦντες τῷ πατρὶ τῷ ἱκανώσαντι ὑμᾶς ἡμᾶς εἰς τὴν μερίδα τοῦ κλήρου τῶν ἁγίων ἐν τῷ φωτί ,",
    "chunk_index": 11,
    "context_before": null,
