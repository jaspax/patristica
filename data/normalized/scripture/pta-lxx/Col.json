    "work_id": "scripture/pta-lxx/col",
    "canonical_ref": "Col.1.19",
    "language": "grc",
    "text": "ὅτι ἐν αὐτῷ εὐδόκησεν πᾶν τὸ πλήρωμα κατοικῆσαι",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
