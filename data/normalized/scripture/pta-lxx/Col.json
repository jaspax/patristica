    "work_id": "scripture/pta-lxx/col",
    "canonical_ref": "Col.1.8",
    "language": "grc",
    "text": "ὁ καὶ δηλώσας ἡμῖν τὴν ὑμῶν ἀγάπην ἐν πνεύματι .",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
