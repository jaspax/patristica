  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.7ad8",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.7ad8",
    "language": "grc",
    "text": "οὗτοι ἰδόντες γυναῖκα ἀστείαν τῷ εἴδει, γυναῖκα ἀδελφοῦ αὐτῶν ἐκ τῶν υἱῶν Ισραηλ, ὄνομα Σουσανναν θυγατέρα Χελκιου γυναῖκα Ιωακιμ, περιπατοῦσαν ἐν τῷ παραδείσῳ τοῦ ἀνδρὸς αὐτῆς τὸ δειλινὸν καὶ ἐπιθυμήσαντες αὐτῆς",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.9",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.9",
    "language": "grc",
    "text": "διέστρεψαν τὸν νοῦν αὐτῶν καὶ ἐξέκλιναν τοὺς ὀφθαλμοὺς αὐτῶν τοῦ μὴ βλέπειν εἰς τὸν οὐρανὸν μηδὲ μνημονεύειν κριμάτων δικαίων.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.10ad11",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.10ad11",
    "language": "grc",
    "text": "καὶ ἀμφότεροι ἦσαν κατανενυγμένοι περὶ αὐτῆς, καὶ ἕτερος τῷ ἑτέρῳ οὐ προσεποιεῖτο τὸ κακὸν τὸ ἔχον αὐτοὺς περὶ αὐτῆς, οὐδὲ ἡ γυνὴ ἔγνω τὸ πρᾶγμα τοῦτο.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.12",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.12",
    "language": "grc",
    "text": "καὶ ὡς ἐγίνετο ὄρθρος, ἐρχόμενοι ἔκλεπτον ἀλλήλους σπεύδοντες, τίς φανήσεται αὐτῇ πρότερος καὶ λαλήσει πρὸς αὐτήν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.13ad14",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.13ad14",
    "language": "grc",
    "text": "καὶ ἰδοὺ αὕτη κατὰ τὸ εἰωθὸς περιεπάτει, καὶ ὁ εἷς τῶν πρεσβυτέρων ἐληλύθει, καὶ ἰδοὺ ὁ ἕτερος παρεγένετο, καὶ εἷς τὸν ἕτερον ἀνέκρινε λέγων Τί σὺ οὕτως ὄρθρου ἐξῆλθες οὐ παραλαβών με; καὶ ἐξωμολογήσαντο πρὸς ἀλλήλους ἑκάτερος τὴν ὀδύνην αὐτοῦ.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.19",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.19",
    "language": "grc",
    "text": "καὶ εἶπεν εἷς τῷ ἑτέρῳ Πορευθῶμεν πρὸς αὐτήν· καὶ συνθέμενοι προσήλθοσαν αὐτῇ καὶ ἐξεβιάζοντο αὐτήν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.22",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.22",
    "language": "grc",
    "text": "καὶ εἶπεν αὐτοῖς ἡ Ιουδαία Οἶδα ὅτι ἐὰν πράξω τοῦτο, θάνατός μοί ἐστι, καὶ ἐὰν μὴ πράξω, οὐκ ἐκφεύξομαι τὰς χεῖρας ὑμῶν·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.23",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.23",
    "language": "grc",
    "text": "κάλλιον δέ με μὴ πράξασαν ἐμπεσεῖν εἰς τὰς χεῖρας ὑμῶν ἢ ἁμαρτεῖν ἐνώπιον κυρίου.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.28",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.28",
    "language": "grc",
    "text": "Οἱ δὲ παράνομοι ἄνδρες ἀπέστρεψαν ἀπειλοῦντες ἐν ἑαυτοῖς καὶ ἐνεδρεύοντες ἵνα θανατώσουσιν αὐτήν· καὶ ἐλθόντες ἐπὶ τὴν συναγωγὴν τῆς πόλεως, οὗ παρῳκοῦσαν, καὶ συνήδρευσαν οἱ ὄντες ἐκεῖ πάντες οἱ υἱοὶ Ισραηλ·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.29",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.29",
    "language": "grc",
    "text": "καὶ ἀναστάντες οἱ δύο πρεσβύτεροι καὶ κριταὶ εἶπαν Ἀποστείλατε ἐπὶ Σουσανναν θυγατέρα Χελκιου, ἥτις ἐστὶ γυνὴ Ιωακιμ· οἱ δὲ εὐθέως ἐκάλεσαν αὐτήν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.30",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.30",
    "language": "grc",
    "text": "ὡς δὲ παρεγενήθη ἡ γυνὴ σὺν τῷ πατρὶ ἑαυτῆς καὶ τῇ μητρί, καὶ οἱ παῖδες καὶ αἱ παιδίσκαι αὐτῆς ὄντες τὸν ἀριθμὸν πεντακόσιοι παρεγένοντο καὶ τὰ παιδία Σουσαννας τέσσαρα·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.31",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.31",
    "language": "grc",
    "text": "ἦν δὲ ἡ γυνὴ τρυφερὰ σφόδρα.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.32",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.32",
    "language": "grc",
    "text": "καὶ προσέταξαν οἱ παράνομοι ἀποκαλύψαι αὐτήν, ἵνα ἐμπλησθῶσι κάλλους ἐπιθυμίας αὐτῆς·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.33",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.33",
    "language": "grc",
    "text": "καὶ ἐκλαίοσαν οἱ παρ’ αὐτῆς πάντες καὶ ὅσοι αὐτὴν ᾔδεισαν πάντες.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.34",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.34",
    "language": "grc",
    "text": "ἀναστάντες δὲ οἱ πρεσβύτεροι καὶ κριταὶ ἐπέθηκαν τὰς χεῖρας αὐτῶν ἐπὶ τῆς κεφαλῆς αὐτῆς·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.35",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.35",
    "language": "grc",
    "text": "ἡ δὲ καρδία αὐτῆς ἐπεποίθει ἐπὶ κυρίῳ τῷ θεῷ αὐτῆς, καὶ ἀνακύψασα ἔκλαυσεν ἐν ἑαυτῇ λέγουσα",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.35a",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.35a",
    "language": "grc",
    "text": "Κύριε ὁ θεὸς ὁ αἰώνιος ὁ εἰδὼς τὰ πάντα πρὶν γενέσεως αὐτῶν, σὺ οἶδας ὅτι οὐκ ἐποίησα ἃ πονηρεύονται οἱ ἄνομοι οὗτοι ἐπ’ ἐμοί. καὶ εἰσήκουσε κύριος τῆς δεήσεως αὐτῆς.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.36",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.36",
    "language": "grc",
    "text": "οἱ δὲ δύο πρεσβύτεροι εἶπαν Ἡμεῖς περιεπατοῦμεν ἐν τῷ παραδείσῳ τοῦ ἀνδρὸς αὐτῆς",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.37",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.37",
    "language": "grc",
    "text": "καὶ κυκλοῦντες τὸ στάδιον εἴδομεν ταύτην ἀναπαυομένην μετὰ ἀνδρὸς καὶ στάντες ἐθεωροῦμεν αὐτοὺς ὁμιλοῦντας ἀλλήλοις,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.38",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.38",
    "language": "grc",
    "text": "καὶ αὐτοὶ οὐκ ᾔδεισαν ὅτι εἱστήκειμεν. τότε συνειπάμεθα ἀλλήλοις λέγοντες Μάθωμεν τίνες εἰσὶν οὗτοι.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.39",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.39",
    "language": "grc",
    "text": "καὶ προσελθόντες ἐπέγνωμεν αὐτήν, ὁ δὲ νεανίσκος ἔφυγε συγκεκαλυμμένος,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.40",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.40",
    "language": "grc",
    "text": "ταύτης δὲ ἐπιλαβόμενοι ἐπηρωτῶμεν αὐτήν Τίς ὁ ἄνθρωπος;",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.41",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.41",
    "language": "grc",
    "text": "καὶ οὐκ ἀπήγγειλεν ἡμῖν, τίς ἦν. ταῦτα μαρτυροῦμεν. καὶ ἐπίστευσεν αὐτοῖς ἡ συναγωγὴ πᾶσα ὡς πρεσβυτέρων ὄντων καὶ κριτῶν τοῦ λαοῦ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.44ad45",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.44ad45",
    "language": "grc",
    "text": "Καὶ ἰδοὺ ἄγγελος κυρίου ἐκείνης ἐξαγομένης ἀπολέσθαι, καὶ ἔδωκεν ὁ ἄγγελος, καθὼς προσετάγη, πνεῦμα συνέσεως νεωτέρῳ ὄντι Δανιηλ.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.48",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.48",
    "language": "grc",
    "text": "διαστείλας δὲ Δανιηλ τὸν ὄχλον καὶ στὰς ἐν μέσῳ αὐτῶν εἶπεν Οὕτως μωροί, υἱοὶ Ισραηλ; οὐκ ἀνακρίναντες οὐδὲ τὸ σαφὲς ἐπιγνόντες ἀπεκρίνατε θυγατέρα Ισραηλ;",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.51",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.51",
    "language": "grc",
    "text": "καὶ νῦν διαχωρίσατέ μοι αὐτοὺς ἀπ’ ἀλλήλων μακράν, ἵνα ἐτάσω αὐτούς.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.52",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.52",
    "language": "grc",
    "text": "ὡς δὲ διεχωρίσθησαν, εἶπεν Δανιηλ τῇ συναγωγῇ Νῦν μὴ βλέψητε ὅτι οὗτοί εἰσι πρεσβύτεροι, λέγοντες Οὐ μὴ ψεύσωνται· ἀλλὰ ἀνακρινῶ αὐτοὺς κατὰ τὰ ὑποπίπτοντά μοι. καὶ ἐκάλεσε τὸν ἕνα αὐτῶν, καὶ προσήγαγον τὸν πρεσβύτερον τῷ νεωτέρῳ, καὶ εἶπεν αὐτῷ Δανιηλ Ἄκουε ἄκουε, πεπαλαιωμένε ἡμερῶν κακῶν· νῦν ἥκασί σου αἱ ἁμαρτίαι, ἃς ἐποίεις τὸ πρότερον",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.53",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.53",
    "language": "grc",
    "text": "πιστευθεὶς ἀκούειν καὶ κρίνειν κρίσεις θάνατον ἐπιφερούσας καὶ τὸν μὲν ἀθῷον κατέκρινας, τοὺς δὲ ἐνόχους ἠφίεις, τοῦ κυρίου λέγοντος Ἀθῷον καὶ δίκαιον οὐκ ἀποκτενεῖς·",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.54",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.54",
    "language": "grc",
    "text": "νῦν οὖν ὑπὸ τί δένδρον καὶ ποταπῷ τοῦ παραδείσου τόπῳ ἑώρακας αὐτοὺς ὄντας σὺν ἑαυτοῖς; καὶ εἶπεν ὁ ἀσεβής Ὑπὸ σχῖνον.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.55",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.55",
    "language": "grc",
    "text": "εἶπεν δὲ ὁ νεώτερος Ὀρθῶς ἔψευσαι εἰς τὴν σεαυτοῦ ψυχήν· ὁ γὰρ ἄγγελος κυρίου σχίσει σου τὴν ψυχὴν σήμερον.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "post_schism": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.56",
    "work_id": "scripture/pta-lxx/sus",
