[
  {
    "chunk_id": "scripture/pta-lxx/sus#Sus.1.6",
    "work_id": "scripture/pta-lxx/sus",
    "canonical_ref": "Sus.1.6",
    "language": "grc",
    "text": "καὶ ἤρχοντο κρίσεις ἐξ ἄλλων πόλεων πρὸς αὐτούς.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
