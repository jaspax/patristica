[
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.1",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.1",
    "language": "grc",
    "text": "Ἐκ προφητείας Αμβακουμ υἱοῦ Ἰησοῦ ἐκ τῆς φυλῆς Λευι.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.2",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.2",
    "language": "grc",
    "text": "Ἄνθρωπός τις ἦν ἱερεύς, ᾧ ὄνομα Δανιηλ υἱὸς Αβαλ, συμβιωτὴς τοῦ βασιλέως Βαβυλῶνος.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.3",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.3",
    "language": "grc",
    "text": "καὶ ἦν εἴδωλον, Βηλ, ὃ ἐσέβοντο οἱ Βαβυλώνιοι· ἀνηλίσκετο δὲ αὐτῷ καθ’ ἑκάστην ἡμέραν σεμιδάλεως ἀρτάβαι δέκα δύο καὶ πρόβατα τέσσαρα καὶ ἐλαίου μετρηταὶ ἕξ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.4",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.4",
    "language": "grc",
    "text": "καὶ ὁ βασιλεὺς ἐσέβετο αὐτόν, καὶ ἐπορεύετο ὁ βασιλεὺς καθ’ ἑκάστην ἡμέραν καὶ προσεκύνει αὐτῷ· Δανιηλ δὲ προσηύχετο πρὸς κύριον.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.5",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.5",
    "language": "grc",
    "text": "καὶ εἶπεν ὁ βασιλεὺς τῷ Δανιηλ Διὰ τί οὐ προσκυνεῖς τῷ Βηλ; καὶ εἶπε Δανιηλ πρὸς τὸν βασιλέα Οὐδένα σέβομαι ἐγὼ εἰ μὴ κύριον τὸν θεὸν τὸν κτίσαντα τὸν οὐρανὸν καὶ τὴν γῆν καὶ ἔχοντα πάσης σαρκὸς κυρ<ι>είαν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.6",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.6",
    "language": "grc",
    "text": "εἶπεν δὲ ὁ βασιλεὺς αὐτῷ Οὗτος οὖν οὐκ ἔστι θεός; οὐχ ὁρᾷς ὅσα εἰς αὐτὸν δαπανᾶται καθ’ ἑκάστην ἡμέραν;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.7",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.7",
    "language": "grc",
    "text": "καὶ εἶπεν αὐτῷ Δανιηλ Μηδαμῶς· μηδείς σε παραλογιζέσθω· οὗτος γὰρ ἔσωθεν μὲν πήλινός ἐστιν, ἔξωθεν δὲ χαλκοῦς· ὀμνύω δέ σοι κύριον τὸν θεὸν τῶν θεῶν, ὅτι οὐθὲν βέβρωκε πώποτε οὗτος.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.8",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.8",
    "language": "grc",
    "text": "καὶ θυμωθεὶς ὁ βασιλεὺς ἐκάλεσε τοὺς προεστηκότας τοῦ ἱεροῦ καὶ εἶπεν αὐτοῖς Παραδείξατε τὸν ἐσθίοντα τὰ παρασκευαζόμενα τῷ Βηλ· εἰ δὲ μή γε, ἀποθανεῖσθε ἢ Δανιηλ ὁ φάσκων μὴ ἐσθίεσθαι αὐτὰ ὑπ’ αὐτοῦ. οἱ δὲ εἶπαν Αὐτὸς ὁ Βηλ ἐστὶν ὁ κατεσθίων αὐτά.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.9",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.9",
    "language": "grc",
    "text": "εἶπε δὲ Δανιηλ πρὸς τὸν βασιλέα Γινέσθω οὕτως· ἐὰν μὴ παραδείξω ὅτι οὐκ ἔστιν ὁ Βηλ ὁ κατεσθίων ταῦτα, ἀποθανοῦμαι καὶ πάντες οἱ παρ’ ἐμοῦ. ἦσαν δὲ τῷ Βηλ ἱερεῖς ἑβδομήκοντα χωρὶς γυναικῶν καὶ τέκνων.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.10",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.10",
    "language": "grc",
    "text": "ἤγαγον δέ τὸν βασιλέα εἰς τὸ εἰδώλιον.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.11",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.11",
    "language": "grc",
    "text": "καὶ παρετέθη τὰ βρώματα ἐνώπιον τοῦ βασιλέως καὶ τοῦ Δανιηλ, καὶ οἶνος κερασθεὶς εἰσηνέχθη καὶ παρετέθη τῷ Βηλ. καὶ εἶπεν Δανιηλ Σὺ αὐτὸς ὁρᾷς ὅτι κεῖται ταῦτα, βασιλεῦ· σὺ οὖν ἐπισφράγισαι τὰς κλεῖδας τοῦ ναοῦ, ἐπὰν κλεισθῇ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.13",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.13",
    "language": "grc",
    "text": "ἤρεσε δὲ ὁ λόγος τῷ βασιλεῖ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.14",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.14",
    "language": "grc",
    "text": "ὁ δὲ Δανιηλ ἐκέλευσε τοὺς παρ’ αὐτοῦ ἐκβαλόντας πάντας ἐκ τοῦ ναοῦ κατασῆσαι ὅλον τὸν ναὸν σποδῷ οὐθενὸς τῶν ἐκτὸς αὐτοῦ εἰδότος. καὶ τότε τὸν ναὸν ἐκέλευσε σφραγίσαι τῷ τοῦ βασιλέως δακτυλίῳ καὶ τοῖς δακτυλίοις τινῶν ἐνδόξων ἱερέων· καὶ ἐγένετο οὕτως.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.15ad17",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.15ad17",
    "language": "grc",
    "text": "καὶ ἐγένετο τῇ ἐπαύριον παρεγένοντο ἐπὶ τὸν τόπον· οἱ δὲ ἱερεῖς τοῦ Βηλ διὰ ψευδοθυρίδων εἰσελθόντες κατεφάγοσαν πάντα τὰ παρακείμενα τῷ Βηλ καὶ ἐξέπιον τὸν οἶνον. καὶ εἶπεν Δανιηλ Ἐπίδετε τὰς σφραγῖδας ὑμῶν εἰ μένουσιν, ἄνδρες ἱερεῖς· καὶ σὺ δέ, βασιλεῦ, σκέψαι μή τί σοι ἀσύμφωνον γεγένηται. καὶ εὗρον, ὡς ἦν ἡ σφραγίς, καὶ ἀπέβαλον τὴν σφραγῖδα.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.18",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.18",
    "language": "grc",
    "text": "καὶ ἀνοίξαντες τὰς θύρας εἴδοσαν δεδαπανημένα πάντα τὰ παρατεθέντα καὶ τὰς τραπέζας κενάς· καὶ ἐχάρη ὁ βασιλεὺς καὶ εἶπεν πρὸς τὸν Δανιηλ Μέγας ἐστὶν ὁ Βηλ, καὶ οὐκ ἔστι παρ’ αὐτῷ δόλος.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.19",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.19",
    "language": "grc",
    "text": "καὶ ἐγέλασε Δανιηλ σφόδρα καὶ εἶπεν τῷ βασιλεῖ Δεῦρο ἰδὲ τὸν δόλον τῶν ἱερέων. καὶ εἶπεν Δανιηλ Βασιλεῦ, ταῦτα τὰ ἴχνη τίνος ἐστί;",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.20",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.20",
    "language": "grc",
    "text": "καὶ εἶπεν ὁ βασιλεύς Ἀνδρῶν καὶ γυναικῶν καὶ παιδίων.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.21",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.21",
    "language": "grc",
    "text": "καὶ ἐπῆλθεν ἐπὶ τὸν οἶκον, ἐν ᾧ ἦσαν οἱ ἱερεῖς καταγινόμενοι, καὶ εὗρε τὰ βρώματα τοῦ Βηλ καὶ τὸν οἶνον· καὶ ἐπέδειξε Δανιηλ τῷ βασιλεῖ τὰ ψευδοθύρια, δι’ ὧν εἰσπορευόμενοι οἱ ἱερεῖς ἐδαπάνων τὰ παρατιθέμενα τῷ Βηλ.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.22",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.22",
    "language": "grc",
    "text": "καὶ ἐξήγαγεν αὐτοὺς ὁ βασιλεὺς ἐκ τοῦ Βηλίου καὶ παρέδωκεν αὐτοὺς τῷ Δανιηλ· καὶ τὴν δαπάνην τὴν εἰς αὐτὸν ἔδωκε τῷ Δανιηλ, τὸν δὲ Βηλ κατέστρεψε.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.23",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.23",
    "language": "grc",
    "text": "Καὶ ἦν δράκων ἐν τῷ αὐτῷ τόπῳ, καὶ ἐσέβοντο αὐτὸν οἱ Βαβυλώνιοι.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.24",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.24",
    "language": "grc",
    "text": "καὶ εἶπεν ὁ βασιλεὺς τῷ Δανιηλ Μὴ καὶ τοῦτον ἐρεῖς ὅτι χαλκοῦς ἐστιν; ἰδοὺ ζῇ καὶ ἐσθίει καὶ πίνει· προσκύνησον αὐτῷ.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.25",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.25",
    "language": "grc",
    "text": "καὶ εἶπεν Δανιηλ Βασιλεῦ, δός μοι τὴν ἐξουσίαν, καὶ ἀνελῶ τὸν δράκοντα ἄνευ σιδήρου καὶ ῥάβδου.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.26",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.26",
    "language": "grc",
    "text": "καὶ συνεχώρησεν αὐτῷ ὁ βασιλεὺς καὶ εἶπεν αὐτῷ Δέδοταί σοι.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.27",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.27",
    "language": "grc",
    "text": "καὶ λαβὼν ὁ Δανιηλ πίσσης μνᾶς τριάκοντα καὶ στέαρ καὶ τρίχας ἥψησεν ἐπὶ τὸ αὐτὸ καὶ ἐποίησε μάζαν καὶ ἐνέβαλεν εἰς τὸ στόμα τοῦ δράκοντος, καὶ φαγὼν διερράγη. καὶ ἔδειξεν αὐτὸν τῷ βασιλεῖ λέγων Οὐ ταῦτα σέβεσθε, βασιλεῦ;",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.28",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.28",
    "language": "grc",
    "text": "καὶ συνήχθησαν οἱ ἀπὸ τῆς χώρας πάντες ἐπὶ τὸν Δανιηλ καὶ εἶπαν Ιουδαῖος γέγονεν ὁ βασιλεύς· τὸν Βηλ κατέστρεψε καὶ τὸν δράκοντα ἀπέκτεινε.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.30",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.30",
    "language": "grc",
    "text": "καὶ ἰδὼν ὁ βασιλεὺς ὅτι ἐπισυνήχθη ὁ ὄχλος τῆς χώρας ἐπ’ αὐτόν, ἐκάλεσε τοὺς συμβιωτὰς αὐτοῦ καὶ εἶπεν Δίδωμι τὸν Δανιηλ εἰς ἀπώλειαν.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.31ad32",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.31ad32",
    "language": "grc",
    "text": "ἦν δὲ λάκκος ἐν ᾧ ἐτρέφοντο λέοντες ἑπτά, οἷς παρεδίδοντο οἱ ἐπίβουλοι τοῦ βασιλέως, καὶ ἐχορηγεῖτο αὐτοῖς καθ’ ἑκάστην ἡμέραν τῶν ἐπιθανατίων σώματα δύο. καὶ ἐνεβάλοσαν τὸν Δανιηλ οἱ ὄχλοι εἰς ἐκεῖνον τὸν λάκκον, ἵνα καταβρωθῇ καὶ μηδὲ ταφῆς τύχῃ. καὶ ἦν ἐν τῷ λάκκῳ Δανιηλ ἡμέρας ἕξ.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.33",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.33",
    "language": "grc",
    "text": "καὶ ἐγένετο τῇ ἡμέρᾳ τῇ ἕκτῃ καὶ ἦν Αμβακουμ ἔχων ἄρτους ἐντεθρυμμένους ἐν σκάφῃ ἐν ἑψήματι καὶ στάμνον οἴνου κεκερασμένου καὶ ἐπορεύετο εἰς τὸ πεδίον πρὸς τοὺς θεριστάς.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/pta-lxx/beldr#BelDr.1.34",
    "work_id": "scripture/pta-lxx/beldr",
    "canonical_ref": "BelDr.1.34",
    "language": "grc",
