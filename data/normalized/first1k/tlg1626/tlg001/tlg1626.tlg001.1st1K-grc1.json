[
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s1",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s1",
    "language": "grc",
    "text": "Ἡμεῖς οὖν ἀραδιούργητον ἄγομεν τὴν ἡμέραν· μήτε προστιθέντες, μήτε ἀφαιρούμενοι. καὶ γὰρ καὶ κατὰ τὴν Ἀσίαν μεγάλα στοιχεῖα κεκοίμηται·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s2",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s2",
    "language": "grc",
    "text": "ἅ τινα ἀναστήσεται τῇ ἡμέρᾳ τῆς παρουσίας τοῦ Κυρίου, ἐν ᾗ ἔρχεται μετὰ δόξης ἐξ οὐρανῶν, καὶ ἀναστήσει πάντας τοὺς ἁγίους·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s3",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s3",
    "language": "grc",
    "text": "Φίλιππον τὸν τῶν δώδεκα ἀποστόλων, ὃς κεκοίμηται ἐν Ἱεραπόλει, καὶ δύο θυ γατέρες αὐτοῦ γεγηρακυῖαι παρθένοι·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s4",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s4",
    "language": "grc",
    "text": "καὶ ἡ ἑτέρα αὐ τοῦ θυγάτηρ ἐν ἁγίῳ πνεύ ματι πολιτευσαμένη, ὴ ἐν Ἐφέσῳ ἀναπαύεται· ἔτι δὲ καὶ Ἰωάννης ὁ ἐπὶ τὸ στῆθος τοῦ Κυρίου ἀναπεσών·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s5",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s5",
    "language": "grc",
    "text": "ὃς ἐγενήθη ἱερεὺς τὸ πέταλον πεφορεκὼς, καὶ μάρτυς καὶ διδάσκαλος· οὗτος ἐν Ἐφέσῳ κεκοίμηται.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s6",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s6",
    "language": "grc",
    "text": "ἔτι δὲ καὶ Πολύκαρπος ἐν Σμύρνῃ καὶ ἐπίσκοπος καὶ μάρ τυς· καὶ Θρασέας καὶ ἐπίσκοπος καὶ μάρτυς ἀπὸ Εὐμενείας, ὃς ἐν Σμύρνῃ κεκοίμηται.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s7",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s7",
    "language": "grc",
    "text": "τί δὲ δεῖ λέγειν Σάγαριν ἐπίσκοπον καὶ μάρτυρα, ὃς ἐν Λαοδικείᾳ κεκοίμηται;",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s8",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s8",
    "language": "grc",
    "text": "ἔτι δὲ καὶ Παπείριον τὸν μακάριον, καὶ Μελίτωνα τὸν εὐνοῦχον, τὸν ἐν ἁγίῳ πνεύματι πάντα πολιτευσάμενον·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s9",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s9",
    "language": "grc",
    "text": "ὃς κεῖται ἐν Σάρδεσι περιμένων τὴν ἀπὸ τῶν οὐρανῶν ἐπισκοπὴν, ἐν ᾗ ἐκ νεκρῶν ἀναστήσεται.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s10",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s10",
    "language": "grc",
    "text": "οὗτοι πάντες ἐτήρησαν τὴν ἡμέραν τῆς τεσσαρεσκαιδεκάτης τοῦ πάσχα κατὰ τὸ εὐαγγέλιον· μηδὲν παρεκβαίνοντες, ἀλλὰ κατὰ τὸν κανόνα τῆς πίστεως ἀκολουθοῦντες·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s11",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s11",
    "language": "grc",
    "text": "ἔτι δὲ κᾀγὼ ὁ μικρότερος πάντων ὑμῶν Πολυκράτης, κατὰ παράδοσιν τῶν συγγενῶν μου, οἷς καὶ παρηκολούθησα τισὶν αὐτῶν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s12",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s12",
    "language": "grc",
    "text": "ἑπτὰ μὲν ἦσαν συγγενεῖς μου ἐπίσκοποι, ἐγὼ δὲ ὄγδοος· καὶ πάντοτε τὴν ἡμέραν ἤγαγον οἱ συγγενεῖς μου, ὅταν ὁ λαὸς ἤρνυε τὴν ζύμην.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s13",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s13",
    "language": "grc",
    "text": "ἐγὼ οὖν, ἀδελφοὶ, ἑξήκοντα πέντε ἔτη ἔχων ἐν Κυρίῳ· καὶ συμβεβληκὼς τοῖς ἀπὸ τῆς οἰκουμένης ἀδελφοῖς·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.s14",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.s14",
    "language": "grc",
    "text": "καὶ πᾶσαν ἁγίαν γραφὴν διεληλυθὼς, οὐ πτύρομαι ἐπὶ τοῖς καταπλησσομένοις. οἱ γὰρ ἐμοῦ μείζονες εἰρήκάσι, πειθαρχεῖν δεῖ Θεῷ μᾶλλον ἢ ἀνθρώποις.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.1.s1",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.1.s1",
    "language": "grc",
    "text": "Ἐδυνάμην δὲ τῶν ἐπισκόπων τῶν συμπαρόντων μνημονεῦσαι, οὓς ὑμεῖς ἠξιώσατε μετακληθῆναι ὑπ’ ἐμοῦ, καὶ μετεκαλεσάμην· ὧν τὰ ὀνόματα ἐὰν γράφω, πολλὰ πλήθη εἰσίν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1626/tlg001/1st1K-grc1#tlg1626.tlg001.1.1.s2",
    "work_id": "first1k/tlg1626/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1626.tlg001.1.1.s2",
    "language": "grc",
    "text": "οἱ δὲ ἰδόντες τὸν μικρόν μου ἄνθρωπον, συνηυδόκησαν τῇ ἐπιστολῇ· εἰδότες ὅτι εἰκῆ πολιὰς οὐκ ἤνεγκα, ἀλλὰ ἐν Κυρίῳ Ἰησοῦ πάντοτε πεπολίτευμαι. Attulit haec Eusebius lib. v. Hist. cap. 24.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
