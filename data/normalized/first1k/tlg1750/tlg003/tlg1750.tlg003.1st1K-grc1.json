[
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.1.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.1.s1",
    "language": "grc",
    "text": "Ὠσηὲ ἑρμηνεύεται σωζόμενος. Οὗτος ἦν ἐκ Bελεμὼθ τῆς φυλῆς Ἰσάχαρ, καὶ ἔδωκε τέρας ἥξειν κύριον ἐπὶ γῆς ἀνθρώποις συναναστρεφόμενον καὶ ἡ δρῦς ἡ ἐν Σιλὼμ μερισθήσεται εἰς δώδεκα μέρη·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.1.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.1.s2",
    "language": "grc",
    "text": "καὶ γενήσονται δώδεκα δρύες ἐπακοῦσαι καὶ ἀκολουθῆσαι αὐτῷ ἐπὶ γῆς φανέντι θεῷ, καὶ δι᾽ αὐτοῦ σωθήσεται πᾶσα ἡ γῆ· καὶ οὕτως θανὼν ἐτάφη ἐν τῇ γῇ αὐτοῦ.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.2",
    "language": "grc",
    "text": "Ἰωὴλ ἑρμηνεύεται ἀγαπητὸς κυρίου ἢ ἀρχή. Οὗτος ἦν ἐκ τῆς φυλῆς Ῥουβὴν ἀγροῦ Βεθομόρων· ἐν εἰρήνῃ ἀπέθανε καὶ ἐτάφη ἐκεῖ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.3.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.3.s1",
    "language": "grc",
    "text": "Ἀμὼς ἑρμηνεύεται στερέωσις ἢ ἰσχύς. Ἀμὼς ἦν ἐκ Θεκουέ· καὶ Ἀμασίας συχνῶς αὐτὸν τυμπανίσας τέλος ἀνεῖλεν αὐτὸν ξίφει·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.3.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.3.s2",
    "language": "grc",
    "text": "ἔτι δὲ ἐμπνέοντος αὐτοῦ ἀνῆλθεν εἰς τὴν γῆν αὐτοῦ· καὶ μεθ᾽ ἡμέρας δύο ἀπέθανε καὶ ἐτάφη ἐκεῖ.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.4.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.4.s1",
    "language": "grc",
    "text": "Ἀβδιοῦ ἑρμηνεύεται δοῦλος ἐξομολογητός. Οὗτος ἦν ἐκ τῆς Συχέμ.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.4.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.4.s2",
    "language": "grc",
    "text": "Οὗτος ἦν ὁ τριστάτης ἑκατόνταρχος· ὁ τρίτος Ὀχοζίου καὶ δεηθεὶς τοῦ Ἠλίου, καὶ διασωθεὶς παραδόξως ἐγένετο αὐτοῦ λειτουργός.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.4.s3",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.4.s3",
    "language": "grc",
    "text": "Πολλὰ δὲ παθὼν καὶ ὑπὸ τοῦ Ἀχαὰβ διὰ τὸν Ἠλίαν τέλος καταφρονήσας θανάτου, καταλιπὼν τὸν βασιλέα, ἠκολούθησε τῷ Ἠλίᾳ καὶ προεφήτευσε καὶ ἀποθανὼν ἐν εἰρήνῃ ἐτάφη μετὰ τῶν πατέρων αὐτοῦ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s1",
    "language": "grc",
    "text": "Ἰωνᾶς ἑρμηνεύεται ὑψίστου πονοῦντος ἢ περιστερά. Ἰωνᾶς ἦν ἐκ γῆς Καριαθὲμ πλησίον Ἀζώτου πόλεως Ἐλλήνων κατὰ θάλασσαν·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s2",
    "language": "grc",
    "text": "καὶ ἐκβρασθεὶς ἐκ τοῦ κήτους, ἀπελθὼν εἰς Νινευῒ καὶ κηρύξας καὶ ἀνακάμψας οὐκ ἔμεινεν ἐν τῇ γῇ αὐτοῦ·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s3",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s3",
    "language": "grc",
    "text": "ἀλλὰ παραλαβὼν τὴν μητέρα αὐτοῦ παρῴκησεν ἐν τῇ Ἀσσοὺρ χώρᾳ ἀλλοφύλων ἐθνῶν·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s4",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s4",
    "language": "grc",
    "text": "ἔλεγεν γάρ, ὅτι οὕτως ἀφελῶ τὸ ὄνειδός μου, ὅτι ἐψευσάμην προφητεύσας κατὰ Νινευῒ τῆς μεγάλης πόλεως.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s5",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s5",
    "language": "grc",
    "text": "Ἦν τις Ἠλίας ἐλέγχων τὸν Ἀχαὰβ καὶ καλέσας λιμὸν ἐπὶ τῆν γῆν ἔφυγε· καὶ ἐλθὼν εἰς Σαραφθὰ ηὗρε τὴν χήραν μετὰ τοῦ υἱοῦ αὐτῆς, καὶ ἔμεινε παρ᾽ αὐτοῖς·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s6",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s6",
    "language": "grc",
    "text": "οὐδὲ γὰρ ἠδύνατο μένειν μετὰ τῶν ἀπεριτμήτων· καὶ εὐλόγησεν αὐτὴν διὰ τὴν ξενοδοχίαν, ἦν γὰρ προγινώσκων αὐτὴν ἐκ πρώτου.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s7",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s7",
    "language": "grc",
    "text": "Θανόντος δὲ τοῦ υἱοῦ αὐτῆς ἐν μέσῳ ἀπεριτμήτων, πάλιν ἤγειρεν ὁ θεὸς διὰ τοῦ Ἠλία ἐκεῖ νεκρόν· ἠθέλησε γὰρ δεῖξαι αὐτῷ, ὅτι οὐ δύναταί τις ἀποδρᾶσαι θεόν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s8",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s8",
    "language": "grc",
    "text": "Καὶ ἀναστὰς Ἰωνᾶς μετὰ τὸν λιμὸν ἦλθεν εἰς τὴν Ἰουδαῖαν· καὶ ἀπέθανεν ἡ μήτηρ αὐτοῦ κατὰ τὴν ὁδόν, καὶ ἔθαψεν αὐτὴν ἐχόμενα τῆς βαλάνου Δεββώρας.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s9",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s9",
    "language": "grc",
    "text": "Καὶ κατῴκησεν ἐν γῇ Σαραήρ. Ἀπέθανε δὲ ἐκεῖ καὶ ἐτάφη ἐν σπηλαίῳ Κενὲζ κριτοῦ γενομένου ἐν ἡμέραις τῆς ἀναρχίας.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s10",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s10",
    "language": "grc",
    "text": "Καὶ ἔδωκε τέρας πολὺ ἐπὶ Ἰσραὴλ καὶ ἐφ᾽ ὅλην τὴν γῆν· ὅταν φησὶ ἴδωσι λίθον βοῶντα οἰκτρῶς, καὶ κάνθαρον ἀπὸ ξύλου πρὸς θεὸν φθεγγόμενον, τότε ἐγγίζειν τὴν σωτηρίαν·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s11",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s11",
    "language": "grc",
    "text": "τότε ὄψονται τὴν Ἱερουσαλὴμ ἠδαφισμένην ἕως θεμελίων ὅλην, καὶ εἰς αὐτὴν πάντα τὰ ἔθνη [ἐν] προσκυνήσει τῷ κυρίῳ·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.5.s12",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.5.s12",
    "language": "grc",
    "text": "καὶ μεταθήσουσι τοὺς λίθους κατὰ δυσμὰς ἡλίου, καὶ ἐκεῖ ἔσται ἡ προσκύνησις τοῦ ἠλειμμένου διὰ τὸ τὴν Ἱερουσαλὴμ βδελυχθῆναι ἐν ἐρημώσει θηρίων καὶ πάσης ἀκαθαρσίας, καὶ τότε ἥξει τὸ τέλος πάσης πνοῆς.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.6.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.6.s1",
    "language": "grc",
    "text": "Μιχαίας ἑρμηνεύεται ταπείνωσις ἢ ταπεινούμενος. Οὗτος ἦν ἀπὸ Μοραθεὶ ἐκ φυλῆς Ἐφραΐμ. Οὗτος πολλὰ ποιήσας τῷ Ἀχαάβ·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.6.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.6.s2",
    "language": "grc",
    "text": "ὑπὸ Ἰωρὰμ τοῦ υἱοῦ αὐτοῦ ἀνῃρέθη κρημνῷ, ὅτι ἤλεγχεν αὐτὸν ἐπὶ ταῖς ἀσεβείαις τῶν πατέρων αὐτοῦ· καὶ ἐτάφη ἐν τῇ γῇ αὐτοῦ μόνος, σύνεγγυς πολυανδρίου Ἐνακείμ.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.7.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.7.s1",
    "language": "grc",
    "text": "Ναοὺμ ἑρμηνεύεται παράκλητος. Οὗτος ἦν ἀπὸ Ἐλκεσὶν πέραν τοῦ Ἰηνβαρεὶν ἐκ φυλῆς Συμεών.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.7.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.7.s2",
    "language": "grc",
    "text": "Οὗτος μετὰ τὸν Ἰωνᾶν τέρας ἔδωκεν, ὅτι ὑπὸ ὑδάτων γλυκέων καὶ πυρὸς ἀπολεῖται ἡ Νινευΐ: ὃ καὶ γέγονεν.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.7.s3",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.7.s3",
    "language": "grc",
    "text": "Ἡ γὰρ περιέ αὐτὴν λίμνη κατέκλυσεν αὐτὴν ἐν σεισμῷ καὶ πῦρ ἐκ τῆς ἐρήμου τὸ ὑψηλότερον αὐτῆς μέρος ἐνέπρησεν· ἀπέθανε δ᾽ ἐν εἰρήνῃ καὶ ἐτάφη ἐν τῇ γῇ αὐτοῦ.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s1",
    "language": "grc",
    "text": "Ἀμβακοὺμ ἢ Ἀββακού, ἑρμηνεύεται πατὴρ ἐγέρσεως. [Ἀμβακοὺμ ὁ προφήτης ἦν ἐξ ἀγροῦ Βεθουχάρ, φυλῆς Συμεών.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s2",
    "language": "grc",
    "text": "Καὶ εἶδε πρὸ τῆς αἰμαλωσίας περὶ τῆς ἁλώσεως τῆς Ἱερουσαλὴμ καὶ ἐπένθησε σφόδρα.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s3",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s3",
    "language": "grc",
    "text": "Καὶ ὅτε ἦλθε Ναβουχοδονόσορ ἐν Ἱερουσαλήμ, ἔφυγεν εἰς Ὀστρακίνην, καὶ ἦν πάροικος ἐν γῇ Ἰσραήλ.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s4",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s4",
    "language": "grc",
    "text": "Ὡς δὲ ἐπέστρεψαν οἱ Χαλδαῖοι καὶ οἱ κατάλοιποι οἱ ὄντες ἐν Ἱερουσαλὴμ κατέβησαν εἰς Αἴγυπτον, ἦν οὗτος παροικῶν τὴν γῆν αὐτοῦ καὶ λειτουργῶν θερισταῖς τοῦ λαοῦ αὐτοῦ.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s5",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s5",
    "language": "grc",
    "text": "Ὡς δὲ ἔλαβε τὸ ἔδεσμα ἀπενέγκαι τοῖς ἐργάταις, προεφήτευσε τοῖς Ἰουδαίοις εἰπών· Πορεύομαι εἰς γῆν μακράν, καὶ ταχέως ἐλεύσομαι.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s6",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s6",
    "language": "grc",
    "text": "Ἐὰν δὲ βραδύνω, ἀπενέγκατε τοῖς θερισταῖς τὸ ἄριστον αὐτῶν.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s7",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s7",
    "language": "grc",
    "text": "Καὶ γενόμενος ἐν Βαβυλῶνι, καὶ δοὺς τὸ ἄριστον τῷ Δανιὴλ ἐπέστη τοῖς θερισταῖς ἐσθίουσι καὶ οὐδενὶ εἶπε τὸ γεγονός.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s8",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s8",
    "language": "grc",
    "text": "Συνῆκε δὲ ἐκ τούτου, ὅτι τάχιον ἐπιστρέψει ὁ λαὸς ἐκ Βαβυλῶνος. Καὶ πρὸ δύο ἐτῶν τῆς ἐπιστροφῆς θανὼν ἐτάφη ἐκεῖ ἐν ἀγρῷ.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s9",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s9",
    "language": "grc",
    "text": "Ἔδωκε δὲ τέρας τοῖς ἐν τῇ Ἰουδαίᾳ, ὅτι ὄψονται ἐν τῷ ναῷ φῶς, καὶ οὕτως ἴδωσι τὴν δόξαν τοῦ ναοῦ.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s10",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s10",
    "language": "grc",
    "text": "Καὶ περὶ τῆς συντελείας τοῦ ναοῦ προεῖπεν, ὅτι ὑπὸ ἔθνους δυτικοῦ γενήσεται.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s11",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s11",
    "language": "grc",
    "text": "Καὶ τότε τὸ ἅπλωμα τοῦ Δαβεὶρ εἰς μικρὰ διαῤῥαγήσεται, καὶ τὰ ἐπίκρανα τῶν δύο στύλων ἀφαιρεθήσεται· καὶ οὐδεὶς γνώσεται, ποῦ ἔσονται.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.8.s12",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.8.s12",
    "language": "grc",
    "text": "Ταῦτα δὲ ἐν τῇ ἐρήμῳ ἀπενεχθήσονται ὑπὸ ἀγγέλου, ὅπου ἐν ἀρχῇ ἐπάγη ἡ σκηνὴ τοῦ μαρτυρίου καὶ τοῖς ἐπὶ τέλει γνωσθήσεται κύριος.]",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.9.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.9.s1",
    "language": "grc",
    "text": "Σοφονίας ἑρμηνεύεται σκοπιὰ κυρίου. Οὗτος ἦν ἐκ φυλῆς Συμεὼν ἀγροῦ Σαρὼθ καὶ προεφήτευσε περὶ τῆς πόλεως Ἱερουσαλὴμ καὶ περὶ τέλους Ἰσραὴλ καὶ ἀντεισαγωγῆς καὶ σωτηρίας ἐθνῶν,",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.9.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.9.s2",
    "language": "grc",
    "text": "καὶ αἰσχύνης ἀσεβῶν, καὶ δόξης δικαίων, καὶ κριτοῦ πάσης πνοῆς· καὶ θανὼν ἐτάφη ἐν τῷ ἀγρῷ αὐτοῦ.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.10.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.10.s1",
    "language": "grc",
    "text": "Ἀγγαῖος ἑορτάζων ἑρμηνεύεται. Οὗτος ἐτέχθη εἰς Βαβυλῶνα· ἦν δὲ ἐκ φυλῆς Λευὶ καὶ ἔτι νέος ὤν ἦλθεν ἀπὸ Βαβυλῶνος εἰς Ἱερουσαλὴμ καὶ φανερῶς περὶ τῆς ἐπιστροφῆς τοῦ λαοῦ προεφήτευσεν·",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.10.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.10.s2",
    "language": "grc",
    "text": "καὶ εἶδεν ἐκ μέρους τὴν οἰκοδομὴν τοῦ ναοῦ· καὶ ἀποθανὼν ἐν Ἱερουσαλὴμ ἐτάφη πλησίον τάφου τῶν ἱερέων ἐνδόξως, ὡς αὐτοί, ἐπειδὴ καὶ αὐτὸς ἦν ἐκ γένους ἱερατικοῦ.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.11.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.11.s1",
    "language": "grc",
    "text": "Ζαχαρίας ἑρμηνεύεται μνήμη ὑψίστου λέοντος. Οὗτος ἦν ἐκ γένους Λευΐ, ἐγεννήθη ἐν Γαλαὰδ καὶ ἐλθὼν ἀπὸ Χαλδαίων ἤδη προβεβηκώς, καὶ πολλὰ τῷ ναῷ προφητεύσας ἔδωκεν εἰς ἀπόδειξιν.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.11.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.11.s2",
    "language": "grc",
    "text": "Οὗτος εἶπε τῷ Ἰωσεδέκ, ὅτι γεννήσει υἱόν, καὶ ἐν Ἱερουσαλὴμ ἱερατεύσει, εἰς τύπον τοῦ ἀληθῶς ἀρχιερέως.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.11.s3",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.11.s3",
    "language": "grc",
    "text": "Οὗτος καὶ τὸν Σαλαθιὴλ ἐπὶ υἱῷ ηὐλόγησε, καὶ τὸ ὄνομα αὐτοῦ Ζοροβάβελ ἐπέθηκε καὶ ἐπὶ Κύρου τέρας ἔδωκεν εἰς νῖκος·",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.11.s4",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.11.s4",
    "language": "grc",
    "text": "καὶ περὶ τῆς λειτουργίας αὐτοῦ προεφήτευσεν, ἥν ποιήσει ἐν Ἱερουσαλήμ, καὶ ηὐλόγησεν αὐτὸν σφόδρα. Τὸ δὲ τῆς προθέσεως εἶδεν Ἱερουσαλήμ·",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.11.s5",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.11.s5",
    "language": "grc",
    "text": "καὶ περὶ τέλους Ἰσραήλ, καὶ ἀρχῆς ἐθνῶν καὶ τέλους τοῦ ναοῦ, ὡς θεμελίων καταστροφῆς, καὶ ἀργίας προφητῶν καὶ ἱερέων καὶ σαββάτων, καὶ διπλῆς κρίσεως ἐξέθετο.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.11.s6",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.11.s6",
    "language": "grc",
    "text": "Καὶ ἀπέθανεν ἐν γήρει μακρῷ καὶ ἐκλιπὼν ἐτέθη σύνεγγυς τοῦ Ἀγγαίου.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.12.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.12.s1",
    "language": "grc",
    "text": "Μαλαχίας ἑρμηνεύεται ἄγγελος. Οὗτος μετὰ τὴν ἐπιστροφὴν τίκτεται ἐν Σοφιρᾷ ἐκ γένους Λευΐ, καὶ ἔτι πάνυ νέος ὤν καλὸν βίον ἔσχεν.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.12.s2",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.12.s2",
    "language": "grc",
    "text": "Καὶ ἐπειδὴ πᾶς ὁ λαὸς ἐτίμα αὐτὸν ὡς ἄμεπτον καὶ πραΰν, ἐκάλεσε Μαλαχίαν αὐτόν, ὅ ἐστιν ἄγγελος.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.12.s3",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.12.s3",
    "language": "grc",
    "text": "Ἦν γὰρ καὶ τῷ εἴδει εὐπρεπής· ἀλλὰ καὶ ὅσα αὐτὸς εἶπεν ἐν προφητείᾳ, αὐτῇ τῇ ἡμέρᾳ ἄγγελος ὀφθεὶς θεοῦ ἐπεδευτέρου τοὺς λόγους αὐτοῦ·",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.12.s4",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.12.s4",
    "language": "grc",
    "text": "τὸν δὲ ἄγγελον οὐδεὶς ἀνάξιος ἐθεώρει, ἀλλ᾽ ἤτοι φωνὴν αὐτοῦ ἤκουε μόνον·",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.12.s5",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.12.s5",
    "language": "grc",
    "text": "οἱ δὲ ἄξιοι καὶ τὸ εἶδος αὐτοῦ ἐθεώρουν, ὡς ἐγένετο ἐν ταῖς ἡμέραις τῆς ἀναρχίας, ὡς γέγραπται ἐν σχωφετείμ, τουτέστιν ἐν βίβλῳ κριτῶν.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.12.s6",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1750.tlg003.12.s6",
    "language": "grc",
    "text": "Καὶ ἔτι νέος ὤν προσετέθη πρὸς τοὺς πατέρας αὐτοῦ ἐν βίῳ ἀγαθῷ, καὶ ἐτάφη μετὰ τῶν πατέρων αὐτοῦ.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1750/tlg003/1st1K-grc1#tlg1750.tlg003.13.s1",
    "work_id": "first1k/tlg1750/tlg003/1st1K-grc1",
