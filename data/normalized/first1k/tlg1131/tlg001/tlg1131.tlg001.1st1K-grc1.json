[
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s1",
    "language": "grc",
    "text": "’Εκ πλείστου ὅσου καὶ ἱκανωτάτου χρόνου, ἀγαπητὲ Ἀουίρκιε Μάρκελλε, ἐπιταχθεὶς ὑπὸ σοῦ συγγράψαι τινὰ λόγον εἰς τὴν τῶν κατὰ Μιλτιάδην λεγομένων αἵρεσιν,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s2",
    "language": "grc",
    "text": "ἐφεκτικώτερόν πως μέχρι νῦν διεκείμην· οὐκ ἀπορίᾳ τοῦ δύνασθαι ἐλέγχειν μὲν τὸ ψεῦδος, μαρτυρεῖν δὲ τῇ ἀληθείᾳ·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s3",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s3",
    "language": "grc",
    "text": "δεδιὼς δὲ καὶ ἐξευλαβούμενος, μή πῃ δόξω τισὶν ἐπισυγγράφειν ἢ ἐπιδιατάσσεσθαι τῷ τῆς τοῦ εὐαγγελίου καινῆς διαθήκης λόγῳ·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s4",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s4",
    "language": "grc",
    "text": "ᾧ μήτε προσθεῖναι μήτ’ ἀφελεῖν δυνατὸν, τῷ κατὰ τὸ εὐαγγέλιον αὐτὸ πολιτεύεσθαι προῃρημένῳ.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s5",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s5",
    "language": "grc",
    "text": "προσφάτως δὲ γενόμενος ἐν Ἀγκύρᾳ τῆς Γαλατίας· καὶ καταλαβὼν τὴν κατὰ τόπον ἐκκλησίαν ὑπὸ τῆς νέας ταύτης οὐχ ὡς αὐτοὶ φασὶ προφητείας·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s6",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s6",
    "language": "grc",
    "text": "πολὺ δὲ μᾶλλον ὡς δειχθήσεται ψευδοπροφητείας διατεθρυλλημένην, καθόσον δυνατὸν, τοῦ Κυρίου παρασχόντος, περὶ αὐτῶν τε τούτων καὶ τῶν προτεινομένων ὑπ’ αὐτῶν ἑκάστοτε διελέχθημεν ἡμέραις πλείοσιν ἐν τῇ ἐκκλησίᾳ·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s7",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s7",
    "language": "grc",
    "text": "ὡς τὴν μὲν ἐκκλησίαν ἀγαλλιασθῆναι, καὶ πρὸς τὴν ἀλήθειαν ἐπιῤῥωσθῆναι· τοὺς δὲ ἐξεναντίας πρὸς τὸ παρὸν ἀποκρουσθῆναι· καὶ τοὺς ἀντιθέτους λυπηθῆναι.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s8",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s8",
    "language": "grc",
    "text": "ἀξιούντων οὖν τῶν κατὰ τόπον πρεσβυτέρων, ὅπως τῶν λεχθέντων κατὰ τῶν ἀντιδιατιθεμένων τῷ τῆς ἀληθείας λόγῳ ὑπόμνημά τι καταλίπωμεν·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.1.s9",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.1.s9",
    "language": "grc",
    "text": "παρόντος καὶ τοῦ συμπρεσβυτέρου ἡμῶν Ζωτικοῦ τοῦ Ὀτρηνοῦ, τοῦτο μὲν οὐκ ἐπράξαμεν· ἐπηγγειλάμεθα δὲ ἐνθάδε γράψαντες τοῦ Κυρίου διδόντος, διὰ σπουδῆς πέμψειν αὐτοῖς.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s1",
    "language": "grc",
    "text": "Ἡ τοίνυν ἔνστασις αὐτῶν καὶ ἡ πρόσφατος τοῦ ἀποσχίσματος αἵρεσις πρὸς τὴν ἐκκλησίαν, τὴν αἰτίαν ἔσχε τοιαύτην·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s2",
    "language": "grc",
    "text": "κώμη τις εἶναι λέγεται ἐν τῇ κατὰ τὴν Φρυγίαν Μυσίᾳ, καλουμένη Ἀρδαβαῦ τοὔνομα· ἔνθα φασὶ τινὰ τῶν νεοπίστων, πρώτως, Μοντανὸν τοὔνομα, κατὰ Γράτον Ἀσίας ἀνθύπατον,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s3",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s3",
    "language": "grc",
    "text": "ἐν ἐπιθυμίᾳ ψυχῆς ἀμέτρῳ φιλοπρωτείας δόντα πάροδον εἰς ἑαυτὸν τῷ ἀντικειμένῳ, πνευματοφορηθῆναί τε καὶ αἰφνιδίως ἐν κατοχῇ τινὶ καὶ παρεκστάσει γενόμενον ἐνθουσιᾷν·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s4",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s4",
    "language": "grc",
    "text": "ἄρξασθαί τε λαλεῖν καὶ ξενοφωνεῖν, παρὰ τὸ κατὰ παράδοσιν καὶ κατὰ διαδοχὴν ἄνωθεν τῆς ἐκκλησίας ἔθος δῆθεν προφητεύοντα·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s5",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s5",
    "language": "grc",
    "text": "τῶν δὲ κατ’ ἐκεῖνο καιροῦ ἐν τῇ τῶν νόθων ἐκφωνημάτων ἀκροάσει γενομένων, οἱ μὲν ὡς ἐπὶ ἐνεργουμένῳ καὶ δαιμονῶντι καὶ ἐν πλάνης πνεύματι ὑπάρχοντι,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s6",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s6",
    "language": "grc",
    "text": "καὶ τοὺς ὄχλους ταράττοντι ἀχθόμενοι ἐπετίμων, καὶ λαλεῖν ἐκώλυον· μεμνημένοι τῆς τοῦ Κυρίου διαστολῆς τε καὶ ἀπειλῆς, πρὸς τὸ φυλάττεσθαι τὴν τῶν ψευδοπροφητῶν ἐγρηγορότως παρουσίαν·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s7",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s7",
    "language": "grc",
    "text": "οἱ δὲ ὡς ἁγίῳ πνεύματι καὶ προφητικῷ χαρίσματι ἐπαιρόμενοι· καὶ οὐχ ἥκιστα χαυνούμενοι· καὶ τῆς διαστολῆς τοῦ Κυρίου ἐπιλανθανόμενοι·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s8",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s8",
    "language": "grc",
    "text": "τὸ βλαψίφρον καὶ ὑποκοριστικὸν καὶ λαοπλάνον πνεῦμα προὐκαλοῦντο· θελγόμενοι καὶ πλανώμενοι ὑπ’ αὐτοῦ, εἰς τὸ μηκέτι κωλύεσθαι (for.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s9",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s9",
    "language": "grc",
    "text": "κωλύεσθαι λαλεῖν, καὶ) σιωπᾶν. τεχνῇ δέ τινι, μᾶλλον δὲ τοιαύτῃ μεθόδῳ κακοτεχνίας ὁ διάβολος τὴν κατὰ τῶν παρηκόων ἀπώλειαν μηχανησάμενος,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s10",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s10",
    "language": "grc",
    "text": "καὶ παρ’ ἀξίαν ὑπ’ αὐτῶν τιμώμενος, ὑπεξήγειρέ τε καὶ προσεξέκαυσεν αὐτῶν τὴν ἀποκεκοιμημένην ἀπὸ τῆς κατ’ ἀλήθειαν πίστεως διάνοιαν·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s11",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s11",
    "language": "grc",
    "text": "ὡς καὶ ἑτέρας τινὰς δύο γυναῖκας ἐπεγεῖραι, καὶ τοῦ νόθου πνεύματος πληρῶσαι· ὡς καὶ λαλεῖν ἐκφρόνως καὶ ἀκαίρως καὶ ἀλλοτριοτρόπως ὁμοίως τῷ προειρημένῳ.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s12",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s12",
    "language": "grc",
    "text": "καὶ τοὺς μὲν χαίροντας καὶ καυχωμένους ἐπ’ αὐτῷ, μακαρίζοντος τοῦ πνεύματος, καὶ διὰ τοῦ μεγέθους τῶν ἐπαγγελμάτων ἐκφυσιοῦντος·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s13",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s13",
    "language": "grc",
    "text": "ἔσθ’ ὅπῃ δὲ καὶ κατακρίνοντος στοχαστικῶς καὶ ἀξιοπίστως αὐτοὺς ἄντικρυς, ἵνα καὶ ἐλεγκτικὸν εἶναι δοκῇ· ὀλίγοι δ’ ἦσαν οὗτοι τῶν Φρυγῶν ἐξηπατημένοι·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s14",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s14",
    "language": "grc",
    "text": "τὴν δὲ καθόλου καὶ πᾶσαν τὴν ὑπὸ τὸν οὐρανὸν ἐκκλησίαν βλασφημεῖν διδάσκοντος τοῦ ἀπηυθαδισμένου πνεύματος, ὅτι μήτε τιμὴν μήτε πάροδον εἰς αὐτὴν τὸ ψευδοπροφητικὸν ἐλάμβανε πνεῦμα.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s15",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s15",
    "language": "grc",
    "text": "τῶν γὰρ κατὰ τὴν Ἀσίαν πιστῶν πολλάκις καὶ πολλαχῇ τῆς Ἀσίας εἰς τοῦτο συνελθόντων,",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.1.2.s16",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.1.2.s16",
    "language": "grc",
    "text": "καὶ τοὺς προσφάτους λόγους ἐξετασάντων καὶ βεβήλους ἀποφῃνάντων καὶ ἀποδοκιμασάντων τὴν αἵρεσιν, οὕτω δὴ τῆς τε ἐκκλησίας ἐξεώσθησαν, καὶ τῆς κοινωνίας εἴρχθησαν.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s1",
    "language": "grc",
    "text": "Ἐπειδὰν τοίνυν καὶ προφητοφόντας ἡμᾶς ἀπεκάλουν, ὅτι μὴ τοὺς ἀμετροφώνους αὐτῶν προφήτας ἐδεξάμεθα· τούτους γὰρ εἶναι φασὶν οὕς περ ἐπηγγείλατο τῷ λαῷ πέμψειν ὁ Κύριος·",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s2",
    "language": "grc",
    "text": "ἀποκρινάσθωσαν ἡμῖν πρὸς Θεοῦ ἔστι τὶς, ὦ βέλτιστοι, τούτων τῶν ἀπὸ Μοντανοῦ καὶ τῶν γυναικῶν λαλεῖν ἀρξαμένων, ὅς τις ὑπὸ Ἰουδαίων ἐδιώχθη, ἢ ὑπὸ παρανόμων ἀπεκτάνθη;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s3",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s3",
    "language": "grc",
    "text": "οὐδείς. οὐδέ γε τὶς αὐτῶν κρατηθεὶς ὑπὲρ τοῦ ὀνόματος ἀνεσταυρώθη;",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s4",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s4",
    "language": "grc",
    "text": "οὐ γὰρ οὖν· οὐδὲ μὴν οὐδὲ ἐν συναγωγαῖς Ἰουδαίων τῶν γυναικῶν τὶς ἐμαστιγώθη ποτὲ, ἢ ἐλιθοβολήθη; οὐδαμόσε οὐδαμῶς.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s5",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s5",
    "language": "grc",
    "text": "ἄλλῳ δὲ θανάτῳ τελευτῆσαι λέγονται Μοντανός τε καὶ Μαξιμίλλα. τούτους γὰρ ὑπὸ πνεύματος βλαψίφρονος ἑκατέρους ὑποκινήσαντος, λόγος ἀναρτῆσαι ἑαυτούς·",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s6",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s6",
    "language": "grc",
    "text": "οὐχ’ ὁμοῦ κατὰ δὲ τὸν τῆς ἑκάστου τελευτῆς καιρὸν φήμη πολλή· καὶ οὕτω δὲ τελευτῆσαι καὶ τὸν βίον καταστρέψαι, Ἰούδα προδότου δίκην.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s7",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s7",
    "language": "grc",
    "text": "καθάπερ καὶ τὸν θαυμαστὸν ἐκεῖνον τὸν πρῶτον τῆς κατ’ αὐτοὺς λεγομένης προφητείας οἷον ἐπίτροπον τινὰ Θεόδοτον, πολὺς αἱρεῖ λόγος,",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s8",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s8",
    "language": "grc",
    "text": "ὡς αἰρόμενόν ποτε καὶ ἀναλαμβανόμενον εἰς οὐρανοὺς, παρεκστῆναί τε καὶ καταπιστεῦσαι ἑαυτὸν τῷ τῆς ἀπάτης πνεύματι· καὶ δισκευθέντα, κακῶς τελευτῆσαι.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s9",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s9",
    "language": "grc",
    "text": "φασὶ γοῦν τοῦτο οὕτω γεγονέναι. ἀλλὰ μὴ ἄνευ τοῦ ἰδεῖν ἡμᾶς ἐπίστασθαί τῶν τοιούτων νομίζομεν ὦ μακάριε.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.1.s10",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.1.s10",
    "language": "grc",
    "text": "ἴσως μὲν γὰρ οὕτως, ἴσως δὲ οὐχ’ οὕτως τετελευτήκασι Μοντανός τε καὶ Θεόδοτος καὶ ἡ προειρημένη γυνή.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.s1",
    "language": "grc",
    "text": "Καὶ μὴ λεγέτω ἐν τῷ αὐτῷ λόγῳ τῷ κατὰ Ἀστέριον Οὐρβανὸν τὸ διὰ Μαξιμίλλης πνεῦμα, διώκομαι ὡς λύκος ἐκ προβάτων· οὐκ εἰμὶ λύκος· ῥῆμα εἰμὶ καὶ πνεῦμα καὶ δύναμις.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.s2",
    "language": "grc",
    "text": "ἀλλὰ τὴν ἐν τῷ πνεύματι δύναμιν ἐναργῶς δειξάτω καὶ ἐλεγξάτω· καὶ ἐξομολογεῖσθαι διὰ τοῦ πνεύματος καταναγκασάτω τοὺς τότε παρόντας·",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.s3",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.s3",
    "language": "grc",
    "text": "εἰς τὸ δοκιμάσαι καὶ διαλεχθῆναι τῷ πνεύματι λαλοῦντι, ἄνδρας δοκίμους καὶ ἐπισκόπους, Ζωτικὸν ἀπὸ Κομάνης κώμης, καὶ Ἰουλιανὸν ἀπὸ Ἀπαμείας.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.s4",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.s4",
    "language": "grc",
    "text": "ὧν οἱ περὶ Θεμίσωνα τὰ στόματα φιμώσαντες, οὐκ εἴασαν τὸ ψευδὲς καὶ λαοπλάνον πνεῦμα ὑπ’ αὐτῶν ἐλεγχθῆναι.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.s5",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.s5",
    "language": "grc",
    "text": "ἐν ταυτῷ δὲ πάλιν ἕτερα μεταξὺ πρὸς ἔλεγχον τῶν τῆς Μαξιμίλλης ψυδοπροφητειῶν εἰπὼν, ὁμοῦ τόν τε χρόνον καθ’ ὃν ταῦτ’ ἔγραφε σημαίνει,",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.s6",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.s6",
    "language": "grc",
    "text": "καὶ τῶν προῤῥήσεων αὐτῆς μέμνηται, δι’ ὧν πολέμους ἔσεσθαι καὶ ἀκαταστασίας προεμαντεύσατο· ὧν καὶ τὴν ψευδολογίαν εὐθύνει ὧδε λέγων.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.1.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.1.s1",
    "language": "grc",
    "text": "Καὶ πῶς οὐ καταφανὲς ἤδη γέγονε καὶ τοῦτο τὸ ψεῦδος; πλείω γὰρ ἢ τρισκαίδεκα ἔτη εἰς ταύτην τὴν ἡμέραν, ἐξ οὗ τετελεύτηκεν ἡ γυνή·",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.2.2.1.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.2.2.1.s2",
    "language": "grc",
    "text": "καὶ οὔτε μερικὸς, οὔτε καθολικὸς κόσμῳ γέγονε πόλεμος· ἀλλὰ καὶ Χριστιανοῖς μᾶλλον εἰρήνη διάμονος ἐξ ἐλέους Θεοῦ.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.s1",
    "language": "grc",
    "text": "Ὅταν τοίνυν ἐν πᾶσι τοῖς εἰρημένοις ἐλεγχθέντες ἀπορήσωσιν, ἐπὶ τοὺς μάρτυρας καταφεύγειν πειρῶνται·",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.s2",
    "language": "grc",
    "text": "λέγοντες πολλοὺς ἔχειν μάρτυρας, καὶ τοῦτο εἶναι τεκμηρίον πιστὸν τῆς δυνάμεως τοῦ παρ’ αὐτοῖς λεγομένου προφητικοῦ πνεύματος. τὸ δέ ἐστιν ἄρα ὡς ἔοικε παντὸς μᾶλλον οὐκ ἀληθές.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.s3",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.s3",
    "language": "grc",
    "text": "καὶ γὰρ τῶν ἄλλων αἱρέσεων τινὲς, πλείστους ὅσους ἔχουσι μάρτυρας· καὶ οὐ παρὰ τοῦτο δήπου συγκαταθησόμεθα, οὐδὲ ἀλήθειαν ἔχειν αὐτοὺς ὁμολογήσομεν.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.s4",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.s4",
    "language": "grc",
    "text": "καὶ πρῶτοί γε οἱ ἀπὸ τῆς Μαρκίωνος αἱρέσεως Μαρκιωνισταὶ καλούμενοι, πλείστους ὅσους ἔχειν Χριστοῦ μάρτυρας λέγουσιν·",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.s5",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.s5",
    "language": "grc",
    "text": "ἀλλὰ τόν γε Χριστὸν αὐτὸν κατὰ ἀλήθειαν οὐχ’ ὁμολογοῦσι. καὶ μετὰ βραχέα τούτοις ἐπιφέρει λέγων·",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.1.s1",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.1.s1",
    "language": "grc",
    "text": "Ὅθεν τοι καὶ ἐπειδὰν οἱ ἐπὶ τὸ τῆς κατὰ ἀλήθειαν πίστεως μαρτύριον κληθέντες ἀπὸ τῆς ἐκκλησίας τύχωσι μετά τινων τῶν ἀπὸ τῆς τῶν Φρυγῶν αἱρέσεως λεγομένων μαρτύρων,",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.1.s2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.1.s2",
    "language": "grc",
    "text": "διαφέρονταί τε πρὸς αὐτοὺς, καὶ μὴ κοινωνήσαντες αὐτοῖς τελειοῦνται, διὰ τὸ μὴ βούλεσθαι συγκαταθέσθαι τῷ διὰ Μοντανοῦ καὶ τῶν γυναικῶν πνεύματι.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.1.1.s3",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.1.1.s3",
    "language": "grc",
    "text": "καὶ ὅτι τοῦτο ἀληθὲς, καὶ ἐπὶ τῶν ἡμετέρων χρόνων ἐν Ἀπαμείᾳ τῇ πρὸς Μαιάνδρῳ τυγχάνει γεγενημένον, ἐν τοῖς περὶ Γάϊον καὶ Ἀλέξανδρον ἀπὸ Εὐμενείας μαρτυρήσασι, πρόδηλον.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1131/tlg001/1st1K-grc1#tlg1131.tlg001.3.2",
    "work_id": "first1k/tlg1131/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1131.tlg001.3.2",
    "language": "grc",
    "text": "Ταῦτα (λέξεις τινὰς) εὑρὼν ἔν τινι συγγράμματι αὐτῶν ἐνισταμένων τῷ Μιλτιάδου τοῦ ἀδελφοῦ συγγράμματι, ἐν ᾧ ἀποδείκνυσι περὶ τοῦ μὴ δεῖν προφήτην ἐν ἐκστάσει λαλεῖν, ἐπετεμόμην.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
