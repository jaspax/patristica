[
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.hyp.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.hyp.s1",
    "language": "grc",
    "text": "Εστιν ἡ Ἐπιστολἠ περὶ φιλοξενίας. καὶ πρῶτον μὲν ἀποδέχεται τὸν Γάϊον μαρτυρούμενον παρὰ πάντων ἐπὶ φιλοξενίᾳ,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.hyp.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.hyp.s2",
    "language": "grc",
    "text": "καὶ προτρέπει τῇ αὐτῇ προθέσει ἐμμένειν καὶ προπέμπειν καὶ δεξιοῦσθαι τοὺς ἀδελφούς.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.hyp.s3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.hyp.s3",
    "language": "grc",
    "text": "πάλιν τὲ αὐτοῦ μὲν τὴν προφορὰν ἀποδέχεται· αἰτιᾶται δὲ Διοτρεφῆ, ὡς μήτε αὐτὸν παρέχοντα τοῖς πτωχοῖς, ἀλλὰ καὶ κωλύοντα τοὺς ἄλλους,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.hyp.s4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.hyp.s4",
    "language": "grc",
    "text": "καὶ πολλὰ φλυαροῦντα, τοὺς δὲ τοιούτους λέγει ἀλλοτρίους εἶναι τῆς ἀληθείας, καὶ μὴ εἰδέναι τὸν Θεόν. Δημήτριον δὲ συνίστησι μαρτυρῶν αὐτῶ τὰ κάλλιστα.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1",
    "language": "grc",
    "text": "Εὐχὴ ὑπὲρ τελειώσεως καὶ εὐχαριστίας ἐφ’ ὁμολογίᾳ φιλοξενίας a τῶν ἀδελφῶν διὰ Χριστόν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.1",
    "language": "grc",
    "text": "Ὁ πρεσβύτερος Γαΐῳ τῷ ἀγαπητῷ, ὃν ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ. ἀγαπητὲ, περὶ πάντων εὔχομαί σε εὐοδοῦσθαι καὶ ὑγιαίνειν, καθὼς εὐοδοῦταί σου ἡ ψυχή.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.2.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.2.s1",
    "language": "grc",
    "text": "Καὶ ταύτην τὴν Έπιστολὴν γράφει, συνιστῶν τινας ἀδελφούς· γράφει δὲ Γαίῳ· μαρτυρεῖ δὲ αὐτῷ φιλοξενίαν πολλὴν, ἣν καὶ μεγάλων ἐπαίνων ἀξιοῖ.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.2.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.2.s2",
    "language": "grc",
    "text": "τὸν γὰρ ἀγαθοποιοῦντα ἐκ τοῦ Θεοῦ εἰναι λέγει· πλεῖον δὲ αὐτὸν διεγείρει, καὶ ἐξ ὧν διαβάλλει τὸν μὴ τοῦτο ἐγνωκότα ποιεῖν Διοτρεφῆ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.2.s3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.2.s3",
    "language": "grc",
    "text": "ἐπαινεῖ δὲ καὶ Δημήτριον τὸ αὐτὸ πράσσοντα, καὶ μαρτυρίαν αὐτῷ τῆς ἀρετῆς παρέχεται πιστήν.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.2.s4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.2.s4",
    "language": "grc",
    "text": "σύντομος δὲ αὕτη ἡ Ἐπιστολὴ διὰ τὴν προειρημένην αἰτίαν ἐν τῇ β΄ Ἐπιστολῇ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.3.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.3.s1",
    "language": "grc",
    "text": "Ἐχάρην γὰρ λίαν, ἐρχομένων ἀδελφῶν καὶ μαρτυρούντων σου τῆ ἀληθείᾳ, καθὼς σὺ ἐν ἀληθείᾳ περιπατεῖς·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.3.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.3.s2",
    "language": "grc",
    "text": "μειζοτέραν τούτων οὐκ ἔχω χαρὰν, ἵνα ἀκούω τὰ ἐμὰ τέκνα ἐν ἀληθείᾳ περιπατοῦντα.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.3.s3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.3.s3",
    "language": "grc",
    "text": "ἀγαπητὲ, πιστὸν ποιεῖς ὃ ἐὰν ἐργάσῃ εἰς τοὺς ἀδελφοὺς καὶ εἰς τοὺς ξένους, οἳ ἐμαρτύρησάν σου τῆ ἀγάπῃ ἐνώπιον Ἐκκλησίας·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.3.s4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.3.s4",
    "language": "grc",
    "text": "οὓς καλῶς ποιήσεις προπέμψας ἀξίως τοῦ Θεοῦ. ὑπὲρ γὰρ τοῦ ὀνόματος ἐξῆλθον, μηδὲν λαμβάνοντες ἀπὸ τῶν ἐθνῶν·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.3.s5",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.3.s5",
    "language": "grc",
    "text": "ἡμεῖς οὖν ὀφείλομεν ἀπολαμβάνειν τοὺς τοιούτους, ἵνα συνεργοὶ γενώμεθα τῆ ἀληθείᾳ.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.4",
    "language": "grc",
    "text": "Παιδεύων ἡμᾶς μὴ ἀναμένειν τοὺς δεομένους πότε πρὸς ἡμᾶς ἔλθωσιν, ἀλλ’ αὐτοὺς ἐπιτρέχειν καὶ καταδιώκειν· οὕτως ὁ Λὼτ, οὕτως ὁ Ἀβραὰμ ἐποίησαν.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s1",
    "language": "grc",
    "text": "Μένει ἐν τῇ εὐαγγελικῇ διδασκαλίᾳ ὁ κατ’ αὐτὴν φρονῶν καὶ πράττων, ἀπάγει δὲ ἑαυτὸν ἀπ’ αὐτῆς ὁ ἐναντίως αὐτῆς ἐνεργῶν καὶ δοξάζων·",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s2",
    "language": "grc",
    "text": "εἶτα ἐπεὶ διὰ πρακτικοῦ καὶ θεωρητικοῦ γίνεταί τινος ὁ Θεὸς, ὁ τῶν ὅλων κτίστης, ὡς τοῦ Ἀβραὰμ, εἰπὼν αὐτῷ, “ ἐγὼ “ Θεὸς σός.’’",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s3",
    "language": "grc",
    "text": "ὁ ἔξω τῆς ὀρθῆς πίστεως καὶ τῆς τηρήσεως τῶν Χριστοῦ ἐντολῶν ἄθεος ἐστιν, ἑαυτὸν ἀποσχοινίσας τοῦ ἔχειν Θεόν.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s4",
    "language": "grc",
    "text": "ἀθέου δὲ ὄντος τοῦ ἀπαγαγόντος ἑαυτὸν τῆς θείας παιδεύσεως τῷ εἰρημένῳ τρόπῳ, ὁ μένων ἐν αὐτῇ Πατέρα καὶ Υἱὸν ἔχει.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s5",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s5",
    "language": "grc",
    "text": "ἐν τῷ γὰρ τηροῦντι τὸν λόγον αὐτοῦ, εἶπεν ὁ Υἱὸς, ἐλεύσεσθαι ἅμα τῷ Πατρὶ ἐπὶ τῷ μεῖναι παρ’ αὐτῷ, γενομένῳ ἁγίῳ ναῷ, οἰκοδομηθέντι ἐκ τηρήσεως τῶν θείων ἐντολῶν·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s6",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s6",
    "language": "grc",
    "text": "διττοῦ ὄντος τοῦ ἔχειν Θεόν τὸ μὲν ἕτερον κοινὸν πάντων τῶν κτισμάτων, ταὐτὸν σημαῖνον τὸ ἔχειν κτίστην·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s7",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s7",
    "language": "grc",
    "text": "τὸ δὲ ἕτερον λοιπὸν μόνων τῶν διὰ καλοκαγαθίας θερα- πευόντων αὐτόν· καθὸ σημαινόμενον “ Θεὸς Ἀβραὰμ καὶ Ἰσαὰκ “ καὶ Ἰακὼβ,” καὶ συνόλως τῶν Ἑβραίων εἴρηται.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s8",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s8",
    "language": "grc",
    "text": "ἐπίστησον καὶ τοῖς οὕτω λεχθησομένοις. “ ὁ ἔχων τὸν Υἱὸν,” φησὶ, “ καὶ τὸν “ Πατέρα ἔχει.’’",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s9",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s9",
    "language": "grc",
    "text": "καὶ ἔμπαλιν, ὡς πείθεσθαι ἐκ τούτου τῆς θεότητος τὸ ὁμοούσιον· ἐπεὶ γὰρ ὁ Πατὴρ ἐν Υἱῷ, ὁ ἔχων τὸν Υἱὸν, ἔχει καὶ τὸν Πατέρα.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s10",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s10",
    "language": "grc",
    "text": "ἀλλὰ καὶ πάλιν καὶ ἀντιστρέφει· ὁ ἔχων τὸν Πατέρα ἔχει καὶ τὸν Υἱὸν, ὄντα ἐν τῷ Πατρί.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s11",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s11",
    "language": "grc",
    "text": "εἴτις ἐνίστασθαι βουλόμενος λέγοι· καὶ ὁ τοὺς μαθητὰς ἔχων ἔχει τὸν Υἱὸν, καὶ ὁ τὸν Υἱὸν τὸν Πατέρα, κατὰ τὸ “ ὁ δεχόμενος ὑμᾶς ἐμὲ δέχεται,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s12",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s12",
    "language": "grc",
    "text": "καὶ ὁ ἐμὲ δεχόμενος δέχεται τὸν ἀποστείλαντά με. οὐχ ὃν δεῖ τρόπον ἐνιστάμενος· περὶ γὰρ διδασκαλίας εἴρηται ταῦτα·",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s13",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s13",
    "language": "grc",
    "text": "ἐπείπερ ὁ δεξάμενος τοὺς Ἀποστόλους, συγκαταθέσει τῇ πρὸς τὴν διδασκαλίαν, αὐτὸν ἐδέξατο, δι’ αὐτῶν Υἱὸν καὶ Πατέρα διδάσκοντας.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s14",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s14",
    "language": "grc",
    "text": "Καὶ ἑτέρως. Ἐπεὶ καὶ ὁ μένων ἐν τῇ διδαχῇ ἔχει τὸν Πατέρα καὶ τὸν Υἱὸν, ἔμενον δὲ οἱ Ἀπόστολοι ἐν τῇ διδαχῇ,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.5.s15",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.5.s15",
    "language": "grc",
    "text": "ὡς καὶ κηρύττειν αὐτὴν, ὁ δεξάμενος αὐτοὺς ὄντας ναὸν Θεοῦ, δι’ αὐτοῦ τοῦ δέχεσθαι αὐτοὺς, ἔχει τὸν ἐν αὐτοῖς Υἱὸν καὶ Πατέρα.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.6",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.6",
    "language": "grc",
    "text": "* Περὶ τῆς Διοτρεφοῦς φαυλότητος καὶ μισαδελφίας.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.7.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.7.s1",
    "language": "grc",
    "text": "Ἔγραψα ἂν τῇ ἐκκλησίᾳ· ἀλλ’ ὁ φιλοπρωτεύων αὐτῶν Διοτρεφὴς οὐκ ἐπιδέχεται ἡμᾶς.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.7.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.7.s2",
    "language": "grc",
    "text": "διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ, λόγοις πονηροῖς φλυαρῶν ἡμᾶς·",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.7.s3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.7.s3",
    "language": "grc",
    "text": "καὶ μὴ ἀρκούμενος ἐπὶ τούτοις, οὔτε αὐτὸς ἐπ’ ἐπιδέχεται τοὺς ἀδελφοὺς, καὶ τοὺς βουλομένους κωλύει, καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.7.s4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.7.s4",
    "language": "grc",
    "text": "ἀγαπητὲ, μὴ μιμοῦ τὸ κακὸν, ἀλλὰ τὸ ἀγαθόν· ὁ ἀγαθοποιῶν, ἐκ τοῦ Θεοῦ ἐστίν· ὁ κακοποιῶν, οὐχ ἑώρακε τὸν Θεόν.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s1",
    "language": "grc",
    "text": "Μηδεμιᾶς κοινωνίας οὔσης φωτὶ πρὸς σκότος, ἢ συμφωνίας Χριστοῦ πρὸς Βελίαρ, ὁ ἀγαθοποιῶν πρακτικῶς, Θεὸν τὸν Χριστὸν ἔχων ὑπάρχοντα φῶς ἀληθινὸν, πόρρω τοῦ σκότους καὶ τοῦ Βελίαρ ἐστίν.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s2",
    "language": "grc",
    "text": "ἀλλὰ καὶ ἐπεὶ ἐναντίον τὸ ἀγαθοποιεῖν τῷ ποιεῖν τὸ κακὸν, ὁ κακοποιὸς δι’ αὐτοῦ τοῦ οὕτως ἐνεργεῖν,",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s3",
    "language": "grc",
    "text": "ἐκ τοῦ Βελίαρ καὶ τοῦ σκότους ὣν, οὐχ ἑώρακε τὸν Θεὸν, οὐδὲ κατὰ πόσον γνῶσιν αὐτοῦ ἔχων.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s4",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s4",
    "language": "grc",
    "text": "“ πᾶς γὰρ ὁ ἁμαρτάνων, οὐχ ἑώρακε τὸν Θεὸν, οὐδὲ ἔγνωκεν “ αὐτόν·",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s5",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s5",
    "language": "grc",
    "text": "ἐπεὶ δὲ τὸ ὁρᾶν σῶμα ἣ μὴ ὁρᾶν, τῷ χρᾶσθαι ὄψει καὶ μὴ χρᾶσθαι γνωρίζεται ὁρωμένου τοῦ μαθητοῦ.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s6",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s6",
    "language": "grc",
    "text": "καὶ τῷ κακοποιοῦντι, ἐὰν ὄψιν ἔχῃ· μὴ βλεπομένου δὲ τοῦ στερουμένου ὄψεως, κἂν ἀγαθοποιὸς ᾖ· ἀντιρρήτως οὓς ἅμα δείκνυται·",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s7",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s7",
    "language": "grc",
    "text": "εἴγε ἀγαθοποιοῦντι, διὰ τὸ καθαρὰν καρδίαν ἔχειν, ὁρᾶται, καὶ ὄψεως λείπεται οὐχ ὁρώμενος τῷ κακοποιοῦντι, ὀξυωπέστατος b ᾖ,παρόσταται τὰ ἐναντία εἶναι,",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.1.8.s8",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.1.8.s8",
    "language": "grc",
    "text": "καὶ διὰ τοῦτο ἀσυνύπαρκτα τὸ κακοποιεῖν καὶ ἀγαθοποιεῖν· καὶ “ ἔκκλινον ἀπὸ κακοῦ καὶ ποίησον ἀγαθὸν, καὶ παραπλησίως γεγραμμενων.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.2",
    "language": "grc",
    "text": "Περὶ Δημητρίου ᾧ μαρτυρεῖ τὰ κάλλιστα.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.2.1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.2.1",
    "language": "grc",
    "text": "Δημητρίῳ μεμαρτύρηται ὑπὸ πάντων, καὶ ὑπ’ αὐτῆς τῆς ἀληθείας· καὶ ἡμεῖς δὲ μαρτυροῦμεν, καὶ οἶδας ὅτι ἡ μαρτυρία ἡμῶν ἀληθής ἐστι.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.2.2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.2.2",
    "language": "grc",
    "text": "Ὡς οἶμαι οὗτός ἐστιν ὁ τοὺς ἀργυροῦς ναοὺς ποιῶν τῆς Ἀρτεμίδος, ὁ στασίασας ποτὲ κατὰ Παύλου τοῦ Ἀποστόλου.",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.3",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.3",
    "language": "grc",
    "text": "Περὶ ἀφίξεως αὐτοῦ πρὸς αὐτοὺς ἐν τάχει ἐπ’ ὠφελείᾳ.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.3.1.s1",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.3.1.s1",
    "language": "grc",
    "text": "Πόλλα εἶχον γράφειν, ἀλλ’ οὐ θέλω διὰ μέλανος καὶ καλάμου σοι γράψαι· ἐλπίζω δὲ εὐθέως ἰδεῖν σε, καὶ στόμα πρὸς στόμα λαλήσομεν·",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.3.1.s2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.3.1.s2",
    "language": "grc",
    "text": "εἰρήνη σοι· ἀσπάζονταί σε οἱ φίλοι. ἀσπάζου τοὺς φίλους κατ’ ὄνομα. ἀμήν.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg045/1st1K-grc1#tlg4102.tlg045.3.2",
    "work_id": "first1k/tlg4102/tlg045/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg045.3.2",
    "language": "grc",
    "text": "Τέλος τῆς Ἰωάννου καθολικῆς γ΄ Ἐπιστολῆς.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
