[
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1",
    "language": "grc",
    "text": "Ἐκ Τῦν Οἰκουμενίωι τῶλ Μακαρίωι Θεσσαλίασ θεοφιλῶσ Πεπονημένων Εἰσ Ἰωάννορ τοῦ Θεολόγορ, Σύνοψισ Σκολικὴ Σύνοψισ Δεουσησ οσον κατα Συνοψιν Χριστὲ ὁ Θεὸσ σύμπραξον Ἠμῖν a.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s1",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s1",
    "language": "grc",
    "text": "Οτι καὶ τοῦτο τὸ σύγγραμμα ῥάμμα μύησις, τῆς ἀπὸ τοῦ ἐπὶ τὸ στῆθος ἀνακλἰσεως b τῆς ὑπερθέου σοφίας τοῦ ἠγαπημένου, ἅτε θεοπνεύστου ὃν καὶ ὠφέλιμον ἀναμφιλόγως, κατείληπται·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s2",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s2",
    "language": "grc",
    "text": "ἀλλ’ οὐ τῶν νόθων, ὥς τινες πλάνῳ συγχροτούμενοι πνεύματι ἐληρώδησαν, εἰ μὴ καὶ γνήσιον, καὶ τοῦ τῆς βροντῆς ἐπάξιον υἱοῦ.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s3",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s3",
    "language": "grc",
    "text": "εἴγε πιστέον Ἀθανασίῳ τῷ παμμεγίστῳ, ἐν τῇ ἐκθέσει τῶν κανονιζομένων τῆς παλαιᾶς τε καὶ νέας βιβλίων,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s4",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s4",
    "language": "grc",
    "text": "τοῖς γνησίοις καὶ τοῦτο ἐγκρίνοντἰ ἀλλὰ καὶ Βασιλείῳ τῷ θείῳ τοῦτο ἐν τῇ περὶ Υἱοῦ συζητήσει συντόμῳ ἔδειξε,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s5",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s5",
    "language": "grc",
    "text": "καὶ Γρηγορίῳ τῷ θείῳ τὸν λόγον ἐν τῷ συντακτηρίῳ αὐτοῦ λόγῳ· καὶ Μεθοδίῳ τῷ σοφωτάτῳ Ἐπισκόπῳ Πατάρων ἐν τῷ περὶ ἀναστάσεως·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s6",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s6",
    "language": "grc",
    "text": "Κυρίλλῳ τε τῷ μεγάλῳ, ἐν τοῖς περὶ τῆς ἐν πνεύματ’ προσκυνήσεως καὶ λατρείας αὐτοῦ πόνοις·",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s7",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s7",
    "language": "grc",
    "text": "πρὸς τούτοις καὶ Ἱππολύτῳ τῷ Ῥώμης προέδρῳ, ἐν τῇ τοῦ εἰς τὸν Δανιὴλ ἑρμηνείᾳ λόγου·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s8",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s8",
    "language": "grc",
    "text": "καὶ ἄλλοις δὲ πολλοῖς, ἵνα μὴ μακρολόγωμεν, οἷς εἰς νόθον καὶ ἀπόβλητον οὐκ ἔδοξεν ἀπερρῖφθαι, εἰ μὴ γνήσιον κριθῆναι·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s9",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s9",
    "language": "grc",
    "text": "οὐκ ἃν τοιούτοις καὶ τοσούτοις ἀκριβασιαῖς τοῦτο δοκοῦν, εἰ μὴ τὸ μέτριον αὐτῷ ᾔδεσαν σπουδαζόμενον·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.1.s10",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.1.s10",
    "language": "grc",
    "text": "εἰ γὰρ μὴ τοῦτο, μηδὲ τὸ ἔντριτον σπαρτίον κατὰ τὸν Ἐκκλησιάζοντα Σολομῶντα ἄρρηκτον μένον οὐ ταχέως διαρραγήσεται, πολλῷ ἃν τὸ ἑξάπλοκον.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s1",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s1",
    "language": "grc",
    "text": "Διὰ τῆς ἀποκαλύψεως οὖν ταύτης δείκνυσιν ὁ Χριστοῦ μαθητὴς, ὡς καὶ τὸ προφητικὸν καταπλουτεῖ χάρισμα,",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s2",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s2",
    "language": "grc",
    "text": "εἴπερ τῶν ἐνεστώτων καὶ τῶν παρῳχημένων τε καὶ μελλόντων γνῶσιν τὸ μετὰ χεῖρας σύγγραμμα θησαυρίζει·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s3",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s3",
    "language": "grc",
    "text": "ὣν καὶ πᾶσα ἐγκύμων προφητεία, ὃ καὶ τοῖς παρ’ ἡμῖν θυραυλοῦσιν ἐν λόγῳ σοφοῖς.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s4",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s4",
    "language": "grc",
    "text": "ἐπεὶ δέ τινες ηὐθαδίσαντο, ᾗ καὶ προλέλεκται νοθείας ἐγκλήματι τὸ θεοτελὲς τοῦτο χρησμῴδημα ἀχρειοῦν·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s5",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s5",
    "language": "grc",
    "text": "παρ’ ὅσον ὁ θεόληπτος οὗτος τοῦ λόγου πατὴρ εἰωθὸς αὐτῷ θεολογία σεμνύνειν τῶν θεοπρεπῶν αὐτοῦ τόκων τὴν ἐκ βαλβίδος b αὐτῶν, ὡς ἃν εἴποι τις, πρόοδον.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s6",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s6",
    "language": "grc",
    "text": "οὐ νῦν τοῦτο ποιεῖ· περὶ δὲ τὸ κἀς ἡμᾶς πρόσλημμα διὰ φιλανθρωπίαν ἄφατον τὴν περὶ ἡμᾶς, τὸ προοίμιον προσευκαιρεῖ.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s7",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s7",
    "language": "grc",
    "text": "ἀναγκαῖον ἐκεῖνο ἐρεῖν, ὡς ἀδιάφορον εἰδὼς τὸ περὶ τὸ ἓν καὶ τὸ αὐτὸ ὑπάρξαν τῇ ἀπορρήτῳ ἑνώσει τῶν συνελθόντων ὁπωσοῦν ἑκατέρως χρῆσθαι·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s8",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s8",
    "language": "grc",
    "text": "εἴτ’ ἀπὸ τῶν θειοτέρων τοῦ Σωτῆρος Χριστοῦ ἀρξάμενον, ἣ ἀπὸ τῶν ἀνθρωποπρεπῶν ἐν τοῖς πρώτοις αὐτοῦ γράμμασιν,",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s9",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s9",
    "language": "grc",
    "text": "ἀπὸ τῶν θεοπρεπεστέρω ἀρξάμενος ἐπὶ τὰ ἀνθρώπινά χωρεῖν οὐκ ἠνήνατο· ἀφ’ ὧν φάσκει “ καὶ ὁ Λόγος “ σὰρξ ἐγένετο,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s10",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s10",
    "language": "grc",
    "text": "ἐν τῷ μετὰ χεῖρας αὖθις συγγράμματι ἀπὸ τῶν ἀνθρωποπρεπῶν ἀρξάμενος, ὡς ἃν μὴ δόξαι ἀπὸ τῶν θειοτέρων μόνων αὐτὸν γινώσκειν,",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s11",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s11",
    "language": "grc",
    "text": "οὐ μέντοι καὶ ἀπὸ τῶν ἀνθρωπίνων οὐκ ἠνέσχετο τοῖς ἀνθρωποπρέπεσιν ἐπαναπαῦσαι τὸν λόγον, ἀλλὰ κἂν τούτοις τὰ θεοπρεπέστερα προσνέμειν c οὐ κατοκνεῖ.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s12",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s12",
    "language": "grc",
    "text": "δι’ ὧν καὶ τῷ ἀνθρωπίῳ d τοῦ Κυρίου τὰ ὑπὲρ ἄνθρωπον ἐνθεωρεῖσθαι βούλεται·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s13",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s13",
    "language": "grc",
    "text": "ὃ καὶ Παύλῳ τῷ θείῳ σκοπὸς ἐν τῇ πρὸς Κολοσσαεῖς e “ ἐν αὐτῷ, ” περὶ τοῦ Χριστοῦ φάσκοντι, “ ἐκτίσθη τὰ πάντα, “ τάτε f ἐν οὐρανῷ καὶ τὰ ἐπὶ γῆς·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s14",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s14",
    "language": "grc",
    "text": "πάντα δι’ αὐτοῦ ἔκτισται, “ καὶ αὐτός ἐστι πρὸ πάντων· καὶ τὰ πάντα ἐν αὐτῷ συνέστηκεν·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s15",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s15",
    "language": "grc",
    "text": "“ καὶ αὐτός ἐστιν ἡ κεφαλὴ τοῦ σώματος τῆς Ἐκκλησίας· ὅς ἐστιν ἀπάρχη πρωτότοκος ἐκ τῶν νεκρὼν, ἴνα γένηται ἐν πᾶσιν αὐτὸς πρωτεύων.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlgX01/1st1K-grc1#tlg4102.tlgX01.1.2.s16",
    "work_id": "first1k/tlg4102/tlgX01/1st1K-grc1",
    "canonical_ref": "tlg4102.tlgX01.1.2.s16",
    "language": "grc",
    "text": "ἡ προσληφθεῖσα γὰρ αὐτῷ g σὰρξ ἐψυχωμένη νοερῶς, ἵν ἐκ δύο φύσεων ἀσυγχύτως νοοῖτο ὁ Ἐμμανουὴλ, συνημμένων θεότητι καὶ ἀνθρωπότητι,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
