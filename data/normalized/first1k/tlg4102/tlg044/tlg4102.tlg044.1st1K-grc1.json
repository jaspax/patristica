[
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.hyp.s1",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.hyp.s1",
    "language": "grc",
    "text": "ΓΑΥΤΗΝ ὡς πρεσβύτερος γράφει κυρίᾳ τὲ καὶ τοῖς τέκνοις αὐτῆς. ἡ δὲ πρόφασις τῆς Ἐπιστολῆς αὕτη.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.hyp.s2",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.hyp.s2",
    "language": "grc",
    "text": "ὁρῶν τὰ τέκνα αὐτῆς καλῶς ἀναστρεφόμενα ἐν τῇ πίστει, καὶ πολλοὺς πλάνους περιερχομένους καὶ λέγοντας μὴ εἶναι τὴν παρουσίαν τοῦ Χριστοῦ ἐν σαρκὶ, γράφει τὴν Ἐπιστολήν·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.hyp.s3",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.hyp.s3",
    "language": "grc",
    "text": "καὶ πρῶτον μὲν ἀποδέχεται αὐτῆς τὰ τέκνα καλῶς περιπατοῦντα· εἶτα διδάσκων μὴ νεώτερον εἶναι τὸ καθ’ ἡμᾶς μυστήριον, παραινεῖ πάλιν περὶ ἀγάπης,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.hyp.s4",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.hyp.s4",
    "language": "grc",
    "text": "καὶ ἵνα μείνωσιν ἐν τῇ διδαχῇ τῇ παραδοθείσῃ αὐτοῖς· καὶ λοιπὸν διδάσκει Ἀντίχριστον εἶναι τὸν λέγοντα μὴ ἐν σαρκὶ ἐληλυθέναι τὸν Χριστόν·",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.hyp.s5",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.hyp.s5",
    "language": "grc",
    "text": "παραγγέλλει δὲ ὥστε τῶν τοιούτων μὴ δέχεσθαί τινα εἰς οἰκίαν, μηδὲ λέγειν τοῖς τοιούτοις χαίρειν· καὶ οὕτως τελειοῖ τὴν Ἐπιστολήν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1",
    "language": "grc",
    "text": "Μετὰ τὸ προοίμιον περὶ ὀρθοῦ βίου ἐν ἀγάπη Θεοῦ διὰ πίστεως εὐσεβοῦς ἀμεταθέτου.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.1.s1",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.1.s1",
    "language": "grc",
    "text": "Ὁ πρεσβύτερος ἐκλεκτῇ κυρίᾳ καὶ τοῖς τέκνοις αὐτῆς, οὓς ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ, καὶ οὐκ ἐγὼ μόνος,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.1.s2",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.1.s2",
    "language": "grc",
    "text": "ἀλλὰ καὶ πάντες οἱ ἐγνωκότες τὴν ἀλήθειαν, διὰ τὴν ἀλήθειαν τὴν μένουσαν ἐν ἡμῖν, καὶ μεθ’ ἡμῶν ἔσται εἰς τὸν αἰῶνα·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.1.s3",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.1.s3",
    "language": "grc",
    "text": "ἔσται μεθ’ ἡμῶν χάρις, ἔλεος, εἰρήνη, παρὰ Θεοῦ Πατρὸς, καὶ παρὰ Κυρίου Ἰησοῦ Χριστοῦ τοῦ Υἱοῦ τοῦ Πατρὸς, ἐν ἀληθείᾳ καὶ ἀγάπη.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.2",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.2",
    "language": "grc",
    "text": "Ἢ πρὸς Ἐκκλησίαν γράφει, ἣ πρός τινα γυναῖκα διὰ τῶν ευαγγελικῶν ἐντολῶν τὴν ἑαυτῆς οἰκίαν οἰκονομοῦσαν πνευματικῶς.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.3.s1",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.3.s1",
    "language": "grc",
    "text": "Ταύτην γράφει τὴν Ἐπιστολὴν μία τῶν δεξαμένων τὸ κήρυγμα γυναικῶν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.3.s2",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.3.s2",
    "language": "grc",
    "text": "δύο δὲ αὐτῇ παραινεῖ· ἓν μὲν τὸ ἐν ἀγάπῃ περιπατεῖν, δεύτερον δὲ τὸ ἐκτρέπεσθαι, ὡς μηδὲ τῆς προσηγορίας τοῦ χαίρειν μεταδιδόναι·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.3.s3",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.3.s3",
    "language": "grc",
    "text": "τὴν δὲ αἰτίαν τοῦ σύντομον εἶναι τὴν Ἐπιστολὴν αὐτὸς ἐδίδαξεν· αὕτη δέ ἐστι τῆς πρὸς αὐτὴν παρουσίας μήνυσις.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.4.s1",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.4.s1",
    "language": "grc",
    "text": "Ἐχάρην λίαν ὅτι εὕρηκα ἐκ τῶν τέκνων σου περιπατοῦντας ἐν ἀληθείᾳ, καθὼς ἐντολὴν ἐλάβομεν παρὰ τοῦ Πατρός.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.4.s2",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.4.s2",
    "language": "grc",
    "text": "καὶ νῦν ἐρωτῶ σε, κυρία, οὐχ ὡς ἐντολὴν καινὴν γράφων σοι, ἀλλ’ ἢν εἴχομεν ἀπ’ ἀρχῆς, ἵνα ἀγαπῶμεν ἀλλήλους.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.4.s3",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.4.s3",
    "language": "grc",
    "text": "καὶ αὕτη ἐστὶν ἡ ἀγάπη, ἵνα περιπατῶμεν κατὰ τὰς ἐντολὰς αὐτοῦ. καὶ αὕτη ἐστὶν ἡ ἐντολὴ, ἵνα καθὼς ἠκούσατε ἀπ’ ἀρχῆς, ἐν αὐτῇ περιπατῆτε·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.4.s4",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.4.s4",
    "language": "grc",
    "text": "ὅτι πολλοὶ πλάνοι ἐξῆλθον εἰς τὸν κόσμον, οἱ μὴ ὁμολογοῦντες Ἰησοῦν Χριστὸν ἐρχόμενον ἐν σαρκί· οὗτός ἐστιν ὁ πλάνος καὶ ὁ ἀντίχριστος.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.4.s5",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.4.s5",
    "language": "grc",
    "text": "βλέπετε ἑαυτοὺς, ἵνα μὴ ἀπολέσητε ἃ εἰργάσασθε, ἀλλὰ μισθὸν πλήρη ἀπολάβητε.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.4.s6",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.4.s6",
    "language": "grc",
    "text": "πᾶς ὁ παραβαίνων, καὶ μὴ μένων ἐν τῆ διδαχῇ τοῦ Χριστοῦ, Θεὸν οὐκ ἔχει· ὁ μένων ἐν τῇ διδαχῇ τοῦ Χριστοῦ, οὗτος καὶ τὸν Πατέρα καὶ τὸν Υἱὸν ἔχει.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s1",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s1",
    "language": "grc",
    "text": "Συμφωνεῖ τὸ προκείμενον τῷ λεχθέντι ἐν τῇ ᾱ Ἐπιστολῇ οὕτως ἔχοντι· “ καὶ οἴδαμεν, ὅτι ὁ ἀγαπῶν τὸν Θεὸν τὰς ἐντολὰς τηρεῖ.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s2",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s2",
    "language": "grc",
    "text": "καὶ ὁ Κύριος, “ ἐάν τις ἀγαπᾷ με, τὰς ἐντολάς μου τηρήσει.” ταὐτὸν τὸ περιπατεῖν κατὰ τὰς ἐντολὰς ἐνεργούμεναι. περιπατεῖ κατ’ αὐτὰς, ὁ μὴ ἔξω αὐτῶν γινόμενος.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s3",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s3",
    "language": "grc",
    "text": "ἐν τούτῳ δὲ ταὐτὸν τὸ τηρεῖσθαι αὐτὰς, ὅθεν ὁ παυσάμενος τοῦ κατ’ ἀρετὴν ἐνεργεῖν, οὐδὲ τηρεῖ ἔτι τὰς ἐντολὰς, οὔτε περιπατεῖ ἔτι κατ’ αὐτάς.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s4",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s4",
    "language": "grc",
    "text": "ὁ γὰρ κατ’ ἀρετὴν προκόπτων, κατὰ τὰς ἐντολὰς βαδίζει· τοῦ περιπατεῖν προκοπὴν δηλοῦντος.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s5",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s5",
    "language": "grc",
    "text": "τοῦ τελειωθέντος μετὰ τὸ περιπατηκέναι κατὰ τὰς ἐντολὰς τηροῦντος αὐτάς.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s6",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s6",
    "language": "grc",
    "text": "τοῦτο συνᾴδει τὸ μετ’ αἰνιγμοῦ λεχθὲν, ὡς ὁ Ἀδὰμ τέθειται ἐν τῷ παραδείσῳ ἐργάζεσθαι καὶ φυλάττειν αὐτόν·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.5.s7",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.5.s7",
    "language": "grc",
    "text": "τοῦ ἐργάζεσθαι τὴν κατ’ ἐνέργειαν δηλοῦντος προκοπὴν, τοῦ δὲ φυλάττειν τὴν ἐν τῇ τελειώσει παραμονήν.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg4102/tlg044/1st1K-grc1#tlg4102.tlg044.1.6",
    "work_id": "first1k/tlg4102/tlg044/1st1K-grc1",
    "canonical_ref": "tlg4102.tlg044.1.6",
    "language": "grc",
    "text": "* Ὅτι οὐ δεῖ αἱρετικὸν εἰσοικίζειν ἣ χαιρετίζειν ἐφ’ ἁμαρτίᾳ.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
