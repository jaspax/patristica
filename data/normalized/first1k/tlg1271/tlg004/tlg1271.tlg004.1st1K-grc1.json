[
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.1.s1",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.1.s1",
    "language": "grc",
    "text": "Ἀναγνοὺς οὖν ὁ Ιάκωβος τὴν ἐπιστολὴν μετεκαλέσατο τοὺς πρεσβυτέρους, καὶ αὐτοῖς ἀναγνοὺς ἔφη· ἀναγκαίως καὶ πρεπόντως περὶ τῆς ἀληθείας ἀσφαλίζεσθαι ὁ ἡμέτερος ὑπέμνησε Πέτρος,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.1.s2",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.1.s2",
    "language": "grc",
    "text": "ὅπως τὰς τῶν αὐτοῦ κηρυγμάτων διαπεμφηθείσας ἡμῖν βίβλες μηδενὶ μεταδώσωμεν ὡς ἔτυχεν, ἢ ἀγαθῷ τινὶ καὶ εὐλαβεῖ, τῷ καὶ διδάσκειν αἱρεμένῳ ἐμπεριτόμῳ τε ὄντι πιστῷ.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.1.s3",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.1.s3",
    "language": "grc",
    "text": "καὶ ταῦτα μὴ πάντα ὁμοῦ, ἵνα ἐὰν ἐν τοῖς πρώτοις ἀγνώμων φωραθῇ, τὰ δεύτερα μὴ πιστευθῇ. διὸ μὴ ἔλαττον ἔτεσιν ἔξ δοκιμαζέσθῳ·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.1.s4",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.1.s4",
    "language": "grc",
    "text": "καὶ εἴθ᾽ οὕτως, κατὰ τήν Μωϋσέως ἀγωγὴν , ἀγαγόντα αὐτὸν ἐπὶ ποταμὸν ἢ πηγὴν, ὅπερ ἐστὶν ζῶν ὕδωρ, ἔνθα ἡ δικαίων γίνεται ἀναγέννησις, μὴ ὁρκίσαι,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.1.s5",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.1.s5",
    "language": "grc",
    "text": "ἐπεὶ μὴ ἔξεστιν, ἀλλὰ στῆναι αὐτῷ κελεῦσαι πρὸς τῷ ὕδατι καὶ ἐπιμαρτύρασθαι, ὡς καὶ αὐτοὶ ἀναγεννώμενοι κελευσθέντες ἐποιήσαμεν τοῦ μὴ ἁμαρτεῖν χάριν.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.2.s1",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.2.s1",
    "language": "grc",
    "text": "Λεγέτω δέ· μάρτυρας ἔχομι οὐρανόν, γῆν, ὕδωρ, ἐν οιἷς τὰ πάντα περιέχεται, πρὸς τούτοις δὲ ἅπασιν καὶ τὸν διὰ πάντων διήκοντα ἀέρα, οὗ ἄνευ οὐκ ἀναπνέω,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.2.s2",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.2.s2",
    "language": "grc",
    "text": "ὡς ἀεὶ ὑπήκοος ἔσομαι τῷ τὰς βίβλους μου τῶν κηρυγμάτων διδόντι, καὶ αὐτάς μου τάς βίβλους, ἃς ἄν μοι δῷ, οὐ μὴ μεταδῶ τινὶ κατ᾽ οὐδένα τρόπον,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.2.s3",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.2.s3",
    "language": "grc",
    "text": "οὐ γράψας, οὐ γεγραμμένον δούς, οὐ γράφοντι ἀναδιδούς, οὐκ αὐτός, οὐ δὶ ἄλλου, οὐ δὲ ἄλλης τινὸς ἀγωγῆς ἢ δόλου ἢ μηχακνῆς,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.2.s4",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.2.s4",
    "language": "grc",
    "text": "ἢ ἀμελῶς φυλάσσων ἥ τι προστιθεὶς ἢ νοθεύων ἢ ἄλλῳ οἱῳδήποτε τρόπῳ ἢ ἐπινοίᾳ ἑτέρῳ αὐτὰ μεταδιδούς.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.2.s5",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.2.s5",
    "language": "grc",
    "text": "πλὴν ἂν δοκιμάσω τινὰ ἄξιον, ὡς αὐτὸς ἐκρίθην, ἢ καὶ πλεῖον δοκιμάσας, πλὴν οὐκ ἔλαττον ἔτεσιν ἕξ᾽·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.2.s6",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.2.s6",
    "language": "grc",
    "text": "τότε εὐλαβεῖ καὶ ἀγαθῷ, διδάσκειν ἐπαναιρουμένῳ, ὡς παρέλαβον παραδώσω, καὶ ταῦτα ἐπὶ τῇ τοῦ ἐπισκόπου γνώμῃ ποιησάμενος.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.3.s1",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.3.s1",
    "language": "grc",
    "text": "Ἄλλως δὲ ἐδ᾽ ἄν τέκνον ἢ ἀδελφὸς ἢ φίλος ἢ ἄλλως πώς ποτε γένες μοι ἀνήκων, ἐάνπερ ἀνάξιος ἢ, τοῦδε μὴ μεταδοῦναι χάριν, ὡς οὐ προσῆκεν.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.3.s2",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.3.s2",
    "language": "grc",
    "text": "οὔτε ἐπιβουλὴν φοβηθήσομαι, οὐ δώροις κολακενθήσομαι· ἀλλ᾽ εἰ καὶ δόξειέν μοί ποτε τὰ διδόμενά μοι τῶν κηρυγμάτων βιβλία μὴ ἀληθῆ εἶναι, ἐδ᾽ οὕτως μεταδώσω, ἀλλ᾽ ἀποδώσω.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.3.s3",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.3.s3",
    "language": "grc",
    "text": "ἀποδημῶν δὲ σὺν ἐμοὶ αὐτὰ κομίσω, ἅπερ ἄν τύχω κεκτημένος.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.3.s4",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.3.s4",
    "language": "grc",
    "text": "εἰ δὲ μὴ βουληθῶ μετ᾽ ἐμαυτοῦ αὐτὰ περιφέρειν, ἐπὶ τῆς οἰκίας με εἰναι αὐτὰ ἐκ ἐάσω, ἀλλὰ τῷ ἐπισκόπῳ μου τῷ τὴν αὐτὴν ἔχοντι πίστιν καὶ ἀπὸ τῶν αὐτῶν ὁρμωμένῳ παρακαταθήσομαι.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.3.s5",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.3.s5",
    "language": "grc",
    "text": "εἰ δὲ καὶ τύχοι με νοσῆσαι καὶ τόν θάνατον ὑποπτεῦσαι, ἐὰν ἄτεκνος ὦ, ὁμοίως ποιήσω. ἀλλ᾽ εἰ καὶ τελευτῶ τέκνον ἔχων ἐκ ἄξιον ἢ μηδέπω δυνάμενον, ὁμοίως ποιήσω.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.3.s6",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.3.s6",
    "language": "grc",
    "text": "τῷ γὰρ ἐπισκόπῳ μου παρακαταθήσομαι, ἵνα εἰ μὲν τύχοι ἐφ᾽ ἡλικίας γενόμενος ἄξιος εἶναι τῆς πίστεως, ὡς πατρῴαν παρακαταθήκην τῷ τέκνῳ ἀποδόσῃ, κατὰ τὸν τῆς διαμαρτυρίας λόγον.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.4.s1",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.4.s1",
    "language": "grc",
    "text": "Ὅτι δὲ οὕτως ποιήσω, πάλιν τὸ δεύτερον διαμαρτύρομαι ἐρανόν, γῆν, ὕδωρ, ἐν οἷς τὰ πάντα περιέχεται, πρὸς τούτοις ἅπασιν καὶ τὸν διὰ πάντων διήκοντα ἀέρα,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.4.s2",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.4.s2",
    "language": "grc",
    "text": "οὗ ἄνευ οὐκ ἀναπνέω, ὡς ἀεὶ ὑπήκοος ἔσομαι τῷ τὰς βίβλους μου τῶν κηρυγμάτων διδόντι, καὶ φυλάξω κατὰ πάντα ὅσα διεμαρτυράμην, εἰ καί τι πλεῖον.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.4.s3",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.4.s3",
    "language": "grc",
    "text": "φυλάσσοντι οὖν μοι τὰς συνθήκας μέρος ἔσται μετὰ τῶν ὁσίων, ποιήσαντι δὲ παρ᾽ ἅ συνεθέμην, ἐχθρὸν εἴη μοι τὸ πᾶν καὶ ὁ διὰ πάντων διήκων αἰθὴρ καὶ ὁ ὑπὲρ τά ὅλα Θεὸς, οὗ κρείττων, οὗ μείζων ἐδ᾽ εἶς.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.4.s4",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.4.s4",
    "language": "grc",
    "text": "ἀλλ᾽ εἰ καὶ εἰς ἑτέρου Θεοῦ ὑπόνοιαν γένωμαι, κᾀκεῖνον νῦν ὄμνυμι ὡς οὐκ ἄλλως ποιήσω, εἴτ᾽ ἐστὶν, εἰτ᾽ ἐκ ἔστν·",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.4.s5",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.4.s5",
    "language": "grc",
    "text": "πρὸς τέτοις δὲ ἅπασιν εἰ ψεύσομαι, κατάθεμα ἔσομαι ζῶν καὶ θανὼν καὶ αἰωνίῳ κολασθήσομαι κολάσει. καὶ μετὰ τοῦτο ἄρτου καὶ ἅλατος μετὰ τοῦ παραδιδόντος μεταλαβέτω.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.5.s1",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.5.s1",
    "language": "grc",
    "text": "Ταῦτα τοῦ Ἰακώβου εἰπόντος ὠχρίασαν ἀγωνιάσαντες οἱ πρεσβύτεροι. συνιδὼν οὖν ὁ Ἰάκωβος, ὅτι λίαν πεφόβηνται, ἔφη· ἀκούσατέ μου, ἀδελφοὶ καὶ σύνδουλοι.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.5.s2",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.5.s2",
    "language": "grc",
    "text": "ἐὰν τὰς βίβλους πᾶσιν ὡς ἔτυχεν παρασχῶμεν, καὶ αὐταὶ ὑπὸ τολμηρῶν ἀνδρῶν τινῶν νοθευθῶσιν ἢ ταῖς ἑρμηνείαις διαστραφῶσιν,",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.5.s3",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.5.s3",
    "language": "grc",
    "text": "ὡς ἤδη τινὰς ἤκουσατε πεποιηκότας, ἔσται λοιπὸν καὶ τοῖς ὄντως τὴν ἀλήθειαν ζητοῦσιν ἀεὶ πλανᾶσθαι.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg004/1st1K-grc1#tlg1271.tlg004.5.s4",
    "work_id": "first1k/tlg1271/tlg004/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg004.5.s4",
    "language": "grc",
    "text": "διὰ ἄμεινον παρ᾽ ἡμῖν αὐτὰς εἶναι, καὶ μεταδιδόναι μετὰ πάσης τῆς προειρημένης ἀσφαλείας τοῖς θέλουσι ζῆν καὶ ἄλλους σώζειν.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
