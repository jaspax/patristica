[
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.1.s1",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.1.s1",
    "language": "grc",
    "text": "Ειδως σε, ἀδελφέ μου, εἰς τὸ κοινῇ πᾶσιν ἡμῖν συμφέρον σπεύδοντα προθύμως ἀξιῶ καὶ δέομαι, τῶν ἐμῶν κηρυγμάτων ἃς ἔπεμψά σοι βίβλους μηδενὶ τῶν ἀπὸ τῶν ἐθνῶν μεταδοῦναι μήτε ὁμοφύλῳ πρὸ πείρας,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.1.s2",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.1.s2",
    "language": "grc",
    "text": "ἀλλ᾽ ἐάν τις δοκιμασθεὶς ἄξιος εὑρεθῇ, τότε αὐτῷ κατὰ τὴν ἀγωγὴν παραδοῦναι, καθ᾽ ἣν καὶ τοῖς ἑβδομήκοντα ὁ Μωϋσῆς παρέδωκε τοῖς τὴν καθέδραν αὐτοῦ παρειληφόσιν.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.1.s3",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.1.s3",
    "language": "grc",
    "text": "διὰ τοῦτο καὶ ὁ καρπὸς τῆς ἀσφαλείας μέχρι τοῦ δεῦρο φαίνεται.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.1.s4",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.1.s4",
    "language": "grc",
    "text": "τὸν γὰρ αὐτὸν οἱ πανταχῆ ὁμόεθνοι τῆς μοναρχίας καὶ πολιτείας φυλάσσεσι κανόνα, κατὰ μηδένα τρόπον ἄλλως φρονεῖν ὑπὸ τῶν πολλὰ νευεσῶν γραφῶν ἐξοδευθῆναι δυνηθέντες.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.1.s5",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.1.s5",
    "language": "grc",
    "text": "κατὰ γὰρ τὸν παραδοθέντα αὐτοῖς κανόνα τὰ τῶν γραφῶν ἀσύμφωνα πειρῶνται μεταῤῥυθμίζειν, εἰ δή τις τυχὸν μὴ εἰδὼς τὰς παραδόσεις ναρκᾷ πρὸς τὰς τῶν προφητῶν πολυσήμες φωνάς·",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.1.s6",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.1.s6",
    "language": "grc",
    "text": "οὗ ἕνεκεν οὐδενὶ διδάσκειν ἐπιτρέπεσιν , ἐὰν μὴ πρότερον μάθοι, πῶς δεῖ ταῖς γραφαῖς χρῆσθαι· διὰ τοῦτο παρ᾽ αὐτοῖς εἷς Θεὸς, εἷς νόμος, μία ἐλπίς.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s1",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s1",
    "language": "grc",
    "text": "Ἵνα τὸ ὅμοιον καὶ παρ᾽ ἡμῖν γένηται τοῖς ἑβδομήκοντα, ἡμων ἀδελφοῖς τὰς βίβλους μου τῶν κηρυγμάτων δὸς μετὰ τοῦ ὁμοίου τῆς ἀγωγῆς μυστηρίου,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s2",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s2",
    "language": "grc",
    "text": "ἵνα καὶ τοὺς βουλομένους τὸ τῆς διδασκαλίας ἀναδέξασθαι μέρος ἐφοδιάζωσιν· ἐπεὶ ἐὰν μὴ οὕτως γένηται, εἰς πολλὰς γνώμας ὁ τῆς ἀληθείας ἡμῶν διαιρεθήσεται λόγος.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s3",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s3",
    "language": "grc",
    "text": "τοῦτο δὲ οὐχ ὡς προφήτης ὥν ἐπίσταμαι· ἀλλ᾽ ἤδη αὐτοῦ τοῦ κακοῦ τὴν ἀρχὴν ὁρῶν.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s4",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s4",
    "language": "grc",
    "text": "τινὲς γὰρ τῶν ἀπὸ ἐθνῶν τὸ δἰ ἐμοῦ νόμιμον ἀπεδοκίμασαν κήρυγμα, τοῦ ἐχθροῦ ἀνθρώπου ἄνομόν τινα καὶ φλυαρώδη προσηκάμενοι διδασκαλίαν.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s5",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s5",
    "language": "grc",
    "text": "καὶ ταῦτα ἔτι μου περιόντος ἐπεχειρησάν τινες, ποικίλαις τισὶν ἑρμηνείαις τοὺς ἐμοὺς λόγους μετασχηματίζειν, εἰς τὴν τοῦ νόμου κατάλυσιν·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s6",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s6",
    "language": "grc",
    "text": "ὡς καὶ ἐμοῦ αὐτοῦ οὕτω μὲν φρονοῦντος, μὴ ἐκ παῤῥησίας δὲ κηρύσσοντος· ὅπερ ἀπείῃ.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s7",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s7",
    "language": "grc",
    "text": "τὸ γὰρ τοιοῦτο ἀντιπράσσειν ἐστὶ τῷ τοῦ Θεοῦ νόμῳ τῷ διὰ Μωϋσέως ῥηθέντι καὶ ὑπὸ τοῦ κυρίου ἡμῶν μαρτυρηθέντι περὶ τῆς ἀϊδίου αὐτοῦ διαμονῆς.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s8",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s8",
    "language": "grc",
    "text": "ἐπεὶ οὕτως εἶπεν· ὁ οὐρανὸς καὶ ἡ γῆ παρελεύσονται ἰῶτα ἕν ἢ μία κεραία οὐ μὴ παρέλθῃ ἀπὸ τοῦ νόμου. Τοῦτο δὲ εἴρηκεν, ἵνα τὰ πάντα γίνηται.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s9",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s9",
    "language": "grc",
    "text": "οἱ δὲ οὐκ οἶδα πῶς τὸν ἐμὸν νοῦν ἐπαγγελλόμενοι, οὕς ἤκουσαν ἐξ ἐμοῦ λόγους ἐμοῦ τοῦ εἰπόντος αὐτοὺς φρονιμώτερον ἐπχειροῦσιν ἑρμηνεύειν,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s10",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s10",
    "language": "grc",
    "text": "λέγοντες τοῖς ὑπ᾽ αὐτῶν κατηχουμένοις, τοῦτο εἶναι τὸ ἐμὸν φρόνημα, ὅ ἐγὼ οὐδὲ ἐνεθυμήθην.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.2.s11",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.2.s11",
    "language": "grc",
    "text": "εἰ δὲ ἐμοῦ ἔτι περιόντος τοιαῦτα τολμῶσιν καταψεύδεσθαι, πόσῳ γε μᾶλλον μετ᾽ ἐμὲ ποιεῖν οἱ μετ᾽ ἐμὲ τολμήσουσιν;",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.3.s1",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.3.s1",
    "language": "grc",
    "text": "Ἵνα οὖν μὴ τοιοῦτόν τι γένηται, τούτου ἕνεκα ἠξίωσα καὶ ἐδεήθην, τῶν ἐμῶν κηρυγμάτων ἃς ἔπεμψά σοι βίβλους μηδενὶ μεταδοῦναι, μήτε ὁμοφύλῳ μήτε ἀλλοφύλῳ, πρὸ πείρας,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.3.s2",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.3.s2",
    "language": "grc",
    "text": "ἀλλ᾽ ἐάν τις δοκιμασθεὶς ἄξιος εὑρεθῇ, τότε αὐτῷ κατὰ τὴν Μωϋσέως ἀγωγὴν παραδοῦναι, καθ᾽ ἥν τοῖς ἑβδομήκοντα παρέδωκε τοῖς τὴν καθέδραν αὐτοῦ παρειληφόσιν·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.3.s3",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.3.s3",
    "language": "grc",
    "text": "ἵνα οὕτως τὰς πίστεις φυλάξωσιν καὶ πανταχῆ τὸν τῆς ἀληθείας κανόνα παραδῶσιν, ἑρμηνεύοντες τὰ πάντα πρὸς τὴν παράδοσιν ἡμῶν,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.3.s4",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.3.s4",
    "language": "grc",
    "text": "καὶ μὴ αὐτοὶ ὑπ᾽ ἀμαθείας κατασπώμενοι, ὑπὸ τῶν κατὰ τὴν ψυχὴν στοχασμῶν εἰς πλάνην ἑλκόμενοι, ἄλλους εἰς τὸν ὅμοιον τῆς ἀπωλείας ἐνέγκωσιν βόθυνον.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1271/tlg003/1st1K-grc1#tlg1271.tlg003.3.s5",
    "work_id": "first1k/tlg1271/tlg003/1st1K-grc1",
    "canonical_ref": "tlg1271.tlg003.3.s5",
    "language": "grc",
    "text": "καὶ τὰ μὲν ἐμοὶ δόξαντα καλῶς ἐσήμανά σοι, τὸ δέ σοι δοκοῦν, κύριέ μου, πρεπόντως ἐπιτέλει. ἔῤῥωσο.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
