[
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.1.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.1.s1",
    "language": "grc",
    "text": "Σὺ, καὶ πᾶς ὁ λαὸς οὗτος, Τοῖς φυλάσσουσι τὸν νόμον ὑπέσχετο διδόναι ἂ προείρηκεν· οὐ γὰρ Ἰησοῦ τῷ Ναυῆ.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.1.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.1.s2",
    "language": "grc",
    "text": "Μὴ φυλάξαντες γὰρ οἱ Ἰσραηλῖται οὐκ ἕλαβον, ὡς δηλοῖ τὰ ἑξῆς.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.2.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.2.s1",
    "language": "grc",
    "text": "Πᾶς ὁ τόπος ἐφʼ ᾧ ἂν ἐπιβῆτε. Ἀντέστηπαν οἱ ἐπὶ τῆς Γαῒ διὰ τὴν τοῦ Ἀχὰρ παρανομίαν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.2.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.2.s2",
    "language": "grc",
    "text": "Καὶ ἄλλως· Ὅτι τοῦ Θεοῦ παραδόντος εἰς χεῖρας αὐτῶν τὰ ἕθνη οὐκ ἐξωλόθ ρευσαν, καὶ ἐγενήθησαν, εἰς σκόλοπα αὐτοῖς.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.3.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.3.s1",
    "language": "grc",
    "text": "Καὶ εἰσήλθοσαν εἰς οἰκίαν γυναικός πόρνης, ὄνομα Ῥαάβ. Πόρνῃ πιστεύουσιν οἱ κατάσκοποι τὴν ἑαυτῶν σωτηρίαν· καὶ μάλα εἰκότως.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.3.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.3.s2",
    "language": "grc",
    "text": "Δείκτυται γὰρ ἐξ ὧν ἡ πόρνη διαλέγεται, μόνη πιστὴ καὶ τὸν Θεὸν φοβουμένη· διὸ καὶ διʼ αὐτῆς ἡ συγγένεια σώζεται.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.4",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.4",
    "language": "grc",
    "text": "Τοῦ αὐτοῦ. Ῥαὰβ ἑρμηνεύεται πλατυσμὸς, σύμβολον οὗσα τὴς ἀπὸ τῶν ἐθνῶν Ἐκκλησίας λεγούσης· « Στενός μοι ὁ τόπος, ποίησόν μοι τόπον ἵνα οἰκήσω. »",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.5",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.5",
    "language": "grc",
    "text": "Τοῦ αὐτοῦ. Οὐκ ἐκ τῆς δεξιώσεως μόνης σώζεται, ἀλλὰ προηγουμένως ἀπὸ τῆς πίστεως καὶ τῆς πρὸς τὸν Θεὸν διαθέσεως.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.6.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.6.s1",
    "language": "grc",
    "text": "Καὶ ἔκρυψεν αὐτοὺς ἐν τῇ λινοκαλάμῃ.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.6.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.6.s2",
    "language": "grc",
    "text": "Τοῖς ξύλοις αὐτοὺς ἔκρυψε τῆς λινοκαλάμης οἷς εἶχεν ἐπὶ τοῦ δώματος ἑτοιμάζουσα ἐργάζεσθαι τὴν βύσσον αὐτοῖς ὡς ἀξίοις οὖσιν ἐνδύματος ἀρχιερατικοῦ.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.6.s3",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.6.s3",
    "language": "grc",
    "text": "Ἡ γὰρ λινοκαλάμη ποιεῖ τὴν βύσσον ἐξ ἧς τὸ ἱερατικὸν ἔνδυμα γίνεται.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.7.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.7.s1",
    "language": "grc",
    "text": "Καὶ κατεχάλασεν αὐτοὺς διὰ τῆς θυρίδος. Ἰστέον ὅτι ὁ οἶκος αὐτῆς ἐν τῷ τείχει ἦν. Ἀδελφὰ τῆς παλαιᾶς τὰ νέα·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.7.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.7.s2",
    "language": "grc",
    "text": "ὅμοιον γάρ ἐστι τὸ ἐπὶ τοῦ Παύλου, ὅτε ἐχάλασαν αὐτὸν ἐν σαργάνῃ διὰ τοῦ τείχους.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.8.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.8.s1",
    "language": "grc",
    "text": "Τοῦ αὐτοῦ. Ὁ Ἀπόστολος δεύτερον ἐσώθη ἀπὸ τῶν ἐχθρῶν ὁμοιοτρόπως, ὥς φησιν ἐν τῇ δευτέρᾳ πρὸς Κορινθίους αὐτοῦ Ἐπιστολῇ·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.8.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.8.s2",
    "language": "grc",
    "text": "« Καὶ διὰ θυρίδος ἐν σαργάνῃ ἐχαλάσθην διὰ τοῦ τείχους, καὶ ἐξέφυγον. » Πάλιν ἐν ταῖς Πράξεσι·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.8.s3",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.8.s3",
    "language": "grc",
    "text": "« Παρετηροῦντο δὲ καὶ τὰς πύλας ἡμέρας καὶ νυκτὸς, ὅπως αὐτὸν ἀνέλωσι· λαβόντες δὲ οἱ μαθηταὶ αὐτοῦ νυκτὸς, τοῦ τείχους καθῆκαν αὐτὸν, χαλάσαντες ἐν σπυρίδι. »",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.9.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.9.s1",
    "language": "grc",
    "text": "Καὶ κατέμειναν ἐκεῖ τρεῖς ἠμέρας. Οὐχ ὅτ τριῶν ἡμερῶν ἦν ἡ ὁδός· πάνυ γὰρ πλησίον ὁ Ἰορδάνης τῆς Ἰεριχὼ, ἀλλὰ διὰ τὴν τῶν κατασκόπων ἀκριβῆ ἐξέτασιν.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.9.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.9.s2",
    "language": "grc",
    "text": "« Ἐζήτησαν γὰρ, φησὶν, οἱ καταδιώκοντες πάσας τὰς ὀδοὺς, καὶ οὐχ εὗρον. »",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.10",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.10",
    "language": "grc",
    "text": "« Τετράκις μύριοι εὔζωνοι. Σημειωτέον ὅτι ἡ τετρὰς, εἴτε μονάδων, εἴτε ἑκατοντάδων, εἴτε ἑτέρου πλείονος ἀριθμοῦ, ἐπὶ κακώσεως κεῖται.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s1",
    "language": "grc",
    "text": "Ποίησόν σοι μαχαίρας πετρίνας ἐκ πέτρας ἀμροτόμου. Ζητητέον διὰ τί οὐ περιετμήθησαν οἱ ἐν τῇ ἐρήμῳ τεχθέντες·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s2",
    "language": "grc",
    "text": "ἢ διὰ τί τῷ Σαββάτῳ τις ξύλα συλλέξας ἐπὶ Μωϋσέως ἐκ προστάγματος Θεοῦ λιθόλευστος γέγονε. Τοσοῦτον δὲ πλῆθος ἀπερίτμητον μεμενηκὸς ἐν τῇ ἐρήμῳ οὐδὲ ἐμέμφθη,",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s3",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s3",
    "language": "grc",
    "text": "καίτοι τοῦ Θσοῦ μὲν ἀποφῃναμένου ἐξολοθρεύεσθαι τὴν ψυχὴν τὴν μὴ περιτμημένην τῇ ἡμέρᾳ τῇ ὀγδόῃ, οὐκέτι δὲ ἐπὶ τῶν παραβαινόντων τὸ Σάββατον τοῦτο ὡρίσαντος.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s4",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s4",
    "language": "grc",
    "text": "Ἥδη μὲν οὖν καὶ αὐτόθεν εὔδηλον, ὅτι περιτομὴ καὶ Σάββατον οὐκ αὐτὰ καθʼ ἑαυτὰ καλὰ, ἀλλὰ ἐπειδὴ πρὸς καιρὸν ἐχρησίμευσεν.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s5",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s5",
    "language": "grc",
    "text": "Ἰστέον δὲ ὅτι σημείου χάριν διὰ τῆς περιτομῆς ἐβουλήθη γνωρίζεσθαι, καὶ οὐκ ἀνασχομένους ἀπὸ πίστεως φαίνεσθαι, ὡς πρόβατα ἄλογα τῷ καυτῆρι κἂν πλανηθῇ, ῥᾳδίαν ἔχει τὴν ἑαυτοῦ εὕρεσιν·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s6",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s6",
    "language": "grc",
    "text": "οὕτω τοὺς Ἰουδαίους ἐπιμιγνυμένους τοῖς ἔθνεσιν ἀπὸ τῆς περιτομῆς φανεροὺς εἶναι βουληθείς.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s7",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s7",
    "language": "grc",
    "text": "Καὶ τούτου ἀπόδειξις τὸ ἐν μὲν τῇ Αἰγύπτῳ περιτέμνεσθαι αὐτοὺς, ἐν δὲ τῇ ἐρήμῳ, ἐπειδὴ μόνοι ἦσαν καὶ Αἰγυπτίων κεχωρισμένοι καὶ τῶν ἄλλων ἐθνῶν τῶν κατὰ Παλαιστίνην, ἀπεριτμήτους μεμενηκέναι.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s8",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s8",
    "language": "grc",
    "text": "Ὅτε δὲ παρελθόντες τὸν Ἰορδάνην ἔμελλον ἐν μέσῳ εἶναι τῶν ἐθνῶν, αὖθις προσετάχθησαν περιτμηθῆναι.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s9",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s9",
    "language": "grc",
    "text": "Διόπερ ἐκ δευτέρου εἶπεν, ὅτι οὐκ ὀκταημέρους περιετέμνοντο, ἀλλʼ ἀνδροθέντας ἤδη, καὶ πρὸς γῆράς τινας νενευκότας.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s10",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s10",
    "language": "grc",
    "text": "Ἡ δὲ πετρίνη μάχαιρα τὸν Κύριον ἡμῖν δηλοῖ τὸν τὴν νοητὴν δόντα ἡμῖν περιτομὴν, τὴν εἰς νοῦν καὶ καρδίαν.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.11.s11",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.11.s11",
    "language": "grc",
    "text": "Διὰ τοῦτο γὰρ καὶ ὁ Ἀπόστο λος ἡμῖν ἔλεγε περιτομὴν τοῦ Χριστοῦ, οὐκ ἐν τῇ ἀπεκδύσει τῆς σαρκὸς ἡμῶν.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s1",
    "language": "grc",
    "text": "Ἐγὼ ἀρχιστράτηγος τῆς δυνάμεως Κυρίου, νῦν παραγέγονα. Μεμνῆσθαι δεῖ ὅτι ἡνίκα ἐμοσχοποίησαν.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s2",
    "language": "grc",
    "text": "ὁ Θεὸς τῷ Μωϋσεῖ φησιν, ὅτι « Ἀνάγαγε τὸν λαὸν τοῦτον, οὐ γὰρ μὴ συναναβῶ διὰ τὸ τὸν λαὸν σκληροτράχηλον εἶναι.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s3",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s3",
    "language": "grc",
    "text": "Καὶ ἰδοὺ ἀποστελῶ τὸν ἄγγελόν μου πρὸ προσώπου σου. Πρόσεχε οὖν σεαυτῷ, καὶ μὴ ἀπείθει.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s4",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s4",
    "language": "grc",
    "text": "» Ὁ δὲ Μωϋσῆς πρὸς αὐτόν φησιν· « Εἰ μὴ συνανέρχῃ ἡμῖν, μή με ἀναγάγῃς ἐντεῦθεν.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s5",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s5",
    "language": "grc",
    "text": "» Καὶ τοῦτο εἰπὼν ἔπεισε· καὶ ἦν μετὰ τοῦ λαοῦ, ἕως τῆς τελευτῆς Μωϋσῆ. Μετὰ δὲ τὴν τούτου ἀποβίωσιν, φαίνεται μὲν καὶ διαλέγεται τῷ τοῦ Ναυῆ Ἰησοῦ.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s6",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s6",
    "language": "grc",
    "text": "Μετὰ γοῦν τὴν ἐπιστασίαν τοῦ λαοῦ εἰς τὸν μαθητὴν Μωϋσέως λοιπὸν παραδίδωσιν αὐτὸν τῷ ἀρχιστρατήγῳ τῷ Μιχαήλ.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.12.s7",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.12.s7",
    "language": "grc",
    "text": "Οὗτος ἦν ἄρχων τοῦ λαοῦ, ὡς ἐν τῷ Δανιὴλ φαίνεται λέγων ἕτερος ἄγγελος.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.13.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.13.s1",
    "language": "grc",
    "text": "Πορευόμενοι κεὶ σαλπίζοντες. Αὐταὶ αἱ σάλπιγγες, σύμβολόν εἰσι τῶν ἐν τῇ ἐσχάτῃ ἡμέρᾳ.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.13.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.13.s2",
    "language": "grc",
    "text": "« Αὐτὸς γὰρ, φησὶν, ὁ Κύριος ἐν κελεύσματι, ἐν φωνῇ ἀρχαγγέλου, καὶ ἐν σάλπιγγι Θεοῦ καταβήσεται ἀπʼ οὐρανοῦ.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.13.s3",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.13.s3",
    "language": "grc",
    "text": "» Τὸ δὲ, ἐπὶ ἓξ ἡμέρας κυκλοῦν τὴν πόλαι τοὺς ἱερεῖς, σημεῖον ἂν εἴη τοῦ διὰ τῶν ἓξ ἡμερῶν τοῦ παρόντος αἰῶνος τοὺς ἁγίους ἅπαντα, σαλπίζειν καὶ κηρύττειν ἄφεσιν ἁμαρτιῶν τοῖς μετανοεῖν βουλομένοις.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.14.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.14.s1",
    "language": "grc",
    "text": "Καὶ εἶπεν Ἰησοῦς τοῖς υἱοῖς Ἰσραὴλ, Κεκράξατε.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.14.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.14.s2",
    "language": "grc",
    "text": "Τὴν μέντοι κραυγὴν, τὴν τῶν ῥημάτων εἰκὸς δοξολογίαν εἶναι καὶ φωνὴν αἰνέσεως τὴν εἰς τὸν Θεὸν, μαχομένην τῇ πλάνῃ τῶν Ἱεριχουντίων, νικῶσαν δὲ τὴν παράδοξον νίκην καὶ θαύματος γέμουσαν.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s1",
    "language": "grc",
    "text": "Οὕτως ἐποίησεν Ὁζάν. Ἐκ τούτου δείκνυται ὡς οὐκ Ἰησοῦς ὁ τοῦ Ναυῆ, ἀλλʼ ἕτερός τις μετὰ πολλὰς γενεὰς ταῦτα συνέγραψε.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s2",
    "language": "grc",
    "text": "Καὶ ἀληθὲς μὲν νοηθὲν, οὐκ ἐναντίον δὲ οἷς πρότερον εἰρήκαμεν.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s3",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s3",
    "language": "grc",
    "text": "Ἔγραψε γὰρ ὁ Ἰησοῦς τὰ ἐπʼ αὐτοῦ γεγονότα, ἢ ἀποκαλυφθέντα, ὥσπερ καὶ Μωϋσῆς τὰ κατὰ τοὺς ἐπʼ αὐτοῦ χρόνους.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s4",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s4",
    "language": "grc",
    "text": "Μετὰ δὲ ταῦτα τοῦ ναοῦ οἰκοδομηθέντος ἤδη ὑπὸ τοῦ σοφοῦ Σολομῶντος, καὶ τοῦ λαοῦ ὑποκλίναντος εἰς πολλὴν ἀσέβειαν,",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s5",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s5",
    "language": "grc",
    "text": "καὶ τοῦ Θεοῦ τὸν ναὸν ἔρημον καταλιπόντος ὡς μόλις εὑρεθῆναι τὸ Δευτερονόμιον ἐῤῥιμμένον ὡς ἔτυχε·",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s6",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s6",
    "language": "grc",
    "text": "διά τοι τοῦτο τοῦ λαοῦ τὴν Βαβυλωνικὴν αἰχμαλωσίαν ὑποστάντος, Ἔσδρας νομικώτατος ὢν, καὶ ἀποστομίζων πᾶσαν τὴν Παλαιὰν Διαθήκην, ἔγραψε τὸν νόμον, καὶ ἕτερά τινα τὰ γεγονότα καὶ ἀποκαλυφθέντα.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.15.s7",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.15.s7",
    "language": "grc",
    "text": "Ταῦτα πάλαι μὲν προεῤῥέθη, μετὰ δὲ ταῦτα γέγονε. Τοιοῦτόν ἐστι δήπου καὶ οὖ νῦν ἐμνημονεύσαμεν.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.16.s1",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.16.s1",
    "language": "grc",
    "text": "Ἔτι σήμερον ἰσχύω, ὡσεὶ ὅτε ἀπέστειλέ με Μωϋσῆς. Ἐν ἀμφοτέροις οὖν ἰσχύει τοῖς λόγοις ὁ ἅγιος.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg054/1st1K-grc1#tlg2042.tlg054.16.s2",
    "work_id": "first1k/tlg2042/tlg054/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg054.16.s2",
    "language": "grc",
    "text": "Ἰσχύει γὰρ ἐν παλαιοῖς καὶ ἐν καινοῖς μυστηρίοις. Τοῦτό ἐστι τὸ ἰσχύειν ἐπὶ Μωϋσέως καὶ ἐπὶ Ἰησοῦ.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  }
]