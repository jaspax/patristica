    "work_id": "first1k/tlg2042/tlg012/opp-grc1",
    "canonical_ref": "tlg2042.tlg012.1.1.s8",
    "language": "grc",
    "text": "ὁποῖός ποτε γέγονε Παῦλος προδιδοὺς τὰς ἐκκλησίας κατὰ ζῆλον θεοσεβείας.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
