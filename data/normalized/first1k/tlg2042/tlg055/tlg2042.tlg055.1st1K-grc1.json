[
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.1.s1",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.1.s1",
    "language": "grc",
    "text": "Καὶ εῦξατο Ἱεμθάε τῷ Κυφίῳ. Εἰ Πνεῦμα Κυρίου ἐπ᾿ αὐτὸν, πῶς εὔχεται ἃ μὴ προσήκει;",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.1.s2",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.1.s2",
    "language": "grc",
    "text": "Ἐνῆν γὰρ καὶ κύνα ἀπαντῆσαι ἐπανιόντι τῷ Ἰεφθάε. Ἆῤ οὖν ἐσφάλη τὸ Πνεῦμα;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.1.s3",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.1.s3",
    "language": "grc",
    "text": "οὐδαμῶς· ἀλλὰ τὸ μὲν Πνεῦμα βοηθεῖν παραγέγονεν, οὐχ ὑποβάλλειν τὴν ἄτοπον εὐχήν· αὐτὸς δὲ σφάλλεται ἀπερισκέπτως ὑποσχόμενος.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.2.s1",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.2.s1",
    "language": "grc",
    "text": "Καὶ εἶπαν αὐτῷ· Εἰπὸν δὴ στάχυς. Οἱ δὲ ἔλεγον στάχυς· σημαίνει σέβηλα, ὅπερ ἐστὶν ἄσταχυς. Οἱ δὲ ἔλεγον σεβήλω καὶ οὐκ ἐδύναντο τρανῶς εἰπεῖν σέδηλα.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.2.s2",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.2.s2",
    "language": "grc",
    "text": "Εἰ γὰρ καὶ Ἑβραῖοι ἐτύγχανον, ἀλλὰ κατὰ συμμετρίαν βραχύτητι παρήλλασσον ἐν τῇ τῆς διαλέξεως προφορᾷ.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.2.s3",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.2.s3",
    "language": "grc",
    "text": "Τὸ οὖν σύνθεμα ἦν σέβηλα, ὅπερ οἱ ἐπερωτώμενοι λέγοντες σεδήλω, ἠλέγχοντο οὐκ ὄντες τῶν οἰκείων τοῦ Ἰεφθάε, ἀλλὰ τῶν ἐπαναστάντων.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.3",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.3",
    "language": "grc",
    "text": "Καὶ γυνὴ αὐτοῦ στεῖρα καὶ οὐκ ἔτεκεν. Οὐκ ἀπὸ τῆς φύσεως, ἀλλ᾿ ἀπὸ τῆς διακονίας ἐπὶ τοῦ παρόντος στείραν καλεῖ.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.4.s1",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.4.s1",
    "language": "grc",
    "text": "Σίδηρος οὐκ ἀνέβη ἐπὶ τὴν κεφαλήν μου ὅτι Ναζιραῖος τοῦ Θεοῦ ἐγώ εἰμι.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.4.s2",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.4.s2",
    "language": "grc",
    "text": "Δι᾿ ὅλης τῆς περὶ τὸν Σαμψὼν ἱστορίας αἱ τρίχες φαίνονται τὴν πᾶσαν αὐτῷ περιποιεῖν ἰσχύν.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.5.s1",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.5.s1",
    "language": "grc",
    "text": "Τοῦ αὐτοῦ. Ναζιραῖον τὸ πεφυλαγμένον κατὰ τὴν Σύρων φωνὴν ὀνομάζει.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.5.s2",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.5.s2",
    "language": "grc",
    "text": "Μὴ ἐξακολουθεῖν δὲ τῇ τάξει τῶν Ἰσραηλιτῶν τὸν Σαμψὼν ὁ Θεὸς προστάσσει, κατ᾿ ἐκεῖνο καιροῦ τὴν κεφαλὴν ξυρωμένων διὰ τὸ εὐσήμους εἶναι πρὸς πάντας.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.6.s1",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.6.s1",
    "language": "grc",
    "text": "Καὶ ἐποίησεν Ἐφὼδ καὶ Θεραφείν. Ἐφὼδ ὕφασμα ἦν ἱερατικὸν, ὅπερ περικειμένῳ τῷ ἱερεῖ ἐφοίτα τοῦ ἁγίου Πνεύματος ἡ χάρις.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.6.s2",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.6.s2",
    "language": "grc",
    "text": "Τὸ δὲ Θεραφεὶν τοιοῦτο μέντοι, οὐ θεῖκὸν δὲ, ἀλλʼ εἰδωλικὸν, ὡς ἐν ταῖς βασιλείαις δείκνυται.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.7.s1",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.7.s1",
    "language": "grc",
    "text": "Καὶ ἐξῆλθον οἱ υἱοὶ Βενιαμίν. Τίνος ἕνεκεν ἡττῶνται δικαίως ἐπελθόντες;",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.7.s2",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.7.s2",
    "language": "grc",
    "text": "Ἥ δῆλον ὅτι διὰ προλαβούσης αἰτίας. Καὶ ὁ ψαλμός φησιν· « Ὅταν λάβω καιρὸν, ἐγὼ εὐθύτητας κρινῶ.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg055/1st1K-grc1#tlg2042.tlg055.7.s3",
    "work_id": "first1k/tlg2042/tlg055/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg055.7.s3",
    "language": "grc",
    "text": "» Εἶτα καὶ μετὰ τὸ ἡττηθῆναι, καὶ μίαν καὶ δευτέραν, μετῆλθεν ὀργὴ ἐπὶ τοὺς ἠδικηκότας, καὶ νικῶσι δίκαιαν νίκην.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
