    "canonical_ref": "tlg2042.tlg068.4.27",
    "language": "grc",
    "text": "Στίχ. κζ΄. Ψυχὴ ἐὰν ἁμάρτῃ ἀκουσίως. φησὶ. καὶ μὴ ποιήσῃ ἀπὸ πασῶν τῶν ἐντολῶν Κυρίου, ὧν δεῖ ποιεῖν.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
