[
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.s1",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.s1",
    "language": "grc",
    "text": "Στιχ. δ΄. Ἐγὼ ἐπάγω ὑετὸν (ἐπὶ) τὴν γῆν τεσσαράκοντα ἡμέρας, καὶ τεσσαράκοντα νύκτας.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.s2",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.s2",
    "language": "grc",
    "text": "Καὶ ἐξαλείψω πᾶσαν τὴν ἐξανάστασιν, ἣν ἐποίησα, ἀπὸ προσώπου τῆς γῆς, ἀπὸ ἀνθρώπουἕως κτήνους.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s1",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s1",
    "language": "grc",
    "text": "Τί δήποτε τῷ κατακλυσμῷ τὰ τῶν ἀνθρώπων πλήθη διέφθειρεν; Ἐξαλεῖψαι τοῦ Κάῖν τὸ γένος ἠθέλησε· ἀνεμίγη δὲ αὐτῷ καὶ τῶν εὐσεβῶν ἡ φυλή· διὸ καὶ τῆς τιμωρίας μετέσχηκεν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s2",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s2",
    "language": "grc",
    "text": "Ἀρχὴν δέ τινα καιτοῦ βίου ποιήσασθαι βουληθεὶς, τὸν Νῶε καὶ τοὺς ἐκείνου παῖδας σὺν ταῖς γυναιξὶ διετήρησεν,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s3",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s3",
    "language": "grc",
    "text": "εὐσεβῆ ὄντα καὶ δίκαιον, καὶ ἐκ τῆς τῶν συγγενῶν εὐσεβείας βλαστήσαντα, καὶ τὴν τῆς παρανομίας ἐπιμιξίαν μισήσαντα.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s4",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s4",
    "language": "grc",
    "text": "Οὐ μὴν, ὥς τινές φασιν, ὀργῇ (4) τινι καὶ μεταμελείᾳ ταῦτα πεποίηκε. Ταῦτα γάρ τοι ἀνθρώπινα πάθη· ἡ δὲ θεία φύσις, ἐλευθέρα παθῶν.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s5",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s5",
    "language": "grc",
    "text": "Ἄλλως τε ἡ μεταμέλεια τοῖς μετὰ τὴν πεῖραν μανθάνουσι τῶν πραγμάτων τὴν φύσιν κατάλληλος· εἶτα τῇ πείρᾳ μανθάνοντες ὡς οὐκ ὀρθῶς ἐβουλεύσαντο, μεταμέλονται.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s6",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s6",
    "language": "grc",
    "text": "Ὁ δὲ Θεὸς οὕτως ὁρᾷ τὰ μετὰ πολλὰς ἐσόμενα γενεὰς, ὡς ἤδη γεγενημένα. Ὡς προορῶν τοίνυν καὶ προγινώσκων, οὕτως ἅπαντα πρυτανεύει.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s7",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s7",
    "language": "grc",
    "text": "Τί δήποτε τοίνυν μεταμέλεται, ἅπαντα πρὸς τὴν πρόγνωσιν τὴν οἰκε ίαν οἰκονομῶν; Οὐκοῦν ἐπὶ Θεοῦ μεταμέλεια οἰκε νομίας μεταβολή·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s8",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s8",
    "language": "grc",
    "text": "Μεταμέλομαι γὰρ, φησὶν, ὅτι κέ κρικα τὸν Σαοὺλ εἰς βασιλέα· ἀντὶ τοῦ· Εὐδοκίμασα μὲν παῦσαι τοῦτον, ἕτερον δὲ χειροτονῆσαι.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s9",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s9",
    "language": "grc",
    "text": "Οὕτω κἀνταῦθα· Ἐνεθυμήθην, ὅτι ἐποίησα ἄνθρωπον· ἐδοκίμασα διολέσαι τῶν ἀνθρώπων τὸ γένος. Ἀλλὰ φιλάνθρωπος ὢν, σπέρμα τὸν Νῶε τῇ φύσει τετήρηκεν.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s10",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s10",
    "language": "grc",
    "text": "Ἐπειδὴ δὲ καὶ τῶν ἀλόγων τὰ γένη τῆς τῶν ἀνθρώπων εἵνεκα δεδημιούργηκε χρείας· καὶ ταῦτα τοῖς ἀνθρώποις συνδιεφθάρη, πλὴν τῶν ἐν τῇ κιβωτῷ σὺν τῷ Νῶε διαφυλαχθέντων.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s11",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s11",
    "language": "grc",
    "text": "Ἐκέλευσε γὰρ ὁ δεσπότης Θεὸς ἀνὰ δύο μὲν ἐξ ἑκάστου γένους τῶν δοκούντων ἀκαθάρτων διασωθῆναι, ἀνὰ ἑπτὰ δὲ τῶν καθαρῶν.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s12",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s12",
    "language": "grc",
    "text": "Ἐπειδὴ γὰρ ἤμελλε συγχωρεῖν τοῖς ἀνθρώποις μεταλαμβάνειν κρεῶν, ἤμελλον δὲ καὶ θυσίας αὐτῷ προσφέρειν τῆς εὐσεβείας οἱ τρόφιμοι, πλείονα τὰ καθαρὰ φυλαχθῆναι προσέταξε·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s13",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s13",
    "language": "grc",
    "text": "τὰς μὲν τρεῖς συζυγίας, εἰς τὴν αὔξησιν τοῦ γένους, τὸ δὲ ἓν τὸ περιττὸν εἰς θυσίαν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s14",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s14",
    "language": "grc",
    "text": "Εὐθὺς γὰρ ὁ Νῶε μετὰ τὴν καῦλαν τῆς τιμωρίας, θυσίαν τῷ Θεῷ εὐχαριστήριον προσενήνοχεν, ἀπὸ πάντων, φησὶ, κτηνῶν τῶν καθαρῶν, καὶ ἀπὸ πάντων τῶν πετεινῶν τῶν καθαρῶν.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.4.1.s15",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.4.1.s15",
    "language": "grc",
    "text": "Ὡς εἶναι δῆλον ὅτι τούτου χάριν, ἀνὰ ἑπτὰ προσέταξεν ἐξ ἑκάστου γένους τῶν καθαρῶν εἰς τὴν τιβωτὸν εἰσαχθῆναι, ἵνα, τὸ ἓν ζῶον ἐξ ἑκάστου γένους ὁ Νῶε προσφέρων, μὴ διαφθείρῃ τὰς συζυγίας.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.16",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.16",
    "language": "grc",
    "text": "(4·) Στίχ. ις΄. Καὶ ἔκλεισε Κύριος ὁ Θεὸς ἔξωθεν αὐτοῦ τὴν κιβωτόν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.7.16.1",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.7.16.1",
    "language": "grc",
    "text": "Θειοτέρας τινὸς δυνάμεως ἔχρῃζεν ἡ ἀσφάλεια τῆς θύρας κλειομένης.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25",
    "language": "grc",
    "text": "Σπίχκε΄. Καὶ κατέστρεφεν τὰς πόλεις ταύτας, καὶ πασαν τὴν περίχωρον, καὶ πάντας τοὺς κατοικοῦντας ἐν ταῖς πόλεσι.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25.1",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25.1",
    "language": "grc",
    "text": "Στίχ. κς΄. Καὶ ἀπέλεψεν ἡ γυνὴ αὐτοῦ εἰς τὰ ὀπίσω, καὶ ἐγένετο στήλη ἁλός.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25.2.s1",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25.2.s1",
    "language": "grc",
    "text": "Ὁ Κύριος οὐ μόνον τοὺς ἀσεβεῖς ἀπόλλυσιν, ἀλλὰ καὶ τὰς τροφὰς αὐτῶν οὔσας Σοδομιτικὰς καὶ ἐπιβλαβεῖς·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25.2.s2",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25.2.s2",
    "language": "grc",
    "text": "ἐν αἷς ἐστι καὶ ἄμπελος, περὶ ἧς γέγραπται· Ἐκ γὰρ ἀμπέλου Σοδόμων ἡ ἄμπελος αὐτῶν καὶ ἡ κλημαεὶς αὐτῶν ἐκ Γομόῤῤας.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25.2.s3",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25.2.s3",
    "language": "grc",
    "text": "(5) Ἅμα τε εἰς τὴν πόλιν ἀπεσώθη, καὶ τὸ πῦρ ἐπεφέρετο ταῖς πόλεσι, σημεῖον τῆς μελλούσης συντελείας.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25.2.s4",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25.2.s4",
    "language": "grc",
    "text": "Στήλη οὐχ ἁπλῶς ἐγένετο, ἀλλὰ μάλιστα στήλη ἁλὸς, διὰ τό· Ὑμεῖς ἐστε τὸ ἄλας τῆς γῆς. Ἐφαρμόσῃ δὲ τῇ στήλῃ τοῦ ἁλὸς τό· Ἐὰν δὲ τὸ ἅλας μωρανθῇ;",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.19.25.2.s5",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.19.25.2.s5",
    "language": "grc",
    "text": "Οὐκ ἀθρόως ἀναβαίνει εἰς τὸ ὄρος κατὰ τὰ εἰρημένα αὐτῷ, ἀλλὰ πρῶτον εἰς Σηγὼρ γίνεται, καίτοιγε μὴ θαῤῥήσας ἑαυτῷ περὶ τοῦ ἀναβῆναι εἰς τὸ ὄρος.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg066/1st1K-grc1#tlg2042.tlg066.23.15",
    "work_id": "first1k/tlg2042/tlg066/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg066.23.15",
    "language": "grc",
