[
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s1",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s1",
    "language": "grc",
    "text": "{Ὥσπερ δὲ πάντα τὰ τοῦ θεοῦ δωρήματα εἰς ὑπερβολὴν μείζονά ἐστι τῆς θνητῆς ὑποστάσεως, οὕτω καὶ ὁ ἀκριβὴς λόγος τῆς περὶ πάντων τούτων σοφίας, παρὰ τῷ θεῷ τῷ καὶ οἰκονομήσαντι ταῦτα γραφῆναι τυγχάνων,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s2",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s2",
    "language": "grc",
    "text": "θέλοντος τοῦ πατρὸς τοῦ λόγου γένοιτο ἂν ἐν τῇ ἄκρως μετὰ πάσης φιλοτιμίας καὶ συναισθήσεως τῆς ἀνθρωπίνης ἀσθενείας τῆς περὶ τὴν κατάληψιν τῆς σοφίας κεκαθαρμένῃ ψυχῇ.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s3",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s3",
    "language": "grc",
    "text": "εἰ δέ τις προπετέστερον ἑαυτὸν ἐπιδῴη, μὴ συνιδὼν τὸ ἀπόρρητον τῆς σοφίας τοῦ θεοῦ καὶ τοῦ »ἐν ἀρχῇ« »πρὸς τὸν θεὸν« λόγου,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s4",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s4",
    "language": "grc",
    "text": "καὶ αὐτοῦ θεοῦ ὄντος, καὶ ὅτι κατὰ τὸν λόγον καὶ θεόν, καὶ κατὰ τὴν παρ᾿ αὐτῷ σοφίαν, ταῦτα καὶ ζητητέον καὶ εὑρετέον,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s5",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s5",
    "language": "grc",
    "text": "ἀνάγκη τὸν τοιοῦτον εἰς μυθολογίας καὶ φλυαρίας ἐκπίπτοντα καὶ ἀναπλασμοὺς τῷ περὶ ἀσεβείας ἑαυτὸν ὑποβάλλειν κινδύνῳ.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s6",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s6",
    "language": "grc",
    "text": "διόπερ μνημονευτέον καὶ τῆς παρὰ τῷ Σολομῶντι ἐν τῷ Ἐκκλησιαστῇ περὶ τῶν τοιούτων ἐντολῆς, λέγοντι· »μὴ σπεύσῃς τοῦ ἐξενεγκεῖν λόγον πρὸ προσώπου τοῦ θεοῦ·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.s7",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.s7",
    "language": "grc",
    "text": "ὅτι ὁ θεὸς ἐν τῷ οὐρανῷ ἄνω, καὶ σὺ ἐπὶ τῆς γῆς κάτω· διὰ τοῦτο ἔστωσαν οἱ λόγοι σου ὀλίγοι«.}",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.1.s1",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.1.s1",
    "language": "grc",
    "text": "Πρέπει δὲ τὰ ἅγια γράμματα πιστεύειν μηδεμίαν κεραίαν ἔχειν κενὴν σοφίας θεοῦ·",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.1.s2",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.1.s2",
    "language": "grc",
    "text": "ὁ γὰρ ἐντειλάμενος ἐμοὶ τῷ ἀνθρώπῳ καὶ λέγων· »οὐκ ὀφθήσῃ ἐνώπιόν μου κενός«, πολλῷ πλέον αὐτὸς οὐδὲν κενὸν ἐρεῖ.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.1.s3",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.1.s3",
    "language": "grc",
    "text": "»ἐκ« γὰρ »τοῦ πληρώματος αὐτοῦ« λαβόντες οἱ προφῆται λέγουσι· διὸ πάντα πάντα πνεῖ αὐτῶν ἀπὸ πληρώματος·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.1.s4",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.1.s4",
    "language": "grc",
    "text": "καὶ οὐδέν ἐστιν ἐν προφητείᾳ ἢ νόμῳ ἢ εὐαγγείῳ ἢ ἀποστόλῳ, ὃ οὐκ ἔστιν ἀπὸ πληρώματος διὰ τοῦτο ἐπεί ἐστιν ἀπὸ πληρώματος,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.1.s5",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.1.s5",
    "language": "grc",
    "text": "πνεῖ τοῦ πληρώματος τοῖς ἔχουσιν ὀφθαλμοὺς βλέποντας τὰ τοῦ πληρώματος, καὶ ὦτα ἀκούοντα τῶν ἀπὸ πληρώματος, καὶ αἰσθητήριον τῆς εὐωδίας τῶν ἀπὸ πληρώματος πνεόντων.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.2.s1",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.2.s1",
    "language": "grc",
    "text": "Ἐὰν δέ ποτε ἀναγινώσκων τὴν γραφὴν προσκόψῃς νοήματι ὄντι καλῷ λίθῳ προσκόμματος καὶ πέτρᾳ σκανδάλου, αἰτιῶ σαυτόν.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.2.s2",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.2.s2",
    "language": "grc",
    "text": "μὴ ἀπελπίσῃς γὰρ τὸν λίθον τοῦτον τοῦ προσκόμματος καὶ τὴν πέτραν τοῦ σκανδάλου ἔχειν νοήματα ὥστ᾿ ἂν γενέσθαι | | κατὰ τὸ εἰρημένον· »καὶ ὁ πιστεύων οὐ καταισχυνθήσεται«.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.1.1.2.s3",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.1.1.2.s3",
    "language": "grc",
    "text": "πίστευσον πρῶτον, καὶ εὑρήσεις ὑπὸ τὸ νομιζόμενον σκάνδαλον πολλὴν ὠφέλειαν ἁγίαν.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.s1",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.s1",
    "language": "grc",
    "text": "Περὶ τῶν ἐν τῇ θείᾳ γραφῇ δοκούντων ἔχειν τι λίθου προσκόμματος ἢ πέτρας σκανδάλου.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.s2",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.s2",
    "language": "grc",
    "text": "ἐν τῇ λθ΄ ὁμιλίᾳ τῶν εἰς τὸν Ἱερεμίαν, εἰς τὸ »οὐκ ἠδύνατο κύριος φέρειν ἀπὸ προσώπου πονηρίας ὑμῶν«.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s1",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s1",
    "language": "grc",
    "text": "Ἐάν ποτε ἀναγινώσκων τὴν γραφὴν προσκόψῃς νοήματι ὄντι καλῷ >λίθῳ προσκόμματος καὶ πέτρᾳ σκανδάλου<, αἰτιῶ σαυτόν·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s2",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s2",
    "language": "grc",
    "text": "μὴ ἀπελπίσῃς γὰρ τὸν λίθον τοῦτον τοῦ προσκόμματος καὶ τὴν πέτραν τοῦ σκανδάλου ἔχειν νοήματα ὥστ᾿ ἂν γενέσθαι τὸ εἰρημένον· »καὶ ὁ πιστεύων οὐ καταισχυνθήσεται«.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s3",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s3",
    "language": "grc",
    "text": "πίστευσον πρῶτον, καὶ εὑρήσεις ὑπὸ τὸ νομιζόμενον σκάνδαλον πολλὴν ὠφέλειαν ἁγίαν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s4",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s4",
    "language": "grc",
    "text": "εἰ γὰρ ἡμεῖς ἐντολὴν ἐλάβομεν μὴ λέγειν >ῥῆμα ἀργόν, ὡς δώσοντες περὶ αὐτοῦ λόγον ἐν ἡμέρᾳ κρίσεως<,",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s5",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s5",
    "language": "grc",
    "text": "καὶ ὅση δύναμις φιλοτιμούμεθα πᾶν ῥῆμα τὸ ἐξιὸν ἐκ τοῦ στόματος ἡμῶν ποιεῖν ἐργάζεσθαι καὶ ἐν ἡμῖν τοῖς λέγουσι καὶ ἐν τοῖς ἀκούσουσι·",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s6",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s6",
    "language": "grc",
    "text": "τί χρὴ νοεῖν περὶ τῶν προφητῶν, ἢ ὅτι πᾶν ῥῆμα λαληθὲν διὰ τοῦ στόματος αὐτῶν ἐργατικὸν ἦν;",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s7",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s7",
    "language": "grc",
    "text": "καὶ οὐ θαυμαστόν, εἰ πᾶν [τὸ] ῥῆμα τὸ λαλούμενον ὑπὸ τῶν προφητῶν εἰργάζετο ἔργον τὸ πρέπον ῥήματι.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s8",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s8",
    "language": "grc",
    "text": "ἀλλὰ γὰρ οἶμαι ὅτι καὶ πᾶν θαυμάσιον γράμμα τὸ γεγραμμένον ἐν τοῖς λογίοις τοῦ θεοῦ ἐργάζεται.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.1.s9",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.1.s9",
    "language": "grc",
    "text": "καὶ οὐκ ἔστιν »ἰῶτα ἓν ἢ μία κεραία« γεγραμμένη ἐν τῇ γραφῇ, ἥτις τοῖς ἐπισταμένοις χρῆσθαι τῇ δυνάμει τῶν γραμμάτων οὐκ ἐργάζεται τὸ ἑαυτῆς ἔργον.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.2.s1",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.2.s1",
    "language": "grc",
    "text": "Ὥσπερ δὲ ἐπὶ τῶν βοτανῶν ἑκάστη μὲν ἔχει | δύναμιν εἴτε εἰς τὴν ὑγίειαν τῶν σωμάτων εἴτε εἰς ὁτιδήποτε, οὐ πάντων δέ ἐστιν ἐπίστασθαι εἰς ὃ ἑκάστη τῶν βοτανῶν ἐστι χρήσιμος,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg2042/tlg084/opp-grc1#tlg2042.tlg084.2.2.s2",
    "work_id": "first1k/tlg2042/tlg084/opp-grc1",
    "canonical_ref": "tlg2042.tlg084.2.2.s2",
    "language": "grc",
    "text": "ἀλλ᾿ εἴ τινες ἐπιστήμην εἰλήφασιν, οὗτοι οἱ περὶ τὰς βοτάνας διατρίβοντες ἵνα εἰδῶσι καὶ πότε παραλαμανομένη καὶ ποῦ τῶν σωμάτων ἐπιτιθεμένη καὶ τίνα τρόπον σκευαζομένη ὀνίνησι τὸν χρώμενον,",
    "chunk_index": 27,
    "context_before": null,
