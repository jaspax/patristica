    "work_id": "first1k/tlg2042/tlg072/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg072.20.21.s4",
    "language": "grc",
    "text": "Θαυμάσαι δὲ ἄξιον τὸ πλῆθος τῶν Ἰσραηλιτῶν, ὅτι, δικαίως τοῖς Βενιαμίταις ἐπελθόντες, καὶ ἡττηθέντες,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
