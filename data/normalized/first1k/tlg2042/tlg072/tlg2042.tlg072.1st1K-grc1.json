    "work_id": "first1k/tlg2042/tlg072/1st1K-grc1",
    "canonical_ref": "tlg2042.tlg072.20.21.s5",
    "language": "grc",
    "text": "οὐκ ἐνενόησάν τι πονηρὸν κατὰ τοῦ Θεοῦ, ἀλλὰ μᾶλλον οὐδὲ ἐπαύσαντο προκλαίοντες, ἕως ὅτε δίκην ἔλαβον κατὰ τῶν ἠδικηκότων.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
