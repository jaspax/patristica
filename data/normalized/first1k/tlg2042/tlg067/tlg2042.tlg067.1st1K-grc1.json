    "language": "grc",
    "text": "Στίχ. κε΄. Ἐκεῖ ἔθετο αὐτῷ ὁ Θεὸς δικαώματα καὶ κρίσεις, καὶ ἐκεῖ αὐτὸν ἐπείραζε.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
