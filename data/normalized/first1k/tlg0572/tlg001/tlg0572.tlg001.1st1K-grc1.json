[
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.1.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.1.s1",
    "language": "grc",
    "text": "Καὶ ἐν τῷ Γαΐου δὲ (inquit Eusebius lib. iii. Hist. cap. 31.) οὗ μικρῷ πρόσθεν (cap. 28. ejusd. lib.)",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.1.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.1.s2",
    "language": "grc",
    "text": "ἐμνήσθημεν διαλόγῳ, Πρόκλος πρὸς ὃν ἐποιεῖτο τὴν ζήτησιν, περὶ τῆς Φιλίππου καὶ τῶν θυγατέρων αὐτοῦ τελευτῆς συνᾴδων τοῖς ἐκτεθεῖσιν οὕτω φησίν·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.1.s3",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.1.s3",
    "language": "grc",
    "text": "Μετὰ τοῦτον δὲ προφήτιδες τέσσαρες αἱ Φιλίππου γεγένηνται ἐν Ἱεραπόλει τῇ κατὰ τὴν Ἀσίαν· ὁ τάφος αὐτῶν ἐστὶν ἐκεῖ, καὶ ὁ τοῦ πατρὸς αὐτῶν.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.2.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.2.s1",
    "language": "grc",
    "text": "Ἐγὼ δὲ τὰ τρόπαια τῶν ἀποστόλων ἔχω δεῖξαι.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.2.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.2.s2",
    "language": "grc",
    "text": "ἐὰν γὰρ θελήσῃς ἀπελθεῖν ἐπὶ τὸν Βατικανὸν, ἢ ἐπὶ τὴν ὁδὸν τὴν Ὠστίαν, εὑρήσεις τὰ τρόπαια τῶν ταύτην ἱδρυσαμένων τὴν ἐκκλησίαν. Attulit hoc Eusebius lib. ii. Hist. cap. 25.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.3.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.3.s1",
    "language": "grc",
    "text": "——Ἀλλὰ καὶ Κήρινθος [ὁ] δι’ ἀποκαλύψεων ὡς ὑπὸ ἀποστόλου μεγάλου γεγραμμένων, τερατολογίας ἡμῖν ὡς δι’ ἀγγέλων αὐτῷ δεδειγμένας ψευδόμενος ἐπεισάγει,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.3.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.3.s2",
    "language": "grc",
    "text": "λέγων, μετὰ τὴν ἀνάστασιν ἐπίγειον εἶναι τὸ βασίλειον τοῦ Χριστοῦ· καὶ πάλιν ἐπιθυμίαις καὶ ἡδοναῖς ἐν ερουσαλὴμ τὴν σάρκα πολιτευομένην δουλεύειν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.3.s3",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.3.s3",
    "language": "grc",
    "text": "καὶ ἐχθρὸς ὑπάρχων ταῖς γραφαῖς τοῦ Θεοῦ, ἀριθμὸν χιλιονταετίας ἐν γάμῳ ἑορτῆς θέλων πλανᾷν λέγει γίνεσθαι. Haec posuit Eusebius lib. iii. Hist. cap. 28.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.4.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.4.s1",
    "language": "grc",
    "text": "Ἦλθε δὲ εἰς ἡμᾶς (inquit Eusebius lib. vi. Hist. cap. 20.) καὶ Γαΐου λογιωτάτου ἀνδρὸς διάλογος, ἐπὶ Ῥώμης κατὰ Ζεφυρῖνον πρὸς Πρόκλον τῆς κατὰ Φρύγας αἱρέσεως ὑπερμαχοῦντα κεκινημένος·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.1.4.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.1.4.s2",
    "language": "grc",
    "text": "ἐν ᾧ τῶν δι’ ἐναντίας τὴν περὶ τὸ συντάττειν καινὰς γραφὰς προπέτειάν τε καὶ τόλμαν ἐπιστομίζων, τῶν τοῦ ἱεροῦ ἀποστόλου δεκατριῶν μόνων ἐπιστολῶν μνημονεύει, τὴν πρὸς Ἐβραίους μὴ συναριθμήσας ταῖς λοιπαῖς.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s1",
    "language": "grc",
    "text": "Φασὶ γὰρ (Hæretici) τοὺς μὲν προτέρους ἅπαντας καὶ αὐτοὺς τοὺς ἀποστόλους παρειληφέναι τε καὶ δεδιδαχέναι ταῦτα, ἃ νῦν οὗτοι λέγουσι·",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s2",
    "language": "grc",
    "text": "καὶ τετηρῆσθαι τὴν ἀλήθειαν τοῦ κηρύγματος μέχρι τῶν Βίκτορος χρόνων, ὃς ἦν τρισκαιδέκατος ἀπὸ Πέτρου ἐν Ῥώμῃ ἐπίσκοπος·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s3",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s3",
    "language": "grc",
    "text": "ἀπὸ δὲ τοῦ διαδόχου αὐτοῦ Ζεφυρίνου, παρακεχαράχθαι τὴν ἀλήθειαν. ἦν δ’ ἂν τυχὸν πιθανὸν τὸ λεγόμενον, εἰ μὴ πρῶτον μὲν ἀντέπιπτον αὐτοῖς αἱ θεῖαι γραφαί·",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s4",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s4",
    "language": "grc",
    "text": "καὶ ἀδελφῶν δέ τινων ἐστὶ γράμματα πρεσβύτερα τῶν Βίκτορος χρόνων, ἃ ἐκεῖνοι πρὸς τὰ ἔθνη ὑπὲρ τῆς ἀληθείας, καὶ πρὸς τὰς τότε αἱρέσεις ἔγραψαν·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s5",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s5",
    "language": "grc",
    "text": "λέγω δὲ Ἰουστίνου καὶ Μιλτιάδου καὶ Τατιανοῦ καὶ Κλήμεντος καὶ ἑτέρων πλειόνων, ἐν οἷς ἅπασι θεολογεῖται ὁ Χριστός·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s6",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s6",
    "language": "grc",
    "text": "τὰ γὰρ Εἰρηναίου τε καὶ Μελίτωνος καὶ τῶν λοιπῶν τίς ἀγνοεῖ βιβλία, Θεὸν καὶ ἄνθρωπον καταγγέλλοντα τὸν Χριστόν;",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s7",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s7",
    "language": "grc",
    "text": "ψαλμοὶ δὲ ὅσοι καὶ ᾠδαὶ ἀδελφῶν ἀπ’ ἀρχῆς ὑπὸ πιστῶν γραφεῖσαι, τὸν λόγον τοῦ Θεοῦ τὸν Χριστὸν ὑμνοῦσι θεολογοῦντες.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s8",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s8",
    "language": "grc",
    "text": "πῶς οὖν ἐκ τοσούτων ἐτῶν καταγγελλομένου τοῦ ἐκκλησιαστικοῦ φρονήματος, ἐνδέχεται τοὺς μέχρι Βίκτορος οὕτως ὡς οὗτοι λέγουσι κεκηρυχέναι;",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s9",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s9",
    "language": "grc",
    "text": "πῶς δὲ οὐκ αἰδοῦνται ταῦτα Βίκτορος καταψεύ- δεσθαι·",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s10",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s10",
    "language": "grc",
    "text": "ἀκριβῶς εἰδότες, ὅτι Βίκτωρ τὸν σκυτέα Θεόδοτον τὸν ἀρχηγὸν καὶ πατέρα ταύτης τῆς ἀρνησιθέου ἀποστασίας, ἀπεκήρυξε τῆς κοινωνίας, πρῶτον εἰπόντα ψιλὸν ἄνθρωπον τὸν Χριστόν.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.1.s11",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.1.s11",
    "language": "grc",
    "text": "εἰ γὰρ Βίκτωρ κατ’ αὐτοὺς οὕτως ἐφρόνει ὡς ἡ τούτων διδάσκει βλασφημία, πῶς ἂν ἀπέβαλλε Θεόδοτον τὸν τῆς αἱρέσεως ταύτης εὐρείην; Attulit haec Eusebius lib. v. Hist. cap. 28.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s1",
    "language": "grc",
    "text": "Ὑπομνήσω γοῦν πολλοὺς τῶν ἀδελφῶν πρᾶγμα ἐφ’ ἡμῶν γενόμενον· ὃ νομίζω ὅτιᵃ εἰ ἐν Σοδόμοις ἐγεγόνει, τυχὸν ἂν κᾀκείνους ἐνουθέτησε.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s2",
    "language": "grc",
    "text": "Νατάλιος ἦν τὶς ὁμολογητὴς οὐ πάλαι, ἀλλ’ ἐπὶ τῶν ἡμετέρων γενόμενος καιρῶν. οὗτος ἠπατήθη ποτὲ ὑπὸ Ἀσκληπιοδότου (for.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s3",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s3",
    "language": "grc",
    "text": "Ἀσκληπιάδου. vid. notam) καὶ ἑτέρου Θεοδότου τινὸς τραπεζίτου· ἦσαν καὶ οὗτοι ἄμφω Θεοδότου τοῦ σκυτέως μαθηταὶ,",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s4",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s4",
    "language": "grc",
    "text": "τοῦ πρώτου ἐπὶ ταύτῃ τῇ φρονήσει, μᾶλλον δὲ ἀφροσύνῃ, ἀφορισθέντος τῆς κοινωνίας ὑπὸ Βίκτορος ὡς ἔφην τοῦ τότε ἐπισκόπου.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s5",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s5",
    "language": "grc",
    "text": "ἀνεπείσθη δὲ ὁ Νατάλιος ὑπ’ αὐτῶν ἐπὶ σαλαρίῳ ἐπίσκοπος κληρωθῆναι ταύτης τῆς αἱρέσεως, ὥστε λαμβάνειν παρ’ αὐτῶν μηνιαῖα δηνάρια ἑκατὸν πεντήκοντα.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s6",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s6",
    "language": "grc",
    "text": "γενόμενος οὖν σὺν αὐτοῖς, δι’ ὁραμάτων πολλάκις ἐνουθετεῖτο ὑπὸ τοῦ Κυρίου.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s7",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s7",
    "language": "grc",
    "text": "ὁ γὰρ εὔσπλαγχνος Θεὸς καὶ Κύριος ἡμῶν Ἰησοῦς Χριστὸς, οὐκ ἐβούλετο ἔξω ἐκκλησίας γενόμενον, ἀπολέσθαι μάρτυρα τῶν ἰδίων παθῶν.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s8",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s8",
    "language": "grc",
    "text": "ἐπεὶ δὲ ῥαθυμότερον τοῖς ὁράμασι προσεῖχε, δελεαζόμενος τῇ τε παρ’ αὐτοῖς πρωτοκαθεδρίᾳ, καὶ τῇ πλείστους ἀπολλυούσῃ αἰσχροκερδείᾳ,",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s9",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s9",
    "language": "grc",
    "text": "τελευταῖον ὑπὸ ἀγίων ἀγγείων ἐμαστιγώθη, δι’ ὅλης τῆς νυκτὸς οὐ σμικρῶς αἰκισθείς· ὥστε ἕωθεν ἀναστῆναι, καὶ ἐνδυσάμενον σάκκον, καὶ σποδὸν καταπασάμενον,",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s10",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s10",
    "language": "grc",
    "text": "μετὰ πολλῆς σπουδῆς καὶ δακρύων προσπεσεῖν Ζεφυρίνῳ τῷ ἐπισκόπῳ, κυλιόμενον ὑπὸ τοὺς πόδας οὐ μόνον τῶν ἐν τῷ κλήρῳ, ἀλλὰ καὶ τῶν λαϊκῶν·",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.2.s11",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.2.s11",
    "language": "grc",
    "text": "συγχέαι τε τοῖς δάκρυσι τὴν εὔσπλαγχνον ἐκκλησίαν τοῦ ἐλεήμονος Χριστοῦ· πολλῇ τε τῇ δεήσει χρησάμνον, δείξαντά τε τοὺς μώλωπας ὧν εἰλήφει πληγῶν, μόλις κοινωνηθῆναι. Attulit haec Eusebius ibid.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s1",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s1",
    "language": "grc",
    "text": "Γραφὰς μὲν θείας ἀφόβως ῥεραδιουργήκασι· πίστεως δὲ ἀρχαίας κανόνα ἠθετήκασι· Χριστὸν δὲ ἠγνοήκασιν·",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s2",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s2",
    "language": "grc",
    "text": "οὐ τί αἱ θεῖαι λέγουσι γραφαὶ ζητοῦντες, ἀλλ’ ὁποῖον σχῆμα συλλογισμοῦ εἰς τὴν τῆς ἀθεότητος εὑρεθῇ σύστασιν, φιλοπόνως ἀσκοῦντες·",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s3",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s3",
    "language": "grc",
    "text": "κἄν αὐτοῖς προτείνῃ τὶς ῥητὸν γραφῆς θεϊκῆς, ἐξετάζουσι πότερον συνημμένον ἢ διεζευγμένον δύναται ποιῆσαι σχῆμα συλλογισμοῦ.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s4",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s4",
    "language": "grc",
    "text": "καταλιπόντες δὲ τὰς ἁγίας τοῦ Θεοῦ γραφὰς, γεωμετρίαν ἐπιτηδεύουσιν· ᵇὡς ἂν ἐκ τῆς γῆς ὄντες καὶ ἐκ τῆς γῆς λαλοῦντες, καὶ τὸν ἄνωθεν ἐρχόμενον ἀγνοοῦντες.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s5",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s5",
    "language": "grc",
    "text": "Εὐκλείδης γοῦν παρά τισιν αὐτῶν φιλοπόνως γεωμετρεῖται· Ἀριστοτέλης δὲ καὶ Θεόφραστος θαυμάζονται· Γαληνὸς γὰρ ἴσως ὑπό τινων καὶ προσκυνεῖται.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s6",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s6",
    "language": "grc",
    "text": "οἱ δὲ ταῖς τῶν ἀπίστων τέχναις εἰς τὴν τῆς αἱρέσεως αὐτῶν γνώμην ἀποχρώμενοι, καὶ τῇ τῶν ἀθέων πανουργίᾳ τὴν ἁπλῆν τῶν θείων γραφῶν πίστιν καπηλεύοντες·",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s7",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s7",
    "language": "grc",
    "text": "ὅτι μηδὲ ἐγγὺς πίστεως ὑπάρχουσι, τί δεῖ καὶ λέγειν; διατοῦτο ταῖς θείαις γραφαῖς ἀφόβως ἐπέβαλον τὰς χεῖρας, λέγοντες αὐτὰς διωρθωκέναι.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s8",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s8",
    "language": "grc",
    "text": "καὶ ὅτι τοῦτο μὴ καταψευδόμενος αὐτῶν λέγω, ὁ βουλόμενος δύναται μαθεῖν.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s9",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s9",
    "language": "grc",
    "text": "εἰ γάρ τις θελήσει συγκομίσας αὐτῶν ἑκάστου τὰ ἀντίγραφα ἐξετάζειν πρὸς ἄλληλα, κατὰ πολὺ ἂν εὕροι διαφωνοῦντα. ἀσύμφωνα γοῦν ἔσται τὰ Ἀσκληπιάδου τοῖς Θεοδότου.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s10",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s10",
    "language": "grc",
    "text": "πολλῶν δέ ἐστιν εὐπορῆσαι, διὰ τὸ φιλοτίμως ἐγγεγράφθαι τοὺς μαθητὰς αὐτῶν τὰ ὑφ’ ἑκάστου αὐτῶν ὡς αὐτοὶ καλοῦσι κατωρθωμένα, τουτέστιν ἠφανισμένα.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s11",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s11",
    "language": "grc",
    "text": "πάλιν δὲ τούτοις τὰ Ἐρμοφίλου οὐ συνᾴδει· τὰ γὰρ Ἀπολλωνίδου οὐδὲ αὐτὰ ἑαυτοῖς ἐστὶ σύμφωνα.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s12",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s12",
    "language": "grc",
    "text": "ἔνεστι γὰρ συγκρῖναι τὰ πρότερον ὑπ’ αὐτῶν κατασκευασθέντα, τοῖς ὕστερον πάλιν ἐπιδιαστραφεῖσι, καὶ εὑρεῖν καταπολὺ ἀπᾴδοντα.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s13",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s13",
    "language": "grc",
    "text": "ὅσης δὲ τόλμης ἐστὶ τοῦτο τὸ ἁμάρτημα, εἰκὸς μηδὲ ἐκείνους ἀγνοεῖν.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s14",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s14",
    "language": "grc",
    "text": "ἢ γὰρ οὐ πιστεύουσιν ἁγίῳ πνεύματι λελέχθαι τὰς θείας γραφὰς, καὶ εἰσὶν ἄπιστοι· ἢ ἑαυτοὺς ἡγοῦνται σοφωτέρους τοῦ ἁγίου πνεύματος ὑπάρχειν· καὶ τί ἕτερον ἢ δαιμονῶσιν;",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s15",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s15",
    "language": "grc",
    "text": "οὐδὲ γὰρ ἀρνήσασθαι δύνανται ἑαυτῶν εἶναι τὸ τόλμημα, ὁπόταν καὶ τῇ αὐτῶν χειρὶ ᾖ γεγραμμένα·",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s16",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s16",
    "language": "grc",
    "text": "καὶ παρ’ ὧν κατηχήθησαν μὴ τοιαύτας παρέλαβον τὰς γραφάς· καὶ δεῖξαι ἀντίγραφα, ὅθεν αὐτὰ μετεγράψαντο, μὴ ἔχωσιν.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s17",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s17",
    "language": "grc",
    "text": "ἔνιοι δὲ αὐτῶν οὐδὲ παραχαράσσειν ἠξίωσαν αὐτὰς, ἀλλ’ ἁπλῶς ἀρνησάμενοι τόν τε νόμον καὶ τοὺς προφήτας·",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg0572/tlg001/1st1K-grc1#tlg0572.tlg001.2.3.s18",
    "work_id": "first1k/tlg0572/tlg001/1st1K-grc1",
    "canonical_ref": "tlg0572.tlg001.2.3.s18",
    "language": "grc",
    "text": "ἀνόμου καὶ ἀθέου διδασκαλίας προφάσει χάριτος· εἰς ἔσχατον ἀπωλείας ὄλεθρον κατωλίσθησαν. Attulit Eusebius ibid.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  }
]