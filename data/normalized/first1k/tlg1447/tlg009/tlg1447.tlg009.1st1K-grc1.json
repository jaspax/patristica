    "canonical_ref": "tlg1447.tlg009.1.s2",
    "language": "grc",
    "text": "οἱ μὲν γὰρ οἴονται μίαν ἡμέραν δεῖν αὐτοὺς νηστεύειν· οἱ δὲ δύο, οἱ δὲ καὶ πλείονας.",
    "chunk_index": 1,
    "context_before": null,
