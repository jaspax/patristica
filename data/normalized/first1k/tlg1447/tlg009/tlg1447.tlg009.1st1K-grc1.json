    "work_id": "first1k/tlg1447/tlg009/1st1K-grc1",
    "canonical_ref": "tlg1447.tlg009.1.s5",
    "language": "grc",
    "text": "τῶν παρὰ τὸ ἀκριβὲς ὡς εἰκὸς κρατούντων, τὴν καθ’ ἁπλότητα καὶ ἰδιωτισμὸν συνήθειαν εἰς τὸ μετέπειτα πεποιηκότων·",
    "chunk_index": 4,
    "context_before": null,
