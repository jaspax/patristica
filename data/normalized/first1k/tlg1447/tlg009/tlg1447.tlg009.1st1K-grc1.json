    "work_id": "first1k/tlg1447/tlg009/1st1K-grc1",
    "canonical_ref": "tlg1447.tlg009.1.s7",
    "language": "grc",
    "text": "Attulit hæc Eusebius lib. v. Hist. c. 24. et proxime post ait: Τούτοις καὶ ἱστορίαν προστίθησιν (Irenæus) ἣν οἰκείως παραθήσομαι τοῦτον ἔχουσαν τὸν τρόπον.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
