    "work_id": "first1k/tlg1447/tlg009/1st1K-grc1",
    "canonical_ref": "tlg1447.tlg009.1.1.s1",
    "language": "grc",
    "text": "Ἐν οἷς καὶ οἱ πρὸ Σωτῆρος πρεσβύτεροι οἱ προστάντες τῆς ἐκκλησίας ἧς σὺ νῦν ἀφηγῇ, Ἀνίκητον λέγομεν καὶ Πίον,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
