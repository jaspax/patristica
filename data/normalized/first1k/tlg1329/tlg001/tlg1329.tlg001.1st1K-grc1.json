[
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.1.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.1.s1",
    "language": "grc",
    "text": "Εξ ἀρχῆς γὰρ ὑμῖν ἔθος ἐστὶ τοῦτο, πάντας μὲν ἀδελφοὺς ποικίλως εὐεργετεῖν, ἐκκλησίαις τε πολλαῖς ταῖς κατὰ πᾶσαν πόλιν ἐφόδια πέμπειν·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.1.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.1.s2",
    "language": "grc",
    "text": "ὧδε μὲν τὴν τῶν δεομένων πενίαν ἀναψύχοντας· ἐν μετάλλοις δὲ ἀδελφοῖς ὑπάρχουσιν ἐπιχορηγοῦντας·",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.1.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.1.s3",
    "language": "grc",
    "text": "δἰ ὧν πέμπετε ἀρχῆθεν ἐφοδίων, πατροπαράδοτον ἔθος Ῥωμαίων Ῥωμαῖοι διαφυλάττοντες· ὃ οὐ μόνον διατετήρηκεν ὁ μακάριος ὑμῶν ἐπίσκοπος Σωτὴρ, ἀλλὰ καὶ ἐπηύξηκεν·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.1.s4",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.1.s4",
    "language": "grc",
    "text": "ἐπιχορηγῶν μὲν τὴν διαπεμπομένην δαψίλειαν τὴν εἰς τοὺς ἁγίους· λόγοις δὲ μακαρίοις τοὺς ἀνιόντας ἀδελφοὺς ὡς τέκνα πατὴρ φιλόστοργος παρακαλῶν. Hæc attulit Eusebius lib. iv. Hist. c. 23.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.2.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.2.s1",
    "language": "grc",
    "text": "Ἐν αὐτῇ δὲ ταύτῃ (epistola) καὶ τῆς Κλήμεντος πρὸς Κορινθίους μέμνηται ἐπιστολῆς, (verba Eusebii sunt in loco modo signato) δηλῶν ἀνέκαθεν ἐξ ἀρχαίου ἔθους ἐπὶ τῆς ἐκκλησίας τὴν ἀνάγνωσιν αὐτῆς ποιεῖσθαι.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.2.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.2.s2",
    "language": "grc",
    "text": "λέγει γοῦν (Dionysius) Τὴν σήμερον οὖν Κυριακὴν ἁγίαν ἡμέραν διηγάγομεν, ἐν ᾗ ἀνέγνωμεν ὑμῶν τὴν ἐπιστολήν·",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.2.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.2.s3",
    "language": "grc",
    "text": "ἣν ἕξομεν ἀεί ποτε ἀναγινώσκοντες νουθετεῖσθαι, ὡς καὶ τὴν προτέραν ἡμῖν διὰ Κλήμεντος γραφεῖσαν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.3.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.3.s1",
    "language": "grc",
    "text": "Ταῦτα (Valesius emendat ταύτῃ) καὶ ὑμεῖς διὰ τῆς τοσαύτης νουθεσίας, τὴν ἀπὸ Πέτρου καὶ Παύλου φυτείαν γενηθεῖσαν Ῥωμαίων τε καὶ Κορινθίων συνεκεράσατε.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.3.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.3.s2",
    "language": "grc",
    "text": "καὶ γὰρ ἄμφω καὶ εἰς τὴν ἡμετέραν Κόρινθον φυτεύσαντες ἡμᾶς, ὁμοίως ἐδίδαξαν.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.3.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.3.s3",
    "language": "grc",
    "text": "ὁμοίως δὲ καὶ εἰς τὴν Ἰταλίαν ὁμόσε διδάξαντες, ἐμαρτύρησαν κατὰ τὸν αὐτὸν καιρόν. Protulit hæc Eusebius lib. ii. Hist. c. 25.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.4.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.4.s1",
    "language": "grc",
    "text": "Ἔτι δὲ ὁ αὐτὸς καὶ περὶ τῶν ἰδίων ἐπιστολῶν (verba Eusebii sunt in lib. iv. Hist. c. 23.) ὡς ῥᾳδιουργηθεισῶν, ταῦτα φησίν. Ἐπιστολὰς γὰρ ἀδελφῶν ἀξιωσάντων με γράψαι, ἔνραψα.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.4.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.4.s2",
    "language": "grc",
    "text": "καὶ ταύτας οἱ τοῦ διαβόλου ἀπόστολοι ζιζανίων γεγέμικαν· ἃ μὲν ἐξαιροῦντες, ἃ δὲ προστιθέντες· οἷς τὸ οὐαὶ κεῖται.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.4.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.4.s3",
    "language": "grc",
    "text": "οὐ θαυμαστὸν ἄρα εἰ καὶ τῶν Κυριακῶν ῥαδιουργῆσαί τινες (for. legend. τινας) ἐπιβέβληνται γραφῶν, ὁπότε καὶ ταῖς οὐ τοιαύταις ἐπιβεβλήκασι (alii ἐπιβουλεύκασι).",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.s1",
    "language": "grc",
    "text": "Καὶ πρῶτόν γε περὶ Διονυσίου φατέον· ὅτι τε τῆς ἐν Κορίνθῳ παροικίας τὸν τῆς ἐπισκοπῆς ἐγκεχείριστο θρόνον·",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.s2",
    "language": "grc",
    "text": "καὶ ὡς τῆς ἐνθέου φιλοπονίας οὐ μόνον τοῖς ὑπ᾿ αὐτὸν, ἀλλ᾿ ἤδη καὶ τοῖς ἐπὶ τῆς ἀλλοδαπῆς ἀφθόνως ἐκοινώνει·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.s3",
    "language": "grc",
    "text": "χρησιμώτατον ἅποσιν ἑαυτὸν καθιστὰς, ἐν αἷς ὑπετυποῦτο καθολικαῖς πρὸς τὰς ἐκκλησίας ἐπιστολαῖς.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.s4",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.s4",
    "language": "grc",
    "text": "ὧν ἐστιν, Ἡ ΜΕΝ ΠΡΟΣ ΛΑΚΕΔΑIΜΟΝΙΟΥΣ, ὀρθοδοξίας κατηχητικὴ, εἰρήνης τε καὶ ἑνώσεως ὑποθετική.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.1.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.1.s1",
    "language": "grc",
    "text": "Ἡ ΔΕ ΠΡΟΣ ΑΘΗΝΑΙΟΥΣ, διεγερτικὴ πίστεως καὶ τῆς κατὰ τὸ εὐαγγέλιον πολιτείας·",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.1.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.1.s2",
    "language": "grc",
    "text": "ἧς ὀλιγωρήσαντας ἐλέγχει, ὡς ἂν μικροῦ δεῖν ἀποστάντας τοῦ λόγου, ἐξ οὗπερ τὸν προεστῶτα αὐτῶν Πούπλιον μαρτυρῆσαι κατὰ τοὺς τότε συνέβη διωγμούς.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.1.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.1.s3",
    "language": "grc",
    "text": "Κοδράτου δὲ μετὰ τὸν μαρτυρήσαντα Πούπλιον καταστάντος αὐτῶν ἐπισκόπου μέμνηται· ἐπιμαρτυρῶν, ὡς ἂν διὰ τῆς αὐτοῦ σπουδῆς ἐπισυναχθέντων, καὶ τῆς πίστεως ἀναζωπύρησιν εἰληχότων·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.1.s4",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.1.s4",
    "language": "grc",
    "text": "δηλοῖ δ᾿ ἐπὶ τούτοις, ὡς καὶ Διονύσιος ὁ Ἀρεοπαγίτης ὑπὸ τοῦ ἀποστόλου Παύλου προτραπεὶς ἐπὶ τὴν πίστιν κατὰ τὰ ἐν ταῖς πράξεσι δεδηλωμένα, πρῶτος τῆς ἐν Ἀθήναις παροικίας τὴν ἐπισκοπὴν ἐγκεχείριστο.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.2",
    "language": "grc",
    "text": "Ἄλλη δ᾿ ἐπιστολή τις αὐτοῦ ΠΡΟΣ ΝΙΚΟΜΗΔΕΑΣ φέρεται· ἐν τὴν Μαρκίωνος αἵρεσιν πολεμῶν, τῷ τῆς ἀληθείας παρίσταται κανόνι.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.3.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.3.s1",
    "language": "grc",
    "text": "Καὶ τῇ ἐκκλησίᾳ δὲ τῇ παροικούσῃ ΓΟΡΤΥΝΑΝ ἉΜΑ ΤΑΙΣ ΛΟΙΠΑΙΣ ΚΑΤΑ ΚΡΗΤΗΝ ΠΑΡΟΙΚΙΑΙΣ ἐπιστείλας, Φίλιππον ἐπίσκοπον αὐτῶν ἀποδέχεται,",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.3.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.3.s2",
    "language": "grc",
    "text": "ἅτε δὴ ἐπὶ πλείσταις μαρτυρουμένης ἀνδραγαθίαις τῆς ὑπ᾿ αὐτὸν ἐκκλησίας· τήν τε τῶν αἱρετικῶν διαστροφὴν ὑπομιμνήσκει φυλάττεσθαι.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.4.s1",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.4.s1",
    "language": "grc",
    "text": "Καὶ τῇ ἐκκλησίᾳ δὲ τῇ παροικούσῃ ΑΜΑΣΤΡΙΝ ἉΜΑ ΤΑΙΣ ΚΑΤΑ ΠΟΝΤΟΝ ἐπιστείλας, Βακχυλίδου μὲν καὶ Ἐλπίστου, ὡς ἂν αὐτὸν ἐπὶ τὸ γράψαι προτρεψάντων μέμνηται·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.4.s2",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.4.s2",
    "language": "grc",
    "text": "γραφῶν τε θείων ἐξηγήσεις παρατέθειται· ἐπίσκοπον αὐτῶν ὀνόματι Πάλμαν ὑποσημαίνων· πολλὰ δὲ περὶ γάμου καὶ ἁγνείας τοῖς αὐτοῖς παραινεῖ.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1329/tlg001/1st1K-grc1#tlg1329.tlg001.5.4.s3",
    "work_id": "first1k/tlg1329/tlg001/1st1K-grc1",
    "canonical_ref": "tlg1329.tlg001.5.4.s3",
    "language": "grc",
