[
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s1",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s1",
    "language": "grc",
    "text": "Ἄνθρωποι θνητοὶ κοὶ σάρκινοι, οὐδὲν ἐόντες, πῶς ταχέως ὑψοῦσθε βίου τέλος οὐκ ἐσορῶντες;",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s2",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s2",
    "language": "grc",
    "text": "οὐ τρέμετ᾿ οὐδὲ φοβεῖσθε θεόν, τὸν ἐπίσκοπον ὑμῶν, ὕψιστον γνώστην πανεπόπτην μάρτυρα πάντων παντοτρόφον κτίστην, ὅστις γλυκὺ πνεῦμ᾿ ἐν ἄπασιν κάτθετο χἠγητῆρα βροτῶν πάντων ἐποίησεν;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s3",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s3",
    "language": "grc",
    "text": "εἷς θεός, ὃς μόνος ἄρχει, ὑπερμεγέθης ἀγένητος παντοκρατωρ αορατος ορωμενος αυτος απαντα, αὐτὸς δ᾿ οὐ βλέπεται θνητῆς ὑπὸ σαρκὸς ἁπάσης·",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s4",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s4",
    "language": "grc",
    "text": "τίς γὰρ σὰρξ δύναται τὸν ἐπουράνιον καὶ ἀληθῆ ὀφθαλμοῖσιν ἰδεῖν θεὸν ἄμβροτον, ὃς πόλον οἰκεῖ;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s5",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s5",
    "language": "grc",
    "text": "ἀλλ’ οὐδ᾿ ἀκτίνων κατεναντίον ἠελίοιο ἄνθρωποι στῆναι δυνατοί, θνητοὶ γεγαῶτες ἄνδρες, ἐν ὀστείοισι φλέβες καὶ σάρκες ἐόντες.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s6",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s6",
    "language": "grc",
    "text": "αὐτὸν τὸν μόνον ὄντα σέβεσθ᾿ ἡγήτορα κόσμου.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s7",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s7",
    "language": "grc",
    "text": "ὃς μόνος εἰς αἰῶνα καὶ ἐξ αἰῶνος ἐτύχθη αὐτογενὴς ἀγένητος ἅπαντα κρατῶν διὰ παντός, πᾶσι βροτοῖσι νέμων τὸ κριτήριον έν φαΐ κοινῷ.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s8",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s8",
    "language": "grc",
    "text": "τῆς κακοβουλοσύνης δὲ τὸν ἄξιον ἕξετε μισθόν, ὅττι θεὸν προλιπόντες ἀληθινὸν ἀέναόν τε δοξάζειν αὐτῷ τε θύειν ἱερὰς ἑκατόμβας δαίμοσι τὰς θυσίας ἐποιήσατε τοῖσιν ἐν Ἅιδῃ.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s9",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s9",
    "language": "grc",
    "text": "τύφῳ καὶ μανίῃ δὲ βαδίζετε καὶ τρίβον ὀρθήν εὐθεῖαν προλιπόντες ἀπήλθετε καὶ δι᾿ ἀκανθῶν καὶ σκολόπων ἐπλανπασθ·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s10",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s10",
    "language": "grc",
    "text": "βροτοί, παύσασθε, μάταιοι, ῥεμβόμενοι σκοτίῃ καὶ ἀφεγγέι νυκτὶ μελαίνῃ, καὶ λίπετε σκοτίην νυκτός, φωτὸς δὲ λάβεσθε.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s11",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s11",
    "language": "grc",
    "text": "οὑτος ἰδοὺ πάντεσσι σαφὴς ἀπλάνητος ὑπάρχει. ἔλθετε, μὴ σκοτίην δὲ διώκετε καὶ γνόφον αἰεί. ἠελίου γλυκυδερκὲς ἰδοὺ φάος φάος λάμπει.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s12",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s12",
    "language": "grc",
    "text": "γνῶτε δὲ κατθέμενοι σοφίην ἐν στήθεσιν ὑμῶν· εἷς θεός ἐστι βροχὰς ἀνέμους σεισμοὺς ἐπιπέμπων ἀστεροπὰς λιμοὺς λοιμοὺς καὶ κήδεα λυγρά καὶ νιφετοὺς κρύσταλλα.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.1.s13",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.1.s13",
    "language": "grc",
    "text": "τί δὴ καθ’ ἓν ἐξαγορεύω; οὐρανοῦ ἡγεῖται, γαίης κρατεῖ, αὐτὸς ὑπάρχει.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.2",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.2",
    "language": "grc",
    "text": "εἰ δὲ θεοὶ γεννῶσι καὶ ἀθάνατοί γε μένουσιν, πλείονες ἀνθρώπων γεγενημένοι ἂν θεοὶ ἠσαν, οὐδὲ τόπος στῆναι θνητοῖς οὐκ ἂν ποθ᾿ ὑπῆρξεν.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s1",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s1",
    "language": "grc",
    "text": "εἰ δὲ γενητὸν ὅλως καὶ φθείρεται, οὐ δύνατ᾿ ἀνδρός ἐκ μηρῶν μήτρας τε θεὸς τετυπωμένος εἶναι·",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s2",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s2",
    "language": "grc",
    "text": "ἀλλὰ θεὸς μόνος εἱς πανυπέρτατος, ὃς πεποίηκεν οὐρανὸν ἠέλιόν τε καὶ ἀστέρας ἠδὲ σελήνην καρποφόρον γαῖάν τε καὶ ὕδατος οἴδματα πόντου ουρεἀ θ᾿ ὑψήεντα ἀένναα χεύματα πηγῶν.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s3",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s3",
    "language": "grc",
    "text": "τῶν τ᾿ ἐνύδρων πάλι γεννᾷ ἀνήριθμον πολὺ πλῆθος, ἑρπετὰ δ᾿ ἐν γαίῃ κινούμενα ψυχοτροφεῖται,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s4",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s4",
    "language": "grc",
    "text": "ποικίλα τε πτηνῶν λιγυροθρόα τραυλίζοντα ξουθὰ λιγυπτερόφωνα ταράσσοντ᾿ ἀέρα ταρσοῖς, έν δὲ νάπαις ὀρέων ἀγρίαν γένναν θέτο θηρῶν ἡμῖν τε κτήνη ὑπέταξεν πάντα βροτοῖσιν.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s5",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s5",
    "language": "grc",
    "text": "πάντων δ᾿ ἡγητῆρα κατέστησεν θεότευκτον, ἀνδρὶ δ᾿ ὑπέταξεν παμποίκιλα κοὐ κατάληπτα. τίς γὰρ σὰρξ δύναται θνητῶν γνῶναι τάδ᾿ ἅπαντα;",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s6",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s6",
    "language": "grc",
    "text": "ἀλλ᾿ αὐτὸς μόνος οἶδεν ὁ ποιήσας τάδ᾿ ἀπ᾿ ἀρχῆς, ἄφθαρτος κτίστης αἰώνιος αἰθέρα ναίων,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s7",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s7",
    "language": "grc",
    "text": "τοῖς ἀγαθοῖς ἀγαθὸν προφέρων πολὺ πλείονα μισθόν, τοῖς δὲ κακοῖς ἀδίκοις τε χόλον καὶ θυμὸν ἐγείρων καὶ πόλεμον καὶ λοιμὸν ἰδ ἄλγεα δακρυόεντα.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s8",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s8",
    "language": "grc",
    "text": "ἄνθρωποι, τί μάτην ὑψούμενοι ἐκριζοῦσθε; αἰσχύνθητε γαλᾶς καὶ κνώδαλα θειοποιοῦντες.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s9",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s9",
    "language": "grc",
    "text": "οὐ μανίη καὶ λύσσα φρενῶν αἴσθησιν ἀφαιρεῖ, εἰ λοπάδας κλέπτουσι θεοί, συλοῦσι δὲ χύτρας·",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s10",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s10",
    "language": "grc",
    "text": "ἀντὶ δὲ χρυσήεντα πόλον κατ᾿ ἀπείρονα ναίειν σητόβρωτα δέδορκε, πυκναῖς δ’ ἀράχναις δεδίασται·",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s11",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s11",
    "language": "grc",
    "text": "προσκυνέοντες ὄφεις κύνας αἰλούρους, ἀνόητοι, καὶ πετεηνὰ σέβεσθε καὶ ἑρπετὰ θηρία γαίης καὶ λίθινα ξόανα καὶ ἀγάλματα χειροποίητα καὶ παρ᾿ ὁδοῖσι λίθων συγχώσματα·",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s12",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s12",
    "language": "grc",
    "text": "ταῦτα σέβεσθε ἄλλα τε πολλὰ μάταια, ἂ δὴ καἰσχρὸν ἀγορεύειν· εἰσὶ θεοὶ μερόπων δόλῳ ἡγητῆρες ἀβούλων, τῶν δὴ κἀκ στόματος χεῖται θανατηφόρος ἰός.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s13",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s13",
    "language": "grc",
    "text": "ὃς δ᾿ ἔστιν ζωή τε καὶ ἄφθιτον ἀέναον φῶς καὶ μέλιτος #x23D4; – γλυκερώτερον ἀνδράσι χάρμα ἐκπροχέει #x23D4;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "first1k/tlg1551/tlg002/1st1K-grc1#tlg1551.tlg002.3.s14",
    "work_id": "first1k/tlg1551/tlg002/1st1K-grc1",
    "canonical_ref": "tlg1551.tlg002.3.s14",
    "language": "grc",
    "text": "–, τῷ δὴ μόνῳ αὐχένα κάμπτε, καὶ τρίβον αἰώνεσσιν ἐν εὐσεβέεσσ’ ἀνακλίνοις.",
    "chunk_index": 27,
