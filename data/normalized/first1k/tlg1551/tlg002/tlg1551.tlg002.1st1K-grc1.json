    "canonical_ref": "tlg1551.tlg002.4",
    "language": "grc",
    "text": "κλῦτε δέ μου, μέροπες, βασιλεὺς αἰώνιος ἄρχει.",
    "chunk_index": 32,
    "context_before": null,
