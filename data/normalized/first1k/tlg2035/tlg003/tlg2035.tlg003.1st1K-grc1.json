    "work_id": "first1k/tlg2035/tlg003/1st1K-grc1",
    "canonical_ref": "tlg2035.tlg003.1.17.s2",
    "language": "grc",
    "text": "νῦν ὑμέτερόν ἐστι πρὸς τὸν θεὸν ἐκείνῃ τῇ πίστει βλέπειν ᾗ πάντοτε καὶ γεγενῆσθαι συνέστηκε καὶ εἶναι πρέπει,",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
