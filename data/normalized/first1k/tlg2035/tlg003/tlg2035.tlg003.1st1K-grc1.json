    "canonical_ref": "tlg2035.tlg003.1.1.1",
    "language": "grc",
    "text": "»Κωνσταντῖνος Σεβαστὸς τῇ καθολικῇ ἐκκλησίᾳ Νικομηδέων.",
    "chunk_index": 1,
    "context_before": null,
