  },
  {
    "chunk_id": "first1k/tlg2035/tlg003/1st1K-grc1#tlg2035.tlg003.1.8.s1",
    "work_id": "first1k/tlg2035/tlg003/1st1K-grc1",
    "canonical_ref": "tlg2035.tlg003.1.8.s1",
    "language": "grc",
    "text": "αὕτη ἄρα ἐστὶν ἡ ἡμετέρα πίστις, αὕτη ἡ >τοῦ ἁγιωτάτου νόμου διδασκαλία;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
