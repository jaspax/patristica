    "work_id": "first1k/tlg2035/tlg003/1st1K-grc1",
    "canonical_ref": "tlg2035.tlg003.1.17.s1",
    "language": "grc",
    "text": "ἁρπαγέντας γὰρ αὐτοὺς ἐκέλευσα ὡς πορρωτάτω ἐξορισθῆναι.",
    "chunk_index": 59,
    "context_before": null,
