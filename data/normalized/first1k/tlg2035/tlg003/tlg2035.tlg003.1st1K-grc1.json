    "work_id": "first1k/tlg2035/tlg003/1st1K-grc1",
    "canonical_ref": "tlg2035.tlg003.1.17.s4",
    "language": "grc",
    "text": "εἴ τις δὲ ἢ πρὸς μνήμην τῶν λυμεώνων ἐκείνων ἢ πρὸς ἔπαινον ἀπρονοήτως ἐξαφθῆναι τολμήσει,",
    "chunk_index": 62,
    "context_before": null,
