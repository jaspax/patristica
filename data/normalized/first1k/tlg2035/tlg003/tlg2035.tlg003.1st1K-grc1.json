    "work_id": "first1k/tlg2035/tlg003/1st1K-grc1",
    "canonical_ref": "tlg2035.tlg003.1.16.s1",
    "language": "grc",
    "text": "ἀλλ’ οὗτοι τὸ καλοί τε καὶ ἀγαθοὶ ἐπίσκοποι, οὓς ἅπαξ ἡ τῆς συνόδου ἀλήθεια πρὸς μετάνοιαν τετηρήκει, οὐ μόνον ἐκείνους ὑπεδέξαντο καὶ πὰρ ἑαυτοῖς ἠσφαλίσαντο,",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
