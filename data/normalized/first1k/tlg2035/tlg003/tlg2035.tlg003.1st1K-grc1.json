    "canonical_ref": "tlg2035.tlg003.2.1",
    "language": "grc",
    "text": "Νικητὴς Κωνσταντῖνος Σεβαστὸς Θεοδότῳ·",
    "chunk_index": 64,
    "context_before": null,
