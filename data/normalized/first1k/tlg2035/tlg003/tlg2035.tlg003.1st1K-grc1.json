    "work_id": "first1k/tlg2035/tlg003/1st1K-grc1",
    "canonical_ref": "tlg2035.tlg003.1.16.s2",
    "language": "grc",
    "text": "ἀλλὰ καὶ ἐκοινώνησαν αὐτοῖς τῆς τῶν τρόπων κακοηθείας. διὸ τοῦτο περὶ τοὺς ἀχαρίστους τούτους ἔκρινα πρᾶξαι·",
    "chunk_index": 58,
    "context_before": null,
