    "work_id": "oglt-pl/pseudo-isidorus/pl83_31_ap",
    "canonical_ref": "PL83.AP.3.s19",
    "language": "lat",
    "text": "De justo autem dicit : Loquitur veritatem in corde suo; et non egit dolum in lingua sua.",
