    "work_id": "oglt-pl/patricius/pl53_15_pr",
    "canonical_ref": "PL53.PR.10",
    "language": "lat",
    "text": "Patricius (ait) : Exempla majorum perqaire, ubi nihil fallaciæ invenies.",
