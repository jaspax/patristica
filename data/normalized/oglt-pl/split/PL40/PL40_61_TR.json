    "canonical_ref": "PL40.TR.1",
    "language": "lat",
    "text": "SEU DE VERBIS PSALMI , TERRA DEDIT FRUCTUM SUUM.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
