    "work_id": "oglt-pl/pseudo-augustinus/pl40_63_se",
    "canonical_ref": "PL40.SE.4.s1",
    "language": "lat",
    "text": "Omnibus esse impertiendam misericordiam docet apostolus Paulus apertissime dicens : Infatigabiles.",
