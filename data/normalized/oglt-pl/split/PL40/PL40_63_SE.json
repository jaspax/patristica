    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_63_se#PL40.SE.5.s4",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_63_se",
    "canonical_ref": "PL40.SE.5.s4",
    "language": "lat",
    "text": "Omnis enim qui reclc arguit peccatorem , quid aliud quam nun vult eum esse peccatorem ?",
