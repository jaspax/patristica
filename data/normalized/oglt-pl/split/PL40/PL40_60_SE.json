  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s5",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s5",
    "language": "lat",
    "text": "Vicit me caro mea, supcravit me adolescentia ina. Non dico qnod facerc deboas t, siquidem et hoc odio habet Deus :",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
