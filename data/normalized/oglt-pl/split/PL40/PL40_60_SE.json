    "canonical_ref": "PL40.SE.3.s3",
    "language": "lat",
    "text": "fornicationem , in quibus si quis deprehensus fuisset, non posset ocule a levare , sed sic eum habe­ remus quasi exsecrabilem:",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
