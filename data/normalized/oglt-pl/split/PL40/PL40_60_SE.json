  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s12",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s12",
    "language": "lat",
    "text": "Hoc ergo dico secundum quod scriptum est, Deus superbis resistit, humilibus autem dat gratiam (I Petr.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
