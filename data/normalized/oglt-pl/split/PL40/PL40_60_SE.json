  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s16",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s16",
    "language": "lat",
    "text": "Numquid tu es sapientier me, licet non dicat; tan en ex eo quod contemnit consilium fratris, in cordc suo loquitur.",
