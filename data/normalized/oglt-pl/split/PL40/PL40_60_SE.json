  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s10",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s10",
    "language": "lat",
    "text": "Hoc ergo dico, ne cogitetis peccatum modicum esse superbiam a. Nempe quid dicit Apostolus?",
