    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.2.s8",
    "language": "lat",
    "text": "Aliquis doctus est? Et vadit ad peritiorem magistrum. Hoc lolum qnare dico? Ut obedientiam exhibeamus in patres nostros.",
