  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s15",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s15",
    "language": "lat",
    "text": "Et quid dicit in corde suo? Ego mihi sapientior : ego ergo non habeo consitium?",
