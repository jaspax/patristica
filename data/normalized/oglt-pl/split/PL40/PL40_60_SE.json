    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s14",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s14",
    "language": "lat",
    "text": "Si quis dc fratribus dederit ei consilium , ct dixerit ei, Frater, non debes sic agere; non cum di­ gnatur audire, quia se magis sapientem putat quam illum qui dat consilium.",
    "chunk_index": 30,
    "context_before": null,
