  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s11",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s11",
    "language": "lat",
    "text": "Ne quis, inquit, incidat in judicium diaboli (I Tim. Ill, G). Vide ergo quuniam quicumque inflatur, in judicium diaboli incidit.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
