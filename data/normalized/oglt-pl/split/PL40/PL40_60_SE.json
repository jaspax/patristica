  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.2.s13",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.2.s13",
    "language": "lat",
    "text": "el tibi 1 lucris quasi sapiens, ct obediens patri non fueris, omnes viriuics disperdidisti. Ina obedientia plus valet, quam omn es virtutes aliæ.",
