  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.4.s1",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.4.s1",
    "language": "lat",
    "text": "Ergo hocdico, Qni superbiam habet, sinc causa alias habet virtutes. Habet virtutes? Imo non habet, sed videtur habere.",
