    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.2.s11",
    "language": "lat",
    "text": "Hoc dico, quia hic in nobis summa et sola cst virtus obedientiæ.",
