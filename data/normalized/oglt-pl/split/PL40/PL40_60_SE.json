  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s7",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s7",
    "language": "lat",
    "text": "Quid cuimdicil, Propterea fur­ tum feci, quia egebam, quia fame moriebar, quia ægro­ tabam.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s8",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s8",
    "language": "lat",
    "text": "Superbus quid dicere potest? Ideo superbia vide quantum malum sit, quod excusationem non Ila­ bet.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
