    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s4",
    "language": "lat",
    "text": "si quis superbus esi, multo pejus peccatum facit quam adulterium; et tamen lo­ quimur cum eo. Qui fornicatur, potest aliquid dicere:",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
