    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s6",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s6",
    "language": "lat",
    "text": "sed in comparatione ma!i dico, Qui­ cumque aliud peceatum fecerit, verbi causa, si furtum fecerit, excusare potest.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
