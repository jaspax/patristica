    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.2.s14",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.2.s14",
    "language": "lat",
    "text": "Jc­ junium vel continentia, nisi te diligenter attenderis, superbiam tibi facit: superbia autem inimica est Dco. Nihil sic odit Deus, quomodo superbiam.",
