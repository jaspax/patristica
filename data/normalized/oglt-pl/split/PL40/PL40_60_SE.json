  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s13",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s13",
    "language": "lat",
    "text": "v, 5), ut omnia quidem peccata fugiamus, maxime autem su­ perbiam. Dico vobis de superbia, semper sibi sapiens videtur.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
