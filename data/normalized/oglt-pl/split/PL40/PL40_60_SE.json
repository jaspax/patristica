  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl40_60_se#PL40.SE.3.s9",
    "work_id": "oglt-pl/pseudo-augustinus/pl40_60_se",
    "canonical_ref": "PL40.SE.3.s9",
    "language": "lat",
    "text": "Cæ cra vilia eis nocent, qui ea committunt : cæ­ terum superbia plus omnibus nocet.",
