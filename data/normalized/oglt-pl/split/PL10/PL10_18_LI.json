    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s16",
    "language": "lat",
    "text": "Via est : quia per ipsum accessum habemus (adscensus est) ad Deum patrem. Veritas est : quia mendacium nescii. Vita est : quia ipse universa vivi- ficat.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
