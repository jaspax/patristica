  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.7.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.7.s3",
    "language": "lat",
    "text": "Modo enim verbum, modo virtus, modo sapientia, modo dex- tera, modo brachium, modo margarita, modo the- saurus, modo retia, modo aratrum, modo fons,",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
