    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.9.s6",
    "language": "lat",
    "text": "Nam Filium quis videre po- tuit antequam conspicabilem materiam cum placuit assumpsit, vel ipsum hominem induere dignatus est?",
