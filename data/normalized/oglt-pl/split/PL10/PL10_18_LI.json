  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s9",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s9",
    "language": "lat",
    "text": "Fons aquae appellatur : quia ex eo sitientium corda coelestis aquae gratia irrigantur.",
