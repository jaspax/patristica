    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s6",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s6",
    "language": "lat",
    "text": "Thesaurus dicitur : ut in ipso omnes divitiae regnorum coelestium, quae reconditae sunt, agno- scantur. (Ambr. conditae agnosc.)",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
