    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.9.s5",
    "language": "lat",
    "text": "sed dispositiones rerum futurarum, quae suis quibusque temporibus complendae erant, in ipso per imaginem cernerentur.",
