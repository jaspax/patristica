    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s7",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s7",
    "language": "lat",
    "text": "Retia dicitur : quia per ipsum, et in ipso de mari saeculi, gentium quasi multitudo piscium in Ecclesia congregantur, ubi bo- norum malorumque discrimina cognoscuntur.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
