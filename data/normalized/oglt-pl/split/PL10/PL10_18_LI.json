    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.7.s4",
    "language": "lat",
    "text": "modo petra, modo lapis angularis, modo agnus, modo homo, modo vitulus, modo aquila, modo leo, modo via, modo veritas, modo vita, cum sit Deus omnia et in omnibus.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
