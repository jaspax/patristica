  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s17",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s17",
    "language": "lat",
    "text": "Vides ergo, quia per haec vocabula significatio- nes dispositionum et operum divinorum praeostensae sunt : nou tamen ipse Deus per haec proprie defini- tus est.",
    "chunk_index": 54,
    "context_before": null,
