  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.9.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.9.s3",
    "language": "lat",
    "text": "quia inquit, De Patre exivi, hoc est, lumen de lu- mine. Quod si filium (Apud Ambros.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
