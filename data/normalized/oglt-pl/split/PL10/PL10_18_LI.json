    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s4",
    "language": "lat",
    "text": "coelestia credentibus) reseravit. Dextera nuncupatur : quod per eum omnia opera divina perfecta sunt.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
