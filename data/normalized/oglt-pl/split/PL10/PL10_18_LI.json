  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s12",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s12",
    "language": "lat",
    "text": "Agnus appellatur : ut innocentia Christi et passio demonstretur. Homo di- tur : quia secundum carnem propter nos homines nasci dignatus est.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
