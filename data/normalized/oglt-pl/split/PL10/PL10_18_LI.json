  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.9.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.9.s1",
    "language": "lat",
    "text": "Ex cap. 8 proedicti Tractatus. — Est ergo Pater Deus immensus, aeternus, incomprehensibilis, inaes- timabilis.",
