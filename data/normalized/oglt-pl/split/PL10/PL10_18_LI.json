  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.9.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.9.s2",
    "language": "lat",
    "text": "Est et Filius ejus Dominus noster tantus, quantus est Pater; sed non aliunde, sed de Patre :",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
