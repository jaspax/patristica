    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s8",
    "language": "lat",
    "text": "Ara- trum nuncupatur : quia signo crucis suae gentium pectora subiguntur, ut necessario semini praeparen- tur.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
