  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s15",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s15",
    "language": "lat",
    "text": "Idem leo dictus est : quia ipse est rex regum, qui mortem ac diabolum virtutis suae potestate com- minuit.",
