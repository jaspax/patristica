    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s13",
    "language": "lat",
    "text": "Vitulus dicitur : quia propter nostram salutem pati sustinuit.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.8.s14",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s14",
    "language": "lat",
    "text": "Aquila dicitur : quia post venerabilem resurrectionem, quasi remis alitum, ad Patrem revolavit (rex alitum ad Patris revolat se- dem).",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
