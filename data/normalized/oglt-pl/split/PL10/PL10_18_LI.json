    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.8.s5",
    "language": "lat",
    "text": "Brachium dicitur : quia ab ipso omnia continentur. Margarita appellatur : quia nihil illo pretiosius inve- nitur.",
