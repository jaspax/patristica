[
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.s1",
    "language": "lat",
    "text": "Qui hunc librum anno 1535 typis Frobenianis edi curaverunt, vix illum e prelo subduxerant, cum com- pererunt illum non novum Hilarii opus,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.s2",
    "language": "lat",
    "text": "sed rhapsodiam esse studiosi cujuspiam, tum e secundo libro de Trini- tate, tum maxime ex nono consarcinatam, cui aliunde adtexta est appendix de variis Christi cognominibus.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.s3",
    "language": "lat",
    "text": "Hoec porro appendix descripta est ex cap. 6 libri de fide orthodoxa, apud Ambrosium et apud Gregorium Naz.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.s4",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.s4",
    "language": "lat",
    "text": "vulgati, quem Gregorii Boetici esse plurimi arbi- trantur. Ex eodem additamento conficitur sermo in ap- pendice Augustini nunc 113.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.1.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.1.s1",
    "language": "lat",
    "text": "Deus qui ubique est (Ex lib. ii Hilarii de Trinit., num. 6), et ubique totus est, ita regimen intelligen- tiae excedit, extra quem nihil est, cui semper sit, ut hoc modo se velit in veritate sacramenti intelligi.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.1.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.1.s2",
    "language": "lat",
    "text": "Hoc imperspicabilis naturae est nomen in Patre, quod Deus invisibilis, ineffabilis, infinitus, ad quem et elo- quendum sermo sileat, et investigandum sensus he- betetur, et complectendum inielligentia coarctetur.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.1.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.1.s3",
    "language": "lat",
    "text": "Deficit ergo (Ex num. 7) in nuncupatione confessio, et quidquid ilii sermonum aptabitur, Deuro ut est, quantusque est, non loquetur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.1.s4",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.1.s4",
    "language": "lat",
    "text": "Perfecta scientia est, sic Deum scire, ut licet non ignorabilem, tamen ine- narrabilem scias.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.1.s5",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.1.s5",
    "language": "lat",
    "text": "Credendus est, intelligendus, ado- randus est, et iis officiis eloquendus.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.2.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.2.s1",
    "language": "lat",
    "text": "Est autem Filias progenies ingeniti (Ex num. 3), unus ex uno, verus a vero, vivus a vivo, perfectus a perfecto,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.2.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.2.s2",
    "language": "lat",
    "text": "virtutis virtus, sapientiae sapientia, gloria gloriae, imago invisibilis Dei, forma patris ingeniti :",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.2.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.2.s3",
    "language": "lat",
    "text": "habet igitur nativitatis hujus utique secretum (Ex num. 9). Et si quis forte intelligentiae suae imputave- rit, generationis hujus sacramentum non posse con- sequi,",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.2.s4",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.2.s4",
    "language": "lat",
    "text": "cum tamen et Pater sit absolute intellectus, et Filius nec major eo, nec minor; sine dolore a me audiet, Ignoro, ego nescio, non requiro.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.2.s5",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.2.s5",
    "language": "lat",
    "text": "Consolabor me tamen : Archangeli nesciunt, Angeli non audie- runt, Propheta non sensit, Apostolus interrogavit, Filius ipse non edidit.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.2.s6",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.2.s6",
    "language": "lat",
    "text": "Cesset dolor querelarum. Non te, quisquis es qui haec quaeris, revoco in excelsum, non in amplitudinem tendo, non deduco in pro- fundum.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s1",
    "language": "lat",
    "text": "Haec de natura divinitatis attigimus (Ex num. 11 et 12), non summam inteliigentiae comprehendentes, sed intelligentes incomprehensibilia esse quae loqui- mur.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s2",
    "language": "lat",
    "text": "Nullum ergo, dicis, ofiicium fidei est, si nil po- terit comprehendi.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s3",
    "language": "lat",
    "text": "Immo hoc officium fides profitea- tur, id unde quaeritur incomprehensibile sibi esse scire.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s4",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s4",
    "language": "lat",
    "text": "Superest de inenarrabili generatione Filii adhuc aliquid : immo aliquid illud adhuc lotum est.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s5",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s5",
    "language": "lat",
    "text": "AEstuo, differor, hebesco, et unde incipiam nescio. Nescio enim quando natus sit Filius : et nefas est mihi scire quando natus sit Filius.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s6",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s6",
    "language": "lat",
    "text": "Quem imprecor? quem im- plorem? ex quibus libris ad tantarum difficultatum narrationem verba praesumam?",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s7",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s7",
    "language": "lat",
    "text": "Evolvam omnem Graeciae scholam? Sed legi, ubi sapiens? ubi scriba? ubi conquisitor sacculi?",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s8",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s8",
    "language": "lat",
    "text": "In hoc ergo mundo sophistae multi et sapientes sunt : sapientiam autem Dei repro- baverunt. Scribam legis consulam? Sed ignorat, et crux Christi scandalum est.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.3.s9",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.3.s9",
    "language": "lat",
    "text": "Hortabor forte vos con- nivere et tacere : quia ad venerationem ejus satis sit, quod in Evangeliis praedicatur tanta inter homi- nes fecisse stupenda prodigia.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.4.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.4.s1",
    "language": "lat",
    "text": "Ex num. 13. —Consistit enim meum in patroci- nium meditatarum difficultatum piscator egens, igno- tus, indoctus, manibus lino occupatis, veste humida, pedibus limo oblitis, totus e navi.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.4.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.4.s2",
    "language": "lat",
    "text": "Quaerite et inve- nite, utrum mirabilius fuerit mortuos suscitasse, an imperito scientiam istius doctrinae intimasse? Ait enim, In principio erat Verbum.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.4.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.4.s3",
    "language": "lat",
    "text": "Transeuntur tem- pora, transmittuntur saecula, tolluntur aetates : pisca- tor meus illitteratus liber a tempore est, vicit omne principium.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.5.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.5.s1",
    "language": "lat",
    "text": "Principium lib. ix. — Tractantes ante paucos dies de indifferenti natura Dei patris et Dei filii, etc., usque ad haec num. 44.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.5.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.5.s2",
    "language": "lat",
    "text": "Ac sic perfectam fidem do- cuit, cum id quod modo est, ejusdem temporis opus sit; et id quod operatur Pater operatur et Filius ex- tra singularis sit unionem.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.6.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.6.s1",
    "language": "lat",
    "text": "Ex capit. 6 Tractatus de fide orthodoxa. — Denique pro captu, pro viribus, pro fide nostra intucamur Deus quid sit : et videamus an illi possit aliquid comparari.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.6.s2",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.6.s2",
    "language": "lat",
    "text": "Certe hoc est Deus, quod et cum dicitur, non potest dici; cum aestimatur, non potest aesti- mari; cum comparatur, non potest comparari :",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.6.s3",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.6.s3",
    "language": "lat",
    "text": "cum definitur, ipsa definitione sua crescit : qui coelum manu sua operit, pugno omnem mundum claudit, quem totum omnia nesciunt,",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.6.s4",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.6.s4",
    "language": "lat",
    "text": "et metuendo sciunt, cujus nomini et virtuti famulantur, hunc orbis ex ipsa elementorum sibi succedentium momentanea vi- cissitudine testatur.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-hilarius/pl10_18_li#PL10.LI.7.s1",
    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.7.s1",
    "language": "lat",
    "text": "Ratio quaedam est, quae apud Graecos \\6yoc appella- tur, quae inter Patrem et Filium personas vel voca- bula distinguit :",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
