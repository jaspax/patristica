    "work_id": "oglt-pl/pseudo-hilarius/pl10_18_li",
    "canonical_ref": "PL10.LI.9.s4",
    "language": "lat",
    "text": "huc accedit quod sic (ilium) Dei, ut jam dictum est, visum a patribus approbamus, ut non totum in illo quod Dei est vide- retur :",
    "chunk_index": 58,
    "context_before": null,
