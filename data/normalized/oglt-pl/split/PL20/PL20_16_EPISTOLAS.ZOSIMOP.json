    "work_id": "oglt-pl/pseudo-zosimus/pl20_16_epistolas.zosimop",
    "canonical_ref": "PL20.EPISTOLAS.2.2.s5",
    "language": "lat",
    "text": "Lazarum indebite episcopum criminatorem fratris ordinatum, scias nostro judicio esse da- mnatum.",
