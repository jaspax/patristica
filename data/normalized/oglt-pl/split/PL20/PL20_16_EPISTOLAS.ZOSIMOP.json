    "work_id": "oglt-pl/pseudo-zosimus/pl20_16_epistolas.zosimop",
    "canonical_ref": "PL20.EPISTOLAS.1.s2",
    "language": "lat",
    "text": "Sed eidem antiquitati primum adversatur usurpatum in ipsius inscriptione archiepiscopi vocabulum.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
