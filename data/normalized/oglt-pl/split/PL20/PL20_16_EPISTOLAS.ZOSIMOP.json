    "work_id": "oglt-pl/pseudo-zosimus/pl20_16_epistolas.zosimop",
    "canonical_ref": "PL20.EPISTOLAS.1.s8",
    "language": "lat",
    "text": "An sententiam, quam a se « numerosa cognitione » praemissa pro- nuntiatam testatur, quarto post die mutasse dicen- dus est?",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
