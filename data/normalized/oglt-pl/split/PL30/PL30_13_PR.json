    "work_id": "oglt-pl/pseudo-hieronymus/pl30_13_pr",
    "canonical_ref": "PL30.PR.1.s9",
    "language": "lat",
    "text": "ut re­ quirentibus demonstraret, in quo apprehendens eral per Nathan filium David introitu, recurrentis in Deum generationis admisso, inseparabilis Dei,",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
