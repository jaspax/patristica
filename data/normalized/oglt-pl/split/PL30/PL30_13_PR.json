    "work_id": "oglt-pl/pseudo-hieronymus/pl30_13_pr",
    "canonical_ref": "PL30.PR.1.s8",
    "language": "lat",
    "text": "Cui ideo post baptismum Filii Dei, a perfectione gene- rationis in Christo impletæ, repetendæ a principio nativitatis humanæ, potestas permissa est :",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
