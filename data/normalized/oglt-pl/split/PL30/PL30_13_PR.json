    "work_id": "oglt-pl/pseudo-hieronymus/pl30_13_pr",
    "canonical_ref": "PL30.PR.1.s2",
    "language": "lat",
    "text": "Nam neque uxorem umquam habens, neque filios : septuaginta et quatuor annorum obiit in Bi­ thynia plenus Spiritu sancto.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
