    "work_id": "oglt-pl/pseudo-hieronymus/pl30_13_pr",
    "canonical_ref": "PL30.PR.1.s11",
    "language": "lat",
    "text": "Cui lucæ non immerito etiam scribendo­ rum Actuum apostolorum potestas in ministerio datur :",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
