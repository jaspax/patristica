    "work_id": "oglt-pl/pseudo-hieronymus/pl30_13_pr",
    "canonical_ref": "PL30.PR.1.s10",
    "language": "lat",
    "text": "ut praedicans in omnibus Cbristuro suum perfecti opus hominis redire in se per filium faceret : qui per David .patrem venientibus iter praebebat it Christo.",
    "chunk_index": 10,
    "context_before": null,
