    "work_id": "oglt-pl/pseudo-hieronymus/pl30_13_pr",
    "canonical_ref": "PL30.PR.1.s13",
    "language": "lat",
    "text": "Sicque Paulus consummationem apostolicis actibus daret: quamdiu contra stimulum recalcitrautem Dominus clegisset.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
