    "canonical_ref": "PL8.EPISTOLA.4.s17",
    "language": "lat",
    "text": "aut docere, aut accusando, aut mussi- tando retulerit, vel detrahendo, scriptis mandaverit, per hanc manifeste nos ita credere et docere agnoscatis.",
