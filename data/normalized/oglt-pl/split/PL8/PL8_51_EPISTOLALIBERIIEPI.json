    "canonical_ref": "PL8.EPISTOLALIBERIIEPI.latin.s1",
    "language": "lat",
    "text": "Haec igitur est nostra confessio, optatissime Atha- nasi. Verbum Dei filius secundum naturam ex Deo et Patre genitus, non creatus;",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 359,
    "date_range": [
      352,
      366
    ],
