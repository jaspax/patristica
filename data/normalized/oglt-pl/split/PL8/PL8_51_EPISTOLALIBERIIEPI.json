    "work_id": "oglt-pl/liberius/pl8_51_epistolaliberiiepi",
    "canonical_ref": "PL8.EPISTOLALIBERIIEPI.latin.s23",
    "language": "lat",
    "text": "qui perfectum hominem assumpsit sine peccato, natus ex Spiritu sancto et Maria virgine, secundum Evangelia, in Christo Jesu, amen.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
