    "work_id": "oglt-pl/varii/pl18_11_un",
    "canonical_ref": "PL18.UN.2.s3",
    "language": "lat",
    "text": "Haud aliter quam si rostris quis tentet eburnis Coenosum versare solum, limoque madentes Excolere aureolis si forte ligonius ulnas.",
    "chunk_index": 6,
    "context_before": null,
