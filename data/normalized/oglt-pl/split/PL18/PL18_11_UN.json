    "canonical_ref": "PL18.UN.2.s1",
    "language": "lat",
    "text": "O linguam miro verborum fonte fluentem, Romani decus eloquii, cui cedat et ipse. Tullius! has fundit dives facundia gemmas.",
    "chunk_index": 4,
    "context_before": null,
