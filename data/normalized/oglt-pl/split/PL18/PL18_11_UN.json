    "work_id": "oglt-pl/varii/pl18_11_un",
    "canonical_ref": "PL18.UN.2.s5",
    "language": "lat",
    "text": "Non ausim conferre pedem, nec spicula tantae Indocilis fandi conjecta lacessere linguae.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
