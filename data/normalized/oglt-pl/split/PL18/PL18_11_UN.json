    "work_id": "oglt-pl/varii/pl18_11_un",
    "canonical_ref": "PL18.UN.2.s2",
    "language": "lat",
    "text": "Os dignum aeterno tinctum quod fulgeat auro, Si mallet laudare Deum, cui sordida monstra Praetulit, et liquidam temeravit crimine vocem.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
