    "work_id": "oglt-pl/varii/pl18_11_un",
    "canonical_ref": "PL18.UN.3.s1",
    "language": "lat",
    "text": "Sum plane temerarius, Qui nocti mihi conscius, Quam vitae in tenebris ago, Puppim credere fluctibus Tanti non timeam viri, Quo nunc nemo disertior.",
