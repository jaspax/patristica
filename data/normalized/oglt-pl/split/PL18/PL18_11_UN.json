    "canonical_ref": "PL18.UN.2.s6",
    "language": "lat",
    "text": "Illaesus maneat liber, excellensque volumen Obtineat partam dicendi fulmine famam. Idem in praefatione lib. ii",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
