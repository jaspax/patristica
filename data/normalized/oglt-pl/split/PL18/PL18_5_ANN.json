    "work_id": "oglt-pl/novatus-catholicus/pl18_5_ann",
    "canonical_ref": "PL18.ANN.s22",
    "language": "lat",
    "text": "Idcirco primum humilitatem fratribus vestris monstrare debetis propter imitationem; ut fundata sit ipsa humilitas intus in corde secundum Deum.",
    "chunk_index": 21,
    "context_before": null,
