    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/anonymus/pl13_21_co#PL13.CO.s8",
    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s8",
    "language": "lat",
    "text": "Certe hanc ipsam Arianorum objectionem de genito et ingenito proponunt sibi dissolvuntque sapienter Basi- lius, orat, contra Arr., ed. Garn., t. II, p. 194; et Ambrosius, de Incarn.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
