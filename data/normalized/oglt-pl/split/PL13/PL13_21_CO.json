    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/anonymus/pl13_21_co#PL13.CO.s24",
    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s24",
    "language": "lat",
    "text": "Pater factus non est; Spiritus sanctus factus non est; Filius factus non est : ergo ejusdem erit substantiae Spiritus sanctus, vel Filius, cujus et pater est.",
