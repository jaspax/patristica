    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s9",
    "language": "lat",
    "text": "sacramento, capp. 8 et 9; item- que Augustinus de Trin., V, 4, qui et de illa sic pro- aemiatur :",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
