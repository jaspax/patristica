    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s4",
    "language": "lat",
    "text": "pertinere suspicabar ad tractatus illos Augustini contra praedictam haeresim quos deperditos esse scimus. Equidem sentio me periculose admodum de hac re pronuntiare;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
