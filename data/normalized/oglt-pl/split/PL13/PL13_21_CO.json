    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s26",
    "language": "lat",
    "text": "sed mundus factus est, Pater autem non est factus, sed neque Filius neque Spiri- tus sanctus;",
