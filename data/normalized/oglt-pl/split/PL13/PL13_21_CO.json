    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/anonymus/pl13_21_co#PL13.CO.s27",
    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s27",
    "language": "lat",
    "text": "ergo solus mundus non erit ejusdem substantiae, cujus Pater, vel Filius, vel Spiritus sanctus.",
