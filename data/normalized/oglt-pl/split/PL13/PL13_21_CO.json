    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/anonymus/pl13_21_co#PL13.CO.s15",
    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s15",
    "language": "lat",
    "text": "Secundum quam formam et ego interrogo : si differentia est geniti nomen ab ingenito, ne eadem videatur sub- stantia :",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/anonymus/pl13_21_co#PL13.CO.s16",
    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s16",
    "language": "lat",
    "text": "ergo quodcumque ingenitum dicitur*, ejus- dem erit substantiae, si geniti ab ingenito discrepat nomen.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
