    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s3",
    "language": "lat",
    "text": "In posteriore autem membrana, quae manu eadem perscripta est, fragmen- tum item legebam contra Arianos, quod ego cum con- siderarem,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
