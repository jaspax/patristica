    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/anonymus/pl13_21_co#PL13.CO.s14",
    "work_id": "oglt-pl/anonymus/pl13_21_co",
    "canonical_ref": "PL13.CO.s14",
    "language": "lat",
    "text": "ut per id quod dissimilis sonus in nomine est, non videatur Patris et Filii et 4 Cod. esse. Spiritus sancti eadem esse substantia.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
      450
    ],
