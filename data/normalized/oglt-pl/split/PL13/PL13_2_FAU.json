    "canonical_ref": "PL13.FAU.s4",
    "language": "lat",
    "text": "cum semper catholica fides unam substantiam Patris et Filii et Spiritus sancti confessa sit.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 382,
    "date_range": [
      380,
      384
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
