    "work_id": "oglt-pl/faustinus-presbyter/pl13_2_fau",
    "canonical_ref": "PL13.FAU.1.s6",
    "language": "lat",
    "text": "Nam qui nos putant esse Apollinaristas, sciant quod non minus Apollinaris haeresim exsecramur quam Aria- nam.",
    "chunk_index": 9,
    "context_before": null,
