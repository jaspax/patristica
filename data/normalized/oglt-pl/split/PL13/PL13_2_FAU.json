    "work_id": "oglt-pl/faustinus-presbyter/pl13_2_fau",
    "canonical_ref": "PL13.FAU.1.s5",
    "language": "lat",
    "text": "sed est ejusdem et ipse substantiae cum Patre et Filio, sicut ejusdem deitatis.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 382,
    "date_range": [
      380,
      384
    ],
    "date_confidence": "approximate",
