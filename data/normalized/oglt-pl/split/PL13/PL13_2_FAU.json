    "work_id": "oglt-pl/faustinus-presbyter/pl13_2_fau",
    "canonical_ref": "PL13.FAU.1.s2",
    "language": "lat",
    "text": "et Filium credimus, qui non sit Pater, sed habeat patrem, de quo sit genitus, non factus; et Spiritum sanctum credimus, qui sit vere Spiritus Dei.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 382,
    "date_range": [
      380,
      384
    ],
    "date_confidence": "approximate",
