    "work_id": "oglt-pl/faustinus-presbyter/pl13_2_fau",
    "canonical_ref": "PL13.FAU.1.s3",
    "language": "lat",
    "text": "Unde et divinae Trinitatis unam substantiam confitemur; quin qualis esi Pater secundum substantiam; talem genuit et Filium :",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 382,
    "date_range": [
      380,
      384
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
