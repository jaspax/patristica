    "work_id": "oglt-pl/faustinus-presbyter/pl13_2_fau",
    "canonical_ref": "PL13.FAU.1.s4",
    "language": "lat",
    "text": "et Spiritus sanctus, non creatura exsistens, sed Spiritus Dei, non est alienus a substantia Patris et Fili;",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 382,
    "date_range": [
      380,
      384
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
