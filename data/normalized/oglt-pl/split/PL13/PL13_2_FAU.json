    "work_id": "oglt-pl/faustinus-presbyter/pl13_2_fau",
    "canonical_ref": "PL13.FAU.1.s1",
    "language": "lat",
    "text": "Nos Patrem credimus, qui non sit Filius, sed habeat Filium de se sine initio genitum, non factum;",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 382,
    "date_range": [
      380,
      384
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
