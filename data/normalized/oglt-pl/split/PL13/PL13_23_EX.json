    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s9",
    "language": "lat",
    "text": "Cum autem dicimus Deum Patrem omnipotentem, non potest hujus nominis evacuari b Cod. ab aeternae Patris persona et credere.",
