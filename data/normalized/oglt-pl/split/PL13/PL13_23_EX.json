    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s6",
    "language": "lat",
    "text": "naturas introducentes ut Arius blasphemat, qui tres deos praedicavit, excellentiorem, minorem, et infe- riorem.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      360,
