    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s7",
    "language": "lat",
    "text": "Nos vero sanctam Trinitatem in unitate, et unitatem in sancta Trinitate confitemur. Nam cum dicimus omnipotentem Patrem, appellatio hujus Paterni nominis ad Filii personam attenditur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
