    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s14",
    "language": "lat",
    "text": "et si potuerit hoc approbari, nulla erit dubietas ex illo initio Paterni nominis Filium initium accepisse, quo Pater nomina- tus est.",
