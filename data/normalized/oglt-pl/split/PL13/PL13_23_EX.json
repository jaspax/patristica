    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s5",
    "language": "lat",
    "text": "Non tres a Ex antiquo codice Vaticano, olim Bobiensi. post libros S. Augustini de Trinitate.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
