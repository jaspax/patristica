    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s8",
    "language": "lat",
    "text": "Et cum dicimus aeternum Filium, ad aeterni Patris personam refertur. Et cum nominamus Spiritum sanctum, ab aeterni Patris persona eum credere b demonstramus.",
