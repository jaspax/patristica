    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s13",
    "language": "lat",
    "text": "Si in tempore, si extra tempus, dicat nobis aliquis quando primitus coeperit appellari :",
    "chunk_index": 12,
