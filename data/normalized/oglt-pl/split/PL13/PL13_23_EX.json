    "work_id": "oglt-pl/anonymus/pl13_23_ex",
    "canonical_ref": "PL13.EX.s10",
    "language": "lat",
    "text": "sacramentum : quia cum dieimus Patrem, Filium de- monstramus : et cum dicimus Filium, Patrem decla- ramus : et cum dicimus aeternum Patrem, aeternum Filium demonstramus.",
