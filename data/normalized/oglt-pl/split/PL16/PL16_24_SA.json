    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.48",
    "language": "lat",
    "text": "Verusque sol illabere, Micans nitore perpeti, Jubarque sancti Spiritus Infunde nostris sensibus.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
