    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.66",
    "language": "lat",
    "text": "Te lingua primum concinat, Te mentis ardor ambiat; Ut actuum sequentium Tu, sancte. sis exordium.",
