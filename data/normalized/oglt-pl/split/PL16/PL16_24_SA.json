    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.68",
    "language": "lat",
    "text": "Precamur iidem supplices, Noxas ut omnes amputes ; Ne ore te canentium Lauderis in perpetuum.",
    "chunk_index": 68,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
