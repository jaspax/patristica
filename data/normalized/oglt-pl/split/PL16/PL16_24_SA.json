    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.58",
    "language": "lat",
    "text": "Terrore victo sæculi, 1223 Spretisque pœnis corporis, Mortis sacræ compendio, Vitam beatam possident.",
