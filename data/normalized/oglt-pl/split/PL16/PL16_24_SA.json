    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.65",
    "language": "lat",
    "text": "Somno refectis artubus, Spreto cubili surgimus, Nobis, Pater, canentibus Adesse te deposcimus.",
