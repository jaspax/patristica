    "chunk_id": "oglt_pl/ambrosius/pl16_24_sa#PL16.SA.63",
    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.63",
    "language": "lat",
    "text": "Te nunc, Redemptor, quæsumus, Ut ipsorum consortio Jungas precantes servulos, In sempiterna sæcula. Amen.",
