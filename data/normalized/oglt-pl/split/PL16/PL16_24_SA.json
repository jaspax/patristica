    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.49",
    "language": "lat",
    "text": "Votis vocemus et Patrem, Patrem perennis gloriæ, Patrem potentis gratiæ, Culpam releget lubricam",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
