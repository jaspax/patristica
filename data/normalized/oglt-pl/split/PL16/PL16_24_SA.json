    "chunk_id": "oglt_pl/ambrosius/pl16_24_sa#PL16.SA.69",
    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.69",
    "language": "lat",
    "text": "Præsta, Pater piissime , Patrique compar unice, 1224Cum Spiritu paraclito Regnans per omne sæcutum.",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
