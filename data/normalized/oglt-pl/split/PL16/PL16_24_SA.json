    "canonical_ref": "PL16.SA.47",
    "language": "lat",
    "text": "Splendor Paternæ gloriæ , De luce lucem proferens, Primordiis lucis novæ Diem dies illuminans.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
