    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.42",
    "language": "lat",
    "text": "Multiplicabatur magis Dispendio panis suo: 1222 Quis hæc videns mirabitur Juges meatus fontium ?",
