    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.43",
    "language": "lat",
    "text": "Inter manus frangentium Panis rigatur profluus : Intacta quæ non fregerant, Fragmenta subrepunt viris.",
