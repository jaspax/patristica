    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.53",
    "language": "lat",
    "text": "Lætus dies hic transeat, Pudor sit ut diluculum, Fides velut meridies, Crepusculum mens nesciat.",
