    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.50",
    "language": "lat",
    "text": "Informet actus strenuos, Dentes retundat invidi, Casus secundet asperos, Donet gerendi gratiam.",
    "chunk_index": 50,
    "context_before": null,
