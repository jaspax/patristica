    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.60",
    "language": "lat",
    "text": "Nudata pendent viscera, Sanguis sacratus funditur, Sed permanent immobiles Vitæ perennis gratia.",
