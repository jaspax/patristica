    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.51",
    "language": "lat",
    "text": "Mentem gubernet et regat, Casto fideli corpore, Fides calore ferveat , Fraudis venena nesciat.",
