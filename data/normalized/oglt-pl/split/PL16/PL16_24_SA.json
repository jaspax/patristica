    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.40",
    "language": "lat",
    "text": "Aquas colorari videns, Inebriare flumina; Mutata elementa stupent Transire in usus alteros.",
