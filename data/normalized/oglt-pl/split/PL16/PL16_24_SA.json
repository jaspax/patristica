    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.62",
    "language": "lat",
    "text": "In his Paterna gloria, In his voluntas Filii, Exsultat in his Spiritus Cœlum repletur gaudiis.",
