    "chunk_id": "oglt_pl/ambrosius/pl16_24_sa#PL16.SA.67",
    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.67",
    "language": "lat",
    "text": "Cedant tenebræ lumini, Et nox diurno sideri ; Ut culpa quam nox intulit, Lucis labascat munere.",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
      374,
      397
    ],
