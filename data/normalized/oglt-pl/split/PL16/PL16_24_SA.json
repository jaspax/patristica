    "work_id": "oglt_pl/ambrosius/pl16_24_sa",
    "canonical_ref": "PL16.SA.41",
    "language": "lat",
    "text": "Sic quinque millibus viris Dum quinque panes dividis, Edentium sub dentibus In ore crescebat cibus.",
