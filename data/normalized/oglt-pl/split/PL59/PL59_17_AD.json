  },
  {
    "chunk_id": "oglt-pl/avitus-viennensis/pl59_17_ad#PL59.AD.16.s2",
    "work_id": "oglt-pl/avitus-viennensis/pl59_17_ad",
    "canonical_ref": "PL59.AD.16.s2",
    "language": "lat",
    "text": "Ait Paulus apostolus : Nihil intulimus in hunc mundum, sed nec auferre pos­ sumus (I Tim.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
      518
    ],
