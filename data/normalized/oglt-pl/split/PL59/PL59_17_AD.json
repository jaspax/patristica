    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/avitus-viennensis/pl59_17_ad#PL59.AD.16.s3",
    "work_id": "oglt-pl/avitus-viennensis/pl59_17_ad",
    "canonical_ref": "PL59.AD.16.s3",
    "language": "lat",
    "text": "vi, 7). Et quid nostrum dici potest, quod non intulimus, quodque non relaturi sumus?",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
