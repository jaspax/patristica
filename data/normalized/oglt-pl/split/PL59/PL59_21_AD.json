    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s2",
    "language": "lat",
    "text": "Neque enim illud centuplicato fenore promittitur reformandum, quod unusquisque animo miserendi alimoniae pauperum pia professione contulerit;",
    "chunk_index": 8,
    "context_before": null,
