    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s18",
    "language": "lat",
    "text": "x, 35) : id est, ut quorumlibet affectuum personæ, ten­ dentibus nobis ad Christum, si comitari noluerint, deserantur.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
