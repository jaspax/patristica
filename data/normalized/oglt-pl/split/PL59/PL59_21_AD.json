    "canonical_ref": "PL59.AD.5.s17",
    "language": "lat",
    "text": "De qua divisione idem Dominus alio loco : Veni, inquit, separare filios adversus parentes, nurum adversus socrum (Matth.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
      518
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
