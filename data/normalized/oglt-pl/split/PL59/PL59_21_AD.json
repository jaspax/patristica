    "chunk_id": "oglt-pl/avitus-viennensis/pl59_21_ad#PL59.AD.5.s22",
    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s22",
    "language": "lat",
    "text": "Et quod Deus, in­ quit, conjunxit, homo non separet (Matth. XIX, 6; Marc. x, 9). Et Apostolus protestatur (I Tim.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
