  {
    "chunk_id": "oglt-pl/avitus-viennensis/pl59_21_ad#PL59.AD.5.s19",
    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s19",
    "language": "lat",
    "text": "Excepto autem hoc sensu, propinquita­ tes istas non semper nobis ut præjudicatas debere dimitti, et exemplis et ratione colligitur.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
      518
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/avitus-viennensis/pl59_21_ad#PL59.AD.5.s20",
    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s20",
    "language": "lat",
    "text": "Nec enim et illi propinqui dimittendi sunt, qui ad cœlestes co­ ronas contemptu sæculi calcata morte festinant;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
      518
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/avitus-viennensis/pl59_21_ad#PL59.AD.5.s21",
    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s21",
    "language": "lat",
    "text": "neque suadere fidelibus possumus ut conjugia vel parentes abjiciant, cum Dominus clamet quod non liceat homini dimittere uxorem.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
      518
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
