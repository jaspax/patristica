    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s3",
    "language": "lat",
    "text": "quia et in hac ipsa eleemosynaria largi­ tale, in qua operantis sensus potius quam census aspicilur, non est doni quantitas pensanda, sed stu- dii.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
