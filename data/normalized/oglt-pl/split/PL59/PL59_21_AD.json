    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s1",
    "language": "lat",
    "text": "Quæstio quam pietas vestra disserendam proposuit, tota prorsus ad interiorem figuram spiritali conside­ ratione referenda est.",
    "chunk_index": 7,
