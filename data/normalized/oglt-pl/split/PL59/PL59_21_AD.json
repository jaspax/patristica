  },
  {
    "chunk_id": "oglt-pl/avitus-viennensis/pl59_21_ad#PL59.AD.5.s4",
    "work_id": "oglt-pl/avitus-viennensis/pl59_21_ad",
    "canonical_ref": "PL59.AD.5.s4",
    "language": "lat",
    "text": "Quo factum est per evangelicam lectionem, ut inlinitis auri argentique donariis paupertina numm duplicis præferatur eblatio.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 504,
    "date_range": [
      490,
