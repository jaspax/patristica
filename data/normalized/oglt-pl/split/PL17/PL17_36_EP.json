    "work_id": "oglt-pl/pseudo-ambrosius/pl17_36_ep",
    "canonical_ref": "PL17.EP.s4",
    "language": "lat",
    "text": "Posterior minus habet Ambrosii : aed tamen appressimus utramque, quia utramque antiquam esse et utilem judicavimus.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
