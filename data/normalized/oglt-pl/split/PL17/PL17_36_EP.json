    "work_id": "oglt-pl/pseudo-ambrosius/pl17_36_ep",
    "canonical_ref": "PL17.EP.2.s1",
    "language": "lat",
    "text": "Vir quidam religiosus atque in monachico habitu I constitutus tunc, nostro tempore nunc antiqui hostis est inaudita tentatione pulsatus,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
