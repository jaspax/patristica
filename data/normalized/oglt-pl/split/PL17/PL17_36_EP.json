    "canonical_ref": "PL17.EP.s2",
    "language": "lat",
    "text": "Priorem esse Ambrosii persuadebat materia ad illud tempus accommodata de Antonio, Hilarione, Machario, Gervasio, Prothasio, de Mediolanensi civitate in qua scriptam fuisse constat.",
    "chunk_index": 1,
    "context_before": null,
