    "work_id": "oglt-pl/pseudo-ambrosius/pl17_36_ep",
    "canonical_ref": "PL17.EP.s3",
    "language": "lat",
    "text": "Illud tantum u: dubitaremus fecit, quod vocet Germanicos et Anglicos et Italicos.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
