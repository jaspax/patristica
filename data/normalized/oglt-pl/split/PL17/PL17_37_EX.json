    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.2.s5",
    "language": "lat",
    "text": "Deinde frequenter admonui, quod Dominus noster Jesus Christus Filius Dei solus carnem istam suscepit, corporis forma.",
