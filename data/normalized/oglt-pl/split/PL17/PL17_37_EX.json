      397
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s8",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s8",
    "language": "lat",
    "text": "Crede quia resurget et caro. Quid enim opus fuit, ut Christus carnem susciperet ?",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
      374,
      397
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s9",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s9",
    "language": "lat",
    "text": "quid opus fuit ut Christus mortem gustaret, sepultu­ ram susciperet et resurgeret, nisi propter tuam resur­ rectionem?",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
      374,
      397
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s10",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s10",
    "language": "lat",
    "text": "Totum hoc sacramentum tuæ est resurre­ ctionis. Si Christus non resurrexit, vana est fides no­ stra : sed quia rcsurrexiL,ideo firma est fides nostra.",
    "chunk_index": 59,
    "context_before": null,
