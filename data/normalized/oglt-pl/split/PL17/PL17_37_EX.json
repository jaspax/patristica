      397
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.4.s17",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.4.s17",
    "language": "lat",
    "text": "Vides ergo unius operationis, unius sanctifi­ cationis, unius majestatis esse venerabilem trini­ tatem.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
