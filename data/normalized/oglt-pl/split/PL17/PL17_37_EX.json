    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s2",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s2",
    "language": "lat",
    "text": "Quid ergo? Par causa est. Sic ere­ dimus in Christum, sic credimus in Patrem,quemad­ modum credimus et in Ecclesiam, et in remissionem peccatorum, et in carnis resurrectionem.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
