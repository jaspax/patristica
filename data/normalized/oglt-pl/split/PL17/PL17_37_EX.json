  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.6.s5",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s5",
    "language": "lat",
    "text": "Si qui, inquit, addideriS aut detraxerit, judicium sibi sumit et pcenam.",
    "chunk_index": 64,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
