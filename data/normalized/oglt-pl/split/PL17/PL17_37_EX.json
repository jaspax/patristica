    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s5",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s5",
    "language": "lat",
    "text": "Nunc fides tua amplius elucebit, si in opus auctoris tui fidem veram et in­ tegram putaveris deferendam.",
