  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s1",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s1",
    "language": "lat",
    "text": "Sane accipe rationem quemadmodum credimus in auctorem; ne forte dicas, sed habet et in Ecclesium, I sed habet et in remissionem peccatorum, sed habet et in resurrectionem.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
