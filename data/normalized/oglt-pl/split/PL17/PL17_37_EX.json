    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.4.s13",
    "language": "lat",
    "text": "Cave ergo detrahere ei, quem judi­ cem habiturus es. Quare boc mysterium ?",
