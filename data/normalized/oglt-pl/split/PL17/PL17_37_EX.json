    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s7",
    "language": "lat",
    "text": "Hoc autem est symbolum quod Romana Ecclesia tenet, ubi primus apostolorum Petrus se­ dit, et communem sententiam eo detulit.",
