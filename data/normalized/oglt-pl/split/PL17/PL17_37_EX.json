    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s7",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s7",
    "language": "lat",
    "text": "Quare legisti in Evangelio, dieente Domino : Fides tua te salvum fecit. Resurrectionem.",
