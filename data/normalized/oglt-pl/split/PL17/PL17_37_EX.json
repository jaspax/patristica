    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.6.s1",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s1",
    "language": "lat",
    "text": "Ergo dixi apostolos symbolum composuisse. Si ergo mercum istarum negotiatores et collatores pe­ cuniae hanc habent legem,",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
