    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.6.s4",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s4",
    "language": "lat",
    "text": "ibi enim evidenter om­ nipotentem Dominum nostrum Jesum Christum me- moravit.Licet et in aliis locis, tameo in ipso .libello :",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
