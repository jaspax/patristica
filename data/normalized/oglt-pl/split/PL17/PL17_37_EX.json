    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.4.s14",
    "language": "lat",
    "text": "Numquid non unum juditium est Patris et Filii et Spiritus sancti? Numquid eon una voluntas est? Numquid non una majestas?",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
