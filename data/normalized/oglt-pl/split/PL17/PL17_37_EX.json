      397
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s3",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s3",
    "language": "lat",
    "text": "Quae ratio est? Quia qui credit in auctorem, credit et in opus auctoris.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
