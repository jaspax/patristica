    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.7.s1",
    "language": "lat",
    "text": "Ergo quemadmodum duodecim apostoli, et duo­ decim sententiæ. Signate vos.",
