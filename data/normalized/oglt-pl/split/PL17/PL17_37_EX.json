    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s6",
    "language": "lat",
    "text": "Sic unius apostoli Scripturis nihil est detrahendum, nibil addendum, quemadmodum nos symbolo quod accepimus ab apostolis traditum atque compositum, nihil debemus detrahere, nihil adjungere.",
    "chunk_index": 65,
    "context_before": null,
