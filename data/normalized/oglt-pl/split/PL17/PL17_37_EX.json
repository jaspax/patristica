    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.3.s5",
    "language": "lat",
    "text": "Ergo esto medici fuerint ma­ jores nostri; voluerint addere aegritudini sanitatem ; medicina non quaeritur.",
