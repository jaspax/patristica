    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s4",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s4",
    "language": "lat",
    "text": "Denique ne hoc ingenii nostri putetis, ac­ cipite testimonium : Si mihi non creditis,vel operi­ bes credite. Ergo hoc habes.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
