    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.4.s12",
    "language": "lat",
    "text": "Quare dico sedet ? Qui amat, babet quid timeat. Unde It mortuos? Ipse de nubis judicaturus est.",
