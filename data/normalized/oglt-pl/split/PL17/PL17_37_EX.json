    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.6.s2",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s2",
    "language": "lat",
    "text": "ut si qui symbolam suam violaverit, improbus et intestabilis habeatur, multo magis cavendum est nobis, ne de majorum symbolo aliquid detrahatur :",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
      374,
      397
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.6.s3",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.6.s3",
    "language": "lat",
    "text": "cum habeas in libro apocaly­ psis Joannis, qui libellus canonizauir, et maxime ad fidei proficit fundamentum :",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
      374,
      397
    ],
