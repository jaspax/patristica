  },
  {
    "chunk_id": "oglt-pl/ambrosius/pl17_37_ex#PL17.EX.5.s6",
    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.5.s6",
    "language": "lat",
    "text": "In Ecclesiam sanctam, it in remissionem peccatorum. Crede ergo ex lide, quia omnia tibi peccata remittantur.",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": 385,
    "date_range": [
      374,
