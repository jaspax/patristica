    "work_id": "oglt-pl/ambrosius/pl17_37_ex",
    "canonical_ref": "PL17.EX.2.s4",
    "language": "lat",
    "text": "Ubi enim nulla discretio majestatis est, nee fidei debet esse discretio.",
