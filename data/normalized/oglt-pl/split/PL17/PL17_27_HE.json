  {
    "chunk_id": "oglt-pl/pseudo-ambrosius/pl17_27_he#PL17.HE.3.s16",
    "work_id": "oglt-pl/pseudo-ambrosius/pl17_27_he",
    "canonical_ref": "PL17.HE.3.s16",
    "language": "lat",
    "text": "Post transmiqrationem Babylonis Jechonias genult Salathiel: sed priorem esse Patrem, secundum esse Filium :",
