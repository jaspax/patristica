    "canonical_ref": "PL17.HE.3.s15",
    "language": "lat",
    "text": "aui hon esse eumdem Jechoniam illum, de quo dicitur : Josias genuit Jechoniam; et illum de quo diciliif :",
    "chunk_index": 30,
    "context_before": null,
