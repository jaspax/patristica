    "work_id": "oglt-pl/pseudo-ambrosius/pl17_27_he",
    "canonical_ref": "PL17.HE.3.s10",
    "language": "lat",
    "text": "Ozias ergo, qui et Azarias, genuit Joatham , Joatham genuit Achaz, Achaz genuit Ezechiam , Ezechias genuit Manassen ,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
