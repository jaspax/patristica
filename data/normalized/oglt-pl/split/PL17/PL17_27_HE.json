  },
  {
    "chunk_id": "oglt-pl/pseudo-ambrosius/pl17_27_he#PL17.HE.3.s11",
    "work_id": "oglt-pl/pseudo-ambrosius/pl17_27_he",
    "canonical_ref": "PL17.HE.3.s11",
    "language": "lat",
    "text": "Manasses genuit Amon, Amon genuit Josiam, Josias genuit Jechoriiam, Jechonias genuit 610 Salathiel.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
