    "work_id": "oglt-pl/pseudo-ambrosius/pl17_27_he",
    "canonical_ref": "PL17.HE.3.s13",
    "language": "lat",
    "text": "Eleachim autem genuit Joachim, qui et ipse sicut pater, je- chonias appellatus est: hic demum genuit Salathiel.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
