  },
  {
    "chunk_id": "oglt-pl/pseudo-ambrosius/pl17_27_he#PL17.HE.3.s12",
    "work_id": "oglt-pl/pseudo-ambrosius/pl17_27_he",
    "canonical_ref": "PL17.HE.3.s12",
    "language": "lat",
    "text": "Ve­ ritas historiæ habet quod Josias genuerit Eleachim, qui et Joachim, sive Jechonias dictus est:",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
