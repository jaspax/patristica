    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s1",
    "language": "lat",
    "text": "Principaliter nomen ab ipsis incunabulis justitiae suscepisti: et juslus Dominus qui ita præstitit, ut nomen ante justitiæ tribuerit, cui imperii postmo­ dum gubernacula contulisset.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
    "date_range": [
      544,
