    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s11",
    "language": "lat",
    "text": "Nunc autem quibus recitabimr sententia d amna­ tionis nostræ? Quod in eis recorrigatur non est. Sed timeo, piissimc imperator.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
    "date_range": [
