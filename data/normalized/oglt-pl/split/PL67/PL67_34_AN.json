    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s10",
    "language": "lat",
    "text": "Quod si adhuc viverent, et correpti erro­ rem suum non condemnarent, justissime damnaren­ tur.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
