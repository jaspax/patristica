    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s4",
    "language": "lat",
    "text": "Super hanc petram ædi­ ficabo Ecclesiam meam, et portæ inferi non prævale­ bunt adversus eam, et tibi dabo claves regni cœlorum (Matth. XVI).",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
    "date_range": [
      544,
      545
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
