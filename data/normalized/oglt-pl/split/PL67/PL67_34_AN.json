    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s12",
    "language": "lat",
    "text": "ne sub obtentu damnatio- nis istorum Eutychiana hæresis erigatur : et dum minima indicia non spernimus, ad majorem hæreim collisionemque veniamus.",
