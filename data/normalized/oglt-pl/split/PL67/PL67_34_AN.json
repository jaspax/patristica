    "canonical_ref": "PL67.AN.3",
    "language": "lat",
    "text": "Clementissimo atque piissimo filio Justiniano im­ peratori Pontianus episcopus in Domino salutem.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
