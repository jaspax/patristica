    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s9",
    "language": "lat",
    "text": "dicta possumus respicere, non auctores dicto­ rum jam mortuos præcipiti condemnatione dam­ nare.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
    "date_range": [
