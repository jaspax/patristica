    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s13",
    "language": "lat",
    "text": "Et quid nobis cum mortuis inire bellum, ubi nulla invenitur in congressione vi­ ctoria Apud judicem verum jam tenentur, a quo nul­ lus appellat.",
    "chunk_index": 16,
    "context_before": null,
