    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s2",
    "language": "lat",
    "text": "Adunata est igitur gra­ tia Creatoris non solum in nomine, verum etiam et merito, cujus vita exaltata est imperando. et im- perium juste vivendo.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
    "date_range": [
      544,
      545
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
