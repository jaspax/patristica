    "work_id": "oglt-pl/pontianus-africanus/pl67_34_an",
    "canonical_ref": "PL67.AN.4.s3",
    "language": "lat",
    "text": "Dignatus es nos in Africanis partibus commorantes literis admonere, qualem fidem teneas et defendas. Cognovimus qu d Dominus beato Petro statuit, dicens :",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 544,
    "date_range": [
      544,
      545
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
