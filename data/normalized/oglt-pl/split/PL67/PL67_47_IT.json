  },
  {
    "chunk_id": "oglt-pl/caesarius-arelatensis/pl67_47_it#PL67.IT.1.s3",
    "work_id": "oglt-pl/caesarius-arelatensis/pl67_47_it",
    "canonical_ref": "PL67.IT.1.s3",
    "language": "lat",
    "text": "Moram autem faciente 'pomo, dormitaverunt omnes et dormie­ runt.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
      502,
      542
    ],
