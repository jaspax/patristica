    "work_id": "oglt-pl/caesarius-arelatensis/pl67_47_it",
    "canonical_ref": "PL67.IT.1.s2",
    "language": "lat",
    "text": "sed fatuæ non habuerunt oteum lampadibus præparatum ; prudentes vero sumpserunt oleum in vasis suis.",
