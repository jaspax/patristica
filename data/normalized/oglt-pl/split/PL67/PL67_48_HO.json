    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s2",
    "language": "lat",
    "text": "Et sic demum henignus Deus dat illi tristitiam pro peccatis, et post hæc iterum pro sua benignitate donat illi afflictio­ nem corporis, jejunia et vigilias et orationum instan­ tiam,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
      502,
      542
    ],
    "date_confidence": "approximate",
