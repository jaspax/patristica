    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s23",
    "language": "lat",
    "text": "Et quia gran le sit onus ipsarum et importabile subjungentes illi infirmitatem corporis et fragelitatem naturæ.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
