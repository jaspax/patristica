    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s7",
    "language": "lat",
    "text": "Si autem viderit quia haec iili suavia sunt, tentat eum si abrenuntiat voluutali­ bus suis , et rcsisiit adversus impugnationes hujus mundi principis.",
    "chunk_index": 8,
    "context_before": null,
