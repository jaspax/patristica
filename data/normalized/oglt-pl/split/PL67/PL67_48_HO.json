    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s3",
    "language": "lat",
    "text": "et contemptum mundi, ut libens illatas injurias sufferat, et in odium habeat omne refrigerium cor­ porale, et diligat planctum magis quam risum.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
