    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s11",
    "language": "lat",
    "text": "Si autem cognoverit quia cor illius firmum est in timore Dei ct non dimittit locum suum, sed for­ titer resistit cogitationibus, tunc veniunt illi sub occa­ sione justitiæ cogitationes, dicentes:",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
      502,
      542
    ],
    "date_confidence": "approximate",
