    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s8",
    "language": "lat",
    "text": "qui vinxerat eum prius esca variæ delectationis quæ mollire facit cor, ut rursus pro­ pemodum vincerc queat.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
