    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s10",
    "language": "lat",
    "text": "Et quia ardui laboris sit in merea­ tur quis habitatorem Deum habere, præsertim tu qui multa peccasti : et q uanta tibi possunt a Deo remitti peccata?",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
      502,
      542
    ],
