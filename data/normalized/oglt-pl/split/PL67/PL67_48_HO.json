    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s18",
    "language": "lat",
    "text": "Probasti cor meum, et visitasti nocte; igne me examinasti, et non est invenla in me iniquitas (Psal. XVI).",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
