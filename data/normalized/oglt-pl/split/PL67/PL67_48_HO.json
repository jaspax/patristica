    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s12",
    "language": "lat",
    "text": "Peccasti qui­ dem, sed pœnitentiam egisti, jam sanctus es, et la­ ciunt illum recordari quorumdam hominum peccata qui non egerunt pœnitentiam, superseminantes illi in corde vanam gloriam.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
