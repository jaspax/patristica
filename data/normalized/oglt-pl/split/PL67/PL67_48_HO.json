    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s17",
    "language": "lat",
    "text": "Si autem benignus Deus per­ spexerit quia uulli horum acquievit cur ipsius, di- cente David et de hujuscemodi tentationibus signifi­ cante:",
    "chunk_index": 18,
    "context_before": null,
