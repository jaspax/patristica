    "canonical_ref": "PL67.HO.2.s20",
    "language": "lat",
    "text": "tenebrarum , sed lucis , quia filius Dei dies est, diabolus vero nocti assimilatur (/ Thess.",
    "chunk_index": 21,
    "context_before": null,
