    "canonical_ref": "PL67.HO.2.s4",
    "language": "lat",
    "text": "PostI hæc, tribuit illi desiderium planctus et flemus, atque humilitatem cordis, ut trabem oculi sui consideret, non alterius festucam nitatur eruere;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
      502,
      542
    ],
