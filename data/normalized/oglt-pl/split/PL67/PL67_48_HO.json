    "canonical_ref": "PL67.HO.2.s15",
    "language": "lat",
    "text": "Et facilitatem ci ad hæc per­ ficienda tribuuntn si quomodo eum ad hæc alliciant, præcavente Scriptura et dicente :",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
    "date_range": [
