    "work_id": "oglt-pl/caesarius-arelatensis/pl67_48_ho",
    "canonical_ref": "PL67.HO.2.s16",
    "language": "lat",
    "text": "Ne declinaveris ad dexteram nec ad sinistram , sed rectum iter ingre­ dere (Deut. V et XVII).",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 522,
