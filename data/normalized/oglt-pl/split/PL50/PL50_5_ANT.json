  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.4.s18",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s18",
    "language": "lat",
    "text": "Conflige fortiter per puritatem bapti­ smi, quod contemnere noluisti.",
