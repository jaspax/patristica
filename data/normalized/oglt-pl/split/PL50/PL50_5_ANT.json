    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s1",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s1",
    "language": "lat",
    "text": "Job non attendit uxorem, et ideo vicit; non fami- Has, non divitias, non amicos, et merito superavit.",
