  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s6",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s6",
    "language": "lat",
    "text": "Ipse ar­ changelus qui cecidit, dimicat; ipse tecum luctatur; sed tecum est Pater et Filius et Spiritus sanctus.",
    "chunk_index": 16,
