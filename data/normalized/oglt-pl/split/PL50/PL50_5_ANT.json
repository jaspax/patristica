    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s4",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s4",
    "language": "lat",
    "text": "Deus unus est, Deus non potest esse minor, Deus non potest immutari. Scis ista, tene fortiter veritatem.",
