    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s8",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s8",
    "language": "lat",
    "text": "Sic Pater e t Filius, licet unum sint, et unus Deus sit, tamen ad so­ um Christum pertinet caro, sicut ad solam rationem pertinet sapientia, licet non recedat ab anima.",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
      437,
