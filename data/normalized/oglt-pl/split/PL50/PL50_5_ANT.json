    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.6.s5",
    "language": "lat",
    "text": "Implevit autem carnem Christi, et Pater et Spiritus sanctus; sed majestate non susceptione.",
