    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s7",
    "language": "lat",
    "text": "Time poenas æter­ nas, ubi semper ardetur, ubi semper in tenebris et corpus et anima cruciatur, ubi cum diabolo anima et corpus in æternum exuritur.",
