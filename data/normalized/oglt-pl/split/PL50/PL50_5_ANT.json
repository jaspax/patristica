    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s8",
    "language": "lat",
    "text": "Gehennas expa­ vesce, et Christum modo tene. Modo est ut aut vivas aut pereas.",
