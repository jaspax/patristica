    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s2",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s2",
    "language": "lat",
    "text": "Si­ gnifer es Christi; in acie primus ambulas : si tu cecideris, ab aliorum morte non eris immunis.",
