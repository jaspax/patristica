  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s9",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s9",
    "language": "lat",
    "text": "Respice quia in utero matris Deus te fecit; ipse tibi spiritum et ani­ mam dedit, ipso te ornavit ratione et sapientia.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
