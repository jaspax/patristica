    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.4.s19",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s19",
    "language": "lat",
    "text": "Securus esto de co­ rona; securus pugna, donec voluerit tibi Dominus terminare victoriam.",
