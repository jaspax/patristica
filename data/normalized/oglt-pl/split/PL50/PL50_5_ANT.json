    "canonical_ref": "PL50.ANT.4.s3",
    "language": "lat",
    "text": "x]), tribulatio, exspoliatio, exsilium, remissionem tibi contulit peccatorum; mors autem aperit tibi regna coelorum.",
    "chunk_index": 26,
