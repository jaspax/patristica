    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.2.s2",
    "language": "lat",
    "text": "Ecce jam serpens ille sub pedibus tuis jacet, ipse confligere potuit; sed ipse cecidit, quia te elidere non potuit.",
