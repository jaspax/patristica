  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s8",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s8",
    "language": "lat",
    "text": "Ante eam cruciabantur, et ipsa magis eos hortabatur ut morerentur : ipsa autem post filios occisos, ecce jam exsultat cum filiis coronata.",
    "chunk_index": 18,
    "context_before": null,
