    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s16",
    "language": "lat",
    "text": "Tu tamen exora, quia luctari coepisti nec de­ fecisti; martyrium inchoasti, custodi animam tuam.",
