    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s10",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s10",
    "language": "lat",
    "text": "Ipse coelum fecit et terram, et omnia quæin eis sunt.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
      437,
