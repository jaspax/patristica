    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.4.s9",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s9",
    "language": "lat",
    "text": "Nemo te recuperabit si in ista pugna de­ feceris. Et quid tibi prodest, si diabolo consenseris, et mox corpus amiseris?",
