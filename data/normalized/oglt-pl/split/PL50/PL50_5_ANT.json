    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.2.s9",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.2.s9",
    "language": "lat",
    "text": "Verum, frater, habes certamen; integra est ista confessio : Si mortuus fueris, certus esto, mar1yr eris.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
