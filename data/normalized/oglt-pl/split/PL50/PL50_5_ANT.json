    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s12",
    "language": "lat",
    "text": "Respice solem ct lunam et stellas : et ipsa sol­ venda sunt. Conflige fortiter pro anima tua, quæ aut semper vivit aut semper perit.",
    "chunk_index": 22,
    "context_before": null,
