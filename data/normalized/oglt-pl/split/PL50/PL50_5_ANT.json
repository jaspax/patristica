    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s5",
    "language": "lat",
    "text": "Christum mox tua anima videbit; et corpus tuum erit in refri- gerio resurrectionis, ut et ipsa caro videat quod tua anima cum exierit mox videbit.",
    "chunk_index": 28,
    "context_before": null,
