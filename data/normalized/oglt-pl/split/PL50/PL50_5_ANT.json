    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s3",
    "language": "lat",
    "text": "Sic dicit Dominus : Qui non dimiserit patrem, aut matrem, aut uxorem, aut filios, aut filias propter me, non est meus discipulus (Marc.",
    "chunk_index": 13,
    "context_before": null,
