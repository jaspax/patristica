    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s5",
    "language": "lat",
    "text": "lene eum fortiter, ne dimit- tas, ne resoexeris retro ad uxorem aut familiam. Sursum cor, perfectam inchoasti pugnam.",
