    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s7",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s7",
    "language": "lat",
    "text": "Ad animam pertinet vita; ad rationem periinet sapientia : et tamen nec anima est sine ratione, nec ratio sine anima; et cum unum sint, anima sola sus­ cepit vitam, ratio sola suscepit sapientiam.",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
      437,
      439
