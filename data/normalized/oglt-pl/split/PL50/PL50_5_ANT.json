  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s7",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s7",
    "language": "lat",
    "text": "Vide ne timeas, adjuvat te ut coronet te. Septem filios Machabæa mater pro Christo misit ad mortem.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
