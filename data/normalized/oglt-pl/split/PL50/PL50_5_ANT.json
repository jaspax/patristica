  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.2.s3",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.2.s3",
    "language": "lat",
    "text": "Rogo te, preme caput ejus; non surgat isto in agone martyrii, nemo te commoveat.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
