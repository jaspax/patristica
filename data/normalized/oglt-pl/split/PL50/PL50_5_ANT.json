    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.6.s4",
    "language": "lat",
    "text": "Carnem suscepit Christus, num- quid a Patre aut a Spiritu sancto recessit? Ergo vera est unitas.",
