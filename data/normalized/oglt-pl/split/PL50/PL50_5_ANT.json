    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s2",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s2",
    "language": "lat",
    "text": "Adam mulierem suam plus satis dilexit, et ideo tam lacrymabiliter cecidit.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
      437,
