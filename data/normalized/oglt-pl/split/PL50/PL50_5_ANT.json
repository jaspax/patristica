  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s9",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s9",
    "language": "lat",
    "text": "Ecce igi­ tur in sole calor et splendor in uno radio sunt, sed calor exsiccat, splendor illuminat:",
