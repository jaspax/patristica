    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s11",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s11",
    "language": "lat",
    "text": "Sic te vult suscipere pro fide morienlem, ut tibi plenam exhibeat majestatem. Respice mundum : periturus est.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
