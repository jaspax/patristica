  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.3.s13",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.3.s13",
    "language": "lat",
    "text": "Ecce dimissa sunt tibi peccata tua ; et omnes iniquitates tuas Deus pro hac pugna delebit, quascumque usque hodie com­ mittere potuisti.",
    "chunk_index": 23,
    "context_before": null,
