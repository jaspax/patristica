    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s11",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s11",
    "language": "lat",
    "text": "Suscepit ergo splendor illuminationem, nou fervorem; suscepit calor fervo­ rem, non illuminationem.",
