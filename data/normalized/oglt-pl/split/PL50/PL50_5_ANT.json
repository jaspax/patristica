    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s3",
    "language": "lat",
    "text": "Haec time : nam et, si viceris, pro multorum salute pu- gnasli, et coronam multiplicem accepisti.",
