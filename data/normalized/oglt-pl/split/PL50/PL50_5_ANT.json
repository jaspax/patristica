    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.4.s21",
    "language": "lat",
    "text": "Si firmum tc viderit, gaudet et adju­ vat ; si infirmum, succurrit et sublevat.",
