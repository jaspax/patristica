    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s6",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s6",
    "language": "lat",
    "text": "Nempe aliud est anima, aliud ratio : et tamen Hi anima est ratio. Et una est anima; sed aliud anima agit, aliud ratio : anima vivit, ratio sapit.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": 438,
    "date_range": [
