    "canonical_ref": "PL50.ANT.4.s4",
    "language": "lat",
    "text": "Qualis eris cum te cum sancto Stepbano videris? Qualis eris cum Petrum et Paulum, quos ro­ gare solebas ut patronos, habebis amicos?",
    "chunk_index": 27,
    "context_before": null,
