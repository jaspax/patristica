    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.6.s7",
    "language": "lat",
    "text": "Audi de Spiritu sancto, quia, quod cum eo erat, evangelista referat : Jesus plenus Spiritu sancto re­ gressus ad Jordanem (Luc.",
    "chunk_index": 62,
