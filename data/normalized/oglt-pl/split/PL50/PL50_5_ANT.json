    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant#PL50.ANT.5.s10",
    "work_id": "oglt-pl/honoratus-constantiensis/pl50_5_ant",
    "canonical_ref": "PL50.ANT.5.s10",
    "language": "lat",
    "text": "aliud suscipit ca­ lor, aliud suscipit splendor, licet ab invicem calor et splendor non possint separari.",
