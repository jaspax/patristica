    "canonical_ref": "PL50.SA.1.s7",
    "language": "lat",
    "text": "Divinum opus est unde gaudemus. Diu discas quod bene doceas. Utinam secundum meritum vestrum digne vobis praedicine os nostrum possit.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
