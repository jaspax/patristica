  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s5",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s5",
    "language": "lat",
    "text": "Humilia ergo temet- ipsum, et altiora te ne quæsieris (Eccl. III, 22).",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
