    "canonical_ref": "PL50.SA.2.s8",
    "language": "lat",
    "text": "adver­ sum ipsam superbiam sit superbus, et sub pedibus suis habeat potentiam, divitius, cupiditates, et cæ­ tera quæ mundo dominantur.",
    "chunk_index": 20,
    "context_before": null,
