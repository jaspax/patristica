    "canonical_ref": "PL50.SA.2.s11",
    "language": "lat",
    "text": "Hic tamen si tamen sancte superbus esse voluerit, contemptor quidem erit mundo, sed humilis erit Christo.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
