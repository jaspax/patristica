    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s4",
    "language": "lat",
    "text": "Superbia enim, quæ e<t humilitati contraria, quid aliud quam tumor est? Sed sicut corpus cum tumore, ita anima cum superbia sanitatem non habet.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
