  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s2",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s2",
    "language": "lat",
    "text": "Hæc est, quæ non ruinam, non præcipitium, non lapsum timet, quia humilitas unde cadat non habet. Vis ergo non cadere?",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s3",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s3",
    "language": "lat",
    "text": "non extollaris. Vis non inflare? non infleris. Nam vi ex hoc bene quidam ait: Quidquid tumet, sanum non est.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
