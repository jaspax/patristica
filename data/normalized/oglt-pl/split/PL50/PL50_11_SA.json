    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.1.s11",
    "language": "lat",
    "text": "Quisquis autem se huic lumini appropinquaverit, ille utique habebit oculus videndi, qui et habuit aures audieudi.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
    "date_confidence": "approximate",
