    "canonical_ref": "PL50.SA.3.s2",
    "language": "lat",
    "text": "I.. qua obedientia, dilectissimi, Itique compun­ ctio manifestatur. Compunctus enim cordA est, qui se minimum judicat.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
