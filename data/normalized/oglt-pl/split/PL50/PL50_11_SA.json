    "canonical_ref": "PL50.SA.1.s6",
    "language": "lat",
    "text": "LXXX, 11). Loquarergoapud vos, dilectissimi, non expavescens; ne sii unius ve­ recundia, ubi lætitia multorum est.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
