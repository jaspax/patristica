  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s12",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s12",
    "language": "lat",
    "text": "Erit quidem ibi el itus, sed hic subditus : propterea enim se in illis erigit, ut se facilius ad hæc deponat.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
