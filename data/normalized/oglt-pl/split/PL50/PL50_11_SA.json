    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.1.s10",
    "language": "lat",
    "text": "v, 14). Vos lucerna illa super candelabrum posita. Si quis ab hac lucerna remotus est, involva­ tur nece se est mundi tenebris.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
