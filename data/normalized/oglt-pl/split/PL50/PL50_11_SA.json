  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.1.s12",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.1.s12",
    "language": "lat",
    "text": "Hæc ergo lucerna ut clarissimum lumen habeat, implenda est semper oleo misericordiæ, pietatis, mansuetudi- nis, humilitatis, obedientiæ, charitatis.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s1",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s1",
    "language": "lat",
    "text": "Humilitas vero maxime excolenda est, quæ nos justis aequat, angeli jungit, Deo appropinquare fa- cit.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
