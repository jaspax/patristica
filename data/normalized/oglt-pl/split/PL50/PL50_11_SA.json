  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.3.s3",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.3.s3",
    "language": "lat",
    "text": "Quando audeat voluntates suas exsequi ? Quando audeat resistere auctori ejus qui præceperit ?",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
