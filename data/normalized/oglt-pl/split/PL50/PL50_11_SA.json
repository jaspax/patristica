    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.1.s8",
    "language": "lat",
    "text": "Quod recte alii prædi­ cant, vos impletis ; quod alii loquuntur, vos facitis: quia angelorum vitam homines adhuc in terra positi exhibetis.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
    "date_confidence": "approximate",
