    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s7",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s7",
    "language": "lat",
    "text": "Superbiat mundo, despi­ ciat conversationem saeculi, pro nihilo habeat eon­ cupiscentias ejus, adversum vitia insurgat,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
