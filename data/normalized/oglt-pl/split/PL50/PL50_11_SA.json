    "canonical_ref": "PL50.SA.3.s1",
    "language": "lat",
    "text": "Hanc ergo humilitatem si intente custodieri­ mus, etiam vera illa obedientia sine labore servabi. tur.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
