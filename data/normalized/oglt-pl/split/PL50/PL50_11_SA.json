  },
  {
    "chunk_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa#PL50.SA.2.s6",
    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.2.s6",
    "language": "lat",
    "text": "At. tam' n si quis vult superbus esse, habet in se ubi exerceat superbiam suam.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
    ],
    "date_confidence": "approximate",
