    "work_id": "oglt-pl/eucherius-lugdunensis/pl50_11_sa",
    "canonical_ref": "PL50.SA.1.s9",
    "language": "lat",
    "text": "Nam illam conversationem coelestem, quamvis pauci illic videbunt, vos facitis jam hic vi­ dere. Vos estis, sicut Salvator ait, lux hujus mundi (Math.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 434,
    "date_range": [
      420,
      449
