    "work_id": "oglt-pl/trifolius-presbyter/pl63_3_tri",
    "canonical_ref": "PL63.TRI.3.s2",
    "language": "lat",
    "text": "Ista do­ ctrina de fonte Arii prodivit, et est conveniens omni­ bus hæresibus.",
