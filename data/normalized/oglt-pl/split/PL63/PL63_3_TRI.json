    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/trifolius-presbyter/pl63_3_tri#PL63.TRI.3.s25",
    "work_id": "oglt-pl/trifolius-presbyter/pl63_3_tri",
    "canonical_ref": "PL63.TRI.3.s25",
    "language": "lat",
    "text": "Quomodo isti synodum Chalcedonensem se di­ cunt sequi, et praedicant quæ illi no i receperunt I Nam in quarto secretario synodi Chalcedonensis ad finem requisiti sunt a judicibus Carosus et.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 519,
    "date_range": [
      519,
      520
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/trifolius-presbyter/pl63_3_tri#PL63.TRI.3.s26",
    "work_id": "oglt-pl/trifolius-presbyter/pl63_3_tri",
    "canonical_ref": "PL63.TRI.3.s26",
    "language": "lat",
    "text": "Dorotheus archimandritæ taliter : Eutyches corpus Domini no­ stri Jesu Christi dixit non esse nostræ substantiæ, vos de hoc quomodo confitemini?",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 519,
