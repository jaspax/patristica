    "work_id": "oglt-pl/trifolius-presbyter/pl63_3_tri",
    "canonical_ref": "PL63.TRI.3.s4",
    "language": "lat",
    "text": "prsetorio exstant plures epistolae apud Cassiodorum, lib. VI Variarum.",
    "chunk_index": 9,
    "context_before": null,
