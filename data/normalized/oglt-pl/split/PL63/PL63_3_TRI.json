    "work_id": "oglt-pl/trifolius-presbyter/pl63_3_tri",
    "canonical_ref": "PL63.TRI.3.s1",
    "language": "lat",
    "text": "Mandare mihi dignatus es monachos Scythas a Constantinopoli advenisse, qui unum de Trinitate prædicant crucifixum, sperans a parvitate mea, si tale aliquid in doctrina Patrum repererim.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 519,
    "date_range": [
      519,
      520
    ],
    "date_confidence": "approximate",
