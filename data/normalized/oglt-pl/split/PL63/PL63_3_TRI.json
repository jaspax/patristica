    "work_id": "oglt-pl/trifolius-presbyter/pl63_3_tri",
    "canonical_ref": "PL63.TRI.3.s3",
    "language": "lat",
    "text": "Vita quidquid quatuor synodi in de­ finitione tidei non posuerunt, id est Nicæna, Con­ * Is videtur Faustus ad quem praef.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 519,
    "date_range": [
      519,
      520
    ],
    "date_confidence": "approximate",
