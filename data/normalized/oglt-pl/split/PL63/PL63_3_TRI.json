    "canonical_ref": "PL63.TRI.2.s4",
    "language": "lat",
    "text": "quam inter schedas Sirmondi nostri delitescentem reperi, tibique nunc, lector, repraesento, ut de tota hac controversia certius judicium feras.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 519,
    "date_range": [
