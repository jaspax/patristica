    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.1.s3",
    "language": "lat",
    "text": "Quia quotiens crebra recordatione dul- cia affectionis vestrae vota commemoro, desideria pectoris publicare suspiriis non desisto.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/dynamius-patricius/pl80_8_dyn#PL80.DYN.1.s4",
    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.1.s4",
    "language": "lat",
    "text": "Pro eo quod ille corporali fraudatur intuitu, qui de cordis non absentatur arcano. Idcirco officium sospitatis plenissimo charitatis jure persolvens,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/dynamius-patricius/pl80_8_dyn#PL80.DYN.1.s5",
    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.1.s5",
    "language": "lat",
    "text": "spero ut quo- ties aditum temporum difficultas diversa praestiterit, semper exiguitatem meam vestrorum apicum elocu- tio desiderata confortet,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
