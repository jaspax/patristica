    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.1.s2",
    "language": "lat",
    "text": "ita mihi vestrarum epistolarum elocutio cum inco- lumitatis vestrae indicia retulit, gaudiorum incremen- ta nutrivit.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
