    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s8",
    "language": "lat",
    "text": "Pro qua re universitas se certatim vestro conciliari affectu de- siderat, dum omnes conscius amor invitat.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/dynamius-patricius/pl80_8_dyn#PL80.DYN.2.s9",
    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s9",
    "language": "lat",
    "text": "Quam magis ego invicem mei famulatus verborum gaudeo jura praemittere, donec et recuperatis viribus rebus merear respondere.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/dynamius-patricius/pl80_8_dyn#PL80.DYN.2.s10",
    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s10",
    "language": "lat",
    "text": "Idcirco foenus humillime sospi- tatis impendens, deprecor ut jugiter me in divinis oraculis quem receptum dignatio retinet, intercessio vestra commendet, et omnibus quibus necessarium inspicitis,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/dynamius-patricius/pl80_8_dyn#PL80.DYN.2.s11",
    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s11",
    "language": "lat",
    "text": "per quos etiam regis auribus deferatur, meam necessitatem asserite, vel celerem reditum obtinete ut indulto suffragetis patrocinio, quem impenso fovetis affectu.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
