    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s15",
    "language": "lat",
    "text": "Sicut me, quem huma- nitas vestra optata infestatione persequitur; quam, dum non valui coactus effugere, devotus videor excepisse.",
    "chunk_index": 21,
    "context_before": null,
