    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s12",
    "language": "lat",
    "text": "De transmissis vestris xe- niis ancipiti meditatione suspendor, utrum me re- ferre grates oporteat, an silere :",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
