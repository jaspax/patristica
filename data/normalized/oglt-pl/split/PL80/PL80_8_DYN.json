    "canonical_ref": "PL80.DYN.1.s1",
    "language": "lat",
    "text": "AD AMICUM. Quantum aestifero solis ardore defesso, vel longin- qui itineris vastitate quassato, gelida nympha, dum ariditatem temperat, restinguit desideria sitientis :",
    "chunk_index": 1,
    "context_before": null,
