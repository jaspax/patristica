    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s13",
    "language": "lat",
    "text": "quoniam qui non valet implere praeconium, digne vitat affectum· Non tamen credit coronae [Id est, sacerdotii, episcopatus] vestrae magnitudo sufficere,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
