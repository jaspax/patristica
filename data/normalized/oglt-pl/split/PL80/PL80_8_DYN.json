    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.2.s14",
    "language": "lat",
    "text": "quod in urbe cui prae- estis non desinit universis immensa largitas mini- strare, nisi ut illos stipendiis donetis propriis, qui moenibus inhabitant alienis.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
