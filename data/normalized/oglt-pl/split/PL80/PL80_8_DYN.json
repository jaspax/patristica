    "work_id": "oglt-pl/dynamius-patricius/pl80_8_dyn",
    "canonical_ref": "PL80.DYN.1.s6",
    "language": "lat",
    "text": "quousque cum divino auxi- lio, animorum devotione suppleta, mutuis inter nos laetemur aspectibus qui nunquam indivisis affectioni- bus sequestramur·",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 588,
    "date_range": [
      575,
      601
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
