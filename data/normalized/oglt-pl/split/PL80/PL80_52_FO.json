    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.3.s1",
    "language": "lat",
    "text": "Curriculi gemis est, memorat quod Gallia rhedam, Molliter incedens orbita sulcat humum.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
