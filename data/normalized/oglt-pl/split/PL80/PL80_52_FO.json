    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s1",
    "language": "lat",
    "text": "Ardua suscepi missis epigrammata chartis, Atque cothurnato verba rotata Sapho.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s2",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s2",
    "language": "lat",
    "text": "Percurrens tumido spumantia carmina versu, Credidi in undoso me dare vela freto.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s3",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s3",
    "language": "lat",
    "text": "Plana procellosos ructavit pagina fluctus, Et velut Oceanus (Oceanas) fonte refudit aquas.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s4",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s4",
    "language": "lat",
    "text": "Vix modo tam nitido pomposa poemata cultu, Audit Trajano Roma verenda foro. Quid si tale decus recitasset in aure senatus?",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s5",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s5",
    "language": "lat",
    "text": "Stravissent blandis aurea fila tuis. Per loca, per populos, per compita cuncta videres Currere versiculos, plebe favente, tuos.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s6",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s6",
    "language": "lat",
    "text": "Sed tamen in vestro quaedam sermone notavi, Carmine de veteri furta novella loqui.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s7",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s7",
    "language": "lat",
    "text": "Ex quibus in paucis superaddita syllaba fregit, Et pede laesa suo musica clauda jacet. Nunc, venerande Pater, prece, volo, voce saluto.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.7.s8",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.7.s8",
    "language": "lat",
    "text": "Commendans animum supplice corde meum. Sit tua vita diu, cujus modulante camaena, Cogimur optatis reddere verba jocis.",
