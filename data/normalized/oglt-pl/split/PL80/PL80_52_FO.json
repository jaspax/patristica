    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.3.s2",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.3.s2",
    "language": "lat",
    "text": "Exsiliens duplici bijugo volat axe citato, Atque movet rapidas juncta quadriga rotas.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.3.s3",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.3.s3",
    "language": "lat",
    "text": "Huc ego dum famulans comitatu jungor eodem, Et mea membra cito dum veherentur equo, Pontificisque sacri Bertichramni actus honore, Comprehendente manu raptus in axe levor.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.3.s4",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.3.s4",
    "language": "lat",
    "text": "Qualiter implumes fetus pia mater hirundo Confovet, et placide pennula tensa regit; Sic bonitate poteus, affectu dives opimo, In proprium pastor molle sedile locat.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/venantius-fortunatus/pl80_52_fo#PL80.FO.1.4",
    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.4",
    "language": "lat",
    "text": "Nec solum amplectens pia mens, sed diligit omnes, Unde magis populis unicus exstet amor.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
