    "work_id": "oglt-pl/venantius-fortunatus/pl80_52_fo",
    "canonical_ref": "PL80.FO.1.6",
    "language": "lat",
    "text": "Ad eumdem de opusculis suis (ejus).",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 582,
    "date_range": [
      565,
