    "canonical_ref": "PL80.FU.1.s26",
    "language": "lat",
    "text": "et monachos inibi perpetuis temporibus deservituros in eadem ecclesia instituens donis variis et possessionibus dotavit eamdem, et in eadem eccle- sia praefatus rex sibi et successoribus Cantuariorum regibus sepulturam elegit.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
