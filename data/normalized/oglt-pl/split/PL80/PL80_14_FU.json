    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s21",
    "language": "lat",
    "text": "quod fanum, statim ut ab Etherio Arelatensi Augustinus episcopus ordinatus, ut subscribitur, Angliam est regressus, ab inquinamentis et sordibus gentilium purgavit,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
