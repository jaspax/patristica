    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s22",
    "language": "lat",
    "text": "et si- mulacro quod in ea erat confraeto, synagogam mu- tavit in ecclesiam, et eam in nomine sancti Pancratii martyris dedicavit; et haec est prima ecclesia ab Au- gustino dedicata.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
