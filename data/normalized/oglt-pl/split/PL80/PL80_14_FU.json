    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s23",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s23",
    "language": "lat",
    "text": "Exstat adhuc altare in porticu ejus- dem ecclesiae australi in quo idem Augustinus sole- lebat celebrare, ubi prius steterat simulacrum regis.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s24",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s24",
    "language": "lat",
    "text": "His itaque gestis, Augustinus praedictam sancti Pan- cratii ecclesiam, una cum terra adjacente, a rege obtinuit;",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s25",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s25",
    "language": "lat",
    "text": "in cujus fundo praedictus Athelbertus, hor- tatu beati Patris Augustini, ecclesiam in honore sanctorum apostolorum Petri et Pauli a fundamentis construxit,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
