    "canonical_ref": "PL80.FU.1.s3",
    "language": "lat",
    "text": "Gregorius namque in sum- mum pontificem ordinatus, quarto Nonas Septembris sub anno Domini 592 verbum Dei quod ipse et in persona propria genti Anglorum praedicare disposue- rat,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
