    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s20",
    "language": "lat",
    "text": "in quo idem rex Athelbertus secundum ri- tum gentis suae solebat orare, et una cum plebe sua, daemoniis magis quam Deo immolare :",
    "chunk_index": 20,
    "context_before": null,
