    "canonical_ref": "PL80.FU.1.s2",
    "language": "lat",
    "text": "specialius cum gentem visitavit Anglicam; cum eam de tenebris et umbra mortis dignatus est evocare ad lucis suae fidei notitiam.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
