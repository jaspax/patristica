  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s14",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s14",
    "language": "lat",
    "text": "et se ipsi genti Anglorum episcopum fore ordinatum, simul et de iis quae necessaria videbantur quaestionibus ejus consulta efflagitans.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s15",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s15",
    "language": "lat",
    "text": "Quae si quis plenius scire desi- derat, Bedam de gestis Anglorum legat, et ibi deside- rata reperiet.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s16",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s16",
    "language": "lat",
    "text": "Interea Augustino sedem episcopalem, ut supra diximus, in civitate Cantuariae adepto, re- cuperavit in ea ecclesiam, regio fultus auxilio,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s17",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s17",
    "language": "lat",
    "text": "quam ibidem antiquo fidelium Romanorum opere factam esse didicerat, et eam in nomine sancti Salvatoris Dei et Domini nostri Jesu Christi consecravit;",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s18",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s18",
    "language": "lat",
    "text": "atque ibidem habitationem sibi statuit, et cunctis succes- soribus suis, quae usque in hodiernum diem vocatur Ecclesia Christi Cantuariensis totius Angliae nutrix et metropolis.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu#PL80.FU.1.s19",
    "work_id": "oglt-pl/augustinus-cantuariensis/pl80_14_fu",
    "canonical_ref": "PL80.FU.1.s19",
    "language": "lat",
    "text": "Erat autem non longe ab ipsa civitate, ad orientalem, quasi medio itinere ad ecclesiam sancti Martini et muros civitatis situm, fanum, sive Idolum,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      597,
      604
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
