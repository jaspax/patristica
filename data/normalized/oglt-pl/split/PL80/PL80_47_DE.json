    "work_id": "oglt-pl/adeodatus-i/pl80_47_de",
    "canonical_ref": "PL80.DE.3.s6",
    "language": "lat",
    "text": "Episcopis etiam earum ci- vitatum ab hac apostolica sede volentibus scire utrum viri et mulieres redirent ad proprium torum, beatae memoriae sanctissimi Patres,",
    "chunk_index": 8,
