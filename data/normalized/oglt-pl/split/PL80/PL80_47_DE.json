  },
  {
    "chunk_id": "oglt-pl/adeodatus-i/pl80_47_de#PL80.DE.3.s8",
    "work_id": "oglt-pl/adeodatus-i/pl80_47_de",
    "canonical_ref": "PL80.DE.3.s8",
    "language": "lat",
    "text": "Codicibus nactus sum; sed ex iisdem mss. Codicibus animadversione di- gnum censeo inscriptionem aliquando diversam re- ferre :",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
