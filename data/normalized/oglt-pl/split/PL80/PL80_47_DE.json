    "work_id": "oglt-pl/adeodatus-i/pl80_47_de",
    "canonical_ref": "PL80.DE.3.s4",
    "language": "lat",
    "text": "Nos vero moesti hac in re inquisivimus b priorum patrum nostrorum dicta.",
    "chunk_index": 6,
    "context_before": null,
