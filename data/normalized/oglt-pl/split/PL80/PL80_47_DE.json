    "work_id": "oglt-pl/adeodatus-i/pl80_47_de",
    "canonical_ref": "PL80.DE.3.s1",
    "language": "lat",
    "text": "Pervenit ad nos diaconus vester, vestrae sanctitatis epistolam ferens, quod quidam viri etiam et mulieres,",
    "chunk_index": 3,
    "context_before": null,
