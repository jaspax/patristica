  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_16_bo#PL80.BO.5.s28",
    "work_id": "oglt-pl/bonifatius-iv/pl80_16_bo",
    "canonical_ref": "PL80.BO.5.s28",
    "language": "lat",
