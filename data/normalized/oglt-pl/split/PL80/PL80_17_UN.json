    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s1",
    "language": "lat",
    "text": "Sunt nonnulli fulti nullo dogmate, audacissime quidem, zelo magis amaritudinis quam dilectione inflammati,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
