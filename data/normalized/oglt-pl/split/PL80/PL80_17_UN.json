    "canonical_ref": "PL80.UN.1",
    "language": "lat",
    "text": "Quomodo liceat monachis cum sacerdotali officio ubiubi ministrare.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
