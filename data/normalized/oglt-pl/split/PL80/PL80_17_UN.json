    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s3",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s3",
    "language": "lat",
    "text": "neque Christianitatem largiri, neque absolvere posse per sacerdotali officio divinitus injunctam potestatem : sed omnino labun- tur.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s4",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s4",
    "language": "lat",
    "text": "Nam si ex hac causa veteres aemuli vera praedi- carent, apostolicae compar sedis beatissimus Gregorius monachico cultu pollens ad summam nullatenus api- cem conscenderet.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s5",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s5",
    "language": "lat",
    "text": "Quoniam quidem haec ostiatim fungendi, ligandi, solvendique potestas a Deo summa conceditur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s6",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s6",
    "language": "lat",
    "text": "Augustinus quoque ejusdem sanctissimi Gregorii discipulus, Anglorum praedicator egregius, ac Pannoniensis Martinus beatissimus, cujus san- ctitatis fama longe lateque diffusa totus personat mundus;",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s7",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s7",
    "language": "lat",
    "text": "alii quoque jam plurimi sanctissimi pre- tiosissimo monachorum habitu fulgentes nequaquam annulo pontificali subartarentur, si quia monachi fuerunt praedictis uti prohiberentur.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s8",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s8",
    "language": "lat",
    "text": "Neque enim Benedictus monachorum praeceptor almificus hujus- cemodi rei aliquo modo fuit interdictor; sed eos saecularium negotiorum edixit expertes fore solum- modo.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s9",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s9",
    "language": "lat",
    "text": "Quod quidem apostolicis documentis, et om- nium sanctorum Patrum institutis, non solum mona- chis, verum etiam canonicis maximopere imperatur.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s10",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s10",
    "language": "lat",
    "text": "Nemo enim militans Deo implicat se negotiis saecula- ribus.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s11",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s11",
    "language": "lat",
    "text": "Utrisque etiam praefatorum Patrum exemplis perspicacibus circumquaque ut mundo mortui sint evidentissima ratione praecipitur.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s12",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s12",
    "language": "lat",
    "text": "Tantorum igitur Patrum instituti exemptis, quibus periculosissimum est refragari,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s13",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s13",
    "language": "lat",
    "text": "credimus a sacerdotibus monachis li- gandi solvendique officium Deo imperante haud in- digne administrari, si eos digne contigerit ad hoc ministerium sublimari.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s14",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s14",
    "language": "lat",
    "text": "Quod incunctanter affirmat quisquis statum monachorum et habitum potentatum- que evidenter considerat. Verbi gratia : angelus Graece, Latine nuntius dicitur.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s15",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s15",
    "language": "lat",
    "text": "Sacerdotes igitur mo- nachi atque canonici, qui quotidie sancta Dei prae- cepta annuntiant, angeli vocantur, ratione non incon- grua.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s16",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s16",
    "language": "lat",
    "text": "Sed unusquisque angelicus ordo quanto clarita- tem Dei vicinius contemplatur, tanto dignitate subli- mior affirmatur.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s17",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s17",
    "language": "lat",
    "text": "Nam uti cherubim, monachi sex alis velantur. Duae quidem in capitio quo caput tegi- tur verisimilibus demonstratur assertionibus.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s18",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s18",
    "language": "lat",
    "text": "Illud vero tunicae quod brachiis extenditur, alas duas esse dicimus : et illud tandem quo conditur corpus, sex alarum numerum certissime implere asseritur.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
      615
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s19",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s19",
    "language": "lat",
    "text": "De- certantes igitur monachicae professionis presbyteros sacerdotalis potentiae arcere officio, omnimodo prae- cipimus,",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
