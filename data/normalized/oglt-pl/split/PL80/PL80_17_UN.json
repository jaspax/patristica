  },
  {
    "chunk_id": "oglt-pl/bonifatius-iv/pl80_17_un#PL80.UN.2.s2",
    "work_id": "oglt-pl/bonifatius-iv/pl80_17_un",
    "canonical_ref": "PL80.UN.2.s2",
    "language": "lat",
    "text": "asserentes monachos, quia mundo mor- tui sunt, et Deo vivunt, sacerdotalis officii potentia indignos, neque poenitentiam,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 611,
    "date_range": [
      608,
