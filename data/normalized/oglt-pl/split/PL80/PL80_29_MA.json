[
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA",
    "language": "lat",
    "text": "(Ex Mabill. Act. SS. BB. t. I.)",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.1.s1",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.1.s1",
    "language": "lat",
    "text": "Caeca profanatas coleret dum turba figuras, Et manibus factos crederet esse deos, Templa ruinosis haec olim struxerat aris, Queis dabat obsceno sacra cruenta Jovi.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.1.s2",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.1.s2",
    "language": "lat",
    "text": "Sed jussus veniens, eremoque vocatus ab alta. Purgavit sanctus hanc Benedictus humum.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.1.s3",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.1.s3",
    "language": "lat",
    "text": "Sculptaque confractis dejecit marmora signis, Et templum vivo praebuit esse Deo.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.1.s4",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.1.s4",
    "language": "lat",
    "text": "Huc properet, coelos optat qui cernere apertos Nec removet votum semita dura pium.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.1.s5",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.1.s5",
    "language": "lat",
    "text": "Semper difficili quaeruntur magna labore, Arctam semper habet vita beata viam.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.1.s6",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.1.s6",
    "language": "lat",
    "text": "Huc ergo cum scelerum depressus fasce subissem, Depositum sensi pondus abesse mihi. Credo quod et felix vita fruar insuper illa",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s1",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s1",
    "language": "lat",
    "text": "Oras pro Marco si, Benedicte, tuo. Hunc plebs stulta locum quondam vocitaverat arcem, Marmoreisque sacrum fecerat esse deis.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s2",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s2",
    "language": "lat",
    "text": "Quod tunc si vero signasset nomine quisquam, Tartareum potuit jure vocare Chaos. Ad quem caecatis errantes mentibus ibant Improba mortifero reddere vota Jovi.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s3",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s3",
    "language": "lat",
    "text": "Sed puto praevisae culmen signaverat aulae, Nomine tunc arcis templa moderna vocans.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s4",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s4",
    "language": "lat",
    "text": "In quibus aeternae damnatur porta gehennae, Arxque modo vitae est, quae fuit ante necis.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s5",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s5",
    "language": "lat",
    "text": "De qua stelligeri pulsatur janua coeli, Dum canit angelicis turba beata modis.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s6",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s6",
    "language": "lat",
    "text": "De qua colloqueris vero, Benedicte, Tonanti, Monticula et sacri dux eremita chori.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s7",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s7",
    "language": "lat",
    "text": "Ad quam tu ex alio monitus cum monte venires, Per deserta tibi, dux, via, Christus erat.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s8",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s8",
    "language": "lat",
    "text": "Namque duos juvenes bivium perduxit ad omne, Qui te firmarent quod sequereris iter. Hic quoque viventi justo praedixerat uni, His tu parce locis, alter amicus adest.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s9",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s9",
    "language": "lat",
    "text": "Te sibi sublato tenebris mons coelitus horret, Et pallet nebulis concolor ipse suis.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s10",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s10",
    "language": "lat",
    "text": "Moerent, et largis distillant fletibus antra, Cumque suis plangunt tabida lustra focis.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.2.s11",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.2.s11",
    "language": "lat",
    "text": "Teque lacus liquidi vero flevere dolore, Et sparsit laceras silva soluta comas,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.3.s1",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.3.s1",
    "language": "lat",
    "text": "Credar ficta loqui, nisi te, ne solus abires, Tres subito corvi promeruere sequi.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.3.s2",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.3.s2",
    "language": "lat",
    "text": "Hic quoque te clausum populi te teste requirunt. Exspectas noctis cum pia festa sacrae.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.3.s3",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.3.s3",
    "language": "lat",
    "text": "Qui velut orbati raucis tibi flere querelis Instant, convictu quod caruere tuo Ast huc perducto scopuli cessere, rubique Siccaque mirandas terra retexit aquas.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.3.s4",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.3.s4",
    "language": "lat",
    "text": "Certum est mons Christi quod montibus imperet ipsis, Subjecit pedibus mons caput ipse tuis.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.3.s5",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.3.s5",
    "language": "lat",
    "text": "Utque suum tu sancte supervegetere cacumen, Submisso tumidam vertice planat humum.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.4.s1",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.4.s1",
    "language": "lat",
    "text": "Neve fatigentur qui te, Benedicte, requirunt, Molliter obliquum flectit ubique latus.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.4.s2",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.4.s2",
    "language": "lat",
    "text": "Hunc mons ipse tamen juste tibi reddit honorem Qui meruit tantum te decorante bonum.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.4.s3",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.4.s3",
    "language": "lat",
    "text": "Arida tu cujus hortis componis amoenis, Nudaque fecundo palmite saxa tegis.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.4.s4",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.4.s4",
    "language": "lat",
    "text": "Mirantur scopuli fruges, et non sua poma, Pomiferisque viret silva dumata comis.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.4.s5",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.4.s5",
    "language": "lat",
    "text": "Sic hominum steriles in fructum dirigis actus, Sicca salutari flumine corda rigans.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/marcus-cassinensis/pl80_29_ma#PL80.MA.4.s6",
    "work_id": "oglt-pl/marcus-cassinensis/pl80_29_ma",
    "canonical_ref": "PL80.MA.4.s6",
    "language": "lat",
    "text": "Sic, rogo, nunc spinas in frugem verte malignas, Quae lacerant Marci pectora bruta tui.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 585,
    "date_range": [
      550,
      620
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  }
]