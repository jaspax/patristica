[
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN",
    "language": "lat",
    "text": "EPISTOLA AUSPICII EPISCOPI ECCLESIÆ TULLENSIS AD ARDOGASTFII COMITEM TREVIRORUM.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s1",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s1",
    "language": "lat",
    "text": "Præcelso exspectabili his Arbogasto comiti, Auspicius qui diligo, salutem plurimam.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s2",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s2",
    "language": "lat",
    "text": "Magnas coelesti Domino rependo corde gratias, Quod te Tullensi proxime magnum in urbe vidimus.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s3",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s3",
    "language": "lat",
    "text": "Multis me luis aclibus lætificabas antea, Sed nunc fecisti maximo me exsultare gaudio.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s4",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s4",
    "language": "lat",
    "text": "Major etenim solus apparuisli omnibus, Ut potestatis ordinem illustri mente vinceres, Cui honor debitus majorc nobis gaudio Nondum delatus nomine, jam est collatus meritis.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s5",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s5",
    "language": "lat",
    "text": "Plus est enim laudabilem virum fulgere actibus, Quam prætentare lampada sine scintillæ lumine.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s6",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s6",
    "language": "lat",
    "text": "Sed tu qui totis gradibus plus es quam esse diceris, Erit credo velocius ut reddant merita.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s7",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s7",
    "language": "lat",
    "text": "Clarus etenim genere, clarus et vitae moribus, Justus, pudicus, sobrius, totus illustris redderis.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s8",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s8",
    "language": "lat",
    "text": "Pater in cunctis nobilis fuit tibi Arigius : Cujus tu famam nobilem aut renovas, aut superas.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s9",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s9",
    "language": "lat",
    "text": "Sed tuus honor ejus est, ejusque tibi permanet, Et geminato lumine sic tu praecluis a omnibus.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s10",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s10",
    "language": "lat",
    "text": "Cujusque nemo dubitet felicitati prastitum, Ut superesset genitrix tibi, laudanda omnibus, Quae te sic cunctis copiis replet et ornat pariter, Ut sis abundans usibus, et sis decorus actibus.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s11",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s11",
    "language": "lat",
    "text": "Congratulandum tibi est, o Trevirorum civitas, Quæ tali viro regeris, antiquis comparabili.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s12",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s12",
    "language": "lat",
    "text": "De magno origo semine descendit tui nominis : Certe virtutis ejus est, ut Arbogastis legitur.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s13",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s13",
    "language": "lat",
    "text": "Scribantur in annalibus hujus triumphi pariter, Sicut et ejus scripti sunt, quem supra memoravimus.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s14",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s14",
    "language": "lat",
    "text": "Sed hoc addamus meritum huic, qui vere major est, Quod Christi nomen invocat religioni deditus.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s15",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s15",
    "language": "lat",
    "text": "Fuit in armis alacer ille antiquus, verum est: Sed infidelis moritur, et morte cuncta perdidit.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s16",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s16",
    "language": "lat",
    "text": "Hic autem noster strenuus, belligerosus, inclytus, Et quod his cunctis majus est, cultor divini nominis.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s17",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s17",
    "language": "lat",
    "text": "Nunc autem, fili sapiens, quæso, dignanter accipe Tui cultoris paginam quam ex amore porrigo.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s18",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s18",
    "language": "lat",
    "text": "Primum deposco, cupias collatas tantas gratias In te conserves integras, et bonis multis afflues.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s19",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s19",
    "language": "lat",
    "text": "Unum repelle vitium, ne corda pura inquinet, Quod esse sacris scribitur radix malorum omnium : Cupiditatem scilicet, quae in alumnos desaevit,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s20",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s20",
    "language": "lat",
    "text": "Nec sæva parcit rabiem quorum amore pascitur, Hoc (inquam) semper devorat famem edendam b per- [ferens, Et velut ignis addito succensa crescit pabulo.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s21",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s21",
    "language": "lat",
    "text": "Sed hæc non ita dixerim, quod te hoc damnem cri- [mine. L Tamen deposco diligens, ut nec scintilla vulneret.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s22",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s22",
    "language": "lat",
    "text": "Quam si forte improvidus quandoque inescaveris, Cito Oagrabit nimium augendum incendium.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s23",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s23",
    "language": "lat",
    "text": "Tende per mundum oculos, cerne primates saeculi, Aut interire cupidos, aut in periclis vivere.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s24",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s24",
    "language": "lat",
    "text": "Corradunt, quaerunt, inhiant, velut canes avidi: Et haec nec ipsi possident, sed nec relinquunt po- [ steris.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s25",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s25",
    "language": "lat",
    "text": "Tamen non generaliter ista de cunctis dixerim : Sed ut paucorum dedecus sit multis emanatio e. Tu autem, vir eximie, judex multorum providus, Tui repente pectoris secreta judex perspice.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s26",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s26",
    "language": "lat",
    "text": "Hujus si ullam senseris parvam veneni guttulam, Dulci perfunde oleo, ne serpat in visceribus.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s27",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s27",
    "language": "lat",
    "text": "Nec hoc ignoras oleum, pro tua sapientia, Quod est cunctorum pauperum mercatum eleemosy­ [nis.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s28",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s28",
    "language": "lat",
    "text": "His te exerce studiis, haec cuncta bona perage, Ut mea tibi maneant, et perseverent gaudia :",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s29",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s29",
    "language": "lat",
    "text": "Nam parum esse noveris, si quisquam nulla rapiat, Et obdurato pectore sua præcludat miseris.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s30",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s30",
    "language": "lat",
    "text": "Non multum sibi consulit, qui sic evitat rabiem Cupiditatis, ut simul incurrat avaritiae.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s31",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s31",
    "language": "lat",
    "text": "Nam ista duo crimina, velut cognata genere, Et geminata specie, nimis conjuncta permanent;",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/auspicius-tullensis/pl61_3_ann#PL61.ANN.1.s32",
    "work_id": "oglt-pl/auspicius-tullensis/pl61_3_ann",
    "canonical_ref": "PL61.ANN.1.s32",
    "language": "lat",
    "text": "Hæc qui sectantur miseri, hoc unum distat vitium, Quod unus horum malus est, et ille alter pessimus, Unde, mi cara dignitas,",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 472,
    "date_range": [
      470,
      475
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
