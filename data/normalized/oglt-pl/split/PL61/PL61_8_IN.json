  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.1",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.1",
    "language": "lat",
    "text": "Bilinguis ore calli do, Crimen fovebat invidum, Ferens acerbum nuntium, Hunc jam sepulcro conditum.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.2.s1",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.2.s1",
    "language": "lat",
    "text": "Celare se non pertulit, Qui triste funus edidit, Et si nocere desiit, Insana vita prodiit.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.2.s2",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.2.s2",
    "language": "lat",
    "text": "Deceptus arte noxia Cassata deflet crimina, Dum quæ putabat tristia, Conversa sunt in gaudia.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.3",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.3",
    "language": "lat",
    "text": "Exempla sæva protulit, Calcanda cuncto tempore, Ut jam sibi conscriberet Decreta vivo antistitc.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.4.s1",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.4.s1",
    "language": "lat",
    "text": "Fucata res hæc contigit Vitanda casto pectore, Superstite ut præsumeret, Post fata quod vix defuit.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.4.s2",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.4.s2",
    "language": "lat",
    "text": "Gravat sacerdos ordinem Qui episcopatum sic petit, Praecepta qui complectitur Fugit honoris ambitum.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.5.s1",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.5.s1",
    "language": "lat",
    "text": "lloc si cui sit debitum Coactus ascendat gradum, Non se petente callide, Sed dante Christi muncre.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.5.s2",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.5.s2",
    "language": "lat",
    "text": "Ineptus est quis ipse se Præferre vult Ecclesiæ : Nam rem sacratam sumere Electio divina sit.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.6",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.6",
    "language": "lat",
    "text": "Carus sacerdos ordinem Hilarius non ambiit, Martinus illud effugit, Gregorius vix sustulit.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.7",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.7",
    "language": "lat",
    "text": "Leges refutant ambitum, Invasor omnis pellitur, Quod respuunt pratoria, Vitet nefas Ecclesia.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.8.s1",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.8.s1",
    "language": "lat",
    "text": "Maligna erant certamina, De sede non tamen sua, Quae nec pati desiderat, Non inferat mens improba.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.8.s2",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.8.s2",
    "language": "lat",
    "text": "Nec longiore tempore Versatur in hoc murmure, Dum cogitant succedere, Redit sacerdos qui fuit.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.9",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.9",
    "language": "lat",
    "text": "Orante plebe protinus, Dum nemo credit, redditur, Quae confluunt post tristia Majora sunt haec gaudia.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.10",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.10",
    "language": "lat",
    "text": "Plausu favebat civitas, Cui reddita est felicitas Orbata quem defleverat, Partem recepit anxia.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
