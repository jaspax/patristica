    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.15",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.15",
    "language": "lat",
    "text": "Venite, cives, plaudite, Et vota votis addite ; Quo facta sunt miracula, Servent eum coelestia.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
