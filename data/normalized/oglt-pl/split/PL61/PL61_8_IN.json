[
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN",
    "language": "lat",
    "text": "Agnoscat omne sæculum Antislitem Leontium, Burdegalense praemium, Dono superno redditum.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
