    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.12",
    "language": "lat",
    "text": "Recolligit rector gregem, Errore captum semitae, Pastoris arce cognita Gavisa sunt ovilia.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.13",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.13",
    "language": "lat",
    "text": "Sumpsit gradum quo tempore Regressus est : eo die, Quis non superno munere Hoc contigisse prædicet ?",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
      420
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.14",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.14",
    "language": "lat",
    "text": "Tantum nec ante pracmium Plebi fuit, cum factus est, Lætata quantum tunc fuit Quando recepit præsulem.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      380,
