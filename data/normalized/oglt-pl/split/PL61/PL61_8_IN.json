    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.17",
    "language": "lat",
    "text": "Imum canendo concrepet, Quisquis Deo non invidct; Laus ejus est, qui præulem De mortis ore retrahit.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
