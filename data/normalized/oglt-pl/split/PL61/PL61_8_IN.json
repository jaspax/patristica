    "chunk_id": "oglt-pl/amoenus/pl61_8_in#PL61.IN.16",
    "work_id": "oglt-pl/amoenus/pl61_8_in",
    "canonical_ref": "PL61.IN.16",
    "language": "lat",
    "text": "Christus sereno lumine Circumvolet, quem reddidit, Ut trina crescat gralia, Mercede, vita, gloria.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
