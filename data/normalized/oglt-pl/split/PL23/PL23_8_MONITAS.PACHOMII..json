    "canonical_ref": "PL23.MONITAS.s5",
    "language": "lat",
    "text": "Omnium enim malo- rum pejus est legi Dei resistere, et acquiescere propriae voluntati.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 395,
