    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s6",
    "language": "lat",
    "text": "Unde merito in figura quatuor animalium, aquilae volanti compara­ tur : quae volat altius cæteris avibus, et solis radios irreverberatis aspicit luminibus.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
