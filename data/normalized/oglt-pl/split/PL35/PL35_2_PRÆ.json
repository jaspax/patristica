    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s16",
    "language": "lat",
    "text": "verba vero Domini quæ Trinitatis unitatem, et vitæ aeternae feli­ citatem insinuant, diligentius conscribit ;",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
