    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s14",
    "language": "lat",
    "text": "Tres siquidem alii evangelistae dicta et facta Domini temporalia, quae ad informandos mores vitæ præsentis maxime valent, copiosius prosecuti, circa activam vitam suut versati :",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
