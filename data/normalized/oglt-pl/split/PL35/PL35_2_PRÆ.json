    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s12",
    "language": "lat",
    "text": "in quibus deesse vidit aliqua gestarum rerum historiæ, et ea maxime quae Dominus gessit primo prædicationis suae tempore, scilicetantequam Joannes Baptista clau­ deretur In carcere.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
