    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s10",
    "language": "lat",
    "text": "Qui enim supra pectus Do­ mini in cœna recubuit, coelestis haustum sapientiæ ceteris excellentius de ipso Dominici pectoris fonte potavit.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
