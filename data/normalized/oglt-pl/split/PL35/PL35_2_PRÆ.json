    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s7",
    "language": "lat",
    "text": "Cæteri quippe evan­ gelistx, qui temporalem Christi nauvitatem, et tem­ poralia ejus facta quæ gessit in homine,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
