    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s17",
    "language": "lat",
    "text": "et sic in con­ templativa virtute commendanda, intentionem suam et praedicationem tenuit: in qua contemplativa vaca­ tur ut Deus videatur.",
    "chunk_index": 16,
