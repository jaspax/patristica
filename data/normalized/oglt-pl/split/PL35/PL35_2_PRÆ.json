  },
  {
    "chunk_id": "oglt-pl/anonymus/pl35_2_præ#PL35.PR.s13",
    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s13",
    "language": "lat",
    "text": "Hæc ergo quasi dimissa ab illis scribit Joannes, quae fecit Jesus antequam Joannes clauderetur : sed maxime divinitatem Christi et Trini­ tatis mysterium commendare curavit.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
