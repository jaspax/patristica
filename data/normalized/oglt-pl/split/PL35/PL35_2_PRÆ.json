    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s15",
    "language": "lat",
    "text": "in qua laboratur, ut cor mundetur ad videndum Deum: Joannes vero pauca Domini faeta dicit:",
