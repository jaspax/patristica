    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s8",
    "language": "lat",
    "text": "sufficienter exponunt, et de divinitate pauca dixerunt, quasi ani­ matia gressibilia cum Domino ambulant in terra :",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
