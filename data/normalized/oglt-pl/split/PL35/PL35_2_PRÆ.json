    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s5",
    "language": "lat",
    "text": "compulsus ab episcopis Asix, de coæterna Patri divinitate Christi scripsit adversus hæreticos, qui eo absente irruperant in ejus Ecclesias, qui Chri­ stum ante Mariam fuisse negabant.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
