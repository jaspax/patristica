    "canonical_ref": "PL35.PR.s2",
    "language": "lat",
    "text": "Inter ipsos autem Evangeliorum scriptores Joannes eminet in dir vinorum mysteriorum profunditate,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
