    "work_id": "oglt-pl/anonymus/pl35_2_præ",
    "canonical_ref": "PL35.PR.s9",
    "language": "lat",
    "text": "hic autem pauca de temporalibus ejus gestis edisserens, sed divinitatis potentiam-sublimius contemplans, cum Domino ad caelum volat.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
