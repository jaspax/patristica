    "canonical_ref": "PL35.PR.s3",
    "language": "lat",
    "text": "qui a tempore Dominicæ ascensionis per annos sexaginta quinque verbum Dei absque adminiculo scribendi, usque ad ut­ tima Domitiani praedicavit tempora.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
