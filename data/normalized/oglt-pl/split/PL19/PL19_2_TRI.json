    "work_id": "oglt-pl/pseudo-juvencus/pl19_2_tri",
    "canonical_ref": "PL19.TRI.s10",
    "language": "lat",
    "text": "Quid miseri audetis contra capere arma Tonan- [tem? Hic ego rex vester, frustra est obsistere regi.",
