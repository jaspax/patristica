    "work_id": "oglt-pl/pseudo-juvencus/pl19_2_tri",
    "canonical_ref": "PL19.TRI.s8",
    "language": "lat",
    "text": "Ecce autem Christus per tetra silentia rupit Lumine sidereo, claraque in luce refulsit.",
