    "canonical_ref": "PL19.TRI.4.s3",
    "language": "lat",
    "text": "pavet ipsa Me- [goera, Tisiphone, Alecto, perculsae luce molesta, Ultrices Dirae, Furiae, Parcaeque sorores.",
