    "work_id": "oglt-pl/pseudo-juvencus/pl19_2_tri",
    "canonical_ref": "PL19.TRI.4.s1",
    "language": "lat",
    "text": "Cardinibus, magnamque dedit collapsa ruinam Janua, et admittunt concussa palatia Christum.",
