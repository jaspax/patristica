    "work_id": "oglt-pl/pseudo-juvencus/pl19_2_tri",
    "canonical_ref": "PL19.TRI.s7",
    "language": "lat",
    "text": "Agmine facto illi summa ad fastigia currunt, Vocibus horrisonis et tecta et moenia complent.",
