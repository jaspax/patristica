    "canonical_ref": "PL19.TES.7",
    "language": "lat",
    "text": "Pauxillum Fortuna tibi, res perfida. Quinte, Extulit in frontem grande supercilium. Nam ne aliud credam, puteum puto te quoque, Quinte, Quanto altus magis es, lam mage despiceris.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
