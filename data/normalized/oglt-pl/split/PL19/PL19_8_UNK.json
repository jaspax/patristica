    "chunk_id": "oglt-pl/sedulius/pl19_8_unk#PL19.UNK.1.1.s12",
    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s12",
    "language": "lat",
    "text": "Ut coeptis studeant addere plura meis : — Et Jove cum falso saeva Junone relicta, —",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 437,
    "date_range": [
