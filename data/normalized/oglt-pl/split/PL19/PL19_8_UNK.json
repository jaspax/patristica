    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s16",
    "language": "lat",
    "text": "Primum disti- chum Finem carmen habet, etc.; aliis in locis ejus- dem codicis reperitur.",
    "chunk_index": 17,
    "context_before": null,
