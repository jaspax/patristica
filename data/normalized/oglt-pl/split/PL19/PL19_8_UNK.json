    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s9",
    "language": "lat",
    "text": "sed in Reg. 5 alii plures adduntur, quos censeo esse exscriptoris Matthiae filii Adae Sculteri, Mansiona- rii in ecclesia Cracoviensi.",
    "chunk_index": 10,
    "context_before": null,
