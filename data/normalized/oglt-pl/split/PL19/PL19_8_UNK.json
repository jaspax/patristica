    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s20",
    "language": "lat",
    "text": "Certum tamen est, nonnullos mi- nus caute beatissimam Virginem Matiam deam ap- pellasse :",
