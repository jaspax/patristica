    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s21",
    "language": "lat",
    "text": "nam ut omittam auctorem anonymum hu- jus epigrammatis, et Apollinarem haereticum, qui in carmine etiam ut deam vocavit, satis notus est versus Justi Lipsii :",
    "chunk_index": 22,
