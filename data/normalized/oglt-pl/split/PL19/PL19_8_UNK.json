    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s7",
    "language": "lat",
    "text": "quod acu- men in voculis paribus te tua, tete, tibi, quaerit : quod genus cum honestate quadam amat hic Christi olor.",
