    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s24",
    "language": "lat",
    "text": "Negat idem Raynaudus, Petrum Damiani in elogiis Deiparae hoc vocabulo deae usum fuisse, quod alii asseruerant :",
    "chunk_index": 25,
    "context_before": null,
