    "canonical_ref": "PL19.UNK.1.1.s19",
    "language": "lat",
    "text": "devotion. cap. 1, disserit, super- vacanee, aut etiam contumeliose hoc monitum exhi- beri, cum nemo sit fidelium qui Mariam deum esse credat, aut dicat.",
    "chunk_index": 20,
