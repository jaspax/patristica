    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s14",
    "language": "lat",
    "text": "—Qui cum Patre Deo vivens per saecula cuncta, — Una cum sancto flamine regnat : amen.",
    "chunk_index": 15,
    "context_before": null,
