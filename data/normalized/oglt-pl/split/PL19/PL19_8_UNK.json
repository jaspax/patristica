    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s15",
    "language": "lat",
    "text": "In versu Nunc, ubi obscure scriptum est Nunc, et in v. Qui cum, etc. non satis clare cuncta.",
    "chunk_index": 16,
    "context_before": null,
