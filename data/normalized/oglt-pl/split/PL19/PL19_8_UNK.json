    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/sedulius/pl19_8_unk#PL19.UNK.1.1.s11",
    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s11",
    "language": "lat",
    "text": "Tardus ego laudum pelagus lustrare tuarum—Exigua coepi, Virgo serena, manu.—Exemplum praebeus aliis imitabile doctis, —",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
