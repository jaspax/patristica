    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s17",
    "language": "lat",
    "text": "In pentametro, Incipient ve- ram te celebrare deam, merito displicebit, quod Virgo Deipara vocetur vera dea.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
