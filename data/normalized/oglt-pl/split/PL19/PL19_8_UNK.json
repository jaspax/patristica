    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s10",
    "language": "lat",
    "text": "Ita igitur continenter procedit epigramma : Finem carmen habet, nec lauri serta requiro.—Tu studii merces esto, Maria, mei.—",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 437,
    "date_range": [
