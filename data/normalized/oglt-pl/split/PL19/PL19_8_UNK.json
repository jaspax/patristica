    "work_id": "oglt-pl/sedulius/pl19_8_unk",
    "canonical_ref": "PL19.UNK.1.1.s13",
    "language": "lat",
    "text": "Incipiant veram te celebrare deam.—Nunc ubi magna sedes hominum regina beatrix,—A dextris nati plena decore tui.",
