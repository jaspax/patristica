    "work_id": "oglt-pl/boethius/pl64_18_an",
    "canonical_ref": "PL64.AN.2.s2",
    "language": "lat",
    "text": "In gestione vero negotii ea sunt quæ et ante factum,et dum fit,et post factum,quod gestum ost contineant.",
