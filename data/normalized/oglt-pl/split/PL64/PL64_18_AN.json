    "work_id": "oglt-pl/boethius/pl64_18_an",
    "canonical_ref": "PL64.AN.3.s2",
    "language": "lat",
    "text": "Haec cum aliis cceperint comparari et quasi in revelationem venire, fiunt aut genus, aut pars,aut contrarium, aut even­ tus, aut majus, aut minus, aut simile, aut aeque magnum,aut disparatum.",
    "chunk_index": 28,
