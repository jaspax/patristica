    "work_id": "oglt-pl/boethius/pl64_18_an",
    "canonical_ref": "PL64.AN.2.s6",
    "language": "lat",
    "text": "Sunt autem ea quodammodo effecta et respicientia negotium quod agit:Jr hoc modo.",
