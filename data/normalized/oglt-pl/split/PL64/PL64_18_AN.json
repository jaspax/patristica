    "work_id": "oglt-pl/boethius/pl64_18_an",
    "canonical_ref": "PL64.AN.2.s3",
    "language": "lat",
    "text": "In omnibus enim tempus, occasio, ocus, modus, facultas inquiritur. Rursus dum fit, factum est quo administratum est negotium.",
