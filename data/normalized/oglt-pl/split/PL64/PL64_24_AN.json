    "work_id": "oglt-pl/boethius/pl64_24_an",
    "canonical_ref": "PL64.AN.s13",
    "language": "lat",
    "text": "Si igitur eorum unadeuas, nna sub­ stantia est licet Dei nomen de divinitate substantia­ liter praedicari.",
