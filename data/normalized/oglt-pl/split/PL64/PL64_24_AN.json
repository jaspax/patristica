    "work_id": "oglt-pl/boethius/pl64_24_an",
    "canonical_ref": "PL64.AN.s10",
    "language": "lat",
    "text": "Quae­ cunque igitur de divina substantia praedicantur, ea tribus oportet esse communia ;",
