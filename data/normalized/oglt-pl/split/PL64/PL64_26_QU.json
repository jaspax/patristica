    "work_id": "oglt-pl/boethius/pl64_26_qu",
    "canonical_ref": "PL64.QU.s12",
    "language": "lat",
    "text": "Quod est, participare aliquo po­ test; sed ipsum esse, nullo modo aliquo partici­ pat: fit enim participatio cum aliquid jam est; 1 est autem aliquid, cum esse susceperit.",
