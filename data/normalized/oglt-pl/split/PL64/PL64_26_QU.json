    "work_id": "oglt-pl/boethius/pl64_26_qu",
    "canonical_ref": "PL64.QU.s9",
    "language": "lat",
    "text": "Alia vero est doctorum tantum, quæ tamen ex talibus commu­ nis animi conceptionibus venit, ut est:",
