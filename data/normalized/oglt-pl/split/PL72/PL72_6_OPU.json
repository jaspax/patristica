    "canonical_ref": "PL72.OPU.5.s5",
    "language": "lat",
    "text": "Cupio te omnia mandata Christi seryare; et cum illa operibus bonis adimpleas, illud quod ipsis aposiolis dictum est, recordari.",
    "chunk_index": 51,
    "context_before": null,
