    "work_id": "oglt-pl/martinus-bracarensis/pl72_6_opu",
    "canonical_ref": "PL72.OPU.5.s4",
    "language": "lat",
    "text": "Super quem, inquit Dominus, requiescet spiritus meus, nisi super humilem et trementem verba mea (Isai. i.xvi, 2 ) ?",
