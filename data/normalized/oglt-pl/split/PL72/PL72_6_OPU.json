    "work_id": "oglt-pl/martinus-bracarensis/pl72_6_opu",
    "canonical_ref": "PL72.OPU.6.s2",
    "language": "lat",
    "text": "In hac victoriam ex omni vitio poteris promereri , Deo hoc quod viceris tribuendo, non tibi.",
