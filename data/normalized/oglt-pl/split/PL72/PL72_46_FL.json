    "canonical_ref": "PL72.FL.3.s14",
    "language": "lat",
    "text": "Vestra autem conversatio in cœlis est , orate cum his, et rogate it­ lum meum sacratissimum confessorem AmbrosiuM, quatenus me ut peculiarem famulum tueatur,",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
