    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s4",
    "language": "lat",
    "text": "Nestorii fulmen, Eutychis exstinctor, glorio­ sam dominam meam inviolabilemque Mariam Chri­ stotocon et Theotocon, apostolica auctoritate perdo­ cuit.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
      550,
