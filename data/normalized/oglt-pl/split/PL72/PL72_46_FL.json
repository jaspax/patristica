    "canonical_ref": "PL72.FL.3.s11",
    "language": "lat",
    "text": "jejuniis castigatum, orationi­ bus refeclum, puritate mundissimum, qui mihi sa­ cras exposuit Scripturas, et flures teneræ lanuginis ipse suscepit;",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
