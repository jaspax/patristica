    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s2",
    "language": "lat",
    "text": "quj generosi sanguinis nobilitatem humilitate prævexit ad glo­ riam, ut in cœlestis patriæ senatu fieret et ibi sena­ tor,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
