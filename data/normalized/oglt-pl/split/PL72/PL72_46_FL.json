    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s10",
    "language": "lat",
    "text": "saeculi hujus inimicum, cui cru­ cifixus est mundus, templum vrre dignissimum Tri­ nitatis, plenum reverentiæ Christianitatis, ex placida bonitate mitissimum,",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
