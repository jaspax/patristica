    "canonical_ref": "PL72.FL.3.s15",
    "language": "lat",
    "text": "ut proprium civem foveat, ut familiarem alumnum eruat: qui apud Dominum Jesum quod oraverit exo­ rabit.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
