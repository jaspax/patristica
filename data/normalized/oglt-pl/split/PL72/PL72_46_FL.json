    "canonical_ref": "PL72.FL.3.s16",
    "language": "lat",
    "text": "Quocirca salutationis obsequium famul anter insinuans, precor ut pro beatissimo viro, domino meo Datio episcopo fratre vestro, semper pretis.",
    "chunk_index": 24,
    "context_before": null,
