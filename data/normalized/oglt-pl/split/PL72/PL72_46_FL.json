  },
  {
    "chunk_id": "oglt-pl/florianus-abbas/pl72_46_fl#PL72.FL.3.s6",
    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s6",
    "language": "lat",
    "text": "Sed et coronæ vestrae socium beatae memo­ riæ dominum Cæsarium Arelatensem episcopum, qui vixit inter barbaros pius, inter bella pacatus,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
      550,
      560
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
