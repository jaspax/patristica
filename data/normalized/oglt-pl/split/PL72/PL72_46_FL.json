    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s3",
    "language": "lat",
    "text": "cujus incomparabilem doctrinae facundiam non solum testatur Occidens, sed et Oriens instructa mi­ ratur.",
    "chunk_index": 11,
    "context_before": null,
