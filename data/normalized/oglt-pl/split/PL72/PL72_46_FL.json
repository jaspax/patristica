    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s8",
    "language": "lat",
    "text": "Ipse igitur mihi Latinis elementis imposuit alphabetum, sed et hunc profamulo discipuloque suo impetrare confido.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
      550,
      560
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/florianus-abbas/pl72_46_fl#PL72.FL.3.s9",
    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s9",
    "language": "lat",
    "text": "Addo tertium, imparem quidem dignitate, sed meritis coæ­ qualem sanctæ memoriæ Theodatum abbatem meum, et archimandritam,",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
