    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s7",
    "language": "lat",
    "text": "pater orphanorum, pastor egentium, qui tanti cen­ sus effusione nil perdidit, catholice regulam disci­ plinæ dictis factisque demonstrans.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
      550,
