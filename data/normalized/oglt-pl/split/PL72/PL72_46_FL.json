    "work_id": "oglt-pl/florianus-abbas/pl72_46_fl",
    "canonical_ref": "PL72.FL.3.s5",
    "language": "lat",
    "text": "Ipse ergo meus est pater ex lavacro, quem credo apud æternum Patrem per Filium intervenire pro filio.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 555,
    "date_range": [
      550,
