    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.7.s5",
    "language": "lat",
    "text": "Et satis miror hominem doctissimum et sanctum , ut de stellis naenias Origenis transferret.",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": 591,
    "date_range": [
