    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.6.s6",
    "language": "lat",
    "text": "qui periius esse dicatur; neino erit utique sacerdos, si nisi peri­ tus esse non debet.",
