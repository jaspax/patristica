    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.6.s9",
    "language": "lat",
    "text": "Valde enim metuimus, ne per necessitatem ea facia­ m us quae non debemus.",
    "chunk_index": 47,
    "context_before": null,
