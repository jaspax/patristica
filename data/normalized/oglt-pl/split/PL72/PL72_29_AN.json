    "canonical_ref": "PL72.AN.6.s13",
    "language": "lat",
    "text": "In utroque periculum manet; aot talis ordinetur qui non debet, aut non ni qui secra mysteria celebret vel ministret,",
    "chunk_index": 51,
    "context_before": null,
