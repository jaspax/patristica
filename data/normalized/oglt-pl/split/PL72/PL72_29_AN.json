    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.6.s5",
    "language": "lat",
    "text": "si aulem non sufficit, nemo erit in boc libro [Ms. Tolet., loco].",
