    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.7.s8",
    "language": "lat",
    "text": "sed et alios librus morales, quos fecisse te memoras in hoc libro Regutarum, exiguitati [Ms. Tolet., nostræ] trans­ mittere.",
    "chunk_index": 59,
    "context_before": null,
