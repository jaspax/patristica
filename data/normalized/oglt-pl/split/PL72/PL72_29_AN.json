    "canonical_ref": "PL72.AN.7.s7",
    "language": "lat",
    "text": "quæ neque cum angelis, neque cum hominibus facta esse Scriptura sancta declarat. Dignetur ergo Bea­ titudo vestra opus ipsum de libro sancti Job;",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": 591,
    "date_range": [
