    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.6.s1",
    "language": "lat",
    "text": "Unde precor per gratiam Dei, quæ in te exuberat, ut non respuas deprecantem ; sed libenter doceas quae me fateor ignorare.",
