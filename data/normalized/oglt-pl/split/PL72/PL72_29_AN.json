    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.7.s3",
    "language": "lat",
    "text": "in qua epistola memoras displicuisse vobis illud opus, sed hoc salubriori consilio statuisse ut in librorum ductu [Ms. Tolet., ductus] eas transponeres.",
    "chunk_index": 54,
    "context_before": null,
