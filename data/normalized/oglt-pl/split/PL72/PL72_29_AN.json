    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.6.s3",
    "language": "lat",
    "text": "Peritus enim dum nou reperitur qui ad officium sa­ cerdotale veniat, quid fiendum est, nisi ut imperi­ tus, utego sum, ordinetur ?",
