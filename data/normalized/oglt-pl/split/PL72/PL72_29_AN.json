  },
  {
    "chunk_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an#PL72.AN.5.s2",
    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.5.s2",
