    "canonical_ref": "PL72.AN.6.s10",
    "language": "lat",
    "text": "Ecce obediendum est pre­ ceptis tuis, ut talis liat, qualis [Ms. Tolet..",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": 591,
    "date_range": [
