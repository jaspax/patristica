    "work_id": "oglt-pl/licinianus-carthaginensis/pl72_29_an",
    "canonical_ref": "PL72.AN.7.s6",
    "language": "lat",
    "text": "Mihi, sanctis­ sime Pater, nullo pacto suaderi potest, ut credam astra coeli spiritus [Ms. Tolet., habere] rationales,",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": 591,
    "date_range": [
