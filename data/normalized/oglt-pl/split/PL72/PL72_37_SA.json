    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa#PL72.SA.2.s4",
    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.2.s4",
    "language": "lat",
    "text": "deficiente ergo vino, dicit ad Jesum mater ejus (Joan. II) : Vi­ num non habent.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
      589,
