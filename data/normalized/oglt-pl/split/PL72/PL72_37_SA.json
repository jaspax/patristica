    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa#PL72.SA.s10",
    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.s10",
    "language": "lat",
    "text": "Tibi ergo nascendo, Christus adveuit, tibi vivendo militavit, tibi monendo conflixit.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
