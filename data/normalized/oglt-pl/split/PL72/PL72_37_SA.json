      589
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa#PL72.SA.s8",
    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.s8",
    "language": "lat",
    "text": "Quia hæc Christi generatio tuae fidei confirmatio est.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
      589,
      589
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa#PL72.SA.s9",
    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.s9",
    "language": "lat",
    "text": "Et quia per universum mundum sacramento baptismi hu­ mano generi opus erat, aquis benedictionem dedit, quando in Jordanis alveum, unica, ac singulari pie­ tale descendit.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
      589,
