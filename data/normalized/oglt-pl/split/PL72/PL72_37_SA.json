    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.1.s1",
    "language": "lat",
    "text": "Quem vides pro te mortuum, propter te intellige baptizatum.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
