  },
  {
    "chunk_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa#PL72.SA.s6",
    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.s6",
    "language": "lat",
    "text": "Nobis remedia provi­ vidit ex baptismo quod in Jordanis ałveo aquas de­ dicavit;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
      589,
      589
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa#PL72.SA.s7",
    "work_id": "oglt-pl/sedatus-biterrensis/pl72_37_sa",
    "canonical_ref": "PL72.SA.s7",
    "language": "lat",
    "text": "et ideo, 'ratres charissimi, in omni actu nostro stellam fidei præferamus, et in custodia puri­ tatis Christi baptismum celebremus.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 589,
    "date_range": [
