[
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s1",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s1",
    "language": "lat",
    "text": "Dominæ clementissimæ atque præcellentissimæ, et nobis semper piissimae dominae et in Christo san­ ctæ Ecclesia filiae Brunichildi reginae Germanus pec­ cator.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s2",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s2",
    "language": "lat",
    "text": "Quia charitas congaudet veritati, et omnia sustinet, et nunquam excedit, propterea ex contri­ bulato corde et ex intima animi dilectione audemus vobis suggerere.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s3",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s3",
    "language": "lat",
    "text": "Quia eo tempore quando minor erat numerus populi Christiani, et cum Dei auxilio lice­ bat residere quietum, cum apostoli dicebant: Ecce nunc tempus acceptabile, ecce nunc dies salutis.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s4",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s4",
    "language": "lat",
    "text": "Nunc e contrario tam funestos et luctuosos ante oculos habentes dies, flenter dicimus : Ecce dies tribulatio­ nis et perditionis nostrae adveniunt. V æ nobis quia peccavimus.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s5",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s5",
    "language": "lat",
    "text": "Si nos istæ conterruissent amaritudines et tribulationes, et corpori exhibuissent infirmitatem, per nosmetipsos vestrae debuimus occurrere pietati.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s6",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s6",
    "language": "lat",
    "text": "Quia si fas dici est singulariter et vestri dilectionem in nostro gestamus pectore, et unice de vestra præ- sentia spirituali desiderio sitientes,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s7",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s7",
    "language": "lat",
    "text": "sicut cultorcs et peculiares filii Dei, ambientissime vos vivere atque proficere in omnibus pie optamus.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s8",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s8",
    "language": "lat",
    "text": "Sed quicunque hominem in anima diligit, si minus oculis carnalibus eum valet intueri, quae ad animæ et corporis vel prosperitatem pertinent et salutem, omnimodis litte­ rario officio reticeri non debet.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s9",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s9",
    "language": "lat",
    "text": "Vulgi verba iterantes quæ nos maxime terrent, vestrae pietati in notitiam dcponimus , quæ ita disseminat, eloquentium ora detrahuntur,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s10",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s10",
    "language": "lat",
    "text": "quasi vestro voto, consilio et instiga­ tione Dominus gloriosissimus Sigibertus rex tam ar­ due hanc velit perdere regionem.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s11",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s11",
    "language": "lat",
    "text": "Non propterea haec dicimus, quasi a nobis credatur : sed supplicamus , ut nulla occasio tribuatur dicendi, unde vobis tam maximum et periculosum generetur blaspbemium.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s12",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s12",
    "language": "lat",
    "text": "Licet hæc regio jam caruisse felicitatem, et perditio­ nis nostrae concludamus terminum :",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s13",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s13",
    "language": "lat",
    "text": "sed de miseri­ cordia non desperabamus divina, adhuc ultionis sus­ pendendi manum , dum emendationis exspectatur remedium, si non dominaretur intentio, quae mortem operatur;",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s14",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s14",
    "language": "lat",
    "text": "cupiditas quae radix est omnium malorum; iracundia, quae sensum aufert prudentix.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s15",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s15",
    "language": "lat",
    "text": "Salvator noster perspiciens suae passionis imminere tempus, dixit: V æ homini per quem scandalum venit.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s16",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s16",
    "language": "lat",
    "text": "Quod ore proprio detestatus est, impuue non posse manere credimus, omnibus clamamus, omnes conscientiæ suae cogitationes et actiones considerent, et caveant ne cum Juda proditore hujus condemnationis sor­ tiantur judicium.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s17",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s17",
    "language": "lat",
    "text": "Deo sufficit nosse, optabam aut pro ipsis mori, ut illi viverent, aut ante eorum interitum quocunque casu vitam linire, ut nec eorum, nec re­ gionis cerneremus.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s18",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s18",
    "language": "lat",
    "text": "interitum. Sed alter ab altero excusatione utitur, et nullus ex ipsis ante oculos Dei ponit judicium;",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s19",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s19",
    "language": "lat",
    "text": "neque aliquid Dei reservat pote­ stati judicandum, nec credent se jam sub Dei notitia.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s20",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s20",
    "language": "lat",
    "text": "Quia a nullo audiri meremur, vobis et ideo suppli­ camus : quia si illi regnum perdiderint, nec vos nec filii vestri magnum possidebitis triumphum.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s21",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s21",
    "language": "lat",
    "text": "Ad hoc vos haec regio suscepisse gratuletur, ut per vos sa­ lutem non interitum percipere videatur.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s22",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s22",
    "language": "lat",
    "text": "In hoc po­ puli restinguitis verba, si mitigatis furorem, si Dei facitis exspectare judicium.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s23",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s23",
    "language": "lat",
    "text": "In veritate suggero, si meam humilem non despicitis supplicationem, adhuc devotorum vestrorum gaudemus plenitudine.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s24",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s24",
    "language": "lat",
    "text": "Pro­ pterea haec dolens scribo, quia video qualiter praeci- pitantur et reges et populi, ut Dei incurrant offen­ sam.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s25",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s25",
    "language": "lat",
    "text": "Ita legimus : Quicunque in brachii sui fortitu­ dine speravit, antea confusionem quam victoriam pro­ meruit.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s26",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s26",
    "language": "lat",
    "text": "Quicunque adminiculo gentis sibi adjuvari posse conlidit, antea periculum mortis quam salutem promeruit.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s27",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s27",
    "language": "lat",
    "text": "Quicunque propter copiam auri et argenti elevatur in superbiam, antea desolationis opprobrium sustinebit, quam suae cupiditatis consuluisset avidi­ tati.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s28",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s28",
    "language": "lat",
    "text": "Ipse Judex aeternus nunc judicat, perpetuam judiciariam possidet potestatem :",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s29",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s29",
    "language": "lat",
    "text": "non corrumpitur praemiis, aut aspicit ad vOla impiorum, sed conside­ rat cogitationes cordium, et reddet unicuique secun­ dum opera sua.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s30",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s30",
    "language": "lat",
    "text": "Inhonesta victoria est fratrem vin­ cere, domesticas domos bumiliare et possessionem a parentibus constructam evertere.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s31",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s31",
    "language": "lat",
    "text": "Contra semetipsos pugnant suamque felicitatem exterminant : de sua perditione gaudet accelerans inimicus.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s32",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s32",
    "language": "lat",
    "text": "Qua fide et ex animo, qua devotione haec scribimus Deo sufficit nosse, ut vobis bona futura praeparetis, et nos cum Deo absolutos esse vel paululum sentiamus.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
      555,
      576
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/germanus-parisiensis/pl72_11_sa#PL72.SA.s33",
    "work_id": "oglt-pl/germanus-parisiensis/pl72_11_sa",
    "canonical_ref": "PL72.SA.s33",
    "language": "lat",
    "text": "Sed quia sacerdotibus praeceptum est : Ut tuba exalta vocem tuam et annuntia populo meo opera eorum ; ergo, piis- sima domina, intelligite mysterium et cavete exem­ pium.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 565,
    "date_range": [
