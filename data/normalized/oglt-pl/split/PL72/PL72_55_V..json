    "work_id": "oglt-pl/chlodovechus-i/pl72_55_v.",
    "canonical_ref": "PL72.V.3.s3",
    "language": "lat",
    "text": "Simili conditione et de clericis , vel filiis supradictorum , tam clericorum , quam vidua­ rum, qui cum illis in domo ipsorum consistere vi­ debantur.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      507,
      511
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
