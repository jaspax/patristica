    "work_id": "oglt-pl/chlodovechus-i/pl72_55_v.",
    "canonical_ref": "PL72.V.3.s6",
    "language": "lat",
    "text": "De caeteris quidem captivis laicis, qui extra pacem sunt captivatit, et fuerint approbati, apostolica cui volueritis arbitrii vestri est non negandum.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      507,
      511
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
