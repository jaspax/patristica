    "canonical_ref": "PL72.V.3.s5",
    "language": "lat",
    "text": "Quod ita ad integrum est agnoscendum, ut ex his supradictis, si aliquis vim captivitatis pertulisset, sive in ecclesia, sive extra ecclesiam, omnino sine aliqua dilatione reddendos esse præcipiamus.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      507,
      511
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
