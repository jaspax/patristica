    "work_id": "oglt-pl/chlodovechus-i/pl72_55_v.",
    "canonical_ref": "PL72.V.3.s4",
    "language": "lat",
    "text": "Idem et de servis ecclesiarum, quos de ec­ clesiis tractos per episcoporum sacramenta constite­ rit, praeceptum est observare, ut nullus ex ipsis aliquam violentiam vel damnum pateretur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      507,
      511
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
