    "work_id": "oglt-pl/chlodovechus-i/pl72_55_v.",
    "canonical_ref": "PL72.V.3.s2",
    "language": "lat",
    "text": "In primo quoque de ministerio Ecclesia­ rum omnium præcepimus, ut nullus ad subripiendum in aliquo conaretur, neque de sanctimonialibus , ne­ que de viduis , quæ in religione domini devotae esse probarentur.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      507,
      511
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
