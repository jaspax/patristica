    "work_id": "oglt-pl/theodericus-rex/pl72_49_ii",
    "canonical_ref": "PL72.II.2.s3",
    "language": "lat",
    "text": "Sed non optavimus commisisse, sanctae congregationis examinis sub hac protrahi dilatione negotium, nec universitatis animos gravius praejudicio pendere suspensos.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
    "date_confidence": "approximate",
