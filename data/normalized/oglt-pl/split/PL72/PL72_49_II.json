    "work_id": "oglt-pl/theodericus-rex/pl72_49_ii",
    "canonical_ref": "PL72.II.2.s2",
    "language": "lat",
    "text": "ne discedentibus universis sub manifesta deserti dispositione judicii major urbem regiam sedi­ tiosis motibus turba concuteret.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
