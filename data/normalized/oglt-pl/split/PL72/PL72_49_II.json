    "work_id": "oglt-pl/theodericus-rex/pl72_49_ii",
    "canonical_ref": "PL72.II.2.s4",
    "language": "lat",
    "text": "Quia nec tranquillitati urbis definitionis mora, nec sacerdotali proposito sententia potest convenire discordiae.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
