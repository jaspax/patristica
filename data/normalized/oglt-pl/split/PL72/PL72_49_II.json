    "canonical_ref": "PL72.II.2.s1",
    "language": "lat",
    "text": "Vos quidem rem fecistis proposito congruentem , DOS potius de reditu vestro secundo consulere, quam indictum concilium alienae facilitatis imitatione deserere;",
    "chunk_index": 2,
    "context_before": null,
