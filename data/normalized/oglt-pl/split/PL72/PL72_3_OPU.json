  },
  {
    "chunk_id": "oglt-pl/martinus-bracarensis/pl72_3_opu#PL72.OPU.3.s12",
    "work_id": "oglt-pl/martinus-bracarensis/pl72_3_opu",
    "canonical_ref": "PL72.OPU.3.s12",
    "language": "lat",
    "text": "Eleemosyna non tam acci­ pientibus quam dantibus prodest. Et spes praemii solatium sit laboris. Quae est maxima egestas?",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 568,
    "date_range": [
