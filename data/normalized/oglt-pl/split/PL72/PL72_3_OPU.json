  {
    "chunk_id": "oglt-pl/martinus-bracarensis/pl72_3_opu#PL72.OPU.3.s11",
    "work_id": "oglt-pl/martinus-bracarensis/pl72_3_opu",
    "canonical_ref": "PL72.OPU.3.s11",
    "language": "lat",
    "text": "Mira ratio est, quæ non vult praedicari quod gaudet intellegi. Ignosci amat, qui quod odit ostendit.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 568,
    "date_range": [
