    "canonical_ref": "PL72.OPU.3.s10",
    "language": "lat",
    "text": "Pejora sunt te­ cta odia quam aperta. Itaque te minus loquax inimi­ cus offendit quam tacitus.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 568,
