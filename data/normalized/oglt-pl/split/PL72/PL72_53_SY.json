    "work_id": "oglt-pl/theodericus-rex/pl72_53_sy",
    "canonical_ref": "PL72.SY.2.s7",
    "language": "lat",
    "text": "Nullius ergo perso­ nam ante oculos habeatis: qaamvis si vobis aliquis violenter vellet quae injusta sunt imponere, missis rebus vestris justitiam custodire debeatis.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
    "date_confidence": "approximate",
