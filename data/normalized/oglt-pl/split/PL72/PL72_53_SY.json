    "work_id": "oglt-pl/theodericus-rex/pl72_53_sy",
    "canonical_ref": "PL72.SY.2.s11",
    "language": "lat",
    "text": "Hæc cum diceret, proposuit similitudinem : Aliquando utipse fieret im­ perator, Aspari a senatu dicebatur;",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
    "date_confidence": "approximate",
