    "canonical_ref": "PL72.SY.2.s2",
    "language": "lat",
    "text": "et po­ steritati ingratum non fuisset, sed quia causa est Dei et clericorum , ideoque modo ad petitionem se­ natus vel cleri ex diversis civitatibus convenere an­ tistites, velut Deo medio ,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
