    "work_id": "oglt-pl/theodericus-rex/pl72_53_sy",
    "canonical_ref": "PL72.SY.2.s4",
    "language": "lat",
    "text": "Si vero vobis visum fuerit sine discussione causam Linire, aut discussam, quemadmodum visum fuerit, judicate.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/theodericus-rex/pl72_53_sy#PL72.SY.2.s5",
    "work_id": "oglt-pl/theodericus-rex/pl72_53_sy",
    "canonical_ref": "PL72.SY.2.s5",
    "language": "lat",
    "text": "Meam personam nolite metuere, diluri rationem ante conspectum Dei : tantum est ut senatum, clerum et populum pacificum dimittatis, et quod judicaveritis scribatis.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
