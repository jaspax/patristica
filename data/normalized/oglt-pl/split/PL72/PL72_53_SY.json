  {
    "chunk_id": "oglt-pl/theodericus-rex/pl72_53_sy#PL72.SY.2.s12",
    "work_id": "oglt-pl/theodericus-rex/pl72_53_sy",
    "canonical_ref": "PL72.SY.2.s12",
    "language": "lat",
    "text": "qui tale fertur dedisse responsum : Timeo ne per me peccandi con­ suetudo in regno nascatur.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
