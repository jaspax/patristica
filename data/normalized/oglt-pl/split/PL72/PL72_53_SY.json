    "work_id": "oglt-pl/theodericus-rex/pl72_53_sy",
    "canonical_ref": "PL72.SY.2.s6",
    "language": "lat",
    "text": "Nos autem hoc prob mus vos bene ordinare, si populo, senatui, clero pacem integram reddatis. Quod si minime feceritis , ostendetis vos uni parti favisse.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 509,
    "date_range": [
      493,
      526
    ],
    "date_confidence": "approximate",
