    "canonical_ref": "PL72.SY.2.s3",
    "language": "lat",
    "text": "secundum quod legitis in Evangelio, et Apostolo ad Corinthios, hoc sequami- nf. Nam si meum animum requiretis, ut superius dixi, quae praecipit Deus in Evangelio, hoc sequa­ mini.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
