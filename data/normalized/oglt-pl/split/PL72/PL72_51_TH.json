    "canonical_ref": "PL72.TH.1.s5",
    "language": "lat",
    "text": "Ideo­ que nostro toto affectu et obsequio jussioni vestrae pa­ rere voluimus, et ad papam, qui impetebatur,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 501,
    "date_range": [
