    "canonical_ref": "PL72.TH.1.s3",
    "language": "lat",
    "text": "Sic enim mansuetos principes coeli Dominus fecit esse quos diligit; et propitiata Divinitas eos in causis omnibus mandatis suis ordinat obedire;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 501,
    "date_range": [
