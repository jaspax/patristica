    "canonical_ref": "PL72.TH.1.s4",
    "language": "lat",
    "text": "quod scri­ ptum est, dicente Deo. me nihil potestis facere (Joan. xv), quod utique boni intlelligendum est.",
    "chunk_index": 4,
    "context_before": null,
