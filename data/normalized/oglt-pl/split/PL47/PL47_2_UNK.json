    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s9",
    "language": "lat",
    "text": "Ipse ædificabis mihi domum, et firmabo so- tium ejus usque in æternum, Ego ero illi in patrem,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
