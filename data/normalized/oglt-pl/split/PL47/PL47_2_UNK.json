    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_2_unk#PL47.UNK.s22",
    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s22",
    "language": "lat",
    "text": "Non est ergo Salomon, sed nec iste David. sed dilatatus est Christus.",
