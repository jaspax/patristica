    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s19",
    "language": "lat",
    "text": "Salomonis namque do- mum fuisse plenam mulieribus alienigenis colentibus idola, et ipse ab eis rex idololatriæ seductus, atque dejectus, qui dum bonus fuisset in initio, malum exi- tum habuit.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
