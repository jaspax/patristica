  {
    "chunk_id": "oglt-pl/augustinus/pl47_2_unk#PL47.UNK.s27",
    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s27",
    "language": "lat",
    "text": "In die illa radix Jesse qui stat in signum populorum, ipsum gentes deprecabuntur, et erit sepul- crum ejus gloriosum, In signum populorum stat radix Jesse,",
