    "canonical_ref": "PL47.UNK.s6",
    "language": "lat",
    "text": "Et item in libro Paralipomenon : Et factum est verbum Domini ad Nathan prophetam dicens : Vade et dic servo meo David :",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
