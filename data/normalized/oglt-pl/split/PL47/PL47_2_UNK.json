    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s30",
    "language": "lat",
    "text": "etiam locus ipse coruscans miraculis gloriæ suæ, ob eam causam ad se omnem contrahit mun- dum.",
