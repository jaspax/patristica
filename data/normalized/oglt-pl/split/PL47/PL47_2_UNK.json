    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s7",
    "language": "lat",
    "text": "Hæc dicit Dominus : Annuntio tibi quod ædifi- caturus est domum sibi Dominus;",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_2_unk#PL47.UNK.s8",
    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s8",
    "language": "lat",
    "text": "cumque impleveris dies tuos ut vadas ad patres tuos, suscitabo semen tuum post te, quod erit de filiis tuis, et stabiliam re- gnum ejus.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
