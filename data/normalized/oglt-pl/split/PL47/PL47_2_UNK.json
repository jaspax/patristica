    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_2_unk#PL47.UNK.s24",
    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s24",
    "language": "lat",
    "text": "Ecce dies veniunt,et suscita- bo David germen justum, et regnabit rex,et sapiens erit, et faciet judicium et justitiam super terram.",
    "chunk_index": 23,
    "context_before": null,
