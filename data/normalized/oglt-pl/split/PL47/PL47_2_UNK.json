  {
    "chunk_id": "oglt-pl/augustinus/pl47_2_unk#PL47.UNK.s20",
    "work_id": "oglt-pl/augustinus/pl47_2_unk",
    "canonical_ref": "PL47.UNK.s20",
    "language": "lat",
    "text": "Ergo quis est iste cujus domus est fide- lis in perpetuum, et qui post mortem David promit- tebatur suscitandus?",
