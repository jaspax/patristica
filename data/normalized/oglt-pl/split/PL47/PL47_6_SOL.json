    "work_id": "oglt-pl/pseudo-augustinus/pl47_6_sol",
    "canonical_ref": "PL47.SOL.1.s2",
    "language": "lat",
    "text": "ae præclarissimo Ecclesiæ Doctore non esse compo- situm : at novimus etiam, a landabili Scriptore eum prodiisse.",
