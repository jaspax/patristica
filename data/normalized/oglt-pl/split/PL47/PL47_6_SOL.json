    "work_id": "oglt-pl/pseudo-augustinus/pl47_6_sol",
    "canonical_ref": "PL47.SOL.2.s20",
    "language": "lat",
    "text": "In te sum quod sum; in te vivo quod vivo : in te intelligo quod intelligo, quia tu es summa intelligentia, essentia summa, vita summa,",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
