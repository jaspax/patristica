  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl47_6_sol#PL47.SOL.2.s18",
    "work_id": "oglt-pl/pseudo-augustinus/pl47_6_sol",
    "canonical_ref": "PL47.SOL.2.s18",
    "language": "lat",
    "text": "tu vide te in me, tu intellige te in me. Per me enim non video nisi vana, fluxa, et caduca, nec video nisi falsa, et corporea plasmata :",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
