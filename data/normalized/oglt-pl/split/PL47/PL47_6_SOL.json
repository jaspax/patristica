    "work_id": "oglt-pl/pseudo-augustinus/pl47_6_sol",
    "canonical_ref": "PL47.SOL.1.s3",
    "language": "lat",
    "text": "Gratum itaque, ut puto, Lectori erit, si quæ in codice, quem e selecta sua biblioth(??)ca mihi dono misit nobilissimus,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/pseudo-augustinus/pl47_6_sol#PL47.SOL.1.s4",
    "work_id": "oglt-pl/pseudo-augustinus/pl47_6_sol",
    "canonical_ref": "PL47.SOL.1.s4",
    "language": "lat",
    "text": "atque humanissimus vir Faustinus Avogadro, Comes Brixianus, eidem libello adjecta invenimus, evulgemus.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
