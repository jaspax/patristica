    "canonical_ref": "PL47.SOL.1.s1",
    "language": "lat",
    "text": "Novimus quidem librum eum, qui Augustini solilo- quia inscribitur, ab Augustino Hipponensi Ep scopo,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
