    "work_id": "oglt-pl/pseudo-augustinus/pl47_6_sol",
    "canonical_ref": "PL47.SOL.2.s19",
    "language": "lat",
    "text": "per me nihil sum, nisi mors, et abyssus tenebrosa, et imperfecta.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
