  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s28",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s28",
    "language": "lat",
    "text": "Ecce sancto evangelista narrante cognovimus Christum Dei Filium verum ho- minem natum, Christum Dei Filium veraciter cir- cumcisum,",
