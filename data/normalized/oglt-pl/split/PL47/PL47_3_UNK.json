    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s27",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s27",
    "language": "lat",
    "text": "ex hodierna evangelica lectione veritatem Testamenti Veteris de- fendamus, ut ex hoc et Veteris et Novi Deum unum manifestissime comprobemus.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
