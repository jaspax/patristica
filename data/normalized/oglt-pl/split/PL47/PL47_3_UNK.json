    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s4",
    "language": "lat",
    "text": "in quo pro nobis humi- litatem veræ carnis, ve(??)æque mortis, non coactus ne- cessitate sed bonitate miseratus assumpsit.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
