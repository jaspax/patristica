    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s17",
    "language": "lat",
    "text": "et idem pro se sacrificium præcepit offerri, qui sine peccato pro nostris venerat impietatibus im- molari.",
