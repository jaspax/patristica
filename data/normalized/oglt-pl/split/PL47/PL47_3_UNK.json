    "canonical_ref": "PL47.UNK.s3",
    "language": "lat",
    "text": "Proinde, fratres, quantum audivimus Dominum Jesum Christum pro nobis misericorditer humiliatum, tanto magis agnoscamus ineffabiliter gloriosum, in quo namque suam circa nos insuperabilem charitatem Dei unigenitus evidenter ostendit,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
