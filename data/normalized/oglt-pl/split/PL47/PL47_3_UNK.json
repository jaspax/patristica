    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s24",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s24",
    "language": "lat",
    "text": "nec victimam de carnibus animalium Deo vivo et vero priscis temporibus immolatam, nec sabbatum ex Dei præcepto ac voluntate servatum, nec Domino templum, Deo jubente, fabricatum;",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
