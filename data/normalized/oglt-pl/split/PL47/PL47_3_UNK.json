    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s22",
    "language": "lat",
    "text": "Nam cum Veteris Testamenti deifi- cam miser execratur historiam, in Novo Testamento ipse sibi denegat utique medicinam.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s23",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s23",
    "language": "lat",
    "text": "Non vult enim eredere humanam carnem a Dea plasmatam, neque circumcisionem carnis imperatam a Deo nostro san- ctis patribus,",
