    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s5",
    "language": "lat",
    "text": "Quid enim boni feceramus, fratres, ut tantum nobis beneficium præstaretur?",
