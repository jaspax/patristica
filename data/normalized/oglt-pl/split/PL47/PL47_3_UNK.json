      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s20",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s20",
    "language": "lat",
    "text": "vel audimus, historiam primum veram esse sine dubitatione credamus, deinde in historica veritate spiritualem quoque intelligentiam requiramus. Cum enim divinæ textus historiæ verus esse creditur,.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
