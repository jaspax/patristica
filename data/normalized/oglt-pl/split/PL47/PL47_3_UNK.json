    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s6",
    "language": "lat",
    "text": "Quæ nostra bona merita fuerunt ut uni- genitus Dei homo fleri dignaretur, ut Altissimus im- molaretur,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s7",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s7",
    "language": "lat",
    "text": "ut indeficiens Angelorum panis fœmineis uberibus lactaretur, ut sæculorum rex contumeliis afficeretur, ut vita æterna mori patientissime digna- retur?",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 408,
    "date_range": [
      386,
      430
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "oglt-pl/augustinus/pl47_3_unk#PL47.UNK.s8",
    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s8",
    "language": "lat",
    "text": "Attende igitur, homo, tantæ benignitatis digna- tionem, ut gratiarum persolvas humiliter actionem.",
