    "work_id": "oglt-pl/augustinus/pl47_3_unk",
    "canonical_ref": "PL47.UNK.s18",
    "language": "lat",
    "text": "Considera igitur, homo, quid debeas excelso Creatori tuo, humiliato Redemptori tuo.",
