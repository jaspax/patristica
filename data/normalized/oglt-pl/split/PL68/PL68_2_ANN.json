    "work_id": "oglt-pl/mappinius-remensis/pl68_2_ann",
    "canonical_ref": "PL68.ANN.5.s21",
    "language": "lat",
    "text": "Atque utinam, ut praefati sumus, cha­ ritate sua dente ac pagina decurrente, vestram nobis patefieri decrevissetis animorum molestiam !",
