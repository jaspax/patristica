    "canonical_ref": "PL68.ANN.5.s20",
    "language": "lat",
    "text": "quia amaritudo vestra dul­ cedo nostra esse non poterit; nec abjectio vestra absque nostra dejectione constabit; et venera­ tio vobis debita impensa a nobis non dignoscitur procul posita.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 542,
    "date_range": [
      535,
