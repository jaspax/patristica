    "work_id": "oglt-pl/mappinius-remensis/pl68_2_ann",
    "canonical_ref": "PL68.ANN.5.s1",
    "language": "lat",
    "text": "Evangelicæ lectionis doctrina testatur regnum in se divisum stare non posse (Matth. XII).",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 542,
    "date_range": [
