    "work_id": "oglt-pl/mappinius-remensis/pl68_2_ann",
    "canonical_ref": "PL68.ANN.5.s19",
    "language": "lat",
    "text": "Quanquam parere nos regiis praeceptis ia bonis rebus et conveniat et libeat, tamen non vestris minus scriptis, si studio charitalis, non supercilio dirigantur despectionis;",
    "chunk_index": 23,
    "context_before": null,
