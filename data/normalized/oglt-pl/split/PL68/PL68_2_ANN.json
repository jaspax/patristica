    "work_id": "oglt-pl/mappinius-remensis/pl68_2_ann",
    "canonical_ref": "PL68.ANN.5.s18",
    "language": "lat",
    "text": "quia pari modo, si nobis aliquid simile, quod in posterum arbitramur posse fieri, contigisset, statim ad vestram fraternitalem scripta direxissemus, ut nos congruo tempore vel loco coram positi vide­ remus.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 542,
    "date_range": [
      535,
      550
    ],
    "date_confidence": "approximate",
