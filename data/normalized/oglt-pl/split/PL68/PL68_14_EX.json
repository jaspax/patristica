    "work_id": "oglt-pl/aurelianus-arelatensis/pl68_14_ex",
    "canonical_ref": "PL68.EX.2.s7",
    "language": "lat",
    "text": "Quia cum omnes generaliter bono cordis inclyti perfruantur, nos tamen, etsi exigua portio ob- sequii vestri, plenitudinem nobis principalis iudul- gentiæ ad integrum vindicamus.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 548,
    "date_range": [
      546,
