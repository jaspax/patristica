    "work_id": "oglt-pl/aurelianus-arelatensis/pl68_14_ex",
    "canonical_ref": "PL68.EX.2.s2",
    "language": "lat",
    "text": "Hinc præcique quod ambientibus cunctis celsitudinem vestram, nec metum trahunt ex privilegio culminis, nec repulsam metuunt de præjudicio tarditatis.",
    "chunk_index": 3,
    "context_before": null,
