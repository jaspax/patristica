    "work_id": "oglt-pl/aurelianus-arelatensis/pl68_14_ex",
    "canonical_ref": "PL68.EX.2.s5",
    "language": "lat",
    "text": "Hæc ergo ex parte amo­ ris nostri fiduciam, Princeps optime, metieris, cum ministeriis tuis nec territi pro tarditate subtrahi­ mur, nec verecundia pauperis ingenii refraudamur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 548,
    "date_range": [
      546,
      551
    ],
    "date_confidence": "approximate",
