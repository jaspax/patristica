    "canonical_ref": "PL68.EX.2.s8",
    "language": "lat",
    "text": "Etenim cum de te loquimur, adest gratia, etsi eloquentia deest, et solo ornatui nostro materia sufficit, quanquam doctrina non adsit.",
    "chunk_index": 9,
    "context_before": null,
