    "work_id": "oglt-pl/aurelianus-arelatensis/pl68_14_ex",
    "canonical_ref": "PL68.EX.2.s6",
    "language": "lat",
    "text": "Suscipe igitur benigne devotionis studio tirocinia famulantum et gremia veniae largioris expande sup­ plicibus.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 548,
    "date_range": [
      546,
