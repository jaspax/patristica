    "work_id": "oglt-pl/aurelianus-arelatensis/pl68_14_ex",
    "canonical_ref": "PL68.EX.2.s3",
    "language": "lat",
    "text": "Vestra enim erectio ita solemnis est, ut etiam hu­ milium amore tangotur, ac dignitatum cumulum onerata fastigia vernularum adhuc rudium primiti­ vis cultibus præsumantur.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 548,
    "date_range": [
      546,
      551
    ],
