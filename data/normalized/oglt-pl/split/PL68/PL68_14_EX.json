    "work_id": "oglt-pl/aurelianus-arelatensis/pl68_14_ex",
    "canonical_ref": "PL68.EX.2.s4",
    "language": "lat",
    "text": "Novis namque nunc stu­ diis in obsequia religiosi principis informamus, et cum testimonio p rfectæ dilectionis ad præsentiam sacratae metitis admittimur.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 548,
    "date_range": [
      546,
      551
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
