    "work_id": "oglt-pl/eraclius-presbyter/pl39_2_ser",
    "canonical_ref": "PL39.SER.s11",
    "language": "lat",
    "text": "Quidquid enim in hoc viro miramur, veneramur, amplectimur, tunc creditur vere a nobis amari, si non pigeat imitari.",
