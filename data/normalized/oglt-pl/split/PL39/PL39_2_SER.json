    "work_id": "oglt-pl/eraclius-presbyter/pl39_2_ser",
    "canonical_ref": "PL39.SER.s15",
    "language": "lat",
    "text": "Atque in ommibus viis Domini, qui potest, ambulet cum illo ; et qui non potest, discat ab illo.",
