    "work_id": "oglt-pl/eraclius-presbyter/pl39_2_ser",
    "canonical_ref": "PL39.SER.s14",
    "language": "lat",
    "text": "Qui potest, apprehen­ dat ejus scientiam : qui nou potest, imitetur ejus pa­ tientiam.",
