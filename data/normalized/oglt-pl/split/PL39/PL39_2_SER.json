    "work_id": "oglt-pl/eraclius-presbyter/pl39_2_ser",
    "canonical_ref": "PL39.SER.s13",
    "language": "lat",
    "text": "Qui potest, assequatur ejus eloquentiam : qui non potest, teneat continen­ tiam. Qui potest, impleat ejus auctoritatem : qui non potest, sectetur humilitatem.",
