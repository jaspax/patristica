    "work_id": "scripture/kjv/2john",
    "canonical_ref": "2John.1.8",
    "language": "eng",
    "text": "Look to yourselves, that we lose not those things which we have wrought, but that we receive a full reward.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
