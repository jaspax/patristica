    "work_id": "scripture/kjv/2john",
    "canonical_ref": "2John.1.4",
    "language": "eng",
    "text": "I rejoiced greatly that I found of thy children walking in truth, as we have received a commandment from the Father.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
