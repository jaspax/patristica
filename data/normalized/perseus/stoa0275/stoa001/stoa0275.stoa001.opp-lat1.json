[
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s1",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s1",
    "language": "lat",
    "text": "Inter carnis alimenta, benedicti martyres designati, quae vobis et domina mater ecclesia de uberibus suis et singuli fratres de opibus suis propriis in carcerem subministrant,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s2",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s2",
    "language": "lat",
    "text": "capite aliquid et a nobis, quod faciat ad spiritum quoque educandum. Carnem enim saginari et spiritum esurire non prodest.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s3",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s3",
    "language": "lat",
    "text": "Immo si quod infirmum est curatur, aeque quod infirmius est neglegi non debet. Nec tantus ego sum, ut vos alloquar.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s4",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s4",
    "language": "lat",
    "text": "Verumtamen et gladiatores perfectissimos non tantum magistri et praepositi sui, sed etiam idiotae et supervacue quique adhortantur de longinquo, ut saepe de ipso populo dictata suggesta profuerint.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s5",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s5",
    "language": "lat",
    "text": "Inprimis ergo, benedicti, nolite contristare spiritum sanctum, qui vobiscum introiit carcerem.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s6",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s6",
    "language": "lat",
    "text": "Si enim non vobiscum nunc introisset, nec vos illic hodie fuissetis. Et ideo date operam, ut illic vobiscum perseveret: ita vos inde perducat ad dominum.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s7",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s7",
    "language": "lat",
    "text": "Domus quidem diaboli est et carcer, in qua familiam suam continet. Sed vos ideo in carcerem pervenistis, ut illum etiam in domo sua conculcetis.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s8",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s8",
    "language": "lat",
    "text": "Iam enim foris congressi conculcaveratis. Non ergo dicat: In meo sunt, temptabo illos vilibus odiis, defectionibus aut inter se dissensionibus.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s9",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s9",
    "language": "lat",
    "text": "Fugiat conspectum vestrum et in ima sua deliteseat contractus et torpens, tamquam coluber exeantatus aut effumigatus.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s10",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s10",
    "language": "lat",
    "text": "Nec illi tam bene sit in suo regno, ut vos commitat, sed inveniat munitos et concordia armatos, quia pax vestra bellum est illi.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s11",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s11",
    "language": "lat",
    "text": "Quam pacem quidam in ecclesia non habentes a martyribus in earcere exorare consueverunt.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.1.s12",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.1.s12",
    "language": "lat",
    "text": "Et ideo eam propterea in vobis habere et fovere et custodire debetis, ut, si forte, et aliis praestare possitis.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s1",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s1",
    "language": "lat",
    "text": "Cetera aeque animi impedimenta usque ad limen carceris deduxerint vos, quousque et parentes vestri.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s2",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s2",
    "language": "lat",
    "text": "Exinde segregati estis ab ipso mundo, quanto magis a saeculo rebusque eius? Nec hoc vos consternet, quod segregati estis a mundo.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s3",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s3",
    "language": "lat",
    "text": "Si enim recogitemus ipsum magis mundum carcerem esse, exisse vos e carcere quam in carcerem introisse intellegemus.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s4",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s4",
    "language": "lat",
    "text": "Maiores tenebras habet mundus, quae hominum praecordia excaecant. Graviores catenas induit mundus, quae ipsas animas hominum constringunt.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s5",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s5",
    "language": "lat",
    "text": "Peiores immunditias expirat mundus, libidines hominum. Plures postremo mundus reos continet, scilicet universum hominum genus.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s6",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s6",
    "language": "lat",
    "text": "Iudicia denique non proconsulis, sed dei sustinet. Quo vos, benedicti, de carcere in custodiarium, si forte, translatos existimetis.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s7",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s7",
    "language": "lat",
    "text": "Habet tenebras, sed lumen estis ipsi. Habet vincula, sed vos soluti deo estis. Triste illic expirat, sed vos odor estis suavitatis.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s8",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s8",
    "language": "lat",
    "text": "Iudex expectatur, sed vos estis de iudicibus ipsis iudicaturi. Contristetur illi qui fructum saeculi suspirat.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s9",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s9",
    "language": "lat",
    "text": "Christianus etiam extra carcerem saeculo renuntiavit, in carcere autem etiam carceri. Nihil interest, ubi sitis in saeculo, qui extra saeculum estis.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s10",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s10",
    "language": "lat",
    "text": "Et si aliqua amisistis vitae gaudia, negotiatio est aliquid amittere, ut maiora lucreris. Nihil adhuc dico de praemio, ad quod deus martyres invitat.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s11",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s11",
    "language": "lat",
    "text": "Ipsam interim conversationem saeculi et carceris comparemus, si non plus in carcere spiritus acquirit, quam caro amittit.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s12",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s12",
    "language": "lat",
    "text": "Immo et quae iusta sunt caro non amittit per curam ecclesiae et agapen fratrum, et insuper quae semper utilia fidei, spiritus adipiscitur.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s13",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s13",
    "language": "lat",
    "text": "Non vides alienos deos, non imaginibus eorum incurris, non sollemnes nationum dies ipsa commixtione participas, non nidoribus spurcis verberaris,",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s14",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s14",
    "language": "lat",
    "text": "non clamoribus spectaculorum, atrocitate vel furore vel impudicitia celebrantium caederis, non in loca libidinum publicarum oculi tui impingunt,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s15",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s15",
    "language": "lat",
    "text": "vacas a scandalis, a temptationibus, a recordationibus malis, iam et a persecutione. Hoc praestat carcer Christiano, quod eremus prophetis.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s16",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s16",
    "language": "lat",
    "text": "Ipse dominus in secessu frequentius agebat, ut liberius oraret, ut saeculo cederet: gloriam denique suam discipulis in solitudine demonstravit.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s17",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s17",
    "language": "lat",
    "text": "Auferamus carceris nomen, secessum vocemus. Etsi corpus includitur, etsi caro detinetur, omnia spiritui patent.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s18",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s18",
    "language": "lat",
    "text": "Vagare spiritu, spatiare spiritu et non stadia opaca aut porticus longas proponens tibi, sed illam viam, quae ad deum ducit.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s19",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s19",
    "language": "lat",
    "text": "Quotiens eam spiritu deambulaveris, totiens in carcere non eris.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s20",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s20",
    "language": "lat",
    "text": "Nihil crus sentit in nervo, cum animus in caelo est. Totum hominem animus circumfert et, quo velit, transfert.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.2.s21",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.2.s21",
    "language": "lat",
    "text": "Ubi autem erit cor tuum, illic erit et thesaurus tuus. Ibi ergo sit cor nostrum, ubi volumus habere thesaurum.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa001/opp-lat1#stoa0275.stoa001.3.s1",
    "work_id": "perseus/stoa0275/stoa001/opp-lat1",
    "canonical_ref": "stoa0275.stoa001.3.s1",
    "language": "lat",
    "text": "Sit nunc, benedicti, carcer etiam Christianis molestus. Vocati sumus ad militiam dei vivi iam tunc, cum in sacramenti verba respondemus.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
