    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.5.s8",
    "language": "lat",
    "text": "Parce ergo tibi, si non nobis. Parce Carthagini, si non tibi.",
    "chunk_index": 72,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
