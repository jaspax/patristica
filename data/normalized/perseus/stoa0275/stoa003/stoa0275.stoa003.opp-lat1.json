    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.5.s5",
    "language": "lat",
    "text": "Hoc si placuerit et hic fieri, quid facies de tantis milibus hominum, tot viris ac feminis, omnis sexus, omnis aetatis, omnis dignitatis, offerentibus se tibi?",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
