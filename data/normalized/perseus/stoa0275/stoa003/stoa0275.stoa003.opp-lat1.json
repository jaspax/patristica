    "canonical_ref": "stoa0275.stoa003.5.s9",
    "language": "lat",
    "text": "Parce provinciae, quae visa intentione tua obnoxia facta est concussionibus et militum et inimicorum suorum cuiusque. Magistrum neminem habemus, nisi deum solum.",
    "chunk_index": 73,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
