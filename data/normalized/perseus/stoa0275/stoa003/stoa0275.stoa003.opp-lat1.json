    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s7",
    "language": "lat",
    "text": "Nam et sol ille in conventu Uticensi extincto paene lumine adeo portentum fuit, ut non potuerit ex ordinario deliquio hoc pati positus in suo hypsomate et domicilio.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
