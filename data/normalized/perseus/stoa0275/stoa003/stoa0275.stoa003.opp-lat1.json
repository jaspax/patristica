    "canonical_ref": "stoa0275.stoa003.5.s6",
    "language": "lat",
    "text": "Quantis ignibus, quantis gladiis opus erit? Quid ipsa Carthago passura est, decimanda a te, cum propinquos, cum contubernales suos illic unusquisque cognoverit,",
    "chunk_index": 70,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
