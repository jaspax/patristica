    "canonical_ref": "stoa0275.stoa003.5.s7",
    "language": "lat",
    "text": "cum viderit illic fortasse et tui ordinis viros et matronas et principales quasque personas et amicorum tuorum vel propinquos vel amicos?",
    "chunk_index": 71,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
