  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s8",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s8",
    "language": "lat",
    "text": "Habetis astrologos. Possumus aeque et exitus quorundam praesidum tibi proponere, qui in fine vitae suae recordati sunt deliquisse, quod vexassent Christianos.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s9",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s9",
    "language": "lat",
    "text": "Vigellius Saturninus, qui primus hic gladium in nos egit, lumina amisit.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s10",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s10",
    "language": "lat",
    "text": "Claudius Lucius Herminianus in Cappadocia, cum, indigne ferens uxorem suam ad hanc sectam transisse, Christianos crudeliter tractasset,",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s11",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s11",
    "language": "lat",
    "text": "solusque in praetorio suo vastatus peste convivis vermibus ebullisset, Nemo sciat, aiebat, ne gaudeant Christiani aut sperent Christianae.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s12",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s12",
    "language": "lat",
    "text": "Postea cognito errore suo, quod tormentis quosdam a proposito sue excidere fecisset, paene Christianus decessit.",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s13",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s13",
    "language": "lat",
    "text": "Caecilius Capella in illo exitu By(??)mtinor, Christiani gaudete (??)",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
