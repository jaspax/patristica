[
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s1",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s1",
    "language": "lat",
    "text": "Nos quidem neque expavescimus neque pertimescimus ea quae ab ignorantibus patimur, cum ad hanc sectam utique suscepta condicione eius pacti venerimus,",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s2",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s2",
    "language": "lat",
    "text": "ut etiam animas nostras auctorati in has pugnas accedamus, ea quae deus repromittit consequi optantes et ea quae diversae vitae comminatur pati timentes.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s3",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s3",
    "language": "lat",
    "text": "Denique cum omni saevitia vestra concertamus etiam ultro erumpentes, magisque damnati quam absoluti gaudemus.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s4",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s4",
    "language": "lat",
    "text": "Itaque hunc libellum non nobis timentes misimus, sed vobis et omnibus inimicis nostris, nedum amicis.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s5",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s5",
    "language": "lat",
    "text": "Ita enim disciplina iubemur diligere inimicos quoque et orare pro iis qui nos persequuntur, ut haec sit perfecta et propria bonitas nostra, non communis.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s6",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s6",
    "language": "lat",
    "text": "Amicos enim diligere omnium est, inimicos autem solorum Christianorum. Qui ergo dolemus de ignorantia vestra, et miseremur erroris humani, et futura prospicimus,",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.1.s7",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.1.s7",
    "language": "lat",
    "text": "et signa eorum cottidie intentari videmus, necesse est vel hoc modo erumpere ad proponenda vobis ea quae palam non vultis audire.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s1",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s1",
    "language": "lat",
    "text": "Nos unum deum colimus, quem omnes naturaliter nostis, ad cuius fulgura et tonitrua contremiscitis, ad cuius beneficia gaudetis.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s2",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s2",
    "language": "lat",
    "text": "Ceteros et ipsi putatis deos esse quos nos daemonas scimus.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s3",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s3",
    "language": "lat",
    "text": "Tamen humani iuris et naturalis potestatis est unicuique quod putaverit colere, nec alii obest aut prodest alterius religio.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s4",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s4",
    "language": "lat",
    "text": "Sed nec religionis est cogere religionem, quae sponte suscipi debeat, non vi, cum et hostiae ab animo libenti expostulentur.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s5",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s5",
    "language": "lat",
    "text": "Ita etsi nos compuleritis ad sacrificandum, nihil praestabitis diis vestris. Ab invitis enim sacrificia non desiderabunt, nisi si contentiosi sunt; contentiosus autem deus non est.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s6",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s6",
    "language": "lat",
    "text": "Denique qui est verus, omnia sua ex aequo et profanis et suis praestat, ideoque et iudicium constituit aeternum de gratis et ingratis.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s7",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s7",
    "language": "lat",
    "text": "Tamen nos, quos sacrilegos existimatis, nec in furto umquam deprehendistis, nedum in sacrilegio.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s8",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s8",
    "language": "lat",
    "text": "Omnes autem, qui templa dispoliant et per deos iurant et eosdem colunt, et Christiani non sunt et sacrilegi tamen deprehenduntur.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s9",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s9",
    "language": "lat",
    "text": "Longum est, si retexamus, quibus aliis modis et derideantur et contemnantur omnes dii ab ipsis cultoribus suis.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s10",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s10",
    "language": "lat",
    "text": "Sic et circa maiestatem imperatoris infamamur, tamen numquam Albiniani nee Nigriani vel Cassiani inveniri potuerunt Christiani,",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s11",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s11",
    "language": "lat",
    "text": "sed idem ipsi qui per genios eorum in pridie usque iuraverant, qui pro salute eorum hostias et fecerant et voverant, qui Christianos saepe damnaverant, hostes eorum sunt reperti.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s12",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s12",
    "language": "lat",
    "text": "Christianus nullius est hostis, nedum imperatoris, quem sciens a deo suo constitui necesse est ut et ipsum diligat et revereatur et honoret et salvum velit cum toto Romano imperio, quousque saeculum stabit: tamdiu enim stabit.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s13",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s13",
    "language": "lat",
    "text": "Colimus ergo et imperatorem sic quomodo et nobis licet et ipsi expedit, ut hominem a deo secundum et quicquid est a deo consecutum et solo deo minorem.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s14",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s14",
    "language": "lat",
    "text": "Hoc et ipse volet. Sic enim omnibus maior est, dum solo vero deo minor est. Sic et ipsis diis maior eat, dum et ipsi in potestate sunt eius.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s15",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s15",
    "language": "lat",
    "text": "Itaque et sacrificamus pro salute imperatoris, sed deo nostro et ipsius, sed quomodo praecepit deus, pura prece.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s16",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s16",
    "language": "lat",
    "text": "Non enim eget deus, conditor universitatis, odoris aut sanguinis alicuius. Haec enim daemoniorum pabula sunt.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s17",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s17",
    "language": "lat",
    "text": "Daemones autem non tantum respuimus, verum et revincimus et cottidie traducimus et de hominibus expellimus, sicut plurimis notum est.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s18",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s18",
    "language": "lat",
    "text": "Ita nos magis oramus pro salute imperatoris, ab eo eam postulantes qui praestare potest.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s19",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s19",
    "language": "lat",
    "text": "Et utique ex disciplina patientiae divinae agere nos satis manifestum esse vobis potest, cum tanta hominum multitudo, pars paene maior civitatis cuiusque,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s20",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s20",
    "language": "lat",
    "text": "in silentio et modestia agimus, singuli forte noti magis quam omnes, nec aliunde noscibiles quam de emendatione vitiorum pristinorum.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.2.s21",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.2.s21",
    "language": "lat",
    "text": "Absit enim, ut indigne feramus ea nos pati quae optamus, aut ultionem a nobis aliquam machinemur, quam a deo expectamus.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s1",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s1",
    "language": "lat",
    "text": "Tamen, sicut supra diximus, doleamus necesse est, quod nulla civitas impune latura sit sanguinis nostri effusionem;",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s2",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s2",
    "language": "lat",
    "text": "sicut et sub Hilariano praeside, cum de areis sepulturarum nostrarum adclamassent: Areae non sint! areae ipsorum non fuerunt! Messes enim suas non egerunt.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s3",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s3",
    "language": "lat",
    "text": "Ceterum et imbres anni praeteriti quid commemoraverint genus humanum apparuit, cataclysmum scilicet et retro fuisse propter incredulitates et iniquitates hominum, et ignes,",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s4",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s4",
    "language": "lat",
    "text": "qui super moenia Carthaginis proxime pependerunt per noctem, quid minati sint, sciunt qui viderunt, et pristina tonitrua quid sonaverint, sciunt qui obduruerunt.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s5",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s5",
    "language": "lat",
    "text": "Omnia haec signa sunt imminentis irae dei, quam necesse est, quoquo modo possumus, ut et nuntiemus et praedicemus et deprecemur interim localem esse.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0275/stoa003/opp-lat1#stoa0275.stoa003.3.s6",
    "work_id": "perseus/stoa0275/stoa003/opp-lat1",
    "canonical_ref": "stoa0275.stoa003.3.s6",
    "language": "lat",
    "text": "Universalem enim et supremam suo tempore sentient qui exempla eius aliter interpretantur.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
