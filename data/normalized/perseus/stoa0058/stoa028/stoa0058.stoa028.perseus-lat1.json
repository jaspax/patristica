[
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s1",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s1",
    "language": "lat",
    "text": "quaero an pater et filius ac spiritus sanctus de diuinitate substantialiter praedicentur an alio quolibet modo;",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s2",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s2",
    "language": "lat",
    "text": "uiamque indaginis hinc arbitror esse sumendam, unde rerum omnium manifestum constat exordium, id est ab ipsis catholicae fidei fundamentis.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s3",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s3",
    "language": "lat",
    "text": "Si igitur interrogem, an qui dicitur pater substantia sit, respondetur esse substantia. Quod si quaeram, an filius substantia sit, idem dicitur.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s4",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s4",
    "language": "lat",
    "text": "Spiritum quoque sanctum substantiam esse nemo dubitauerit. Sed cum rursus colligo patrem filium spiritum sanctum, non plures sed una occurrit esse substantia.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s5",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s5",
    "language": "lat",
    "text": "Una igitur substantia trium nec separari ullo modo aut disiungi potest nec uelut partibus in unum coniuncta est, sed est una simpliciter.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s6",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s6",
    "language": "lat",
    "text": "Quaecumque igitur de diuina substantia praedicantur, ea tribus oportet esse communia;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s7",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s7",
    "language": "lat",
    "text": "idque signi erit quae sint quae de diuinitatis substantia praedicentur, quod quaecumque hoc modo dicuntur, de singulis in unum collectis tribus singulariter praedicabuntur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s8",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s8",
    "language": "lat",
    "text": "Hoc modo si dicimus: Pater deus est, filius deus est, spiritus sanctus deus est, pater filius ac spiritus sanctus unus deus.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s9",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s9",
    "language": "lat",
    "text": "Si igitur eorum una deitas una substantia est, licet dei nomen de diuinitate substantialiter praedicari.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s10",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s10",
    "language": "lat",
    "text": "Ita pater ueritas est, filius ueritas est, spiritus sanctus ueritas est; pater filius et spiritus sanctus non tres ueritates sed una ueritas est.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s11",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s11",
    "language": "lat",
    "text": "Si igitur una in his substantia una est ueritas, necesse est ueritatem substantialiter praedicari.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s12",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s12",
    "language": "lat",
    "text": "De bonitate de incommutabilitate de iustitia de omnipotentia ac de ceteris omnibus quae tam de singulis quam de omnibus singulariter praedicamus manifestum est substantialiter dici.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s13",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s13",
    "language": "lat",
    "text": "Vnde apparet ea quae cum in singulis separatim dici conuenit nec tamen in omnibus dici queunt, non substantialiter praedicari sed alio modo; qui uero iste sit, posterius quaeram.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s14",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s14",
    "language": "lat",
    "text": "Nam qui pater est, hoc uocabulum non transmittit ad filium neque ad spiritum sanctum.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s15",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s15",
    "language": "lat",
    "text": "Quo fit ut non sit substantiale nomen hoc inditum; nam si substantiale esset, ut deus ut ueritas ut iustitia ut ipsa quoque substantia, de ceteris diceretur.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s16",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s16",
    "language": "lat",
    "text": "Item filius solus hoc recipit nomen neque cum aliis iungit sicut in deo, sicut in ueritate, sicut in ceteris quae superius dixi.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s17",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s17",
    "language": "lat",
    "text": "Spiritus quoque non est idem qui pater ac filius. Ex his igitur intellegimus patrem ac filium ac spiritum sanctum non de ipsa diuinitate substantialiter dici sed alio quodam modo;",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s18",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s18",
    "language": "lat",
    "text": "si enim substantialiter praedicaretur, et de singulis et de omnibus singulariter diceretur.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s19",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s19",
    "language": "lat",
    "text": "Haec uero ad aliquid dici manifestum est; nam et pater alicuius pater est et filius alicuius filius est, spiritus alicuius spiritus.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s20",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s20",
    "language": "lat",
    "text": "Quo fit, ut ne trinitas quidem substantialiter de deo praedicetur; non enim pater trinitas (qui enim pater est,",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s21",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s21",
    "language": "lat",
    "text": "filius ac spiritus sanctus non est) nec trinitas filius nec trinitas spiritus sanctus secundum eundem modum, sed trinitas quidem in personarum pluralitate consistit, unitas uero in substantiae simplicitate.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s22",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s22",
    "language": "lat",
    "text": "Quod si personae diuisae sunt, substantia uero indiuisa sit, necesse est quod uocabulum ex personis originem capit id ad substantiam non pertinere;",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s23",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s23",
    "language": "lat",
    "text": "at trinitatem personarum diuersitas fecit, trinitas igitur non pertinet ad substantiam.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s24",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s24",
    "language": "lat",
    "text": "Quo fit ut neque pater neque filius neque spiritus sanctus neque trinitas de deo substantialiter praedicetur, sed ut dictum est ad aliquid.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s25",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s25",
    "language": "lat",
    "text": "Deus uero ueritas iustitia bonitas omnipotentia substantia inmutabilitas uirtus sapientia et quicquid huiusmodi excogitari potest substantialiter de diuinitate dicuntur.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa028/perseus-lat1#stoa0058.stoa028.1.s26",
    "work_id": "perseus/stoa0058/stoa028/perseus-lat1",
    "canonical_ref": "stoa0058.stoa028.1.s26",
    "language": "lat",
    "text": "Haec si se recte et ex fide habent, ut me instruas peto; aut si aliqua re forte diuersus es, diligentius intuere quae dicta sunt et fidem si poterit rationemque coniunge.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  }
]