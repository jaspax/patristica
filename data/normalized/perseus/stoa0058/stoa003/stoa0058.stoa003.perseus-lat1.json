[
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.s1",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.s1",
    "language": "lat",
    "text": "postulas, ut ex Hebdomadibus nostris eius quaestionis obscuritatem quae continet modum quo substantiae in eo quod sint bonae sint, cum non sint substantialia bona, digeram et paulo euidentius monstrem;",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.s2",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.s2",
    "language": "lat",
    "text": "idque eo dicis esse faciendum, quod non sit omnibus notum iter huiusmodi scriptionum. Tuus uero testis ipse sum quam haec uiuaciter fueris ante complexus.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.s3",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.s3",
    "language": "lat",
    "text": "Hebdomadas uero ego mihi ipse commentor potiusque ad memoriam meam speculata conseruo quam cuiquam participo quorum lasciuia ac petulantia nihil a ioco risuque patitur esse seiunctum.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.s4",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.s4",
    "language": "lat",
    "text": "1 Prohinc tu ne sis obscuritatibus breuitatis aduersus, quae cum sint arcani fida custodia tum id habent commodi, quod cum his solis qui digni sunt conloquuntur.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.s5",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.s5",
    "language": "lat",
    "text": "Vt igitur in mathematica fieri solet ceterisque etiam disciplinis, praeposui terminos regulasque quibus cuncta quae sequuntur efficiam.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.1.s1",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.1.s1",
    "language": "lat",
    "text": "I. Communis animi conceptio est enuntiatio quam quisque probat auditam. Harum duplex modus est.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.1.s2",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.1.s2",
    "language": "lat",
    "text": "Nam una ita communis est, ut omnium sit hominum, ueluti si hanc proponas:",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.1.s3",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.1.s3",
    "language": "lat",
    "text": "Si duobus aequalibus aequalia auferas, quae relinquantur aequalia esse, nullus id intellegens neget.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.1.s4",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.1.s4",
    "language": "lat",
    "text": "Alia uero est doctorum tantum, quae tamen ex talibus communis animi conceptionibus uenit, ut est:",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.1.s5",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.1.s5",
    "language": "lat",
    "text": "Quae incorporalia sunt, in loco non esse, et cetera; quae non uulgus sed docti comprobant.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.2",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.2",
    "language": "lat",
    "text": "II. Diuersum est esse et id quod est; ipsum enim esse nondum est, at uero quod est accepta essendi forma est atque consistit.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.3",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.3",
    "language": "lat",
    "text": "III. Quod est participare aliquo potest, sed ipsum esse nullo modo aliquo participat. Fit enim participatio cum aliquid iam est; est autem aliquid, cum esse susceperit.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.4",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.4",
    "language": "lat",
    "text": "IV. Id quod est habere aliquid praeterquam quod ipsum est potest; ipsum uero esse nihil aliud praeter se habet admixtum.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.5",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.5",
    "language": "lat",
    "text": "V. Diuersum est tantum esse aliquid et esse aliquid in eo quod est; illic enim accidens hic substantia significatum",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.6.s1",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.6.s1",
    "language": "lat",
    "text": "VI. Omne quod est 1 participate eo quod est esse ut sit; alio uero participat ut aliquid sit.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.6.s2",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.6.s2",
    "language": "lat",
    "text": "Ac per hoc id quod est participat eo quod est esse ut sit; est uero ut participet alio quolibet. VII. Omne simplex esse suum et id quod est unum habet.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.7",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.7",
    "language": "lat",
    "text": "VIII, Omni composito aliud est esse, aliud ipsum est.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.8",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.8",
    "language": "lat",
    "text": "IX. Omnis diuersitas discors, similitudo uero appetenda est; et quod appetit aliud, tale ipsum esse naturaliter ostenditur quale est illud hoc ipsum quod appetit.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.9",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.9",
    "language": "lat",
    "text": "Sufficiunt igitur quae praemisimus; a prudente uero rationis interprete suis unumquodque aptabitur argumentis.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s1",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s1",
    "language": "lat",
    "text": "Quaestio uero huiusmodi est. Ea quae sunt bona sunt; tenet enim communis sententia doctorum omne quod est ad bonum tendere, omne autem tendit ad simile.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s2",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s2",
    "language": "lat",
    "text": "Quae igitur ad bonum tendunt bona ipsa sunt. Sed quemadmodum bona sint, inquirendum est, utrumne participatione an substantia?",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s3",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s3",
    "language": "lat",
    "text": "Si participatione, per se ipsa nullo modo bona sunt; nam quod participatione album est, per se in eo quod ipsum est album non est. Et de ceteris qualitatibus eodem modo.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s4",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s4",
    "language": "lat",
    "text": "Si igitur participatione sunt bona, ipsa per se nullo modo bona sunt: non igitur ad bonum tendunt. Sed concessum est.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s5",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s5",
    "language": "lat",
    "text": "Non igitur participatione sunt bona sed substantia. Quorum uero substantia bona est, id quod sunt bona sunt; id quod sunt autem habent ex eo quod est esse.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s6",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s6",
    "language": "lat",
    "text": "Esse igitur ipsorum bonum est; omnium igitur rerum ipsum esse bonum est.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s7",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s7",
    "language": "lat",
    "text": "Sed si esse bonum est, ea quae sunt in eo quod sunt bona sunt idemque illis est esse quod boni esse; substantialia igitur bona sunt, quoniam non participant bonitatem.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s8",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s8",
    "language": "lat",
    "text": "Quod si ipsum esse in eis bonum est, non est dubium quin substantialia cum sint bona, primo sint bono similia ac per hoc hoc ipsum bonum erunt;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s9",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s9",
    "language": "lat",
    "text": "nihil enim illi praeter se ipsum simile est. Ex quo fit ut omnia quae sunt deus sint, quod dictu nefas est.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s10",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s10",
    "language": "lat",
    "text": "Non sunt igitur substantialia bona ac per hoc non in his est esse bonum; non sunt igitur in eo quod sunt bona.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.10.s11",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.10.s11",
    "language": "lat",
    "text": "Sed nec participant bonitatem; nullo enim modo ad bonum tenderent. Nullo modo igitur sunt bona.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s1",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s1",
    "language": "lat",
    "text": "Huic quaestioni talis poterit adhiberi solutio. Multa sunt quae cum separari actu non possunt, animo tamen et cogitatione separantur;",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s2",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s2",
    "language": "lat",
    "text": "ut cum triangulum uel cetera a subiecta materia nullus actu separat, mente tamen segregans ipsum triangulum proprietatemque eius piae ter materiam speculatur.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s3",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s3",
    "language": "lat",
    "text": "Amoueamus igitur primi boni praesentiam paulisper ex animo, quod esse quidem constat idque ex omnium doctorum indoctorumque sententia barbararumque gentium religionibus cognosci potest.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s4",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s4",
    "language": "lat",
    "text": "Hoc igitur paulisper amoto ponamus omnia esse quae sunt bona atque ea consideremus quemadmodum bona esse possent, si a primo bono minime defluxissent.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s5",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s5",
    "language": "lat",
    "text": "Hinc intueor aliud in eis esse quod bona sunt, aliud quod sunt. Ponatur enim una eademque substantia bona esse alba, grauis, rotunda.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s6",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s6",
    "language": "lat",
    "text": "Tunc aliud esset ipsa illa substantia, aliud eius rotunditas, aliud color, aliud bonitas;",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s7",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s7",
    "language": "lat",
    "text": "nam si haec singula idem essent quod ipsa substantia, idem esset grauitas quod color, quod bonum et bonum quod grauitas—quod fieri natura non sinit.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s8",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s8",
    "language": "lat",
    "text": "Aliud igitur tunc in eis esset esse, aliud aliquid esse, ac tunc bona quidem essent, esse tamen ipsum minime haberent bonum.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s9",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s9",
    "language": "lat",
    "text": "Igitur si ullo modo essent, non a bono ac bona essent ac non idem essent quod bona, sed eis aliud esset esse aliud bonis esse.",
    "chunk_index": 38,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s10",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s10",
    "language": "lat",
    "text": "Quod si nihil omnino aliud essent nisi bona neque grauia neque colorata neque spatii dimensione distenta nec ulla in eis qualitas esset, nisi tantum bona essent,",
    "chunk_index": 39,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s11",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s11",
    "language": "lat",
    "text": "tunc non res sed rerum uideretur esse principium nec potius uiderentur, sed uideretur; unum enim solumque est huiusmodi, quod tantum bonum aliudque nihil sit.",
    "chunk_index": 40,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s12",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s12",
    "language": "lat",
    "text": "Quae quoniam non sunt simplicia, nec esse omnino poterant, nisi ea id quod solum bonum est esse uoluisset.",
    "chunk_index": 41,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s13",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s13",
    "language": "lat",
    "text": "Idcirco quoniam esse eorum a boni uoluntate defluxit, bona esse dicuntur.",
    "chunk_index": 42,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s14",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s14",
    "language": "lat",
    "text": "Primum enim bonum, quoniam est, in eo quod est bonum est; secundum uero bonum, quoniam ex eo fluxit cuius ipsum esse bonum est, ipsum quoque bonum est.",
    "chunk_index": 43,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s15",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s15",
    "language": "lat",
    "text": "Sed ipsum esse omnium rerum ex eo fluxit quod est primum bonum et quod bonum tale est ut recte dicatur in eo quod est esse bonum.",
    "chunk_index": 44,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s16",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s16",
    "language": "lat",
    "text": "Ipsum igitur eorum esse bonum est; tunc enim in eo. Qua in re soluta quaestio est.",
    "chunk_index": 45,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s17",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s17",
    "language": "lat",
    "text": "Idcirco enim licet in eo quod sint bona sint, non sunt tamen similia primo bono, quoniam non quoquo modo sint res ipsum esse earum bonum est,",
    "chunk_index": 46,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s18",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s18",
    "language": "lat",
    "text": "sed quoniam non potest esse ipsum esse rerum, nisi a primo esse defluxerit, id est bono; idcirco ipsum esse bonum est nec est simile ei a quo est.",
    "chunk_index": 47,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s19",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s19",
    "language": "lat",
    "text": "Illud enim quoquo modo sit bonum est in eo quod est; non enim aliud est praeterquam bonum.",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s20",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s20",
    "language": "lat",
    "text": "Hoc autem nisi ab illo esset, bonum fortasse esse posset, sed bonum in eo quod est esse non posset.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s21",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s21",
    "language": "lat",
    "text": "Tunc enim participaret forsitan bono; ipsum uero esse quod non haberent a bono, bonum habere non possent.",
    "chunk_index": 50,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s22",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s22",
    "language": "lat",
    "text": "Igitur sublato ab his bono primo mente et cogitatione, ista licet essent bona, tamen in eo quod essent bona esse non possent, et quoniam actu non potuere exsistere,",
    "chunk_index": 51,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s23",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s23",
    "language": "lat",
    "text": "nisi illud ea quod uere bonum est produxisset, idcirco et esse eorum bonum est et non est simile substantiali bono id quod ab eo fluxit;",
    "chunk_index": 52,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s24",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s24",
    "language": "lat",
    "text": "et nisi ab eo fluxissent, licet essent bona, tamen in eo quod sunt bona esse non possent, quoniam et praeter bonum et non ex bono essent, cum illud ipsum bonum primum est et ipsum esse sit et ipsum bonum et ipsum esse bonum.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s25",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s25",
    "language": "lat",
    "text": "At non etiam alba in eo quod sunt alba esse oportebit ea quae alba sunt, quoniam ex uoluntate dei fluxerunt ut essent, alba minime.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s26",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s26",
    "language": "lat",
    "text": "Aliud est enim esse, aliud albis esse; hoc ideo, quoniam qui ea ut essent effecit bonus quidem est, minime uero albus.",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s27",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s27",
    "language": "lat",
    "text": "Voluntatem igitur boni comitatum est ut essent bona in eo quod sunt;",
    "chunk_index": 56,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s28",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s28",
    "language": "lat",
    "text": "uoluntatem uero non albi non est comitata talis eius quod est proprietas ut esset album in eo quod est; neque enim ex albi uoluntate defluxerunt.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s29",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s29",
    "language": "lat",
    "text": "Itaque quia uoluit esse ea alba qui erat non albus, sunt alba tantum; quia uero uoluit ea esse bona qui erat bonus, sunt bona in eo quod sunt.",
    "chunk_index": 58,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s30",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s30",
    "language": "lat",
    "text": "Secundum hanc igitur rationem cuncta oportet esse iusta, quoniam ipse iustus est qui ea esse uoluit?",
    "chunk_index": 59,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s31",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s31",
    "language": "lat",
    "text": "Ne hoc quidem. Nam bonum esse essentiam, iustum uero esse actum respicit.",
    "chunk_index": 60,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s32",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s32",
    "language": "lat",
    "text": "Idem autem est in eo esse quod agere; idem igitur bonum esse quod iustum. Nobis uero non est idem esse quod agere; non enim simplices sumus.",
    "chunk_index": 61,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s33",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s33",
    "language": "lat",
    "text": "Non est igitur nobis idem bonis esse quod iustis, sed idem nobis est esse omnibus in eo quod sumus. Bona igitur omnia sunt, non etiam iusta.",
    "chunk_index": 62,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/stoa0058/stoa003/perseus-lat1#stoa0058.stoa003.1.11.s34",
    "work_id": "perseus/stoa0058/stoa003/perseus-lat1",
    "canonical_ref": "stoa0058.stoa003.1.11.s34",
    "language": "lat",
    "text": "Amplius bonum quidem generale est, iustum uero speciale nec species descendit in omnia. Idcirco alia quidem iusta alia aliud omnia bona.",
    "chunk_index": 63,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  }
]