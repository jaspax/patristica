[
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.1.s1",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.1.s1",
    "language": "grc",
    "text": "Ἡσυχίαν μὲν λόγοις ἐπιτήδευε, ἡσυχίαν δὲ ἔργοις, ὡσαύτως δὲ ἐν γλώττῃ καὶ βαδίσματι· σφοδρότητα δὲ ἀπόφευγε προπετῆ·",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.1.s2",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.1.s2",
    "language": "grc",
    "text": "οὕτως γὰρ ὁ νοῦς διαμενεῖ βέβαιος, καὶ οὐχ ὑπὸ τῆς σφοδρότητος ταραχώδης γενόμενος ἀσθενὴς ἔσται καὶ βραχὺς περὶ φρόνησιν καὶ σκοτεινὸν ὁρῶν οὐδὲ ἡττηθήσεται μὲν γαστριμαργίας,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.1.s3",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.1.s3",
    "language": "grc",
    "text": "ἡττηθήσεται δὲ ἐπιζέοντος θυμοῦ, ἡττηθήσεται δὲ τῶν ἄλλων παθῶν, ἕτοιμον αὐτοῖς ἅρπαγμα προκείμενος.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.1.s4",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.1.s4",
    "language": "grc",
    "text": "τὸν γὰρ νοῦν δεῖ τῶν παθῶν ἐπικρατεῖν ὑψηλὸν ἐπὶ ἡσύχου θρόνου καθήμενον ἀφορῶντα πρὸς θεόν.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.1.s5",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.1.s5",
    "language": "grc",
    "text": "μηδὲν ὀξυχολίας ἀνάπλεος ἔσο περὶ ὀργάς, μηδὲ νωθρὸς ἐν λόγοις, μηδὲ ἐν βαδίσμασιν ὄκνου πεπληρωμένος, ἵνα σοι ῥυθμὸς ἀγαθὸς τὴν ἡσυχίαν κοσμῇ καὶ θειῶδές τι καὶ ἱερὸν τὸ σχῆμα φαίνηται.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.1.s6",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.1.s6",
    "language": "grc",
    "text": "φυλάττου δὲ καὶ τῆς ὑπερηφανίας τὰ σύμβολα, σχῆμα ὑψαυχενοῦν καὶ κεφαλὴν ἐξηρμένην καὶ βῆμα ποδῶν ἁβρὸν καὶ μετέωρον.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s1",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s1",
    "language": "grc",
    "text": "Ἤπιά σοι πρὸς τοὺς ἀπαντῶντας ἔστω τὰ ῥήματα, καὶ προσηγορίαι γλυκεῖαι· αἰδὼς δὲ πρὸς γυναῖκας καὶ βλέμμα τετραμμένον εἰς γῆν.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s2",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s2",
    "language": "grc",
    "text": "λάλει δὲ περιεσκεμμένως ἅπαντα, καὶ τῇ φωνῇ τὸ χρήσιμον ἀποδίδου, τῇ χρείᾳ τῶν ἀκουόντων τὸ φθέγμα μετρῶν, ἄχρι ἂν καὶ ἐξάκουστον ᾖ,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s3",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s3",
    "language": "grc",
    "text": "καὶ μήτε διαφεῦγον τὴν ἀκοὴν τῶν παρόντων ὑπὸ σμικρότητος, μήτε ὑπερβάλλον μείζονι τῇ κραυγῇ. φυλάττου δὲ ὅπως μηδέν ποτε λαλήσῃς ὃ μὴ προεσκέψω καὶ προενόησας·",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s4",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s4",
    "language": "grc",
    "text": "μηδὲ προχείρως καὶ μεταξὺ τῶν τοῦ ἑτέρου λόγων ὑπόβαλλε τοὺς σαυτοῦ δεῖ γὰρ ἀνὰ μέρος ἀκούειν καὶ διαλέγεσθαι, χρόνῳ μερίζοντα λόγον καὶ σιωπήν·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s5",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s5",
    "language": "grc",
    "text": "μάνθανε δὲ ἀσμένως, καὶ ἀφθόνως δίδασκε, μηδὲ ὑπὸ φθόνου ποτὲ σοφίαν ἀποκρύπτου πρὸς τοὺς ἑτέρους, μηδὲ μαθήσεως ἀφίστασο δι’ αἰδῶ.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s6",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s6",
    "language": "grc",
    "text": "ὕπεικε πρεσβυτέροις ἴσα πατράσιν· τίμα θεράποντας θεοῦ· κάταρχε σοφίας καὶ ἀρετῆς. μηδὲ ἐριστικὸς ἔσο πρὸς τοὺς φίλους, μηδὲ χλευαστὴς κατ’ αὐτῶν καὶ γελωτοποιός·",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.2.s7",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.2.s7",
    "language": "grc",
    "text": "ψεῦδος δὲ καὶ δόλον καὶ ὕβριν ἰσχυρῶς παραίτου· σὺν εὐφημίᾳ δὲ φέρε καὶ τὸν ὑπερήφανον καὶ ὑβριστὴν ὡς πρᾷός τε καὶ μεγαλόψυχος ἀνήρ.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.3.s1",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.3.s1",
    "language": "grc",
    "text": "Κείσθω δέ σοι πάντα εἰς θεὸν καὶ ἔργα καὶ λόγοι, καὶ πάντα ἀνάφερε Χριστῷ τὰ σαυτοῦ, καὶ πυκνῶς ἐπὶ θεὸν τρέπε τὴν ψυχήν,",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.3.s2",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.3.s2",
    "language": "grc",
    "text": "καὶ τὸ νόημα ἐπέρειδε τῇ Χριστοῦ δυνάμει ὥσπερ ἐν λιμένι τινὶ τῷ θείῳ φωτὶ τοῦ σωτῆρος ἀναπαυόμενον ἀπὸ πάσης λαλιᾶς τε καὶ πράξεως.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.3.s3",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.3.s3",
    "language": "grc",
    "text": "καὶ μεθ’ ἡμέραν πολλάκις μὲν μὲν ἀνθρώποις κοίνου τὴν σεαυτοῦ φρόνησιν, θεῷ δὲ ἐπὶ πλεῖστον ἐν νυκτὶ ὁμοίως καὶ ἐν ἡμέρᾳ·",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.3.s4",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.3.s4",
    "language": "grc",
    "text": "μὴ γὰρ ὕπνος σε ἐπικρατείτω πολὺς τῶν πρὸς θεὸν εὐχῶν τε καὶ ὕμνων· θανάτῳ γὰρ ὁ μακρὸς ὕπνος ἐφάμιλλος.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.3.s5",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.3.s5",
    "language": "grc",
    "text": "μέτοχος Χριστοῦ ἀεὶ καθίστασο τοῦ τὴν θείαν αὐγὴν καταλάμποντος ἐξ οὐρανοῦ· εὐφροσύνη γὰρ ἔστω σοι διηνεκὴς καὶ ἄπαυστος ὁ Χριστός.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.4.s1",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.4.s1",
    "language": "grc",
    "text": "Μηδὲ λῦε τὸν τῆς ψυχῆς τόνον ἐν εὐωχίᾳ καὶ ποτῶν ἀνέσει, ἱκανὸν δὲ ἡγοῦ τῷ σώματι τὸ χρειῶδες.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.4.s2",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.4.s2",
    "language": "grc",
    "text": "καὶ μὴ πρόσθεν ἐπείγου πρὸς τροφὰς πρὶν ἢ καὶ δείπνου παρῇ καιρός· ἄρτος δὲ ἔστω σοι τὸ δεῖπνον, καὶ πόαι γῆς προσέστωσαν καὶ τὰ ἐκ δένδρων ὡραῖα·",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.4.s3",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.4.s3",
    "language": "grc",
    "text": "ἴθι δὲ ἐπὶ τὴν τροφὴν εὐσταθῶς καὶ μὴ λυσσώδη γαστριμαργίαν ἐπιφαίνων· μηδὲ σαρκοβόρος μηδὲ φίλοινος ἔσο, ὁπότε μὴ νόσος τις ἴασιν ἐπὶ ταύτην ἄγοι.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.4.s4",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.4.s4",
    "language": "grc",
    "text": "ἀλλ’ ἀντὶ τῶν ἐν τούτοις ἡδονῶν τὰς ἐν λόγοις θείοις καὶ ὕμνοις εὐφροσύνας αἱροῦ τῇ παρὰ θεοῦ σοι χορηγουμένας σοφίᾳ, οὐράνιός τε ἀεί σε φροντὶς ἀναγέτω πρὸς οὐρανόν.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.5.s1",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.5.s1",
    "language": "grc",
    "text": "Καὶ τὰς πολλὰς περὶ σώματος ἀνίει μερίμνας τεθαρσηκὼς ἐλπίσι ταῖς πρὸς θεόν, ὅτι σοί γε τὰ ἀναγκαῖα παρέξει διαρκῆ τροφήν τε τὴν εἰς ζωὴν καὶ κάλυμμα σώματος καὶ χειμερινοῦ ψύχους ἀλεξητήρια.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.5.s2",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.5.s2",
    "language": "grc",
    "text": "τοῦ γὰρ δὴ σοῦ βασιλέως γῆ τε ἅπασα καὶ ὅσα ἐκφύεται· ὡς μέλη δὲ αὑτοῦ τῶν αὑτοῦ θεραπόντων ὑπερβαλλόντως περιέπει καθάπερ ἱερὰ καὶ ναοὺς αὑτοῦ.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.5.s3",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.5.s3",
    "language": "grc",
    "text": "διὰ δὴ τοῦτο μηδὲ νόσους ὑπερβαλλούσας δέδιθι μηδὲ γήρως ἔφοδον χρόνῳ προσδοκωμένου· παύσεται γὰρ καὶ νόσος, ὅταν ὁλοψύχῳ προθέσει ποιῶμεν τὰς αὐτοῦ ἐντολάς.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.6.s1",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.6.s1",
    "language": "grc",
    "text": "Ταῦτα εἰδὼς καὶ πρὸς νόσους ἰσχυρὰν κατασκεύαζε τὴν ψυχήν, εὐθάρσησον ὥσπερ τις ἀνὴρ ἐν σταδίοις ἄριστος ἀτρέπτῳ τῇ δυνάμει τοὺς πόνους ὑφίστασθαι.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "perseus/tlg0555/tlg008/perseus-grc2#tlg0555.tlg008.6.s2",
    "work_id": "perseus/tlg0555/tlg008/perseus-grc2",
    "canonical_ref": "tlg0555.tlg008.6.s2",
    "language": "grc",
    "text": "μηδὲ ὑπὸ λύπης πάνυ πιέζου τὴν ψυχήν, εἴτε νόσος ἐπικειμένη βαρύνει εἴτε ἄλλο τι συμπίπτει δυσχερές, ἀλλὰ γενναίως ἀνθίστα τοῖς πόνοις τὸ νόημα,",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": null,
    "date_range": null,
