    "work_id": "anf-works/origen-letter-to-gregory-anf09",
    "canonical_ref": "Orig.EpGreg.7.s19",
    "language": "eng",
    "text": "and to cause them to say to the golden calf, “These are thy gods, O Israel, which brought thee up out of the land of Egypt.”",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 238,
    "date_range": [
