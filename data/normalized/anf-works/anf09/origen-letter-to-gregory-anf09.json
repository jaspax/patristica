    "canonical_ref": "Orig.EpGreg.7.s18",
    "language": "eng",
    "text": "Therefore, though he did go back to the land of Israel, he came back to it to bring division into the people of God,",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 238,
