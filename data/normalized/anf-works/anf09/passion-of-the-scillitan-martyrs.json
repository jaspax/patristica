    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.22",
    "language": "eng",
    "text": "Saturninus the proconsul said: Have a delay of thirty days and bethink yourselves.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
      180,
