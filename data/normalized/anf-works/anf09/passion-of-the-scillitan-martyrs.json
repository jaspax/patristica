    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
      180,
      180
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/passion-of-the-scillitan-martyrs#PassScill.20",
    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.20",
    "language": "eng",
    "text": "Saturninus the proconsul said: What are the things in your chest?",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
      180,
      180
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/passion-of-the-scillitan-martyrs#PassScill.21",
    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.21",
    "language": "eng",
    "text": "Speratus said: Books and epistles of Paul, a just man.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
      180,
      180
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
