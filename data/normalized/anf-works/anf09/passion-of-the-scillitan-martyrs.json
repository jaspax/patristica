    "chunk_id": "anf-works/passion-of-the-scillitan-martyrs#PassScill.23",
    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.23",
    "language": "eng",
    "text": "Speratus said a second time: I am a Christian. And with him they all agreed.",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
