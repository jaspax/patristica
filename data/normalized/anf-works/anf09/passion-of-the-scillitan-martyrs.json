    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.25",
    "language": "eng",
    "text": "Speratus said: We give thanks to God.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
      180,
      180
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/passion-of-the-scillitan-martyrs#PassScill.26",
    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.26",
    "language": "eng",
    "text": "Nartzalus said: To-day we are martyrs in heaven; thanks be to God.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
