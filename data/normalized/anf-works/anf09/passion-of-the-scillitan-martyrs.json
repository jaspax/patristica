    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/passion-of-the-scillitan-martyrs#PassScill.18",
    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.18",
    "language": "eng",
    "text": "Saturninus the proconsul said: Will ye have a space to consider?",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
      180,
      180
