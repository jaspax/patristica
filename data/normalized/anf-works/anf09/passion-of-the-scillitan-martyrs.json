    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/passion-of-the-scillitan-martyrs#PassScill.19",
    "work_id": "anf-works/passion-of-the-scillitan-martyrs",
    "canonical_ref": "PassScill.19",
    "language": "eng",
    "text": "Speratus said: In a matter so straightforward there is no considering.",
