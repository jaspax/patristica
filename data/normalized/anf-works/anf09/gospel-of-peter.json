    "canonical_ref": "EvPetr.10.s1",
    "language": "eng",
    "text": "9 And in the night in which the Lord’s day was drawing on, as the soldiers kept guard two by two in a watch, there was a great voice in the heaven;",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
