    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.4.s5",
    "language": "eng",
    "text": "others pricked him with a reed; and some scourged him, saying, With this honour let us honour the Son of God.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
