    "canonical_ref": "EvPetr.9.s1",
    "language": "eng",
    "text": "8 But the scribes and Pharisees and elders being gathered together one with another, when they heard that all the people murmured and beat their breasts saying,",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
