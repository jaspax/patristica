    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.9.s3",
    "language": "eng",
    "text": "that we may guard his sepulchre for three days, lest his disciples come and steal him away, and the people suppose that he is risen from the dead and do us evil.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
