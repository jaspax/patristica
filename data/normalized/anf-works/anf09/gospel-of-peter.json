    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.3.s1",
    "language": "eng",
    "text": "2 And there was standing there Joseph the friend of Pilate and of the Lord; and, knowing that they were about to crucify him, he came to Pilate and asked the body of the Lord for burial.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
