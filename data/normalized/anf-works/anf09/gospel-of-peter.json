    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.5.s2",
    "language": "eng",
    "text": "And when they had raised the cross, they wrote the title: This is the king of Israel. And having set his garments before him they parted them among them, and cast lots for them.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
