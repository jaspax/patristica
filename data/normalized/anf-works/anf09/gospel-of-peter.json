    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.9.s5",
    "language": "eng",
    "text": "And with them came elders and scribes to the sepulchre, and having rolled a great stone together with the centurion and the soldiers, they all together who were there set it at the door of the sepulchre;",
    "chunk_index": 29,
    "context_before": null,
