    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.7.s1",
    "language": "eng",
    "text": "6 And then they drew out the nails from the hands of the Lord, and laid him upon the earth, and the whole earth quaked, and great fear arose.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
