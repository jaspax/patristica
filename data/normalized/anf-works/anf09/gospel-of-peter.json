    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.6.s3",
    "language": "eng",
    "text": "And they mixed and gave him to drink, and fulfilled all things, and accomplished their sins against their own head. And many went about with lamps, supposing that it was night, and fell down.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
