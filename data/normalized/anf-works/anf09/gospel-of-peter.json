    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.7.s2",
    "language": "eng",
    "text": "Then the sun shone, and it was found the ninth hour: and the Jews rejoiced, and gave his body to Joseph that he might bury it, since he had seen what good things he had done.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 150,
    "date_range": [
