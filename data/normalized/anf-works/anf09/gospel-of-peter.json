    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.7.s3",
    "language": "eng",
    "text": "And he took the Lord, and washed him, and rolled him in a linen cloth, and brought him into his own tomb, which was called the Garden of Joseph.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 150,
    "date_range": [
