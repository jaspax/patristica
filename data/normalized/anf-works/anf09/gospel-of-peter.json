    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.8.s1",
    "language": "eng",
    "text": "7 Then the Jews and the elders and the priests, perceiving what evil they had done to themselves, began to lament and to say, Woe for our sins: the judgement hath drawn nigh, and the end of Jerusalem.",
    "chunk_index": 22,
    "context_before": null,
