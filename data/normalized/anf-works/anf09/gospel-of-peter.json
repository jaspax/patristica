    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.3.s2",
    "language": "eng",
    "text": "And Pilate sent to Herod and asked his body. And Herod said, Brother Pilate, even if no one had asked for him, we purposed to bury him, especially as the sabbath draweth on:",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 150,
    "date_range": [
