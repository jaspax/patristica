    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.9.s2",
    "language": "eng",
    "text": "If by his death these most mighty signs have come to pass, see how righteous he is,—the elders were afraid and came to Pilate, beseeching him and saying, Give us soldiers,",
    "chunk_index": 26,
    "context_before": null,
