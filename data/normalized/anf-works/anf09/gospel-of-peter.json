    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.6.s4",
    "language": "eng",
    "text": "And the Lord cried out, saying, My power, my power, thou hast forsaken me. And when he had said it he was taken up. And in that hour the vail of the temple of Jerusalem was rent in twain.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
