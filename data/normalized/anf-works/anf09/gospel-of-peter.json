    "canonical_ref": "EvPetr.5.s1",
    "language": "eng",
    "text": "4 And they brought two malefactors, and they crucified the Lord between them. But he held his peace, as though having no pain.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 150,
