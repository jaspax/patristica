    "work_id": "anf-works/gospel-of-peter",
    "canonical_ref": "EvPetr.9.s6",
    "language": "eng",
    "text": "and they affixed seven seals, and they pitched a tent there and guarded it. And early in the morning as the sabbath was drawing on,",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 150,
    "date_range": [
