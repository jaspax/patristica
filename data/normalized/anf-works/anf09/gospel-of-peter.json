    "canonical_ref": "EvPetr.4.s4",
    "language": "eng",
    "text": "And one of them brought a crown of thorns and put it on the head of the Lord. And others stood and spat in his eyes, and others smote his cheeks:",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
