    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.iv.s7",
    "language": "eng",
    "text": "and that all animals, feeding then only on the productions of the earth, would become peaceable and harmonious, and be in perfect subjection to man.”",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
