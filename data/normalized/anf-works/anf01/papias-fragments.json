    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s8",
    "language": "eng",
    "text": "and that, moreover, they ascend through the Spirit to the Son, and through the Son to the Father;",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
