    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s2",
    "language": "eng",
    "text": "for everywhere the Saviour will be seen, according as they shall be worthy who see Him.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
