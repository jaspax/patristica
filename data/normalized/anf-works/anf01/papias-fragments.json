  },
  {
    "chunk_id": "anf-works/papias-fragments#Papias.v.s6",
    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s6",
    "language": "eng",
    "text": "And this is the couch in which they shall recline who feast, being invited to the wedding.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
