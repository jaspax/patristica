    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.i.s3",
    "language": "eng",
    "text": "who was a hearer of John, and a friend of Polycarp, in the fourth of his books; for five books were composed by him.” Thus wrote Irenæus.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
      100,
      130
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
