    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s7",
    "language": "eng",
    "text": "The presbyters, the disciples of the apostles, say that this is the gradation and arrangement of those who are saved, and that they advance through steps of this nature;",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
