    "canonical_ref": "Papias.i.s1",
    "language": "eng",
    "text": "[The writings of Papias in common circulation are five in number, and these are called an Exposition of the Oracles of the Lord.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
