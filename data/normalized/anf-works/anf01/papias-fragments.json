    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.iv.s10",
    "language": "eng",
    "text": "And Judas the traitor,” says he, “not believing, and asking, ‘How shall such growths be accomplished by the Lord?’ the Lord said, ‘They shall see who shall come to them.’",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
