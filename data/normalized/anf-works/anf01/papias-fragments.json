    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.iv.s6",
    "language": "eng",
    "text": "and every grain would yield ten pounds of clear, pure, fine flour; and that apples, and seeds, and grass would produce in similar proportions;",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
      100,
      130
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
