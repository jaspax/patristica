    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s4",
    "language": "eng",
    "text": "for the first will be taken up into the heavens, the second class will dwell in Paradise, and the last will inhabit the city; and that on this account the Lord said, “In my Father’s house are many mansions:”",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
