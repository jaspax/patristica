    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.x.s5",
    "language": "eng",
    "text": "Mary Salome (3) is called Salome either from her husband or her village. Some affirm that she is the same as Mary of Cleophas, because she had two husbands.",
    "chunk_index": 64,
    "context_before": null,
    "context_after": null,
