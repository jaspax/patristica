    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s3",
    "language": "eng",
    "text": "But that there is this distinction between the habitation of those who produce an hundred-fold, and that of those who produce sixty-fold, and that of those who produce thirty-fold;",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
