    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s1",
    "language": "eng",
    "text": "As the presbyters say, then those who are deemed worthy of an abode in heaven shall go there, others shall enjoy the delights of Paradise, and others shall possess the splendour of the city;",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
