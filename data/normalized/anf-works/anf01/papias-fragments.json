    "chunk_id": "anf-works/papias-fragments#Papias.iv.s8",
    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.iv.s8",
    "language": "eng",
    "text": "[Testimony is borne to these things in writing by Papias, an ancient man, who was a hearer of John and a friend of Polycarp, in the fourth of his books;",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
