    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s5",
    "language": "eng",
    "text": "for all things belong to God, who supplies all with a suitable dwelling-place, even as His word says, that a share is given to all by the Father, according as each one is or shall be worthy.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
