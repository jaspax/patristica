    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s10",
    "language": "eng",
    "text": "The last enemy that shall be destroyed is death.” For in the times of the kingdom the just man who is on the earth shall forget to die.",
    "chunk_index": 33,
