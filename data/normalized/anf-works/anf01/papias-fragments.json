    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.v.s9",
    "language": "eng",
    "text": "and that in due time the Son will yield up His work to the Father, even as it is said by the apostle, “For He must reign till He hath put all enemies under His feet.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
