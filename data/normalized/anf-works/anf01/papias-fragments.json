    "work_id": "anf-works/papias-fragments",
    "canonical_ref": "Papias.i.s2",
    "language": "eng",
    "text": "Irenæus makes mention of these as the only works written by him, in the following words: “Now testimony is borne to these things in writing by Papias, an ancient man,",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 120,
    "date_range": [
