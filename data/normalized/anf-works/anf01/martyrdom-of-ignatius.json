    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/martyrdom-of-ignatius#MartIgn.vii.s6",
    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vii.s6",
    "language": "eng",
    "text": "and now we have made known to you both the day and the time [when these things happened], that, assembling ourselves together according to the time of his martyrdom,",
    "chunk_index": 68,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
