    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.v.s8",
    "language": "eng",
    "text": "Wherefore, continuing to enjoy fair winds, we were reluctantly hurried on in one day and a night, mourning [as we did] over the coming departure from us of this righteous man.",
    "chunk_index": 49,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
