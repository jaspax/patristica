    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.ii.s3",
    "language": "eng",
    "text": "and [thereupon] threatening them with persecution unless they should agree to worship dæmons, as did all other nations, thus compelled all who were living godly lives either to sacrifice [to idols] or die.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      350,
      500
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
