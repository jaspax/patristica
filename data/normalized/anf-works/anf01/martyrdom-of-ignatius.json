    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.i.s6",
    "language": "eng",
    "text": "For he inwardly reflected, that the confession which is made by martyrdom, would bring him into a yet more intimate relation to the Lord.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      350,
      500
    ],
    "date_confidence": "uncertain",
