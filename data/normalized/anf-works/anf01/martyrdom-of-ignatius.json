    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.v.s7",
    "language": "eng",
    "text": "But a violent wind arising did not suffer him to do so, the ship being driven rapidly forwards; and, simply expressing his delight over the love of the brethren in that place, he sailed by.",
    "chunk_index": 48,
    "context_before": null,
