      500
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/martyrdom-of-ignatius#MartIgn.vii.s5",
    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vii.s5",
    "language": "eng",
    "text": "When, therefore, we had with great joy witnessed these things, and had compared our several visions together, we sang praise to God, the giver of all good things, and expressed our sense of the happiness of the holy [martyr];",
    "chunk_index": 67,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      350,
