    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vi.s6",
    "language": "eng",
    "text": "that a stop might be put to the persecution, and that mutual love might continue among the brethren, was led with all haste into the amphitheatre.",
    "chunk_index": 57,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
