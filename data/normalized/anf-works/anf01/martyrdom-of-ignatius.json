    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.i.s5",
    "language": "eng",
    "text": "Wherefore he rejoiced over the tranquil state of the Church, when the persecution ceased for a little time, but was grieved as to himself, that he had not yet attained to a true love to Christ, nor reached the perfect rank of a disciple.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
