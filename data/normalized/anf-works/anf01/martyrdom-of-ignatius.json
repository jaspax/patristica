    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vi.s2",
    "language": "eng",
    "text": "rejoicing indeed because they were thought worthy to meet with Theophorus, but struck with fear because so eminent a man was being led to death.",
    "chunk_index": 53,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
