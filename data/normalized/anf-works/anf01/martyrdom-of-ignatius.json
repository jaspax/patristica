    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.i.s3",
    "language": "eng",
    "text": "like a good pilot, by the helm of prayer and fasting, by the earnestness of his teaching, and by his [constant] spiritual labour,",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
