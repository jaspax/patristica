    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.ii.s1",
    "language": "eng",
    "text": "For Trajan, in the ninth year of his reign, being lifted up [with pride], after the victory he had gained over the Scythians and Dacians,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
