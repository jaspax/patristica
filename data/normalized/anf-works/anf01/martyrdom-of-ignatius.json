  },
  {
    "chunk_id": "anf-works/martyrdom-of-ignatius#MartIgn.vi.s4",
    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vi.s4",
    "language": "eng",
    "text": "He being immediately aware of this through the Spirit, and having saluted them all, and begged of them to show a true affection towards him, and having dwelt [on this point] at greater length than in his Epistle,",
    "chunk_index": 55,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
