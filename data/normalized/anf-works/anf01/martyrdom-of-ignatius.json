    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.ii.s2",
    "language": "eng",
    "text": "and many other nations, and thinking that the religious body of the Christians were yet wanting to complete the subjugation of all things to himself,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      350,
      500
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
