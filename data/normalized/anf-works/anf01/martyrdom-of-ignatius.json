  },
  {
    "chunk_id": "anf-works/martyrdom-of-ignatius#MartIgn.vi.s3",
    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vi.s3",
    "language": "eng",
    "text": "Now he enjoined some to keep silence who, in their fervent zeal, were saying that they would appease the people, so that they should not demand the destruction of this just one.",
    "chunk_index": 54,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
