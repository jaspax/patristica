    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.vii.s7",
    "language": "eng",
    "text": "we may have fellowship with the champion and noble martyr of Christ, who trod under foot the devil, and perfected the course which, out of love to Christ, he had desired, in Christ Jesus our Lord;",
    "chunk_index": 69,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      350,
      500
    ],
