    "work_id": "anf-works/martyrdom-of-ignatius",
    "canonical_ref": "MartIgn.i.s7",
    "language": "eng",
    "text": "Wherefore, continuing a few years longer with the Church, and, like a divine lamp, enlightening every one’s understanding by his expositions of the [Holy] Scriptures, he [at length] attained the object of his desire.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      350,
      500
    ],
    "date_confidence": "uncertain",
