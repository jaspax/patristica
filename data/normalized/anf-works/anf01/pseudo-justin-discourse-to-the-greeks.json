    "canonical_ref": "PsJust.OrGr.iii.s6",
    "language": "eng",
    "text": "and to be conquered by the love of woman, and to be struck on the hips by the laughing Lyda!",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
