    "work_id": "anf-works/pseudo-justin-discourse-to-the-greeks",
    "canonical_ref": "PsJust.OrGr.iii.s9",
    "language": "eng",
    "text": "Since, therefore, ye Greeks, your gods are convicted of intemperance, and your heroes are effeminate, as the histories on which your dramas are founded have declared, such as the curse of Atreus,",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": 200,
    "date_range": [
      150,
      300
    ],
