    "work_id": "anf-works/pseudo-justin-discourse-to-the-greeks",
    "canonical_ref": "PsJust.OrGr.iii.s8",
    "language": "eng",
    "text": "Let Vulcan lay aside his envy, and not be jealous if he is hated because he is old and club-footed, and Mars loved, because young and beautiful.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 200,
    "date_range": [
      150,
      300
