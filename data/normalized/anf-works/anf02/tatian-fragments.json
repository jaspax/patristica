    "work_id": "anf-works/tatian-fragments",
    "canonical_ref": "Tat.Frag.s3",
    "language": "eng",
    "text": "for while he permits them to return to the same on account of Satan and incontinence, he exhibits a man who will attempt to serve two masters—God by the ‘consent’ (1 Cor.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 170,
    "date_range": [
      160,
      180
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
