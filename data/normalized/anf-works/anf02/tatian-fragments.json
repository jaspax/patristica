    "work_id": "anf-works/tatian-fragments",
    "canonical_ref": "Tat.Frag.11.s3",
    "language": "eng",
    "text": "since it was commanded in the law that the Nazarites were not to drink wine, and now those who give the Nazarites wine are accused by the prophet.—Hieron.: Com. in Amos.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 170,
    "date_range": [
