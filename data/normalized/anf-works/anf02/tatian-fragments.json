    "work_id": "anf-works/tatian-fragments",
    "canonical_ref": "Tat.Frag.s2",
    "language": "eng",
    "text": "At any rate, by the permission he certainly, though delicately, forbids;",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 170,
    "date_range": [
