    "work_id": "anf-works/tatian-fragments",
    "canonical_ref": "Tat.Frag.s4",
    "language": "eng",
    "text": "7:5), but by want of consent, incontinence, fornication, and the devil.”—Clem. Alex.: Strom., iii. c. 12.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 170,
    "date_range": [
