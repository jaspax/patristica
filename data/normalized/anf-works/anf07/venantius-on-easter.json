    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s14",
    "language": "eng",
    "text": "Hence Philomela attunes her notes with her own instruments, and the air becomes sweeter with the re-echoed melody.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
