    "chunk_id": "anf-works/venantius-on-easter#VenFort.Pasch.s30",
    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s30",
    "language": "eng",
    "text": "Darkness perishes, put to flight by the brightness of Christ; the thick pall of eternal night falls. But restore the promised pledge, I pray Thee, O power benign!",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/venantius-on-easter#VenFort.Pasch.s31",
    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s31",
    "language": "eng",
    "text": "The third day has returned; arise, my buried One; it is not becoming that Thy limbs should lie in the lowly sepulchre, nor that worthless stones should press that which is the ransom of the world.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/venantius-on-easter#VenFort.Pasch.s32",
    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s32",
    "language": "eng",
    "text": "It is unworthy that a stone should shut in with a confining rock, and cover Him in whose fist all things are enclosed.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
