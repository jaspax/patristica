    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s34",
    "language": "eng",
    "text": "Release the chained shades of the infernal prison, and recall to the upper regions whatever sinks to the lowest depths.",
