    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s28",
    "language": "eng",
    "text": "Thou dost undergo funeral obsequies, Thyself the author of life and framer of the world, Thou dost enter the path of death, in giving the aid of salvation.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
