    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s33",
    "language": "eng",
    "text": "Take away the linen clothes, I pray; leave the napkins in the tomb: Thou art sufficient for us, and without Thee there is nothing.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
