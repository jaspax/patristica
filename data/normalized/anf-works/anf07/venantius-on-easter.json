    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s17",
    "language": "eng",
    "text": "The light, the heaven, the fields, and the sea duly praise the God ascending above the stars, having crushed the laws of hell.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
