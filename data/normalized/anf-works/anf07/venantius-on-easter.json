    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s5",
    "language": "eng",
    "text": "Soft beds of violets paint the purple plain; the meadows are green with plants, and the plant shines with its leaves.",
