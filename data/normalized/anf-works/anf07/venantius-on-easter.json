    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s24",
    "language": "eng",
    "text": "Thou self-existing Word, and powerful from the mouth of Thy Father, equal to Him, of one mind with Him, His fellow, coeval with the Father, from whom at first the world derived its origin!",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
