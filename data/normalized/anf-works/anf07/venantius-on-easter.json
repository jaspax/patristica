    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s12",
    "language": "eng",
    "text": "Hence the bee, about to construct its comb, leaving the hive, humming over the flowers, carries off honey with its leg.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
