    "canonical_ref": "VenFort.Pasch.s35",
    "language": "eng",
    "text": "Give back Thy face, that the world may see the light; give back the day which flees from us at Thy death.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
