    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s7",
    "language": "eng",
    "text": "The seed being deposited, the corn springs up far and wide in the fields, promising to be able to overcome the hunger of the husbandman.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
