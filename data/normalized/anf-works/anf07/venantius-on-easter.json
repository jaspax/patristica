    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s29",
    "language": "eng",
    "text": "The gloomy chains of the infernal law yielded, and chaos feared to be pressed by the presence of the light.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
