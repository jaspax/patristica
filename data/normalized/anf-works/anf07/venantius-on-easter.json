    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s20",
    "language": "eng",
    "text": "The changes of the year and of the months, the bounteous light of the days, the splendour of the hours, all things with voice applaud.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
