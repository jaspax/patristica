    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s11",
    "language": "eng",
    "text": "Mingled together, the willow, the fir, the hazel, the osier, the elm, the maple, the walnut, each tree applauds, delightful with its leaves.",
