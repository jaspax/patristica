    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s16",
    "language": "eng",
    "text": "For in honour of Christ rising triumphant after His descent to the gloomy Tartarus, the grove on every side with its leaves expresses approval, the plants with their flowers express approval.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
