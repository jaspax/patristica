    "chunk_id": "anf-works/venantius-on-easter#VenFort.Pasch.s25",
    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s25",
    "language": "eng",
    "text": "Thou dost suspend the firmament, Thou heapest together the soil, Thou dost pour forth the seas, by whose government all things which are fixed in their places flourish.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
