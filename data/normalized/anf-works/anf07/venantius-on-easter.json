    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s13",
    "language": "eng",
    "text": "The bird which, having closed its song, was dumb, sluggish with the wintry cold, returns to its strains.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
