    "text": "But returning, O holy conqueror! Thou didst altogether fill the heaven! Tartarus lies depressed, nor retains its rights.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
