    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s15",
    "language": "eng",
    "text": "Behold, the favour of the reviving world bears witness that all gifts have returned together with its Lord.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
