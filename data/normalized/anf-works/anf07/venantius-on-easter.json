    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s26",
    "language": "eng",
    "text": "Who seeing that the human race was plunged in the depth of misery, that Thou mightest rescue man, didst Thyself also become man:",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
