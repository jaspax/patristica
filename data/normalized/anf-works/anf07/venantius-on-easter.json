    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s22",
    "language": "eng",
    "text": "Hence the thickets now resound with the whisper of birds; amidst these the sparrow sings with exuberant love.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
