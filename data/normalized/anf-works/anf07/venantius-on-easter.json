    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s18",
    "language": "eng",
    "text": "Behold, He who was crucified reigns as God over all things, and all created objects offer prayer to their Creator.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
