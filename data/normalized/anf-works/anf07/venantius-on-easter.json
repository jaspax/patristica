    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s19",
    "language": "eng",
    "text": "Hail, festive day, to be reverenced throughout the world, on which God has conquered hell, and gains the stars!",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
    "date_confidence": "approximate",
