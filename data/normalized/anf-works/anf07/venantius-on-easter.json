    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s21",
    "language": "eng",
    "text": "Hence, in honour of you, the wood with its foliage applauds; hence the vine, with its silent shoot, gives thanks.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
      560,
      600
    ],
