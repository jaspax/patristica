    "work_id": "anf-works/venantius-on-easter",
    "canonical_ref": "VenFort.Pasch.s27",
    "language": "eng",
    "text": "nor wert Thou willing only to be born with a body, but Thou becamest flesh, which endured to be born and to die.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 570,
    "date_range": [
