[
  {
    "chunk_id": "anf-works/anonymous-against-the-montanists#AntiMont.s1",
    "work_id": "anf-works/anonymous-against-the-montanists",
    "canonical_ref": "AntiMont.s1",
    "language": "eng",
    "text": "Having now for a very long and surely a very sufficient period had the charge pressed upon me by thee, my dear Avircius Marcellus,",
