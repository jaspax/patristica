    "work_id": "anf-works/nicene-creed",
    "canonical_ref": "Nicaea1.Creed.1",
    "language": "eng",
    "text": "We believe in one God, the Father Almighty, Maker of all things, visible and invisible:",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 325,
    "date_range": [
