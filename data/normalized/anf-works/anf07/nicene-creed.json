    "work_id": "anf-works/nicene-creed",
    "canonical_ref": "Nicaea1.Creed.4",
    "language": "eng",
    "text": "By whom all things were made, both things in heaven and things in earth:",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 325,
    "date_range": [
      325,
      381
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
