    "work_id": "anf-works/nicene-creed",
    "canonical_ref": "Nicaea1.Creed.3",
    "language": "eng",
    "text": "God of God; Light of light; very God of very God; begotten, not made; being of one substance with the Father,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 325,
    "date_range": [
      325,
      381
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
