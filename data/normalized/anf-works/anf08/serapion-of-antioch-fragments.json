    "work_id": "anf-works/serapion-of-antioch-fragments",
    "canonical_ref": "Serap.1.s1",
    "language": "eng",
    "text": "[a.d. circa 190–200–211.] He was the eighth bishop of Antioch, a diligent writer and exemplary pastor.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 200,
    "date_range": [
