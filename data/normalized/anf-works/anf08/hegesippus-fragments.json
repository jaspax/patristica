    "canonical_ref": "Heges.I.2",
    "language": "eng",
    "text": "Concerning the Martyrdom of James, the Brother of the Lord, from Book V.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 180,
    "date_range": [
