    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.1.s4",
    "language": "eng",
    "text": "and our author presided over a council in Cæsarea, of which he was bishop, assisted by Narcissus, bishop of Jerusalem,",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
    "date_range": [
      190,
