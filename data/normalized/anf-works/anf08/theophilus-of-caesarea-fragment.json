    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.3.s2",
    "language": "eng",
    "text": "We would have you know, too, that in Alexandria also they observe the festival on the same day as ourselves.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
    "date_range": [
