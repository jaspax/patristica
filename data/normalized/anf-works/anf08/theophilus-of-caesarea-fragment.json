    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.1.s6",
    "language": "eng",
    "text": "and it is not quite correct to say that the Western usage prevailed at Nicæa, for it was the general use, save only in Asia Minor and churches which were colonies of the same.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
    "date_range": [
