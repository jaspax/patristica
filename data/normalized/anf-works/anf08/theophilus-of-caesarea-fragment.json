    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.1.s2",
    "language": "eng",
    "text": "Throughout “the rest of the world,” he testifies, however, that such was not the use.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
    "date_range": [
