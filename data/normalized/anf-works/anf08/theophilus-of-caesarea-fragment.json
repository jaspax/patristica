    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.1.s3",
    "language": "eng",
    "text": "The Palestinian bishops, after the Jewish downfall, seem to have been the first to comprehend the propriety of adopting the more Catholic usage;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
    "date_range": [
      190,
      200
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
