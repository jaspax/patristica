    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.1.s7",
    "language": "eng",
    "text": "This fact has been overlooked, and is very important, in history.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
    "date_range": [
