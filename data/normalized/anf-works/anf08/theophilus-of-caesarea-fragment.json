    "work_id": "anf-works/theophilus-of-caesarea-fragment",
    "canonical_ref": "TheophCaes.3.s1",
    "language": "eng",
    "text": "Endeavour also to send abroad copies of our epistle among all the churches, so that those who easily deceive their own souls may not be able to lay the blame on us.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 195,
