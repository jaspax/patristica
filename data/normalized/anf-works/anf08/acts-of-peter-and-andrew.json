    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.6.s1",
    "language": "eng",
    "text": "And Peter, and Andrew, and Alexander, and Rufus, and Matthias, went into the city of the barbarians.",
