    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.4.s5",
    "language": "eng",
    "text": "Peter says to him: Be a man in the Lord, brother Andrew, and come hither, and rest from thy labour.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
    ],
    "date_confidence": "uncertain",
