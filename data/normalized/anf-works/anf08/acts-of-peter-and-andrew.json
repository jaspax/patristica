    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.4.s6",
    "language": "eng",
    "text": "For if the good husbandman laboriously till the ground, it will also bear fruit, and straightway all his toil will be turned into joy;",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
