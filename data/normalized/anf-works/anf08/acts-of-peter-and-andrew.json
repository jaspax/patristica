    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.4.s2",
    "language": "eng",
    "text": "And when he saw them, they saluted him with great joy. Then Peter says to him: What has happened to thee, brother Andrew?",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
