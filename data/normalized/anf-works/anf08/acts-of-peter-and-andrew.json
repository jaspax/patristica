    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.5.s1",
    "language": "eng",
    "text": "And while he was thus speaking, the Lord Jesus Christ appeared to them in the form of a child, and said to them: Hail, Peter, bishop of the whole of my Church!",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
    ],
    "date_confidence": "uncertain",
