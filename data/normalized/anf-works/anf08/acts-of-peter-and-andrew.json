    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.4.s7",
    "language": "eng",
    "text": "but if he toil, and his land bring forth no fruit, he has double toil.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
    ],
    "date_confidence": "uncertain",
