  {
    "chunk_id": "anf-works/acts-of-peter-and-andrew#ActPetAndr.5.s2",
    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.5.s2",
    "language": "eng",
    "text": "hail, Andrew! My co-heirs, be courageous, and struggle for mankind; for verily I say unto you, you shall endure toils in this world for mankind.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
    ],
    "date_confidence": "uncertain",
