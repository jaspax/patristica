    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.6.s3",
    "language": "eng",
    "text": "Peter says to him: I do not know. But, behold, there is an old man before us sowing in his field:",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
