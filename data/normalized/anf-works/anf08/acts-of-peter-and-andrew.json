  {
    "chunk_id": "anf-works/acts-of-peter-and-andrew#ActPetAndr.4.s3",
    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.4.s3",
    "language": "eng",
    "text": "Hast thou sown the word of truth in the country of the man-eaters or not? Andrew says to him: Yes, father Peter, through thy prayers;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
      500,
      800
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
