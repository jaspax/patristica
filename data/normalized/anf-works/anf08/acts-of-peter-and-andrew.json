    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/acts-of-peter-and-andrew#ActPetAndr.6.s6",
    "work_id": "anf-works/acts-of-peter-and-andrew",
    "canonical_ref": "ActPetAndr.6.s6",
    "language": "eng",
    "text": "And the farmer says to them: Hail you too, merchants! Peter says to him: Have you bread to give to these children, for we have been in want?",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 600,
    "date_range": [
