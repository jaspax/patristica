    "canonical_ref": "Aristo.1.s1",
    "language": "eng",
    "text": "[a.d. 140.] Aristo of Pella is supposed to have been a Jew, whose work was designed to help the failing Judaism of his country.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 140,
    "date_range": [
