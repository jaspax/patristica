[
  {
    "chunk_id": "anf-works/pantaenus-fragments#Pantaen",
    "work_id": "anf-works/pantaenus-fragments",
    "canonical_ref": "Pantaen",
    "language": "eng",
    "text": "Pantænus, the Alexandrian Philosopher.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
