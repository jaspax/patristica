    "canonical_ref": "EpPil.2",
    "language": "eng",
    "text": "Pontius Pilate to Tiberius Cæsar the emperor, greeting.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 300,
    "date_range": [
