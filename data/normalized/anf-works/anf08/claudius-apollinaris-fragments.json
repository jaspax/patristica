  },
  {
    "chunk_id": "anf-works/claudius-apollinaris-fragments#ApollinHier.9.s1",
    "work_id": "anf-works/claudius-apollinaris-fragments",
    "canonical_ref": "ApollinHier.9.s1",
    "language": "eng",
    "text": "The fourteenth day, the true Passover of the Lord; the great sacrifice, the Son of God instead of the lamb, who was bound, who bound the strong, and who was judged,",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
