    "work_id": "anf-works/passion-of-symphorosa",
    "canonical_ref": "PassSymph.2.s17",
    "language": "eng",
    "text": "iv., gave the name, To the Seven Biothanati, i.e., those cut off by a violent death, as Baronius remarks, at the year 138.”",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      300,
