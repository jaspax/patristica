    "work_id": "anf-works/passion-of-symphorosa",
    "canonical_ref": "PassSymph.2.s2",
    "language": "eng",
    "text": "“The narrative of the martyrdom of St. Symphorosa and her seven sons, which we here publish, is ascribed in the mss.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      300,
      600
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
