    "work_id": "anf-works/passion-of-symphorosa",
    "canonical_ref": "PassSymph.2.s19",
    "language": "eng",
    "text": "S.S. Junii, vol. iv. p. 350.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      300,
