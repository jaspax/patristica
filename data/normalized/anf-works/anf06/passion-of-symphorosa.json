  },
  {
    "chunk_id": "anf-works/passion-of-symphorosa#PassSymph.2.s16",
    "work_id": "anf-works/passion-of-symphorosa",
    "canonical_ref": "PassSymph.2.s16",
    "language": "eng",
    "text": "I have no doubt that it was built in that place to which the pontiffs in the Acta, sec.",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
      300,
      600
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
