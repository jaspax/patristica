    "canonical_ref": "PassSymph.2.s1",
    "language": "eng",
    "text": "The text is given from the edition of Ruinart. His preface, which Migne also cites, is as follows:",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
