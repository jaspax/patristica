    "work_id": "anf-works/passion-of-symphorosa",
    "canonical_ref": "PassSymph.2.s18",
    "language": "eng",
    "text": "So far Ruinart: see also Tillemont, Mém. Eccles., ii. pp. 241 and 595; and the Bollandists, Act.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 400,
    "date_range": [
