  {
    "chunk_id": "anf-works/africanus-epistle-to-aristides#Afric.EpArist.I.5.s1",
    "work_id": "anf-works/africanus-epistle-to-aristides",
    "canonical_ref": "Afric.EpArist.I.5.s1",
    "language": "eng",
    "text": "[Africanus on the Genealogy in the Holy Gospels.—Some indeed incorrectly allege that this discrepant enumeration and mixing of the names both of priestly men,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      220,
      240
    ],
    "date_confidence": "approximate",
