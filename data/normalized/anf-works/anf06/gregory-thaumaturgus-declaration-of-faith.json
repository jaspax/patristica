    "work_id": "anf-works/gregory-thaumaturgus-declaration-of-faith",
    "canonical_ref": "GregThaum.Fid.4.s3",
    "language": "eng",
    "text": "and Power formative of the whole creation, true Son of true Father, Invisible of Invisible, and Incorruptible of Incorruptible, and Immortal of Immortal and Eternal of Eternal.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
      270
    ],
    "date_confidence": "uncertain",
