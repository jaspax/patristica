    "work_id": "anf-works/gregory-thaumaturgus-declaration-of-faith",
    "canonical_ref": "GregThaum.Fid.4.s2",
    "language": "eng",
    "text": "There is one Lord, Only of the Only, God of God, Image and Likeness of Deity, Efficient Word, Wisdom comprehensive of the constitution of all things,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
      270
    ],
    "date_confidence": "uncertain",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
