    "work_id": "anf-works/gregory-thaumaturgus-declaration-of-faith",
    "canonical_ref": "GregThaum.Fid.4.s4",
    "language": "eng",
    "text": "And there is One Holy Spirit, having His subsistence from God, and being made manifest by the Son, to wit to men:",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
      270
    ],
    "date_confidence": "uncertain",
