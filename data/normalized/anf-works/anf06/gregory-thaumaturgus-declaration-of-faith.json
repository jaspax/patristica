    "work_id": "anf-works/gregory-thaumaturgus-declaration-of-faith",
    "canonical_ref": "GregThaum.Fid.4.s7",
    "language": "eng",
    "text": "There is a perfect Trinity, in glory and eternity and sovereignty, neither divided nor estranged.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
      270
    ],
    "date_confidence": "uncertain",
