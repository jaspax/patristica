    "work_id": "anf-works/gregory-thaumaturgus-declaration-of-faith",
    "canonical_ref": "GregThaum.Fid.4.s8",
    "language": "eng",
    "text": "Wherefore there is nothing either created or in servitude in the Trinity; nor anything superinduced, as if at some former period it was non-existent, and at some later period it was introduced.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
