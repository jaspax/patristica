    "canonical_ref": "GregThaum.Fid.4.s6",
    "language": "eng",
    "text": "in whom is manifested God the Father, who is above all and in all, and God the Son, who is through all.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
      270
    ],
    "date_confidence": "uncertain",
