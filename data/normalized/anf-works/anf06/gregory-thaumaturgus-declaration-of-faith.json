    "work_id": "anf-works/gregory-thaumaturgus-declaration-of-faith",
    "canonical_ref": "GregThaum.Fid.4.s5",
    "language": "eng",
    "text": "Image of the Son, Perfect Image of the Perfect; Life, the Cause of the living; Holy Fount; Sanctity, the Supplier, or Leader, of Sanctification;",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
      255,
