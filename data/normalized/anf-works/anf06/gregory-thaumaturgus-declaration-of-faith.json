    "canonical_ref": "GregThaum.Fid.4.s1",
    "language": "eng",
    "text": "There is one God, the Father of the living Word, who is His subsistent Wisdom and Power and Eternal Image: perfect Begetter of the perfect Begotten, Father of the only-begotten Son.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 262,
    "date_range": [
