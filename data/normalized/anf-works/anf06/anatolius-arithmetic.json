    "work_id": "anf-works/anatolius-arithmetic",
    "canonical_ref": "Anat.Arith.20.s5",
    "language": "eng",
    "text": "We may instance the facts—that the fixed stars move round the axis passing through the poles, while the planets remove from each other round the perpendicular axis of the zodiac;",
    "chunk_index": 48,
    "context_before": null,
    "context_after": null,
