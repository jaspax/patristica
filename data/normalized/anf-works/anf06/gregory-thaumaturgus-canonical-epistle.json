  },
  {
    "chunk_id": "anf-works/gregory-thaumaturgus-canonical-epistle#GregThaum.EpCan.III",
    "work_id": "anf-works/gregory-thaumaturgus-canonical-epistle",
    "canonical_ref": "GregThaum.EpCan.III",
    "language": "eng",
    "text": "Canon III.",
