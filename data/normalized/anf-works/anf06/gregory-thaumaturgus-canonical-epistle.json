  },
  {
    "chunk_id": "anf-works/gregory-thaumaturgus-canonical-epistle#GregThaum.EpCan.III.1.s5",
    "work_id": "anf-works/gregory-thaumaturgus-canonical-epistle",
    "canonical_ref": "GregThaum.EpCan.III.1.s5",
    "language": "eng",
