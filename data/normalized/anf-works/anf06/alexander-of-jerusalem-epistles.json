    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/alexander-of-jerusalem-epistles#AlexHier.Ep.III.1.s4",
    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.III.1.s4",
    "language": "eng",
    "text": "and all the rest who may be like them, by whose means also I have come to know thee, my lord and brother, who excellest all.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
