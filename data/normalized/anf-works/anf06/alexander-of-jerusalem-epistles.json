    "canonical_ref": "AlexHier.Ep.I.3.s1",
    "language": "eng",
    "text": "Alexander, a servant and prisoner of Jesus Christ, sends greeting in the Lord to the blessed church of Antioch.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
