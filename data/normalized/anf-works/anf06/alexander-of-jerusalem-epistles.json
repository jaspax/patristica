    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.II.1.s2",
    "language": "eng",
    "text": "and who, having now attained to his hundred and tenth year, unites with me in exhorting you to be of one mind.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
