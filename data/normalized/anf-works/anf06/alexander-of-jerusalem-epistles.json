    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.III.1.s3",
    "language": "eng",
    "text": "Pantænus, namely, that man verily blessed, my master; and also the holy Clement, who was once my master and my benefactor;",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
      250
    ],
    "date_confidence": "approximate",
