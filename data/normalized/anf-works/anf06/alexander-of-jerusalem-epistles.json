    "canonical_ref": "AlexHier.Ep.II.1.s1",
    "language": "eng",
    "text": "Narcissus salutes you, who held the episcopate in this district before me, who is now also my colleague and competitor in prayer for you,",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
      250
    ],
