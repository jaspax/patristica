  {
    "chunk_id": "anf-works/alexander-of-jerusalem-epistles#AlexHier.Ep.I.3.s3",
    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.I.3.s3",
    "language": "eng",
    "text": "in regard to the right faith, is most eminently qualified for the office—has undertaken the episcopate of your holy church of Antioch.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
      250
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/alexander-of-jerusalem-epistles#AlexHier.Ep.I.3.s4",
    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.I.3.s4",
    "language": "eng",
    "text": "And this epistle, my brethren and masters, I have sent by the hand of the blessed presbyter Clement, a man virtuous and well tried, whom ye know already, and will know yet better;",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
      250
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "anf-works/alexander-of-jerusalem-epistles#AlexHier.Ep.I.3.s5",
    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.I.3.s5",
    "language": "eng",
    "text": "who also, coming here by the providence and supervision of the Master, has strengthened and increased the Church of the Lord.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
      250
    ],
    "date_confidence": "approximate",
