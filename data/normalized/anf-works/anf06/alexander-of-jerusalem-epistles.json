    "work_id": "anf-works/alexander-of-jerusalem-epistles",
    "canonical_ref": "AlexHier.Ep.I.3.s2",
    "language": "eng",
    "text": "Easy and light has the Lord made my bonds to me during the time of my imprisonment since I have learned that in the providence of God, Asclepiades—who,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 225,
    "date_range": [
      212,
      250
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
