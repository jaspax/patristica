    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.1.4",
    "language": "lat",
    "text": "Et extendam manum meam super Judam et super omnes habitantes Jerusalem: et disperdam de loco hoc reliquias Baal, et nomina ædituorum cum sacerdotibus;",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/zeph#Zeph.1.5",
    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.1.5",
    "language": "lat",
    "text": "et eos qui adorant super tecta militiam cæli, et adorant et jurant in Domino, et jurant in Melchom;",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/zeph#Zeph.1.6",
    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.1.6",
    "language": "lat",
    "text": "et qui avertuntur de post tergum Domini, et qui non quæsierunt Dominum, nec investigaverunt eum.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
