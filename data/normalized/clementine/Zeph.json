    "chunk_id": "clementine/zeph#Zeph.3.4",
    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.3.4",
    "language": "lat",
    "text": "Prophetæ ejus vesani, viri infideles; sacerdotes ejus polluerunt sanctum, injuste egerunt contra legem.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
