    "canonical_ref": "Zeph.1.3",
    "language": "lat",
    "text": "congregans hominem et pecus, congregans volatilia cæli et pisces maris: et ruinæ impiorum erunt, et disperdam homines a facie terræ, dicit Dominus.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
