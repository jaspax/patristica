    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.3.3",
    "language": "lat",
    "text": "Principes ejus in medio ejus quasi leones rugientes; judices ejus lupi vespere, non relinquebant in mane.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
