    "chunk_id": "clementine/zeph#Zeph.3.2",
    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.3.2",
    "language": "lat",
    "text": "non audivit vocem, et non suscepit disciplinam; in Domino non est confisa, ad Deum suum non appropinquavit.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
