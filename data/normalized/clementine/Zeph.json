    "work_id": "clementine/zeph",
    "canonical_ref": "Zeph.1.2",
    "language": "lat",
    "text": "[Congregans congregabo omnia a facie terræ, dicit Dominus:",
    "chunk_index": 1,
    "context_before": null,
