    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.5",
    "language": "lat",
    "text": "recordationem accipiens ejus fidei, quæ est in te non ficta, quæ et habitavit primum in avia tua Loide, et matre tua Eunice, certus sum autem quod et in te.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/2tim#2Tim.1.6",
    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.6",
    "language": "lat",
    "text": "Propter quam causam admoneo te ut resuscites gratiam Dei, quæ est in te per impositionem manuum mearum.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/2tim#2Tim.1.7",
    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.7",
    "language": "lat",
    "text": "Non enim dedit nobis Deus spiritum timoris: sed virtutis, et dilectionis, et sobrietatis.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
