    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.10",
    "language": "lat",
    "text": "Manifestata est autem nunc per illuminationem Salvatoris nostri Jesu Christi, qui destruxit quidem mortem, illuminavit autem vitam, et incorruptionem per Evangelium:",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
