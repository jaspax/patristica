    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.11",
    "language": "lat",
    "text": "in quo positus sum ego prædicator, et Apostolus, et magister gentium.",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
