    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.14",
    "language": "lat",
    "text": "Bonum depositum custodi per Spiritum Sanctum, qui habitat in nobis.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
