    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.4",
    "language": "lat",
    "text": "desiderans te videre, memor lacrimarum tuarum, ut gaudio implear,",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
