    "work_id": "clementine/2tim",
    "canonical_ref": "2Tim.1.13",
    "language": "lat",
    "text": "Formam habe sanorum verborum, quæ a me audisti in fide, et in dilectione in Christo Jesu.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
