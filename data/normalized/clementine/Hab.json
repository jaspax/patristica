[
  {
    "chunk_id": "clementine/hab#Hab.1.1",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.1",
    "language": "lat",
    "text": "Onus quod vidit Habacuc propheta.",
    "chunk_index": 0,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.2",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.2",
    "language": "lat",
    "text": "[Usquequo, Domine, clamabo, et non exaudies? vociferabor ad te, vim patiens, et non salvabis?",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.3",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.3",
    "language": "lat",
    "text": "Quare ostendisti mihi iniquitatem et laborem, videre prædam et injustitiam contra me? Et factum est judicium, et contradictio potentior.",
    "chunk_index": 2,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.4",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.4",
    "language": "lat",
    "text": "Propter hoc lacerata est lex, et non pervenit usque ad finem judicium; quia impius prævalet adversus justum, propterea egreditur judicium perversum.",
    "chunk_index": 3,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.5",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.5",
    "language": "lat",
    "text": "Aspicite in gentibus, et videte; admiramini, et obstupescite: quia opus factum est in diebus vestris, quod nemo credet cum narrabitur.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.6",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.6",
    "language": "lat",
    "text": "Quia ecce ego suscitabo Chaldæos, gentem amaram et velocem, ambulantem super latitudinem terræ, ut possideat tabernacula non sua.",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.7",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.7",
    "language": "lat",
    "text": "Horribilis et terribilis est: ex semetipsa judicium et onus ejus egredietur.",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.8",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.8",
    "language": "lat",
    "text": "Leviores pardis equi ejus, et velociores lupis vespertinis: et diffundentur equites ejus: equites namque ejus de longe venient; volabunt quasi aquila festinans ad comedendum.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.9",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.9",
    "language": "lat",
    "text": "Omnes ad prædam venient, facies eorum ventus urens; et congregabit quasi arenam captivitatem.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.10",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.10",
    "language": "lat",
    "text": "Et ipse de regibus triumphabit, et tyranni ridiculi ejus erunt; ipse super omnem munitionem ridebit, et comportabit aggerem, et capiet eam.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.11",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.11",
    "language": "lat",
    "text": "Tunc mutabitur spiritus, et pertransibit, et corruet: hæc est fortitudo ejus dei sui.]",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.12",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.12",
    "language": "lat",
    "text": "[Numquid non tu a principio, Domine, Deus meus, sancte meus, et non moriemur? Domine, in judicium posuisti eum, et fortem, ut corriperes, fundasti eum.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.13",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.13",
    "language": "lat",
    "text": "Mundi sunt oculi tui, ne videas malum, et respicere ad iniquitatem non poteris. Quare respicis super iniqua agentes, et taces devorante impio justiorem se?",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.14",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.14",
    "language": "lat",
    "text": "Et facies homines quasi pisces maris, et quasi reptile non habens principem.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.15",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.15",
    "language": "lat",
    "text": "Totum in hamo sublevavit, traxit illud in sagena sua, et congregavit in rete suum. Super hoc lætabitur, et exsultabit.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.16",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.16",
    "language": "lat",
    "text": "Propterea immolabit sagenæ suæ, et sacrificabit reti suo, quia in ipsis incrassata est pars ejus, et cibus ejus electus.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.1.17",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.1.17",
    "language": "lat",
    "text": "Propter hoc ergo expandit sagenam suam, et semper interficere gentes non parcet.]",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.1",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.1",
    "language": "lat",
    "text": "[Super custodiam meam stabo, et figam gradum super munitionem: et contemplabor ut videam quid dicatur mihi, et quid respondeam ad arguentem me.]",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.2",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.2",
    "language": "lat",
    "text": "Et respondit mihi Dominus, et dixit: [Scribe visum, et explana eum super tabulas, ut percurrat qui legerit eum.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.3",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.3",
    "language": "lat",
    "text": "Quia adhuc visus procul; et apparebit in finem, et non mentietur: si moram fecerit, exspecta illum, quia veniens veniet, et non tardabit.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.4",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.4",
    "language": "lat",
    "text": "Ecce qui incredulus est, non erit recta anima ejus in semetipso; justus autem in fide sua vivet.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.5",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.5",
    "language": "lat",
    "text": "Et quomodo vinum potantem decipit, sic erit vir superbus, et non decorabitur: qui dilatavit quasi infernus animam suam, et ipse quasi mors, et non adimpletur: et congregabit ad se omnes gentes, et coacervabit ad se omnes populos.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.6",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.6",
    "language": "lat",
    "text": "Numquid non omnes isti super eum parabolam sument, et loquelam ænigmatum ejus, et dicetur: Væ ei qui multiplicat non sua? usquequo et aggravat contra se densum lutum?",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.7",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.7",
    "language": "lat",
    "text": "Numquid non repente consurgent qui mordeant te, et suscitabuntur lacerantes te, et eris in rapinam eis?",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.8",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.8",
    "language": "lat",
    "text": "Quia tu spoliasti gentes multas, spoliabunt te omnes qui reliqui fuerint de populis, propter sanguinem hominis, et iniquitatem terræ, civitatis, et omnium habitantium in ea.",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.9",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.9",
    "language": "lat",
    "text": "Væ qui congregat avaritiam malam domui suæ, ut sit in excelso nidus ejus, et liberari se putat de manu mali !",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.10",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.10",
    "language": "lat",
    "text": "Cogitasti confusionem domui tuæ; concidisti populos multos, et peccavit anima tua.",
    "chunk_index": 26,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.11",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.11",
    "language": "lat",
    "text": "Quia lapis de pariete clamabit, et lignum, quod inter juncturas ædificiorum est, respondebit.",
    "chunk_index": 27,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.12",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.12",
    "language": "lat",
    "text": "Væ qui ædificat civitatem in sanguinibus, et præparat urbem in iniquitate !",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.13",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.13",
    "language": "lat",
    "text": "Numquid non hæc sunt a Domino exercituum? laborabunt enim populi in multo igne, et gentes in vacuum, et deficient.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.14",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.14",
    "language": "lat",
    "text": "Quia replebitur terra, ut cognoscant gloriam Domini, quasi aquæ operientes mare.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.15",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.15",
    "language": "lat",
    "text": "Væ qui potum dat amico suo mittens fel suum, et inebrians ut aspiciat nuditatem ejus !",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.16",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.16",
    "language": "lat",
    "text": "Repletus es ignominia pro gloria; bibe tu quoque, et consopire. Circumdabit te calix dexteræ Domini, et vomitus ignominiæ super gloriam tuam.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.17",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.17",
    "language": "lat",
    "text": "Quia iniquitas Libani operiet te, et vastitas animalium deterrebit eos de sanguinibus hominum, et iniquitate terræ, et civitatis, et omnium habitantium in ea.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.18",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.18",
    "language": "lat",
    "text": "Quid prodest sculptile, quia sculpsit illud fictor suus, conflatile, et imaginem falsam? quia speravit in figmento fictor ejus, ut faceret simulacra muta.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.19",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.19",
    "language": "lat",
    "text": "Væ qui dicit ligno: Expergiscere; Surge, lapidi tacenti ! Numquid ipse docere poterit? ecce iste coopertus est auro et argento, et omnis spiritus non est in visceribus ejus.",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.2.20",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.2.20",
    "language": "lat",
    "text": "Dominus autem in templo sancto suo: sileat a facie ejus omnis terra !]",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.3.1",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.3.1",
    "language": "lat",
    "text": "Oratio Habacuc prophetæ, pro ignorantiis.",
    "chunk_index": 37,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/hab#Hab.3.2",
    "work_id": "clementine/hab",
    "canonical_ref": "Hab.3.2",
    "language": "lat",
    "text": "[Domine, audivi auditionem tuam, et timui. Domine, opus tuum, in medio annorum vivifica illud; in medio annorum notum facies: cum iratus fueris, misericordiæ recordaberis.",
