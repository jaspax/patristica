    "work_id": "clementine/hab",
    "canonical_ref": "Hab.3.10",
    "language": "lat",
    "text": "Viderunt te, et doluerunt montes; gurges aquarum transiit: dedit abyssus vocem suam; altitudo manus suas levavit.",
