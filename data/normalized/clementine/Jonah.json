    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/jonah#Jonah.3.6",
    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.3.6",
    "language": "lat",
    "text": "Et pervenit verbum ad regem Ninive: et surrexit de solio suo, et abjecit vestimentum suum a se, et indutus est sacco, et sedit in cinere.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/jonah#Jonah.3.7",
    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.3.7",
    "language": "lat",
    "text": "Et clamavit, et dixit in Ninive ex ore regis et principum ejus, dicens: Homines, et jumenta, et boves, et pecora non gustent quidquam: nec pascantur, et aquam non bibant.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
