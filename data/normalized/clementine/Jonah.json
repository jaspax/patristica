    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.2.5",
    "language": "lat",
    "text": "Et ego dixi: Abjectus sum a conspectu oculorum tuorum; verumtamen rursus videbo templum sanctum tuum.",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
