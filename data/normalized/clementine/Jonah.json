    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.3.8",
    "language": "lat",
    "text": "Et operiantur saccis homines et jumenta, et clament ad Dominum in fortitudine: et convertatur vir a via sua mala, et ab iniquitate quæ est in manibus eorum.",
    "chunk_index": 34,
    "context_before": null,
