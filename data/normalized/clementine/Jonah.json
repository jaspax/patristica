    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.1.16",
    "language": "lat",
    "text": "Et timuerunt viri timore magno Dominum: et immolaverunt hostias Domino, et voverunt vota.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
