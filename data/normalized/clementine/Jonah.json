    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.1.15",
    "language": "lat",
    "text": "Et tulerunt Jonam, et miserunt in mare: et stetit mare a fervore suo.",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
