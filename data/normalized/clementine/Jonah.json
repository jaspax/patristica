    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.1.2",
    "language": "lat",
    "text": "Surge, et vade in Niniven, civitatem grandem, et prædica in ea, quia ascendit malitia ejus coram me.",
    "chunk_index": 1,
    "context_before": null,
    "context_after": null,
