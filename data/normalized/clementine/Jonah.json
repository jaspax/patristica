    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.1.14",
    "language": "lat",
    "text": "Et clamaverunt ad Dominum, et dixerunt: Quæsumus, Domine, ne pereamus in anima viri istius, et ne des super nos sanguinem innocentem: quia tu, Domine, sicut voluisti, fecisti.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
