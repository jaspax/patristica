    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.3.3",
    "language": "lat",
    "text": "Et surrexit Jonas, et abiit in Niniven juxta verbum Domini: et Ninive erat civitas magna, itinere trium dierum.",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
