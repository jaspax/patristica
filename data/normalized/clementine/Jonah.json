    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.3.2",
    "language": "lat",
    "text": "Surge, et vade in Niniven, civitatem magnam, et prædica in ea prædicationem quam ego loquor ad te.",
    "chunk_index": 28,
    "context_before": null,
