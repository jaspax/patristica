    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.2.4",
    "language": "lat",
    "text": "Et projecisti me in profundum in corde maris, et flumen circumdedit me: omnes gurgites tui, et fluctus tui super me transierunt.",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
