    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "clementine/jonah#Jonah.3.9",
    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.3.9",
    "language": "lat",
    "text": "Quis scit si convertatur et ignoscat Deus, et revertatur a furore iræ suæ, et non peribimus?",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
