    "work_id": "clementine/jonah",
    "canonical_ref": "Jonah.1.13",
    "language": "lat",
    "text": "Et remigabant viri ut reverterentur ad aridam, et non valebant, quia mare ibat, et intumescebat super eos.",
    "chunk_index": 12,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
