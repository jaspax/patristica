    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.5",
    "language": "lat",
    "text": "in exemplum justi judicii Dei, ut digni habeamini in regno Dei, pro quo et patimini.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
