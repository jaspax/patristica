    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.7",
    "language": "lat",
    "text": "et vobis, qui tribulamini, requiem nobiscum in revelatione Domini Jesu de cælo cum angelis virtutis ejus,",
    "chunk_index": 6,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
