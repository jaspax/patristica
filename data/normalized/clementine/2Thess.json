    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.17",
    "language": "lat",
    "text": "exhortetur corda vestra, et confirmet in omni opere et sermone bono.",
    "chunk_index": 28,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.3.1",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.1",
    "language": "lat",
    "text": "De cetero fratres, orate pro nobis ut sermo Dei currat, et clarificetur, sicut et apud vos:",
    "chunk_index": 29,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.3.2",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.2",
    "language": "lat",
    "text": "et ut liberemur ab importunis, et malis hominibus: non enim omnium est fides.",
    "chunk_index": 30,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
