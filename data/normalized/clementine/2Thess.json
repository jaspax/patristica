    "chunk_id": "scripture/clementine/2thess#2Thess.3.8",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.8",
    "language": "lat",
    "text": "neque gratis panem manducavimus ab aliquo, sed in labore, et in fatigatione, nocte et die operantes, ne quem vestrum gravaremus.",
    "chunk_index": 36,
    "context_before": null,
    "context_after": null,
