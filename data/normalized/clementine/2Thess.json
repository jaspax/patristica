    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.10",
    "language": "lat",
    "text": "cum venerit glorificari in sanctis suis, et admirabilis fieri in omnibus, qui crediderunt, quia creditum est testimonium nostrum super vos in die illo.",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
