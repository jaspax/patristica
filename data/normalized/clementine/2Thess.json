    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.8",
    "language": "lat",
    "text": "in flamma ignis dantis vindictam iis qui non noverunt Deum, et qui non obediunt Evangelio Domini nostri Jesu Christi,",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
