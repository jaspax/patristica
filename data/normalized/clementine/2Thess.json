    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.5",
    "language": "lat",
    "text": "Dominus autem dirigat corda vestra in caritate Dei, et patientia Christi.",
    "chunk_index": 33,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.3.6",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.6",
    "language": "lat",
    "text": "Denuntiamus autem vobis, fratres, in nomine Domini nostri Jesu Christi, ut subtrahatis vos ab omni fratre ambulante inordinate, et non secundum traditionem, quam acceperunt a nobis.",
    "chunk_index": 34,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.3.7",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.7",
    "language": "lat",
    "text": "Ipsi enim scitis quemadmodum oporteat imitari nos: quoniam non inquieti fuimus inter vos:",
    "chunk_index": 35,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
