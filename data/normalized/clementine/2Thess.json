    "chunk_id": "scripture/clementine/2thess#2Thess.3.3",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.3",
    "language": "lat",
    "text": "Fidelis autem Deus est, qui confirmabit vos, et custodiet a malo.",
    "chunk_index": 31,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.3.4",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.3.4",
    "language": "lat",
    "text": "Confidimus autem de vobis, in Domino, quoniam quæ præcepimus, et facitis, et facietis.",
    "chunk_index": 32,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
