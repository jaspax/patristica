    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.6",
    "language": "lat",
    "text": "Si tamen justum est apud Deum retribuere tribulationem iis qui vos tribulant:",
    "chunk_index": 5,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
