    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.11",
    "language": "lat",
    "text": "Ideo mittet illis Deus operationem erroris ut credant mendacio,",
    "chunk_index": 22,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.12",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.12",
    "language": "lat",
    "text": "ut judicentur omnes qui non crediderunt veritati, sed consenserunt iniquitati.",
    "chunk_index": 23,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
