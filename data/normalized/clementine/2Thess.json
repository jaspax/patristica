    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.9",
    "language": "lat",
    "text": "qui pœnas dabunt in interitu æternas a facie Domini, et a gloria virtutis ejus:",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
