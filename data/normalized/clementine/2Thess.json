    "chunk_id": "scripture/clementine/2thess#2Thess.2.2",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.2",
    "language": "lat",
    "text": "ut non cito moveamini a vestro sensu, neque terreamini, neque per spiritum, neque per sermonem, neque per epistolam tamquam per nos missam, quasi instet dies Domini.",
    "chunk_index": 13,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.3",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.3",
    "language": "lat",
    "text": "Ne quis vos seducat ullo modo: quoniam nisi venerit discessio primum, et revelatus fuerit homo peccati filius perditionis,",
    "chunk_index": 14,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.4",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.4",
    "language": "lat",
    "text": "qui adversatur, et extollitur supra omne, quod dicitur Deus, aut quod colitur, ita ut in templo Dei sedeat ostendens se tamquam sit Deus.",
    "chunk_index": 15,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.5",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.5",
    "language": "lat",
    "text": "Non retinetis quod cum adhuc essem apud vos, hæc dicebam vobis?",
    "chunk_index": 16,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.6",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.6",
    "language": "lat",
    "text": "et nunc quid detineat scitis, ut reveletur in suo tempore.",
    "chunk_index": 17,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.7",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.7",
    "language": "lat",
    "text": "Nam mysterium jam operatur iniquitatis: tantum ut qui tenet nunc, teneat, donec de medio fiat.",
    "chunk_index": 18,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.8",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.8",
    "language": "lat",
    "text": "Et tunc revelabitur ille iniquus, quem Dominus Jesus interficiet spiritu oris sui, et destruet illustratione adventus sui eum:",
    "chunk_index": 19,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.9",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.9",
    "language": "lat",
    "text": "cujus est adventus secundum operationem Satanæ in omni virtute, et signis, et prodigiis mendacibus,",
    "chunk_index": 20,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.10",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.10",
    "language": "lat",
    "text": "et in omni seductione iniquitatis iis qui pereunt: eo quod caritatem veritatis non receperunt ut salvi fierent.",
    "chunk_index": 21,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
