    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.11",
    "language": "lat",
    "text": "In quo etiam oramus semper pro vobis: ut dignetur vos vocatione sua Deus noster, et impleat omnem voluntatem bonitatis, et opus fidei in virtute,",
    "chunk_index": 10,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
