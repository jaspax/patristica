    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.13",
    "language": "lat",
    "text": "Nos autem debemus gratias agere Deo semper pro vobis, fratres dilecti a Deo, quod elegerit vos Deus primitias in salutem in sanctificatione spiritus, et in fide veritatis:",
    "chunk_index": 24,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/clementine/2thess#2Thess.2.14",
    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.2.14",
    "language": "lat",
    "text": "in qua et vocavit vos per Evangelium nostrum in acquisitionem gloriæ Domini nostri Jesu Christi.",
    "chunk_index": 25,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
    "date_confidence": "established",
    "out_of_period": false,
    "translation_group_id": null
  },
