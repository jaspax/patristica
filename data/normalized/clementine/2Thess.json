    "work_id": "scripture/clementine/2thess",
    "canonical_ref": "2Thess.1.12",
    "language": "lat",
    "text": "ut clarificetur nomen Domini nostri Jesu Christi in vobis, et vos in illo secundum gratiam Dei nostri, et Domini Jesu Christi.",
    "chunk_index": 11,
    "context_before": null,
    "context_after": null,
    "date_composed": 405,
    "date_range": [
      382,
      405
    ],
