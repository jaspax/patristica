    "canonical_ref": "ogpg.vol-045.c0111.1.s21",
    "language": "grc",
    "text": "’ᾫ γὰρ ἐδόθη ὲκ μόνου τοῦ χειμάρρου πίνειν, τοῦ δὲ κατὰ τὸ εἰκὸς",
    "chunk_index": 51,
    "context_before": null,
