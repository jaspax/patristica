    "work_id": "scripture/sblgnt/2john",
    "canonical_ref": "2John.1.10",
    "language": "grc",
    "text": "εἴ τις ἔρχεται πρὸς ὑμᾶς καὶ ταύτην τὴν διδαχὴν οὐ φέρει, μὴ λαμβάνετε αὐτὸν εἰς οἰκίαν καὶ χαίρειν αὐτῷ μὴ λέγετε·",
    "chunk_index": 9,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
