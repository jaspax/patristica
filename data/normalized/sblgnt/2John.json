    "work_id": "scripture/sblgnt/2john",
    "canonical_ref": "2John.1.8",
    "language": "grc",
    "text": "βλέπετε ἑαυτούς, ἵνα μὴ ἀπολέσητε ἃ εἰργασάμεθα, ἀλλὰ μισθὸν πλήρη ἀπολάβητε.",
    "chunk_index": 7,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
