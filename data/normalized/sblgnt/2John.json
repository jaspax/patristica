    "work_id": "scripture/sblgnt/2john",
    "canonical_ref": "2John.1.9",
    "language": "grc",
    "text": "πᾶς ὁ προάγων καὶ μὴ μένων ἐν τῇ διδαχῇ τοῦ Χριστοῦ θεὸν οὐκ ἔχει· ὁ μένων ἐν τῇ διδαχῇ, οὗτος καὶ τὸν πατέρα καὶ τὸν υἱὸν ἔχει.",
    "chunk_index": 8,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
      100
    ],
    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
