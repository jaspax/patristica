    "date_confidence": "approximate",
    "out_of_period": false,
    "translation_group_id": null
  },
  {
    "chunk_id": "scripture/sblgnt/2john#2John.1.5",
    "work_id": "scripture/sblgnt/2john",
    "canonical_ref": "2John.1.5",
    "language": "grc",
    "text": "καὶ νῦν ἐρωτῶ σε, κυρία, οὐχ ὡς ἐντολὴν καινὴν γράφων σοι⸃ ἀλλὰ ἣν εἴχομεν ἀπʼ ἀρχῆς, ἵνα ἀγαπῶμεν ἀλλήλους.",
    "chunk_index": 4,
    "context_before": null,
    "context_after": null,
    "date_composed": 95,
    "date_range": [
      85,
