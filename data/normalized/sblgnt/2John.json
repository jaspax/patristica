    "work_id": "scripture/sblgnt/2john",
    "canonical_ref": "2John.1.11",
    "language": "grc",
    "text": "ὁ λέγων γὰρ⸃ αὐτῷ χαίρειν κοινωνεῖ τοῖς ἔργοις αὐτοῦ τοῖς πονηροῖς.",
    "chunk_index": 10,
    "context_before": null,
