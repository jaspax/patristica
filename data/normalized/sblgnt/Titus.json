    "work_id": "scripture/sblgnt/titus",
    "canonical_ref": "Titus.1.8",
    "language": "grc",
    "text": "ἀλλὰ φιλόξενον, φιλάγαθον, σώφρονα, δίκαιον, ὅσιον, ἐγκρατῆ,",
