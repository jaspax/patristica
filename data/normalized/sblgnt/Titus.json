    "work_id": "scripture/sblgnt/titus",
    "canonical_ref": "Titus.2.4",
    "language": "grc",
    "text": "ἵνα σωφρονίζωσι τὰς νέας φιλάνδρους εἶναι, φιλοτέκνους,",
