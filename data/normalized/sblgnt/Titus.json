    "work_id": "scripture/sblgnt/titus",
    "canonical_ref": "Titus.2.11",
    "language": "grc",
    "text": "Ἐπεφάνη γὰρ ἡ χάρις τοῦ θεοῦ σωτήριος πᾶσιν ἀνθρώποις",
