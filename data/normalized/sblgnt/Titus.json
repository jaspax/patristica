    "work_id": "scripture/sblgnt/titus",
    "canonical_ref": "Titus.2.1",
    "language": "grc",
    "text": "Σὺ δὲ λάλει ἃ πρέπει τῇ ὑγιαινούσῃ διδασκαλίᾳ.",
