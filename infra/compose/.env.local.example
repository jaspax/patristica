# Local run of the production stack over plain HTTP (no certificate):
#   cp .env.local.example .env && docker compose up -d --build
#   curl http://localhost:18080/                 # web app
#   curl http://localhost:18080/api/healthz      # API, same origin
#   curl http://api.localhost:18080/healthz      # API, own hostname
# (*.localhost resolves to 127.0.0.1 in browsers and curl.)
POSTGRES_PASSWORD=local-only
API_DOMAIN=http://api.localhost
WEB_DOMAIN=http://localhost
WWW_DOMAIN=http://www.localhost
# The web app reads the published library from the Spaces CDN.
LIBRARY_URL=https://patristica-library.nyc3.cdn.digitaloceanspaces.com
HTTP_PORT=18080
HTTPS_PORT=18443
# Query embeddings for /api/search (#141); leave empty and search answers 503.
VOYAGE_API_KEY=
