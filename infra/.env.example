# Copy to infra/.env (gitignored) and fill in. Never commit the real file.
# Read by infra/tofu.sh, infra/deploy.sh and scripts.bootstrap_infra.

# DigitalOcean personal access token (full access, or custom scopes that
# include spaces/spaces_key). The only secret you add by hand.
DIGITALOCEAN_TOKEN=

# Optional: names of the Spaces buckets, if the defaults are taken
# (Spaces bucket names are global per region).
# SPACES_STATE_BUCKET=patristica-tfstate

# Optional: private half of the deploy key (default ~/.ssh/patristica_deploy).
# PATRISTICA_SSH_KEY=

# Written by `uv run --extra deploy python -m scripts.bootstrap_infra`:
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_ACCESS_KEY=
