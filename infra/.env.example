# Copy to infra/.env (gitignored) and fill in. Never commit the real file.
# Read by infra/tofu.sh and infra/deploy.sh.

# DigitalOcean personal access token (read + write).
DIGITALOCEAN_TOKEN=

# Cloudflare R2: the private infra bucket (tofu state under tfstate/,
# database dumps under pg-backups/) and a token scoped to that bucket only.
R2_ACCOUNT_ID=
R2_INFRA_BUCKET=patristica-infra
R2_INFRA_ACCESS_KEY_ID=
R2_INFRA_SECRET_ACCESS_KEY=

# Optional: private half of the deploy key (default ~/.ssh/patristica_deploy).
# PATRISTICA_SSH_KEY=
