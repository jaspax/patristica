#!/usr/bin/env bash
# Pre-push hook:
#   1. Reject pushes directly to master (changes land via pull request).
#   2. Run the unit tests before anything leaves this machine.
#   3. Run scripts.validate when a pushed revision changes a file it reads
#      (data/normalized, patristica/data, its code; #130). It takes a few
#      minutes, so it runs only then; skip it with PATRISTICA_SKIP_VALIDATE=1.
#      Every pushed ref is checked against its own base. validate reads the
#      working tree, so a pushed revision that needs it must be the checked-out
#      HEAD: push other branches from their own checkout.
#   4. Upload the git-lfs objects the pushed commits use (data/, #244), with
#      git lfs pre-push: core.hooksPath replaces the hook git lfs installs.
#
# Install once per clone:   git config core.hooksPath scripts/hooks
# Bypass in an emergency:   git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
refs="$(cat)"  # read once: git lfs pre-push needs the same lines
pushed=()  # "local_sha base" for every ref pushed (not deleted)
# git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/master" ]]; then
        echo "pre-push: direct pushes to master are not allowed." >&2
        echo "pre-push: push a feature branch and open a pull request instead." >&2
        exit 1
    fi
    [[ -z "$local_sha" || "$local_sha" == "$zero" ]] && continue  # a deletion
    base=""
    if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha" 2>/dev/null; then
        base="$remote_sha"
    else  # a new branch: compare with where it left master
        for master in origin/master master; do
            if git rev-parse --verify -q "$master" >/dev/null; then
                base="$(git merge-base "$local_sha" "$master")"
                break
            fi
        done
    fi
    pushed+=("$local_sha $base")
done <<<"$refs"

if ! command -v git-lfs >/dev/null; then
    echo "pre-push: git-lfs is required: data/ is stored in git-lfs (#244)." >&2
    exit 1
fi

echo "pre-push: running unit tests (uv run pytest)..." >&2
if ! uv run --extra dev pytest -q -p no:cacheprovider; then
    echo "pre-push: unit tests failed; push aborted." >&2
    exit 1
fi

head="$(git rev-parse HEAD)"
validate=0
[[ "${PATRISTICA_SKIP_VALIDATE:-}" == "1" ]] && pushed=()
for entry in "${pushed[@]+"${pushed[@]}"}"; do
    read -r local_sha base <<<"$entry"
    if [[ -z "$base" ]]; then
        echo "pre-push: no master here to compare ${local_sha:0:12} with; not validating it." >&2
        continue
    fi
    changed="$(uv run python -m scripts.validate --inputs-changed "$base" "$local_sha")"
    [[ -z "$changed" ]] && continue
    if [[ "$local_sha" != "$head" ]]; then
        echo "pre-push: ${local_sha:0:12} changes files scripts.validate reads" \
             "(e.g. $(head -1 <<<"$changed")) but isn't the checked-out HEAD, and validate" \
             "checks the working tree: push it from its own checkout" \
             "(or PATRISTICA_SKIP_VALIDATE=1)." >&2
        exit 1
    fi
    validate=1
done
if [[ "$validate" == 1 ]]; then
    echo "pre-push: the pushed HEAD changes files scripts.validate reads: validating..." >&2
    if ! uv run python -m scripts.validate \
            --output "${TMPDIR:-/tmp}/patristica-validation-report.json"; then
        echo "pre-push: validation found errors; push aborted" \
             "(PATRISTICA_SKIP_VALIDATE=1 to skip)." >&2
        exit 1
    fi
fi

git lfs pre-push "$@" <<<"$refs"
