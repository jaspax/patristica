#!/usr/bin/env bash
# Pre-push hook: run the unit tests before anything leaves this machine.
#
# Install once per clone:   git config core.hooksPath scripts/hooks
# Bypass in an emergency:   git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running unit tests (uv run pytest)..." >&2
if ! uv run --extra dev pytest -q -p no:cacheprovider; then
    echo "pre-push: unit tests failed; push aborted." >&2
    exit 1
fi
