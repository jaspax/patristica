# Raw data is tracked in git-lfs (#244), apart from the upstream clones: each
# clone under _repos/ is one archive in _repo_archives/ (scripts.data pack),
# and the git dirs of the clones ingestors write into live in _gitdirs/.
data/raw/_repos/
data/raw/_gitdirs/
# Page images for new OCR (scripts.ogpg_images, #719): a cache, refetched from
# the Internet Archive; each OCR result records its image's URL.
data/raw/_images/
data/raw/_repo_archives/**/*.tmp

# Local caches of derived values (scripts.ogpg_coverage's column maps)
data/cache/

# Derived chunks (regenerated from data/normalized by scripts.chunk)
data/chunks/*
!data/chunks/.gitkeep

# Claude: local settings, worktrees and the rest stay private; the project
# skills and the nightly agent's permission allowlist are tracked (#425).
.claude/*
!.claude/skills/
!.claude/settings.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Environment
.env

# Validation output (regenerated on each run)
data/validation_report.json

# Static library export for the web browser (regenerated by scripts.export_library)
data/library/

# Embedding eval corpus, queries, embeddings and results (regenerated by scripts.embed_eval)
data/eval/

# OpenTofu working directory (providers, cached backend config); the lock file is tracked
infra/tofu/.terraform/

# scripts.pipeline run logs
logs/

# Local caches: build_index's input hashes (#607)
data/cache/

# Scratch vectors of scripts.anchor (#304): segment and candidate vectors, regenerable
data/anchor_vectors/
